
<style>
*{margin:0;padding:0;box-sizing:border-box;}
#stage{width:100%;aspect-ratio:16/9;background:#03070f;position:relative;overflow:hidden;min-height:320px;font-family:'Segoe UI',system-ui,sans-serif;cursor:default;}
canvas#stars{position:absolute;inset:0;width:100%;height:100%;z-index:0;}

/* vignette */
#vig{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,transparent 30%,rgba(0,0,0,.8) 100%);z-index:1;pointer-events:none;}

/* all scenes sit in z-index 2 */
#scenes{position:absolute;inset:0;z-index:2;}
.sc{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;pointer-events:none;}

/* ── overlay tint per scene ── */
.sc-tint-blue{background:rgba(4,18,44,.55);}
.sc-tint-green{background:rgba(2,20,12,.5);}
.sc-tint-amber{background:rgba(28,18,2,.5);}
.sc-tint-none{background:transparent;}

/* ── typography ── */
.eyebrow{font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:#2e6080;font-weight:400;margin-bottom:8px;opacity:0;transform:translateY(6px);}
.headline{font-size:clamp(22px,4.5vw,38px);font-weight:700;line-height:1.15;text-align:center;color:#fff;opacity:0;transform:translateY(14px);}
.headline .hi{color:#5cc8ff;}
.headline .gr{color:#3de88a;}
.headline .am{color:#f7c355;}
.subline{font-size:clamp(12px,2vw,15px);color:#4a7a96;text-align:center;line-height:1.6;max-width:520px;margin-top:10px;opacity:0;transform:translateY(10px);}
.subline b{color:#7ab8d0;font-weight:500;}

/* ── stat pill ── */
.stat-row{display:flex;gap:12px;margin-top:18px;flex-wrap:wrap;justify-content:center;opacity:0;transform:translateY(10px);}
.stat{padding:8px 18px;border-radius:100px;font-size:12px;font-weight:600;letter-spacing:.04em;}
.stat-b{background:rgba(92,200,255,.1);border:1px solid rgba(92,200,255,.2);color:#5cc8ff;}
.stat-g{background:rgba(61,232,138,.1);border:1px solid rgba(61,232,138,.2);color:#3de88a;}
.stat-a{background:rgba(247,195,85,.1);border:1px solid rgba(247,195,85,.2);color:#f7c355;}

/* ── phone mockup ── */
.phone-wrap{position:relative;width:clamp(120px,22vw,185px);flex-shrink:0;opacity:0;transform:translateY(20px) scale(.95);}
.phone{width:100%;background:#0a1628;border:1.5px solid rgba(92,200,255,.18);border-radius:24px;overflow:hidden;padding:10px;}
.phone-bar{display:flex;align-items:center;gap:6px;margin-bottom:8px;padding:0 2px;}
.phone-dot{width:6px;height:6px;border-radius:50%;}
.phone-screen-inner{background:#040d1e;border-radius:14px;padding:10px;min-height:120px;}

/* ── screen content helpers ── */
.prow{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
.plbl{font-size:9px;color:#2e5a72;text-transform:uppercase;letter-spacing:.07em;}
.pval{font-size:11px;font-weight:600;}
.pbar-bg{height:3px;border-radius:2px;background:rgba(255,255,255,.07);overflow:hidden;margin:4px 0 8px;}
.pbar-fill{height:100%;border-radius:2px;}
.pcta-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:8px;}
.pcta{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:7px;padding:6px 4px;text-align:center;}
.pcta-icon{font-size:13px;margin-bottom:2px;}
.pcta-lbl{font-size:8px;color:#2e5a72;}

/* ── split layout ── */
.split{display:flex;align-items:center;gap:clamp(16px,4vw,48px);width:min(90%,680px);justify-content:center;}
.split-text{flex:1;min-width:0;}
.split-text .eyebrow,.split-text .headline,.split-text .subline,.split-text .stat-row{text-align:left;}

/* ── growth chart ── */
.chart-wrap{width:clamp(140px,28vw,220px);flex-shrink:0;opacity:0;transform:translateY(16px);}
.chart-inner{background:#040d1e;border:1px solid rgba(61,232,138,.15);border-radius:12px;padding:12px;}
.chart-title{font-size:9px;color:#2e5a72;text-transform:uppercase;letter-spacing:.07em;margin-bottom:8px;}
.chart-bars{display:flex;align-items:flex-end;gap:4px;height:60px;}
.cbar{flex:1;border-radius:3px 3px 0 0;min-width:0;}
.chart-labels{display:flex;gap:4px;margin-top:4px;}
.clbl{flex:1;font-size:7px;color:#1e3a52;text-align:center;}
.chart-roi{margin-top:8px;padding:6px 8px;background:rgba(61,232,138,.07);border:1px solid rgba(61,232,138,.15);border-radius:6px;display:flex;justify-content:space-between;align-items:center;}
.chart-roi-lbl{font-size:8px;color:#2e5a72;}
.chart-roi-val{font-size:12px;font-weight:700;color:#3de88a;}

/* ── loan card ── */
.loan-card{width:clamp(140px,28vw,220px);flex-shrink:0;opacity:0;transform:translateY(16px);}
.lc-inner{background:#040d1e;border:1px solid rgba(247,195,85,.15);border-radius:12px;padding:12px;}
.lc-top{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
.lc-icon{width:28px;height:28px;border-radius:7px;background:rgba(247,195,85,.12);display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;}
.lc-title{font-size:11px;font-weight:600;color:#c8d4f0;}
.lc-sub{font-size:8px;color:#2e5a72;}
.lc-row{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid rgba(255,255,255,.05);font-size:9px;}
.lc-row:last-child{border-bottom:none;}
.lc-k{color:#2e5a72;}
.lc-v{font-weight:600;color:#c8d4f0;}
.lc-btn{margin-top:8px;padding:6px;background:linear-gradient(135deg,#7c4a00,#f7c355);border-radius:6px;font-size:9px;font-weight:700;color:#2a1800;text-align:center;}

/* ── progress bar bottom ── */
#prog{position:absolute;bottom:0;left:0;right:0;height:2px;background:rgba(255,255,255,.04);z-index:10;}
#progfill{height:100%;width:0;background:linear-gradient(90deg,#1e40af,#5cc8ff);}

/* ── chapter indicator ── */
#chap-indicator{position:absolute;top:14px;left:16px;z-index:10;font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:#0f2a3a;font-family:'Segoe UI',sans-serif;opacity:0;transition:opacity .4s;}

/* ── cta button ── */
#cta-btn{position:absolute;bottom:18px;right:16px;z-index:10;background:none;border:1px solid rgba(92,200,255,.2);color:#2e6080;border-radius:8px;padding:5px 14px;font-size:10px;cursor:pointer;font-family:inherit;letter-spacing:.06em;opacity:0;transition:all .2s;}
#cta-btn:hover{border-color:#5cc8ff;color:#5cc8ff;}

/* ── start overlay ── */
#so{position:absolute;inset:0;z-index:30;background:#03070f;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;}
#so .ring{width:58px;height:58px;border-radius:50%;border:1.5px solid rgba(92,200,255,.25);display:flex;align-items:center;justify-content:center;}
#so .tri{width:0;height:0;border-top:10px solid transparent;border-bottom:10px solid transparent;border-left:18px solid #5cc8ff;margin-left:4px;}
#so .stxt{font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#1e4a60;font-family:inherit;}
#so .stitle{font-size:clamp(13px,2.5vw,17px);color:#1a3a52;letter-spacing:.06em;font-weight:400;}
</style>

