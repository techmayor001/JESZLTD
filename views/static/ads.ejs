              <div style="background:rgba(255,255,255,.03);border-radius:7px;padding:8px;border:1px solid rgba(255,255,255,.05);">
                <div style="font-size:8px;color:#1e3a52;">Loan eligible</div>
                <div style="font-size:12px;font-weight:600;color:#f7c355;">₦150,000</div>
              </div>
            </div>
          </div>
          <!-- ctas -->
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:10px;">
            <div style="background:rgba(34,199,138,.07);border:1px solid rgba(34,199,138,.15);border-radius:8px;padding:8px 4px;text-align:center;">
              <div style="font-size:13px;margin-bottom:2px;">+</div><div style="font-size:8px;color:#1e5a3a;">Deposit</div>
            </div>
            <div style="background:rgba(240,82,82,.07);border:1px solid rgba(240,82,82,.15);border-radius:8px;padding:8px 4px;text-align:center;">
              <div style="font-size:13px;margin-bottom:2px;color:#f05252;">−</div><div style="font-size:8px;color:#3a1e1e;">Withdraw</div>
            </div>
            <div style="background:rgba(247,195,85,.07);border:1px solid rgba(247,195,85,.15);border-radius:8px;padding:8px 4px;text-align:center;">
              <div style="font-size:13px;margin-bottom:2px;">₦</div><div style="font-size:8px;color:#3a2e1a;">Loan</div>
            </div>
            <div style="background:rgba(79,142,247,.07);border:1px solid rgba(79,142,247,.15);border-radius:8px;padding:8px 4px;text-align:center;">
              <div style="font-size:13px;margin-bottom:2px;color:#4f8ef7;">↩</div><div style="font-size:8px;color:#1a2a3a;">Repay</div>
            </div>
          </div>
          <!-- nav pills -->
          <div style="display:flex;gap:5px;flex-wrap:wrap;">
            <div style="padding:3px 9px;border-radius:20px;background:rgba(79,142,247,.1);border:1px solid rgba(79,142,247,.2);font-size:8px;color:#4f8ef7;">Transactions</div>
            <div style="padding:3px 9px;border-radius:20px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);font-size:8px;color:#1e3a52;">Loans</div>
            <div style="padding:3px 9px;border-radius:20px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);font-size:8px;color:#1e3a52;">Reports</div>
            <div style="padding:3px 9px;border-radius:20px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);font-size:8px;color:#1e3a52;">Guarantor</div>
            <div style="padding:3px 9px;border-radius:20px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);font-size:8px;color:#1e3a52;">Kiddies</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scene 8: call to action finale -->
    <div class="sc sc-tint-none" id="s8" style="background:#03070f;">
      <div style="text-align:center;width:min(90%,560px);">
        <div id="s8logo" style="opacity:0;margin-bottom:18px;">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" style="display:block;margin:0 auto;">
            <circle cx="32" cy="32" r="29" stroke="#0c2236" stroke-width="1.5"/>
            <circle cx="32" cy="32" r="29" stroke="#5cc8ff" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="140" stroke-dashoffset="35" transform="rotate(-90 32 32)"/>
            <circle cx="32" cy="3" r="3.5" fill="#5cc8ff"/>
            <text x="32" y="32" text-anchor="middle" dominant-baseline="central" fill="#5cc8ff" font-size="14" font-weight="700" font-family="'Segoe UI',sans-serif">CB</text>
          </svg>
        </div>
        <div class="eyebrow" id="s8e">Start your journey today</div>
        <div class="headline" id="s8h">Cloud<span class="hi">BAAM</span></div>
        <div class="subline" id="s8s" style="font-size:clamp(11px,1.8vw,14px);color:#2e6080;margin-top:6px;">Save. Earn. Borrow. Grow.<br>Club De Stars Cooperative — powered by JESZ Limited.</div>
        <div class="stat-row" id="s8r">
          <div class="stat stat-b">Join now</div>
          <div class="stat stat-g">₦5,000 to start</div>
        </div>
        <div id="s8sub" style="margin-top:16px;font-size:9px;color:#0f2030;letter-spacing:.12em;opacity:0;">A product of JESZ Limited</div>
      </div>
    </div>

  </div>

  <div id="prog"><div id="progfill"></div></div>
  <div id="chap-indicator">CloudBAAM</div>
  <button id="cta-btn" onclick="startShow()">↺ Replay</button>

  <div id="so" onclick="startShow()">
    <div class="stitle">CloudBAAM · Cooperative Platform</div>
    <div class="ring"><div class="tri"></div></div>
    <div class="stxt">Play story</div>
  </div>
</div>

<style>
@keyframes orbs{to{transform:rotate(360deg);}}
</style>

<script>
const TOTAL = 52000;
let raf, t0, playing = false;
const $ = id => document.getElementById(id);

/* ─── audio ─── */
let ax;
function audio(){if(!ax){ax=new(window.AudioContext||window.webkitAudioContext)();}if(ax.state==='suspended')ax.resume();}
function tone(f,d,v=.05,t='sine',a=.008){
  if(!ax)return;
  const g=ax.createGain(),o=ax.createOscillator();
  o.type=t;o.frequency.value=f;
  g.gain.setValueAtTime(0,ax.currentTime);
  g.gain.linearRampToValueAtTime(v,ax.currentTime+a);
  g.gain.exponentialRampToValueAtTime(.0001,ax.currentTime+d);
  o.connect(g);g.connect(ax.destination);o.start();o.stop(ax.currentTime+d+.05);
}
function chord(fs,d,v=.04){fs.forEach(f=>tone(f,d,v));}
function whoosh(){[200,280,380,480].forEach((f,i)=>setTimeout(()=>tone(f,.12,.03,'sine'),i*30));}
function riseUp(){chord([261.6,329.6,392],.35,.04);}
function shimmer(){[880,1100,1320].forEach((f,i)=>setTimeout(()=>tone(f,.08,.025),i*55));}
function success(){[523,659,784,1047].forEach((f,i)=>setTimeout(()=>tone(f,.14,.04),i*80));}
function coinSound(){[800,1000,1200].forEach((f,i)=>setTimeout(()=>tone(f,.1,.04,'triangle'),i*60));}
function deepBoom(){tone(60,.8,.08,'sine');tone(80,.6,.06,'sine');}
function barPop(){tone(440,.07,.04,'square');}
function click(){tone(600,.04,.04,'square');}
function finalFanfare(){[523,659,784,659,784,1047,784,1047,1318].forEach((f,i)=>setTimeout(()=>tone(f,i===8?.5:.13,.05),i*85));}
function ambientDrone(freq,dur){
  if(!ax)return;
  const g=ax.createGain(),o=ax.createOscillator();
  o.type='sine';o.frequency.value=freq;
  g.gain.setValueAtTime(0,ax.currentTime);
  g.gain.linearRampToValueAtTime(.02,ax.currentTime+.5);
  g.gain.linearRampToValueAtTime(0,ax.currentTime+dur);
  o.connect(g);g.connect(ax.destination);o.start();o.stop(ax.currentTime+dur+.1);
}

/* ─── stars ─── */
function initStars(){
  const c=$('stars'),w=c.parentElement.offsetWidth,h=c.parentElement.offsetHeight;
  c.width=w;c.height=h;
  const ctx=c.getContext('2d');
  let t2=0;
  (function tw(){
    t2+=.008;ctx.clearRect(0,0,w,h);
    for(let i=0;i<220;i++){
      const x=(i*w/220+Math.sin(t2+i)*.4+w)%w;
      const y=(i*h/220+Math.cos(t2*.7+i*.5)*.3+h)%h;
      const r=.4+Math.sin(t2*2+i*.4)*.3;
      const a=.05+Math.abs(Math.sin(t2+i*.3))*.3;
      ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);
      ctx.fillStyle='rgba(92,200,255,'+a.toFixed(2)+')';ctx.fill();
    }
    if(playing)requestAnimationFrame(tw);
  })();
}

/* ─── easing ─── */
function ease(t){return t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2;}
function easeOut(t){return 1-Math.pow(1-t,3);}
function clamp(v){return Math.max(0,Math.min(1,v));}
function seg(ms,s,e){return clamp((ms-s)/(e-s));}
function lerp(a,b,t){return a+(b-a)*t;}

/* ─── show/hide helpers ─── */
function show(el,op){if(typeof el==='string')el=$(el);if(el)el.style.opacity=String(op);}
function tr(el,ty,op){if(typeof el==='string')el=$(el);if(!el)return;el.style.opacity=String(op);el.style.transform='translateY('+ty+'px)';}
function hideAll(){['s0','s1','s2','s3','s4','s5','s6','s7','s8'].forEach(id=>show(id,0));}

/* ─── chapter labels ─── */
const chapters=['CloudBAAM','The Problem','Solution','Join','Save & Earn','Withdraw','Loans','Dashboard','Get Started'];

/* ─── sound fire map ─── */
const sf=new Set();
function sc(ms){
  const cues=[
    [0,    ()=>deepBoom()],
    [2000, ()=>riseUp()],
    [2800, ()=>ambientDrone(55,6)],
    [6000, ()=>whoosh()],
    [7000, ()=>ambientDrone(65,5)],
    [12000,()=>whoosh()],
    [13000,()=>shimmer()],
    [13500,()=>ambientDrone(70,5)],
    [18000,()=>whoosh()],
    [19000,()=>coinSound()],
    [19500,()=>ambientDrone(60,6)],
    [25000,()=>whoosh()],
    [26000,()=>riseUp()],
    [30000,()=>whoosh()],
    [31000,()=>coinSound()],
    [31500,()=>ambientDrone(65,6)],
    [37000,()=>whoosh()],
    [38000,()=>success()],
    [38500,()=>ambientDrone(70,5)],
    [44000,()=>whoosh()],
    [45000,()=>shimmer()],
    [49000,()=>finalFanfare()],
  ];
  cues.forEach(([t,fn])=>{if(ms>=t&&!sf.has(t)){sf.add(t);try{fn();}catch(e){}}});
}

/* ─── main timeline ─── */
function tl(ms){
  $('progfill').style.width=(ms/TOTAL*100)+'%';
  const ci=$('chap-indicator');

  /* helper: fade a group of elements in sequence */
  function seq(items,baseMs,delay=200){
    items.forEach(([id,extraDelay],i)=>{
      const t=ease(clamp((ms-baseMs-i*delay-(extraDelay||0))/450));
      tr(id,lerp(10,0,t),t);
    });
  }

  /* ══ S0: cold open 0–2s ══ */
  const s0op = ms<2200 ? ease(clamp(ms/400))*(1-ease(clamp((ms-1600)/500))) : 0;
  show('s0',s0op);
  if(ms<2200) tr('s0e',lerp(6,0,ease(clamp(ms/400))),ease(clamp(ms/400)));
  else tr('s0e',0,0);

  /* ══ S1: the problem 2s–8s ══ */
  const S1S=2000,S1E=8000;
  const s1=ease(clamp((ms-S1S)/600))*(1-ease(clamp((ms-7200)/800)));
  show('s1',s1);
  if(ms>S1S&&ms<S1E){
    ci.textContent=chapters[1];ci.style.opacity='1';
    seq([['s1e',0],['s1h',100],['s1s',300],['s1r',500]],S1S+300);
  }

  /* ══ S2: introduce CloudBAAM 8s–14s ══ */
  const S2S=8000,S2E=14000;
  const s2=ease(clamp((ms-S2S)/600))*(1-ease(clamp((ms-13200)/800)));
  show('s2',s2);
  if(ms>S2S&&ms<S2E){
    ci.textContent=chapters[2];
    seq([['s2e',0],['s2h',100],['s2s',300]],S2S+300);
    const lt=ease(clamp((ms-S2S-800)/700));
    show('s2logo',lt);$('s2logo').style.transform='scale('+lerp(.8,1,lt)+')';
  }

  /* ══ S3: join 14s–20s ══ */
  const S3S=14000,S3E=20000;
  const s3=ease(clamp((ms-S3S)/600))*(1-ease(clamp((ms-19200)/800)));
  show('s3',s3);
  if(ms>S3S&&ms<S3E){
    ci.textContent=chapters[3];
    seq([['s3e',0],['s3h',100],['s3s',300],['s3r',500]],S3S+300);
    const pt=ease(clamp((ms-S3S-500)/700));
    show('s3phone',pt);$('s3phone').style.transform='translateY('+lerp(20,0,pt)+'px) scale('+lerp(.93,1,pt)+')';
  }

  /* ══ S4: save & ROI 20s–27s ══ */
  const S4S=20000,S4E=27000;
  const s4=ease(clamp((ms-S4S)/600))*(1-ease(clamp((ms-26200)/800)));
  show('s4',s4);
  if(ms>S4S&&ms<S4E){
    ci.textContent=chapters[4];
    seq([['s4e',0],['s4h',100],['s4s',300],['s4r',500]],S4S+400);
    const ct=ease(clamp((ms-S4S-300)/700));
    show('s4chart',ct);$('s4chart').style.transform='translateY('+lerp(16,0,ct)+'px)';
    // animate bars
    const barTargets=[30,45,55,65,78,92];
    const barT=clamp((ms-S4S-600)/2000);
    barTargets.forEach((pct,i)=>{
      const bt=ease(clamp((ms-S4S-600-i*120)/600));
      $('cb'+i).style.height=(bt*pct)+'%';
    });
    // ROI counter
    const rv=clamp((ms-S4S-800)/2500);
    $('roi-val').textContent='₦'+Math.round(rv*1250).toLocaleString();
    if(ms>S4S+700&&ms<S4S+730) barPop();
  }

  /* ══ S5: withdrawals 27s–33s ══ */
  const S5S=27000,S5E=33000;
  const s5=ease(clamp((ms-S5S)/600))*(1-ease(clamp((ms-32200)/800)));
  show('s5',s5);
  if(ms>S5S&&ms<S5E){
    ci.textContent=chapters[5];
    seq([['s5e',0],['s5h',100],['s5s',300],['s5r',500]],S5S+300);
    const tlt=ease(clamp((ms-S5S-800)/600));
    show('s5timeline',tlt);$('s5timeline').style.transform='translateY('+lerp(10,0,tlt)+'px)';
  }

  /* ══ S6: loans 33s–40s ══ */
  const S6S=33000,S6E=40000;
  const s6=ease(clamp((ms-S6S)/600))*(1-ease(clamp((ms-39200)/800)));
  show('s6',s6);
  if(ms>S6S&&ms<S6E){
    ci.textContent=chapters[6];
    seq([['s6e',0],['s6h',100],['s6s',300],['s6r',500]],S6S+300);
    const lt=ease(clamp((ms-S6S-400)/700));
    show('s6loan',lt);$('s6loan').style.transform='translateY('+lerp(16,0,lt)+'px)';
    const bt=ease(clamp((ms-S6S-1400)/400));
    show('s6btn',bt);
  }

  /* ══ S7: dashboard 40s–47s ══ */
  const S7S=40000,S7E=47000;
  const s7=ease(clamp((ms-S7S)/600))*(1-ease(clamp((ms-46200)/800)));
  show('s7',s7);
  if(ms>S7S&&ms<S7E){
    ci.textContent=chapters[7];
    seq([['s7e',0],['s7h',100]],S7S+300);
    const dt=ease(clamp((ms-S7S-500)/700));
    show('s7dash',dt);$('s7dash').style.transform='translateY('+lerp(14,0,dt)+'px)';
    const cv=clamp((ms-S7S-700)/2000);
    $('dashcnt').textContent=Math.round(cv*50000).toLocaleString();
  }

  /* ══ S8: finale 47s–end ══ */
  const S8S=47000;
  const s8=ease(clamp((ms-S8S)/700));
  show('s8',s8);
  if(ms>S8S){
    ci.textContent=chapters[8];
    const lt=ease(clamp((ms-S8S-200)/700));
    show('s8logo',lt);$('s8logo').style.transform='scale('+lerp(.8,1,lt)+')';
    seq([['s8e',0],['s8h',100],['s8s',250],['s8r',400]],S8S+600);
    const sub=ease(clamp((ms-S8S-1800)/600));
    show('s8sub',sub);
  }

  /* replay button */
  if(ms>=TOTAL){
    show('cta-btn',1);
  }
}

function frame(ts){
  const ms=ts-t0;
  if(ms>=TOTAL){tl(TOTAL);playing=false;return;}
  tl(ms);sc(ms);
  raf=requestAnimationFrame(frame);
}

function startShow(){
  audio();
  $('so').style.display='none';
  if(raf)cancelAnimationFrame(raf);
  sf.clear();
  hideAll();

  /* reset animated elements */
  ['s0e','s1e','s1h','s1s','s1r','s2e','s2h','s2s','s3e','s3h','s3s','s3r',
   's4e','s4h','s4s','s4r','s5e','s5h','s5s','s5r','s6e','s6h','s6s','s6r',
   's7e','s7h','s8e','s8h','s8s','s8r','s8sub'].forEach(id=>{
    const el=$(id);if(el){el.style.opacity='0';el.style.transform='translateY(10px)';}
  });
  ['s2logo','s3phone','s4chart','s6loan','s6btn','s7dash','s8logo','s5timeline'].forEach(id=>{
    const el=$(id);if(el){el.style.opacity='0';}
  });
  for(let i=0;i<6;i++){const b=$('cb'+i);if(b)b.style.height='0%';}
  $('roi-val').textContent='₦0';
  $('dashcnt').textContent='0';
  $('progfill').style.width='0';
  show('cta-btn',0);
  $('chap-indicator').style.opacity='0';

  playing=true;
  initStars();
  requestAnimationFrame(ts=>{t0=ts;raf=requestAnimationFrame(frame);});
}
</script>
