<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Club De Stars Cooperative</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .gradient-bg { background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%); }

        @keyframes fadeIn  { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
        @keyframes shake   { 0%,100%{transform:translateX(0)} 10%,30%,50%,70%,90%{transform:translateX(-8px)} 20%,40%,60%,80%{transform:translateX(8px)} }
        @keyframes spin    { to{transform:rotate(360deg)} }
        @keyframes float   { 0%,100%{transform:translateY(0);opacity:.4} 50%{transform:translateY(-14px);opacity:1} }
        @keyframes slideUp { from{transform:translateY(40px);opacity:0} to{transform:none;opacity:1} }

        .fade-in { animation: fadeIn 0.5s ease-out forwards; }
        .shake   { animation: shake 0.45s ease-in-out; }

        /* ── Loader ── */
        .loader-screen {
            position:fixed;inset:0;background:linear-gradient(135deg,#0a1a2f,#102a44);
            display:flex;justify-content:center;align-items:center;z-index:9999;
        }
        .logo span {
            font-size:52px;font-weight:600;color:#5cc8ff;
            display:inline-block;animation:float 1.5s infinite ease-in-out;letter-spacing:1px;
        }
        .logo span:nth-child(1){animation-delay:0s}  .logo span:nth-child(2){animation-delay:.1s}
        .logo span:nth-child(3){animation-delay:.2s} .logo span:nth-child(4){animation-delay:.3s}
        .logo span:nth-child(5){animation-delay:.4s} .logo span:nth-child(6){animation-delay:.5s}
        .logo span:nth-child(7){animation-delay:.6s} .logo span:nth-child(8){animation-delay:.7s}
        .logo span:nth-child(9){animation-delay:.8s}

        /* ── Alerts ── */
        .alert { border-radius:.75rem;padding:.9rem 1rem;margin-bottom:1rem;display:flex;align-items:center;gap:.75rem;font-size:13px; }
        .alert-error   { background:#fef2f2;border:1px solid #fecaca;color:#991b1b; }
        .alert-success { background:#f0fdf4;border:1px solid #bbf7d0;color:#166534; }

        /* ── Form ── */
        .pw-toggle { cursor:pointer;position:absolute;right:1rem;top:50%;transform:translateY(-50%);color:#6b7280;transition:color .2s; }
        .pw-toggle:hover { color:#1e40af; }
        .input-rel { position:relative; }
        .btn-spin { position:relative;pointer-events:none;color:transparent !important; }
        .btn-spin::after {
            content:"";position:absolute;width:18px;height:18px;top:50%;left:50%;
            margin:-9px 0 0 -9px;border:2px solid #fff;border-radius:50%;
            border-top-color:transparent;animation:spin .6s linear infinite;
        }

        /* ── Status modal overlay ── */
        .s-overlay {
            display:none;position:fixed;inset:0;z-index:9900;
            background:rgba(0,0,0,.65);backdrop-filter:blur(6px);
            align-items:flex-end;justify-content:center;
        }
        .s-overlay.open { display:flex; }
        .s-card {
            background:#fff;border-radius:20px 20px 0 0;width:100%;max-width:480px;
            max-height:92vh;overflow-y:auto;padding:24px 20px 36px;
            animation:slideUp .3s cubic-bezier(.16,1,.3,1);
        }
        .s-card::-webkit-scrollbar{width:3px}
        .s-card::-webkit-scrollbar-thumb{background:#e5e7eb;border-radius:4px;}
        .s-handle { width:36px;height:4px;background:#e5e7eb;border-radius:2px;margin:0 auto 18px; }

        /* ── Modal content ── */
        .s-icon  { width:62px;height:62px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 12px; }
        .s-badge { display:inline-flex;align-items:center;gap:5px;padding:3px 12px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px; }
        .s-title { font-size:19px;font-weight:700;color:#111827;margin-bottom:6px;line-height:1.3; }
        .s-body  { font-size:13px;color:#6b7280;line-height:1.6;margin-bottom:14px; }

        .info-box { background:#f8fafc;border:1px solid #e5e7eb;border-radius:12px;padding:12px 14px;margin-bottom:14px;text-align:left; }
        .info-row { display:flex;justify-content:space-between;align-items:center;padding:5px 0;font-size:13px;border-bottom:1px solid #f1f5f9; }
        .info-row:last-child { border-bottom:none; }
        .info-lbl { color:#9ca3af;font-size:11px;text-transform:uppercase;letter-spacing:.06em; }
        .info-val { font-weight:600;font-size:13px;color:#111827; }

        .bank-box { background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;padding:14px;margin-bottom:14px;text-align:left; }
        .bank-row { display:flex;justify-content:space-between;align-items:center;padding:5px 0;font-size:13px;border-bottom:1px solid #e0f2fe; }
        .bank-row:last-child { border-bottom:none; }
        .copy-btn { background:#dbeafe;color:#1d4ed8;border:none;border-radius:6px;padding:3px 10px;font-size:11px;cursor:pointer;font-weight:600;transition:background .2s; }
        .copy-btn:hover { background:#bfdbfe; }

        .pay-card { border:2px solid #e5e7eb;border-radius:12px;padding:14px;cursor:pointer;transition:all .2s;background:#fff;margin-bottom:8px; }
        .pay-card:hover { border-color:#3b82f6;background:#eff6ff; }
        .pay-card.sel   { border-color:#1d4ed8;background:#eff6ff;box-shadow:0 0 0 3px rgba(59,130,246,.12); }
        .pay-card-icon  { width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0; }

        .ferr { color:#ef4444;font-size:12px;margin-top:4px;display:none; }
        .ferr.show { display:block; }

        .m-btn { width:100%;padding:12px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:all .2s;margin-bottom:8px;display:block;text-align:center;text-decoration:none; }
        .m-btn-primary   { background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:#fff; }
        .m-btn-primary:hover { opacity:.88; }
        .m-btn-secondary { background:none;border:1px solid #e5e7eb;color:#6b7280; }
        .m-btn-secondary:hover { background:#f9fafb; }
        .m-btn-danger    { background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.2);color:#dc2626; }

        .spin-ring { border:3px solid rgba(255,255,255,.3);border-top:3px solid #fff;border-radius:50%;width:16px;height:16px;animation:spin 1s linear infinite;display:inline-block;vertical-align:middle;margin-left:8px; }

        .notice-green { background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px;font-size:12px;color:#166534;margin-bottom:14px; }
        .notice-red   { background:#fef2f2;border:1px solid #fca5a5;border-radius:10px;padding:12px;font-size:12px;color:#991b1b;margin-bottom:14px; }
        .notice-amber { background:#fffbeb;border:1px solid #fcd34d;border-radius:10px;padding:12px;font-size:12px;color:#92400e;margin-bottom:14px; }

        @media(min-width:640px) {
            .s-overlay { align-items:center;padding:20px; }
            .s-card    { border-radius:20px;max-height:88vh;padding:32px 28px; }
            .s-handle  { display:none; }
        }
    </style>
</head>
<body class="bg-gray-50">

<!-- ── Loader ── -->
<div id="loader-screen" class="loader-screen">
    <div class="logo">
        <span>C</span><span>l</span><span>u</span><span>b</span><span>D</span><span>e</span><span>S</span><span>t</span><span>a</span>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════
     ALL STATUS MODALS  (always in DOM, opened via JS)
════════════════════════════════════════════════════════ -->

<!-- MODAL 1 — Payment Pending -->
<div class="s-overlay" id="m-payment-pending">
  <div class="s-card">
    <div class="s-handle"></div>
    <div class="s-icon" id="pp-icon" style="background:#fffbeb;color:#d97706;">
      <i class="fas fa-clock" id="pp-icon-i"></i>
    </div>
    <div class="text-center">
      <div class="s-badge" id="pp-badge" style="background:#fef3c7;color:#92400e;border:1px solid #fcd34d;">
        <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
        <span id="pp-badge-txt">Awaiting Approval</span>
      </div>
      <div class="s-title" id="pp-title">Payment Pending Approval</div>
      <div class="s-body"  id="pp-body">Your registration payment has been submitted and is awaiting admin confirmation. This usually takes up to 30 minutes during business hours.</div>
    </div>
    <div class="info-box">
      <div class="info-row"><span class="info-lbl">Submitted</span><span class="info-val" id="pp-submitted">—</span></div>
      <div class="info-row"><span class="info-lbl">Method</span><span class="info-val" id="pp-method">—</span></div>
      <div class="info-row"><span class="info-lbl">Status</span><span class="info-val" style="color:#d97706;">Pending Admin Review</span></div>
    </div>
    <!-- Shown when > 24 hrs -->
    <div id="pp-over24" style="display:none;">
      <div class="notice-red"><i class="fas fa-exclamation-circle mr-1"></i>It's been over 24 hours. Please contact the admin with your transfer receipt to resolve this.</div>
      <a href="mailto:support@clubdestars.com" class="m-btn m-btn-danger"><i class="fas fa-envelope mr-1"></i>Contact Admin</a>
    </div>
    <!-- Shown when < 24 hrs -->
    <div id="pp-normal">
      <div class="notice-green"><i class="fas fa-info-circle mr-1"></i>You'll receive an email notification once your payment is confirmed and your account is activated.</div>
    </div>
    <button class="m-btn m-btn-secondary" onclick="closeModal('m-payment-pending')">Back to Login</button>
  </div>
</div>

<!-- MODAL 2 — Payment Approved, Account Still Pending -->
<div class="s-overlay" id="m-account-pending">
  <div class="s-card">
    <div class="s-handle"></div>
    <div class="s-icon" style="background:#eff6ff;color:#2563eb;"><i class="fas fa-user-clock"></i></div>
    <div class="text-center">
      <div class="s-badge" style="background:#eff6ff;color:#1e40af;border:1px solid #bfdbfe;">
        <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
        Under Review
      </div>
      <div class="s-title">Payment Confirmed</div>
      <div class="s-body">Your registration payment has been approved. Your account details are currently being reviewed by our team and will be activated shortly.</div>
    </div>
    <div class="notice-amber"><i class="fas fa-info-circle mr-1"></i>If your account hasn't been activated within 24 hours, please contact support.</div>
    <a href="mailto:support@clubdestars.com" class="m-btn m-btn-primary"><i class="fas fa-envelope mr-1"></i>Contact Support</a>
    <button class="m-btn m-btn-secondary" onclick="closeModal('m-account-pending')">Back to Login</button>
  </div>
</div>

<!-- MODAL 3 — Deactivated: Pay to Reactivate -->
<div class="s-overlay" id="m-deactivated">
  <div class="s-card">
    <div class="s-handle"></div>
    <div class="s-icon" style="background:#fef2f2;color:#dc2626;"><i class="fas fa-user-slash"></i></div>
    <div class="text-center">
      <div class="s-badge" style="background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;">
        <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
        Deactivated
      </div>
      <div class="s-title">Account Deactivated</div>
      <div class="s-body">Your account has been deactivated. Pay the registration fee of <strong id="dc-fee-display">₦0</strong> to reactivate your access.</div>
    </div>

    <!-- Step 1: Choose method -->
    <div id="deact-step1">
      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#9ca3af;margin-bottom:10px;">Choose Payment Method</p>
      <div class="pay-card" id="dc-card-paystack" onclick="selectDeactPay('paystack')">
        <div style="display:flex;align-items:center;gap:12px;">
          <div class="pay-card-icon" style="background:#dcfce7;"><i class="fas fa-bolt" style="color:#16a34a;"></i></div>
          <div style="flex:1;">
            <div style="font-size:13px;font-weight:600;color:#111;">Paystack
              <span style="background:#dcfce7;color:#166534;font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;margin-left:4px;">Instant</span>
            </div>
            <div style="font-size:11px;color:#9ca3af;">Card, bank transfer or USSD</div>
          </div>
          <div style="width:18px;height:18px;border-radius:50%;border:2px solid #d1d5db;flex-shrink:0;display:flex;align-items:center;justify-content:center;" id="dc-ri-paystack"></div>
        </div>
      </div>
      <div class="pay-card" id="dc-card-manual" onclick="selectDeactPay('manual')">
        <div style="display:flex;align-items:center;gap:12px;">
          <div class="pay-card-icon" style="background:#dbeafe;"><i class="fas fa-university" style="color:#1d4ed8;"></i></div>
          <div style="flex:1;">
            <div style="font-size:13px;font-weight:600;color:#111;">Manual Bank Transfer</div>
            <div style="font-size:11px;color:#9ca3af;">Activated after admin confirms</div>
          </div>
          <div style="width:18px;height:18px;border-radius:50%;border:2px solid #d1d5db;flex-shrink:0;display:flex;align-items:center;justify-content:center;" id="dc-ri-manual"></div>
        </div>
      </div>
    </div>

    <!-- Step 2: Manual transfer details (shown after selecting manual) -->
    <div id="deact-step2" style="display:none;">
      <!-- Bank details — populated dynamically by JS -->
      <div class="bank-box" id="dc-bank-box" style="display:none;">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#6b7280;margin-bottom:8px;">
          <i class="fas fa-university" style="color:#3b82f6;margin-right:4px;"></i>Transfer Details
        </div>
        <div class="bank-row">
          <span style="color:#6b7280;font-size:12px;">Bank</span>
          <span style="font-weight:600;" id="dc-bank-name">—</span>
        </div>
        <div class="bank-row">
          <span style="color:#6b7280;font-size:12px;">Account Name</span>
          <span style="font-weight:600;" id="dc-acct-name">—</span>
        </div>
        <div class="bank-row">
          <span style="color:#6b7280;font-size:12px;">Account No.</span>
          <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-weight:700;font-family:monospace;font-size:14px;" id="dc-acct-num">—</span>
            <button type="button" class="copy-btn" onclick="copyDcAcct(event)">Copy</button>
          </div>
        </div>
        <div style="background:#dbeafe;border-radius:8px;padding:8px;margin-top:8px;font-size:11px;color:#1e40af;">
          <i class="fas fa-exclamation-circle mr-1"></i>Transfer exactly <strong id="dc-fee-transfer">₦0</strong> and use your full name as the narration.
        </div>
      </div>
      <!-- Shown if no bank configured -->
      <div class="notice-amber" id="dc-no-bank" style="display:none;">
        <i class="fas fa-exclamation-triangle mr-1"></i>Bank details not configured. Contact admin before proceeding.
      </div>
      <!-- Payer name -->
      <div style="margin-bottom:12px;">
        <label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#6b7280;display:block;margin-bottom:6px;">Your Name on Transfer *</label>
        <input type="text" id="dc-payer-name" placeholder="Full name used when making the transfer"
          style="width:100%;padding:10px 14px;border:1.5px solid #d1d5db;border-radius:8px;font-size:13px;outline:none;transition:border .2s;"
          onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#d1d5db'">
        <p class="ferr" id="dc-payer-err">Payer name is required.</p>
      </div>
      <div class="notice-green">
        <i class="fas fa-clock mr-1"></i>Your account will be reactivated within <strong>30 minutes</strong> once the transfer is confirmed. You'll receive an email.
      </div>
    </div>

    <!-- Hidden: stores userId populated by JS -->
    <input type="hidden" id="dc-user-id" value="">

    <p class="ferr" id="dc-method-err" style="margin-bottom:8px;">Please select a payment method.</p>

    <button class="m-btn m-btn-primary" id="dc-submit-btn" onclick="submitDeactPay()">
      <span id="dc-btn-txt">Pay to Reactivate</span>
    </button>
    <button class="m-btn m-btn-secondary" id="dc-cancel-btn" onclick="closeModal('m-deactivated')">Cancel</button>

    <!-- Success state shown after manual submission -->
    <div id="dc-success" style="display:none;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:18px;text-align:center;margin-top:4px;">
      <i class="fas fa-check-circle" style="color:#22c55e;font-size:30px;display:block;margin-bottom:10px;"></i>
      <div style="font-size:14px;font-weight:700;color:#166534;margin-bottom:4px;">Reactivation Request Submitted!</div>
      <div style="font-size:12px;color:#166534;">We'll notify you by email once your account is reactivated (usually within 30 minutes).</div>
    </div>
  </div>
</div>

<!-- MODAL 4 — Suspended -->
<div class="s-overlay" id="m-suspended">
  <div class="s-card">
    <div class="s-handle"></div>
    <div class="s-icon" style="background:#fff7ed;color:#ea580c;"><i class="fas fa-ban"></i></div>
    <div class="text-center">
      <div class="s-badge" style="background:#ffedd5;color:#c2410c;border:1px solid #fdba74;">
        <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
        Suspended
      </div>
      <div class="s-title">Account Suspended</div>
      <div class="s-body">Your account has been temporarily suspended. Please contact support to understand the reason and resolve the issue.</div>
    </div>
    <a href="mailto:support@clubdestars.com" class="m-btn m-btn-primary"><i class="fas fa-envelope mr-1"></i>Contact Support</a>
    <button class="m-btn m-btn-secondary" onclick="closeModal('m-suspended')">Back to Login</button>
  </div>
</div>

<!-- MODAL 5 — Rejected -->
<div class="s-overlay" id="m-rejected">
  <div class="s-card">
    <div class="s-handle"></div>
    <div class="s-icon" style="background:#fef2f2;color:#dc2626;"><i class="fas fa-times-circle"></i></div>
    <div class="text-center">
      <div class="s-badge" style="background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;">
        <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
        Application Rejected
      </div>
      <div class="s-title">Registration Rejected</div>
      <div class="s-body">Unfortunately your membership application was not approved. Contact support for more information or to appeal the decision.</div>
    </div>
    <a href="mailto:support@clubdestars.com" class="m-btn m-btn-primary"><i class="fas fa-envelope mr-1"></i>Contact Support</a>
    <button class="m-btn m-btn-secondary" onclick="closeModal('m-rejected')">Back to Login</button>
  </div>
</div>

<!-- MODAL 6 — No Payment / Payment Failed -->
<div class="s-overlay" id="m-no-payment">
  <div class="s-card">
    <div class="s-handle"></div>
    <div class="s-icon" id="np-icon" style="background:#fffbeb;color:#d97706;">
      <i class="fas fa-receipt" id="np-icon-i"></i>
    </div>
    <div class="text-center">
      <div class="s-badge" style="background:#fef3c7;color:#92400e;border:1px solid #fcd34d;">
        <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
        <span id="np-badge-txt">Payment Required</span>
      </div>
      <div class="s-title" id="np-title">Registration Fee Unpaid</div>
      <div class="s-body"  id="np-body">Your account was created but the registration fee hasn't been paid yet. Complete your payment to activate your account.</div>
    </div>
    <a href="/cds-cooperative" class="m-btn m-btn-primary"><i class="fas fa-credit-card mr-1"></i>Complete Registration</a>
    <button class="m-btn m-btn-secondary" onclick="closeModal('m-no-payment')">Back to Login</button>
  </div>
</div>

<!-- MODAL 7 — Deleted -->
<div class="s-overlay" id="m-deleted">
  <div class="s-card">
    <div class="s-handle"></div>
    <div class="s-icon" style="background:#fef2f2;color:#dc2626;"><i class="fas fa-user-times"></i></div>
    <div class="text-center">
      <div class="s-badge" style="background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;">
        <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
        Account Removed
      </div>
      <div class="s-title">Account No Longer Exists</div>
      <div class="s-body">This account has been permanently removed. Please contact support if you believe this is an error.</div>
    </div>
    <a href="mailto:support@clubdestars.com" class="m-btn m-btn-primary"><i class="fas fa-envelope mr-1"></i>Contact Support</a>
    <button class="m-btn m-btn-secondary" onclick="closeModal('m-deleted')">Back to Login</button>
  </div>
</div>


<!-- ════════════════════════════════════════════════════════
     MAIN CONTENT
════════════════════════════════════════════════════════ -->
<div id="main-content" style="display:none;">

    <header class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <img src="/media/assets/logo/log.png" alt=""
                         style="width:40px;height:40px;object-fit:contain;"
                         onerror="this.style.display='none'">
                    <div>
                        <h1 class="text-base font-bold text-gray-900">CLUB DE STARS</h1>
                        <p class="text-xs text-gray-600">Multipurpose Cooperative Society Ltd</p>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

            <!-- Left: Info Panel -->
            <div class="fade-in order-2 lg:order-1">
                <div class="gradient-bg rounded-3xl p-6 md:p-8 text-white mb-6">
                    <h2 class="text-2xl md:text-3xl font-bold mb-4">Welcome Back!</h2>
