    <footer class="bg-gray-900 text-white py-8 px-4 mt-16">
        <div class="max-w-7xl mx-auto text-center">
            <p class="text-gray-400 mb-2 text-sm">CLUB DE STARS MULTIPURPOSE COOPERATIVE SOCIETY LTD</p>
            <p class="text-xs text-gray-500">Powered by <a href="/" class="text-blue-400 hover:text-blue-300">JESZ LTD</a></p>
            <div class="mt-4 flex flex-wrap justify-center gap-4 text-xs text-gray-400">
                <a href="#" class="hover:text-white">Privacy Policy</a>
                <a href="#" class="hover:text-white">Terms of Service</a>
                <a href="#" class="hover:text-white">Contact Support</a>
            </div>
        </div>
    </footer>

</div><!-- /#main-content -->


<script>
/* ════════════════════════════════════════════════════════
   LOADER
════════════════════════════════════════════════════════ */
window.addEventListener('load', () => {
    const loader = document.getElementById('loader-screen');
    const main   = document.getElementById('main-content');
    setTimeout(() => {
        loader.style.opacity    = '0';
        loader.style.transition = 'opacity 0.6s ease';
        setTimeout(() => {
            loader.style.display = 'none';
            main.style.display   = 'block';
        }, 600);
    }, 1600);
});

/* ════════════════════════════════════════════════════════
   MODAL HELPERS
════════════════════════════════════════════════════════ */
function openModal(id) {
    const el = document.getElementById(id);
    if (el) { el.classList.add('open'); document.body.style.overflow = 'hidden'; }
}
function closeModal(id) {
    const el = document.getElementById(id);
    if (el) { el.classList.remove('open'); document.body.style.overflow = ''; }
}

/* ════════════════════════════════════════════════════════
   SHOW MODAL — fills in dynamic data then opens
════════════════════════════════════════════════════════ */
function showModal(state, data) {
    data = data || {};

    switch (state) {

        case 'payment_pending': {
            const over24 = !!data.over24hrs;
            // Icon
            const icon = document.getElementById('pp-icon');
            const iconI = document.getElementById('pp-icon-i');
            icon.style.background = over24 ? '#fef2f2' : '#fffbeb';
            icon.style.color      = over24 ? '#dc2626' : '#d97706';
            iconI.className       = over24 ? 'fas fa-exclamation-triangle' : 'fas fa-clock';
            // Badge
            const badge = document.getElementById('pp-badge');
            badge.style.background   = over24 ? '#fee2e2' : '#fef3c7';
            badge.style.color        = over24 ? '#991b1b' : '#92400e';
            badge.style.borderColor  = over24 ? '#fca5a5' : '#fcd34d';
            document.getElementById('pp-badge-txt').textContent = over24 ? 'Overdue Review' : 'Awaiting Approval';
            // Title & body
            document.getElementById('pp-title').textContent = over24
                ? 'Payment Not Confirmed Yet' : 'Payment Pending Approval';
            document.getElementById('pp-body').textContent = over24
                ? "Your payment was submitted over 24 hours ago and still hasn't been confirmed. Please contact admin with your transfer receipt."
                : 'Your registration payment has been submitted and is awaiting admin confirmation. This usually takes up to 30 minutes during business hours.';
            // Info rows
            document.getElementById('pp-submitted').textContent = data.submittedAt || '—';
            document.getElementById('pp-method').textContent    = data.paymentMethod === 'manual' ? 'Manual Bank Transfer' : 'Paystack';
            // Banners
            document.getElementById('pp-over24').style.display = over24 ? 'block' : 'none';
            document.getElementById('pp-normal').style.display = over24 ? 'none'  : 'block';
            openModal('m-payment-pending');
            break;
        }

        case 'account_pending':
            openModal('m-account-pending');
            break;

        case 'deactivated': {
            const acct = data.companyAccount || {};
            const fee  = data.registrationFee || 0;
            const hasBank = !!(acct.bankName && acct.accountNumber);

            // Fee display in body
            document.getElementById('dc-fee-display').textContent  = '₦' + fee.toLocaleString();
            document.getElementById('dc-fee-transfer').textContent  = '₦' + fee.toLocaleString();
            // Button label
            document.getElementById('dc-btn-txt').textContent = 'Pay ₦' + fee.toLocaleString() + ' to Reactivate';
            // userId
            document.getElementById('dc-user-id').value = data.userId || '';
            // Bank details
            document.getElementById('dc-bank-box').style.display  = hasBank ? 'block' : 'none';
            document.getElementById('dc-no-bank').style.display   = hasBank ? 'none'  : 'block';
            if (hasBank) {
                document.getElementById('dc-bank-name').textContent = acct.bankName    || '—';
                document.getElementById('dc-acct-name').textContent = acct.accountName  || '—';
                document.getElementById('dc-acct-num').textContent  = acct.accountNumber || '—';
            }
            // Reset step states
            document.getElementById('deact-step1').style.display   = 'block';
            document.getElementById('deact-step2').style.display   = 'none';
            document.getElementById('dc-submit-btn').style.display = 'block';
            document.getElementById('dc-cancel-btn').style.display = 'block';
            document.getElementById('dc-success').style.display    = 'none';
            document.getElementById('dc-submit-btn').disabled      = false;
            document.getElementById('dc-btn-txt').textContent      = 'Pay ₦' + fee.toLocaleString() + ' to Reactivate';
            dcMethod = '';
            // Deselect cards
            ['paystack','manual'].forEach(m => {
                document.getElementById(`dc-card-${m}`)?.classList.remove('sel');
                const ri = document.getElementById(`dc-ri-${m}`);
                if (ri) { ri.style.border = '2px solid #d1d5db'; ri.innerHTML = ''; }
            });
            openModal('m-deactivated');
            break;
        }

        case 'suspended':
            openModal('m-suspended');
            break;

        case 'rejected':
            openModal('m-rejected');
            break;

        case 'no_payment': {
            const fee = data.registrationFee || 0;
            document.getElementById('np-icon-i').className         = 'fas fa-receipt';
            document.getElementById('np-badge-txt').textContent    = 'Payment Required';
            document.getElementById('np-title').textContent        = 'Registration Fee Unpaid';
            document.getElementById('np-body').innerHTML           =
                `Your account was created but the registration fee of <strong>₦${fee.toLocaleString()}</strong> hasn't been paid yet. Complete your payment to activate your account.`;
            openModal('m-no-payment');
            break;
        }

        case 'payment_failed': {
            document.getElementById('np-icon-i').className         = 'fas fa-times-circle';
            document.getElementById('np-badge-txt').textContent    = 'Payment Failed';
            document.getElementById('np-title').textContent        = 'Payment Was Not Successful';
            document.getElementById('np-body').textContent         =
                'Your previous payment attempt failed. Please return to the registration page to try again.';
            openModal('m-no-payment');
            break;
        }

        case 'deleted':
            openModal('m-deleted');
            break;

        default:
            break;
    }
}

/* ════════════════════════════════════════════════════════
   LOGIN FORM — async fetch
════════════════════════════════════════════════════════ */
document.getElementById('loginForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const email  = document.getElementById('email').value.trim();
    const pw     = document.getElementById('password').value;
    const eErr   = document.getElementById('emailError');
    const pErr   = document.getElementById('passwordError');
    const btn    = document.getElementById('loginBtn');
    const errBox = document.getElementById('loginErrorBox');
    const errTxt = document.getElementById('loginErrorTxt');

    // Reset errors
    eErr.classList.add('hidden');
    pErr.classList.add('hidden');
    errBox.style.display = 'none';

    // Client-side validation
    let ok = true;
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        eErr.textContent = email ? 'Enter a valid email address' : 'Email is required';
        eErr.classList.remove('hidden');
        document.getElementById('email').classList.add('shake');
        setTimeout(() => document.getElementById('email').classList.remove('shake'), 500);
        ok = false;
    }
    if (!pw) {
        pErr.textContent = 'Password is required';
        pErr.classList.remove('hidden');
        document.getElementById('password').classList.add('shake');
        setTimeout(() => document.getElementById('password').classList.remove('shake'), 500);
        ok = false;
    }
    if (!ok) return;

    // Show spinner
    btn.classList.add('btn-spin');

    try {
        const res  = await fetch('/login', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ email, password: pw }),
        });
        const data = await res.json();
        btn.classList.remove('btn-spin');

        // ── Credentials invalid ───────────────────────────────────
        if (!data.success) {
            errTxt.textContent   = data.error || 'Login failed. Please try again.';
            errBox.style.display = 'flex';
            return;
        }

        // ── Go to dashboard ───────────────────────────────────────
        if (data.accountState === 'dashboard') {
            window.location.href = '/cds-cooperative/dashboard';
            return;
        }

        // ── Show status modal ─────────────────────────────────────
        showModal(data.accountState, data.stateData);

    } catch (err) {
        btn.classList.remove('btn-spin');
        errTxt.textContent   = 'Network error. Please check your connection and try again.';
        errBox.style.display = 'flex';
    }
});

/* ════════════════════════════════════════════════════════
   PASSWORD TOGGLE
════════════════════════════════════════════════════════ */
function togglePassword() {
    const inp = document.getElementById('password');
    const ico = document.getElementById('togglePw');
    inp.type = inp.type === 'password' ? 'text' : 'password';
    ico.classList.toggle('fa-eye');
    ico.classList.toggle('fa-eye-slash');
}

/* ════════════════════════════════════════════════════════
   DEACTIVATED MODAL — Reactivation Flow
════════════════════════════════════════════════════════ */
let dcMethod = '';

function selectDeactPay(method) {
    dcMethod = method;
    ['paystack', 'manual'].forEach(m => {
        const card = document.getElementById(`dc-card-${m}`);
        const ri   = document.getElementById(`dc-ri-${m}`);
        if (m === method) {
            card.classList.add('sel');
            ri.style.border = '2px solid #1d4ed8';
            ri.innerHTML    = '<div style="width:10px;height:10px;border-radius:50%;background:#1d4ed8;"></div>';
        } else {
            card.classList.remove('sel');
            ri.style.border = '2px solid #d1d5db';
            ri.innerHTML    = '';
        }
    });
    document.getElementById('deact-step2').style.display = method === 'manual' ? 'block' : 'none';
    document.getElementById('dc-btn-txt').textContent    = method === 'paystack'
        ? 'Continue to Paystack'
        : 'Submit Reactivation Request';
    document.getElementById('dc-method-err').classList.remove('show');
}

function copyDcAcct(e) {
    const num = document.getElementById('dc-acct-num')?.textContent.trim();
    if (!num || num === '—') return;
    navigator.clipboard.writeText(num).then(() => {
        const btn = e.target;
        const orig = btn.textContent;
        btn.textContent        = 'Copied!';
        btn.style.background   = '#bbf7d0';
        setTimeout(() => { btn.textContent = orig; btn.style.background = ''; }, 2000);
    });
}

async function submitDeactPay() {
    // Clear errors
    document.getElementById('dc-method-err').classList.remove('show');
    document.getElementById('dc-payer-err')?.classList.remove('show');

    // Validate
    if (!dcMethod) {
        document.getElementById('dc-method-err').classList.add('show');
        return;
    }
    if (dcMethod === 'manual') {
        const payer = document.getElementById('dc-payer-name')?.value.trim();
        if (!payer) {
            document.getElementById('dc-payer-err').classList.add('show');
            return;
        }
    }

    const btn    = document.getElementById('dc-submit-btn');
    const btnTxt = document.getElementById('dc-btn-txt');
    const userId = document.getElementById('dc-user-id').value;

    btn.disabled     = true;
    btnTxt.innerHTML = 'Processing… <span class="spin-ring"></span>';

    try {
        const res  = await fetch('/login/reactivate', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({
                userId,
                paymentMethod: dcMethod,
                payerName:     document.getElementById('dc-payer-name')?.value.trim() || '',
            }),
        });
        const data = await res.json();
        btn.disabled = false;

        // Paystack redirect
        if (data.authorization_url) {
            window.location.href = data.authorization_url;
            return;
        }

        // Manual submitted successfully
        if (data.manualPending) {
            document.getElementById('deact-step1').style.display   = 'none';
            document.getElementById('deact-step2').style.display   = 'none';
            document.getElementById('dc-submit-btn').style.display = 'none';
            document.getElementById('dc-cancel-btn').style.display = 'none';
            document.getElementById('dc-success').style.display    = 'block';
            return;
        }

        // Error from server
        btnTxt.textContent = 'Pay to Reactivate';
        alert(data.message || 'Something went wrong. Please try again.');

    } catch (err) {
        btn.disabled       = false;
        btnTxt.textContent = 'Pay to Reactivate';
        alert('Network error. Please try again.');
    }
}
</script>

