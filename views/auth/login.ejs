                    </div>
                </div>
                <div class="bg-blue-50 rounded-2xl p-4 md:p-6 border border-blue-100">
                    <h3 class="font-bold text-gray-900 text-lg mb-3">Need Help?</h3>
                    <ul class="space-y-2 text-sm text-gray-700">
                        <li class="flex items-center">
                            <i class="fas fa-envelope text-blue-900 mr-2 w-5 text-center"></i>
                            <a href="mailto:support@clubdestars.com" class="hover:text-blue-900">support@clubdestars.com</a>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-phone text-blue-900 mr-2 w-5 text-center"></i>
                            <a href="tel:+2341234567890" class="hover:text-blue-900">+234 123 456 7890</a>
