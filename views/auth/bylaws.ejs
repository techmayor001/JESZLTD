    <div id="main-content" class="hidden">
        
        <!-- Header -->
        <header class="bg-white shadow-sm">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                <div class="flex justify-between items-center">
                    <div>
                        <h1 class="text-xl font-bold text-gray-900">CLUB DE STARS</h1>
                        <p class="text-sm text-gray-600">Multipurpose Cooperative Society Ltd</p>
                    </div>
                </div>
            </div>
        </header>
    
        <!-- Main Content -->
        <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
            <div class="fade-in">
                <!-- Page Title -->
                <div class="text-center mb-8 sm:mb-12">
                    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Bylaws & Terms of Service</h1>
                    <p class="text-gray-600 max-w-2xl mx-auto">
                        Please read these bylaws and terms carefully before joining our cooperative society.
                    </p>
                </div>
    
                <!-- Navigation Tabs -->
                <div class="nav-tabs">
                    <div class="nav-tab active" onclick="switchTab('bylaws')">
                        <i class="fas fa-book mr-2"></i>Bylaws
                    </div>
                    <div class="nav-tab" onclick="switchTab('terms')">
                        <i class="fas fa-file-contract mr-2"></i>Terms & Conditions
                    </div>
                    <div class="nav-tab" onclick="switchTab('privacy')">
                        <i class="fas fa-shield-alt mr-2"></i>Privacy Policy
                    </div>
                </div>
    
                <!-- Bylaws Content -->
                <div id="bylaws" class="tab-content active">
                    <div class="section-card">
                        <div class="flex items-start mb-4">
                            <span class="article-number">1</span>
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-gray-900 mb-3">Membership</h2>
                                <p class="text-gray-700 mb-4">Membership shall be opened to Club and Non-club members:</p>
                                
                                <div class="space-y-4">
                                    <div class="sub-item">
                                        <strong class="text-gray-900">1. Club Members:</strong>
                                        <p class="text-gray-700 mt-1">Registered members of Club De Stars Worldwide.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">2. Non-Club Members:</strong>
                                        <p class="text-gray-700 mt-1">Family, friends and associates of members of Club De Stars Worldwide.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">3. Registration Fee:</strong>
                                        <p class="text-gray-700 mt-1">Membership registration shall be ₦5,000 for all categories of members.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">4. Account Categories:</strong>
                                        
                                        <div class="ml-6 mt-3 space-y-3">
                                            <div>
                                                <strong class="text-blue-900">a. Adult:</strong>
                                                <p class="text-gray-700">Members must be 18 years and above.</p>
                                            </div>
                                            
                                            <div>
                                                <strong class="text-blue-900">b. Kiddies:</strong>
                                                <p class="text-gray-700">For minors aged 1 month to 17 years. Parents/guardians shall open and manage such accounts.</p>
                                                
                                                <div class="ml-6 mt-2 space-y-2 text-sm">
                                                    <div>
                                                        <strong>i. Withdrawal Tenure:</strong> Five (5) years minimum, except in cases of:
                                                        <ul class="list-disc ml-6 mt-1">
                                                            <li>Death of the account holder</li>
                                                            <li>Permanent insanity</li>
                                                            <li>Critical medical condition (with medical report from a registered hospital)</li>
                                                        </ul>
                                                    </div>
                                                    <div>
                                                        <strong>ii.</strong> The ROI on Kiddies Accounts shall be calculated using the same formula as other accounts.
                                                    </div>
                                                    <div>
                                                        <strong>iii.</strong> Kiddies account may be upgraded to adult account once the account holder turns 18 years upon submission of account upgrade application with valid birth certificate/Declaration of age.
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div>
                                                <strong class="text-blue-900">c.</strong>
                                                <p class="text-gray-700">No loans shall be advanced on Kiddies Accounts.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <div class="section-card">
                        <div class="flex items-start mb-4">
                            <span class="article-number">2</span>
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-gray-900 mb-3">Contributions</h2>
                                
                                <div class="space-y-3">
                                    <div class="sub-item">
                                        <strong class="text-gray-900">1.</strong>
                                        <p class="text-gray-700 inline ml-2">Savings shall be made at any time, with a minimum of ₦1,000.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">2.</strong>
                                        <p class="text-gray-700 inline ml-2">Savings shall be deposited into the Cooperative's designated account provided by the operating company with proper narration.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">3.</strong>
                                        <p class="text-gray-700 inline ml-2">The Cooperative's financial year shall run from December 1st to November 30th.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <div class="section-card">
                        <div class="flex items-start mb-4">
                            <span class="article-number">3</span>
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-gray-900 mb-3">Withdrawals</h2>
                                
                                <div class="highlight-box mb-4">
                                    <strong class="text-blue-900 text-lg">On Demand Withdrawal</strong>
                                    <p class="text-gray-700 mt-1">Withdrawal outside the statutory window period set aside by the cooperative.</p>
                                </div>
                                
                                <div class="space-y-3 mb-6">
                                    <div class="sub-item">
                                        <strong class="text-gray-900">1.</strong>
                                        <p class="text-gray-700 inline ml-2">Applications for withdrawal of savings shall be processed within thirty (30) days of submission.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">2.</strong>
                                        <p class="text-gray-700 inline ml-2">Withdrawals shall be limited to two batches per financial year:</p>
                                        <div class="ml-6 mt-2 space-y-2">
                                            <p><strong>i. First Withdrawal:</strong> Up to 50% of total savings, subject to a 2.5% service charge.</p>
                                            <p><strong>ii. Second Withdrawal:</strong> Balance of savings to be withdrawn after 30 days, subject to a 2.5% service charge.</p>
                                        </div>
                                    </div>
                                </div>
    
                                <div class="highlight-box">
                                    <strong class="text-blue-900 text-lg">Open-Window Withdrawal</strong>
                                    <p class="text-gray-700 mt-1">Withdrawal within the statutory window period (December 1st – December 10th).</p>
                                </div>
                                
                                <div class="sub-item mt-3">
                                    <strong class="text-gray-900">1.</strong>
                                    <p class="text-gray-700 inline ml-2">Members shall send their application from 1st day of December to 10th of December.</p>
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <div class="section-card">
                        <div class="flex items-start mb-4">
                            <span class="article-number">4</span>
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-gray-900 mb-3">Loans</h2>
                                
                                <div class="space-y-4">
                                    <div class="sub-item">
                                        <strong class="text-gray-900 text-lg">1. Eligibility:</strong>
                                        <div class="ml-6 mt-2 space-y-2">
                                            <p><strong>a.</strong> An applicant must have been a member for at least one (1) month.</p>
                                            <p><strong>b.</strong> Loans shall be advanced up to maximum of Three (3) times of the total savings.</p>
                                            <p><strong>c.</strong> Two guarantors are required for the loan to be approved.</p>
                                        </div>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900 text-lg">2. Loan Tenor and Interest Rates:</strong>
                                        <div class="ml-6 mt-2">
                                            <p><strong>a. One Month Loan:</strong></p>
                                            <ul class="list-disc ml-6 mt-1">
                                                <li>Club Members: 3%</li>
                                                <li>Non-Club Members: 7%</li>
                                            </ul>
                                        </div>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900 text-lg">3. Loan Rollover:</strong>
                                        <div class="ml-6 mt-2 space-y-2">
                                            <p><strong>a.</strong> Upon expiration of loan tenor, members may roll over to the next month (unlimited) if a fresh loan application is submitted for the same amount.</p>
                                            <p><strong>b.</strong> Official rollovers attract an extra 1% applicable only once irrespective of the number of rollovers.</p>
                                        </div>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900 text-lg">4. Default Penalties:</strong>
                                        <div class="ml-6 mt-2 space-y-2">
                                            <p><strong>a.</strong> Loans not refunded within 30 days attract 0.5% of the outstanding amount for each extra day.</p>
                                            <p><strong>b.</strong> Management may liquidate a member's savings to offset outstanding loans.</p>
                                            <p><strong>c.</strong> Upon notification, part of guarantor's savings may be used to settle outstanding loan.</p>
                                            <p><strong>d.</strong> At year-end, management reserves the right to deduct from guarantors' savings without prior approval if loans remain unpaid.</p>
                                        </div>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">5. Disbursement:</strong>
                                        <p class="text-gray-700 inline ml-2">Loans shall be disbursed only into accounts bearing the applicant's full name.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">6. Priority:</strong>
                                        <p class="text-gray-700 inline ml-2">Loans shall be granted on a first-come, first-served basis, subject to funds availability.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <div class="section-card">
                        <div class="flex items-start mb-4">
                            <span class="article-number">5</span>
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-gray-900 mb-3">Profit and Surplus Distribution</h2>
                                
                                <div class="space-y-4">
                                    <div class="sub-item">
                                        <strong class="text-gray-900">1. Service Fee:</strong>
                                        <p class="text-gray-700 mt-1">Fifteen percent (15%) of total profit generated annually shall be paid to the operating company as service fee. Same shall be remitted monthly on pro-rata basis upon submission of invoice and approval by the cooperative management.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">2. Operating Surplus:</strong>
                                        <p class="text-gray-700 mt-1">At the end of each financial year all surplus funds shall be remitted to Club De Stars Worldwide. 15% of the surplus shall given to the operating company.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">3. Profit Sharing:</strong>
                                        <div class="ml-6 mt-2 space-y-2">
                                            <p><strong>i.</strong> Profit shall be calculated monthly but distributed only at the end of each financial year.</p>
                                            <p><strong>ii.</strong> Calculation and distribution of profit shall be based on total savings.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <div class="section-card">
                        <div class="flex items-start mb-4">
                            <span class="article-number">6</span>
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-gray-900 mb-3">Investments</h2>
                                <div class="sub-item">
                                    <p class="text-gray-700">The Cooperative shall invest in low-risk, profit-generating portfolios to ensure sustainability and growth.</p>
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <div class="section-card">
                        <div class="flex items-start mb-4">
                            <span class="article-number">7</span>
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-gray-900 mb-3">General Provisions</h2>
                                
                                <div class="space-y-3">
                                    <div class="sub-item">
                                        <strong class="text-gray-900">1.</strong>
                                        <p class="text-gray-700 inline ml-2">Members may instruct management to liquidate their savings to offset outstanding loan balances.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">2.</strong>
                                        <p class="text-gray-700 inline ml-2">The Cooperative reserves the right to review interest rates, service fees, and investment policies periodically at an AGM.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">3.</strong>
                                        <p class="text-gray-700 inline ml-2">Every member shall maintain a minimum share capital of ₦10,000. Should a member decide to liquidate their savings below the minimum share capital, such account will be considered closed, hence, such a member will be required to re-register.</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">4.</strong>
                                        <p class="text-gray-700 inline ml-2">Newly registered members are mandated to fund their accounts with the minimum share capital of ₦10,000 within one month of registration else such account will be deactivated or re-assigned.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <div class="section-card">
                        <div class="flex items-start mb-4">
                            <span class="article-number">8</span>
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-gray-900 mb-3">Annual General Meeting/Special General Meeting</h2>
                                
                                <div class="space-y-3">
                                    <div class="sub-item">
                                        <strong class="text-gray-900">1.</strong>
                                        <p class="text-gray-700 inline ml-2">Annual General Meeting shall hold once in a year in the last week of November (Management shall determine the actual day).</p>
                                    </div>
                                    
                                    <div class="sub-item">
                                        <strong class="text-gray-900">2.</strong>
                                        <p class="text-gray-700 inline ml-2">Special General Meeting shall be held when the need arises.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
    
                <!-- Terms & Conditions Content -->
                <div id="terms" class="tab-content">
                    <div class="section-card">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4">Terms and Conditions of Use</h2>
                        <p class="text-gray-600 text-sm mb-6">Last Updated: December 2024</p>
                        
                        <div class="space-y-6">
                            <div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2">1. Acceptance of Terms</h3>
                                <p class="text-gray-700">By accessing and using the Club De Stars Multipurpose Cooperative Society Limited website and services, you acknowledge that you have read, understood, and agree to be bound by these Terms and Conditions and our Bylaws. If you do not agree with any part of these terms, you must not use our services.</p>
                            </div>
    
                            <div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2">2. Membership Agreement</h3>
                                <p class="text-gray-700 mb-3">Upon registration, you agree to:</p>
                                <ul class="list-disc ml-6 space-y-2 text-gray-700">
                                    <li>Provide accurate, current, and complete information during registration</li>
                                    <li>Maintain and update your information to keep it accurate and current</li>
                                    <li>Be responsible for maintaining the confidentiality of your account credentials</li>
                                    <li>Notify us immediately of any unauthorized access to your account</li>
                                    <li>Comply with all applicable bylaws and cooperative policies</li>
                                </ul>
                            </div>
    
                            <div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2">3. Registration and Account Activation</h3>
                                <div class="space-y-2 text-gray-700">
                                    <p><strong>3.1</strong> Registration requires payment of a one-time fee of ₦5,000.</p>
                                    <p><strong>3.2</strong> Your account will be subject to administrative approval before activation.</p>
                                    <p><strong>3.3</strong> You must fund your account with a minimum share capital of ₦10,000 within one month of approval, or your account will be deactivated.</p>
                                    <p><strong>3.4</strong> You must be at least 18 years old to register for an adult account.</p>
                                </div>
                            </div>
    
                            <div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2">4. Financial Transactions</h3>
                                <div class="space-y-2 text-gray-700">
                                    <p><strong>4.1</strong> All payments processed through our platform are handled securely via Paystack payment gateway.</p>
                                    <p><strong>4.2</strong> You are responsible for ensuring sufficient funds in your designated account for loan repayments and other obligations.</p>
                                    <p><strong>4.3</strong> Service charges apply to certain transactions as outlined in our Bylaws.</p>
                                    <p><strong>4.4</strong> The Cooperative reserves the right to adjust fees with prior notice to members.</p>
                                </div>
                            </div>
    
                            <div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2">5. Loans and Guarantorship</h3>
                                <div class="space-y-2 text-gray-700">
                                    <p><strong>5.1</strong> By accepting to be a guarantor for another member, you agree that your savings may be used to offset defaulted loans.</p>
                                    <p><strong>5.2</strong> Loan defaults will be subject to penalties as outlined in Article 4 of our Bylaws.</p>
                                    <p><strong>5.3</strong> The Cooperative reserves the right to report persistent defaulters to credit bureaus.</p>
                                </div>
                            </div>
    
                            <div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2">6. Use of Platform</h3>
                                <p class="text-gray-700 mb-3">You agree not to:</p>
                                <ul class="list-disc ml-6 space-y-2 text-gray-700">
                                    <li>Use the platform for any illegal or unauthorized purpose</li>
                                    <li>Attempt to gain unauthorized access to any part of the platform</li>
                                    <li>Transmit any viruses, malware, or harmful code</li>
                                    <li>Interfere with the proper functioning of the platform</li>
                                    <li>Impersonate another person or entity</li>
                                    <li>Harass, abuse, or harm other members</li>
                                </ul>
                            </div>
    
                            <div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2">7. Data and Document Submission</h3>
                                <div class="space-y-2 text-gray-700">
                                    <p><strong>7.1</strong> You warrant that all documents and information submitted are genuine, accurate, and legally obtained.</p>
                                    <p><strong>7.2</strong> Submission of fraudulent documents will result in immediate account termination and possible legal action.</p>
                                    <p><strong>7.3</strong> We reserve the right to verify all submitted documents with relevant authorities.</p>
                                </div>
                            </div>
    
                            <div>
