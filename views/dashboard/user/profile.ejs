        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label">Account Name</label>
          <input type="text" id="accountName" name="accountName" class="form-control"
                 value="<%= user.bankDetails?.accountName || '' %>" readonly>
          <div class="form-hint" id="verifyHint">Auto-verified when account number is entered</div>
        </div>
        <div class="modal-info" style="margin-top:12px;margin-bottom:0;">
          <i class="fas fa-shield-alt" style="margin-right:5px;"></i>Your bank details are encrypted and secure.
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('editBankModal')">Cancel</button>
      <button class="btn btn-primary" onclick="document.getElementById('bankDetailsForm').submit()">
        <i class="fas fa-save" style="margin-right:5px;font-size:11px;"></i>Save Details
      </button>
    </div>
  </div>
</div>

