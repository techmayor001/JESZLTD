<!-- ════ MAIN ════ -->
<main class="main">

  <!-- Profile hero -->
  <div class="profile-hero">
    <div class="profile-hero-avatar" onclick="openModal('avatarModal')">
      <% if (user.displayPicture) { %>
        <img src="<%= user.displayPicture.replace('public\\','/').replace(/\\/g,'/') %>" alt="">
      <% } else { %>
        <%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName.charAt(0).toUpperCase() %>
      <% } %>
      <div class="avatar-edit-badge"><i class="fas fa-camera"></i></div>
    </div>
    <div class="profile-hero-info">
      <div class="profile-hero-name"><%= user.firstName %> <%= user.lastName %></div>
      <div class="profile-hero-id"><%= user.membershipID %></div>
      <div class="profile-hero-badges">
        <% if (user.status === 'active') { %>
          <span class="hero-badge badge-green"><i class="fas fa-check-circle" style="font-size:9px;"></i> Active</span>
        <% } else if (user.status === 'rejected') { %>
          <span class="hero-badge badge-red"><i class="fas fa-times-circle" style="font-size:9px;"></i> Rejected</span>
        <% } else { %>
          <span class="hero-badge badge-amber"><i class="fas fa-clock" style="font-size:9px;"></i> Pending</span>
        <% } %>
        <% if (user.Payment && user.Payment.status === 'paid') { %>
          <span class="hero-badge badge-green"><i class="fas fa-shield-alt" style="font-size:9px;"></i> KYC Verified</span>
        <% } else { %>
          <span class="hero-badge badge-amber"><i class="fas fa-shield-alt" style="font-size:9px;"></i> KYC Pending</span>
        <% } %>
        <span class="hero-badge badge-accent">
          <i class="fas fa-percentage" style="font-size:9px;"></i>
          <%= user.membershipID.startsWith('CD') ? '5%' : '10%' %> loan rate
        </span>
      </div>
    </div>
  </div>

  <!-- Page grid -->
  <div class="page-grid">

    <!-- Left column -->
    <div>

      <!-- Personal Info -->
      <div class="card">
        <div class="card-header">
          <span class="card-title"><i class="fas fa-user" style="margin-right:6px;color:var(--accent);"></i>Personal Information</span>
          <button class="edit-btn" onclick="openModal('editProfileModal')">
            <i class="fas fa-edit" style="font-size:11px;"></i> Edit
          </button>
        </div>
        <div class="info-list">
          <div class="info-row">
            <span class="info-label"><i class="fas fa-user"></i>Full Name</span>
            <span class="info-value"><%= user.firstName %> <%= user.lastName %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-envelope"></i>Email</span>
            <span class="info-value"><%= user.email %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-phone"></i>Phone</span>
            <span class="info-value"><%= user.phone %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-calendar"></i>Date of Birth</span>
            <span class="info-value"><%= new Date(user.dob).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'}) %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-map-marker-alt"></i>Address</span>
            <span class="info-value"><%= user.address %></span>
          </div>
        </div>
      </div>

      <!-- Account Info -->
      <div class="card">
        <div class="card-header">
          <span class="card-title"><i class="fas fa-building" style="margin-right:6px;color:var(--accent);"></i>Account Information</span>
        </div>
        <div class="info-list">
          <div class="info-row">
            <span class="info-label"><i class="fas fa-id-card"></i>Membership ID</span>
            <span class="info-value" style="font-family:'DM Mono',monospace;"><%= user.membershipID || 'N/A' %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-star"></i>Account Type</span>
            <span class="info-value">
              <% if (memberType) { %>
                <span class="hero-badge badge-accent"><%= memberType.name %></span>
              <% } else { %>N/A<% } %>
            </span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-calendar-check"></i>Member Since</span>
            <span class="info-value"><%= user.createdAt.toLocaleDateString('en-US',{month:'long',year:'numeric'}) %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-percentage"></i>Loan Interest Rate</span>
            <span class="info-value" style="color:var(--accent);">
              <% if (memberType) { %><%= memberType.interestRate %>% p.a.<% } else { %>N/A<% } %>
            </span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-hand-holding-usd"></i>Max Loan</span>
            <span class="info-value">
              <% if (memberType && memberType.maxLoanAmount > 0) { %>
                ₦<%= memberType.maxLoanAmount.toLocaleString() %>
              <% } else { %>Unlimited<% } %>
            </span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-percent"></i>Loan-to-Deposit</span>
            <span class="info-value"><% if (memberType) { %><%= memberType.loanToDepositRatio %>%<% } else { %>N/A<% } %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-shield-check"></i>Account Status</span>
            <span class="info-value">
              <span class="hero-badge <%= user.status === 'active' ? 'badge-green' : user.status === 'rejected' ? 'badge-red' : 'badge-amber' %>">
                <%= user.status ? user.status.charAt(0).toUpperCase() + user.status.slice(1) : 'Pending' %>
              </span>
            </span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-chart-line"></i>ROI Frequency</span>
            <span class="info-value" style="text-transform:capitalize;"><%= memberType?.roiDistributionFrequency || 'Monthly' %></span>
          </div>
        </div>
      </div>

      <!-- Bank Details -->
      <div class="card">
        <div class="card-header">
          <span class="card-title"><i class="fas fa-university" style="margin-right:6px;color:var(--accent);"></i>Bank Details</span>
          <button class="edit-btn" onclick="openModal('editBankModal')">
            <i class="fas fa-edit" style="font-size:11px;"></i> Update
          </button>
        </div>
        <div class="info-list">
          <div class="info-row">
            <span class="info-label"><i class="fas fa-university"></i>Bank</span>
            <span class="info-value"><%= user.bankDetails?.bankName || 'N/A' %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-credit-card"></i>Account Number</span>
            <span class="info-value" style="font-family:'DM Mono',monospace;"><%= user.bankDetails?.accountNumber || 'N/A' %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-user-tag"></i>Account Name</span>
            <span class="info-value"><%= user.bankDetails?.accountName || 'N/A' %></span>
          </div>
        </div>
      </div>

      <!-- Next of Kin -->
      <div class="card">
        <div class="card-header">
          <span class="card-title"><i class="fas fa-user-friends" style="margin-right:6px;color:var(--accent);"></i>Next of Kin</span>
          <button class="edit-btn" onclick="openModal('editNextOfKinModal')">
            <i class="fas fa-edit" style="font-size:11px;"></i> Edit
          </button>
        </div>
        <div class="info-list">
          <div class="info-row">
            <span class="info-label"><i class="fas fa-user"></i>Full Name</span>
            <span class="info-value"><%= user.nextOfKin?.fullName || 'N/A' %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-link"></i>Relationship</span>
            <span class="info-value"><%= user.nextOfKin?.relationship || 'N/A' %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-phone"></i>Phone</span>
            <span class="info-value"><%= user.nextOfKin?.phone || 'N/A' %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-map-marker-alt"></i>Address</span>
            <span class="info-value"><%= user.nextOfKin?.address || 'N/A' %></span>
          </div>
        </div>
      </div>

    </div>

    <!-- Right column -->
    <div>

      <!-- Security -->
      <div class="card">
        <div class="card-header">
          <span class="card-title"><i class="fas fa-shield-alt" style="margin-right:6px;color:var(--accent);"></i>Security</span>
        </div>
        <div class="security-item" style="margin-top:14px;">
          <div class="security-title">Password</div>
          <button class="security-btn" onclick="openModal('changePasswordModal')">
            <i class="fas fa-lock" style="margin-right:6px;font-size:11px;"></i>Change Password
          </button>
        </div>
      </div>

      <!-- Quick Stats -->
      <div class="card">
        <div class="card-header">
          <span class="card-title"><i class="fas fa-chart-bar" style="margin-right:6px;color:var(--accent);"></i>Quick Stats</span>
        </div>
        <div class="info-list">
          <div class="info-row">
            <span class="info-label"><i class="fas fa-piggy-bank"></i>Total Savings</span>
            <span class="info-value" style="color:var(--green);">₦<%= accountBalance.toLocaleString() %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-hand-holding-usd"></i>Active Loan</span>
            <span class="info-value" style="color:var(--amber);">₦<%= loan ? loan.amount.toLocaleString() : 0 %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-percentage"></i>Monthly ROI</span>
            <span class="info-value" style="color:var(--accent);">₦<%= ROI.toLocaleString() %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="fas fa-users"></i>Referrals</span>
            <span class="info-value"><%= totalReferrals %> member<%= totalReferrals === 1 ? '' : 's' %></span>
          </div>
        </div>
      </div>

      <!-- Tips -->
      <div class="card">
        <div class="card-header">
          <span class="card-title"><i class="fas fa-info-circle" style="margin-right:6px;color:var(--accent);"></i>Profile Tips</span>
        </div>
        <div class="tips-box">
          <div class="tip-item"><div class="tip-dot"></div>Keep your contact information up to date.</div>
          <div class="tip-item"><div class="tip-dot"></div>Verify bank details for smooth transactions.</div>
          <div class="tip-item"><div class="tip-dot"></div>Update your next of kin details regularly.</div>
        </div>
      </div>

    </div>
  </div>

</main>

<div class="powered-by">Powered by <strong>JESZ LIMITED</strong></div>

<!-- ════════════ MODALS ════════════ -->

<!-- Edit Profile -->
<div class="modal-backdrop" id="editProfileModal">
  <div class="modal-box">
    <div class="modal-handle"></div>
    <div class="modal-header">
      <span class="modal-title"><i class="fas fa-user" style="color:var(--accent);margin-right:8px;font-size:13px;"></i>Edit Profile</span>
      <button class="modal-close" onclick="closeModal('editProfileModal')"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <div class="modal-info" style="margin-bottom:12px;">
        <i class="fas fa-info-circle" style="margin-right:5px;"></i>
        Name changes require admin assistance. Contact support to update your name.
      </div>
      <form id="editProfileForm">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="form-group">
            <label class="form-label">First Name</label>
            <input type="text" class="form-control" name="firstName" value="<%= user.firstName %>" readonly>
          </div>
          <div class="form-group">
            <label class="form-label">Last Name</label>
            <input type="text" class="form-control" name="lastName" value="<%= user.lastName %>" readonly>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input type="email" class="form-control" name="email" value="<%= user.email %>" readonly>
        </div>
        <div class="form-group">
          <label class="form-label">Phone Number</label>
          <input type="tel" class="form-control" name="phone" value="<%= user.phone %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">Date of Birth</label>
          <input type="date" class="form-control" name="dob"
                 value="<%= user.dob ? new Date(user.dob).toISOString().split('T')[0] : '' %>" required>
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label">Address</label>
          <textarea class="form-control" name="address" rows="3" required><%= user.address %></textarea>
        </div>
        <div id="profileMsg" class="modal-msg"></div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('editProfileModal')">Cancel</button>
      <button class="btn btn-primary" id="profileSaveBtn" onclick="saveProfile()">
        <i class="fas fa-save" style="margin-right:5px;font-size:11px;"></i>Save Changes
      </button>
    </div>
  </div>
</div>


<!-- Change Password -->
<div class="modal-backdrop" id="changePasswordModal">
  <div class="modal-box">
    <div class="modal-handle"></div>
    <div class="modal-header">
      <span class="modal-title"><i class="fas fa-lock" style="color:var(--accent);margin-right:8px;font-size:13px;"></i>Change Password</span>
      <button class="modal-close" onclick="closeModal('changePasswordModal')"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <form id="changePasswordForm">
        <!-- Change Password Modal -->
        <div class="form-group">
          <label class="form-label">Current Password</label>
          <input type="password" class="form-control" id="currentPassword" name="password" required>
        </div>
        <div class="form-group">
          <label class="form-label">New Password</label>
          <input type="password" class="form-control" id="newPassword" name="newPassword" required>
          <div class="form-hint">At least 8 characters, mix of letters and numbers</div>
        </div>
        <div class="modal-info" style="margin-bottom:0;"><i class="fas fa-info-circle" style="margin-right:5px;"></i>You will be logged out after a successful password change.</div>
        <div id="passwordMsg" class="modal-msg"></div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('changePasswordModal')">Cancel</button>
      <button class="btn btn-primary" id="pwSaveBtn" onclick="changePassword()">
        <i class="fas fa-key" style="margin-right:5px;font-size:11px;"></i>Update Password
      </button>
    </div>
  </div>
</div>

<!-- Edit Bank Details -->
<div class="modal-backdrop" id="editBankModal">
  <div class="modal-box">
    <div class="modal-handle"></div>
    <div class="modal-header">
      <span class="modal-title"><i class="fas fa-university" style="color:var(--accent);margin-right:8px;font-size:13px;"></i>Update Bank Details</span>
      <button class="modal-close" onclick="closeModal('editBankModal')"><i class="fas fa-times"></i></button>
