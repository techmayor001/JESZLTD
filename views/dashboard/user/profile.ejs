<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Profile — Club De Stars | Powered by JESZ LIMITED</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ══ THEME TOKENS ══ */
:root{
  --sidebar-w:230px;--nav-h:62px;
  --r-sm:8px;--r-md:12px;--r-lg:16px;--r-xl:20px;
  --accent:#4f8ef7;--accent2:#7c5af4;
  --green:#22c78a;--red:#f05252;--amber:#f5a623;
  --tr:all .22s ease;
}
[data-theme="dark"]{
  --bg:#0a0f1e;--bg-card:#111827;--bg-card2:#1a2235;
  --bg-card3:rgba(255,255,255,.035);
  --border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.12);
  --text:#f0f4ff;--text2:#c8d4f0;--muted:#8b9ab8;
  --nav-bg:rgba(10,15,30,.93);
  --hero-bg:linear-gradient(135deg,#111827 0%,#1a2235 100%);
  --bar-bg:rgba(255,255,255,.07);--meta-bg:rgba(255,255,255,.03);
  --tog-bg:rgba(255,255,255,.08);
}
[data-theme="light"]{
  --bg:#f4f6fb;--bg-card:#ffffff;--bg-card2:#f0f3fa;
  --bg-card3:rgba(0,0,0,.025);
  --border:rgba(0,0,0,.07);--border2:rgba(0,0,0,.12);
  --text:#0f1523;--text2:#2a3550;--muted:#6b7a99;
  --nav-bg:rgba(255,255,255,.93);
  --hero-bg:linear-gradient(135deg,#dde8ff 0%,#eef1ff 100%);
  --bar-bg:rgba(0,0,0,.07);--meta-bg:rgba(0,0,0,.025);
  --tog-bg:rgba(0,0,0,.07);
}

/* ══ BASE ══ */
*{margin:0;padding:0;box-sizing:border-box;}
html,body{
  height:100%;font-family:'DM Sans',sans-serif;
  background:var(--bg);color:var(--text);font-size:14px;
  transition:background .3s,color .3s;
}
a{text-decoration:none;color:inherit;}
button,input,select,textarea{font-family:inherit;}

/* ══ LOADER ══ */
#loader{
  position:fixed;inset:0;background:var(--bg);z-index:9999;
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:20px;transition:opacity .5s;
}
.loader-ring{
  width:48px;height:48px;
  border:2.5px solid var(--border2);border-top-color:var(--accent);
  border-radius:50%;animation:spin 1s linear infinite;
}
.loader-label{font-size:11px;color:var(--muted);letter-spacing:.14em;text-transform:uppercase;}
@keyframes spin{to{transform:rotate(360deg)}}

/* ══ SIDEBAR ══ */
.sidebar{
  position:fixed;left:0;top:0;bottom:0;width:var(--sidebar-w);
  background:var(--bg-card);border-right:1px solid var(--border);
  z-index:200;display:flex;flex-direction:column;overflow:hidden;
  transition:transform .3s,background .3s,border-color .3s;
}
.sidebar-logo{
  padding:18px 18px 14px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;flex-shrink:0;
}
.logo-mark{
  width:34px;height:34px;border-radius:10px;flex-shrink:0;overflow:hidden;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:14px;color:#fff;
}
.logo-mark img{width:100%;height:100%;object-fit:cover;}
.logo-name{font-size:13px;font-weight:600;line-height:1.2;}
.logo-sub{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;}
.sidebar-user{padding:12px 14px;border-bottom:1px solid var(--border);flex-shrink:0;}
.user-chip{
  display:flex;align-items:center;gap:10px;
  background:var(--bg-card2);border-radius:10px;padding:9px 11px;
  border:1px solid var(--border);
}
.user-avatar{
  width:32px;height:32px;border-radius:8px;flex-shrink:0;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:600;color:#fff;overflow:hidden;
}
.user-avatar img{width:100%;height:100%;object-fit:cover;}
.user-name{font-size:13px;font-weight:500;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.user-id{font-size:10px;color:var(--muted);font-family:'DM Mono',monospace;letter-spacing:.04em;}
.sidebar-nav{flex:1;overflow-y:auto;padding:8px 10px;}
.sidebar-nav::-webkit-scrollbar{width:3px;}
.sidebar-nav::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px;}
.nav-section{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;padding:10px 8px 4px;margin-top:2px;}
.nav-item{
  display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:9px;
  color:var(--muted);font-size:13px;font-weight:400;
  transition:var(--tr);margin-bottom:1px;cursor:pointer;
  border:none;background:none;width:100%;text-align:left;
}
.nav-item:hover{background:var(--bg-card2);color:var(--text);}
.nav-item.active{background:rgba(79,142,247,.1);color:var(--accent);}
.nav-item i{width:18px;text-align:center;font-size:13px;flex-shrink:0;}
.nav-badge{
  margin-left:auto;background:var(--red);color:#fff;
  font-size:10px;font-weight:700;border-radius:20px;padding:2px 7px;
}
.sidebar-footer{padding:12px 14px;border-top:1px solid var(--border);flex-shrink:0;}
.member-pill{
  display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;
  font-size:10px;font-weight:600;background:rgba(34,199,138,.12);
  color:var(--green);border:1px solid rgba(34,199,138,.2);margin-bottom:8px;
}

/* ══ TOP NAV ══ */
.topnav{
  position:fixed;top:0;left:var(--sidebar-w);right:0;height:var(--nav-h);
  background:var(--nav-bg);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);z-index:100;
  display:flex;align-items:center;padding:0 20px;gap:12px;
  transition:left .3s,background .3s,border-color .3s;
}
.hamburger{
  display:none;cursor:pointer;padding:7px;border-radius:8px;
  border:none;background:none;color:var(--muted);font-size:17px;
  transition:var(--tr);flex-shrink:0;
}
.hamburger:hover{background:var(--bg-card2);color:var(--text);}
.topnav-greeting{flex:1;min-width:0;}
.topnav-greeting h2{font-size:15px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.topnav-greeting p{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.topnav-right{display:flex;align-items:center;gap:8px;flex-shrink:0;}
.status-row{display:flex;align-items:center;gap:5px;}
.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);}
.status-label{font-size:12px;color:var(--green);font-weight:500;}
.kyc-chip{
  display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:8px;
  background:rgba(245,166,35,.1);border:1px solid rgba(245,166,35,.2);
  font-size:11px;font-weight:500;color:var(--amber);cursor:pointer;
  transition:var(--tr);text-decoration:none;white-space:nowrap;
}
.kyc-chip.verified{background:rgba(34,199,138,.08);border-color:rgba(34,199,138,.2);color:var(--green);}
.theme-toggle{
  width:40px;height:22px;border-radius:20px;border:1px solid var(--border2);
  background:var(--tog-bg);cursor:pointer;position:relative;flex-shrink:0;
  transition:background .3s,border-color .3s;padding:0;
}
.tog-thumb{
  position:absolute;top:2px;left:2px;width:16px;height:16px;
  border-radius:50%;background:var(--muted);
  transition:transform .25s ease,background .25s;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;color:#fff;pointer-events:none;
}
[data-theme="light"] .tog-thumb{transform:translateX(18px);background:var(--accent);}

/* ══ MAIN ══ */
.main{
  margin-left:var(--sidebar-w);margin-top:var(--nav-h);
  padding:22px;min-height:calc(100vh - var(--nav-h));
  transition:margin-left .3s;
}

/* ══ PROFILE HERO ══ */
.profile-hero{
  background:var(--hero-bg);border:1px solid var(--border2);
  border-radius:var(--r-xl);padding:24px;margin-bottom:14px;
  display:flex;align-items:center;gap:20px;flex-wrap:wrap;
  position:relative;overflow:hidden;
}
.profile-hero::before{
  content:'';position:absolute;top:-40px;right:-40px;
  width:160px;height:160px;border-radius:50%;
  background:radial-gradient(circle,rgba(79,142,247,.06) 0%,transparent 70%);
  pointer-events:none;
}
.profile-hero-avatar{
  width:72px;height:72px;border-radius:18px;flex-shrink:0;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-size:24px;font-weight:600;color:#fff;
  border:2px solid var(--border2);overflow:hidden;position:relative;cursor:pointer;
}
.profile-hero-avatar img{width:100%;height:100%;object-fit:cover;}
.avatar-edit-badge{
  position:absolute;bottom:3px;right:3px;
  width:20px;height:20px;border-radius:50%;
  background:var(--accent);color:#fff;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;border:1.5px solid var(--bg-card);
}
.profile-hero-info{flex:1;min-width:0;}
.profile-hero-name{font-size:clamp(18px,3vw,24px);font-weight:500;letter-spacing:-.3px;margin-bottom:4px;}
.profile-hero-id{font-size:12px;color:var(--muted);font-family:'DM Mono',monospace;margin-bottom:10px;}
.profile-hero-badges{display:flex;align-items:center;gap:7px;flex-wrap:wrap;}
.hero-badge{
  display:inline-flex;align-items:center;gap:4px;
  padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;border:1px solid;
}
.badge-green{background:rgba(34,199,138,.1);color:var(--green);border-color:rgba(34,199,138,.2);}
.badge-amber{background:rgba(245,166,35,.1);color:var(--amber);border-color:rgba(245,166,35,.2);}
.badge-accent{background:rgba(79,142,247,.1);color:var(--accent);border-color:rgba(79,142,247,.2);}
.badge-muted{background:var(--bg-card3);color:var(--muted);border-color:var(--border);}
.badge-red{background:rgba(240,82,82,.1);color:var(--red);border-color:rgba(240,82,82,.2);}

/* ══ PAGE GRID ══ */
.page-grid{display:grid;grid-template-columns:1fr 300px;gap:14px;}

/* ══ CARD ══ */
.card{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--r-lg);margin-bottom:14px;
  transition:background .3s,border-color .3s;
}
.card:last-child{margin-bottom:0;}
.card-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 18px;border-bottom:1px solid var(--border);
}
.card-title{font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;}

/* ══ INFO ROWS ══ */
.info-list{padding:0 18px;}
.info-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:11px 0;border-bottom:1px solid var(--border);gap:12px;
  flex-wrap:wrap;
}
.info-row:last-child{border-bottom:none;padding-bottom:14px;}
.info-label{
  display:flex;align-items:center;gap:8px;
  font-size:12px;color:var(--muted);flex-shrink:0;
}
.info-label i{width:14px;text-align:center;font-size:11px;color:var(--accent);}
.info-value{font-size:13px;font-weight:500;text-align:right;word-break:break-word;}

/* ══ EDIT BUTTON ══ */
.edit-btn{
  display:inline-flex;align-items:center;gap:5px;
  padding:6px 12px;border-radius:8px;font-size:12px;font-weight:500;
  background:var(--bg-card2);border:1px solid var(--border2);
  color:var(--muted);cursor:pointer;transition:var(--tr);
}
.edit-btn:hover{color:var(--text);border-color:var(--accent);}

/* ══ SECURITY ITEM ══ */
.security-item{
  padding:14px;border-radius:var(--r-md);
  background:var(--bg-card2);border:1px solid var(--border);
  margin:14px 18px 0;
}
.security-item:last-child{margin-bottom:14px;}
.security-title{font-size:13px;font-weight:500;margin-bottom:8px;}
.security-btn{
  width:100%;padding:9px;border-radius:9px;font-size:12px;font-weight:500;
  background:none;border:1px solid var(--border2);color:var(--muted);
  cursor:pointer;transition:var(--tr);
}
.security-btn:hover{border-color:var(--accent);color:var(--accent);}

/* ══ TIPS BOX ══ */
.tips-box{
  background:rgba(79,142,247,.06);border:1px solid rgba(79,142,247,.14);
  border-radius:var(--r-md);padding:14px;margin:14px 18px 16px;
}
.tips-title{font-size:11px;font-weight:600;color:var(--accent);text-transform:uppercase;letter-spacing:.07em;margin-bottom:8px;}
.tip-item{
  display:flex;align-items:flex-start;gap:8px;
  font-size:12px;color:var(--muted);padding:4px 0;line-height:1.5;
}
.tip-dot{width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:5px;}

/* ══ TOAST ══ */
.toast-wrap{position:fixed;top:16px;right:16px;z-index:5000;display:flex;flex-direction:column;gap:8px;}
.toast{
  padding:12px 16px;border-radius:10px;font-size:13px;font-weight:500;
  color:#fff;max-width:320px;opacity:0;transform:translateY(-10px);
  transition:opacity .35s,transform .35s;pointer-events:none;
  display:flex;align-items:center;gap:8px;
}
.toast.show{opacity:1;transform:none;pointer-events:auto;}
.toast.success{background:#22c78a;}
.toast.error{background:#f05252;}

/* ══ SIDEBAR OVERLAY ══ */
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:190;}
.sb-overlay.show{display:block;}

/* ══ MODALS ══ */
.modal-backdrop{
  display:none;position:fixed;inset:0;z-index:1000;
  background:rgba(0,0,0,.55);backdrop-filter:blur(5px);
  align-items:flex-end;justify-content:center;
}
.modal-backdrop.open{display:flex;}
.modal-box{
  background:var(--bg-card);border:1px solid var(--border2);
  border-radius:var(--r-xl) var(--r-xl) 0 0;
  width:100%;max-width:480px;max-height:92vh;overflow-y:auto;
  animation:shup .28s cubic-bezier(.16,1,.3,1);
  transition:background .3s,border-color .3s;
}
@keyframes shup{from{transform:translateY(30px);opacity:0;}to{transform:none;opacity:1;}}
.modal-box::-webkit-scrollbar{width:3px;}
.modal-box::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px;}
.modal-handle{width:36px;height:4px;border-radius:2px;background:var(--border2);margin:12px auto 0;}
.modal-header{padding:16px 20px 0;display:flex;align-items:center;justify-content:space-between;}
.modal-title{font-size:15px;font-weight:500;}
.modal-close{
  background:none;border:none;color:var(--muted);cursor:pointer;font-size:17px;
  width:30px;height:30px;display:flex;align-items:center;justify-content:center;
  border-radius:7px;transition:var(--tr);
}
.modal-close:hover{background:var(--bg-card2);color:var(--text);}
.modal-body{padding:18px 20px;}
.modal-footer{padding:0 20px 24px;display:flex;gap:10px;}
.form-group{margin-bottom:14px;}
.form-label{
  font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;
  color:var(--muted);display:block;margin-bottom:6px;
}
.form-control{
  width:100%;background:var(--bg-card2);border:1px solid var(--border2);
  border-radius:10px;color:var(--text);font-size:14px;padding:11px 14px;
  transition:border-color .18s,background .3s;outline:none;-webkit-appearance:none;
}
.form-control:focus{border-color:var(--accent);}
.form-control:disabled,.form-control[readonly]{opacity:.55;cursor:not-allowed;}
.form-control option{background:var(--bg-card);color:var(--text);}
.form-hint{font-size:11px;color:var(--muted);margin-top:5px;}
.modal-info{
  background:rgba(79,142,247,.07);border:1px solid rgba(79,142,247,.17);
  border-radius:10px;padding:11px;font-size:12px;color:var(--accent);
  line-height:1.6;margin-bottom:12px;
}
.modal-warn{
  background:rgba(245,166,35,.07);border:1px solid rgba(245,166,35,.17);
  border-radius:10px;padding:11px;font-size:12px;color:var(--amber);
  line-height:1.6;margin-bottom:12px;
}
.modal-msg{margin-top:8px;font-size:12px;padding:9px 12px;border-radius:8px;display:none;}
.modal-msg.success{background:rgba(34,199,138,.1);color:var(--green);display:block;}
.modal-msg.error{background:rgba(240,82,82,.1);color:var(--red);display:block;}
.btn{border:none;border-radius:10px;padding:12px 20px;font-size:13px;font-weight:500;cursor:pointer;transition:var(--tr);flex:1;}
.btn-ghost{background:var(--bg-card2);color:var(--muted);}
.btn-ghost:hover{color:var(--text);}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;flex:2;}
.btn-primary:hover{opacity:.88;transform:translateY(-1px);}
.btn-primary:disabled{opacity:.5;pointer-events:none;}

/* avatar upload area */
.avatar-upload-area{
  border:2px dashed var(--border2);border-radius:var(--r-lg);
  padding:28px;text-align:center;cursor:pointer;
  transition:border-color .2s;margin-bottom:12px;
}
.avatar-upload-area:hover{border-color:var(--accent);}
.avatar-preview{
  width:80px;height:80px;border-radius:20px;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-size:28px;font-weight:600;color:#fff;margin:0 auto 12px;overflow:hidden;
}
.avatar-preview img{width:100%;height:100%;object-fit:cover;}

/* verify badge on account name */
.verify-status{
  display:inline-flex;align-items:center;gap:4px;font-size:11px;
  padding:3px 8px;border-radius:20px;margin-top:5px;
}
.verify-status.ok{background:rgba(34,199,138,.1);color:var(--green);}
.verify-status.fail{background:rgba(240,82,82,.1);color:var(--red);}

/* Powered by */
.powered-by{position:fixed;bottom:12px;right:14px;font-size:11px;color:var(--muted);z-index:50;}
.powered-by strong{color:var(--accent);}

/* ══ RESPONSIVE ══ */
@media(max-width:1100px){
  .page-grid{grid-template-columns:1fr;}
}
@media(max-width:900px){
  .sidebar{transform:translateX(calc(-1 * var(--sidebar-w)));}
  .sidebar.open{transform:none;box-shadow:4px 0 24px rgba(0,0,0,.3);}
  .topnav{left:0;}
  .main{margin-left:0;}
  .hamburger{display:flex;}
}
@media(max-width:600px){
  .main{padding:14px;}
  .topnav-greeting p{display:none;}
  .status-label{display:none;}
  .modal-box{max-width:100%;}
  .info-row{flex-direction:column;align-items:flex-start;gap:4px;}
  .info-value{text-align:left;}
  .profile-hero{flex-direction:column;align-items:flex-start;gap:14px;}
}
@media(min-width:901px){
  .modal-backdrop{align-items:center;padding:20px;}
  .modal-box{border-radius:var(--r-xl);max-width:460px;}
  .modal-handle{display:none;}
}
@media print{
  .sidebar,.topnav,.powered-by{display:none!important;}
  .main{margin:0;padding:0;}
}
</style>
</head>
<body>

<!-- LOADER -->
<div id="loader">
  <div class="loader-ring"></div>
  <div class="loader-label">Club De Stars</div>
</div>

<!-- Toast container -->
<div class="toast-wrap" id="toastWrap"></div>

<%# pendingGuarantorCount is passed directly from the route %>

<div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

<!-- ════ SIDEBAR ════ -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-mark">
      <img src="/media/assets/logo/log.png" alt="Logo"
           onerror="this.style.display='none';this.parentNode.innerHTML='<b>C</b>'">
    </div>
    <div style="min-width:0;">
      <div class="logo-name">Club De Stars</div>
      <div class="logo-sub">Cooperative Society</div>
    </div>
  </div>
  <div class="sidebar-user">
    <div class="user-chip">
      <div class="user-avatar">
        <% if (user.displayPicture) { %>
          <img src="<%= user.displayPicture.replace('public\\','/').replace(/\\/g,'/') %>" alt="">
        <% } else { %>
          <%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName.charAt(0).toUpperCase() %>
        <% } %>
      </div>
      <div style="min-width:0;">
