<!-- Avatar Upload -->
<div class="modal-backdrop" id="avatarModal">
  <div class="modal-box">
    <div class="modal-handle"></div>
    <div class="modal-header">
      <span class="modal-title"><i class="fas fa-camera" style="color:var(--accent);margin-right:8px;font-size:13px;"></i>Change Profile Picture</span>
      <button class="modal-close" onclick="closeModal('avatarModal')"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <form method="POST" enctype="multipart/form-data" id="avatarForm" action="/club-de-star-cooperative/uploadAvatar">
        <label class="avatar-upload-area" for="avatarUpload">
          <div class="avatar-preview" id="avatarPreview">
            <% if (user.displayPicture) { %>
              <img src="<%= user.displayPicture.replace('public\\','/').replace(/\\/g,'/') %>" alt="" id="avatarPreviewImg">
            <% } else { %>
              <span id="avatarPreviewInitials"><%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName.charAt(0).toUpperCase() %></span>
            <% } %>
          </div>
          <div style="font-size:13px;color:var(--muted);margin-bottom:4px;">Click to choose image</div>
          <div style="font-size:11px;color:var(--muted);">Square image recommended · Min 200×200px</div>
          <input type="file" id="avatarUpload" name="avatar" accept="image/*" style="display:none;">
        </label>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('avatarModal')">Cancel</button>
      <button class="btn btn-primary" onclick="document.getElementById('avatarForm').submit()">
        <i class="fas fa-upload" style="margin-right:5px;font-size:11px;"></i>Upload Photo
      </button>
    </div>
  </div>
</div>

<!-- ════ SCRIPTS ════ -->
<script>
/* ── Theme ── */
(function(){
  const saved = localStorage.getItem('cds-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  updateThemeUI(saved);
})();
function toggleTheme(){
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('cds-theme', next);
  updateThemeUI(next);
}
function updateThemeUI(t){
  const i = document.getElementById('togIcon');
  if(i) i.className = t === 'dark' ? 'fas fa-moon' : 'fas fa-sun';
}

/* ── Sidebar ── */
function toggleSidebar(){
  const open = document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sbOverlay').classList.toggle('show', open);
  document.body.style.overflow = open ? 'hidden' : '';
}
function closeSidebar(){
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sbOverlay').classList.remove('show');
  document.body.style.overflow = '';
}
document.addEventListener('click', e => {
  const sb = document.getElementById('sidebar');
  const hb = document.querySelector('.hamburger');
  if(window.innerWidth <= 900 && sb.classList.contains('open') && !sb.contains(e.target) && !hb.contains(e.target)) closeSidebar();
});

/* ── Modals ── */
function openModal(id){ document.getElementById(id).classList.add('open'); document.body.style.overflow = 'hidden'; }
function closeModal(id){ document.getElementById(id).classList.remove('open'); document.body.style.overflow = ''; }
document.querySelectorAll('.modal-backdrop').forEach(el => {
  el.addEventListener('click', e => { if(e.target === el){ el.classList.remove('open'); document.body.style.overflow = ''; }});
});

/* ── Toast ── */
function showToast(msg, type = 'success'){
  const wrap = document.getElementById('toastWrap');
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i> ${msg}`;
  wrap.appendChild(t);
  requestAnimationFrame(() => { requestAnimationFrame(() => t.classList.add('show')); });
  setTimeout(() => {
    t.classList.remove('show');
    setTimeout(() => t.remove(), 400);
  }, 4000);
}

/* ── Server flash toasts ── */
<% if (typeof success !== 'undefined') { %>
window.addEventListener('load', () => showToast('<%= success %>', 'success'));
<% } %>
<% if (typeof error !== 'undefined') { %>
window.addEventListener('load', () => showToast('<%= error %>', 'error'));
<% } %>

/* ── Save profile ── */
async function saveProfile(){
  const form  = document.getElementById('editProfileForm');
  const btn   = document.getElementById('profileSaveBtn');
  const msg   = document.getElementById('profileMsg');
  const data  = {};
  new FormData(form).forEach((v, k) => data[k] = v);
  msg.className = 'modal-msg';
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right:5px;"></i>Saving…';
  try{
    const res    = await fetch('/club-de-star-cooperative/updateProfile',{ method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data)});
    const result = await res.json();
    if(result.success){
      msg.className = 'modal-msg success'; msg.textContent = result.message;
      setTimeout(() => { closeModal('editProfileModal'); location.reload(); }, 1500);
    } else {
      msg.className = 'modal-msg error'; msg.textContent = result.error || 'Update failed.';
    }
  } catch(e){ msg.className = 'modal-msg error'; msg.textContent = 'Network error. Try again.'; }
  finally{ btn.disabled = false; btn.innerHTML = '<i class="fas fa-save" style="margin-right:5px;font-size:11px;"></i>Save Changes'; }
}

/* ── Change password ── */
async function changePassword(){
  const btn  = document.getElementById('pwSaveBtn');
  const msg  = document.getElementById('passwordMsg');

  const password    = document.getElementById('currentPassword').value.trim();
  const newPassword = document.getElementById('newPassword').value.trim();

  // Client-side guard — prevents the undefined error entirely
  if (!password || !newPassword) {
    msg.className = 'modal-msg error';
    msg.textContent = 'Please fill in both password fields.';
    return;
  }

  msg.className = 'modal-msg';
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right:5px;"></i>Updating…';

  try {
    const res    = await fetch('/club-de-star-cooperative/changePassword', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password, newPassword })
    });
    const result = await res.json();

    if (result.success) {
      msg.className = 'modal-msg success';
      msg.textContent = result.message;
      setTimeout(() => window.location.href = '/logout', 3000);
    } else {
      msg.className = 'modal-msg error';
      msg.textContent = result.error || 'Failed.';
    }
  } catch(e) {
    msg.className = 'modal-msg error';
    msg.textContent = 'Network error.';
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-key" style="margin-right:5px;font-size:11px;"></i>Update Password';
  }
}

/* ── Bank account verification ── */
async function verifyAccount(){
  const bank   = document.getElementById('bankName').value.trim();
  const acctNo = document.getElementById('accountNumber').value.trim();
  const nameIn = document.getElementById('accountName');
  const hint   = document.getElementById('verifyHint');
  nameIn.value = '';
  if(bank && acctNo.length === 10){
    hint.textContent = 'Verifying…';
    hint.style.color = 'var(--accent)';
    try{
      const res  = await fetch(`/club-de-star-cooperative/verifyBankAccount?bank=${encodeURIComponent(bank)}&accountNumber=${acctNo}`);
      const data = await res.json();
      if(data.success){
        nameIn.value    = data.accountName;
        hint.textContent = '✓ Account verified';
        hint.style.color = 'var(--green)';
      } else {
        hint.textContent = '✗ Could not verify — enter name manually';
        hint.style.color = 'var(--red)';
        nameIn.removeAttribute('readonly');
      }
    } catch(e){ hint.textContent = 'Verification failed'; hint.style.color = 'var(--red)'; }
  } else {
    hint.textContent = 'Auto-verified when account number is entered';
    hint.style.color = '';
  }
}
document.getElementById('accountNumber').addEventListener('input', verifyAccount);
document.getElementById('bankName').addEventListener('change', verifyAccount);

/* ── Avatar preview ── */
document.getElementById('avatarUpload').addEventListener('change', function(e){
  const file = e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(ev){
    const preview = document.getElementById('avatarPreview');
    preview.innerHTML = `<img src="${ev.target.result}" alt="Preview">`;
  };
  reader.readAsDataURL(file);
});

/* ── Loader ── */
window.addEventListener('load', () => {
  const l = document.getElementById('loader');
  setTimeout(() => { l.style.opacity = '0'; setTimeout(() => l.style.display = 'none', 500); }, 400);
});
</script>


<script>
(function () {
    const TIMEOUT_MS  = 1 * 60 * 1000;
    const WARNING_MS  = 20 * 1000;
    const LOGOUT_URL  = '/logout';
    const PING_URL    = '/api/ping';     // keeps session alive on activity

    let logoutTimer, warningTimer, warningEl;

    function resetTimers() {
        clearTimeout(logoutTimer);
        clearTimeout(warningTimer);
        hideWarning();

        warningTimer = setTimeout(showWarning, TIMEOUT_MS - WARNING_MS);
        logoutTimer  = setTimeout(() => { window.location.href = LOGOUT_URL; }, TIMEOUT_MS);
    }

    function showWarning() {
        if (warningEl) return;
        warningEl = document.createElement('div');
        warningEl.id = 'inactivity-warning';
        warningEl.innerHTML = `
            <div style="
                position:fixed;bottom:24px;right:24px;z-index:99999;
                background:#1e3a8a;color:#fff;border-radius:14px;
                padding:16px 20px;max-width:300px;
                box-shadow:0 8px 32px rgba(0,0,0,.3);font-size:13px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
            ">
                <strong style="display:block;margin-bottom:6px;">⏱ Session expiring</strong>
                You'll be logged out in 1 minute due to inactivity.
                <button onclick="stayLoggedIn()" style="
                    display:block;margin-top:12px;width:100%;
                    padding:8px;border:none;border-radius:8px;
                    background:#fff;color:#1e3a8a;font-weight:700;
                    cursor:pointer;font-size:13px;
                ">Stay logged in</button>
            </div>`;
        document.body.appendChild(warningEl);
    }

    function hideWarning() {
        if (warningEl) { warningEl.remove(); warningEl = null; }
    }

    window.stayLoggedIn = function () {
        fetch(PING_URL, { credentials: 'same-origin' }); // touch the session
        resetTimers();
    };

    // Reset on any user activity
    ['mousemove','keydown','mousedown','touchstart','scroll'].forEach(evt => {
        document.addEventListener(evt, resetTimers, { passive: true });
    });

    resetTimers(); // start on page load
})();
</script>
</body>
</html>
