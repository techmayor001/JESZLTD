</header>

<!-- MAIN -->
<main class="main">

  <div class="breadcrumb-row">
    <a href="/cds-cooperative/dashboard">Dashboard</a>
    <i class="fas fa-chevron-right"></i>
    <span>Reports</span>
    <i class="fas fa-chevron-right"></i>
    <span>Financial</span>
  </div>

  <div class="page-top">
    <div>
      <div class="page-title">Account Statement</div>
      <div class="page-sub">Member since <%= new Date(user.createdAt).toLocaleDateString('en-US',{month:'long',year:'numeric'}) %> · All figures in Nigerian Naira (₦)</div>
    </div>
    <div class="page-actions">
      <a href="/cds-cooperative/loan-report" class="action-btn"><i class="fas fa-file-invoice-dollar" style="font-size:12px;"></i> Loan Report</a>
      <button class="action-btn" onclick="window.print()"><i class="fas fa-print" style="font-size:12px;"></i> Print</button>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon-wrap" style="background:rgba(34,199,138,.1);color:var(--green);"><i class="fas fa-arrow-down"></i></div>
      <div class="stat-label">Total Deposited</div>
      <div class="stat-value" style="color:var(--green);">₦<%= totalDeposited.toLocaleString() %></div>
      <div class="stat-sub">All approved deposits</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon-wrap" style="background:rgba(240,82,82,.1);color:var(--red);"><i class="fas fa-arrow-up"></i></div>
      <div class="stat-label">Total Withdrawn</div>
      <div class="stat-value" style="color:var(--red);">₦<%= totalWithdrawn.toLocaleString() %></div>
      <div class="stat-sub">All approved withdrawals</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon-wrap" style="background:rgba(79,142,247,.1);color:var(--accent);"><i class="fas fa-chart-line"></i></div>
      <div class="stat-label">ROI Earned</div>
      <div class="stat-value" style="color:var(--accent);">₦<%= totalROIEarned.toLocaleString(undefined,{maximumFractionDigits:2}) %></div>
      <div class="stat-sub">Monthly interest credited</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon-wrap" style="background:rgba(124,90,244,.1);color:var(--accent2);"><i class="fas fa-wallet"></i></div>
      <div class="stat-label">Current Balance</div>
      <div class="stat-value">₦<%= currentBalance.toLocaleString() %></div>
