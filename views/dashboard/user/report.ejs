    </div>
  </div>

  <!-- Bar Chart Hero -->
  <div class="chart-hero">
    <div class="chart-header">
      <span class="chart-title">Cash Flow — Last 6 Months</span>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;gap:10px;">
        <div class="chart-legend">
          <div class="legend-item"><div class="legend-dot" style="background:var(--green);"></div> Deposits</div>
          <div class="legend-item"><div class="legend-dot" style="background:var(--red);"></div> Withdrawals</div>
          <div class="legend-item"><div class="legend-dot" style="background:var(--accent);"></div> ROI</div>
        </div>
      </div>
    </div>
    <div class="chart-wrap">
      <canvas id="flowChart"></canvas>
    </div>
  </div>

  <!-- Main 2-col -->
  <div class="two-col">

    <!-- Transaction Table -->
    <div class="tx-card">
      <div class="tx-card-header">
        <span class="tx-card-title">All Transactions</span>
        <div class="filter-row">
          <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search…" oninput="filterTable()">
          </div>
          <select class="filter-select" id="typeFilter" onchange="filterTable()">
            <option value="">All Types</option>
            <option value="deposit">Deposits</option>
            <option value="withdrawal">Withdrawals</option>
            <option value="roi">ROI Credits</option>
          </select>
          <select class="filter-select" id="statusFilter" onchange="filterTable()">
            <option value="">All Status</option>
            <option value="approved">Approved</option>
            <option value="pending">Pending</option>
            <option value="failed">Failed</option>
          </select>
        </div>
      </div>

      <div style="overflow-x:auto;">
        <table class="tx-table" id="txTable">
          <thead>
            <tr>
              <th>Transaction</th>
              <th>Amount</th>
              <th>Date</th>
              <th>Method</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="txBody">
            <% if (txList.length === 0) { %>
            <tr>
              <td colspan="5" style="padding:0;">
                <div class="empty-state">
                  <div class="empty-icon"><i class="fas fa-receipt"></i></div>
                  <div style="font-size:14px;font-weight:500;">No transactions yet</div>
                  <div style="font-size:12px;color:var(--muted);">Your financial activity will appear here</div>
                </div>
              </td>
            </tr>
            <% } else { %>
            <% txList.forEach((tx, i) => {
              const isIn  = tx.type === 'deposit' || tx.type === 'roi';
              const isOut = tx.type === 'withdrawal';
              const iconMap = { deposit:'fa-arrow-down', withdrawal:'fa-arrow-up', roi:'fa-chart-line', 'loan-repayment':'fa-credit-card' };
              const bgMap  = { deposit:'rgba(34,199,138,.1)', withdrawal:'rgba(240,82,82,.1)', roi:'rgba(79,142,247,.1)', 'loan-repayment':'rgba(124,90,244,.1)' };
              const clrMap = { deposit:'var(--green)', withdrawal:'var(--red)', roi:'var(--accent)', 'loan-repayment':'var(--accent2)' };
              const icon   = iconMap[tx.type]  || 'fa-circle';
              const bg     = bgMap[tx.type]    || 'var(--bg-card3)';
              const clr    = clrMap[tx.type]   || 'var(--muted)';
              const label  = tx.type === 'deposit' ? 'Deposit' : tx.type === 'withdrawal' ? 'Withdrawal' : tx.type === 'roi' ? 'ROI Credit' : tx.type === 'loan-repayment' ? 'Loan Payment' : tx.type;
              const amtClass = tx.type === 'roi' ? 'roi' : isIn ? 'in' : 'out';
              const prefix = isOut ? '-' : '+';
              const statusClass = ['approved','paid','success'].includes(tx.status) ? 'status-approved' : tx.status === 'pending' ? 'status-pending' : 'status-failed';
              const txDate = tx.createdAt ? new Date(tx.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—';
              const ref = tx.reference || tx._id?.toString().slice(-8).toUpperCase() || '—';
            %>
            <tr data-type="<%= tx.type %>" data-status="<%= tx.status %>" data-search="<%= label.toLowerCase() %> <%= (tx.method||'').toLowerCase() %> <%= ref.toLowerCase() %>">
              <td>
                <div class="tx-row-inner">
                  <div class="tx-type-icon" style="background:<%= bg %>;color:<%= clr %>;"><i class="fas <%= icon %>"></i></div>
                  <div>
                    <div class="tx-label"><%= label %></div>
                    <div class="tx-ref"><%= ref %></div>
                  </div>
                </div>
              </td>
              <td><span class="tx-amount <%= amtClass %>"><%= prefix %>₦<%= (tx.amount||0).toLocaleString(undefined,{minimumFractionDigits:2}) %></span></td>
              <td><span class="tx-date"><%= txDate %></span></td>
              <td><span style="font-size:12px;color:var(--muted);text-transform:capitalize;"><%= tx.method || tx.paymentMethod || '—' %></span></td>
              <td><span class="tx-status <%= statusClass %>"><%= (tx.status||'unknown').charAt(0).toUpperCase() + (tx.status||'unknown').slice(1) %></span></td>
            </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="pagination-row">
        <span class="page-info" id="pageInfo">Showing all transactions</span>
        <div class="page-btns" id="pageBtns"></div>
      </div>
    </div>

    <!-- Side Summary -->
    <div style="display:flex;flex-direction:column;gap:14px;">

      <!-- Balance Breakdown -->
      <div class="summary-card">
        <div class="sc-title">Balance Summary</div>
        <div class="sc-big">₦<%= currentBalance.toLocaleString() %></div>
        <div style="font-size:11px;color:var(--muted);margin-bottom:12px;">Current savings balance</div>
        <div class="sc-row"><span class="sc-label">Total in (deposits)</span><span class="sc-val" style="color:var(--green);">+₦<%= totalDeposited.toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">Total out (withdrawals)</span><span class="sc-val" style="color:var(--red);">-₦<%= totalWithdrawn.toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">ROI credited</span><span class="sc-val" style="color:var(--accent);">+₦<%= totalROIEarned.toLocaleString(undefined,{maximumFractionDigits:2}) %></span></div>
        <hr class="sc-divider">
        <div class="sc-row"><span class="sc-label" style="font-weight:600;">Net flow</span><span class="sc-val" style="color:<%= netFlow >= 0 ? 'var(--green)' : 'var(--red)' %>;">₦<%= netFlow.toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">Member since</span><span class="sc-val"><%= new Date(user.createdAt).toLocaleDateString('en-US',{month:'short',year:'numeric'}) %></span></div>
        <div class="sc-row"><span class="sc-label">Total transactions</span><span class="sc-val"><%= txList.length %></span></div>
      </div>

      <!-- ROI Summary -->
      <div class="summary-card">
        <div class="sc-title">ROI Details</div>
        <div class="sc-row"><span class="sc-label">Monthly ROI earned</span><span class="sc-val" style="color:var(--accent);">₦<%= (monthlyROI||0).toLocaleString(undefined,{maximumFractionDigits:2}) %></span></div>
        <div class="sc-row"><span class="sc-label">Interest rate</span><span class="sc-val"><%= interestRate || '—' %>%</span></div>
        <div class="sc-row"><span class="sc-label">Pool share</span><span class="sc-val"><%= sharePercentage || '0' %>%</span></div>
        <div class="sc-row"><span class="sc-label">Total ROI earned</span><span class="sc-val" style="color:var(--green);">₦<%= totalROIEarned.toLocaleString(undefined,{maximumFractionDigits:2}) %></span></div>
        <div class="roi-meter">
          <div class="roi-meter-label"><span>Your pool share</span><span><%= sharePercentage || '0' %>%</span></div>
          <div class="roi-bar"><div class="roi-bar-fill" style="width:<%= Math.min(parseFloat(sharePercentage||0),100) %>%"></div></div>
        </div>

        <!-- Donut Chart -->
        <div class="donut-wrap"><canvas id="donutChart" width="120" height="120"></canvas></div>
        <div class="donut-legend">
          <div class="dl-item"><div class="dl-left"><div class="dl-dot" style="background:var(--green);"></div>Deposits</div><div class="dl-val">₦<%= totalDeposited.toLocaleString() %></div></div>
          <div class="dl-item"><div class="dl-left"><div class="dl-dot" style="background:var(--red);"></div>Withdrawals</div><div class="dl-val">₦<%= totalWithdrawn.toLocaleString() %></div></div>
          <div class="dl-item"><div class="dl-left"><div class="dl-dot" style="background:var(--accent);"></div>ROI</div><div class="dl-val">₦<%= totalROIEarned.toLocaleString(undefined,{maximumFractionDigits:0}) %></div></div>
        </div>
      </div>

    </div>
  </div>

</main>

<div class="powered-by">Powered by <strong>JESZ LIMITED</strong></div>

<!-- Chart.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
/* ─ Pass EJS data to JS ─ */
const TX_DATA = <%- JSON.stringify(txList.map(t=>({type:t.type,amount:t.amount||0,status:t.status,createdAt:t.createdAt}))) %>;
const MONTHLY_ROI  = <%= monthlyROI || 0 %>;
const SHARE_PCT    = <%= parseFloat(sharePercentage || 0) %>;
const TOTAL_DEP    = <%= totalDeposited %>;
const TOTAL_WD     = <%= totalWithdrawn %>;
const TOTAL_ROI    = <%= totalROIEarned %>;

/* ─ Theme ─ */
(function(){
  const saved = localStorage.getItem('cds-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  updateThemeUI(saved);
})();
function toggleTheme(){
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('cds-theme', next);
  updateThemeUI(next);
  rebuildCharts();
}
function updateThemeUI(t){
  const i = document.getElementById('togIcon');
  if(i) i.className = t === 'dark' ? 'fas fa-moon' : 'fas fa-sun';
}
function getCSSVar(v){ return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }

/* ─ Sidebar ─ */
function toggleSidebar(){
  const open = document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sbOverlay').classList.toggle('show', open);
  document.body.style.overflow = open ? 'hidden' : '';
}
function closeSidebar(){
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sbOverlay').classList.remove('show');
  document.body.style.overflow = '';
}
document.addEventListener('click', e => {
  const sb = document.getElementById('sidebar'), hb = document.querySelector('.hamburger');
  if(window.innerWidth<=900 && sb.classList.contains('open') && !sb.contains(e.target) && hb && !hb.contains(e.target)) closeSidebar();
});

/* ─ Build last-6-months labels ─ */
function getLast6Months(){
  const months = [];
  for(let i = 5; i >= 0; i--){
    const d = new Date(); d.setMonth(d.getMonth() - i);
    months.push({ label: d.toLocaleDateString('en-US',{month:'short'}), year: d.getFullYear(), month: d.getMonth() });
  }
  return months;
}

function buildMonthlyData(){
  const months = getLast6Months();
  const deps = months.map(m => TX_DATA.filter(t => t.type==='deposit' && t.status==='approved' && new Date(t.createdAt).getMonth()===m.month && new Date(t.createdAt).getFullYear()===m.year).reduce((s,t)=>s+t.amount,0));
  const wds  = months.map(m => TX_DATA.filter(t => t.type==='withdrawal' && t.status==='approved' && new Date(t.createdAt).getMonth()===m.month && new Date(t.createdAt).getFullYear()===m.year).reduce((s,t)=>s+t.amount,0));
  const rois = months.map(m => TX_DATA.filter(t => t.type==='roi' && new Date(t.createdAt).getMonth()===m.month && new Date(t.createdAt).getFullYear()===m.year).reduce((s,t)=>s+t.amount,0));
  return { labels: months.map(m=>m.label), deps, wds, rois };
}

let flowChart, donutChart;
function rebuildCharts(){
  if(flowChart)  flowChart.destroy();
  if(donutChart) donutChart.destroy();
  buildFlowChart();
  buildDonutChart();
}

function buildFlowChart(){
  const { labels, deps, wds, rois } = buildMonthlyData();
  const gridColor = getCSSVar('--border');
  const textColor = getCSSVar('--muted');
  const ctx = document.getElementById('flowChart').getContext('2d');
  flowChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [
        { label:'Deposits',    data:deps, backgroundColor:'rgba(34,199,138,.55)', borderRadius:5, borderSkipped:false },
        { label:'Withdrawals', data:wds,  backgroundColor:'rgba(240,82,82,.55)',  borderRadius:5, borderSkipped:false },
        { label:'ROI',         data:rois, backgroundColor:'rgba(79,142,247,.55)', borderRadius:5, borderSkipped:false },
      ]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{ display:false }, tooltip:{ callbacks:{ label: ctx => ' ₦' + ctx.raw.toLocaleString() }}},
      scales:{
        x:{ grid:{ color:gridColor }, ticks:{ color:textColor, font:{size:11} }},
        y:{ grid:{ color:gridColor }, ticks:{ color:textColor, font:{size:11}, callback: v => '₦'+v.toLocaleString() }, beginAtZero:true }
      }
    }
  });
}

function buildDonutChart(){
  const ctx = document.getElementById('donutChart').getContext('2d');
  const total = TOTAL_DEP + TOTAL_WD + TOTAL_ROI || 1;
  donutChart = new Chart(ctx, {
    type:'doughnut',
    data:{
      labels:['Deposits','Withdrawals','ROI'],
      datasets:[{ data:[TOTAL_DEP, TOTAL_WD, TOTAL_ROI], backgroundColor:['rgba(34,199,138,.7)','rgba(240,82,82,.7)','rgba(79,142,247,.7)'], borderWidth:0, hoverOffset:4 }]
    },
    options:{
      responsive:false, cutout:'72%',
      plugins:{ legend:{ display:false }, tooltip:{ callbacks:{ label: ctx => ' ₦'+ctx.raw.toLocaleString() }}}
    }
  });
}

/* ─ Table filter ─ */
let currentPage = 1;
const PER_PAGE = 15;
function filterTable(){
  const q      = document.getElementById('searchInput').value.toLowerCase();
  const type   = document.getElementById('typeFilter').value;
  const status = document.getElementById('statusFilter').value;
  const rows   = [...document.querySelectorAll('#txBody tr[data-type]')];
  let visible  = [];
  rows.forEach(r => {
    const show = (!type   || r.dataset.type   === type) &&
                 (!status || r.dataset.status  === status) &&
                 (!q      || r.dataset.search.includes(q));
    r.style.display = show ? '' : 'none';
    if(show) visible.push(r);
  });
  currentPage = 1;
  paginateRows(visible);
}
function paginateRows(visible){
  const total = visible.length;
  const pages = Math.max(1, Math.ceil(total / PER_PAGE));
  visible.forEach((r,i) => r.style.display = (i >= (currentPage-1)*PER_PAGE && i < currentPage*PER_PAGE) ? '' : 'none');
  document.getElementById('pageInfo').textContent = total === 0 ? 'No results' : `Showing ${Math.min((currentPage-1)*PER_PAGE+1,total)}–${Math.min(currentPage*PER_PAGE,total)} of ${total}`;
  const pb = document.getElementById('pageBtns'); pb.innerHTML = '';
  if(pages <= 1) return;
  const prev = document.createElement('button'); prev.className='page-btn'; prev.textContent='‹'; prev.disabled=currentPage===1;
  prev.onclick = () => { currentPage--; paginateRows(visible); };
  pb.appendChild(prev);
  for(let p=1;p<=Math.min(pages,5);p++){
    const b=document.createElement('button'); b.className='page-btn'+(p===currentPage?' active':''); b.textContent=p;
    b.onclick=(()=>{const pp=p;return()=>{currentPage=pp;paginateRows(visible);}})();
    pb.appendChild(b);
  }
  const next=document.createElement('button'); next.className='page-btn'; next.textContent='›'; next.disabled=currentPage===pages;
  next.onclick=()=>{currentPage++;paginateRows(visible);}; pb.appendChild(next);
}

/* ─ Loader + Init ─ */
window.addEventListener('load',()=>{
  const l=document.getElementById('loader');
  setTimeout(()=>{l.style.opacity='0';setTimeout(()=>l.style.display='none',500);},400);
  buildFlowChart();
  buildDonutChart();
  // Init pagination
  const rows = [...document.querySelectorAll('#txBody tr[data-type]')];
  if(rows.length) paginateRows(rows);
  else document.getElementById('pageInfo').textContent = 'No transactions';
});
</script>

<script>
(function () {
    const TIMEOUT_MS  = 60 * 60 * 1000;
    const WARNING_MS  = 20 * 1000;
    const LOGOUT_URL  = '/logout';
    const PING_URL    = '/api/ping';     // keeps session alive on activity

    let logoutTimer, warningTimer, warningEl;

    function resetTimers() {
        clearTimeout(logoutTimer);
        clearTimeout(warningTimer);
        hideWarning();

        warningTimer = setTimeout(showWarning, TIMEOUT_MS - WARNING_MS);
        logoutTimer  = setTimeout(() => { window.location.href = LOGOUT_URL; }, TIMEOUT_MS);
    }

    function showWarning() {
        if (warningEl) return;
        warningEl = document.createElement('div');
        warningEl.id = 'inactivity-warning';
        warningEl.innerHTML = `
            <div style="
                position:fixed;bottom:24px;right:24px;z-index:99999;
                background:#1e3a8a;color:#fff;border-radius:14px;
                padding:16px 20px;max-width:300px;
                box-shadow:0 8px 32px rgba(0,0,0,.3);font-size:13px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
            ">
                <strong style="display:block;margin-bottom:6px;">⏱ Session expiring</strong>
                You'll be logged out in 1 minute due to inactivity.
                <button onclick="stayLoggedIn()" style="
                    display:block;margin-top:12px;width:100%;
                    padding:8px;border:none;border-radius:8px;
                    background:#fff;color:#1e3a8a;font-weight:700;
                    cursor:pointer;font-size:13px;
                ">Stay logged in</button>
            </div>`;
        document.body.appendChild(warningEl);
    }

    function hideWarning() {
        if (warningEl) { warningEl.remove(); warningEl = null; }
    }

    window.stayLoggedIn = function () {
        fetch(PING_URL, { credentials: 'same-origin' }); // touch the session
        resetTimers();
    };

    // Reset on any user activity
    ['mousemove','keydown','mousedown','touchstart','scroll'].forEach(evt => {
        document.addEventListener(evt, resetTimers, { passive: true });
    });

    resetTimers(); // start on page load
})();
</script>
</body>
</html>
