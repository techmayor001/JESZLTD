<script>
/* ================= SERVER FLAGS ================= */
const USER_HAS_LOAN = <%= user.loans && user.loans.length > 0 ? "true" : "false" %>;
const USER_IS_GUARANTOR = <%= user.guarantorRequests?.some(g => g.status === "accepted") ? "true" : "false" %>;
const USER_BALANCE = <%= user.account?.balance || 0 %>;
const FORCE_FEE_PERCENT = <%= forceWithdrawalCharge %>;
const FORCEFUL_WITHDRAWAL_COUNT = <%= forcefulWithdrawalCount || 0 %>;
const MAX_FORCEFUL_WITHDRAWALS = 2;

/* ================= UPDATE FEE ================= */
function updateWithdrawalFee() {
    const type = document.getElementById('withdrawalType').value;
    const amountInput = document.getElementById('withdrawAmount');
    const feeInfo = document.getElementById('withdrawalFeeInfo');

    const amount = Number(amountInput.value) || 0;
    const halfBalance = USER_BALANCE / 2;
    const chargeRate = FORCE_FEE_PERCENT / 100;

    if (!type || amount <= 0) {
        feeInfo.style.display = 'none';
        return;
    }

    if (amount > USER_BALANCE) {
        amountInput.value = USER_BALANCE;
        return updateWithdrawalFee();
    }

    let initialFee = 0;
    let secondFee = 0;
    let payoutNow = 0;
    let labelText = "";
    let timingMessage = "";

    /* ================= FORCE WITHDRAWAL ================= */
    if (type === "force") {

        if (FORCEFUL_WITHDRAWAL_COUNT >= MAX_FORCEFUL_WITHDRAWALS) {
            new bootstrap.Modal(
                document.getElementById("withdrawLimitModal")
            ).show();

            document.getElementById("withdrawalType").value = "";
            feeInfo.style.display = "none";
            return;
        }

        if (amount < halfBalance) {
            initialFee = amount * chargeRate;
            payoutNow = amount - initialFee;
            labelText = "You'll Receive Immediately:";
            timingMessage = "This withdrawal will be credited immediately.";

        } else if (amount === halfBalance) {
            initialFee = amount * chargeRate;
            payoutNow = amount - initialFee;
            labelText = "You'll Receive Within 30 Days:";
            timingMessage = "This withdrawal will be credited within 30 days.";

        } else {
            initialFee = (amount * chargeRate) / 2;
            secondFee  = (amount * chargeRate) / 2;
            payoutNow = halfBalance - initialFee;
            labelText = "First Payout (Within 30 Days):";
            timingMessage = "This withdrawal will be paid in two phases. First payout within 30 days.";
        }
    }

    /* ================= REGULAR ================= */
    if (type === "regular") {
        payoutNow = amount;
        labelText = "You'll Receive:";
        timingMessage = "This withdrawal will be processed within 24–48 hours.";
    }

    feeInfo.style.display = 'block';

    document.getElementById('withdrawAmountDisplay').innerText = `₦${amount.toLocaleString()}`;
    document.getElementById('initialFee').innerText = `₦${initialFee.toLocaleString(undefined,{minimumFractionDigits:2})}`;
    document.getElementById('secondFee').innerText = `₦${secondFee.toLocaleString(undefined,{minimumFractionDigits:2})}`;
    document.getElementById('netAmount').innerText = `₦${payoutNow.toLocaleString(undefined,{minimumFractionDigits:2})}`;
    document.getElementById('payoutLabel').innerText = labelText;
    document.getElementById('withdrawTimingNotice').innerText = timingMessage;
}

/* ================= SUBMIT WITHDRAWAL ================= */
async function submitWithdrawal() {

    const withdrawModal = document.getElementById("withdrawModal");
    const successModal = new bootstrap.Modal(
        document.getElementById("withdrawSuccessModal")
    );
    const failedModal = new bootstrap.Modal(
        document.getElementById("withdrawFailedModal")
    );
    const limitModal = new bootstrap.Modal(
        document.getElementById("withdrawLimitModal")
    );

    const errorMsg = document.getElementById("withdrawErrorMsg");

    const type = document.getElementById("withdrawalType").value;
    const amount = Number(document.getElementById("withdrawAmount").value);

    try {
        if (!type) throw new Error("Please select a withdrawal type.");
        if (!amount || amount <= 0) throw new Error("Invalid withdrawal amount.");
        if (amount > USER_BALANCE) throw new Error("Insufficient balance.");

        if (type === "force" && FORCEFUL_WITHDRAWAL_COUNT >= MAX_FORCEFUL_WITHDRAWALS) {
            limitModal.show();
            return;
        }

        if (USER_HAS_LOAN === "true") {
            throw new Error("You cannot withdraw while you have an active loan.");
        }

        if (USER_IS_GUARANTOR === "true" && amount >= USER_BALANCE) {
            throw new Error("Guarantors cannot withdraw full balance.");
        }

        if (type === "regular") {
            const today = new Date();
            const day = today.getDate();
            const month = today.getMonth();
            if (month !== 11 || day < 1 || day > 10) {
                throw new Error("Regular withdrawals are only allowed between Dec 1–10.");
            }
        }

        const res = await fetch("/withdraw", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ type, amount })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.message || "Withdrawal failed.");

        /* ✅ KEEP PROCESSING MODAL */
        bootstrap.Modal.getInstance(withdrawModal).hide();
        successModal.show();

        document.querySelector("#withdrawModal form").reset();
        document.getElementById("withdrawalFeeInfo").style.display = "none";

    } catch (err) {
        errorMsg.innerText = err.message;
        failedModal.show();
    }
}
</script>


<script>
document.addEventListener("DOMContentLoaded", () => {

  const paymentMethod = document.getElementById("paymentMethod");
  const paystackSection = document.getElementById("paystackSection");
  const cooperativeSection = document.getElementById("cooperativeSection");
  const coopSource = document.getElementById("coopSource");
  const coopBankDetails = document.getElementById("coopBankDetails");
  const coopNoExtra = document.getElementById("coopNoExtra");
  const form = document.getElementById("depositForm");
  const submitBtn = document.getElementById("submitDeposit");

  /* BOOTSTRAP MODALS */
  const depositModalEl = document.getElementById("depositModal");
  const successModal = new bootstrap.Modal(
    document.getElementById("depositSuccessModal")
  );
  const failedModal = new bootstrap.Modal(
    document.getElementById("depositFailedModal")
  );

  /* PAYMENT METHOD SWITCH */
  paymentMethod.addEventListener("change", () => {
    paystackSection.classList.add("d-none");
    cooperativeSection.classList.add("d-none");

    if (paymentMethod.value === "paystack") {
      paystackSection.classList.remove("d-none");
    }

    if (paymentMethod.value === "cooperative") {
      cooperativeSection.classList.remove("d-none");
    }
  });

  /* COOPERATIVE SOURCE */
  coopSource.addEventListener("change", () => {
    coopBankDetails.classList.toggle("d-none", !coopSource.value);
    coopNoExtra.classList.toggle("d-none", coopSource.value !== "no");
  });

  /* SUBMIT HANDLER */
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const method = paymentMethod.value;

    submitBtn.disabled = true;
    submitBtn.innerHTML = "Processing...";

    try {

      /* ================= PAYSTACK ================= */
      if (method === "paystack") {
        const amount = document.getElementById("paystackAmount").value;

        const res = await fetch("/deposit/init", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ amount })
        });

        const data = await res.json();

        if (data.authorization_url) {
          window.location.href = data.authorization_url;
          return;
        }

        throw new Error(data.message || "Paystack init failed");
      }

      /* ================= COOPERATIVE ================= */
      if (method === "cooperative") {
        const payload = {
          coopAmount: document.getElementById("coopAmount").value,
          source: document.getElementById("coopSource").value,
          payeeName: document.getElementById("payerName")?.value || ""
        };

        const res = await fetch("/deposit/cooperative", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          throw new Error("Cooperative deposit failed");
        }

        /* CLOSE DEPOSIT MODAL */
        bootstrap.Modal.getInstance(depositModalEl).hide();

        /* SHOW SUCCESS MODAL */
        successModal.show();
        form.reset();

        paystackSection.classList.add("d-none");
        cooperativeSection.classList.add("d-none");
      }

    } catch (err) {
      console.error(err);
      failedModal.show();
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = "Proceed";
    }
  });

});
</script>


<script>
document.addEventListener("DOMContentLoaded", () => {

  const loanSelect = document.getElementById("loanSelect");
  const paymentMethod = document.getElementById("loanPaymentMethod");
  const paystackSection = document.getElementById("loanPaystackSection");
  const coopSection = document.getElementById("loanCoopSection");
  const form = document.getElementById("loanRepaymentForm");
  const submitBtn = document.getElementById("submitLoanPayment");

  const successModal = new bootstrap.Modal(
    document.getElementById("loanPaymentSuccessModal")
  );
  const failedModal = new bootstrap.Modal(
    document.getElementById("loanPaymentFailedModal")
  );

  /* Load all active loans */
  async function loadLoans() {
    const res = await fetch("/api/user/loans/active");
    const loans = await res.json();

    loanSelect.innerHTML = '<option value="">Select loan</option>';

    loans.forEach(loan => {
      const opt = document.createElement("option");
      opt.value = loan._id;
      opt.textContent = `₦${loan.totalRepay.toLocaleString()} due - ${new Date(loan.dueDate).toDateString()}`;
      loanSelect.appendChild(opt);
    });
  }

  loadLoans();

  /* Payment method switch */
  paymentMethod.addEventListener("change", () => {
    paystackSection.classList.add("d-none");
    coopSection.classList.add("d-none");

    if (paymentMethod.value === "paystack") {
      paystackSection.classList.remove("d-none");
    }

    if (paymentMethod.value === "cooperative") {
      coopSection.classList.remove("d-none");
    }
  });

  /* Submit handler */
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const loanId = loanSelect.value;
    const method = paymentMethod.value;

    if (!loanId || !method) {
      failedModal.show();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = "Processing...";

    try {

      /* PAYSTACK */
      if (method === "paystack") {
        const amount = document.getElementById("loanPaystackAmount").value;

        const res = await fetch("/loan/payment", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ loanId, amount })
        });

        const data = await res.json();

        if (data.authorization_url) {
          window.location.href = data.authorization_url;
          return;
        }

        throw new Error("Paystack failed");
      }

      /* MANUAL */
      if (method === "cooperative") {
        const payload = {
          loanId,
          amount: document.getElementById("loanCoopAmount").value,
          payerName: document.getElementById("loanPayerName").value
        };

        const res = await fetch("/loan/payment/manual", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        if (!res.ok) throw new Error("Manual payment failed");

        form.reset();
        successModal.show();

        setTimeout(() => {
          location.reload();
        }, 2500);
      }

    } catch (err) {
      console.error(err);
      failedModal.show();
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = "Proceed";
    }
  });

});
</script>


