<!-- ════ SCRIPTS ════ -->
<script>
const USER_STATUS               = "<%= user.status %>";
const USER_HAS_LOAN             = <%= loan ? "true" : "false" %>;
const USER_IS_GUARANTOR         = <%= user.guarantorRequests?.some(g=>g.status==="accepted") ? "true" : "false" %>;
const USER_BALANCE              = <%= user.account?.balance || 0 %>;
const ONDEMAND_FEE_PERCENT      = <%= forceWithdrawalPenalty %>;
const ONDEMAND_COUNT_THIS_YEAR  = <%= forcefulWithdrawalCount || 0 %>;
const MAX_ONDEMAND_PER_YEAR     = 2;
const MIN_BALANCE               = 10000;

/* ── Theme ── */
(function(){
  const saved = localStorage.getItem('cds-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  updateThemeUI(saved);
})();
function toggleTheme(){
  const current = document.documentElement.getAttribute('data-theme');
  const next = current === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('cds-theme', next);
  updateThemeUI(next);
}
function updateThemeUI(theme){
  const icon = document.getElementById('togIcon');
  if(icon){ icon.className = theme === 'dark' ? 'fas fa-moon' : 'fas fa-sun'; }
}

/* ── Sidebar ── */
function toggleSidebar(){
  const open = document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sbOverlay').classList.toggle('show', open);
  document.body.style.overflow = open ? 'hidden' : '';
}
function closeSidebar(){
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sbOverlay').classList.remove('show');
  document.body.style.overflow = '';
}

/* ── Modals ── */
function openModal(id){ document.getElementById(id).classList.add('open'); document.body.style.overflow='hidden'; }
function closeModal(id){ document.getElementById(id).classList.remove('open'); document.body.style.overflow=''; }
document.querySelectorAll('.modal-backdrop').forEach(el=>{
  el.addEventListener('click',e=>{ if(e.target===el){ el.classList.remove('open'); document.body.style.overflow=''; }});
});
function checkUserStatus(modalId){
  if(USER_STATUS==='pending') openModal('pendingAccountModal');
  else openModal(modalId);
}

/* ── Copy account number ── */
let copyToastTimer = null;
function copyAccountNumber(number, el){
  navigator.clipboard.writeText(number).then(function(){
    /* Visual feedback on the element */
    el.classList.add('copied');
    const icon = el.querySelector('.copy-icon');
    if(icon){ icon.className = 'fas fa-check copy-icon'; }
    /* Toast */
    const toast = document.getElementById('copyToast');
    toast.classList.add('show');
    if(copyToastTimer) clearTimeout(copyToastTimer);
    copyToastTimer = setTimeout(function(){
      toast.classList.remove('show');
      el.classList.remove('copied');
      if(icon){ icon.className = 'fas fa-copy copy-icon'; }
    }, 2200);
  }).catch(function(){
    /* Fallback for older browsers / http */
    const ta = document.createElement('textarea');
    ta.value = number; ta.style.position='fixed'; ta.style.opacity='0';
    document.body.appendChild(ta); ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
  });
}

/* ── helpers ── */
const fmt = n => '₦' + Number(n).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});

function willDeactivate(type, amount){
  return (USER_BALANCE - amount) < MIN_BALANCE;
}

/* ── Live fee/payout preview ── */
function updateWithdrawalFee(){
  const type    = document.getElementById('withdrawalType').value;
  const input   = document.getElementById('withdrawAmount');
  const box     = document.getElementById('withdrawalFeeInfo');
  const lockAl  = document.getElementById('lockAlertBox');
  const capAl   = document.getElementById('overCapAlertBox');
  const amount  = Number(input.value) || 0;
  const half    = parseFloat((USER_BALANCE / 2).toFixed(2));
  const rate    = ONDEMAND_FEE_PERCENT / 100;
  box.style.display    = 'none';
  lockAl.style.display = 'none';
  capAl.style.display  = 'none';
  if(!type || amount <= 0) return;
  if(amount > USER_BALANCE){ input.value = USER_BALANCE; return updateWithdrawalFee(); }
  if(type === 'ondemand' && ONDEMAND_COUNT_THIS_YEAR >= MAX_ONDEMAND_PER_YEAR){
    openModal('withdrawLimitModal');
    document.getElementById('withdrawalType').value = '';
    return;
  }
  if(type === 'ondemand' && amount > half){
    document.getElementById('overCapMax').textContent = fmt(half);
    capAl.style.display = 'block';
  }
  if(willDeactivate(type, amount)) lockAl.style.display = 'block';
  const isOnDemand  = type === 'ondemand';
  const penaltyAmt  = isOnDemand ? parseFloat((amount * rate).toFixed(2)) : 0;
  const net         = parseFloat((amount - penaltyAmt).toFixed(2));
  box.style.display = 'block';
  document.getElementById('withdrawAmountDisplay').textContent = fmt(amount);
  const feeRow = document.getElementById('feeRow');
  if(isOnDemand && penaltyAmt > 0){
    feeRow.style.display = 'flex';
    document.getElementById('feeRowLabel').textContent = 'On-demand fee (' + ONDEMAND_FEE_PERCENT + '%)';
    document.getElementById('initialFee').textContent  = fmt(penaltyAmt);
  } else {
    feeRow.style.display = 'none';
  }
  document.getElementById('payoutLabel').textContent = isOnDemand ? 'You receive (immediate)' : 'You receive';
  document.getElementById('netAmount').textContent   = fmt(net);
  document.getElementById('withdrawTimingNotice').textContent = isOnDemand
    ? 'Net amount credited to your bank immediately after admin processes.'
    : 'Processed within 24–48 hours.';
}

function confirmWithdrawal(){
  const type   = document.getElementById('withdrawalType').value;
  const amount = Number(document.getElementById('withdrawAmount').value);
  const errMsg = document.getElementById('withdrawErrorMsg');
  try {
    if(!type)                  throw new Error('Select a withdrawal type.');
    if(!amount || amount <= 0) throw new Error('Enter a valid amount.');
    if(amount > USER_BALANCE)  throw new Error('Insufficient balance.');
    if(type === 'ondemand'){
      if(ONDEMAND_COUNT_THIS_YEAR >= MAX_ONDEMAND_PER_YEAR){ openModal('withdrawLimitModal'); return; }
      const half = parseFloat((USER_BALANCE / 2).toFixed(2));
      if(amount > half) throw new Error('On-demand withdrawals cannot exceed 50% of your balance (' + fmt(half) + ').');
    }
    if(USER_HAS_LOAN) throw new Error('You cannot withdraw while you have an active loan.');
    if(USER_IS_GUARANTOR === 'true' && amount >= USER_BALANCE) throw new Error('Guarantors cannot withdraw their full balance.');
    if(type === 'regular'){
      const d = new Date();
      if(d.getMonth() !== 11 || d.getDate() < 1 || d.getDate() > 10)
        throw new Error('Regular withdrawals are only allowed Dec 1–10.');
    }
    if(willDeactivate(type, amount)){
      const balAfter   = Math.max(0, USER_BALANCE - amount);
      const isOnDemand = type === 'ondemand';
      const penaltyAmt = isOnDemand ? parseFloat((amount * ONDEMAND_FEE_PERCENT / 100).toFixed(2)) : 0;
      const netAmt     = parseFloat((amount - penaltyAmt).toFixed(2));
      document.getElementById('confirmDeactivationMsg').innerHTML =
        'This withdrawal will reduce your balance to <strong>' + fmt(balAfter) + '</strong>, ' +
        'which is below the <strong>₦10,000 minimum</strong>. Your account will be ' +
        '<strong>automatically deactivated</strong> once processed. ' +
        'Contact the cooperative administrator to reactivate.';
      document.getElementById('confirmAmount').textContent   = fmt(amount);
      document.getElementById('confirmBalAfter').textContent = fmt(balAfter);
      const confirmFeeRow = document.getElementById('confirmFeeRow');
      const confirmNetRow = document.getElementById('confirmNetRow');
      if(isOnDemand && penaltyAmt > 0){
        confirmFeeRow.style.display = 'flex';
        document.getElementById('confirmFeeLabel').textContent = 'On-demand fee (' + ONDEMAND_FEE_PERCENT + '%)';
        document.getElementById('confirmFeeAmt').textContent   = fmt(penaltyAmt);
        confirmNetRow.style.display = 'flex';
        document.getElementById('confirmNetAmt').innerHTML =
          fmt(netAmt) + ' <span style="color:var(--muted);font-size:11px;">(immediate)</span>';
      } else {
        confirmFeeRow.style.display = 'none';
        confirmNetRow.style.display = 'none';
      }
      const p1r = document.getElementById('confirmPhase1Row');
      const p2r = document.getElementById('confirmPhase2Row');
      if(p1r) p1r.style.display = 'none';
      if(p2r) p2r.style.display = 'none';
      closeModal('withdrawModal');
      openModal('withdrawConfirmModal');
    } else {
      proceedWithWithdrawal();
    }
  } catch(e){
    errMsg.textContent = e.message;
    openModal('withdrawFailedModal');
  }
}

async function proceedWithWithdrawal(){
  const type   = document.getElementById('withdrawalType').value;
  const amount = Number(document.getElementById('withdrawAmount').value);
  const errMsg = document.getElementById('withdrawErrorMsg');
  closeModal('withdrawConfirmModal');
  try {
    const res  = await fetch('/withdraw',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type,amount})});
    const data = await res.json();
    if(!res.ok) throw new Error(data.message || 'Withdrawal failed.');
    const successEl = document.getElementById('withdrawSuccessMsg');
    if(successEl){
      const s = data.summary || {};
      if(type === 'ondemand'){
        const feeLine   = s.penaltyAmount > 0 ? 'Fee (' + s.penaltyRate + '%): <strong style="color:var(--red);">' + fmt(s.penaltyAmount) + '</strong> · ' : '';
        const netLine   = 'You receive: <strong style="color:var(--green);">' + fmt(s.phase1Amount) + '</strong> (immediate)';
        const deactLine = data.deactivated ? '<br><br>⚠️ <strong>Account deactivated</strong> — balance below ₦10,000. Contact the administrator.' : '';
        successEl.innerHTML = 'On-demand withdrawal submitted.<br><span style="font-size:12px;color:var(--muted);line-height:1.8;">Gross: <strong>' + fmt(s.grossAmount) + '</strong> · ' + feeLine + netLine + '</span>' + deactLine;
      } else if(data.deactivated){
        successEl.innerHTML = 'Withdrawal submitted.<br><br>⚠️ <strong>Account deactivated</strong> — balance below ₦10,000. Contact the administrator.';
      } else {
        successEl.textContent = 'Request submitted — expected within 5 minutes.';
      }
    }
    closeModal('withdrawModal');
    openModal('withdrawSuccessModal');
  } catch(e){
    errMsg.textContent = e.message;
    openModal('withdrawFailedModal');
  }
}

/* ── Deposit ── */
document.getElementById('paymentMethod').addEventListener('change', function(){
  document.getElementById('paystackSection').style.display    = this.value==='paystack'    ? 'block' : 'none';
  document.getElementById('cooperativeSection').style.display = this.value==='cooperative' ? 'block' : 'none';
});
document.getElementById('coopSource').addEventListener('change', function(){
  document.getElementById('coopBankDetails').style.display = this.value        ? 'block' : 'none';
  document.getElementById('coopNoExtra').style.display     = this.value==='no' ? 'block' : 'none';
});
async function submitDeposit(){
  const method = document.getElementById('paymentMethod').value;
  const btn    = document.getElementById('submitDeposit');
  if(!method) return;
  btn.disabled = true; btn.textContent = 'Processing…';
  try {
    if(method === 'paystack'){
      const res  = await fetch('/deposit/init',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount:document.getElementById('paystackAmount').value})});
      const data = await res.json();
      if(data.authorization_url){ window.location.href = data.authorization_url; return; }
      throw new Error(data.message || 'Paystack init failed');
    }
    if(method === 'cooperative'){
      const res  = await fetch('/deposit/cooperative',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({coopAmount:document.getElementById('coopAmount').value,source:document.getElementById('coopSource').value,payeeName:document.getElementById('payerName')?.value||''})});
      const data = await res.json();
      if(!res.ok || !data.success) throw new Error(data.message || 'Failed');
      closeModal('depositModal'); openModal('depositSuccessModal');
    }
  } catch(e){
    openModal('depositFailedModal');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-download" style="margin-right:5px;font-size:12px;"></i>Continue';
  }
}

/* ── Loan repayment ── */
let loansData = [];
async function loadLoans(){
  const sel = document.getElementById('loanSelect');
  try {
    loansData = await(await fetch('/api/user/loans/active')).json();
    sel.innerHTML = '<option value="">Select a loan…</option>';
    if(!Array.isArray(loansData) || !loansData.length){
      sel.innerHTML = '<option value="">No active loans</option>'; return;
    }
    loansData.forEach(function(l){
      const o   = document.createElement('option');
      o.value   = l._id;
      const bal = Number(l.outstandingBalance || l.totalRepay || 0);
      const due = l.dueDate ? new Date(l.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : 'N/A';
      o.textContent = '₦' + bal.toLocaleString() + ' outstanding — ' + (l.status==='overdue'?'⚠️ OVERDUE':'due') + ' ' + due;
      sel.appendChild(o);
    });
  } catch(e){
    sel.innerHTML = '<option value="">Error loading loans</option>';
  }
}
document.getElementById('loanSelect').addEventListener('change', function(){
  const loan       = loansData.find(function(l){ return l._id === this.value; }, this);
  const box        = document.getElementById('loanOutstandingBox');
  if(!loan){ box.style.display = 'none'; return; }
  const outstanding = Number(loan.outstandingBalance || loan.totalRepay || 0);
  const totalRepay  = Number(loan.totalRepay   || 0);
  const loanAmount  = Number(loan.amount       || 0);
  const penalty     = Number(loan.totalPenalty || 0);
  const penRate     = Number(loan.penaltyPercentage || 0);
  const isOverdue   = loan.status === 'overdue';
  const due         = loan.dueDate ? new Date(loan.dueDate).toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric'}) : 'N/A';
  box.style.display   = 'block';
  box.className       = 'lob-box' + (isOverdue ? ' overdue' : '');
  document.getElementById('loanBoxTag').textContent    = isOverdue ? '⚠️ Overdue — Total Owed' : 'Outstanding Balance';
  document.getElementById('loanBoxAmount').textContent = '₦' + outstanding.toLocaleString();
  const bd = document.getElementById('loanBoxBreakdown');
  bd.innerHTML = '';
  const row = function(l,v,c){
    const d = document.createElement('div');
    d.className = 'lob-row';
    d.innerHTML = '<span>' + l + '</span><span style="color:' + (c||'var(--text)') + '">' + v + '</span>';
    return d;
  };
  bd.appendChild(row('Principal:',       '₦' + loanAmount.toLocaleString(), 'var(--muted)'));
  bd.appendChild(row('Base repayment:',  '₦' + totalRepay.toLocaleString(), 'var(--accent)'));
  if(penalty > 0) bd.appendChild(row('Penalty:', '+₦' + penalty.toLocaleString(), 'var(--red)'));
  bd.appendChild(row('Due:', due, 'var(--muted)'));
  const warn = document.getElementById('loanOverdueWarn');
  warn.style.display = (isOverdue && penRate > 0) ? 'block' : 'none';
  if(isOverdue && penRate > 0) document.getElementById('penRateText').textContent = penRate;
  const rounded = Math.ceil(outstanding);
  document.getElementById('loanPaystackAmount').value = rounded;
  document.getElementById('loanCoopAmount').value     = rounded;
});
document.getElementById('loanPaymentMethod').addEventListener('change', function(){
  document.getElementById('loanPaystackSection').style.display = this.value==='paystack'    ? 'block' : 'none';
  document.getElementById('loanCoopSection').style.display     = this.value==='cooperative' ? 'block' : 'none';
});
async function submitLoanPayment(){
  const loanId = document.getElementById('loanSelect').value;
  const method = document.getElementById('loanPaymentMethod').value;
  if(!loanId || !method){ openModal('loanPaymentFailedModal'); return; }
  const btn = document.getElementById('submitLoanPayment');
  btn.disabled = true; btn.textContent = 'Processing…';
  try {
    if(method === 'paystack'){
      const res  = await fetch('/loan/payment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({loanId,amount:document.getElementById('loanPaystackAmount').value})});
      const data = await res.json();
      if(data.authorization_url){ window.location.href = data.authorization_url; return; }
      throw new Error('Paystack init failed');
    }
    if(method === 'cooperative'){
      const res = await fetch('/loan/payment/manual',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({loanId,amount:document.getElementById('loanCoopAmount').value,payerName:document.getElementById('loanPayerName').value})});
      if(!res.ok) throw new Error('Manual payment failed');
      closeModal('loanPaymentModal'); openModal('loanPaymentSuccessModal');
      setTimeout(function(){ location.reload(); }, 2500);
    }
  } catch(e){
    openModal('loanPaymentFailedModal');
  } finally {
    btn.disabled = false; btn.textContent = 'Proceed';
  }
}

/* ── Loader — short form, reveal at 2.8 s ── */
(function(){
  const c = document.getElementById('ldParticles');
  for(let i = 0; i < 20; i++){
    const p = document.createElement('div');
    p.className = 'ldp';
    p.style.cssText =
      'left:' + (Math.random()*100).toFixed(1) + '%;' +
      'top:'  + (Math.random()*100).toFixed(1) + '%;' +
      '--tx:' + ((Math.random()-.5)*120).toFixed(0) + 'px;' +
      '--ty:' + ((Math.random()-.5)*120).toFixed(0) + 'px;' +
      '--dur:' + (2.5 + Math.random()*3).toFixed(1) + 's;' +
      '--delay:' + (Math.random()*4).toFixed(1) + 's;';
    c.appendChild(p);
  }
})();

window.addEventListener('load', function(){
  const loader = document.getElementById('loader');
  const MIN_MS = 2800; // short form: animation finishes ~2.4 s, +0.4 s buffer
  const t0 = Date.now();
  function dismiss(){
    const wait = Math.max(0, MIN_MS - (Date.now() - t0));
    setTimeout(function(){
      loader.style.opacity    = '0';
      loader.style.transition = 'opacity 0.5s ease';
      setTimeout(function(){ loader.style.display = 'none'; }, 500);
    }, wait);
  }
  dismiss();
});

/* ── Close sidebar on outside click ── */
document.addEventListener('click', function(e){
  const sb = document.getElementById('sidebar');
  const hb = document.querySelector('.hamburger');
  if(window.innerWidth<=900 && sb.classList.contains('open') && !sb.contains(e.target) && !hb.contains(e.target)) closeSidebar();
});

loadLoans();
</script>





<script>
(function () {
    const TIMEOUT_MS  = 1 * 60 * 1000;
    const WARNING_MS  = 20 * 1000;
    const LOGOUT_URL  = '/logout';
    const PING_URL    = '/api/ping';     // keeps session alive on activity

    let logoutTimer, warningTimer, warningEl;

    function resetTimers() {
        clearTimeout(logoutTimer);
        clearTimeout(warningTimer);
        hideWarning();

        warningTimer = setTimeout(showWarning, TIMEOUT_MS - WARNING_MS);
        logoutTimer  = setTimeout(() => { window.location.href = LOGOUT_URL; }, TIMEOUT_MS);
    }

    function showWarning() {
        if (warningEl) return;
        warningEl = document.createElement('div');
        warningEl.id = 'inactivity-warning';
        warningEl.innerHTML = `
            <div style="
                position:fixed;bottom:24px;right:24px;z-index:99999;
                background:#1e3a8a;color:#fff;border-radius:14px;
                padding:16px 20px;max-width:300px;
                box-shadow:0 8px 32px rgba(0,0,0,.3);font-size:13px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
            ">
                <strong style="display:block;margin-bottom:6px;">⏱ Session expiring</strong>
                You'll be logged out in 1 minute due to inactivity.
                <button onclick="stayLoggedIn()" style="
                    display:block;margin-top:12px;width:100%;
                    padding:8px;border:none;border-radius:8px;
                    background:#fff;color:#1e3a8a;font-weight:700;
                    cursor:pointer;font-size:13px;
                ">Stay logged in</button>
            </div>`;
        document.body.appendChild(warningEl);
    }

    function hideWarning() {
        if (warningEl) { warningEl.remove(); warningEl = null; }
    }

    window.stayLoggedIn = function () {
        fetch(PING_URL, { credentials: 'same-origin' }); // touch the session
        resetTimers();
    };

    // Reset on any user activity
    ['mousemove','keydown','mousedown','touchstart','scroll'].forEach(evt => {
        document.addEventListener(evt, resetTimers, { passive: true });
    });

    resetTimers(); // start on page load
})();
</script>
