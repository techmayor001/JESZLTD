function calculateLoan() {
const amount = parseFloat(document.getElementById('calcAmount').value) || 0;
const duration = parseInt(document.getElementById('calcDuration').value) || 1;
const rate = parseFloat(document.getElementById('calcRate').value) || 5;

if (amount > 0) {
    const maxLoan = parseFloat("<%= user.account.balance %>") * 3;

    if (amount > maxLoan) {
        alert(`Loan amount exceeds your max eligible amount of ₦${maxLoan.toLocaleString()}`);
        document.getElementById('calcAmount').value = maxLoan;
        return;
    }

    // Interest for ONE MONTH ONLY
    const interest = (amount * rate) / 100;

    // Total repayment
    const total = amount + interest;

    // Monthly payment
    const monthly = total / duration;

    document.getElementById('calcResult').style.display = 'block';
    document.getElementById('monthlyPay').textContent = '₦' + monthly.toLocaleString('en-NG', { maximumFractionDigits: 2 });
    document.getElementById('totalInt').textContent = '₦' + interest.toLocaleString('en-NG', { maximumFractionDigits: 2 });
    document.getElementById('totalRep').textContent = '₦' + total.toLocaleString('en-NG', { maximumFractionDigits: 2 });
}
}

