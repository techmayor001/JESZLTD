<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club De Stars - Member Dashboard | Powered by JESZ LIMITED</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 260px;
        }

        * { box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #f1f5f9;
            min-height: 100vh;
        }

        /* ── Loader ── */
        .loader-screen {
            position: fixed; inset: 0;
            background: linear-gradient(135deg, #0a1a2f, #102a44);
            display: flex; justify-content: center; align-items: center;
            z-index: 9999;
        }
        .loader-logo span {
            font-size: 42px; font-weight: 600; color: #5cc8ff;
            display: inline-block; letter-spacing: 1px;
        }
        .loader-logo span:nth-child(1)  { animation: loaderFloat 1.5s infinite ease-in-out; animation-delay: 0s;   }
        .loader-logo span:nth-child(2)  { animation: loaderFloat 1.5s infinite ease-in-out; animation-delay: .1s;  }
        .loader-logo span:nth-child(3)  { animation: loaderFloat 1.5s infinite ease-in-out; animation-delay: .2s;  }
        .loader-logo span:nth-child(4)  { animation: loaderFloat 1.5s infinite ease-in-out; animation-delay: .3s;  }
        .loader-logo span:nth-child(5)  { animation: loaderFloat 1.5s infinite ease-in-out; animation-delay: .4s;  }
        .loader-logo span:nth-child(6)  { animation: loaderFloat 1.5s infinite ease-in-out; animation-delay: .5s;  }
        .loader-logo span:nth-child(7)  { animation: loaderFloat 1.5s infinite ease-in-out; animation-delay: .6s;  }
        .loader-logo span:nth-child(8)  { animation: loaderFloat 1.5s infinite ease-in-out; animation-delay: .7s;  }
        .loader-logo span:nth-child(9)  { animation: loaderFloat 1.5s infinite ease-in-out; animation-delay: .8s;  }
        @keyframes loaderFloat {
            0%,100% { transform: translateY(0);     opacity: 0.4; }
            50%      { transform: translateY(-12px); opacity: 1;   }
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 55%, #3b82f6 100%);
            color: white; z-index: 1040;
            transition: all 0.3s; overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30,58,138,0.15);
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
        .sidebar-header {
            padding: 1.25rem 1.25rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.1);
        }
        .logo-container { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
        .logo-box {
            width: 38px; height: 38px; background: white;
            border-radius: 9px; display: flex; align-items: center; justify-content: center;
            font-weight: bold; color: var(--primary); font-size: 1.2rem;
            box-shadow: 0 3px 8px rgba(0,0,0,0.2); overflow: hidden; flex-shrink: 0;
        }
        .logo-box img { width: 100%; height: 100%; object-fit: cover; }
        .sidebar-menu { padding: 0.75rem 0; }
        .sidebar-menu a {
            color: rgba(255,255,255,0.82); text-decoration: none;
            padding: 0.7rem 1.25rem; display: flex; align-items: center;
            transition: all 0.25s; border-left: 3px solid transparent;
            font-weight: 500; font-size: 0.875rem;
        }
        .sidebar-menu a:hover  { background: rgba(255,255,255,0.09); color: white; border-left-color: rgba(255,255,255,0.6); }
        .sidebar-menu a.active { background: rgba(255,255,255,0.14); color: white; border-left-color: white; }
        .sidebar-menu a i      { width: 20px; margin-right: 10px; font-size: 0.95rem; flex-shrink: 0; }

        /* ── Top navbar ── */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0;
            height: 62px; background: rgba(255,255,255,0.97);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 12px rgba(30,58,138,0.08);
            z-index: 1030; display: flex; align-items: center;
            padding: 0 1.5rem; transition: all 0.3s;
            border-bottom: 1px solid rgba(30,58,138,0.08);
        }

        /* ── Main content ── */
        .main-content {
            margin-left: var(--sidebar-width); margin-top: 62px;
            padding: 1.25rem; min-height: calc(100vh - 62px);
            transition: all 0.3s;
        }

        /* ── Welcome card ── */
        .welcome-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; border-radius: 16px;
            padding: 1.4rem 1.5rem; margin-bottom: 1rem;
            box-shadow: 0 8px 24px rgba(30,58,138,0.2);
            position: relative; overflow: hidden;
        }
        .welcome-card::before {
            content: ''; position: absolute; top: -60%; right: -10%;
            width: 300px; height: 300px;
            background: rgba(255,255,255,0.04); border-radius: 50%;
        }

        /* ── Member badge ── */
        .member-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 11px; background: rgba(255,255,255,0.18);
            backdrop-filter: blur(10px); border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.25);
            font-weight: 600; font-size: 0.76rem;
        }
        .club-member-badge { background: rgba(16,185,129,0.72); border-color: rgba(16,185,129,0.35); }
        .non-club-badge    { background: rgba(245,158,11,0.72);  border-color: rgba(245,158,11,0.35); }

        /* ════════════════════════════════
           STAT CARDS — fully responsive
           ════════════════════════════════ */
        .stat-card {
            background: white; border-radius: 14px;
            padding: 0.85rem 0.9rem;
            box-shadow: 0 3px 12px rgba(30,58,138,0.07);
            transition: transform 0.25s, box-shadow 0.25s;
            height: 100%; overflow: hidden;
            min-width: 0;
        }
        .stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 22px rgba(30,58,138,0.13); }
        .stat-card--overdue {
            border: 1.5px solid rgba(239,68,68,0.38) !important;
            animation: cardOverduePulse 2.5s ease-in-out infinite;
        }
        @keyframes cardOverduePulse {
            0%,100% { box-shadow: 0 3px 12px rgba(239,68,68,0.08), 0 0 0 0   rgba(239,68,68,0.2); }
            50%      { box-shadow: 0 3px 12px rgba(239,68,68,0.14), 0 0 0 5px rgba(239,68,68,0);   }
        }
        .stat-icon {
            width: 38px; height: 38px; border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; margin-bottom: 0.6rem; flex-shrink: 0;
        }

        .sc-label {
            font-size: clamp(0.62rem, 1.8vw, 0.73rem);
            font-weight: 600; color: #6b7280;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            margin-bottom: 2px;
        }
        .sc-value {
            font-size: clamp(0.78rem, 2.4vw, 0.95rem);
            font-weight: 700; line-height: 1.25;
            word-break: break-word; overflow-wrap: anywhere;
            margin-bottom: 3px;
        }
        .sc-sub {
            font-size: clamp(0.6rem, 1.6vw, 0.7rem);
            line-height: 1.3; word-break: break-word; overflow-wrap: anywhere;
        }

        /* ── Outstanding balance row ── */
        .outstanding-balance-row {
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: nowrap; gap: 3px;
            background: rgba(245,158,11,0.07);
            border: 1px dashed rgba(245,158,11,0.38);
            border-radius: 5px; padding: 2px 5px; margin: 3px 0;
            min-width: 0; overflow: hidden;
        }
        .outstanding-label {
            color: #92400e; font-weight: 700;
            font-size: clamp(0.55rem, 1.4vw, 0.63rem);
            text-transform: uppercase; letter-spacing: 0.04em;
            flex-shrink: 0; white-space: nowrap;
        }
        .outstanding-amount {
            font-size: clamp(0.65rem, 1.9vw, 0.82rem);
            font-weight: 700; text-align: right;
            word-break: break-word; overflow-wrap: anywhere; min-width: 0;
        }

        /* ── Penalty breakdown rows ── */
        .penalty-breakdown-row {
            background: rgba(239,68,68,0.04);
            border: 1px dashed rgba(239,68,68,0.26);
            border-radius: 5px; padding: 3px 5px; margin: 3px 0;
            min-width: 0; overflow: hidden;
        }
        .penalty-line,
        .penalty-total-line {
            display: flex; justify-content: space-between;
            align-items: flex-start; gap: 3px; min-width: 0;
        }
        .penalty-total-line {
            border-top: 1px solid rgba(239,68,68,0.16);
            margin-top: 3px; padding-top: 3px;
        }
        .penalty-label,
        .penalty-total-label {
            color: #6b7280; font-weight: 700; flex-shrink: 0;
            font-size: clamp(0.53rem, 1.3vw, 0.62rem);
            text-transform: uppercase; letter-spacing: 0.03em;
            white-space: nowrap;
        }
        .penalty-amount,
        .penalty-total-amount {
            font-size: clamp(0.62rem, 1.7vw, 0.78rem);
            font-weight: 700; text-align: right;
            word-break: break-word; overflow-wrap: anywhere; min-width: 0;
        }

        @media (max-width: 380px) {
            .stat-card { padding: 0.7rem 0.65rem; }
            .stat-icon { width: 30px; height: 30px; font-size: 0.85rem; }
        }

        /* ── Overdue ticker ── */
        .overdue-ticker {
            background: linear-gradient(90deg, #7f1d1d, #991b1b, #b91c1c, #991b1b, #7f1d1d);
            background-size: 300% 100%;
            animation: tickerBgPulse 4s ease-in-out infinite;
            border-radius: 10px; overflow: hidden; padding: 0.45rem 0;
            box-shadow: 0 3px 14px rgba(185,28,28,0.3);
        }
        @keyframes tickerBgPulse {
            0%,100% { background-position: 0%   50%; }
            50%      { background-position: 100% 50%; }
        }
        .ticker-track { display: flex; white-space: nowrap; animation: tickerScroll 28s linear infinite; }
        .ticker-item  { display: inline-block; padding: 0 2.5rem; font-size: 0.78rem; font-weight: 600; color: #fff; letter-spacing: 0.03em; }
        .ticker-item i { color: #fbbf24; animation: warnPulse 1s ease-in-out infinite; }
        @keyframes warnPulse   { 0%,100% { opacity:1; transform:scale(1); }   50% { opacity:0.5; transform:scale(1.3); } }
        @keyframes tickerScroll { 0% { transform:translateX(0); } 100% { transform:translateX(-50%); } }
        .overdue-ticker:hover .ticker-track { animation-play-state: paused; }

        /* ── Generic cards ── */
        .card {
            border: none; border-radius: 14px;
            box-shadow: 0 3px 12px rgba(30,58,138,0.07); background: white;
        }
        .card-header {
            background: rgba(30,58,138,0.02);
            border-bottom: 1px solid rgba(30,58,138,0.08);
            padding: 0.9rem 1.25rem; border-radius: 14px 14px 0 0 !important;
        }

        /* ── Buttons ── */
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none; border-radius: 9px; font-weight: 600; transition: all 0.25s;
        }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(30,58,138,0.28); }

        /* ── Quick actions ── */
        .quick-action {
            text-align: center; padding: 1rem 0.6rem; border-radius: 12px;
            background: rgba(30,58,138,0.025);
            border: 1.5px solid rgba(30,58,138,0.09);
            transition: all 0.25s; cursor: pointer;
            text-decoration: none; color: inherit; display: block;
        }
        .quick-action:hover {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white; transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(30,58,138,0.22); border-color: transparent;
        }
        .quick-action i { font-size: 1.6rem; margin-bottom: 0.45rem; display: block; }
        .quick-action h6 { font-size: 0.78rem; margin: 0; }

        /* ── Alerts ── */
        .alert-warning-custom {
            background: #fffbeb; border: 1px solid rgba(245,158,11,0.32);
            border-radius: 11px; padding: 0.8rem 1rem; color: #92400e;
        }
        .alert-info-custom {
            background: #eff6ff; border: 1px solid rgba(59,130,246,0.25);
            border-radius: 11px; padding: 0.8rem 1rem; color: #1e40af;
        }

        /* ── ROI list ── */
        .loan-rules-list {
            background: rgba(30,58,138,0.02); padding: 1rem;
            border-radius: 11px; border: 1px solid rgba(30,58,138,0.08);
        }

        /* ── Loan outstanding box (modal) ── */
        .loan-outstanding-box {
            border-radius: 10px; padding: 0.85rem 1rem; margin-bottom: 0.75rem;
            background: #eff6ff; border: 1px solid rgba(30,58,138,0.2);
        }
        .loan-outstanding-box.is-overdue { background: #fef2f2; border-color: rgba(239,68,68,0.3); }
        .lob-tag {
            font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.06em; color: #6b7280; margin-bottom: 2px;
        }
        .lob-amount { font-size: 1.3rem; font-weight: 800; color: var(--primary); line-height: 1.2; }
        .loan-outstanding-box.is-overdue .lob-amount { color: #dc2626; }
        .lob-breakdown {
            margin-top: 6px; padding-top: 6px;
            border-top: 1px dashed rgba(30,58,138,0.15);
        }
        .loan-outstanding-box.is-overdue .lob-breakdown { border-top-color: rgba(239,68,68,0.2); }
        .lob-row { display: flex; justify-content: space-between; font-size: 0.75rem; padding: 1px 0; color: #6b7280; }
        .lob-row span { font-weight: 600; }
        .lob-overdue-warn {
            margin-top: 7px; padding: 5px 8px; border-radius: 6px;
            background: rgba(239,68,68,0.07); font-size: 0.72rem;
            font-weight: 600; color: #dc2626;
        }

        /* ── Powered by ── */
        .powered-by {
            position: fixed; bottom: 16px; right: 16px; background: white;
            padding: 7px 14px; border-radius: 30px;
            box-shadow: 0 3px 12px rgba(30,58,138,0.12);
            font-size: 0.76rem; font-weight: 600; color: var(--primary); z-index: 1000;
        }

        /* ── Sidebar overlay ── */
        .sb-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.38); z-index: 1039; }
        .sb-overlay.show { display: block; }

        /* ════════════════════════════════════════
           MAINTENANCE MODE OVERLAY
           ════════════════════════════════════════ */
        .maintenance-overlay {
            position: fixed; inset: 0; z-index: 99999;
            background: linear-gradient(135deg, #0a1128 0%, #0f2044 50%, #0a1a3a 100%);
            display: flex; align-items: center; justify-content: center;
            padding: 1.5rem;
        }
        .maintenance-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 24px;
            padding: 3rem 2.5rem;
            max-width: 520px; width: 100%;
            text-align: center;
            box-shadow: 0 25px 60px rgba(0,0,0,0.5);
            backdrop-filter: blur(20px);
        }
        .maintenance-icon-ring {
            width: 90px; height: 90px; border-radius: 50%;
            background: rgba(245,158,11,0.12);
            border: 2px solid rgba(245,158,11,0.35);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.5rem;
            animation: mRingPulse 2.5s ease-in-out infinite;
        }
        @keyframes mRingPulse {
            0%,100% { box-shadow: 0 0 0 0 rgba(245,158,11,0.25); }
            50%      { box-shadow: 0 0 0 14px rgba(245,158,11,0); }
        }
        .maintenance-icon-ring i { font-size: 2.2rem; color: #f59e0b; }
        .maintenance-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 14px; border-radius: 20px;
            background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.3);
            font-size: 0.7rem; font-weight: 700; color: #fbbf24;
            text-transform: uppercase; letter-spacing: 0.08em;
            margin-bottom: 1rem;
        }
        .maintenance-title {
            font-size: 1.6rem; font-weight: 800; color: #fff;
            line-height: 1.25; margin-bottom: 0.75rem;
        }
        .maintenance-title span { color: #60a5fa; }
        .maintenance-message {
            font-size: 0.88rem; color: rgba(255,255,255,0.65);
            line-height: 1.65; margin-bottom: 1.75rem;
        }
        .maintenance-info-row {
            display: flex; align-items: center; justify-content: center; gap: 8px;
            background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px; padding: 0.75rem 1rem;
            font-size: 0.78rem; color: rgba(255,255,255,0.5); margin-bottom: 1.5rem;
        }
        .maintenance-info-row i { color: #60a5fa; }
        .maintenance-dots {
            display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .maintenance-dots span {
            width: 8px; height: 8px; border-radius: 50%; background: #3b82f6;
            animation: dotBounce 1.4s ease-in-out infinite;
        }
        .maintenance-dots span:nth-child(2) { animation-delay: 0.2s; }
        .maintenance-dots span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes dotBounce {
            0%,80%,100% { transform: scale(0.7); opacity: 0.4; }
            40%          { transform: scale(1.2); opacity: 1;   }
        }
        .maintenance-footer {
            margin-top: 1.5rem; font-size: 0.7rem;
            color: rgba(255,255,255,0.25); letter-spacing: 0.04em;
        }

        /* ── Responsive breakpoints ── */
        @media (max-width: 1200px) { :root { --sidebar-width: 240px; } }
        @media (max-width: 992px) {
            .sidebar { left: calc(-1 * var(--sidebar-width)); }
            .sidebar.active { left: 0; box-shadow: 6px 0 30px rgba(0,0,0,0.25); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; }
            .powered-by { bottom: 10px; right: 10px; font-size: 0.7rem; padding: 5px 10px; }
        }
        @media (max-width: 576px) {
            .main-content { padding: 0.85rem; }
            .welcome-card { padding: 1rem; }
            .maintenance-card { padding: 2rem 1.25rem; }
            .maintenance-title { font-size: 1.25rem; }
        }
        @media print {
            .sidebar,.top-navbar,.btn,.quick-action,.powered-by,.overdue-ticker { display: none !important; }
            .main-content { margin: 0; padding: 0; }
            .card { break-inside: avoid; }
        }
    </style>
</head>
<body>

<!-- ══════════════════════════════════════════════════
     MAINTENANCE MODE OVERLAY
     Only renders when maintenanceMode.enabled is true.
     Admins can still see the page — check role here if needed.
     ══════════════════════════════════════════════════ -->
<% if (maintenanceMode && maintenanceMode.enabled) { %>
<%
  // Allow admins to bypass the overlay — comment out this block
  // if you want maintenance to block everyone including admins.
  const isAdmin = user.role && user.role.name !== 'member';
  const bypassMaintenance = isAdmin;
%>
<% if (!bypassMaintenance) { %>
<div class="maintenance-overlay" id="maintenanceOverlay">
    <div class="maintenance-card">
        <div class="maintenance-icon-ring">
            <i class="fas fa-wrench"></i>
        </div>
        <div class="maintenance-badge">
            <i class="fas fa-circle" style="font-size:0.45rem;"></i>
            System Maintenance
        </div>
        <h1 class="maintenance-title">
            We'll be back<br><span>shortly!</span>
        </h1>
        <p class="maintenance-message">
            <%= maintenanceMode.message || "The system is currently undergoing scheduled maintenance. Please check back shortly." %>
        </p>
        <div class="maintenance-info-row">
            <i class="fas fa-clock"></i>
            <span>We apologise for any inconvenience caused.</span>
        </div>
        <div class="maintenance-dots">
            <span></span><span></span><span></span>
        </div>
        <div class="maintenance-footer">
            Club De Stars Cooperative Society &nbsp;·&nbsp; Powered by JESZ LIMITED
        </div>
    </div>
</div>
<% } else { %>
<!-- Admin bypass banner -->
<div style="position:fixed;top:0;left:0;right:0;z-index:99998;background:#92400e;color:#fef3c7;text-align:center;padding:7px;font-size:0.78rem;font-weight:600;">
    <i class="fas fa-wrench me-2"></i>
    <strong>Maintenance Mode is ON</strong> — You can see this page because you are an admin.
    <a href="/admin-dashboard" style="color:#fde68a;text-decoration:underline;margin-left:10px;">Manage in Admin Panel →</a>
</div>
<% } %>
<% } %>

<!-- Loader -->
<div id="loaderScreen" class="loader-screen">
    <div class="loader-logo">
        <span>C</span><span>l</span><span>o</span><span>u</span><span>d</span><span>B</span><span>a</span><span>a</span><span>m</span>
    </div>
</div>

<%
  const sharePercentage = allMembersTotalSavings > 0
    ? ((accountBalance / allMembersTotalSavings) * 100).toFixed(2)
    : 0;
  const pendingGuarantorCount = user.guarantorRequests
    ? user.guarantorRequests.filter(r => r.status === "pending").length
    : 0;

  // Company account helpers — fall back to dashes if not configured
  const bankName      = (companyAccount && companyAccount.bankName)      || "—";
  const accountName   = (companyAccount && companyAccount.accountName)   || "—";
  const accountNumber = (companyAccount && companyAccount.accountNumber) || "—";
  const accountConfigured = bankName !== "—" && accountNumber !== "—";
%>

<div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

<!-- ══ SIDEBAR ══ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-container">
            <div class="logo-box">
                <img src="/media/assets/logo/log.png" alt="Logo"
                     onerror="this.style.display='none';this.parentNode.innerHTML='<b style=\'color:#1e3a8a;font-size:13px;\'>C</b>'">
            </div>
            <div>
                <h6 class="mb-0 fw-bold" style="text-transform:uppercase;font-size:0.8rem;">Club De Stars</h6>
                <small style="opacity:0.65;font-size:0.67rem;">COOPERATIVE SOCIETY LIMITED</small>
            </div>
        </div>
        <div class="member-badge mt-2 <%= user.membershipID.startsWith('CD') ? 'club-member-badge' : 'non-club-badge' %>">
            <i class="fas <%= user.membershipID.startsWith('CD') ? 'fa-star' : 'fa-user' %>" style="font-size:0.68rem;"></i>
            <span><%= user.membershipID.startsWith('CD') ? 'Club Member' : 'Non-Club Member' %></span>
        </div>
    </div>
    <div class="sidebar-menu">
        <a href="/cds-cooperative/dashboard" class="active"><i class="fas fa-home"></i> Dashboard</a>
        <a href="/cds-cooperative/transaction"><i class="fas fa-exchange-alt"></i> Transactions</a>
        <a href="/cds-cooperative/loan"><i class="fas fa-hand-holding-usd"></i> My Loans</a>
        <a href="/cds-cooperative/guarantorRequest">
            <i class="fas fa-user-friends"></i> Guarantor Requests
            <% if (pendingGuarantorCount > 0) { %>
                <span class="badge bg-danger ms-auto" style="font-size:0.68rem;"><%= pendingGuarantorCount %></span>
            <% } %>
        </a>
        <a href="/manage/kiddies-account"><i class="fas fa-users"></i> Kiddies Account</a>
        <a href="/cds-cooperative/profile"><i class="fas fa-user-circle"></i> My Profile</a>
        <a href="/cds-cooperative/kyc"><i class="fas fa-shield-alt"></i> KYC Verification</a>
        <a href="/cds-cooperative/referral"><i class="fas fa-user-plus"></i> Referral Program</a>
        <a href="/cds-cooperative/memberContract"><i class="fas fa-file-contract"></i> Terms & Conditions</a>
        <a href="/cds-cooperative/report"><i class="fas fa-chart-line"></i> Reports</a>
        <% if (user.role && user.role.name !== 'member') { %>
        <a href="/admin-dashboard"><i class="fas fa-tachometer-alt"></i> Administration</a>
        <% } %>
        <a href="/logout" style="color:rgba(255,255,255,0.52);margin-top:4px;"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
</div>

<!-- ══ TOP NAVBAR ══ -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3"
       style="cursor:pointer;color:var(--primary);font-size:1.25rem;"
       onclick="toggleSidebar()"></i>
    <div class="flex-grow-1">
        <h6 class="mb-0 fw-bold d-none d-sm-block" style="color:var(--primary);font-size:0.9rem;">
            Welcome back, <%= user.firstName %>! 👋
        </h6>
        <h6 class="mb-0 fw-bold d-sm-none" style="color:var(--primary);font-size:0.85rem;">Hi, <%= user.firstName %>! 👋</h6>
        <small class="text-muted d-none d-md-block" style="font-size:0.73rem;">
            Member ID: <%= user.membershipID %> &nbsp;|&nbsp;
            <%= new Date(user.createdAt).toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) %>
        </small>
    </div>
    <%
      let sbadgeClass = "bg-secondary bg-opacity-10 text-secondary";
      if (user.status === "active")   sbadgeClass = "bg-success bg-opacity-10 text-success";
      if (user.status === "rejected") sbadgeClass = "bg-danger bg-opacity-10 text-danger";
    %>
    <span class="badge <%= sbadgeClass %> ms-2" style="font-size:0.7rem;padding:5px 10px;">
        <%= user.status.charAt(0).toUpperCase() + user.status.slice(1) %>
    </span>
</div>

<!-- ══ MAIN CONTENT ══ -->
<div class="main-content" id="mainContent">

    <!-- Welcome card -->
    <div class="welcome-card position-relative mb-3">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-8">
                <h5 class="mb-2 fw-bold" style="font-size:1rem;">Great to see you, <%= user.firstName %>!</h5>
                <div class="d-flex gap-2 flex-wrap">
                    <div class="member-badge"><i class="fas fa-id-card" style="font-size:0.68rem;"></i><span><%= user.membershipID %></span></div>
                    <div class="member-badge d-none d-sm-inline-flex"><i class="fas fa-calendar" style="font-size:0.68rem;"></i><span>Since <%= new Date(user.createdAt).toLocaleDateString('en-US',{month:'short',year:'numeric'}) %></span></div>
                    <div class="member-badge club-member-badge"><i class="fas fa-star" style="font-size:0.68rem;"></i><span><%= interestRate %>% Interest Rate</span></div>
                </div>
            </div>
            <div class="col-4 text-end">
                <%
                  let badgeClass2 = "bg-light text-secondary";
                  let statusText  = "Pending";
                  if (user.status === "active")   { badgeClass2 = "bg-light text-success"; statusText = "Active";   }
                  if (user.status === "rejected") { badgeClass2 = "bg-light text-danger";  statusText = "Rejected"; }
                %>
                <span class="badge <%= badgeClass2 %> px-3 py-2" style="font-size:0.8rem;"><%= statusText %></span>
                <p class="mb-0 mt-1 opacity-75" style="font-size:0.7rem;">
                    <% if (user.Payment && user.Payment.status === "paid") { %>KYC Verified ✓<% } else { %>KYC Pending ✗<% } %>
                </p>
            </div>
        </div>
    </div>

    <!-- Withdrawal notice -->
    <div class="alert-warning-custom mb-3">
        <p class="mb-0" style="font-size:0.8rem;">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Withdrawal Window:</strong> Regular withdrawals <strong>1st – 10th December</strong>.
            Force withdrawal available with <strong><%= forceWithdrawalCharge %>% charge</strong> (50% now, 50% after 30 days).
        </p>
    </div>

    <!-- Overdue ticker -->
    <% if (loanIsOverdue) { %>
    <div class="overdue-ticker mb-3">
        <div class="ticker-track">
            <span class="ticker-item">
                <i class="fas fa-exclamation-triangle"></i>&nbsp;
                OVERDUE LOAN ALERT &mdash;
                Your loan of <strong>₦<%= loan.amount.toLocaleString() %></strong> is past due &bull;
                Outstanding balance now <strong>₦<%= loanOutstanding.toLocaleString() %></strong> &bull;
                A daily penalty of <strong><%= loanPenaltyRate %>%</strong> is added every day until repaid &bull;
                Please repay or roll over immediately &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            </span>
            <span class="ticker-item" aria-hidden="true">
                <i class="fas fa-exclamation-triangle"></i>&nbsp;
                OVERDUE LOAN ALERT &mdash;
                Your loan of <strong>₦<%= loan.amount.toLocaleString() %></strong> is past due &bull;
                Outstanding balance now <strong>₦<%= loanOutstanding.toLocaleString() %></strong> &bull;
                A daily penalty of <strong><%= loanPenaltyRate %>%</strong> is added every day until repaid &bull;
                Please repay or roll over immediately &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            </span>
        </div>
    </div>
    <% } %>

    <!-- ══ STAT CARDS ══ -->
    <div class="row g-2 g-md-3 mb-3">

        <!-- Total Savings -->
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;">
                    <i class="fas fa-piggy-bank"></i>
                </div>
                <div class="sc-label">Total Savings</div>
                <div class="sc-value">
                    ₦<%= user.account?.balance ? user.account.balance.toLocaleString() : "0" %>
                </div>
                <% if (user.account && typeof ROI !== "undefined") { %>
                <div class="sc-sub text-success fw-semibold">
                    <i class="fas fa-arrow-up me-1"></i>₦<%= totalBalance.toLocaleString() %> +ROI
                </div>
                <% } else { %>
                <div class="sc-sub text-muted fw-semibold">₦0.00</div>
                <% } %>
            </div>
        </div>

        <!-- Active Loan -->
        <div class="col-6 col-lg-3">
            <div class="stat-card <%= loanIsOverdue ? 'stat-card--overdue' : '' %>">
                <div class="stat-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;">
                    <i class="fas fa-hand-holding-usd"></i>
                </div>
                <div class="sc-label">Active Loan</div>
                <div class="sc-value">
                    ₦<%= loan ? loan.amount.toLocaleString() : '0' %>
                </div>
                <% if (loan && loanOutstanding > loan.amount) { %>
                <div class="outstanding-balance-row">
                    <span class="outstanding-label">Owed</span>
                    <span class="outstanding-amount <%= loanIsOverdue ? 'text-danger' : 'text-warning' %>">
                        ₦<%= loanOutstanding.toLocaleString() %>
                    </span>
                </div>
                <% } %>
                <% if (loanIsOverdue) { %>
                <div class="sc-sub text-danger fw-bold mt-1">
                    <i class="fas fa-circle-xmark me-1"></i>OVERDUE<br>
                    <span style="font-weight:400;">
                        <%= loan.dueDate ? new Date(loan.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : 'N/A' %>
                    </span>
                </div>
                <% } else { %>
                <div class="sc-sub text-warning fw-semibold mt-1">
                    <i class="fas fa-clock me-1"></i>Due: <%= loan && loan.dueDate ? loan.dueDate.toLocaleDateString() : 'N/A' %>
                </div>
                <% } %>
                <div class="sc-sub text-muted mt-1">
                    Max: ₦<%= user.account?.balance ? (user.account.balance * 3).toLocaleString() : '0' %>
                </div>
            </div>
        </div>

        <!-- Monthly ROI -->
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#06b6d4,#0891b2);color:white;">
                    <i class="fas fa-percentage"></i>
                </div>
                <div class="sc-label">Monthly ROI</div>
                <div class="sc-value">
                    ₦<%= monthlyROI.toLocaleString(undefined,{maximumFractionDigits:2}) %>
                </div>
                <div class="sc-sub text-info fw-semibold">
                    <i class="fas fa-chart-line me-1"></i><%= sharePercentage %>% of Shares
                </div>
            </div>
        </div>

        <!-- Total Loan Payment -->
        <div class="col-6 col-lg-3">
            <div class="stat-card <%= loanIsOverdue ? 'stat-card--overdue' : '' %>">
                <div class="stat-icon" style="background:linear-gradient(135deg,#3b82f6,#2563eb);color:white;">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div class="sc-label">Loan Payment</div>
                <div class="sc-value">
                    ₦<%= loan ? loan.totalRepay.toLocaleString() : '0' %>
                </div>
                <% if (loan && loanTotalPenalty > 0) { %>
                <div class="penalty-breakdown-row">
                    <div class="penalty-line">
                        <span class="penalty-label">+Penalty</span>
                        <span class="penalty-amount text-danger">+₦<%= loanTotalPenalty.toLocaleString() %></span>
                    </div>
                    <div class="penalty-total-line">
                        <span class="penalty-total-label">Owed</span>
                        <span class="penalty-total-amount" style="color:var(--primary);">₦<%= loanOutstanding.toLocaleString() %></span>
                    </div>
                </div>
                <% } %>
                <div class="sc-sub fw-semibold mt-1" style="color:var(--primary);">
                    <i class="fas fa-calendar me-1"></i>Due <%= loan && loan.dueDate
                        ? new Date(loan.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'2-digit'})
                        : 'N/A' %>
                </div>
                <% if (loanIsOverdue) { %>
                <div class="sc-sub text-danger mt-1">
                    <i class="fas fa-arrow-trend-up me-1"></i>+<%= loanPenaltyRate %>%/day
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0 fw-bold" style="font-size:0.86rem;">
                <i class="fas fa-bolt me-2" style="color:var(--primary);"></i>Quick Actions
            </h6>
        </div>
        <div class="card-body p-3">
            <div class="row g-2">
                <div class="col-6 col-lg-3">
                    <a href="#" class="quick-action" onclick="checkUserStatus('depositModal')">
                        <i class="fas fa-plus-circle" style="color:#10b981;"></i>
                        <h6>Make Deposit</h6>
                    </a>
                </div>
                <div class="col-6 col-lg-3">
                    <a href="#" class="quick-action" onclick="checkUserStatus('withdrawModal')">
                        <i class="fas fa-minus-circle" style="color:#ef4444;"></i>
                        <h6>Withdraw</h6>
                    </a>
                </div>
                <div class="col-6 col-lg-3">
                    <a href="/cds-cooperative/loan" class="quick-action">
                        <i class="fas fa-file-invoice-dollar" style="color:#f59e0b;"></i>
                        <h6>Apply for Loan</h6>
                    </a>
                </div>
                <div class="col-6 col-lg-3">
                    <a href="#" class="quick-action" onclick="openModal('loanPaymentModal')">
                        <i class="fas fa-money-check-alt" style="color:#06b6d4;"></i>
                        <h6>Loan Payment</h6>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ROI Section -->
    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0 fw-bold" style="color:var(--primary);font-size:0.86rem;">
                <i class="fas fa-chart-line me-2"></i>ROI Calculator & Distribution
            </h6>
        </div>
        <div class="card-body p-3">
            <div class="alert-info-custom mb-3">
                <p class="mb-1 fw-bold" style="font-size:0.8rem;">How ROI is Calculated</p>
                <p class="mb-1" style="font-size:0.76rem;">
                    Monthly ROI = (Your Cumulative Savings) / (Total All Members Savings) × Monthly Interest − company charge
                </p>
                <p class="mb-0" style="font-size:0.73rem;">
                    <strong>Note:</strong> <%= roiOperatingCharge %>% of the monthly interest pool is retained as operating charges
                </p>
            </div>
            <div class="row g-2 g-md-3 mb-3">
                <div class="col-6 col-md-3">
                    <div class="p-3 rounded-3 text-center" style="background:#dbeafe;">
                        <small class="text-muted d-block mb-1" style="font-size:0.7rem;">Your Cumulative Savings</small>
                        <h6 class="mb-0 fw-bold" style="color:var(--primary);font-size:0.88rem;">₦<%= accountBalance.toLocaleString() %></h6>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 rounded-3 text-center" style="background:#e0e7ff;">
                        <small class="text-muted d-block mb-1" style="font-size:0.7rem;">Total Balance</small>
                        <h6 class="mb-0 fw-bold" style="color:var(--primary);font-size:0.88rem;">₦<%= totalBalance.toLocaleString() %></h6>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 rounded-3 text-center" style="background:#fef3c7;">
                        <small class="text-muted d-block mb-1" style="font-size:0.7rem;">Your Share</small>
                        <h6 class="mb-0 fw-bold text-warning" style="font-size:0.88rem;"><%= sharePercentage %>%</h6>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 rounded-3 text-center" style="background:#d1fae5;">
                        <small class="text-muted d-block mb-1" style="font-size:0.7rem;">This Month's ROI</small>
                        <h6 class="mb-0 fw-bold text-success" style="font-size:0.88rem;">
                            ₦<%= monthlyROI.toLocaleString(undefined,{maximumFractionDigits:2}) %>
                        </h6>
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <h6 class="fw-bold mb-2" style="color:var(--primary);font-size:0.8rem;">Interest Sources</h6>
                    <div class="loan-rules-list">
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                            <div>
                                <small class="text-muted d-block" style="font-size:0.7rem;">Total Loan Interest</small>
                                <h6 class="mb-0 fw-bold" style="color:var(--primary);font-size:0.88rem;">₦<%= totalInterestCollected.toLocaleString() %></h6>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block" style="font-size:0.7rem;">From All Members</small>
                                <small class="fw-semibold" style="font-size:0.7rem;">Current Month</small>
                            </div>
                        </div>
                        <div>
                            <div class="d-flex justify-content-between mb-1" style="font-size:0.76rem;">
                                <small>Distributed to Members (Net Interest For ROI)</small>
                                <strong>₦<%= netInterestForRoi.toLocaleString() %></strong>
                            </div>
                            <div class="d-flex justify-content-between" style="font-size:0.76rem;">
                                <small>Operating Charges (Company Charge)</small>
                                <strong>₦<%= companyCharge.toLocaleString() %></strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div><!-- END main-content -->

<div class="powered-by">
    <strong style="color:var(--primary);">Cloudbaam</strong> · Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong>
</div>

<!-- ══════════════  MODALS  ══════════════ -->

<!-- Pending account -->
<div class="modal fade" id="pendingAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-3" style="border-radius:14px;">
            <div class="modal-body">
                <i class="fas fa-exclamation-circle text-warning fa-2x mb-2"></i>
                <h6 class="fw-bold">Action Not Allowed</h6>
                <p class="text-muted" style="font-size:0.8rem;">Your account is still pending verification. Complete KYC first.</p>
                <button class="btn btn-warning w-100 btn-sm" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Withdrawal modal -->
<div class="modal fade" id="withdrawModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header py-2 px-3">
                <h6 class="modal-title fw-bold" style="font-size:0.88rem;">
                    <i class="fas fa-minus-circle me-2 text-danger"></i>Request Withdrawal
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-3 py-2">
                <div class="alert-warning-custom mb-2" style="font-size:0.78rem;">
                    <i class="fas fa-calendar-alt me-1"></i>
                    <strong>Window:</strong> December 1st – 10th &nbsp;|&nbsp;
                    <strong>Balance:</strong> ₦<%= user.account?.balance?.toLocaleString() || 0 %>
                </div>
                <div class="alert-info-custom mb-3" style="font-size:0.78rem;">
                    <strong>Force Withdrawal:</strong> Available anytime with
                    <span class="text-danger fw-bold"><%= forceWithdrawalCharge %>% charge</span>
                    (50% now, 50% after 30 days)
                </div>
                <form id="withdrawForm">
                    <div class="mb-2">
                        <label class="form-label fw-semibold" style="font-size:0.76rem;">Withdrawal Type</label>
                        <select class="form-select form-select-sm" id="withdrawalType" required onchange="updateWithdrawalFee()">
                            <option value="">Choose type...</option>
                            <option value="regular">Regular Withdrawal (Dec 1–10 only)</option>
                            <option value="force">Force Withdrawal (<%= forceWithdrawalCharge %>%)</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold" style="font-size:0.76rem;">Amount (₦)</label>
                        <input type="number" class="form-control form-control-sm" id="withdrawAmount"
                               placeholder="Enter amount" max="<%= user.account?.balance || 0 %>"
                               required onchange="updateWithdrawalFee()">
                    </div>
                    <div class="mb-2" id="withdrawalFeeInfo" style="display:none;">
                        <div class="alert-warning-custom" style="font-size:0.76rem;">
                            <div class="d-flex justify-content-between mb-1">
                                <small>Withdrawal Amount:</small><strong id="withdrawAmountDisplay">₦0</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <small>Initial Charge (<%= forceWithdrawalCharge/2 %>%):</small><strong id="initialFee">₦0</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <small>30-Day Charge (<%= forceWithdrawalCharge/2 %>%):</small><strong id="secondFee">₦0</strong>
                            </div>
                            <hr class="my-1">
                            <div class="d-flex justify-content-between">
                                <small class="fw-bold" id="payoutLabel">You'll Receive:</small>
                                <strong id="netAmount">₦0</strong>
                            </div>
                            <small id="withdrawTimingNotice" class="d-block mt-1 text-muted"></small>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold" style="font-size:0.76rem;">Withdrawal Method</label>
                        <select class="form-select form-select-sm" required>
                            <option value="">Choose method...</option>
                            <option>Bank Transfer</option>
                            <option>Cash Pickup</option>
                            <option>Mobile Money</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold" style="font-size:0.76rem;">Reason for Withdrawal</label>
                        <textarea class="form-control form-control-sm" rows="2" placeholder="Brief reason" required></textarea>
                    </div>
                    <div class="alert-info-custom" style="font-size:0.75rem;">
                        <i class="fas fa-clock me-1"></i>Processing: 24–48 hours for regular withdrawals
                    </div>
                </form>
            </div>
            <div class="modal-footer py-2 px-3">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" onclick="submitWithdrawal()">Submit Request</button>
            </div>
        </div>
    </div>
</div>

<!-- Withdraw success / failed / limit -->
<div class="modal fade" id="withdrawSuccessModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-3" style="border-radius:14px;">
            <div class="modal-body">
                <i class="fas fa-check-circle text-success fa-2x mb-2"></i>
                <h6 class="fw-bold">Withdrawal Processing</h6>
                <p class="text-muted" style="font-size:0.8rem;">Expected within <strong>5 minutes</strong>.</p>
                <button class="btn btn-success w-100 btn-sm" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="withdrawFailedModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-3" style="border-radius:14px;">
            <div class="modal-body">
