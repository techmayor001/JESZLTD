<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Club De Stars — Dashboard</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ══ THEME TOKENS ══ */
:root{
  --sidebar-w:230px;--nav-h:62px;
  --r-sm:8px;--r-md:12px;--r-lg:16px;--r-xl:20px;
  --accent:#4f8ef7;--accent2:#7c5af4;
  --green:#22c78a;--red:#f05252;--amber:#f5a623;
  --tr:all .22s ease;
}
[data-theme="dark"]{
  --bg:#0a0f1e;--bg-card:#111827;--bg-card2:#1a2235;
  --bg-card3:rgba(255,255,255,.035);
  --border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.12);
  --text:#f0f4ff;--text2:#c8d4f0;--muted:#8b9ab8;
  --nav-bg:rgba(10,15,30,.93);
  --hero-bg:linear-gradient(135deg,#111827 0%,#1a2235 100%);
  --bar-bg:rgba(255,255,255,.07);--meta-bg:rgba(255,255,255,.03);
  --tog-bg:rgba(255,255,255,.08);
}
[data-theme="light"]{
  --bg:#cedaf8;--bg-card:#ffffff;--bg-card2:#f0f3fa;
  --bg-card3:rgba(0,0,0,.025);
  --border:rgba(0,0,0,.07);--border2:rgba(0,0,0,.12);
  --text:#0f1523;--text2:#2a3550;--muted:#6b7a99;
  --nav-bg:rgba(255,255,255,.93);
  --hero-bg:linear-gradient(135deg,#dde8ff 0%,#eef1ff 100%);
  --bar-bg:rgba(0,0,0,.07);--meta-bg:rgba(0,0,0,.025);
  --tog-bg:rgba(0,0,0,.07);
}

/* ══ BASE ══ */
*{margin:0;padding:0;box-sizing:border-box;}
html,body{
  height:100%;font-family:'DM Sans',sans-serif;
  background:var(--bg);color:var(--text);font-size:14px;
  transition:background .3s,color .3s;
}
a{text-decoration:none;color:inherit;}
button,input,select,textarea{font-family:inherit;}

/* ═══════════════════════════════════════
   PREMIUM LOADER — SHORT FORM
   Ring + "CloudBaam" word-mark only.
   No tagline, no progress bar.
   Total runtime ≈ 2.4 s → reveal at 2.8 s.
═══════════════════════════════════════ */
#loader{
  position:fixed;inset:0;background:#05101e;z-index:9999;
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:18px;overflow:hidden;
  transition:opacity .5s;
}
/* Ambient floating particles */
.ld-particles{position:absolute;inset:0;pointer-events:none;}
.ldp{
  position:absolute;width:2px;height:2px;border-radius:50%;
  background:#5cc8ff;opacity:0;
  animation:ldpDrift var(--dur) ease-in-out var(--delay) infinite;
}
@keyframes ldpDrift{
  0%  {transform:translate(0,0) scale(1);opacity:0;}
  20% {opacity:.5;}
  100%{transform:translate(var(--tx),var(--ty)) scale(0);opacity:0;}
}
/* Soft radial glow */
.ld-glow{
  position:absolute;width:260px;height:260px;border-radius:50%;
  background:radial-gradient(circle,rgba(92,200,255,.06) 0%,transparent 70%);
  animation:ldGlowP 3s ease-in-out infinite;pointer-events:none;
}
@keyframes ldGlowP{0%,100%{transform:scale(1);opacity:.6;}50%{transform:scale(1.12);opacity:1;}}

/* Centre stack */
.ld-center{display:flex;flex-direction:column;align-items:center;gap:16px;position:relative;z-index:2;}

/* Ring mark */
.ld-ring-wrap{
  width:58px;height:58px;position:relative;opacity:0;
  animation:ldRingIn .55s cubic-bezier(.16,1,.3,1) .15s forwards;
}
@keyframes ldRingIn{
  from{opacity:0;transform:scale(.45) rotate(-120deg);}
  to  {opacity:1;transform:scale(1) rotate(0);}
}
.ld-ring-svg{width:100%;height:100%;}
.ld-ring-bg  {fill:none;stroke:#0c2236;stroke-width:3;}
.ld-ring-arc {
  fill:none;stroke:#5cc8ff;stroke-width:3;stroke-linecap:round;
  stroke-dasharray:127;stroke-dashoffset:127;
  animation:ldArcDraw .9s cubic-bezier(.4,0,.2,1) .65s forwards;
}
@keyframes ldArcDraw{to{stroke-dashoffset:32;}}
.ld-ring-dot {fill:#5cc8ff;r:0;opacity:0;animation:ldDotPop .3s cubic-bezier(.34,1.56,.64,1) 1.5s forwards;}
@keyframes ldDotPop{to{r:3.5;opacity:1;}}
.ld-ring-orbit{fill:none;stroke:#0d2d45;stroke-width:1;stroke-dasharray:4 6;animation:ldOrbit 12s linear infinite;transform-origin:29px 29px;}
@keyframes ldOrbit{to{transform:rotate(360deg);}}
.ld-ring-letter{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:20px;font-weight:700;color:#5cc8ff;opacity:0;
  animation:ldLetterPop .35s cubic-bezier(.34,1.56,.64,1) 1.2s forwards;
}
@keyframes ldLetterPop{from{opacity:0;transform:scale(1.6);}to{opacity:1;transform:scale(1);}}

/* Brand name */
.ld-brand{display:flex;align-items:baseline;overflow:hidden;height:40px;}
.ld-word{display:flex;}
.ldl{
  font-size:28px;font-weight:700;letter-spacing:-.5px;display:inline-block;
  opacity:0;transform:translateY(36px);
  animation:ldlRise .45s cubic-bezier(.16,1,.3,1) var(--ld) forwards;
}
.ldl.w{color:#ffffff;}
.ldl.a{color:#5cc8ff;}
@keyframes ldlRise{to{opacity:1;transform:translateY(0);}}
.ld-word-gap{width:3px;}
/* ─── end short loader ─── */

/* ══ SIDEBAR ══ */
.sidebar{
  position:fixed;left:0;top:0;bottom:0;width:var(--sidebar-w);
  background:var(--bg-card);border-right:1px solid var(--border);
  z-index:200;display:flex;flex-direction:column;overflow:hidden;
  transition:transform .3s,background .3s,border-color .3s;
}
.sidebar-logo{
  padding:18px 18px 14px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;flex-shrink:0;
}
.logo-mark{
  width:34px;height:34px;border-radius:10px;flex-shrink:0;overflow:hidden;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:14px;color:#fff;
}
.logo-mark img{width:100%;height:100%;object-fit:cover;}
.logo-name{font-size:13px;font-weight:600;line-height:1.2;}
.logo-sub{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;}
.sidebar-user{padding:12px 14px;border-bottom:1px solid var(--border);flex-shrink:0;}
.user-chip{
  display:flex;align-items:center;gap:10px;
  background:var(--bg-card2);border-radius:10px;padding:9px 11px;
  border:1px solid var(--border);
}
.user-avatar{
  width:32px;height:32px;border-radius:8px;flex-shrink:0;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:600;color:#fff;
}
.user-name{font-size:13px;font-weight:500;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.user-id{font-size:10px;color:var(--muted);font-family:'DM Mono',monospace;letter-spacing:.04em;}
.sidebar-nav{flex:1;overflow-y:auto;padding:8px 10px;}
.sidebar-nav::-webkit-scrollbar{width:3px;}
.sidebar-nav::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px;}
.nav-section{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;padding:10px 8px 4px;margin-top:2px;}
.nav-item{
  display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:9px;
  color:var(--muted);font-size:13px;font-weight:400;
  transition:var(--tr);margin-bottom:1px;cursor:pointer;
  border:none;background:none;width:100%;text-align:left;
}
.nav-item:hover{background:var(--bg-card2);color:var(--text);}
.nav-item.active{background:rgba(79,142,247,.1);color:var(--accent);}
.nav-item i{width:18px;text-align:center;font-size:13px;flex-shrink:0;}
.nav-badge{
  margin-left:auto;background:var(--red);color:#fff;
  font-size:10px;font-weight:700;border-radius:20px;padding:2px 7px;
}
.sidebar-footer{padding:12px 14px;border-top:1px solid var(--border);flex-shrink:0;}
.member-pill{
  display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;
  font-size:10px;font-weight:600;background:rgba(34,199,138,.12);
  color:var(--green);border:1px solid rgba(34,199,138,.2);margin-bottom:8px;
}

/* ══ TOP NAV ══ */
.topnav{
  position:fixed;top:0;left:var(--sidebar-w);right:0;height:var(--nav-h);
  background:var(--nav-bg);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);z-index:100;
  display:flex;align-items:center;padding:0 20px;gap:12px;
  transition:left .3s,background .3s,border-color .3s;
}
.hamburger{
  display:none;cursor:pointer;padding:7px;border-radius:8px;
  border:none;background:none;color:var(--muted);font-size:17px;
  transition:var(--tr);flex-shrink:0;
}
.hamburger:hover{background:var(--bg-card2);color:var(--text);}
.topnav-greeting{flex:1;min-width:0;}
.topnav-greeting h2{font-size:15px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.topnav-greeting p{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.topnav-right{display:flex;align-items:center;gap:8px;flex-shrink:0;}
.status-row{display:flex;align-items:center;gap:5px;}
.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);}
.status-label{font-size:12px;color:var(--green);font-weight:500;}
.kyc-chip{
  display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:8px;
  background:rgba(245,166,35,.1);border:1px solid rgba(245,166,35,.2);
  font-size:11px;font-weight:500;color:var(--amber);cursor:pointer;
  transition:var(--tr);text-decoration:none;white-space:nowrap;
}
.kyc-chip.verified{background:rgba(34,199,138,.08);border-color:rgba(34,199,138,.2);color:var(--green);}
.kyc-chip i,.status-dot{flex-shrink:0;}
.theme-toggle{
  width:40px;height:22px;border-radius:20px;border:1px solid var(--border2);
  background:var(--tog-bg);cursor:pointer;position:relative;flex-shrink:0;
  transition:background .3s,border-color .3s;padding:0;
}
.tog-thumb{
  position:absolute;top:2px;left:2px;width:16px;height:16px;
  border-radius:50%;background:var(--muted);
  transition:transform .25s ease,background .25s;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;color:#fff;pointer-events:none;
}
[data-theme="light"] .tog-thumb{transform:translateX(18px);background:var(--accent);}

/* ══ MAIN ══ */
.main{
  margin-left:var(--sidebar-w);margin-top:var(--nav-h);
  padding:22px;min-height:calc(100vh - var(--nav-h));
  transition:margin-left .3s;
}

/* ══ NOTICE / OVERDUE ══ */
.notice-bar{
  display:flex;align-items:flex-start;gap:10px;
  background:rgba(245,166,35,.07);border:1px solid rgba(245,166,35,.18);
  border-radius:var(--r-md);padding:10px 14px;margin-bottom:14px;
  font-size:12px;color:var(--amber);line-height:1.5;
}
.notice-bar i{flex-shrink:0;margin-top:1px;font-size:13px;}
.overdue-banner{
  background:rgba(240,82,82,.1);border:1px solid rgba(240,82,82,.25);
  border-radius:var(--r-md);padding:10px 14px;margin-bottom:14px;
  display:flex;align-items:center;gap:10px;overflow:hidden;
}
.overdue-icon{color:var(--red);font-size:15px;flex-shrink:0;animation:blink 1.5s ease-in-out infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.35;}}
.ticker-wrap{flex:1;overflow:hidden;min-width:0;}
.ticker-inner{display:flex;white-space:nowrap;animation:ts 24s linear infinite;}
.ticker-inner:hover{animation-play-state:paused;}
.ticker-text{font-size:12px;color:var(--red);font-weight:500;padding-right:60px;}
.ticker-text strong{color:#ff7070;}
@keyframes ts{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}

/* ══ BALANCE HERO ══ */
.balance-hero{
  background:var(--hero-bg);border:1px solid var(--border2);
  border-radius:var(--r-xl);padding:22px;margin-bottom:14px;
  position:relative;overflow:hidden;
}
.balance-hero::before{
  content:'';position:absolute;top:-60px;right:-60px;
  width:200px;height:200px;border-radius:50%;
  background:radial-gradient(circle,rgba(79,142,247,.07) 0%,transparent 70%);
  pointer-events:none;
}
.balance-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px;}
.balance-amount{font-size:clamp(26px,5.5vw,40px);font-weight:300;letter-spacing:-.5px;line-height:1;}
.balance-amount .cur{font-size:.5em;vertical-align:super;color:var(--muted);margin-right:2px;}
.balance-roi{
  display:inline-flex;align-items:center;gap:5px;margin-top:8px;
  padding:4px 10px;background:rgba(34,199,138,.1);border-radius:20px;
  color:var(--green);font-size:12px;font-weight:500;border:1px solid rgba(34,199,138,.2);
}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px;}
.hero-stat{
  background:var(--bg-card3);border-radius:var(--r-md);
  padding:12px 14px;border:1px solid var(--border);
}
.hero-stat-label{font-size:11px;color:var(--muted);margin-bottom:3px;}
.hero-stat-value{font-size:clamp(14px,3vw,18px);font-weight:500;letter-spacing:-.3px;word-break:break-word;}
.hero-stat-sub{font-size:11px;color:var(--muted);margin-top:3px;line-height:1.4;}
.overdue-value{color:var(--red)!important;}
.overdue-tag{
  display:inline-flex;align-items:center;gap:4px;
  background:rgba(240,82,82,.1);color:var(--red);
  border-radius:5px;padding:2px 7px;font-size:10px;font-weight:600;margin-top:4px;
}

/* ══ CTA GRID ══ */
.cta-grid{
  display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;
}
.cta-btn{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:7px;padding:15px 8px;border-radius:var(--r-lg);
  border:1px solid var(--border);background:var(--bg-card);
  cursor:pointer;text-decoration:none;color:var(--text);transition:var(--tr);
}
.cta-btn:hover{border-color:var(--border2);background:var(--bg-card2);transform:translateY(-2px);}
.cta-icon{
  width:42px;height:42px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;
}
.cta-label{font-size:12px;font-weight:500;color:var(--muted);text-align:center;line-height:1.3;}
.cta-btn:hover .cta-label{color:var(--text);}
.cta-deposit .cta-icon{background:rgba(34,199,138,.12);color:var(--green);}
.cta-withdraw .cta-icon{background:rgba(240,82,82,.12);color:var(--red);}
.cta-loan    .cta-icon{background:rgba(245,166,35,.12);color:var(--amber);}
.cta-repay   .cta-icon{background:rgba(79,142,247,.12);color:var(--accent);}

/* ══ CARDS ROW ══ */
.cards-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px;}
.info-card,.loan-card{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--r-lg);padding:18px;
  transition:background .3s,border-color .3s;
}
.loan-card.overdue-card{border-color:rgba(240,82,82,.3);}
.ic-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.ic-title{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;}
.ic-link{font-size:12px;color:var(--accent);}
.ic-link:hover{text-decoration:underline;}
.roi-row{
  display:flex;justify-content:space-between;align-items:center;
  padding:7px 0;border-bottom:1px solid var(--border);font-size:13px;gap:8px;
}
.roi-row:last-of-type{border-bottom:none;}
.roi-row-label{color:var(--muted);flex:1;min-width:0;font-size:12px;}
.roi-row-val{font-weight:500;flex-shrink:0;text-align:right;font-size:13px;}
.share-bar-wrap{margin-top:14px;}
.share-bar-label{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:6px;}
.share-bar{background:var(--bar-bg);border-radius:4px;height:5px;overflow:hidden;}
.share-bar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .8s ease;}
.loan-progress{background:var(--bar-bg);border-radius:4px;height:4px;overflow:hidden;margin:10px 0;}
.loan-progress-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--amber),#f57c23);}
.loan-progress-fill.overdue{background:linear-gradient(90deg,var(--red),#c0392b);}
.loan-meta{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;}
.loan-meta-item{
  flex:1;min-width:calc(33.33% - 6px);
  background:var(--meta-bg);border-radius:9px;
  padding:9px 10px;border:1px solid var(--border);
}
.lm-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;}
.lm-value{font-size:13px;font-weight:500;word-break:break-word;}
.loan-pay-btn{
  width:100%;margin-top:12px;padding:11px;
  background:rgba(79,142,247,.1);border:1px solid rgba(79,142,247,.2);
  border-radius:10px;color:var(--accent);font-size:13px;font-weight:500;
  cursor:pointer;transition:var(--tr);
}
.loan-pay-btn:hover{background:rgba(79,142,247,.18);}
.no-loan-state{
  display:flex;flex-direction:column;align-items:center;
  justify-content:center;text-align:center;gap:12px;min-height:180px;
}
.no-loan-icon{
  width:52px;height:52px;border-radius:14px;
  background:rgba(79,142,247,.08);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;color:var(--accent);
}
.no-loan-cta{
  padding:10px 20px;background:rgba(79,142,247,.1);
  border:1px solid rgba(79,142,247,.2);border-radius:9px;
  color:var(--accent);font-size:13px;font-weight:500;
  text-decoration:none;transition:var(--tr);
}
.no-loan-cta:hover{background:rgba(79,142,247,.18);}

/* ══ COPYABLE ACCOUNT NUMBER ══ */
.acct-copy-row{
  display:inline-flex;align-items:center;gap:6px;
  font-weight:600;letter-spacing:.04em;cursor:pointer;
  padding:2px 6px;border-radius:6px;
  transition:background .18s;
}
.acct-copy-row:hover{background:rgba(79,142,247,.12);}
.acct-copy-row .copy-icon{
  font-size:11px;color:var(--accent);opacity:.7;transition:opacity .15s;
}
.acct-copy-row:hover .copy-icon{opacity:1;}
.acct-copy-row.copied{background:rgba(34,199,138,.1);color:var(--green);}
.acct-copy-row.copied .copy-icon{color:var(--green);}
/* tooltip bubble */
.copy-toast{
  position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(8px);
  background:rgba(34,199,138,.15);border:1px solid rgba(34,199,138,.3);
  color:var(--green);padding:7px 16px;border-radius:20px;font-size:12px;font-weight:500;
  pointer-events:none;opacity:0;z-index:9998;
  transition:opacity .25s,transform .25s;
}
.copy-toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* ══ MAINTENANCE ══ */
.maintenance-overlay{
  position:fixed;inset:0;z-index:9998;
  background:linear-gradient(135deg,#050910,#0a1428);
  display:flex;align-items:center;justify-content:center;padding:20px;
}
.maint-card{
  background:var(--bg-card);border:1px solid var(--border2);border-radius:var(--r-xl);
  max-width:420px;width:100%;padding:40px 28px;text-align:center;
}
.maint-icon{
  width:68px;height:68px;border-radius:50%;
  background:rgba(245,166,35,.1);border:1px solid rgba(245,166,35,.25);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 18px;font-size:26px;color:var(--amber);
  animation:mpulse 2s ease-in-out infinite;
}
@keyframes mpulse{0%,100%{box-shadow:0 0 0 0 rgba(245,166,35,.25);}50%{box-shadow:0 0 0 10px rgba(245,166,35,0);}}
.maint-badge{
  display:inline-flex;align-items:center;gap:5px;padding:3px 12px;border-radius:20px;
  background:rgba(245,166,35,.1);border:1px solid rgba(245,166,35,.2);
  color:var(--amber);font-size:10px;font-weight:700;text-transform:uppercase;
  letter-spacing:.1em;margin-bottom:14px;
}
.maint-title{font-size:22px;font-weight:400;margin-bottom:10px;line-height:1.3;}
.maint-title em{color:var(--accent);font-style:normal;}
.maint-message{font-size:13px;color:var(--muted);line-height:1.7;margin-bottom:22px;}
.maint-dots{display:flex;align-items:center;justify-content:center;gap:6px;}
.maint-dots span{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:dotb 1.4s ease-in-out infinite;}
.maint-dots span:nth-child(2){animation-delay:.2s;}
.maint-dots span:nth-child(3){animation-delay:.4s;}
@keyframes dotb{0%,80%,100%{transform:scale(.7);opacity:.4;}40%{transform:scale(1.1);opacity:1;}}
.maint-footer{margin-top:16px;font-size:11px;color:rgba(255,255,255,.2);}

/* ══ SIDEBAR OVERLAY ══ */
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:190;}
.sb-overlay.show{display:block;}

/* ══ MODALS ══ */
.modal-backdrop{
  display:none;position:fixed;inset:0;z-index:1000;
  background:rgba(0,0,0,.55);backdrop-filter:blur(5px);
  align-items:flex-end;justify-content:center;padding:0;
}
.modal-backdrop.open{display:flex;}
.modal-box{
  background:var(--bg-card);border:1px solid var(--border2);
  border-radius:var(--r-xl) var(--r-xl) 0 0;
  width:100%;max-width:480px;max-height:92vh;overflow-y:auto;
  animation:shup .28s cubic-bezier(.16,1,.3,1);
  transition:background .3s,border-color .3s;
}
@keyframes shup{from{transform:translateY(30px);opacity:0;}to{transform:none;opacity:1;}}
.modal-box::-webkit-scrollbar{width:3px;}
.modal-box::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px;}
.modal-handle{width:36px;height:4px;border-radius:2px;background:var(--border2);margin:12px auto 0;}
.modal-header{padding:16px 20px 0;display:flex;align-items:center;justify-content:space-between;}
.modal-title{font-size:16px;font-weight:500;}
.modal-close{
  background:none;border:none;color:var(--muted);cursor:pointer;font-size:17px;
  width:30px;height:30px;display:flex;align-items:center;justify-content:center;
  border-radius:7px;transition:var(--tr);
}
.modal-close:hover{background:var(--bg-card2);color:var(--text);}
.modal-body{padding:18px 20px;}
.form-group{margin-bottom:14px;}
.form-label{
  font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;
  color:var(--muted);display:block;margin-bottom:6px;
}
.form-control{
  width:100%;background:var(--bg-card2);border:1px solid var(--border2);
  border-radius:10px;color:var(--text);font-size:14px;padding:11px 14px;
  transition:border-color .18s,background .3s;outline:none;-webkit-appearance:none;
}
.form-control:focus{border-color:var(--accent);}
.form-control option{background:var(--bg-card);color:var(--text);}
.form-hint{font-size:11px;color:var(--muted);margin-top:5px;}
.modal-info{
  background:rgba(79,142,247,.08);border:1px solid rgba(79,142,247,.18);
  border-radius:10px;padding:12px;font-size:12px;color:var(--accent);
  line-height:1.6;margin-bottom:14px;
}
.modal-warn{
  background:rgba(245,166,35,.08);border:1px solid rgba(245,166,35,.18);
  border-radius:10px;padding:12px;font-size:12px;color:var(--amber);
  line-height:1.6;margin-bottom:14px;
}
.modal-danger{
  background:rgba(240,82,82,.09);border:1px solid rgba(240,82,82,.28);
  border-radius:10px;padding:12px 14px;font-size:12px;color:var(--red);
  line-height:1.65;margin-bottom:14px;
}
.modal-danger strong{color:#ff7a7a;}
.modal-footer{padding:0 20px 24px;display:flex;gap:10px;}
.btn{
  border:none;border-radius:10px;padding:12px 20px;font-size:13px;
  font-weight:500;cursor:pointer;transition:var(--tr);flex:1;
}
.btn-ghost{background:var(--bg-card2);color:var(--muted);}
.btn-ghost:hover{color:var(--text);}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;flex:2;}
.btn-primary:hover{opacity:.88;transform:translateY(-1px);}
.btn-danger{background:rgba(240,82,82,.12);border:1px solid rgba(240,82,82,.25);color:var(--red);flex:2;}
.btn-success{background:rgba(34,199,138,.12);border:1px solid rgba(34,199,138,.25);color:var(--green);flex:2;}
.fee-breakdown{
  background:var(--bg-card2);border:1px solid var(--border);
  border-radius:10px;padding:12px;margin-bottom:14px;
}
.fee-row{display:flex;justify-content:space-between;font-size:12px;padding:4px 0;}
.fee-row-label{color:var(--muted);}
.fee-divider{border:none;border-top:1px solid var(--border);margin:6px 0;}
.fee-total{font-weight:500;}
.result-modal{text-align:center;padding:28px 20px;}
.result-icon{
  width:60px;height:60px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 14px;font-size:24px;
}
.result-icon.success{background:rgba(34,199,138,.12);color:var(--green);}
.result-icon.error{background:rgba(240,82,82,.12);color:var(--red);}
.result-title{font-size:17px;font-weight:500;margin-bottom:7px;}
.result-msg{font-size:13px;color:var(--muted);margin-bottom:20px;line-height:1.6;}
.lob-box{
  border-radius:12px;padding:14px;margin-bottom:14px;
  background:rgba(79,142,247,.07);border:1px solid rgba(79,142,247,.2);
}
.lob-box.overdue{background:rgba(240,82,82,.07);border-color:rgba(240,82,82,.25);}
.lob-label{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:4px;}
.lob-amount{font-size:22px;font-weight:400;letter-spacing:-.3px;color:var(--accent);}
.lob-box.overdue .lob-amount{color:var(--red);}
.lob-row{display:flex;justify-content:space-between;font-size:12px;padding:3px 0;color:var(--muted);}
.lob-row span{color:var(--text);}
.lob-warn{background:rgba(240,82,82,.08);border-radius:8px;padding:8px 10px;margin-top:8px;font-size:11px;color:var(--red);}
.lock-warning{
  display:flex;align-items:flex-start;gap:10px;
  background:rgba(240,82,82,.09);border:1px solid rgba(240,82,82,.3);
  border-radius:10px;padding:12px 14px;margin-bottom:14px;
}
.lock-warning-icon{
  width:32px;height:32px;border-radius:8px;flex-shrink:0;
  background:rgba(240,82,82,.15);display:flex;align-items:center;justify-content:center;
  color:var(--red);font-size:14px;margin-top:1px;
}
.lock-warning-text{font-size:12px;color:var(--red);line-height:1.6;}
.lock-warning-text strong{color:#ff7a7a;display:block;margin-bottom:2px;font-size:13px;}

/* Admin banner */
.admin-banner{
  position:fixed;top:0;left:0;right:0;z-index:9997;
  background:#7c3a00;color:#fde68a;text-align:center;
  padding:8px;font-size:12px;font-weight:500;
}
.admin-banner a{color:#fcd34d;text-decoration:underline;margin-left:8px;}

/* Powered by */
.powered-by{position:fixed;bottom:12px;right:14px;font-size:11px;color:var(--muted);z-index:50;}
.powered-by strong{color:var(--accent);}

/* ══ RESPONSIVE ══ */
@media(max-width:1100px){.cards-row{grid-template-columns:1fr;}}
@media(max-width:900px){
  .sidebar{transform:translateX(calc(-1 * var(--sidebar-w)));}
  .sidebar.open{transform:none;box-shadow:4px 0 24px rgba(0,0,0,.3);}
  .topnav{left:0;}
  .main{margin-left:0;}
  .hamburger{display:flex;}
}
@media(max-width:600px){
  .main{padding:14px;}
  .cta-grid{grid-template-columns:repeat(2,1fr);gap:8px;}
  .hero-grid{grid-template-columns:1fr 1fr;}
  .balance-hero{padding:16px;}
  .notice-bar{font-size:11px;}
  .status-label{display:none;}
  .topnav{padding:0 12px;gap:8px;}
  .topnav-greeting h2{font-size:13px;}
  .topnav-greeting p{display:none;}
  .modal-box{max-width:100%;}
  .loan-meta{gap:6px;}
  .loan-meta-item{min-width:calc(50% - 3px);flex:none;}
  .cta-btn{padding:13px 6px;gap:6px;}
  .cta-icon{width:38px;height:38px;font-size:16px;}
  .cta-label{font-size:11px;}
}
@media(max-width:380px){
  .cta-icon{width:34px;height:34px;font-size:14px;}
  .cta-label{font-size:10px;}
  .hero-stat-value{font-size:13px;}
  .balance-amount{font-size:24px;}
  .hero-grid{gap:8px;}
  .hero-stat{padding:10px 11px;}
}
@media(min-width:901px){
  .modal-backdrop{align-items:center;padding:20px;}
  .modal-box{border-radius:var(--r-xl);max-width:440px;}
  .modal-handle{display:none;}
}
@media print{
  .sidebar,.topnav,.powered-by,.cta-grid,.overdue-banner,.notice-bar{display:none!important;}
  .main{margin:0;padding:0;}
}
</style>
</head>
<body>

<!-- ═══════════════════════════════════════
     PREMIUM LOADER — SHORT FORM (dashboard)
     Ring in → arc draw → dot snap → "C" pop
     → "Cloud" + "Baam" cascade
     Total ≈ 2.4 s, reveal at 2.8 s
═══════════════════════════════════════ -->
<div id="loader">
  <div class="ld-particles" id="ldParticles"></div>
  <div class="ld-glow"></div>

  <div class="ld-center">
    <div class="ld-ring-wrap">
      <svg class="ld-ring-svg" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle class="ld-ring-orbit" cx="29" cy="29" r="26"/>
        <circle class="ld-ring-bg"    cx="29" cy="29" r="20"/>
        <circle class="ld-ring-arc"   cx="29" cy="29" r="20" transform="rotate(-90 29 29)"/>
        <circle class="ld-ring-dot"   cx="29" cy="9"/>
      </svg>
      <div class="ld-ring-letter">C</div>
    </div>

    <div class="ld-brand">
      <div class="ld-word">
        <span class="ldl w" style="--ld:1.05s">C</span>
        <span class="ldl w" style="--ld:1.13s">l</span>
        <span class="ldl w" style="--ld:1.21s">o</span>
        <span class="ldl w" style="--ld:1.29s">u</span>
        <span class="ldl w" style="--ld:1.37s">d</span>
      </div>
      <div class="ld-word-gap"></div>
      <div class="ld-word">
        <span class="ldl a" style="--ld:1.48s">B</span>
        <span class="ldl a" style="--ld:1.56s">A</span>
        <span class="ldl a" style="--ld:1.64s">A</span>
        <span class="ldl a" style="--ld:1.72s">M</span>
      </div>
    </div>
  </div>
</div>

<!-- Copy toast -->
<div class="copy-toast" id="copyToast">Account number copied!</div>

<%
  const sharePercentage = allMembersTotalSavings > 0
    ? ((accountBalance / allMembersTotalSavings) * 100).toFixed(2) : 0;
  const pendingGuarantorCount = user.guarantorRequests
    ? user.guarantorRequests.filter(r => r.status === "pending").length : 0;
  const bankName      = (companyAccount && companyAccount.bankName)      || "—";
  const accountName   = (companyAccount && companyAccount.accountName)   || "—";
  const accountNumber = (companyAccount && companyAccount.accountNumber) || "—";
  const accountConfigured = bankName !== "—" && accountNumber !== "—";
  const isAdmin = user.role && user.role.name !== 'member';

  const forceWithdrawalPenalty = (user.account && user.account.accountType && user.account.accountType.forceWithdrawalPenalty != null)
    ? user.account.accountType.forceWithdrawalPenalty
    : (forceWithdrawalCharge || 2.5);

  const MIN_BALANCE = 10000;
%>

<!-- MAINTENANCE -->
<% if (maintenanceMode && maintenanceMode.enabled) { %>
  <% if (isAdmin) { %>
    <div class="admin-banner">
      <i class="fas fa-wrench" style="margin-right:6px;"></i>
      Maintenance Mode is ON — admins only.
      <a href="/admin-dashboard">Admin Panel →</a>
    </div>
  <% } else { %>
    <div class="maintenance-overlay">
      <div class="maint-card">
        <div class="maint-icon"><i class="fas fa-wrench"></i></div>
        <div class="maint-badge"><span style="width:5px;height:5px;border-radius:50%;background:currentColor;display:inline-block;"></span> Maintenance</div>
        <h1 class="maint-title">We'll be back <em>shortly</em></h1>
        <p class="maint-message"><%= maintenanceMode.message || "Scheduled maintenance in progress. Back soon." %></p>
        <div class="maint-dots"><span></span><span></span><span></span></div>
        <div class="maint-footer">Club De Stars · Powered by JESZ LIMITED</div>
      </div>
    </div>
  <% } %>
<% } %>

<div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

<!-- ════ SIDEBAR ════ -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-mark">
      <img src="/media/assets/logo/log.png" alt="Logo"
           onerror="this.style.display='none';this.parentNode.innerHTML='<b>C</b>'">
    </div>
    <div style="min-width:0;">
      <div class="logo-name">Club De Stars</div>
      <div class="logo-sub">Cooperative Society</div>
    </div>
  </div>
  <div class="sidebar-user">
    <div class="user-chip">
      <div class="user-avatar">
        <%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName.charAt(0).toUpperCase() %>
      </div>
      <div style="min-width:0;">
        <div class="user-name"><%= user.firstName %> <%= user.lastName %></div>
        <div class="user-id"><%= user.membershipID %></div>
      </div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">Menu</div>
    <a href="/cds-cooperative/dashboard" class="nav-item active"><i class="fas fa-home"></i> Dashboard</a>
    <a href="/cds-cooperative/transaction" class="nav-item"><i class="fas fa-exchange-alt"></i> Transactions</a>
    <a href="/cds-cooperative/loan" class="nav-item"><i class="fas fa-coins"></i> Loans</a>
    <a href="/cds-cooperative/guarantorRequest" class="nav-item">
      <i class="fas fa-user-check"></i> Guarantor
      <% if (pendingGuarantorCount > 0) { %><span class="nav-badge"><%= pendingGuarantorCount %></span><% } %>
    </a>
    <div class="nav-section">Account</div>
    <a href="/manage/kiddies-account" class="nav-item"><i class="fas fa-baby"></i> Kiddies Account</a>
    <a href="/cds-cooperative/profile" class="nav-item"><i class="fas fa-user"></i> Profile</a>
    <a href="/cds-cooperative/kyc" class="nav-item"><i class="fas fa-shield-alt"></i> KYC</a>
    <a href="/cds-cooperative/referral" class="nav-item"><i class="fas fa-user-plus"></i> Referrals</a>
    <a href="/cds-cooperative/report" class="nav-item"><i class="fas fa-chart-bar"></i> Reports</a>
    <a href="/cds-cooperative/memberContract" class="nav-item"><i class="fas fa-file-alt"></i> Terms</a>
    <% if (user.role && user.role.name !== 'member') { %>
    <div class="nav-section">Admin</div>
    <a href="/admin/dashboard" class="nav-item"><i class="fas fa-tachometer-alt"></i> Administration</a>
    <% } %>
  </nav>
  <div class="sidebar-footer">
    <div class="member-pill">
      <i class="fas fa-star" style="font-size:9px;"></i>
      <%= user.membershipID.startsWith('CD') ? 'Club Member' : 'Associate Member' %>
    </div>
    <a href="/logout" class="nav-item" style="color:var(--red);margin-top:2px;">
      <i class="fas fa-sign-out-alt"></i> Sign Out
    </a>
  </div>
</aside>

<!-- ════ TOP NAV ════ -->
<header class="topnav">
  <button class="hamburger" onclick="toggleSidebar()" aria-label="Menu">
    <i class="fas fa-bars"></i>
  </button>
  <div class="topnav-greeting">
    <h2>Hello, <%= user.firstName %> 👋</h2>
    <p>Since <%= new Date(user.createdAt).toLocaleDateString('en-US',{month:'short',year:'numeric'}) %></p>
  </div>
  <div class="topnav-right">
    <div class="status-row">
      <div class="status-dot"></div>
      <span class="status-label">Active</span>
    </div>
    <% if (user.Payment && user.Payment.status === "paid") { %>
      <div class="kyc-chip verified">
        <i class="fas fa-shield-alt" style="font-size:11px;"></i>
        <span>Verified</span>
      </div>
    <% } else { %>
      <a href="/cds-cooperative/kyc" class="kyc-chip">
        <i class="fas fa-shield-alt" style="font-size:11px;"></i>
        <span>KYC</span>
      </a>
    <% } %>
    <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle light/dark mode">
      <div class="tog-thumb" id="togThumb">
        <i class="fas fa-moon" id="togIcon" style="font-size:9px;"></i>
      </div>
    </button>
  </div>
</header>

<!-- ════ MAIN ════ -->
<main class="main">

  <div class="notice-bar">
    <i class="fas fa-calendar-check"></i>
    <span style="color: red;">Regular withdrawal window: <strong>Dec 1–10</strong> · On-demand withdrawal at <strong><%= forceWithdrawalPenalty %>% charge</strong> · Max <strong>50% of balance</strong> per request · Minimum balance of <strong>₦10,000</strong> must be maintained</span>
  </div>

  <% if (loanIsOverdue) { %>
  <div class="overdue-banner">
    <i class="fas fa-exclamation-triangle overdue-icon"></i>
    <div class="ticker-wrap">
      <div class="ticker-inner">
        <span class="ticker-text">Loan of <strong>₦<%= loan.amount.toLocaleString() %></strong> is overdue · Balance <strong>₦<%= loanOutstanding.toLocaleString() %></strong> · <strong><%= loanPenaltyRate %>%</strong>/day penalty accruing &nbsp;&nbsp;&nbsp;&nbsp;</span>
        <span class="ticker-text">Loan of <strong>₦<%= loan.amount.toLocaleString() %></strong> is overdue · Balance <strong>₦<%= loanOutstanding.toLocaleString() %></strong> · <strong><%= loanPenaltyRate %>%</strong>/day penalty accruing &nbsp;&nbsp;&nbsp;&nbsp;</span>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Balance Hero -->
  <div class="balance-hero">
    <div class="balance-label">Total Savings Balance</div>
    <div class="balance-amount">
      <span class="cur">₦</span><%= user.account?.balance ? user.account.balance.toLocaleString() : "0" %>
    </div>
    <% if (typeof ROI !== "undefined" && totalBalance) { %>
    <div class="balance-roi">
      <i class="fas fa-chart-line" style="font-size:12px;"></i>
      ₦<%= totalBalance.toLocaleString() %> incl. ROI
    </div>
    <% } %>
    <div class="hero-grid">
      <div class="hero-stat">
        <div class="hero-stat-label">Monthly ROI</div>
        <div class="hero-stat-value" style="color:var(--green);">₦<%= monthlyROI.toLocaleString(undefined,{maximumFractionDigits:2}) %></div>
        <div class="hero-stat-sub"><%= sharePercentage %>% Shares</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-label">Active Loan</div>
        <% if (loan) { %>
          <div class="hero-stat-value <%= loanIsOverdue ? 'overdue-value' : '' %>">₦<%= loanOutstanding.toLocaleString() %></div>
          <% if (loanIsOverdue) { %>
            <div class="overdue-tag"><i class="fas fa-circle" style="font-size:7px;"></i> Overdue</div>
          <% } else { %>
            <div class="hero-stat-sub">Due <%= loan.dueDate ? new Date(loan.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : 'N/A' %></div>
          <% } %>
        <% } else { %>
          <div class="hero-stat-value" style="color:var(--muted);">None</div>
          <div class="hero-stat-sub">Up to ₦<%= user.account?.balance ? (user.account.balance * 3).toLocaleString() : '0' %></div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- CTAs -->
  <div class="cta-grid">
    <a href="#" class="cta-btn cta-deposit" onclick="checkUserStatus('depositModal');return false;">
      <div class="cta-icon"><i class="fas fa-plus"></i></div>
      <div class="cta-label">Deposit</div>
    </a>
    <a href="#" class="cta-btn cta-withdraw" onclick="checkUserStatus('withdrawModal');return false;">
      <div class="cta-icon"><i class="fas fa-minus"></i></div>
      <div class="cta-label">Withdraw</div>
    </a>
    <a href="/cds-cooperative/loan" class="cta-btn cta-loan">
      <div class="cta-icon"><i class="fas fa-coins"></i></div>
      <div class="cta-label">Apply Loan</div>
    </a>
    <a href="#" class="cta-btn cta-repay" onclick="openModal('loanPaymentModal');return false;">
      <div class="cta-icon"><i class="fas fa-credit-card"></i></div>
      <div class="cta-label">Repay Loan</div>
    </a>
  </div>

  <!-- ROI + Loan -->
  <div class="cards-row">
    <div class="info-card">
      <div class="ic-header">
        <span class="ic-title">ROI Breakdown</span>
        <a href="/cds-cooperative/report" class="ic-link">Reports</a>
      </div>
      <div class="roi-row">
        <span class="roi-row-label">Your savings</span>
        <span class="roi-row-val">₦<%= accountBalance.toLocaleString() %></span>
      </div>
      <div class="roi-row">
        <span class="roi-row-label">Your ROI this month</span>
        <span class="roi-row-val" style="color:var(--accent);">₦<%= monthlyROI.toLocaleString(undefined,{maximumFractionDigits:2}) %></span>
      </div>
      <div class="share-bar-wrap">
        <div class="share-bar-label"><span>Shares</span><span><%= sharePercentage %>%</span></div>
        <div class="share-bar"><div class="share-bar-fill" style="width:<%= Math.min(parseFloat(sharePercentage),100) %>%"></div></div>
      </div>
    </div>

    <% if (loan) { %>
    <%
      const progressPct = loan.totalRepay > 0
        ? Math.max(0,Math.min(100,((loan.totalRepay - loanOutstanding)/loan.totalRepay*100).toFixed(0))) : 0;
    %>
    <div class="loan-card <%= loanIsOverdue ? 'overdue-card' : '' %>">
      <div class="ic-header">
        <span class="ic-title">Current Loan</span>
        <a href="/cds-cooperative/loan" class="ic-link">Details</a>
      </div>
      <div style="font-size:clamp(20px,4.5vw,28px);font-weight:300;letter-spacing:-.3px;color:<%= loanIsOverdue ? 'var(--red)' : 'var(--text)' %>;">
        ₦<%= loanOutstanding.toLocaleString() %>
      </div>
      <div style="font-size:12px;color:var(--muted);margin-top:2px;">Outstanding balance</div>
      <div class="loan-progress">
        <div class="loan-progress-fill <%= loanIsOverdue ? 'overdue' : '' %>" style="width:<%= progressPct %>%"></div>
      </div>
      <div class="loan-meta">
        <div class="loan-meta-item">
          <div class="lm-label">Principal</div>
          <div class="lm-value">₦<%= loan.amount.toLocaleString() %></div>
        </div>
        <div class="loan-meta-item">
          <div class="lm-label">Total Repay</div>
          <div class="lm-value">₦<%= loan.totalRepay.toLocaleString() %></div>
        </div>
        <div class="loan-meta-item">
          <div class="lm-label">Due</div>
          <div class="lm-value" style="color:<%= loanIsOverdue ? 'var(--red)' : 'var(--amber)' %>;">
            <%= loan.dueDate ? new Date(loan.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'2-digit'}) : 'N/A' %>
          </div>
        </div>
      </div>
      <% if (loanTotalPenalty > 0) { %>
      <div style="margin-top:12px;padding:10px;background:rgba(240,82,82,.07);border:1px solid rgba(240,82,82,.15);border-radius:9px;display:flex;justify-content:space-between;align-items:center;font-size:12px;">
        <span style="color:var(--muted);">Penalty (+<%= loanPenaltyRate %>%/day)</span>
        <span style="color:var(--red);font-weight:500;">+₦<%= loanTotalPenalty.toLocaleString() %></span>
      </div>
      <% } %>
      <button class="loan-pay-btn" onclick="openModal('loanPaymentModal')">
        Make a Payment <i class="fas fa-arrow-right" style="font-size:11px;margin-left:4px;"></i>
      </button>
    </div>
    <% } else { %>
    <div class="info-card">
      <div class="no-loan-state">
        <div class="no-loan-icon"><i class="fas fa-coins"></i></div>
        <div>
          <div style="font-size:15px;font-weight:500;margin-bottom:4px;">No Active Loan</div>
          <div style="font-size:12px;color:var(--muted);">Up to ₦<%= user.account?.balance ? (user.account.balance * 3).toLocaleString() : '0' %> available</div>
        </div>
        <a href="/cds-cooperative/loan" class="no-loan-cta">Apply for a Loan</a>
      </div>
    </div>
    <% } %>
  </div>

</main>

