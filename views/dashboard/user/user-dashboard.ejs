<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>

<script>
/* ── Server-injected constants ── */
const USER_STATUS               = "<%= user.status %>";
const USER_HAS_LOAN             = <%= loan ? "true" : "false" %>;
const USER_IS_GUARANTOR         = <%= user.guarantorRequests?.some(g => g.status === "accepted") ? "true" : "false" %>;
const USER_BALANCE              = <%= user.account?.balance || 0 %>;
const FORCE_FEE_PERCENT         = <%= forceWithdrawalCharge %>;
const FORCEFUL_WITHDRAWAL_COUNT = <%= forcefulWithdrawalCount || 0 %>;
const MAX_FORCEFUL_WITHDRAWALS  = 2;

/* ── Sidebar ── */
function toggleSidebar() {
    const open = document.getElementById("sidebar").classList.toggle("active");
    document.getElementById("sbOverlay").classList.toggle("show", open);
}
function closeSidebar() {
    document.getElementById("sidebar").classList.remove("active");
    document.getElementById("sbOverlay").classList.remove("show");
}

/* ── Helpers ── */
function checkUserStatus(modalId) {
    if (USER_STATUS === "pending") {
        new bootstrap.Modal(document.getElementById("pendingAccountModal")).show();
    } else {
        new bootstrap.Modal(document.getElementById(modalId)).show();
    }
}
function openModal(modalId) {
    new bootstrap.Modal(document.getElementById(modalId)).show();
}

/* ── Withdrawal fee calculator ── */
function updateWithdrawalFee() {
    const type        = document.getElementById("withdrawalType").value;
    const amountInput = document.getElementById("withdrawAmount");
    const feeInfo     = document.getElementById("withdrawalFeeInfo");
    const amount      = Number(amountInput.value) || 0;
    const halfBalance = USER_BALANCE / 2;
    const chargeRate  = FORCE_FEE_PERCENT / 100;

    if (!type || amount <= 0) { feeInfo.style.display = "none"; return; }
    if (amount > USER_BALANCE) { amountInput.value = USER_BALANCE; return updateWithdrawalFee(); }

    let initialFee = 0, secondFee = 0, payoutNow = 0, labelText = "", timingMessage = "";

    if (type === "force") {
        if (FORCEFUL_WITHDRAWAL_COUNT >= MAX_FORCEFUL_WITHDRAWALS) {
            new bootstrap.Modal(document.getElementById("withdrawLimitModal")).show();
            document.getElementById("withdrawalType").value = "";
            feeInfo.style.display = "none"; return;
        }
        if (amount < halfBalance) {
            initialFee    = amount * chargeRate;
            payoutNow     = amount - initialFee;
            labelText     = "You'll Receive Immediately:";
            timingMessage = "This withdrawal will be credited immediately.";
        } else if (amount === halfBalance) {
            initialFee    = amount * chargeRate;
            payoutNow     = amount - initialFee;
            labelText     = "You'll Receive Within 30 Days:";
            timingMessage = "This withdrawal will be credited within 30 days.";
        } else {
            initialFee    = (amount * chargeRate) / 2;
            secondFee     = (amount * chargeRate) / 2;
            payoutNow     = halfBalance - initialFee;
            labelText     = "First Payout (Within 30 Days):";
            timingMessage = "Paid in two phases. First payout within 30 days.";
        }
    }
    if (type === "regular") {
        payoutNow = amount; labelText = "You'll Receive:"; timingMessage = "Processed within 24–48 hours.";
    }

    feeInfo.style.display = "block";
    document.getElementById("withdrawAmountDisplay").innerText = `₦${amount.toLocaleString()}`;
    document.getElementById("initialFee").innerText  = `₦${initialFee.toLocaleString(undefined,{minimumFractionDigits:2})}`;
    document.getElementById("secondFee").innerText   = `₦${secondFee.toLocaleString(undefined,{minimumFractionDigits:2})}`;
    document.getElementById("netAmount").innerText   = `₦${payoutNow.toLocaleString(undefined,{minimumFractionDigits:2})}`;
    document.getElementById("payoutLabel").innerText = labelText;
    document.getElementById("withdrawTimingNotice").innerText = timingMessage;
}

async function submitWithdrawal() {
    const successModal = new bootstrap.Modal(document.getElementById("withdrawSuccessModal"));
    const failedModal  = new bootstrap.Modal(document.getElementById("withdrawFailedModal"));
    const limitModal   = new bootstrap.Modal(document.getElementById("withdrawLimitModal"));
    const errorMsg     = document.getElementById("withdrawErrorMsg");
    const type         = document.getElementById("withdrawalType").value;
    const amount       = Number(document.getElementById("withdrawAmount").value);
    try {
        if (!type)                  throw new Error("Please select a withdrawal type.");
        if (!amount || amount <= 0) throw new Error("Invalid withdrawal amount.");
        if (amount > USER_BALANCE)  throw new Error("Insufficient balance.");
        if (type === "force" && FORCEFUL_WITHDRAWAL_COUNT >= MAX_FORCEFUL_WITHDRAWALS) { limitModal.show(); return; }
        if (USER_HAS_LOAN)          throw new Error("You cannot withdraw while you have an active loan.");
        if (USER_IS_GUARANTOR === "true" && amount >= USER_BALANCE) throw new Error("Guarantors cannot withdraw full balance.");
        if (type === "regular") {
            const today = new Date(), day = today.getDate(), month = today.getMonth();
            if (month !== 11 || day < 1 || day > 10) throw new Error("Regular withdrawals are only allowed between Dec 1–10.");
        }
        const res  = await fetch("/withdraw", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({type, amount}) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || "Withdrawal failed.");
        bootstrap.Modal.getInstance(document.getElementById("withdrawModal")).hide();
        successModal.show();
        document.getElementById("withdrawForm").reset();
        document.getElementById("withdrawalFeeInfo").style.display = "none";
    } catch(err) {
        errorMsg.innerText = err.message; failedModal.show();
    }
}
</script>

<!-- Deposit logic -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    const paymentMethod      = document.getElementById("paymentMethod");
    const paystackSection    = document.getElementById("paystackSection");
    const cooperativeSection = document.getElementById("cooperativeSection");
    const coopSource         = document.getElementById("coopSource");
    const coopBankDetails    = document.getElementById("coopBankDetails");
    const coopNoExtra        = document.getElementById("coopNoExtra");
    const form               = document.getElementById("depositForm");
    const submitBtn          = document.getElementById("submitDeposit");
    const depositModalEl     = document.getElementById("depositModal");
    const successModal       = new bootstrap.Modal(document.getElementById("depositSuccessModal"));
    const failedModal        = new bootstrap.Modal(document.getElementById("depositFailedModal"));

    paymentMethod.addEventListener("change", () => {
        paystackSection.classList.add("d-none");
        cooperativeSection.classList.add("d-none");
        if (paymentMethod.value === "paystack")    paystackSection.classList.remove("d-none");
        if (paymentMethod.value === "cooperative") cooperativeSection.classList.remove("d-none");
    });
    coopSource.addEventListener("change", () => {
        coopBankDetails.classList.toggle("d-none", !coopSource.value);
        coopNoExtra.classList.toggle("d-none", coopSource.value !== "no");
    });
    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const method = paymentMethod.value;
        submitBtn.disabled = true; submitBtn.innerHTML = "Processing...";
        try {
            if (method === "paystack") {
                const res  = await fetch("/deposit/init", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ amount: document.getElementById("paystackAmount").value }) });
                const data = await res.json();
                if (data.authorization_url) { window.location.href = data.authorization_url; return; }
                throw new Error(data.message || "Paystack init failed");
            }
            if (method === "cooperative") {
                const res = await fetch("/deposit/cooperative", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        coopAmount: document.getElementById("coopAmount").value,
                        source: coopSource.value,
                        payeeName: document.getElementById("payerName")?.value || ""
                    })
                });
                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.message || "Cooperative deposit failed");
                bootstrap.Modal.getInstance(depositModalEl).hide();
                successModal.show();
                form.reset();
                paystackSection.classList.add("d-none");
                cooperativeSection.classList.add("d-none");
            }
        } catch(err) { console.error(err); failedModal.show(); }
        finally { submitBtn.disabled = false; submitBtn.innerHTML = "Proceed"; }
    });
});
</script>

<!-- Loan repayment logic -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    const loanSelect   = document.getElementById("loanSelect");
    const payMethod    = document.getElementById("loanPaymentMethod");
    const paystackSec  = document.getElementById("loanPaystackSection");
    const coopSec      = document.getElementById("loanCoopSection");
    const form         = document.getElementById("loanRepaymentForm");
    const submitBtn    = document.getElementById("submitLoanPayment");
    const successModal = new bootstrap.Modal(document.getElementById("loanPaymentSuccessModal"));
    const failedModal  = new bootstrap.Modal(document.getElementById("loanPaymentFailedModal"));
    const outBox       = document.getElementById("loanOutstandingBox");
    const boxTag       = document.getElementById("loanBoxTag");
    const boxAmount    = document.getElementById("loanBoxAmount");
    const boxBreakdown = document.getElementById("loanBoxBreakdown");
    const overdueWarn  = document.getElementById("loanOverdueWarn");
    const penRateText  = document.getElementById("penRateText");

    let loansData = [];

    async function loadLoans() {
        try {
            const res = await fetch("/api/user/loans/active");
            loansData = await res.json();
            loanSelect.innerHTML = '<option value="">Select a loan</option>';
            if (!Array.isArray(loansData) || !loansData.length) {
                loanSelect.innerHTML = '<option value="">No active loans found</option>';
                return;
            }
            loansData.forEach(loan => {
                const opt         = document.createElement("option");
                opt.value         = loan._id;
                const outstanding = Number(loan.outstandingBalance || loan.totalRepay || 0);
                const isOverdue   = loan.status === "overdue";
                const dueStr      = loan.dueDate
                    ? new Date(loan.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})
                    : "N/A";
                opt.textContent = `₦${outstanding.toLocaleString()} outstanding — ${isOverdue ? "⚠️ OVERDUE" : "due"} ${dueStr}`;
                loanSelect.appendChild(opt);
            });
        } catch(err) {
            loanSelect.innerHTML = '<option value="">Error loading loans</option>';
            console.error(err);
        }
    }

    loanSelect.addEventListener("change", () => {
        const loan = loansData.find(l => l._id === loanSelect.value);
        if (!loan) { outBox.classList.add("d-none"); return; }

        const outstanding  = Number(loan.outstandingBalance || loan.totalRepay || 0);
        const totalRepay   = Number(loan.totalRepay         || 0);
        const loanAmount   = Number(loan.amount             || 0);
        const totalPenalty = Number(loan.totalPenalty       || 0);
        const penaltyRate  = Number(loan.penaltyPercentage  || 0);
        const isOverdue    = loan.status === "overdue";
        const dueStr       = loan.dueDate
            ? new Date(loan.dueDate).toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric'})
            : "N/A";

        outBox.classList.remove("d-none", "is-overdue");
        if (isOverdue) outBox.classList.add("is-overdue");

        boxTag.textContent    = isOverdue ? "⚠️ Overdue — Total Amount Now Owed" : "Total Outstanding Balance";
        boxAmount.textContent = `₦${outstanding.toLocaleString()}`;

        boxBreakdown.innerHTML = "";
        const mkRow = (lbl, val, color) => {
            const d = document.createElement("div");
            d.className = "lob-row";
            d.innerHTML = `<span>${lbl}</span><span style="color:${color||'inherit'}">${val}</span>`;
            return d;
        };
        boxBreakdown.appendChild(mkRow("Original loan amount:", `₦${loanAmount.toLocaleString()}`,  "#374151"));
        boxBreakdown.appendChild(mkRow("Base repayment (with interest):", `₦${totalRepay.toLocaleString()}`, "#1e3a8a"));
        if (totalPenalty > 0)
            boxBreakdown.appendChild(mkRow("Penalty accrued:", `+₦${totalPenalty.toLocaleString()}`, "#dc2626"));
        boxBreakdown.appendChild(mkRow("Due date:", dueStr, "#6b7280"));

        if (isOverdue && penaltyRate > 0) {
            overdueWarn.classList.remove("d-none");
            penRateText.textContent = penaltyRate;
        } else {
            overdueWarn.classList.add("d-none");
        }

        const rounded = Math.ceil(outstanding);
        document.getElementById("loanPaystackAmount").value = rounded;
        document.getElementById("loanCoopAmount").value     = rounded;
    });

    payMethod.addEventListener("change", () => {
        paystackSec.classList.add("d-none"); coopSec.classList.add("d-none");
        if (payMethod.value === "paystack")    paystackSec.classList.remove("d-none");
        if (payMethod.value === "cooperative") coopSec.classList.remove("d-none");
    });

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const loanId = loanSelect.value;
        const method = payMethod.value;
        if (!loanId || !method) { failedModal.show(); return; }
        submitBtn.disabled = true; submitBtn.innerHTML = "Processing...";
        try {
            if (method === "paystack") {
                const res  = await fetch("/loan/payment", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ loanId, amount: document.getElementById("loanPaystackAmount").value }) });
                const data = await res.json();
                if (data.authorization_url) { window.location.href = data.authorization_url; return; }
                throw new Error("Paystack init failed");
            }
            if (method === "cooperative") {
                const res = await fetch("/loan/payment/manual", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ loanId, amount: document.getElementById("loanCoopAmount").value, payerName: document.getElementById("loanPayerName").value }) });
                if (!res.ok) throw new Error("Manual payment failed");
                form.reset(); outBox.classList.add("d-none");
                paystackSec.classList.add("d-none"); coopSec.classList.add("d-none");
                successModal.show();
                setTimeout(() => location.reload(), 2500);
            }
        } catch(err) { console.error(err); failedModal.show(); }
        finally { submitBtn.disabled = false; submitBtn.innerHTML = "Proceed"; }
    });

    loadLoans();
});
</script>

<script>
/* Sidebar outside click */
document.addEventListener("click", function(e) {
    const sb = document.getElementById("sidebar");
    if (window.innerWidth <= 992 && sb.classList.contains("active") &&
        !sb.contains(e.target) && !e.target.classList.contains("fa-bars")) {
        closeSidebar();
    }
});

/* Loader dismiss */
window.addEventListener("load", () => {
    const loader = document.getElementById("loaderScreen");
    setTimeout(() => {
        loader.style.opacity    = "0";
        loader.style.transition = "opacity 0.5s ease";
        setTimeout(() => { loader.style.display = "none"; }, 500);
    }, 400);
});

/* Entrance animation */
document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".stat-card, .card").forEach((el, i) => {
        el.style.opacity    = "0";
        el.style.transform  = "translateY(14px)";
        el.style.transition = "opacity 0.45s ease, transform 0.45s ease";
        setTimeout(() => { el.style.opacity = "1"; el.style.transform = "translateY(0)"; }, i * 80);
    });
});
</script>

</body>
</html>
