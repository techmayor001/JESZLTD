        <div class="sc-row"><span class="sc-label">Guarantors</span><span class="sc-val"><%= (activeLoan.guarantors||[]).length || 0 %> assigned</span></div>
        <a href="/cds-cooperative/loan" style="display:block;margin-top:12px;padding:10px;border-radius:10px;background:rgba(79,142,247,.1);border:1px solid rgba(79,142,247,.2);color:var(--accent);font-size:13px;font-weight:500;text-align:center;">
