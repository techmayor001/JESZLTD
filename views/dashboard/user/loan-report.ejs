                const statusClass = l.status === 'paid' ? 'ls-paid' : l.status === 'overdue' ? 'ls-overdue' : l.status === 'active' ? 'ls-active' : l.status === 'pending' ? 'ls-pending' : 'ls-rejected';
                const dueStr = l.dueDate ? new Date(l.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : 'N/A';
