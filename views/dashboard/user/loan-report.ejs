        <div class="sc-row"><span class="sc-label">Settled loans</span><span class="sc-val" style="color:var(--green);"><%= allLoans.filter(l=>l.status==='paid').length %></span></div>
        <div class="sc-row"><span class="sc-label">Active loans</span><span class="sc-val" style="color:var(--amber);"><%= allLoans.filter(l=>l.status==='active').length %></span></div>
        <div class="sc-row"><span class="sc-label">Overdue loans</span><span class="sc-val" style="color:<%= allLoans.filter(l=>l.status==='overdue').length > 0 ? 'var(--red)' : 'var(--muted)' %>;"><%= allLoans.filter(l=>l.status==='overdue').length %></span></div>
        <hr class="sc-divider">
        <div class="sc-row"><span class="sc-label">Total borrowed</span><span class="sc-val">₦<%= totalBorrowed.toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">Total repaid</span><span class="sc-val" style="color:var(--green);">₦<%= totalRepaid.toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">Total interest paid</span><span class="sc-val" style="color:var(--red);">₦<%= interestPaid.toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">Penalties incurred</span><span class="sc-val" style="color:<%= totalPenalties > 0 ? 'var(--red)' : 'var(--muted)' %>;"><%= totalPenalties > 0 ? '₦'+totalPenalties.toLocaleString() : 'None' %></span></div>
        <div class="sc-row"><span class="sc-label">Outstanding</span><span class="sc-val" style="color:<%= loanIsOverdue ? 'var(--red)' : 'var(--amber)' %>;">₦<%= outstanding.toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">Interest rate</span><span class="sc-val"><%= interestRate %>% · <%= user.membershipID.startsWith('CD') ? 'Club' : 'Standard' %></span></div>
      </div>

      <!-- Active loan repayment schedule -->
      <% if (activeLoan) { %>
      <div class="side-card">
        <div class="sc-title">Current Loan Detail</div>
        <div style="font-size:clamp(20px,3.5vw,26px);font-weight:300;letter-spacing:-.3px;margin-bottom:4px;">₦<%= outstanding.toLocaleString() %></div>
        <div style="font-size:11px;color:var(--muted);margin-bottom:14px;">Outstanding of ₦<%= activeLoan.totalRepay.toLocaleString() %> total</div>
        <div class="progress-section">
          <div class="progress-header"><span>Paid off</span><span><%= loanProgressPct %>%</span></div>
          <div class="progress-bar"><div class="progress-fill <%= loanIsOverdue ? 'red' : 'amber' %>" style="width:<%= loanProgressPct %>%"></div></div>
        </div>
        <div class="sc-row"><span class="sc-label">Principal</span><span class="sc-val">₦<%= activeLoan.amount.toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">Interest (<%= interestRate %>%)</span><span class="sc-val" style="color:var(--red);">₦<%= ((activeLoan.totalRepay||0)-(activeLoan.amount||0)).toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">Amount paid</span><span class="sc-val" style="color:var(--green);">₦<%= ((activeLoan.totalRepay||0)-outstanding).toLocaleString() %></span></div>
        <div class="sc-row"><span class="sc-label">Remaining</span><span class="sc-val" style="color:<%= loanIsOverdue ? 'var(--red)' : 'var(--amber)' %>;">₦<%= outstanding.toLocaleString() %></span></div>
        <% if ((activeLoan.totalPenalty||0) > 0) { %>
        <div class="sc-row"><span class="sc-label" style="color:var(--red);">Penalty accrued</span><span class="sc-val" style="color:var(--red);">+₦<%= activeLoan.totalPenalty.toLocaleString() %></span></div>
