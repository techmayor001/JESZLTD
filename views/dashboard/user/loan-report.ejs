        <div class="empty-state" style="padding:32px 20px;">
          <div class="empty-icon"><i class="fas fa-receipt"></i></div>
          <div style="font-size:13px;color:var(--muted);">No repayments recorded yet</div>
        </div>
        <% } else { %>
        <div class="timeline" style="padding:0 18px;">
          <% repayments.slice().reverse().forEach((p, i) => {
            const pDate = p.createdAt ? new Date(p.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—';
            const pTime = p.createdAt ? new Date(p.createdAt).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}) : '';
            const dotColor = p.status === 'approved' || p.status === 'paid' ? 'var(--green)' : p.status === 'pending' ? 'var(--amber)' : 'var(--red)';
          %>
          <div class="tl-item">
            <div class="tl-left">
              <div class="tl-dot" style="background:<%= dotColor %>;"></div>
