                <td><span style="font-family:'DM Mono',monospace;font-size:13px;">₦<%= (l.amount||0).toLocaleString() %></span></td>
                <td><span style="font-family:'DM Mono',monospace;font-size:13px;color:var(--amber);">₦<%= (l.totalRepay||0).toLocaleString() %></span></td>
