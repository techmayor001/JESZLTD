            <div class="tl-body">
              <div class="tl-title">Loan Payment</div>
              <div class="tl-sub"><%= pDate %> · <%= pTime %> · <%= p.method || p.paymentMethod || 'Transfer' %></div>
              <% if (p.status === 'pending') { %>
                <span style="font-size:10px;background:rgba(245,166,35,.1);color:var(--amber);border:1px solid rgba(245,166,35,.2);padding:2px 7px;border-radius:8px;display:inline-block;margin-top:3px;">Pending approval</span>
              <% } %>
            </div>
            <div class="tl-amount" style="color:var(--green);">+₦<%= (p.amount||0).toLocaleString() %></div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </div>

      <!-- Repayment Chart -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">Monthly Repayments</span>
