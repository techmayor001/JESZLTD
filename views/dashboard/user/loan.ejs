      <button class="modal-close" onclick="closeModal('paymentModal')"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <div class="summary-box">
        <div class="summary-row">
          <span class="summary-label">Outstanding balance</span>
          <span style="font-weight:500;color:<%= loanIsOverdue ? 'var(--red)' : 'var(--text)' %>;">
            ₦<%= loan ? (loan.outstandingBalance || loan.totalRepay).toLocaleString() : '0' %>
          </span>
        </div>
        <% if (loan && loan.totalPenalty > 0) { %>
        <div class="summary-row">
          <span class="summary-label">Penalty accrued</span>
          <span style="color:var(--red);">+₦<%= loan.totalPenalty.toLocaleString() %></span>
        </div>
        <% } %>
      </div>
      <form id="loanPaymentForm">
        <div class="form-group">
          <label class="form-label">Amount (₦)</label>
          <input type="number" name="amount" id="paymentAmount" class="form-control"
                 value="<%= loan ? Math.ceil((loan.outstandingBalance || loan.totalRepay) / 12) : 0 %>"
                 min="<%= loan ? Math.ceil((loan.outstandingBalance || loan.totalRepay) / 12) : 0 %>"
                 max="<%= loan ? (loan.outstandingBalance || loan.totalRepay) : 0 %>" required>
          <div class="form-hint">Minimum: ₦<%= loan ? Math.ceil((loan.outstandingBalance || loan.totalRepay) / 12).toLocaleString() : '0' %></div>
        </div>
        <input type="hidden" name="loanId" value="<%= loan ? loan._id : '' %>">
        <div class="modal-warn" style="margin-bottom:0;">
          <i class="fas fa-calendar-alt" style="margin-right:6px;"></i>
          Due <strong><%= loan && dueDate ? new Date(dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : 'N/A' %></strong>
          — avoid <%= loan?.duration?.penaltyPercentage || 0.5 %>% daily penalty
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('paymentModal')">Cancel</button>
      <button class="btn btn-primary" onclick="submitLoanPayment()">
        <i class="fas fa-arrow-right" style="margin-right:5px;font-size:11px;"></i>Proceed
      </button>
    </div>
  </div>
</div>

