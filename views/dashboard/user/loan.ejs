<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club De Stars - My Loans | Powered by JESZ LIMITED</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
        }
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; z-index: 1040; transition: all 0.3s;
            overflow-y: auto; box-shadow: 4px 0 20px rgba(30,58,138,0.15);
        }
        .sidebar-header { padding: 2rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.1); }
        .logo-container { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .logo-box {
            width: 45px; height: 45px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; color: var(--primary); font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        .sidebar-menu { padding: 1rem 0; }
        .sidebar-menu a {
            color: rgba(255,255,255,0.85); text-decoration: none;
            padding: 0.875rem 1.5rem; display: flex; align-items: center;
            transition: all 0.3s; border-left: 3px solid transparent; font-weight: 500;
        }
        .sidebar-menu a:hover { background: rgba(255,255,255,0.1); color: white; border-left-color: white; }
        .sidebar-menu a.active { background: rgba(255,255,255,0.15); color: white; border-left-color: white; }
        .sidebar-menu a i { width: 24px; margin-right: 12px; font-size: 1.1rem; }
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0;
            height: 75px; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,0.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 2rem;
            transition: all 0.3s; border-bottom: 1px solid rgba(30,58,138,0.1);
        }
        .main-content { margin-left: var(--sidebar-width); margin-top: 75px; padding: 2rem; min-height: calc(100vh - 75px); }
        .welcome-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; border-radius: 24px; padding: 2.5rem; margin-bottom: 2rem;
            box-shadow: 0 15px 40px rgba(30,58,138,0.25); position: relative; overflow: hidden;
        }
        .welcome-card::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,0.05); border-radius: 50%;
        }
        .member-badge {
            display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px;
            background: rgba(255,255,255,0.2); backdrop-filter: blur(10px);
            border-radius: 20px; border: 1px solid rgba(255,255,255,0.3);
            font-weight: 600; font-size: 0.9rem;
        }
        .club-member-badge { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
        .stat-card {
            background: white; border-radius: 20px; padding: 1.75rem;
            box-shadow: 0 8px 20px rgba(30,58,138,0.08); transition: transform 0.3s, box-shadow 0.3s;
            height: 100%; border: 1px solid rgba(30,58,138,0.05);
        }
        .stat-card:hover { transform: translateY(-8px); box-shadow: 0 15px 35px rgba(30,58,138,0.15); }
        .stat-icon { width: 65px; height: 65px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 1rem; }
        .card { border: none; border-radius: 20px; box-shadow: 0 8px 20px rgba(30,58,138,0.08); background: white; border: 1px solid rgba(30,58,138,0.05); }
        .card-header {
            background: linear-gradient(135deg, rgba(30,58,138,0.03) 0%, rgba(59,130,246,0.03) 100%);
            border-bottom: 2px solid rgba(30,58,138,0.1); padding: 1.5rem;
            border-radius: 20px 20px 0 0 !important;
        }
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none; padding: 0.7rem 1.75rem; border-radius: 12px; font-weight: 600; transition: all 0.3s;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(30,58,138,0.3); }
        .btn-outline-primary { border: 2px solid var(--primary); color: var(--primary); border-radius: 12px; padding: 0.7rem 1.75rem; font-weight: 600; transition: all 0.3s; }
        .btn-outline-primary:hover { background: var(--primary); transform: translateY(-2px); }
        .alert-warning-custom { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border: 2px solid #f59e0b; border-radius: 16px; padding: 1.25rem; color: #92400e; }
        .alert-info-custom { background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border: 2px solid #3b82f6; border-radius: 16px; padding: 1.25rem; color: #1e40af; }
        .loan-rules-list { background: rgba(30,58,138,0.02); padding: 1.5rem; border-radius: 16px; border: 2px solid rgba(30,58,138,0.1); }
        .loan-rules-list li { padding: 0.75rem 0; border-bottom: 1px solid rgba(30,58,138,0.1); }
        .loan-rules-list li:last-child { border-bottom: none; }
        .powered-by {
            position: fixed; bottom: 20px; right: 20px; background: white;
            padding: 12px 20px; border-radius: 30px; box-shadow: 0 4px 15px rgba(30,58,138,0.15);
            font-size: 0.85rem; font-weight: 600; color: var(--primary); z-index: 1000;
        }
        .loader-screen {
            position: fixed; inset: 0; background: linear-gradient(135deg, #0a1a2f, #102a44);
            display: flex; justify-content: center; align-items: center; z-index: 9999;
        }
        .logo span {
            font-size: 52px; font-weight: 600; color: #5cc8ff;
            display: inline-block; animation: float 1.5s infinite ease-in-out; letter-spacing: 1px;
        }
        .logo span:nth-child(1){--i:0}.logo span:nth-child(2){--i:1}.logo span:nth-child(3){--i:2}
        .logo span:nth-child(4){--i:3}.logo span:nth-child(5){--i:4}.logo span:nth-child(6){--i:5}
        .logo span:nth-child(7){--i:6}.logo span:nth-child(8){--i:7}.logo span:nth-child(9){--i:8}
        .logo span { animation-delay: calc(var(--i) * 0.1s); }
        @keyframes float { 0%,100%{transform:translateY(0);opacity:.4} 50%{transform:translateY(-14px);opacity:1} }
        @media (max-width: 992px) {
            .sidebar { left: calc(-1 * var(--sidebar-width)); }
            .sidebar.active { left: 0; }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; }
        }
        @media print {
            .sidebar,.top-navbar,.btn,.powered-by { display: none !important; }
            .main-content { margin: 0; padding: 0; }
        }
    </style>
</head>
<body>

<div id="loader-screen" class="loader-screen">
    <div class="logo">
        <span>C</span><span>l</span><span>o</span><span>u</span><span>d</span><span>B</span><span>a</span><span>a</span><span>m</span>
    </div>
</div>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-container">
            <div class="logo-box">
                <img src="/media/assets/logo/log.png" alt="" width="100%" height="100%">
            </div>
            <div>
                <h5 class="mb-0 fw-bold" style="text-transform:uppercase;">Club De Stars</h5>
                <small class="opacity-75">COOPERATIVE SOCIETY LIMITED</small>
            </div>
        </div>
        <div class="member-badge mt-2 <%= user.membershipID.startsWith('CD') ? 'club-member-badge' : '' %>">
            <i class="fas <%= user.membershipID.startsWith('CD') ? 'fa-star' : 'fa-user' %>"></i>
            <span><%= user.membershipID.startsWith('CD') ? 'Club Member' : 'Non-Club Member' %></span>
        </div>
    </div>
    <div class="sidebar-menu">
        <a href="/cds-cooperative/dashboard"><i class="fas fa-home"></i> Dashboard</a>
        <a href="/cds-cooperative/transaction"><i class="fas fa-exchange-alt"></i> Transactions</a>
        <a href="/cds-cooperative/loan" class="active"><i class="fas fa-hand-holding-usd"></i> My Loans</a>
        <a href="/cds-cooperative/guarantorRequest">
            <i class="fas fa-user-friends"></i> Guarantor Requests
            <% if (pendingGuarantorCount > 0) { %>
                <span class="badge bg-danger ms-auto" style="font-size:0.68rem;"><%= pendingGuarantorCount %></span>
            <% } %>
        </a>
        <a href="/manage/kiddies-account"><i class="fas fa-users"></i> Kiddies Account</a>
        <a href="/cds-cooperative/profile"><i class="fas fa-user-circle"></i> My Profile</a>
        <a href="/cds-cooperative/kyc"><i class="fas fa-shield-alt"></i> KYC Verification</a>
        <a href="/cds-cooperative/referral"><i class="fas fa-user-plus"></i> Referral Program</a>
        <a href="/cds-cooperative/memberContract"><i class="fas fa-file-contract"></i> Terms & Conditions</a>
        <a href="/cds-cooperative/report"><i class="fas fa-chart-line"></i> Reports</a>
        <% if (user.role && user.role.name !== 'member') { %>
        <a href="/admin-dashboard"><i class="fas fa-tachometer-alt"></i> Administration</a>
        <% } %>
        <a href="/logout" style="color:rgba(255,255,255,0.52);margin-top:4px;"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
</div>

<!-- Top Navbar -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3"
       style="cursor:pointer;color:var(--primary);font-size:1.5rem;"
       onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
    <div class="flex-grow-1">
        <h6 class="mb-0 fw-bold d-none d-sm-block" style="color:var(--primary);font-size:0.9rem;">
            Welcome back, <%= user.firstName %>! 👋
        </h6>
        <h6 class="mb-0 fw-bold d-sm-none" style="color:var(--primary);font-size:0.85rem;">Hi, <%= user.firstName %>! 👋</h6>
        <small class="text-muted d-none d-md-block" style="font-size:0.73rem;">
            Member ID: <%= user.membershipID %> &nbsp;|&nbsp;
            <%= new Date(user.createdAt).toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) %>
        </small>
    </div>
    <% let sbadgeClass = "bg-secondary bg-opacity-10 text-secondary";
       if (user.status === "active")   sbadgeClass = "bg-success bg-opacity-10 text-success";
       if (user.status === "rejected") sbadgeClass = "bg-danger bg-opacity-10 text-danger"; %>
    <span class="badge <%= sbadgeClass %> ms-2" style="font-size:0.7rem;padding:5px 10px;">
        <%= user.status.charAt(0).toUpperCase() + user.status.slice(1) %>
    </span>
</div>

<!-- Main Content -->
<div class="main-content">

    <!-- Welcome Card -->
    <div class="welcome-card position-relative">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-md-8">
                <h2 class="mb-3 fw-bold">Great to see you again <%= user.firstName %>!</h2>
                <div class="d-flex gap-3 flex-wrap">
                    <div class="member-badge"><i class="fas fa-id-card"></i><span><%= user.membershipID %></span></div>
                    <div class="member-badge">
                        <i class="fas fa-calendar"></i>
                        <span>Member Since: <%= new Date(user.createdAt).toLocaleDateString('en-US',{month:'short',year:'numeric'}) %></span>
                    </div>
                    <div class="member-badge club-member-badge">
                        <i class="fas fa-star"></i>
                        <span><%= interestRate %>% Loan Interest Rate</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <h5 class="opacity-90">Account Status</h5>
                <% let badgeClass = "bg-light text-secondary";
                   if (user.status === "active")   badgeClass = "bg-light text-success";
                   if (user.status === "rejected")  badgeClass = "bg-light text-danger"; %>
                <h3><span class="badge <%= badgeClass %> fs-5 px-4 py-2"><%= user.status.charAt(0).toUpperCase()+user.status.slice(1) %></span></h3>
            </div>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;"><i class="fas fa-wallet"></i></div>
                <p class="text-muted mb-1 fw-semibold">Eligible Loan Amount</p>
                <h3 class="mb-2 fw-bold">₦<%= (user.account.balance * 3).toLocaleString() %></h3>
                <small class="text-success fw-semibold"><i class="fas fa-info-circle me-1"></i>Available</small>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;"><i class="fas fa-hand-holding-usd"></i></div>
                <p class="text-muted mb-1 fw-semibold">Active Loan</p>
                <h3 class="mb-2 fw-bold">₦<%= loan && loan.amount ? loan.amount.toLocaleString() : "0" %></h3>
                <% if (loan) { %>
                    <small class="text-warning fw-semibold"><i class="fas fa-clock me-1"></i>Status: <%= loan.status.toUpperCase() %></small>
                <% } else { %>
                    <small class="text-secondary fw-semibold">No active loan</small>
                <% } %>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#3b82f6,#2563eb);color:white;"><i class="fas fa-calendar-check"></i></div>
                <p class="text-muted mb-1 fw-semibold">Total Payment</p>
                <h3 class="mb-2 fw-bold">
                    <% if (loan && loan.status === "approved") { %>₦<%= loan.totalRepay.toLocaleString() %><% } else { %>₦0<% } %>
                </h3>
                <small style="color:var(--primary);" class="fw-semibold">
                    <i class="fas fa-calendar me-1"></i>
                    <% if (loan && loan.status === "approved" && dueDate) { %>
                        Due <%= new Date(dueDate).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"}) %>
                    <% } else { %>No due date<% } %>
                </small>
            </div>
        </div>
    </div>

    <!-- Loan Section -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold" style="color:var(--primary);"><i class="fas fa-hand-holding-usd me-2"></i>My Loans</h5>
                    <button class="btn btn-primary btn-sm" onclick="openModal('loanRequestModal')">
                        <i class="fas fa-plus me-2"></i>Request New Loan
                    </button>
                </div>
                <div class="card-body">

                    <!-- Loan Rules -->
                    <div class="alert-info-custom mb-4">
                        <h6 class="fw-bold mb-3"><i class="fas fa-info-circle me-2"></i>Loan Rules & Conditions</h6>
                        <ul class="small mb-0 ps-3">
                            <li class="mb-2"><strong>Maximum Loan:</strong> 3x your total savings (Current max: ₦<%= user.account?.balance ? (user.account.balance * 3).toLocaleString() : '0' %>)</li>
                            <li class="mb-2"><strong>Club Members (CDS):</strong> 5% interest rate per annum</li>
                            <li class="mb-2"><strong>Non-Club Members (NCDS):</strong> 10% interest rate per annum</li>
                            <li class="mb-2"><strong>Qualification:</strong> Must have been a member for at least 1 month</li>
                            <li class="mb-2"><strong>Late Payment Penalty:</strong> 0.5% of loan amount per extra day</li>
                            <li class="mb-0"><strong>Rollover:</strong> Pay interest first, then apply before expiration</li>
                        </ul>
                    </div>

                    <!-- Active Loan Card -->
                    <div class="card mb-3" style="border:3px solid #3350b0;border-radius:20px;">
                        <div class="card-body">
                            <% if (loan) { %>
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h5 class="mb-1 fw-bold">Personal Loan</h5>
                                        <small class="text-muted">
                                            Approved: <%= loan.approvedAt ? loan.approvedAt.toLocaleDateString('en-US') : '-' %> |
                                            Expires: <%= loan.dueDate ? loan.dueDate.toLocaleDateString('en-US') : '-' %>
                                        </small>
                                    </div>
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        <%= loan.status.charAt(0).toUpperCase() + loan.status.slice(1) %>
                                    </span>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-3 col-6">
                                        <small class="text-muted d-block">Loan Amount</small>
                                        <h6 class="mb-0 fw-bold">₦<%= loan.amount.toLocaleString() %></h6>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <small class="text-muted d-block">Outstanding</small>
                                        <h6 class="mb-0 fw-bold text-danger">₦<%= loan.totalRepay.toLocaleString() %></h6>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <small class="text-muted d-block">Interest Amount</small>
                                        <h6 class="mb-0 fw-bold">
                                            ₦<%= (loan.amount * (user.account?.accountType?.interestRate || 0) / 100).toLocaleString() %>
                                        </h6>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <small class="text-muted d-block">Interest Rate</small>
                                        <h6 class="mb-0 fw-bold"><%= interestRate %>% p.a.</h6>
                                    </div>
                                </div>

                                <div class="alert-warning-custom mb-3">
                                    <small>
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        <strong>Payment Due in <%= daysUntilDue ?? '-' %> days!</strong>
                                        Avoid <%= loan.duration?.penaltyPercentage ?? 0 %>% daily penalty
                                    </small>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <small class="fw-semibold">Repayment Progress</small>
                                        <small class="fw-bold"><%= loan.repaymentProgress || 0 %>% Paid</small>
                                    </div>
                                    <div class="progress" style="height:12px;">
                                        <div class="progress-bar bg-success" style="width:<%= loan.repaymentProgress || 0 %>%"></div>
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary flex-grow-1" onclick="openModal('paymentModal')">
                                        <i class="fas fa-credit-card me-2"></i>Make Payment
                                    </button>
                                    <button class="btn btn-outline-primary" onclick="openRolloverFlow()">
                                        <i class="fas fa-sync-alt me-2"></i>Rollover
                                    </button>
                                </div>

                            <% } else { %>
                                <div class="text-center py-4">
                                    <h6 class="fw-bold text-muted">No Active Loans</h6>
                                    <p>You currently have no active loans.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Loan Calculator -->
            <div class="card mb-4">
                <div class="card-body">
                    <h6 class="mb-3 fw-bold" style="color:var(--primary);"><i class="fas fa-calculator me-2"></i>Loan Calculator</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Loan Amount (₦)</label>
                        <input type="number" class="form-control" id="calcAmount" placeholder="100000" onchange="calculateLoan()">
                        <small class="text-muted">Max: ₦<%= user.account?.balance ? (user.account.balance * 3).toLocaleString() : '0' %></small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Duration (months)</label>
                        <select class="form-select" id="calcDuration" onchange="calculateLoan()">
                            <% loanSettings.forEach(setting => { %>
                                <% if(setting.status === 'active') { %>
                                    <option value="<%= setting.duration %>"><%= setting.loanName %> — <%= setting.duration %> months</option>
                                <% } %>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Interest Rate (%)</label>
                        <input type="number" class="form-control" id="calcRate" value="<%= user.account.accountType.interestRate %>" readonly>
                        <small id="rateInfo" class="text-success"><i class="fas fa-star me-1"></i><%= user.account.accountType.name %> Rate</small>
                    </div>
                    <div class="alert-info-custom" id="calcResult" style="display:none;">
                        <div class="d-flex justify-content-between mb-2"><small class="fw-semibold">Monthly Payment:</small><strong id="monthlyPay">₦0</strong></div>
                        <div class="d-flex justify-content-between mb-2"><small class="fw-semibold">Total Interest:</small><strong id="totalInt">₦0</strong></div>
                        <div class="d-flex justify-content-between"><small class="fw-semibold">Total Repayment:</small><strong id="totalRep">₦0</strong></div>
                    </div>
                </div>
            </div>

            <!-- Important Notes -->
            <div class="card">
                <div class="card-body">
                    <h6 class="mb-3 fw-bold" style="color:var(--primary);"><i class="fas fa-shield-alt me-2"></i>Important Notes</h6>
                    <div class="loan-rules-list">
                        <ul class="small mb-0 ps-3">
                            <li class="mb-2">3-day reminder before payment due</li>
                            <li class="mb-2">Pay interest first before rollover request</li>
                            <li class="mb-2">Rollover adds a fee on outstanding balance</li>
                            <li class="mb-0">Two guarantors required for approval</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="powered-by">
    <strong style="color:var(--primary);">Cloudbaam</strong> Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong>
</div>


<!-- ═══════════════════════════════════════════════════════════════════════════
     LOAN REQUEST MODAL
═══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="loanRequestModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius:20px;">
            <div class="modal-header" style="border-radius:20px 20px 0 0;">
                <h5 class="modal-title fw-bold"><i class="fas fa-file-invoice-dollar me-2" style="color:var(--primary);"></i>Apply for Loan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert-warning-custom mb-4">
                    <small><i class="fas fa-exclamation-triangle me-2"></i><strong>Requirements:</strong> Two guarantors required for loan approval.</small>
                </div>

                <%
                    const now2 = new Date();
                    const joinDate = new Date(user.createdAt);
                    const isEligibleForLoan = (unit, value) => {
                        if (unit === "daily") return true;
                        let elapsed;
                        switch(unit) {
                            case "weeks":  elapsed = Math.floor((now2 - joinDate) / (1000*60*60*24*7)); break;
                            case "months": elapsed = (now2.getFullYear() - joinDate.getFullYear()) * 12 + (now2.getMonth() - joinDate.getMonth()); break;
                            default:       elapsed = 0;
                        }
                        return elapsed >= value;
                    };
                    const eligibleLoan = loanSettings.find(ls => ls.status === "active" && isEligibleForLoan(ls.eligibilityUnit, ls.eligibilityValue));
                    const isEligible = !!eligibleLoan;
                    const canApply = isEligible && !loan;
                %>

                <% if (loan) { %>
                    <div class="alert alert-danger mb-3">
                        <i class="fas fa-ban me-2"></i>You already have an active or pending loan. Clear it before applying for a new one.
                    </div>
                <% } %>
                <% if (!isEligible && !loan) { %>
                    <div class="alert alert-danger mb-3">You are not yet eligible to apply for a loan.</div>
                <% } %>

                <form id="loanForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Loan Amount (₦)</label>
                            <input type="number" class="form-control" name="amount" max="<%= user.account.balance * 3 %>" placeholder="Enter amount" required <%= !canApply ? "disabled" : "" %>>
                            <small class="text-muted">Max: ₦<%= (user.account.balance * 3).toLocaleString() %></small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Repayment Period</label>
                            <select class="form-select" name="duration" required <%= !canApply ? "disabled" : "" %>>
                                <% loanSettings.forEach(setting => { %>
                                    <% if (setting.status === "active") { %>
                                        <option value="<%= setting._id %>" <%= !isEligibleForLoan(setting.eligibilityUnit, setting.eligibilityValue) ? "disabled" : "" %>>
                                            <%= setting.loanName %><% if(!isEligibleForLoan(setting.eligibilityUnit, setting.eligibilityValue)){%> (Not yet eligible)<%}%>
                                        </option>
                                    <% } %>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Guarantor 1</label>
                            <select id="guarantor1" class="form-select guarantorSelect" name="guarantor1" required <%= !canApply ? "disabled" : "" %>>
                                <option value="">Select guarantor...</option>
                                <% users.forEach(u => { if(u._id.toString() !== user._id.toString()){ %><option value="<%= u._id %>"><%= u.firstName %> — <%= u.phone %></option><% }}) %>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Guarantor 2</label>
                            <select id="guarantor2" class="form-select guarantorSelect" name="guarantor2" required <%= !canApply ? "disabled" : "" %>>
                                <option value="">Select guarantor...</option>
                                <% users.forEach(u => { if(u._id.toString() !== user._id.toString()){ %><option value="<%= u._id %>"><%= u.firstName %> — <%= u.phone %></option><% }}) %>
                            </select>
                        </div>
                    </div>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" name="agreeTerms" id="agreeTerms" required <%= !canApply ? "disabled" : "" %>>
                        <label class="form-check-label" for="agreeTerms">
                            I agree to the loan terms: <%= user.account.accountType.name %> account — <%= user.account.accountType.interestRate %>% interest rate.
                        </label>
                    </div>
                    <div class="modal-footer mt-4">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" <%= !canApply ? "disabled" : "" %>>Submit Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- ═══════════════════════════════════════════════════════════════════════════
     PAYMENT MODAL
═══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:20px;">
