<div class="modal fade" id="messageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:18px;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="messageModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="messageModalIcon" class="mb-3"></div>
                <p id="messageModalText" class="mb-0"></p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Okay</button>
            </div>
        </div>
    </div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>

// ── Loader ────────────────────────────────────────────────────────────────────
window.addEventListener("load", () => {
    const loader = document.getElementById("loader-screen");
    setTimeout(() => {
        loader.style.opacity = "0";
        loader.style.transition = "opacity 0.6s ease";
        setTimeout(() => { loader.style.display = "none"; }, 600);
    }, 400);
});

// ── Sidebar close on mobile ───────────────────────────────────────────────────
document.addEventListener('click', function(event) {
    const sidebar = document.getElementById('sidebar');
    if (window.innerWidth <= 992 && sidebar.classList.contains('active') &&
        !sidebar.contains(event.target) && !event.target.closest('.fa-bars')) {
        sidebar.classList.remove('active');
    }
});

// ── Generic helpers ───────────────────────────────────────────────────────────
function openModal(modalId) {
    new bootstrap.Modal(document.getElementById(modalId)).show();
}

function showMessageModal({ title, message, type = "info" }) {
    const icons = {
        success: `<i class="fas fa-check-circle fa-3x text-success"></i>`,
        error:   `<i class="fas fa-times-circle fa-3x text-danger"></i>`,
        warning: `<i class="fas fa-exclamation-triangle fa-3x text-warning"></i>`,
        info:    `<i class="fas fa-info-circle fa-3x text-primary"></i>`
    };
    document.getElementById("messageModalTitle").innerText  = title;
    document.getElementById("messageModalText").innerText   = message;
    document.getElementById("messageModalIcon").innerHTML   = icons[type] || icons.info;
    new bootstrap.Modal(document.getElementById("messageModal")).show();
}

// Safely switch from one open modal to another without backdrop stacking
function switchModal(fromId, openFn) {
    const fromEl = document.getElementById(fromId);
    const inst   = bootstrap.Modal.getInstance(fromEl);
    if (inst) {
        fromEl.addEventListener('hidden.bs.modal', function handler() {
            fromEl.removeEventListener('hidden.bs.modal', handler);
            openFn();
        });
        inst.hide();
    } else {
        openFn();
    }
}

// ── Loan calculator ───────────────────────────────────────────────────────────
function calculateLoan() {
    const amount   = parseFloat(document.getElementById('calcAmount').value)   || 0;
    const duration = parseInt(document.getElementById('calcDuration').value)   || 1;
    const rate     = parseFloat(document.getElementById('calcRate').value)     || 0;
    const maxLoan  = parseFloat("<%= user.account.balance %>") * 3;
    if (amount > maxLoan) { alert(`Max eligible: ₦${maxLoan.toLocaleString()}`); document.getElementById('calcAmount').value = maxLoan; return; }
    if (amount <= 0) return;
    const interest = amount * (rate / 100) * duration;
    const total    = amount + interest;
    const monthly  = total / duration;
    document.getElementById('calcResult').style.display = 'block';
    document.getElementById('monthlyPay').textContent = '₦' + monthly.toLocaleString('en-NG',{minimumFractionDigits:2});
    document.getElementById('totalInt').textContent   = '₦' + interest.toLocaleString('en-NG',{minimumFractionDigits:2});
    document.getElementById('totalRep').textContent   = '₦' + total.toLocaleString('en-NG',{minimumFractionDigits:2});
}

// ── Guarantor duplicate prevention ───────────────────────────────────────────
document.querySelectorAll('.guarantorSelect').forEach(select => {
    select.addEventListener('change', function() {
        const g1 = document.getElementById('guarantor1').value;
        const g2 = document.getElementById('guarantor2').value;
        if (g1 && g2 && g1 === g2) {
            this.value = "";
            showMessageModal({ title: "Invalid Selection", message: "You cannot select the same guarantor twice.", type: "warning" });
        }
    });
});

// ── Loan application form ─────────────────────────────────────────────────────
document.getElementById("loanForm").addEventListener("submit", async function(e) {
    e.preventDefault();
    const submitBtn = this.querySelector("button[type='submit']");
    submitBtn.disabled = true;
    submitBtn.innerText = "Submitting...";

    const g1 = document.getElementById("guarantor1").value;
    const g2 = document.getElementById("guarantor2").value;

    if (g1 === g2) {
        showMessageModal({ title: "Invalid Guarantors", message: "You cannot select the same guarantor twice.", type: "warning" });
        submitBtn.disabled = false; submitBtn.innerText = "Submit Application"; return;
    }
    if (!document.getElementById("agreeTerms").checked) {
        showMessageModal({ title: "Agreement Required", message: "You must agree to the loan terms.", type: "warning" });
        submitBtn.disabled = false; submitBtn.innerText = "Submit Application"; return;
    }

    try {
        const res    = await fetch("/club-de-star-cooperative/apply-loan", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ amount: this.amount.value, duration: this.duration.value, guarantor1: g1, guarantor2: g2, agreeTerms: true })
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.message || "Submission failed.");
        bootstrap.Modal.getInstance(document.getElementById("loanRequestModal"))?.hide();
        setTimeout(() => new bootstrap.Modal(document.getElementById("loanSuccessModal")).show(), 400);
        this.reset();
    } catch (err) {
        showMessageModal({ title: "Submission Failed", message: err.message, type: "error" });
    } finally {
        submitBtn.disabled = false; submitBtn.innerText = "Submit Application";
    }
});

// ── Loan payment form ─────────────────────────────────────────────────────────
document.getElementById("loanPaymentForm").addEventListener("submit", async function(e) {
    e.preventDefault();
    const amount = parseFloat(document.getElementById("paymentAmount").value);
    const loanId = this.querySelector('input[name="loanId"]').value;
    if (!amount || amount <= 0) { alert("Please enter a valid payment amount."); return; }

    const btn = this.querySelector("button[type='submit']");
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';

    try {
        const res    = await fetch("/loan/payment", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ amount, loanId })
        });
        const result = await res.json();
        if (result.status && result.authorization_url) {
            window.location.href = result.authorization_url;
        } else if (result.status) {
            alert("Payment successful!"); location.reload();
        } else {
            alert(result.message || "Failed to process payment.");
            btn.disabled = false; btn.innerHTML = "Make Payment";
        }
    } catch (err) {
        alert("Unable to process payment. Please try again.");
        btn.disabled = false; btn.innerHTML = "Make Payment";
    }
});


// ═════════════════════════════════════════════════════════════════════════════
// ROLLOVER FLOW
// ═════════════════════════════════════════════════════════════════════════════

let rolloverState = null;

// Entry point — triggered by the Rollover button
async function openRolloverFlow() {
    const btn = document.querySelector('[onclick="openRolloverFlow()"]');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Checking...'; }

    try {
        const res  = await fetch('/club-de-star-cooperative/rollover-status');
        const data = await res.json();

        if (!res.ok) {
            showMessageModal({ title: 'Rollover Unavailable', message: data.message || 'No active loan found.', type: 'error' });
            return;
        }

        rolloverState = data;

        if (data.interestPaid) {
            openRolloverConfirmModal(data);
        } else {
            openRolloverInterestModal(data);
        }
    } catch (err) {
        showMessageModal({ title: 'Error', message: 'Could not check rollover status. Please try again.', type: 'error' });
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-sync-alt me-2"></i>Rollover'; }
    }
}

// Re-check status after submitting interest payment
async function checkRolloverStatus() {
    try {
        const res  = await fetch('/club-de-star-cooperative/rollover-status');
        const data = await res.json();
        if (!res.ok) return;
        rolloverState = data;
        if (data.interestPaid) {
            switchModal('rolloverInterestModal', () => openRolloverConfirmModal(data));
        } else {
            showMessageModal({ title: 'Still Pending', message: 'Your interest payment is awaiting admin approval. Please check back shortly.', type: 'warning' });
        }
    } catch (err) {
        showMessageModal({ title: 'Error', message: 'Could not check status.', type: 'error' });
    }
}

// Open Modal 1 — interest not paid
function openRolloverInterestModal(data) {
    document.getElementById('ri_interestOwed').textContent  = '₦' + Number(data.interestOwed).toLocaleString();
    document.getElementById('ri_bankName').textContent      = data.companyAccount?.bankName      || '—';
    document.getElementById('ri_accountNumber').textContent = data.companyAccount?.accountNumber || '—';
    document.getElementById('ri_accountName').textContent   = data.companyAccount?.accountName   || '—';
    document.getElementById('ri_amount').value              = data.interestOwed || '';
    // Reset state
    document.getElementById('ri_error').classList.add('d-none');
    document.getElementById('ri_pendingNotice').classList.add('d-none');
    document.getElementById('ri_form').classList.remove('d-none');
    document.getElementById('ri_footer').classList.remove('d-none');
    new bootstrap.Modal(document.getElementById('rolloverInterestModal')).show();
}

// CHANGED: Open Modal 2 — populate read-only duration label (no dropdown)
// The backend returns data.loanName from the existing loan's duration setting.
function openRolloverConfirmModal(data) {
    document.getElementById('rc_outstanding').textContent  = '₦' + Number(data.outstandingBalance).toLocaleString();
    document.getElementById('rc_rolloverPct').textContent  = data.rolloverPct;
    document.getElementById('rc_rolloverFee').textContent  = '₦' + Number(data.rolloverFee).toLocaleString();
    document.getElementById('rc_newTotal').textContent     = '₦' + Number(data.newTotalRepay).toLocaleString();
    // Display the locked loan type name — user cannot change it
    document.getElementById('rc_durationLabel').textContent = data.loanName || 'Same as current loan';
    document.getElementById('rc_error').classList.add('d-none');
    new bootstrap.Modal(document.getElementById('rolloverConfirmModal')).show();
}

// Submit interest payment proof
async function submitInterestPayment() {
    const btn       = document.getElementById('ri_submitBtn');
    const errDiv    = document.getElementById('ri_error');
    const errMsg    = document.getElementById('ri_errorMsg');
    const amount    = parseFloat(document.getElementById('ri_amount').value);
    const payerName = document.getElementById('ri_payerName').value.trim();

    errDiv.classList.add('d-none');

    if (!amount || amount <= 0) {
        errMsg.textContent = 'Please enter the amount you transferred.';
        errDiv.classList.remove('d-none');
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';

    try {
        const res  = await fetch('/club-de-star-cooperative/rollover-interest-payment', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ loanId: rolloverState.loanId, amount, payerName })
        });
        const data = await res.json();

        if (res.ok && data.status) {
            // Hide form, show pending notice
            document.getElementById('ri_form').classList.add('d-none');
            document.getElementById('ri_footer').classList.add('d-none');
            document.getElementById('ri_pendingNotice').classList.remove('d-none');
        } else {
            errMsg.textContent = data.message || 'Failed to submit. Please try again.';
            errDiv.classList.remove('d-none');
        }
    } catch (err) {
        errMsg.textContent = 'Network error. Please try again.';
        errDiv.classList.remove('d-none');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Submit Payment Proof';
    }
}

// CHANGED: submitRollover — no duration sent; backend reuses old loan's duration setting
async function submitRollover() {
    const btn      = document.getElementById('rc_submitBtn');
    const errDiv   = document.getElementById('rc_error');
    const errMsg   = document.getElementById('rc_errorMsg');

    errDiv.classList.add('d-none');

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';

    try {
        const res  = await fetch('/club-de-star-cooperative/rollover-loan', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({})  // duration is locked server-side to the old loan's type
        });
        const data = await res.json();

        if (res.ok) {
            document.getElementById('rs_newTotal').textContent    = '₦' + Number(data.newTotalRepay).toLocaleString();
            document.getElementById('rs_rolloverFee').textContent = '₦' + Number(data.rolloverFee).toLocaleString();
            switchModal('rolloverConfirmModal', () => {
                new bootstrap.Modal(document.getElementById('rolloverSuccessModal')).show();
            });
        } else if (data.code === 'INTEREST_UNPAID') {
            // Interest not yet approved — go back to interest modal
            rolloverState = { ...rolloverState, ...data };
            switchModal('rolloverConfirmModal', () => openRolloverInterestModal(rolloverState));
        } else {
            errMsg.textContent = data.message || 'Rollover failed. Please try again.';
            errDiv.classList.remove('d-none');
        }
    } catch (err) {
        errMsg.textContent = 'Network error. Please try again.';
        errDiv.classList.remove('d-none');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-sync-alt me-2"></i>Submit Rollover Request';
    }
}

// Card entrance animation
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.stat-card, .card').forEach((card, i) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        setTimeout(() => { card.style.opacity = '1'; card.style.transform = 'translateY(0)'; }, i * 100);
    });
});
</script>
</body>
</html>
