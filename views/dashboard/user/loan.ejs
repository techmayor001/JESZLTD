                               value="<%= loan ? Math.ceil(loan.totalRepay / 12) : 0 %>"
                               min="<%= loan ? Math.ceil(loan.totalRepay / 12) : 0 %>"
                               max="<%= loan ? loan.totalRepay : 0 %>" required>
                        <small class="text-muted">Minimum payment: ₦<%= loan ? Math.ceil(loan.totalRepay / 12).toLocaleString() : '0' %></small>
                    </div>
                    <input type="hidden" name="loanId" value="<%= loan ? loan._id : '' %>">
                    <input type="hidden" name="dueDate" value="<%= dueDate ? dueDate.toISOString() : '' %>">
                    <div class="alert-warning-custom">
                        <small>
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Due <%= dueDate ? dueDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : 'N/A' %></strong>
