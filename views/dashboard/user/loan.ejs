<!-- ════ SCRIPTS ════ -->
<script>
/* ── Theme ── */
(function(){
  const saved = localStorage.getItem('cds-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  updateThemeUI(saved);
})();
function toggleTheme(){
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('cds-theme', next);
  updateThemeUI(next);
}
function updateThemeUI(t){
  const i = document.getElementById('togIcon');
  if(i) i.className = t === 'dark' ? 'fas fa-moon' : 'fas fa-sun';
}

/* ── Sidebar ── */
function toggleSidebar(){
  const open = document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sbOverlay').classList.toggle('show', open);
  document.body.style.overflow = open ? 'hidden' : '';
}
function closeSidebar(){
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sbOverlay').classList.remove('show');
  document.body.style.overflow = '';
}
document.addEventListener('click', e => {
  const sb = document.getElementById('sidebar');
  const hb = document.querySelector('.hamburger');
  if(window.innerWidth <= 900 && sb.classList.contains('open') && !sb.contains(e.target) && !hb.contains(e.target)) closeSidebar();
});

/* ── Modals ── */
function openModal(id){ document.getElementById(id).classList.add('open'); document.body.style.overflow = 'hidden'; }
function closeModal(id){ document.getElementById(id).classList.remove('open'); document.body.style.overflow = ''; }
document.querySelectorAll('.modal-backdrop').forEach(el => {
  el.addEventListener('click', e => { if(e.target === el){ el.classList.remove('open'); document.body.style.overflow = ''; }});
});
function showError(title, msg){
  document.getElementById('errorModalTitle').textContent = title;
  document.getElementById('errorModalMsg').textContent   = msg;
  openModal('errorModal');
}

/* ── Max loan constant (server-rendered, single source of truth) ── */
const MAX_LOAN = <%- maxLoan %>;

/* ── Loan amount enforcement ── */
function enforceLoanMax(input){
  const hint = document.getElementById('loanAmountHint');
  const val  = parseFloat(input.value);

  if(val > MAX_LOAN){
    input.value = MAX_LOAN;
    input.classList.add('input-error');
    hint.textContent = '⚠ Capped at ₦' + MAX_LOAN.toLocaleString() + ' — max is 3× your savings balance';
    hint.classList.add('hint-error');
    setTimeout(() => {
      input.classList.remove('input-error');
      hint.textContent = 'Max: ₦' + MAX_LOAN.toLocaleString() + ' · 3× your savings balance';
      hint.classList.remove('hint-error');
    }, 2500);
  } else if(val <= 0 || isNaN(val)){
    input.classList.remove('input-error');
    hint.textContent = 'Max: ₦' + MAX_LOAN.toLocaleString() + ' · 3× your savings balance';
    hint.classList.remove('hint-error');
  } else {
    input.classList.remove('input-error');
    hint.textContent = 'Max: ₦' + MAX_LOAN.toLocaleString() + ' · 3× your savings balance';
    hint.classList.remove('hint-error');
  }
}

/* ── Calculator ── */
function calculateLoan(){
  const amount   = parseFloat(document.getElementById('calcAmount').value) || 0;
  const duration = parseInt(document.getElementById('calcDuration').value) || 1;
  const rate     = parseFloat(document.getElementById('calcRate').value) || 0;
  const res      = document.getElementById('calcResult');

  if(amount <= 0){ res.style.display = 'none'; return; }
  if(amount > MAX_LOAN){ document.getElementById('calcAmount').value = MAX_LOAN; return calculateLoan(); }

  const interest = amount * (rate / 100);          // flat: 5% of 5000 = 250
  const total    = amount + interest;               // 5000 + 250 = 5250
  const monthly  = total / duration;               // spread over months

  res.style.display = 'block';
  document.getElementById('monthlyPay').textContent = '₦' + monthly.toLocaleString('en-NG',{minimumFractionDigits:2,maximumFractionDigits:2});
  document.getElementById('totalInt').textContent   = '₦' + interest.toLocaleString('en-NG',{minimumFractionDigits:2,maximumFractionDigits:2});
  document.getElementById('totalRep').textContent   = '₦' + total.toLocaleString('en-NG',{minimumFractionDigits:2,maximumFractionDigits:2});
}

/* ── Guarantor duplicate check ── */
document.querySelectorAll('.guarantorSelect').forEach(sel => {
  sel.addEventListener('change', () => {
    const g1 = document.getElementById('guarantor1').value;
    const g2 = document.getElementById('guarantor2').value;
    if(g1 && g2 && g1 === g2){ sel.value = ''; showError('Invalid Selection','You cannot select the same guarantor twice.'); }
  });
});

/* ── Loan application ── */
async function submitLoanApplication(){
  const form = document.getElementById('loanForm');
  const btn  = document.getElementById('loanSubmitBtn');
  const g1   = document.getElementById('guarantor1').value;
  const g2   = document.getElementById('guarantor2').value;

  if(!document.getElementById('agreeTerms').checked){
    showError('Agreement Required','You must agree to the loan terms.');
    return;
  }
  if(g1 === g2){
    showError('Invalid Guarantors','You cannot select the same guarantor twice.');
    return;
  }

  /* ── Max loan enforcement before submit ── */
  const requestedAmount = parseFloat(form.amount.value);
  if(!requestedAmount || requestedAmount <= 0){
    showError('Invalid Amount','Please enter a loan amount greater than ₦0.');
    return;
  }
  if(requestedAmount > MAX_LOAN){
    /* Clamp the field and show error */
    document.getElementById('loanAmountInput').value = MAX_LOAN;
    enforceLoanMax(document.getElementById('loanAmountInput'));
    showError(
      'Amount Exceeds Limit',
      'Your loan cannot exceed ₦' + MAX_LOAN.toLocaleString() +
      ', which is 3× your current savings balance of ₦' +
      (MAX_LOAN / 3).toLocaleString() + '.'
    );
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Submitting…';

  try{
    const res    = await fetch('/club-de-star-cooperative/apply-loan',{
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        amount:    requestedAmount,
        duration:  form.duration.value,
        guarantor1: g1,
        guarantor2: g2,
        agreeTerms: true
      })
    });
    const result = await res.json();
    if(!res.ok) throw new Error(result.message || 'Submission failed.');
    closeModal('loanRequestModal');
    setTimeout(() => openModal('loanSuccessModal'), 300);
    form.reset();
  } catch(e){
    showError('Submission Failed', e.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-paper-plane" style="margin-right:5px;font-size:11px;"></i>Submit Application';
  }
}

/* ── Loan payment ── */
async function submitLoanPayment(){
  const amount = parseFloat(document.getElementById('paymentAmount').value);
  const loanId = document.querySelector('#loanPaymentForm input[name="loanId"]').value;
  if(!amount || amount <= 0){ showError('Invalid Amount','Enter a valid payment amount.'); return; }
  try{
    const res    = await fetch('/loan/payment',{ method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ amount, loanId })});
    const result = await res.json();
    if(result.authorization_url){ window.location.href = result.authorization_url; return; }
    if(result.status){ closeModal('paymentModal'); setTimeout(() => location.reload(), 1500); }
    else throw new Error(result.message || 'Payment failed.');
  } catch(e){ showError('Payment Failed', e.message); }
}

/* ══════════════════════════════════
   PRINT LOAN OFFER LETTER
══════════════════════════════════ */
function printLoanOffer(){
  const loanData = <%- loan ? JSON.stringify({
    amount:         loan.amount || 0,
    interestRate:   loan.interestRate || 0,
    interestAmount: loan.interestAmount || 0,
    totalRepay:     loan.totalRepay || 0,
    durationMonths: loan.duration ? loan.duration.duration : (loan.externalDuration || 0),
    status:         loan.status || '',
    createdAt:      loan.createdAt || null,
    disbursementDate: loan.disbursementDate || null,
    dueDate:        loan.dueDate || null,
    guarantors: (loan.guarantors || []).map(g => ({
      name: g.guarantor ? `${g.guarantor.firstName} ${g.guarantor.lastName}` : 'N/A',
      membershipID: g.guarantor ? g.guarantor.membershipID : '',
      status: g.status || 'pending'
    }))
  }) : 'null' %>;

  if(!loanData){ showError('No Active Loan','You have no active loan to print an offer letter for.'); return; }

  const userSignature = <%- JSON.stringify(user.signature || '') %>;
  const userFullName  = <%- JSON.stringify(user.firstName + ' ' + user.lastName) %>;
  const userMembershipID = <%- JSON.stringify(user.membershipID || '') %>;
  const userIdNumber  = <%- JSON.stringify(user.idNumber || '') %>;
  const userAddress   = <%- JSON.stringify(user.address || '') %>;
  const userPhone      = <%- JSON.stringify(user.phone || '') %>;
  const userEmail      = <%- JSON.stringify(user.email || '') %>;

  const fmtMoney = n => '₦' + Number(n || 0).toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fmtDate  = d => d ? new Date(d).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) : '—';
  const today    = new Date().toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' });

  const guarantorRows = loanData.guarantors.length
    ? loanData.guarantors.map((g,i) => `
        <tr>
          <td style="padding:6px 10px;border-bottom:1px solid #e2e8f0;">${i+1}</td>
          <td style="padding:6px 10px;border-bottom:1px solid #e2e8f0;">${g.name}</td>
          <td style="padding:6px 10px;border-bottom:1px solid #e2e8f0;">${g.membershipID || 'N/A'}</td>
          <td style="padding:6px 10px;border-bottom:1px solid #e2e8f0;text-transform:capitalize;">${g.status}</td>
        </tr>`).join('')
    : `<tr><td colspan="4" style="padding:8px 10px;color:#94a3b8;">No guarantors on record.</td></tr>`;

  const signatureBlock = userSignature
    ? `<img src="${userSignature}" alt="Signature" style="height:60px;max-width:220px;object-fit:contain;border-bottom:1px solid #1e293b;padding-bottom:4px;">`
    : `<div style="height:60px;display:flex;align-items:flex-end;color:#94a3b8;font-size:12px;border-bottom:1px solid #1e293b;padding-bottom:4px;">Signature on file</div>`;

  const html = `<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Loan Offer Letter — ${userFullName}</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:Georgia,'Times New Roman',serif;color:#1e293b;background:#fff;line-height:1.6;padding:40px 50px;}
.letterhead{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #1e3a8a;padding-bottom:16px;margin-bottom:28px;}
.letterhead h1{font-size:20px;color:#1e3a8a;font-weight:800;letter-spacing:.02em;}
.letterhead p{font-size:11px;color:#64748b;margin-top:2px;}
.letterhead .ref{text-align:right;font-size:11px;color:#64748b;}
h2{font-size:15px;color:#1e3a8a;margin-bottom:14px;text-transform:uppercase;letter-spacing:.04em;}
.section{margin-bottom:22px;}
.kv{display:grid;grid-template-columns:180px 1fr;gap:6px 12px;font-size:13px;margin-bottom:10px;}
.kv strong{color:#475569;font-weight:600;}
table{width:100%;border-collapse:collapse;font-size:12px;margin-top:8px;}
thead th{background:#f1f5f9;text-align:left;padding:6px 10px;font-size:11px;text-transform:uppercase;color:#475569;}
.terms{font-size:12.5px;color:#334155;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:14px 16px;margin-top:10px;}
.terms li{margin-bottom:6px;}
.sign-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:50px;}
.sign-box{font-size:12px;}
.sign-box .label{margin-top:6px;color:#475569;}
.footer-note{margin-top:40px;font-size:10.5px;color:#94a3b8;text-align:center;border-top:1px solid #e2e8f0;padding-top:12px;}
@media print{ @page{margin:14mm;} .no-print{display:none;} }
</style></head><body>

<div class="letterhead">
  <div>
    <h1>Club De Stars Cooperative</h1>
    <p>Loan Offer Letter &nbsp;·&nbsp; Powered by JESZ LIMITED</p>
  </div>
  <div class="ref">
    Date Issued: ${today}<br>
    Member ID: ${userMembershipID}
  </div>
</div>

<div class="section">
  <h2>Borrower Information</h2>
  <div class="kv">
    <strong>Full Name</strong><span>${userFullName}</span>
    <strong>Membership ID</strong><span>${userMembershipID}</span>
    <strong>Email</strong><span>${userEmail || 'N/A'}</span>
    <strong>Phone</strong><span>${userPhone || 'N/A'}</span>
    <strong>Address</strong><span>${userAddress || 'N/A'}</span>
    <strong>ID Number</strong><span>${userIdNumber || 'N/A'}</span>
  </div>
</div>

<div class="section">
  <h2>Loan Terms</h2>
  <div class="kv">
    <strong>Loan Amount</strong><span>${fmtMoney(loanData.amount)}</span>
    <strong>Interest Rate</strong><span>${loanData.interestRate}%</span>
    <strong>Interest Amount</strong><span>${fmtMoney(loanData.interestAmount)}</span>
    <strong>Total Repayable</strong><span><strong>${fmtMoney(loanData.totalRepay)}</strong></span>
    <strong>Duration</strong><span>${loanData.durationMonths} months</span>
    <strong>Application Date</strong><span>${fmtDate(loanData.createdAt)}</span>
    <strong>Disbursement Date</strong><span>${fmtDate(loanData.disbursementDate)}</span>
    <strong>Repayment Due Date</strong><span>${fmtDate(loanData.dueDate)}</span>
    <strong>Status</strong><span style="text-transform:uppercase;">${loanData.status.replace('_',' ')}</span>
  </div>

  <div class="terms">
    <strong>Key Conditions:</strong>
    <ul>
      <li>Repayment of the total amount above (${fmtMoney(loanData.totalRepay)}) is due in full by ${fmtDate(loanData.dueDate)}.</li>
      <li>Late repayment attracts a daily penalty as defined in the cooperative's loan policy.</li>
      <li>Rollover is available subject to admin approval and payment of accrued interest at the time of request.</li>
      <li>This loan is guaranteed by the member(s) listed below, who accepted responsibility at the time of application.</li>
    </ul>
  </div>
</div>

<div class="section">
  <h2>Guarantors</h2>
  <table>
    <thead><tr><th>#</th><th>Name</th><th>Membership ID</th><th>Status</th></tr></thead>
    <tbody>${guarantorRows}</tbody>
  </table>
</div>

<div class="sign-grid">
  <div class="sign-box">
    ${signatureBlock}
    <div class="label">${userFullName}<br>Borrower</div>
  </div>
  <div class="sign-box">
    <div style="height:60px;border-bottom:1px solid #1e293b;"></div>
    <div class="label">Authorized Signatory<br>Club De Stars Cooperative</div>
  </div>
</div>

<div class="footer-note">
  This document was generated electronically from the borrower's account dashboard and reflects loan terms on file as of ${today}.<br>
  Club De Stars Cooperative &nbsp;·&nbsp; Powered by JESZ LIMITED
</div>

<div style="text-align:center;padding:24px;" class="no-print">
  <button onclick="window.print()" style="padding:10px 28px;background:#1e3a8a;color:white;border:none;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;margin-right:8px;">🖨 Print / Save as PDF</button>
  <button onclick="window.close()" style="padding:10px 20px;background:#f1f5f9;color:#374151;border:1px solid #e2e8f0;border-radius:8px;font-weight:600;font-size:14px;cursor:pointer;">Close</button>
</div>
</body></html>`;

  const win = window.open('', '_blank', 'width=900,height=950');
  win.document.write(html);
  win.document.close();
  win.focus();
}

/* ══════════════════════════════════
   ROLLOVER FLOW
══════════════════════════════════ */
let rolloverState = null;
const ROLLOVER_BLOCKED = <%- user.rolloverBlocked ? 'true' : 'false' %>;

async function openRolloverFlow(){
  if(ROLLOVER_BLOCKED){
    showError(
      'Rollover Blocked',
      'Rollover has been disabled on your account. Please settle your loan in full or contact admin to resolve this.'
    );
    return;
  }

  const btn = document.querySelector('[onclick="openRolloverFlow()"]');
  if(btn){ btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right:6px;font-size:11px;"></i>Loading…'; }
  try{
    const res  = await fetch('/club-de-star-cooperative/rollover-status');
    const data = await res.json();
    if(!res.ok){ showError('Rollover Unavailable', data.message || 'No active loan found.'); return; }

    if(data.rolloverPending){
      showError('Already Submitted', 'A rollover request is already pending admin approval.');
      return;
    }

    rolloverState = data;
    populateRolloverModal(data);
    openModal('rolloverModal');
  } catch(e){
    showError('Error','Could not load rollover info. Please try again.');
  } finally {
    if(btn){ btn.disabled = false; btn.innerHTML = '<i class="fas fa-sync-alt" style="margin-right:6px;font-size:11px;"></i>Rollover'; }
  }
}

function populateRolloverModal(data){
  const principal       = Number(data.principalAmount    || 0);
  const interest        = Number(data.interestOwed       || 0);
  const penalty         = Number(data.totalPenalty       || 0);
  const outstanding     = Number(data.outstandingBalance || 0);
  const rolloverPct     = Number(data.rolloverPct        || 0);
  const memberInterest  = Number(data.memberInterestRate || 0);
  const newInterestRate = Number(data.newInterestRate    || 0);

  document.getElementById('rv_hiddenLoanId').value          = data.loanId;
  document.getElementById('rv_hiddenInterest').value        = interest;
  document.getElementById('rv_hiddenPenalty').value         = penalty;
  document.getElementById('rv_hiddenRolloverPct').value     = rolloverPct;
  document.getElementById('rv_hiddenPrincipal').value       = principal;
  document.getElementById('rv_hiddenMemberRate').value      = memberInterest;
  document.getElementById('rv_hiddenNewInterestRate').value = newInterestRate;

  document.getElementById('rv_principalAmt').textContent    = '₦' + principal.toLocaleString();
  document.getElementById('rv_interestAmt').textContent     = '₦' + interest.toLocaleString();
  document.getElementById('rv_outstandingAmt').textContent  = '₦' + outstanding.toLocaleString();
  document.getElementById('rv_rolloverPctLabel').textContent = newInterestRate;

  document.getElementById('rv_currentRateDisplay').textContent  = memberInterest + '%';
  document.getElementById('rv_rolloverRateDisplay').textContent = '+' + rolloverPct + '%';
  document.getElementById('rv_newRateDisplay').textContent      = newInterestRate + '%';

  const hasPenalty = penalty > 0;
  document.getElementById('rv_penaltyBreakRow').style.display   = hasPenalty ? 'flex' : 'none';
  document.getElementById('rv_penaltyBreakAmt').textContent     = '₦' + penalty.toLocaleString();
  document.getElementById('rv_penaltyOptionWrap').style.display = hasPenalty ? 'block' : 'none';
  document.getElementById('rv_penaltyCheckAmt').textContent     = '₦' + penalty.toLocaleString();
  document.getElementById('rv_payPenalty').checked              = false;

  selectRolloverMethod(null);
  document.getElementById('rv_payerName').value           = '';
  document.getElementById('rv_error').style.display       = 'none';
  document.getElementById('rv_summaryWrap').style.display = 'none';
  document.getElementById('rv_submitBtn').disabled        = true;
}

function selectRolloverMethod(method){
  document.getElementById('rv_selectedMethod').value = method || '';
  document.getElementById('rv_methodManual').classList.toggle('selected', method === 'manual');
  document.getElementById('rv_methodPaystack').classList.toggle('selected', method === 'paystack');
  document.getElementById('rv_manualSection').style.display = method === 'manual' ? 'block' : 'none';
  document.getElementById('rv_submitBtn').disabled = !method;
  if(method){
    document.getElementById('rv_summaryWrap').style.display = 'block';
    updateRolloverSummary();
  }
}

function updateRolloverSummary(){
  const interest        = parseFloat(document.getElementById('rv_hiddenInterest').value)        || 0;
  const penalty         = parseFloat(document.getElementById('rv_hiddenPenalty').value)         || 0;
  const rolloverPct     = parseFloat(document.getElementById('rv_hiddenRolloverPct').value)     || 0;
  const principal       = parseFloat(document.getElementById('rv_hiddenPrincipal').value)       || 0;
  const newInterestRate = parseFloat(document.getElementById('rv_hiddenNewInterestRate').value) || 0;
  const payPenalty      = document.getElementById('rv_payPenalty').checked;

  const totalToPay  = interest + (payPenalty ? penalty : 0);
  const newBase     = payPenalty ? principal : (principal + penalty);
  const newInterestAmt = parseFloat((newBase * (newInterestRate / 100)).toFixed(2));
  const newTotal       = parseFloat((newBase + newInterestAmt).toFixed(2));

  document.getElementById('rv_payInterestLine').textContent = '₦' + interest.toLocaleString();

  const penaltyPayLine = document.getElementById('rv_payPenaltyLine');
  if(payPenalty && penalty > 0){
    penaltyPayLine.style.display = 'flex';
    document.getElementById('rv_payPenaltyAmt').textContent = '₦' + penalty.toLocaleString();
  } else {
    penaltyPayLine.style.display = 'none';
  }

  document.getElementById('rv_totalToPay').textContent     = '₦' + totalToPay.toLocaleString();
  document.getElementById('rv_newBase').textContent        = '₦' + newBase.toLocaleString();
  document.getElementById('rv_rolloverFeeAmt').textContent = '₦' + newInterestAmt.toLocaleString();
  document.getElementById('rv_newTotal').textContent       = '₦' + newTotal.toLocaleString();
  document.getElementById('rv_previewNewRate').textContent = newInterestRate + '%';
}

async function submitRolloverRequest(){
  const btn        = document.getElementById('rv_submitBtn');
  const errDiv     = document.getElementById('rv_error');
  const loanId     = document.getElementById('rv_hiddenLoanId').value;
  const interest   = parseFloat(document.getElementById('rv_hiddenInterest').value);
  const penalty    = parseFloat(document.getElementById('rv_hiddenPenalty').value);
  const payPenalty = document.getElementById('rv_payPenalty').checked;
  const payerName  = document.getElementById('rv_payerName').value.trim();
  const method     = document.getElementById('rv_selectedMethod').value;

  errDiv.style.display = 'none';

  if(!loanId){
    errDiv.textContent = 'Invalid session. Please close and try again.';
    errDiv.style.display = 'block'; return;
  }
  if(!interest || interest <= 0){
    errDiv.textContent = 'Interest amount is missing. Please close and try again.';
    errDiv.style.display = 'block'; return;
  }
  if(!method){
    errDiv.textContent = 'Please select a payment method.';
    errDiv.style.display = 'block'; return;
  }
  if(method === 'manual' && !payerName){
    errDiv.textContent = 'Please enter your name as it appears on the bank receipt.';
    errDiv.style.display = 'block'; return;
  }

  const totalToPay = interest + (payPenalty ? penalty : 0);

  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right:5px;"></i>Processing…';

  try{
    if(method === 'paystack'){
      const initRes  = await fetch('/club-de-star-cooperative/rollover-paystack-init',{
        method:  'POST',
        headers: {'Content-Type':'application/json'},
        body:    JSON.stringify({ amount: totalToPay, loanId })
      });
      const initData = await initRes.json();
      if(!initRes.ok || !initData.authorization_url){
        throw new Error(initData.message || 'Could not initiate Paystack payment.');
      }
      sessionStorage.setItem('pendingRollover', JSON.stringify({
        loanId,
        interestAmount: interest,
        penaltyAmount:  payPenalty ? penalty : 0,
        payPenalty,
        payerName,
        paystackRef: initData.reference,
      }));
      window.location.href = initData.authorization_url;
      return;
    }

    const res  = await fetch('/club-de-star-cooperative/rollover-request',{
      method:  'POST',
      headers: {'Content-Type':'application/json'},
      body:    JSON.stringify({
        loanId,
        interestAmount: interest,
        penaltyAmount:  payPenalty ? penalty : 0,
        payPenalty,
        payerName,
        paymentMethod: 'manual',
      })
    });
    const data = await res.json();

    if(res.ok && data.status){
      const s = data.summary;
      document.getElementById('rvs_msg').innerHTML =
        `Paid: <strong>₦${Number(s.totalPaid).toLocaleString()}</strong> ` +
        `(interest: ₦${Number(s.interestPaid).toLocaleString()}` +
        `${s.penaltyPaid > 0 ? ` + penalty: ₦${Number(s.penaltyPaid).toLocaleString()}` : ''})` +
        `<br>New loan total: <strong>₦${Number(s.newTotalRepay).toLocaleString()}</strong>` +
        `<br>New interest rate: <strong>${Number(s.newInterestRate)}%</strong>` +
        `<br><br>Admin will confirm your bank transfer and complete the rollover.`;
      closeModal('rolloverModal');
      setTimeout(() => openModal('rolloverSuccessModal'), 300);
    } else {
      errDiv.textContent   = data.message || 'Submission failed. Please try again.';
      errDiv.style.display = 'block';
    }
  } catch(e){
    errDiv.textContent   = e.message || 'Network error. Please try again.';
    errDiv.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-paper-plane" style="margin-right:5px;font-size:11px;"></i>Submit Rollover Request';
  }
}

/* ── Handle Paystack return ── */
(function checkPaystackReturn(){
  const pending = sessionStorage.getItem('pendingRollover');
  if(!pending) return;
  const params = new URLSearchParams(window.location.search);
  const ref    = params.get('reference') || params.get('ref') || params.get('trxref');
  if(!ref) return;
  sessionStorage.removeItem('pendingRollover');
  const data = JSON.parse(pending);
  fetch('/club-de-star-cooperative/rollover-request',{
    method:  'POST',
    headers: {'Content-Type':'application/json'},
    body:    JSON.stringify({ ...data, paymentMethod: 'paystack', paystackRef: ref })
  }).then(r => r.json()).then(d => {
    if(d.status){
      const s = d.summary;
      document.getElementById('rvs_msg').innerHTML =
        `Paid via Paystack: <strong>₦${Number(s.totalPaid).toLocaleString()}</strong>` +
        `<br>New loan total: <strong>₦${Number(s.newTotalRepay).toLocaleString()}</strong>` +
        `<br>New interest rate: <strong>${Number(s.newInterestRate)}%</strong>` +
        `<br><br>Admin will complete your rollover shortly.`;
      openModal('rolloverSuccessModal');
    }
  }).catch(() => {});
})();

/* ── Loader ── */
window.addEventListener('load', () => {
  const l = document.getElementById('loader');
  setTimeout(() => { l.style.opacity = '0'; setTimeout(() => l.style.display = 'none', 500); }, 400);
});
</script>

<script>
(function () {
    const TIMEOUT_MS  = 60 * 60 * 1000;
    const WARNING_MS  = 20 * 1000;
    const LOGOUT_URL  = '/logout';
    const PING_URL    = '/api/ping';     // keeps session alive on activity

    let logoutTimer, warningTimer, warningEl;

    function resetTimers() {
        clearTimeout(logoutTimer);
        clearTimeout(warningTimer);
        hideWarning();

        warningTimer = setTimeout(showWarning, TIMEOUT_MS - WARNING_MS);
        logoutTimer  = setTimeout(() => { window.location.href = LOGOUT_URL; }, TIMEOUT_MS);
    }

    function showWarning() {
        if (warningEl) return;
        warningEl = document.createElement('div');
        warningEl.id = 'inactivity-warning';
        warningEl.innerHTML = `
            <div style="
                position:fixed;bottom:24px;right:24px;z-index:99999;
                background:#1e3a8a;color:#fff;border-radius:14px;
                padding:16px 20px;max-width:300px;
                box-shadow:0 8px 32px rgba(0,0,0,.3);font-size:13px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
            ">
                <strong style="display:block;margin-bottom:6px;">⏱ Session expiring</strong>
                You'll be logged out in 1 minute due to inactivity.
                <button onclick="stayLoggedIn()" style="
                    display:block;margin-top:12px;width:100%;
                    padding:8px;border:none;border-radius:8px;
                    background:#fff;color:#1e3a8a;font-weight:700;
                    cursor:pointer;font-size:13px;
                ">Stay logged in</button>
            </div>`;
        document.body.appendChild(warningEl);
    }

    function hideWarning() {
        if (warningEl) { warningEl.remove(); warningEl = null; }
    }

    window.stayLoggedIn = function () {
        fetch(PING_URL, { credentials: 'same-origin' }); // touch the session
        resetTimers();
    };

    // Reset on any user activity
    ['mousemove','keydown','mousedown','touchstart','scroll'].forEach(evt => {
        document.addEventListener(evt, resetTimers, { passive: true });
    });

    resetTimers(); // start on page load
})();
</script>
</body>
</html>
