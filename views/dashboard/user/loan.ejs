<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loans — Club De Stars | Powered by JESZ LIMITED</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --sidebar-w:230px;--nav-h:62px;
  --r-sm:8px;--r-md:12px;--r-lg:16px;--r-xl:20px;
  --accent:#4f8ef7;--accent2:#7c5af4;
  --green:#22c78a;--red:#f05252;--amber:#f5a623;
  --tr:all .22s ease;
}
[data-theme="dark"]{
  --bg:#0a0f1e;--bg-card:#111827;--bg-card2:#1a2235;
  --bg-card3:rgba(255,255,255,.035);
  --border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.12);
  --text:#f0f4ff;--text2:#c8d4f0;--muted:#8b9ab8;
  --nav-bg:rgba(10,15,30,.93);
  --hero-bg:linear-gradient(135deg,#111827 0%,#1a2235 100%);
  --bar-bg:rgba(255,255,255,.07);--meta-bg:rgba(255,255,255,.03);
  --tog-bg:rgba(255,255,255,.08);
}
[data-theme="light"]{
  --bg:#f4f6fb;--bg-card:#ffffff;--bg-card2:#f0f3fa;
  --bg-card3:rgba(0,0,0,.025);
  --border:rgba(0,0,0,.07);--border2:rgba(0,0,0,.12);
  --text:#0f1523;--text2:#2a3550;--muted:#6b7a99;
  --nav-bg:rgba(255,255,255,.93);
  --hero-bg:linear-gradient(135deg,#dde8ff 0%,#eef1ff 100%);
  --bar-bg:rgba(0,0,0,.07);--meta-bg:rgba(0,0,0,.025);
  --tog-bg:rgba(0,0,0,.07);
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{
  height:100%;font-family:'DM Sans',sans-serif;
  background:var(--bg);color:var(--text);font-size:14px;
  transition:background .3s,color .3s;
}
a{text-decoration:none;color:inherit;}
button,input,select,textarea{font-family:inherit;}
#loader{
  position:fixed;inset:0;background:var(--bg);z-index:9999;
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:20px;transition:opacity .5s;
}
.loader-ring{
  width:48px;height:48px;
  border:2.5px solid var(--border2);border-top-color:var(--accent);
  border-radius:50%;animation:spin 1s linear infinite;
}
.loader-label{font-size:11px;color:var(--muted);letter-spacing:.14em;text-transform:uppercase;}
@keyframes spin{to{transform:rotate(360deg)}}
.sidebar{
  position:fixed;left:0;top:0;bottom:0;width:var(--sidebar-w);
  background:var(--bg-card);border-right:1px solid var(--border);
  z-index:200;display:flex;flex-direction:column;overflow:hidden;
  transition:transform .3s,background .3s,border-color .3s;
}
.sidebar-logo{
  padding:18px 18px 14px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;flex-shrink:0;
}
.logo-mark{
  width:34px;height:34px;border-radius:10px;flex-shrink:0;overflow:hidden;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:14px;color:#fff;
}
.logo-mark img{width:100%;height:100%;object-fit:cover;}
.logo-name{font-size:13px;font-weight:600;line-height:1.2;}
.logo-sub{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;}
.sidebar-user{padding:12px 14px;border-bottom:1px solid var(--border);flex-shrink:0;}
.user-chip{
  display:flex;align-items:center;gap:10px;
  background:var(--bg-card2);border-radius:10px;padding:9px 11px;
  border:1px solid var(--border);
}
.user-avatar{
  width:32px;height:32px;border-radius:8px;flex-shrink:0;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:600;color:#fff;
}
.user-name{font-size:13px;font-weight:500;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.user-id{font-size:10px;color:var(--muted);font-family:'DM Mono',monospace;letter-spacing:.04em;}
.sidebar-nav{flex:1;overflow-y:auto;padding:8px 10px;}
.sidebar-nav::-webkit-scrollbar{width:3px;}
.sidebar-nav::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px;}
.nav-section{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;padding:10px 8px 4px;margin-top:2px;}
.nav-item{
  display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:9px;
  color:var(--muted);font-size:13px;font-weight:400;
  transition:var(--tr);margin-bottom:1px;cursor:pointer;
  border:none;background:none;width:100%;text-align:left;
}
.nav-item:hover{background:var(--bg-card2);color:var(--text);}
.nav-item.active{background:rgba(79,142,247,.1);color:var(--accent);}
.nav-item i{width:18px;text-align:center;font-size:13px;flex-shrink:0;}
.nav-badge{
  margin-left:auto;background:var(--red);color:#fff;
  font-size:10px;font-weight:700;border-radius:20px;padding:2px 7px;
}
.sidebar-footer{padding:12px 14px;border-top:1px solid var(--border);flex-shrink:0;}
.member-pill{
  display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;
  font-size:10px;font-weight:600;background:rgba(34,199,138,.12);
  color:var(--green);border:1px solid rgba(34,199,138,.2);margin-bottom:8px;
}
.topnav{
  position:fixed;top:0;left:var(--sidebar-w);right:0;height:var(--nav-h);
  background:var(--nav-bg);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);z-index:100;
  display:flex;align-items:center;padding:0 20px;gap:12px;
  transition:left .3s,background .3s,border-color .3s;
}
.hamburger{
  display:none;cursor:pointer;padding:7px;border-radius:8px;
  border:none;background:none;color:var(--muted);font-size:17px;
  transition:var(--tr);flex-shrink:0;
}
.hamburger:hover{background:var(--bg-card2);color:var(--text);}
.topnav-greeting{flex:1;min-width:0;}
.topnav-greeting h2{font-size:15px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.topnav-greeting p{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.topnav-right{display:flex;align-items:center;gap:8px;flex-shrink:0;}
.status-row{display:flex;align-items:center;gap:5px;}
.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);}
.status-label{font-size:12px;color:var(--green);font-weight:500;}
.kyc-chip{
  display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:8px;
  background:rgba(245,166,35,.1);border:1px solid rgba(245,166,35,.2);
  font-size:11px;font-weight:500;color:var(--amber);cursor:pointer;
  transition:var(--tr);text-decoration:none;white-space:nowrap;
}
.kyc-chip.verified{background:rgba(34,199,138,.08);border-color:rgba(34,199,138,.2);color:var(--green);}
.theme-toggle{
  width:40px;height:22px;border-radius:20px;border:1px solid var(--border2);
  background:var(--tog-bg);cursor:pointer;position:relative;flex-shrink:0;
  transition:background .3s,border-color .3s;padding:0;
}
.tog-thumb{
  position:absolute;top:2px;left:2px;width:16px;height:16px;
  border-radius:50%;background:var(--muted);
  transition:transform .25s ease,background .25s;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;color:#fff;pointer-events:none;
}
[data-theme="light"] .tog-thumb{transform:translateX(18px);background:var(--accent);}
.main{
  margin-left:var(--sidebar-w);margin-top:var(--nav-h);
  padding:22px;min-height:calc(100vh - var(--nav-h));
  transition:margin-left .3s;
}
.loan-hero{
  background:var(--hero-bg);border:1px solid var(--border2);
  border-radius:var(--r-xl);padding:22px;margin-bottom:14px;
  position:relative;overflow:hidden;
}
.loan-hero::before{
  content:'';position:absolute;top:-60px;right:-60px;
  width:200px;height:200px;border-radius:50%;
  background:radial-gradient(circle,rgba(245,166,35,.06) 0%,transparent 70%);
  pointer-events:none;
}
.hero-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px;}
.hero-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:5px;}
.hero-amount{font-size:clamp(26px,5vw,38px);font-weight:300;letter-spacing:-.5px;line-height:1;}
.hero-amount .cur{font-size:.5em;vertical-align:super;color:var(--muted);margin-right:2px;}
.hero-pill{
  display:inline-flex;align-items:center;gap:5px;margin-top:8px;
  padding:4px 10px;border-radius:20px;font-size:12px;font-weight:500;border-width:1px;border-style:solid;
}
.pill-amber{background:rgba(245,166,35,.1);color:var(--amber);border-color:rgba(245,166,35,.2);}
.pill-red{background:rgba(240,82,82,.1);color:var(--red);border-color:rgba(240,82,82,.2);}
.pill-green{background:rgba(34,199,138,.1);color:var(--green);border-color:rgba(34,199,138,.2);}
.pill-muted{background:var(--bg-card3);color:var(--muted);border-color:var(--border);}
.hero-actions{display:flex;gap:8px;flex-shrink:0;flex-wrap:wrap;}
.hero-btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:9px 16px;border-radius:10px;font-size:12px;font-weight:500;
  border:none;cursor:pointer;transition:var(--tr);
}
.hero-btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;}
.hero-btn-primary:hover{opacity:.88;transform:translateY(-1px);}
.hero-btn-ghost{background:var(--bg-card3);border:1px solid var(--border2);color:var(--text);}
.hero-btn-ghost:hover{background:var(--bg-card2);}
.hero-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.hero-stat{
  background:var(--bg-card3);border-radius:var(--r-md);
  padding:12px 14px;border:1px solid var(--border);
}
.hero-stat-label{font-size:10px;color:var(--muted);margin-bottom:3px;text-transform:uppercase;letter-spacing:.06em;}
.hero-stat-value{font-size:clamp(13px,2.5vw,17px);font-weight:500;letter-spacing:-.3px;word-break:break-word;}
.hero-stat-sub{font-size:11px;color:var(--muted);margin-top:2px;}
.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px;}
.stat-mini{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--r-lg);padding:16px;
  transition:border-color .2s;
}
.stat-mini:hover{border-color:var(--border2);}
.stat-mini-icon{
  width:36px;height:36px;border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  font-size:14px;margin-bottom:10px;
}
.stat-mini-label{font-size:10px;color:var(--muted);margin-bottom:3px;text-transform:uppercase;letter-spacing:.06em;}
.stat-mini-value{font-size:clamp(14px,2.5vw,18px);font-weight:500;word-break:break-word;}
.page-grid{display:grid;grid-template-columns:1fr 340px;gap:14px;}
.card{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--r-lg);
  transition:background .3s,border-color .3s;
}
.card-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 18px;border-bottom:1px solid var(--border);
}
.card-title{font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;}
.card-body{padding:18px;}
.active-loan-wrap{margin-bottom:14px;}
.loan-block{border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;}
.loan-block.overdue{border-color:rgba(240,82,82,.3);}
.loan-block-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 16px;background:var(--bg-card2);border-bottom:1px solid var(--border);
  flex-wrap:wrap;gap:8px;
}
.loan-block-title{font-size:13px;font-weight:500;}
.loan-block-body{padding:16px;}
.loan-amount-display{font-size:clamp(22px,4vw,32px);font-weight:300;letter-spacing:-.4px;margin-bottom:4px;}
.loan-sub{font-size:12px;color:var(--muted);margin-bottom:14px;}
.loan-progress-bar{background:var(--bar-bg);border-radius:4px;height:4px;overflow:hidden;margin-bottom:14px;}
.loan-progress-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--amber),#f57c23);transition:width .8s ease;}
.loan-progress-fill.overdue{background:linear-gradient(90deg,var(--red),#c0392b);}
.loan-detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px;}
.loan-detail-item{
  background:var(--meta-bg);border-radius:9px;
  padding:9px 10px;border:1px solid var(--border);
}
.ld-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;}
.ld-value{font-size:13px;font-weight:500;word-break:break-word;}
.penalty-row{
  display:flex;justify-content:space-between;align-items:center;
  padding:10px 12px;background:rgba(240,82,82,.06);
  border:1px solid rgba(240,82,82,.15);border-radius:9px;
  font-size:12px;margin-bottom:12px;
}
.loan-action-row{display:flex;gap:8px;}
.loan-action-btn{
  flex:1;padding:11px;border-radius:10px;font-size:13px;font-weight:500;
  cursor:pointer;transition:var(--tr);border:none;
}
.btn-pay{background:rgba(79,142,247,.1);border:1px solid rgba(79,142,247,.2);color:var(--accent);}
.btn-pay:hover{background:rgba(79,142,247,.18);}
.btn-rollover{background:var(--bg-card2);border:1px solid var(--border2);color:var(--muted);}
.btn-rollover:hover{color:var(--text);}
.calc-form-group{margin-bottom:12px;}
.calc-label{
  font-size:11px;font-weight:600;text-transform:uppercase;
  letter-spacing:.07em;color:var(--muted);display:block;margin-bottom:5px;
}
.calc-input,.calc-select{
  width:100%;background:var(--bg-card2);border:1px solid var(--border2);
  border-radius:9px;color:var(--text);font-size:13px;padding:9px 12px;
  transition:border-color .18s,background .3s;outline:none;-webkit-appearance:none;
}
.calc-input:focus,.calc-select:focus{border-color:var(--accent);}
.calc-input[readonly]{opacity:.6;cursor:default;}
.calc-input option,.calc-select option{background:var(--bg-card);color:var(--text);}
.calc-hint{font-size:11px;color:var(--muted);margin-top:4px;}
.calc-result{
  background:var(--bg-card2);border:1px solid var(--border);
  border-radius:10px;padding:12px;margin-top:4px;display:none;
}
.calc-result-row{display:flex;justify-content:space-between;font-size:12px;padding:4px 0;}
.calc-result-label{color:var(--muted);}
.calc-result-divider{border:none;border-top:1px solid var(--border);margin:5px 0;}
.empty-state{
  display:flex;flex-direction:column;align-items:center;
  justify-content:center;text-align:center;gap:12px;padding:48px 20px;
}
.empty-icon{
  width:52px;height:52px;border-radius:14px;
  background:rgba(79,142,247,.08);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;color:var(--accent);
}
.empty-cta{
  padding:10px 20px;background:rgba(79,142,247,.1);
  border:1px solid rgba(79,142,247,.2);border-radius:9px;
  color:var(--accent);font-size:13px;font-weight:500;
  cursor:pointer;border:none;transition:var(--tr);
}
.empty-cta:hover{background:rgba(79,142,247,.18);}
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:190;}
.sb-overlay.show{display:block;}
.modal-backdrop{
  display:none;position:fixed;inset:0;z-index:1000;
  background:rgba(0,0,0,.55);backdrop-filter:blur(5px);
  align-items:flex-end;justify-content:center;padding:0;
}
.modal-backdrop.open{display:flex;}
.modal-box{
  background:var(--bg-card);border:1px solid var(--border2);
  border-radius:var(--r-xl) var(--r-xl) 0 0;
  width:100%;max-width:480px;max-height:92vh;overflow-y:auto;
  animation:shup .28s cubic-bezier(.16,1,.3,1);
  transition:background .3s,border-color .3s;
}
@keyframes shup{from{transform:translateY(30px);opacity:0;}to{transform:none;opacity:1;}}
.modal-box::-webkit-scrollbar{width:3px;}
.modal-box::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px;}
.modal-handle{width:36px;height:4px;border-radius:2px;background:var(--border2);margin:12px auto 0;}
.modal-header{padding:16px 20px 0;display:flex;align-items:center;justify-content:space-between;}
.modal-title{font-size:15px;font-weight:500;}
.modal-close{
  background:none;border:none;color:var(--muted);cursor:pointer;font-size:17px;
  width:30px;height:30px;display:flex;align-items:center;justify-content:center;
  border-radius:7px;transition:var(--tr);
}
.modal-close:hover{background:var(--bg-card2);color:var(--text);}
.modal-body{padding:18px 20px;}
.form-group{margin-bottom:14px;}
.form-label{
  font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;
  color:var(--muted);display:block;margin-bottom:6px;
}
.form-control{
  width:100%;background:var(--bg-card2);border:1px solid var(--border2);
  border-radius:10px;color:var(--text);font-size:14px;padding:11px 14px;
  transition:border-color .18s,background .3s;outline:none;-webkit-appearance:none;
}
.form-control:focus{border-color:var(--accent);}
.form-control.input-error{border-color:var(--red);}
.form-control:disabled{opacity:.5;cursor:not-allowed;}
.form-control option{background:var(--bg-card);color:var(--text);}
.form-hint{font-size:11px;color:var(--muted);margin-top:5px;transition:color .2s;}
.form-hint.hint-error{color:var(--red);}
.modal-info{
  background:rgba(79,142,247,.08);border:1px solid rgba(79,142,247,.18);
  border-radius:10px;padding:12px;font-size:12px;color:var(--accent);
  line-height:1.6;margin-bottom:14px;
}
.modal-warn{
  background:rgba(245,166,35,.08);border:1px solid rgba(245,166,35,.18);
  border-radius:10px;padding:12px;font-size:12px;color:var(--amber);
  line-height:1.6;margin-bottom:14px;
}
.modal-danger{
  background:rgba(240,82,82,.08);border:1px solid rgba(240,82,82,.18);
  border-radius:10px;padding:12px;font-size:12px;color:var(--red);
  line-height:1.6;margin-bottom:14px;
}
.modal-footer{padding:0 20px 24px;display:flex;gap:10px;}
.btn{border:none;border-radius:10px;padding:12px 20px;font-size:13px;font-weight:500;cursor:pointer;transition:var(--tr);flex:1;}
.btn-ghost{background:var(--bg-card2);color:var(--muted);}
.btn-ghost:hover{color:var(--text);}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;flex:2;}
.btn-primary:hover{opacity:.88;transform:translateY(-1px);}
.btn-primary:disabled{opacity:.5;pointer-events:none;}
.btn-success{background:rgba(34,199,138,.12);border:1px solid rgba(34,199,138,.25);color:var(--green);flex:2;}
.btn-amber{background:rgba(245,166,35,.12);border:1px solid rgba(245,166,35,.25);color:var(--amber);flex:2;}
.summary-box{background:var(--bg-card2);border:1px solid var(--border);border-radius:10px;padding:12px;margin-bottom:14px;}
.summary-row{display:flex;justify-content:space-between;font-size:12px;padding:3px 0;}
.summary-label{color:var(--muted);}
.summary-divider{border:none;border-top:1px solid var(--border);margin:6px 0;}
.summary-total{font-weight:500;}
.result-modal{text-align:center;padding:28px 20px;}
.result-icon{width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:24px;}
.result-icon.success{background:rgba(34,199,138,.12);color:var(--green);}
.result-icon.error{background:rgba(240,82,82,.12);color:var(--red);}
.result-title{font-size:17px;font-weight:500;margin-bottom:7px;}
.result-msg{font-size:13px;color:var(--muted);margin-bottom:20px;line-height:1.6;}
.check-group{display:flex;align-items:flex-start;gap:10px;padding:12px 0;}
.check-group input[type=checkbox]{width:16px;height:16px;flex-shrink:0;margin-top:1px;accent-color:var(--accent);}
.check-group label{font-size:12px;color:var(--muted);line-height:1.5;}
.bank-box{
  background:var(--bg-card2);border:1px solid var(--border);
  border-radius:10px;padding:12px;margin-bottom:12px;
}
.bank-row{display:flex;justify-content:space-between;font-size:12px;padding:3px 0;}
.bank-label{color:var(--muted);}
.bank-value{font-weight:500;font-family:'DM Mono',monospace;}
.rollover-summary{
  background:var(--bg-card2);border:1px solid var(--border);
  border-radius:10px;padding:14px;margin-bottom:14px;
}
.rs-amount{font-size:clamp(22px,4vw,28px);font-weight:300;letter-spacing:-.3px;color:var(--accent);margin-bottom:2px;}
.rs-label{font-size:11px;color:var(--muted);}
.method-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
.method-card{
  border:1px solid var(--border2);border-radius:10px;padding:12px 10px;
  cursor:pointer;transition:var(--tr);text-align:center;background:var(--bg-card2);
}
.method-card:hover{border-color:var(--accent);}
.method-card.selected{border-color:var(--accent);background:rgba(79,142,247,.08);}
.method-card i{font-size:18px;margin-bottom:6px;display:block;}
.method-card-label{font-size:12px;font-weight:500;}
.method-card-sub{font-size:10px;color:var(--muted);margin-top:2px;}
.powered-by{position:fixed;bottom:12px;right:14px;font-size:11px;color:var(--muted);z-index:50;}
.powered-by strong{color:var(--accent);}
@media(max-width:1100px){.page-grid{grid-template-columns:1fr;}}
@media(max-width:900px){
  .sidebar{transform:translateX(calc(-1 * var(--sidebar-w)));}
  .sidebar.open{transform:none;box-shadow:4px 0 24px rgba(0,0,0,.3);}
  .topnav{left:0;}
  .main{margin-left:0;}
  .hamburger{display:flex;}
}
@media(max-width:600px){
  .main{padding:14px;}
  .stats-row{grid-template-columns:1fr 1fr;}
  .hero-grid{grid-template-columns:1fr 1fr;}
  .loan-detail-grid{grid-template-columns:1fr 1fr;}
  .hero-top{flex-direction:column;}
  .topnav-greeting p{display:none;}
  .status-label{display:none;}
  .modal-box{max-width:100%;}
  .hero-actions{width:100%;}
  .hero-btn{flex:1;justify-content:center;}
}
@media(max-width:380px){
  .stats-row{grid-template-columns:1fr;}
  .hero-grid{grid-template-columns:1fr;}
  .loan-detail-grid{grid-template-columns:1fr 1fr;}
}
@media(min-width:901px){
  .modal-backdrop{align-items:center;padding:20px;}
  .modal-box{border-radius:var(--r-xl);max-width:440px;}
  .modal-handle{display:none;}
}
@media print{
  .sidebar,.topnav,.powered-by{display:none!important;}
  .main{margin:0;padding:0;}
}
</style>
</head>
<body>

<div id="loader">
  <div class="loader-ring"></div>
  <div class="loader-label">Club De Stars</div>
</div>

<%
  const pendingGuarantorCount = user.guarantorRequests
    ? user.guarantorRequests.filter(r => r.status === "pending").length : 0;
  const maxLoan = user.account?.balance ? user.account.balance * 3 : 0;
  const loanProgressPct = loan && loan.totalRepay > 0
    ? Math.max(0,Math.min(100,((loan.totalRepay - (loan.outstandingBalance || loan.totalRepay)) / loan.totalRepay * 100).toFixed(0))) : 0;
  const loanIsOverdue = loan && loan.status === 'overdue';

  const now2 = new Date();
  const joinDate = new Date(user.createdAt);
  const isEligibleForLoan = (unit, value) => {
    if (unit === "daily") return true;
    let elapsed;
    switch(unit) {
      case "weeks":  elapsed = Math.floor((now2 - joinDate) / (1000*60*60*24*7)); break;
      case "months": elapsed = (now2.getFullYear() - joinDate.getFullYear()) * 12 + (now2.getMonth() - joinDate.getMonth()); break;
      default: elapsed = 0;
    }
    return elapsed >= value;
  };
  const eligibleLoan = loanSettings.find(ls => ls.status === "active" && isEligibleForLoan(ls.eligibilityUnit, ls.eligibilityValue));
  const canApply = !!eligibleLoan && !loan;

  const bankName      = (companyAccount && companyAccount.bankName)      || "—";
  const accountName   = (companyAccount && companyAccount.accountName)   || "—";
  const accountNumber = (companyAccount && companyAccount.accountNumber) || "—";
  const accountConfigured = bankName !== "—" && accountNumber !== "—";
%>

<div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

<!-- ════ SIDEBAR ════ -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-mark">
      <img src="/media/assets/logo/log.png" alt="Logo"
           onerror="this.style.display='none';this.parentNode.innerHTML='<b>C</b>'">
    </div>
    <div style="min-width:0;">
      <div class="logo-name">Club De Stars</div>
      <div class="logo-sub">Cooperative Society</div>
    </div>
  </div>
  <div class="sidebar-user">
    <div class="user-chip">
      <div class="user-avatar">
        <%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName.charAt(0).toUpperCase() %>
      </div>
      <div style="min-width:0;">
        <div class="user-name"><%= user.firstName %> <%= user.lastName %></div>
        <div class="user-id"><%= user.membershipID %></div>
      </div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">Menu</div>
    <a href="/cds-cooperative/dashboard" class="nav-item"><i class="fas fa-home"></i> Dashboard</a>
    <a href="/cds-cooperative/transaction" class="nav-item"><i class="fas fa-exchange-alt"></i> Transactions</a>
    <a href="/cds-cooperative/loan" class="nav-item active"><i class="fas fa-coins"></i> Loans</a>
    <a href="/cds-cooperative/guarantorRequest" class="nav-item">
      <i class="fas fa-user-check"></i> Guarantor
      <% if (pendingGuarantorCount > 0) { %><span class="nav-badge"><%= pendingGuarantorCount %></span><% } %>
    </a>
    <div class="nav-section">Account</div>
    <a href="/manage/kiddies-account" class="nav-item"><i class="fas fa-baby"></i> Kiddies Account</a>
    <a href="/cds-cooperative/profile" class="nav-item"><i class="fas fa-user"></i> Profile</a>
    <a href="/cds-cooperative/kyc" class="nav-item"><i class="fas fa-shield-alt"></i> KYC</a>
    <a href="/cds-cooperative/referral" class="nav-item"><i class="fas fa-user-plus"></i> Referrals</a>
    <a href="/cds-cooperative/report" class="nav-item"><i class="fas fa-chart-bar"></i> Reports</a>
    <a href="/cds-cooperative/memberContract" class="nav-item"><i class="fas fa-file-alt"></i> Terms</a>
    <% if (user.role && user.role.name !== 'member') { %>
    <div class="nav-section">Admin</div>
    <a href="/admin-dashboard" class="nav-item"><i class="fas fa-tachometer-alt"></i> Administration</a>
    <% } %>
  </nav>
  <div class="sidebar-footer">
    <div class="member-pill">
      <i class="fas fa-star" style="font-size:9px;"></i>
      <%= user.membershipID.startsWith('CD') ? 'Club Member' : 'Associate Member' %>
    </div>
    <a href="/logout" class="nav-item" style="color:var(--red);margin-top:2px;">
      <i class="fas fa-sign-out-alt"></i> Sign Out
    </a>
  </div>
</aside>

<!-- ════ TOP NAV ════ -->
<header class="topnav">
  <button class="hamburger" onclick="toggleSidebar()" aria-label="Menu">
    <i class="fas fa-bars"></i>
  </button>
  <div class="topnav-greeting">
    <h2>My Loans</h2>
    <p><%= user.firstName %> <%= user.lastName %> · <%= user.membershipID %></p>
  </div>
  <div class="topnav-right">
    <div class="status-row">
      <div class="status-dot"></div>
      <span class="status-label">Active</span>
    </div>
    <% if (user.Payment && user.Payment.status === "paid") { %>
      <div class="kyc-chip verified">
        <i class="fas fa-shield-alt" style="font-size:11px;"></i>
        <span>Verified</span>
      </div>
    <% } else { %>
      <a href="/cds-cooperative/kyc" class="kyc-chip">
        <i class="fas fa-shield-alt" style="font-size:11px;"></i>
        <span>KYC</span>
      </a>
    <% } %>
    <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme">
      <div class="tog-thumb" id="togThumb">
        <i class="fas fa-moon" id="togIcon" style="font-size:9px;"></i>
      </div>
    </button>
  </div>
</header>

<!-- ════ MAIN ════ -->
<main class="main">

  <div class="loan-hero">
    <div class="hero-top">
      <div>
        <div class="hero-label">Eligible Loan Amount</div>
        <div class="hero-amount"><span class="cur">₦</span><%= maxLoan.toLocaleString() %></div>
        <div class="hero-pill pill-<%= user.membershipID.startsWith('CD') ? 'green' : 'amber' %>" style="margin-top:8px;">
          <i class="fas fa-percentage" style="font-size:10px;"></i>
          <%= interestRate %>% · <%= user.membershipID.startsWith('CD') ? 'Club Member Rate' : 'Standard Rate' %>
        </div>
      </div>
      <div class="hero-actions">
        <button class="hero-btn hero-btn-primary" onclick="openModal('loanRequestModal')">
          <i class="fas fa-plus" style="font-size:11px;"></i> Apply for Loan
        </button>
        <% if (loan) { %>
        <button class="hero-btn hero-btn-ghost" onclick="openModal('paymentModal')">
          <i class="fas fa-credit-card" style="font-size:11px;"></i> Pay Now
        </button>
        <% } %>
      </div>
    </div>
    <div class="hero-grid">
      <div class="hero-stat">
          <div class="hero-stat-label" style="display:flex;align-items:center;justify-content:space-between;">
            <span>Active Loan</span>
            <% if (loan && ['approved','overdue','rolled_over'].includes(loan.status)) { %>
              <button onclick="printLoanOffer()" title="Print Loan Offer Letter"
                      style="background:none;border:none;color:var(--amber);cursor:pointer;padding:0;font-size:12px;display:flex;align-items:center;gap:4px;">
                <i class="fas fa-print"></i>
              </button>
            <% } %>
          </div>
          <div class="hero-stat-value" style="color:<%= loan ? (loanIsOverdue ? 'var(--red)' : 'var(--text)') : 'var(--muted)' %>;">
            ₦<%= loan ? loan.amount.toLocaleString() : '0' %>
          </div>
          <div class="hero-stat-sub"><%= loan ? loan.status.toUpperCase() : 'None' %></div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-label">Outstanding</div>
        <div class="hero-stat-value" style="color:<%= loanIsOverdue ? 'var(--red)' : 'var(--amber)' %>;">
          ₦<%= loan ? (loan.outstandingBalance || loan.totalRepay).toLocaleString() : '0' %>
        </div>
        <div class="hero-stat-sub"><%= loan ? 'Total repayment' : 'No balance' %></div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-label">Due Date</div>
        <div class="hero-stat-value" style="color:<%= loanIsOverdue ? 'var(--red)' : 'var(--text)' %>;">
          <%= loan && loan.dueDate ? new Date(loan.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '—' %>
        </div>
        <div class="hero-stat-sub"><%= loan && daysUntilDue != null ? daysUntilDue + ' days left' : 'No active loan' %></div>
      </div>
    </div>
  </div>

  <div class="stats-row">
    <div class="stat-mini">
      <div class="stat-mini-icon" style="background:rgba(34,199,138,.1);color:var(--green);">
        <i class="fas fa-wallet"></i>
      </div>
      <div class="stat-mini-label">Savings Balance</div>
      <div class="stat-mini-value">₦<%= (user.account?.balance || 0).toLocaleString() %></div>
    </div>
    <div class="stat-mini">
      <div class="stat-mini-icon" style="background:rgba(79,142,247,.1);color:var(--accent);">
        <i class="fas fa-chart-line"></i>
      </div>
      <div class="stat-mini-label">Repayment Progress</div>
      <div class="stat-mini-value"><%= loanProgressPct %>%</div>
    </div>
    <div class="stat-mini">
      <div class="stat-mini-icon" style="background:rgba(245,166,35,.1);color:var(--amber);">
        <i class="fas fa-calendar-check"></i>
      </div>
      <div class="stat-mini-label">Days Until Due</div>
      <div class="stat-mini-value" style="color:<%= loan && daysUntilDue < 3 ? 'var(--red)' : 'var(--text)' %>;">
        <%= loan && daysUntilDue != null ? daysUntilDue : '—' %>
      </div>
    </div>
  </div>

  <div class="page-grid">
    <div>
      <div class="active-loan-wrap">
        <% if (loan) { %>
        <div class="loan-block <%= loanIsOverdue ? 'overdue' : '' %>">
          <div class="loan-block-header">
            <span class="loan-block-title">Current Loan</span>
            <div style="display:flex;align-items:center;gap:8px;">
              <% if (loanIsOverdue) { %>
                <span class="hero-pill pill-red" style="margin:0;font-size:11px;">
                  <i class="fas fa-circle" style="font-size:7px;"></i> Overdue
                </span>
              <% } else { %>
                <span class="hero-pill pill-amber" style="margin:0;font-size:11px;">
                  <%= loan.status.charAt(0).toUpperCase() + loan.status.slice(1) %>
                </span>
              <% } %>
            </div>
          </div>
          <div class="loan-block-body">
            <div class="loan-amount-display" style="color:<%= loanIsOverdue ? 'var(--red)' : 'var(--text)' %>;">
              ₦<%= (loan.outstandingBalance || loan.totalRepay).toLocaleString() %>
            </div>
            <div class="loan-sub">Outstanding balance</div>
            <div class="loan-progress-bar">
              <div class="loan-progress-fill <%= loanIsOverdue ? 'overdue' : '' %>" style="width:<%= loanProgressPct %>%"></div>
            </div>
            <div class="loan-detail-grid">
              <div class="loan-detail-item">
                <div class="ld-label">Principal</div>
                <div class="ld-value">₦<%= loan.amount.toLocaleString() %></div>
              </div>
              <div class="loan-detail-item">
                <div class="ld-label">Total Repay</div>
                <div class="ld-value">₦<%= loan.totalRepay.toLocaleString() %></div>
              </div>
              <div class="loan-detail-item">
                <div class="ld-label">Interest</div>
                <div class="ld-value">₦<%= (loan.interestAmount || Math.round(loan.amount * (interestRate / 100))).toLocaleString() %></div>
              </div>
              <div class="loan-detail-item">
                <div class="ld-label">Rate</div>
                <div class="ld-value"><%= interestRate %>% p.a.</div>
              </div>
              <div class="loan-detail-item">
                <div class="ld-label">Due</div>
                <div class="ld-value" style="color:<%= loanIsOverdue ? 'var(--red)' : 'var(--amber)' %>;">
                  <%= loan.dueDate ? new Date(loan.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'2-digit'}) : 'N/A' %>
                </div>
              </div>
              <div class="loan-detail-item">
                <div class="ld-label">Progress</div>
                <div class="ld-value" style="color:var(--green);"><%= loanProgressPct %>%</div>
              </div>
            </div>
            <% if (loan.totalPenalty > 0) { %>
            <div class="penalty-row">
              <span style="color:var(--muted);">Penalty (<%= loan.duration?.penaltyPercentage || 0 %>%/day)</span>
              <span style="color:var(--red);font-weight:500;">+₦<%= loan.totalPenalty.toLocaleString() %></span>
            </div>
            <% } %>
            <div class="loan-action-row">
              <button class="loan-action-btn btn-pay" onclick="openModal('paymentModal')">
                <i class="fas fa-credit-card" style="margin-right:6px;font-size:11px;"></i>Make Payment
              </button>
              <button
                class="loan-action-btn btn-rollover"
                onclick="openRolloverFlow()"
                <%= (rolloverPending || user.rolloverBlocked) ? 'disabled' : '' %>
                title="<%= user.rolloverBlocked ? 'Rollover blocked by admin' : (rolloverPending ? 'Rollover pending admin approval' : '') %>"
                style="<%= (rolloverPending || user.rolloverBlocked) ? 'opacity:.5;cursor:not-allowed;' : '' %>">
                <i class="fas fa-<%= user.rolloverBlocked ? 'ban' : (rolloverPending ? 'clock' : 'sync-alt') %>" style="margin-right:6px;font-size:11px;"></i>
                <%= user.rolloverBlocked ? 'Rollover Blocked' : (rolloverPending ? 'Rollover Pending' : 'Rollover') %>
              </button>
            </div>
          </div>
        </div>
        <% } else { %>
        <div class="card">
          <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-coins"></i></div>
            <div>
              <div style="font-size:15px;font-weight:500;margin-bottom:4px;">No Active Loan</div>
              <div style="font-size:12px;color:var(--muted);">Up to ₦<%= maxLoan.toLocaleString() %> available</div>
            </div>
            <button class="empty-cta" onclick="openModal('loanRequestModal')">Apply for a Loan</button>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:14px;">
      <div class="card">
        <div class="card-header">
          <span class="card-title">Loan Calculator</span>
          <i class="fas fa-calculator" style="color:var(--accent);font-size:13px;"></i>
        </div>
        <div class="card-body">
          <div class="calc-form-group">
            <label class="calc-label">Amount (₦)</label>
            <input type="number" class="calc-input" id="calcAmount" placeholder="e.g. 100,000" oninput="calculateLoan()">
            <div class="calc-hint">Max: ₦<%= maxLoan.toLocaleString() %></div>
          </div>
          <div class="calc-form-group">
            <label class="calc-label">Duration</label>
            <select class="calc-select" id="calcDuration" onchange="calculateLoan()">
              <% loanSettings.forEach(s => { if(s.status === 'active'){ %>
                <option value="<%= s.duration %>"><%= s.loanName %> — <%= s.duration %> months</option>
              <% }}); %>
            </select>
          </div>
          <div class="calc-form-group">
            <label class="calc-label">Interest Rate</label>
            <input type="number" class="calc-input" id="calcRate" value="<%= interestRate %>" readonly>
            <div class="calc-hint" style="color:var(--green);"><i class="fas fa-star" style="font-size:9px;margin-right:3px;"></i><%= user.account?.accountType?.name || 'Member' %> rate</div>
          </div>
          <div class="calc-result" id="calcResult">
            <div class="calc-result-row"><span class="calc-result-label">Monthly payment</span><span id="monthlyPay" style="font-weight:500;color:var(--accent);">₦0</span></div>
            <div class="calc-result-row"><span class="calc-result-label">Total interest</span><span id="totalInt" style="color:var(--amber);">₦0</span></div>
            <hr class="calc-result-divider">
            <div class="calc-result-row"><span class="calc-result-label">Total repayment</span><span id="totalRep" style="font-weight:600;">₦0</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

</main>

<div class="powered-by">Powered by <strong>JESZ LIMITED</strong></div>

<!-- ════════════ MODALS ════════════ -->

<!-- Loan Request -->
<div class="modal-backdrop" id="loanRequestModal">
  <div class="modal-box"><div class="modal-handle"></div>
    <div class="modal-header">
      <span class="modal-title"><i class="fas fa-file-invoice-dollar" style="color:var(--accent);margin-right:8px;font-size:14px;"></i>Apply for Loan</span>
      <button class="modal-close" onclick="closeModal('loanRequestModal')"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <% if (loan) { %>
        <div class="modal-danger"><i class="fas fa-ban" style="margin-right:6px;"></i>You have an active loan. Clear it before applying.</div>
      <% } else if (!eligibleLoan) { %>
        <div class="modal-danger"><i class="fas fa-clock" style="margin-right:6px;"></i>You are not yet eligible to apply for a loan.</div>
      <% } %>
      <div class="modal-warn"><i class="fas fa-users" style="margin-right:6px;"></i>Two guarantors required for approval.</div>
      <form id="loanForm">
        <div class="form-group">
          <label class="form-label">Loan Amount (₦)</label>
          <input
            type="number"
            class="form-control"
            id="loanAmountInput"
            name="amount"
            placeholder="0.00"
            min="1"
            max="<%= maxLoan %>"
            oninput="enforceLoanMax(this)"
            required
            <%= !canApply ? 'disabled' : '' %>>
          <div class="form-hint" id="loanAmountHint">
            Max: ₦<%= maxLoan.toLocaleString() %> &nbsp;·&nbsp; 3× your savings balance
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Repayment Period</label>
          <select class="form-control" name="duration" required <%= !canApply ? 'disabled' : '' %>>
            <option value="">Select duration…</option>
            <% loanSettings.forEach(s => { if(s.status === 'active'){ %>
              <option value="<%= s._id %>" <%= !isEligibleForLoan(s.eligibilityUnit, s.eligibilityValue) ? 'disabled' : '' %>>
                <%= s.loanName %><% if(!isEligibleForLoan(s.eligibilityUnit, s.eligibilityValue)){%> (Not eligible)<% } %>
              </option>
            <% }}); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Guarantor 1</label>
          <select class="form-control guarantorSelect" id="guarantor1" name="guarantor1" required <%= !canApply ? 'disabled' : '' %>>
            <option value="">Select guarantor…</option>
            <% users.forEach(u => { if(u._id.toString() !== user._id.toString()){ %><option value="<%= u._id %>"><%= u.membershipID %></option><% }}) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Guarantor 2</label>
          <select class="form-control guarantorSelect" id="guarantor2" name="guarantor2" required <%= !canApply ? 'disabled' : '' %>>
            <option value="">Select guarantor…</option>
            <% users.forEach(u => { if(u._id.toString() !== user._id.toString()){ %><option value="<%= u._id %>"><%= u.membershipID %></option><% }}) %>
          </select>
        </div>
        <div class="check-group">
          <input type="checkbox" name="agreeTerms" id="agreeTerms" <%= !canApply ? 'disabled' : '' %>>
          <label for="agreeTerms">I agree to the loan terms: <%= interestRate %>% interest rate for <%= user.membershipID.startsWith('CD') ? 'Club' : 'Standard' %> members.</label>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('loanRequestModal')">Cancel</button>
      <button class="btn btn-primary" id="loanSubmitBtn" onclick="submitLoanApplication()" <%= !canApply ? 'disabled' : '' %>>
        <i class="fas fa-paper-plane" style="margin-right:5px;font-size:11px;"></i>Submit Application
      </button>
    </div>
  </div>
</div>

<!-- Payment Modal -->
<div class="modal-backdrop" id="paymentModal">
  <div class="modal-box"><div class="modal-handle"></div>
    <div class="modal-header">
