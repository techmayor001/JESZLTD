<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KYC Verification | Club De Stars</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
        }
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0; width: 280px;
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; z-index: 1040; transition: all 0.3s;
            overflow-y: auto; box-shadow: 4px 0 20px rgba(30,58,138,0.15);
        }
        .sidebar-header { padding: 2rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.1); }
        .logo-container { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .logo-box {
            width: 45px; height: 45px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; color: var(--primary); font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        .sidebar-menu { padding: 1rem 0; }
        .sidebar-menu a {
            color: rgba(255,255,255,0.85); text-decoration: none;
            padding: 0.875rem 1.5rem; display: flex; align-items: center;
            transition: all 0.3s; border-left: 3px solid transparent; font-weight: 500;
        }
        .sidebar-menu a:hover { background: rgba(255,255,255,0.1); color: white; border-left-color: white; }
        .sidebar-menu a.active { background: rgba(255,255,255,0.15); color: white; border-left-color: white; }
        .sidebar-menu a i { width: 24px; margin-right: 12px; font-size: 1.1rem; }
        .member-badge {
            display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px;
            backdrop-filter: blur(10px); border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.3); font-weight: 600; font-size: 0.9rem;
        }
        .club-member-badge { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
        .top-navbar {
            position: fixed; top: 0; left: 280px; right: 0; height: 75px;
            background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,0.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 2rem;
            transition: all 0.3s; border-bottom: 1px solid rgba(30,58,138,0.1);
        }
        .main-content-wrapper {
            margin-left: 280px; margin-top: 75px; padding: 2rem;
            min-height: calc(100vh - 75px); transition: all 0.3s;
        }
        .kyc-container { max-width: 900px; margin: 0 auto; }
        .kyc-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white; border-radius: 24px 24px 0 0; padding: 2.5rem;
            text-align: center; position: relative; overflow: hidden;
        }
        .kyc-header::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,0.05); border-radius: 50%;
        }
        .kyc-card {
            background: white; border-radius: 0 0 24px 24px;
            box-shadow: 0 15px 40px rgba(30,58,138,0.15); overflow: hidden;
        }
        .progress-container {
            padding: 2rem;
            background: linear-gradient(135deg, rgba(30,58,138,0.03) 0%, rgba(59,130,246,0.03) 100%);
            border-bottom: 2px solid rgba(30,58,138,0.1);
        }
        .progress { height: 12px; border-radius: 10px; background: #e0e7ff; }
        .progress-bar {
            background: linear-gradient(90deg, #1e3a8a 0%, #3b82f6 100%);
            border-radius: 10px; transition: width 0.5s ease;
        }
        .document-section { padding: 2rem; border-bottom: 1px solid rgba(30,58,138,0.05); }
        .document-section:last-child { border-bottom: none; }
        .document-item {
            background: linear-gradient(135deg, rgba(30,58,138,0.02) 0%, rgba(59,130,246,0.02) 100%);
            border: 2px solid rgba(30,58,138,0.1); border-radius: 16px;
            padding: 1.5rem; margin-bottom: 1.5rem; transition: all 0.3s;
        }
        .document-item:hover { border-color: var(--primary-light); box-shadow: 0 8px 20px rgba(30,58,138,0.1); }
        .document-item.completed {
            border-color: var(--success);
            background: linear-gradient(135deg, rgba(16,185,129,0.05) 0%, rgba(5,150,105,0.05) 100%);
        }
        .document-icon {
            width: 60px; height: 60px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.75rem; margin-right: 1rem; flex-shrink: 0;
        }
        .document-content { flex: 1; min-width: 0; }
        .document-header {
            display: flex; justify-content: space-between; align-items: start;
            gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem;
        }
        .document-title { flex: 1; min-width: 0; }
        .document-title h6 { margin-bottom: 0.25rem; word-wrap: break-word; }
        .document-title small { display: block; word-wrap: break-word; }
        .existing-doc-banner {
            display: flex; align-items: center; justify-content: space-between;
            gap: 0.75rem; flex-wrap: wrap; padding: 0.875rem 1.125rem;
            background: linear-gradient(135deg, rgba(16,185,129,0.08) 0%, rgba(5,150,105,0.08) 100%);
            border: 1.5px solid rgba(16,185,129,0.35); border-radius: 10px; margin-bottom: 0.875rem;
        }
        .existing-doc-banner .doc-info {
            display: flex; align-items: center; gap: 0.625rem;
            font-size: 0.875rem; font-weight: 600; color: #065f46;
        }
        .existing-doc-banner .doc-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .btn-view-doc {
            display: inline-flex; align-items: center; gap: 0.375rem;
            padding: 0.375rem 0.875rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 600;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white; border: none; cursor: pointer; transition: all 0.2s;
        }
        .btn-view-doc:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(16,185,129,0.35); color: white; }
        .btn-replace-doc {
            display: inline-flex; align-items: center; gap: 0.375rem;
            padding: 0.375rem 0.875rem; border-radius: 8px; font-size: 0.8125rem; font-weight: 600;
            background: transparent; color: #1e3a8a; border: 1.5px solid rgba(30,58,138,0.3); cursor: pointer; transition: all 0.2s;
        }
        .btn-replace-doc:hover { background: rgba(30,58,138,0.06); border-color: #1e3a8a; }
        .replace-area-wrapper { display: none; margin-top: 0.5rem; }
        .replace-area-wrapper.open { display: block; }
        .upload-area {
            border: 2px dashed var(--primary-light); border-radius: 12px; padding: 2rem;
            text-align: center; cursor: pointer; transition: all 0.3s; background: rgba(59,130,246,0.02);
        }
        .upload-area:hover { border-color: var(--primary); background: rgba(59,130,246,0.05); }
        .upload-area.dragover { border-color: var(--success); background: rgba(16,185,129,0.05); }
        .file-preview {
            display: none; margin-top: 1rem; padding: 1rem;
            background: #f8fafc; border-radius: 10px; border: 1px solid #e2e8f0;
        }
        .file-preview.show { display: flex; align-items: center; justify-content: space-between; }
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none; padding: 0.875rem 2rem; border-radius: 12px; font-weight: 600; transition: all 0.3s;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(30,58,138,0.3); }
        .btn-outline-primary {
            border: 2px solid var(--primary); color: var(--primary);
            border-radius: 12px; padding: 0.875rem 2rem; font-weight: 600;
        }
        .alert-custom { border-radius: 16px; border: 2px solid; padding: 1.25rem; margin-bottom: 1.5rem; word-wrap: break-word; }
        .alert-custom ul { margin-bottom: 0; padding-left: 1.25rem; }
        .alert-custom li { word-wrap: break-word; margin-bottom: 0.5rem; }
        .alert-warning-custom { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-color: #f59e0b; color: #92400e; }
        .alert-info-custom { background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-color: #3b82f6; color: #1e40af; }
        .alert-success-custom { background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); border-color: #10b981; color: #065f46; }
        .status-badge { padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.875rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.5rem; }
        .status-pending { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); color: #92400e; }
        .status-completed { background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); color: #065f46; }
        .form-control, .form-select { border: 2px solid #e2e8f0; border-radius: 10px; padding: 0.75rem 1rem; transition: all 0.3s; }
        .form-control:focus, .form-select:focus { border-color: var(--primary-light); box-shadow: 0 0 0 0.2rem rgba(59,130,246,0.15); }
        .requirements-list { background: rgba(30,58,138,0.02); border-radius: 12px; padding: 1.25rem; margin-top: 1rem; }
        .requirements-list li { padding: 0.5rem 0; display: flex; align-items: flex-start; gap: 0.5rem; }
        .requirements-list li i { flex-shrink: 0; margin-top: 0.125rem; }
        .loading-spinner { display: none; border: 3px solid #f3f4f6; border-top: 3px solid #3b82f6; border-radius: 50%; width: 20px; height: 20px; animation: spin 1s linear infinite; }
        @keyframes spin { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }
        .hidden { display: none; }
        .loader-screen { position: fixed; inset: 0; background: linear-gradient(135deg, #0a1a2f, #102a44); display: flex; justify-content: center; align-items: center; z-index: 9999; }
        .logo span { font-size: 52px; font-weight: 600; color: #5cc8ff; display: inline-block; animation: float 1.5s infinite ease-in-out; letter-spacing: 1px; }
        .logo span:nth-child(1){animation-delay:0s}.logo span:nth-child(2){animation-delay:.1s}.logo span:nth-child(3){animation-delay:.2s}.logo span:nth-child(4){animation-delay:.3s}.logo span:nth-child(5){animation-delay:.4s}.logo span:nth-child(6){animation-delay:.5s}.logo span:nth-child(7){animation-delay:.6s}.logo span:nth-child(8){animation-delay:.7s}.logo span:nth-child(9){animation-delay:.8s}
        @keyframes float{0%,100%{transform:translateY(0);opacity:.4}50%{transform:translateY(-14px);opacity:1}}
        .powered-by { position: fixed; bottom: 20px; right: 20px; background: white; padding: 12px 20px; border-radius: 30px; box-shadow: 0 4px 15px rgba(30,58,138,0.15); font-size: .85rem; font-weight: 600; color: var(--primary); z-index: 1000; }
        #docViewerModal .modal-dialog { max-width: 850px; }
        #docViewerModal .modal-body { padding: 0; background: #111; min-height: 400px; display: flex; align-items: center; justify-content: center; }
        #docViewerContent img { max-width: 100%; max-height: 80vh; object-fit: contain; display: block; margin: auto; padding: 12px; }
        #docViewerContent iframe { width: 100%; height: 80vh; border: none; display: block; }
        @media(max-width:992px){.sidebar{left:-280px}.sidebar.active{left:0}.top-navbar{left:0}.main-content-wrapper{margin-left:0}.powered-by{bottom:10px;right:10px;font-size:.75rem;padding:8px 12px}}
        @media(max-width:768px){.kyc-container{padding:0 1rem}.kyc-header{padding:2rem 1.5rem;border-radius:16px 16px 0 0}.kyc-header h2{font-size:1.5rem}.document-section{padding:1.5rem 1rem}.document-item{padding:1rem}.document-item .d-flex{flex-direction:column}.document-icon{width:50px;height:50px;font-size:1.5rem;margin-right:0;margin-bottom:.75rem}.document-header{flex-direction:column;align-items:flex-start}.status-badge{align-self:flex-start;margin-top:.5rem}.main-content-wrapper{padding:1rem;margin-top:75px}.btn-primary,.btn-outline-primary{width:100%;padding:.75rem 1.5rem}.existing-doc-banner{flex-direction:column;align-items:flex-start}}
        @media(max-width:576px){.top-navbar{padding:0 1rem;height:70px}.main-content-wrapper{padding:.75rem}}
    </style>
</head>
<body>

<div id="loader-screen" class="loader-screen">
    <div class="logo"><span>C</span><span>l</span><span>o</span><span>u</span><span>d</span><span>B</span><span>a</span><span>a</span><span>m</span></div>
</div>

<div id="main-content" class="hidden">

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-box"><i class="fas fa-star"></i></div>
                <div>
                    <h5 class="mb-0 fw-bold" style="text-transform:uppercase;">Club De Stars</h5>
                    <small class="opacity-75">COOPERATIVE SOCIETY LIMITED</small>
                </div>
            </div>
            <div class="member-badge mt-2 club-member-badge"><i class="fas fa-star"></i><span>Club Member</span></div>
        </div>
        <div class="sidebar-menu">
            <a href="/cds-cooperative/dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/cds-cooperative/transaction"><i class="fas fa-exchange-alt"></i> Transactions</a>
            <a href="/cds-cooperative/loan"><i class="fas fa-hand-holding-usd"></i> My Loans</a>
            <a href="/cds-cooperative/guarantorRequest">
                <i class="fas fa-user-friends"></i> Guarantor Requests
                <% if (pendingGuarantorCount > 0) { %>
                    <span class="badge bg-danger ms-auto" style="font-size:.68rem;"><%= pendingGuarantorCount %></span>
                <% } %>
            </a>
            <a href="/manage/kiddies-account"><i class="fas fa-users"></i> Kiddies Account</a>
            <a href="/cds-cooperative/profile"><i class="fas fa-user-circle"></i> My Profile</a>
            <a href="/cds-cooperative/kyc" class="active"><i class="fas fa-shield-alt"></i> KYC Verification</a>
            <a href="/cds-cooperative/referral"><i class="fas fa-user-plus"></i> Referral Program</a>
            <a href="/cds-cooperative/memberContract"><i class="fas fa-file-contract"></i> Terms & Conditions</a>
            <a href="/cds-cooperative/report"><i class="fas fa-chart-line"></i> Reports</a>
            <% if (user.role && user.role.name !== 'member') { %>
            <a href="/admin-dashboard"><i class="fas fa-tachometer-alt"></i> Administration</a>
            <% } %>
            <a href="/logout" style="color:rgba(255,255,255,.52);margin-top:4px;"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <!-- Top Navbar -->
    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;"
           onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
        <div class="flex-grow-1">
            <h5 class="mb-0 fw-bold d-none d-md-block" style="color:var(--primary)">KYC Verification</h5>
            <h6 class="mb-0 fw-bold d-md-none" style="color:var(--primary)">KYC Verification</h6>
            <small class="text-muted">Upload your documents to activate your account</small>
        </div>
    </div>

    <div class="main-content-wrapper">
    <div class="kyc-container">

        <div class="kyc-header">
            <div class="position-relative" style="z-index:1;">
                <i class="fas fa-shield-alt fa-3x mb-3"></i>
                <h2 class="fw-bold mb-2">Complete Your KYC Verification</h2>
                <p class="mb-0 opacity-90">Upload your documents to activate your account</p>
            </div>
        </div>

        <div class="kyc-card">

            <% if (success) { %>
            <div class="document-section"><div class="alert-custom alert-success-custom mb-0"><i class="fas fa-check-circle me-2"></i><%= success %></div></div>
            <% } %>
            <% if (error) { %>
            <div class="document-section"><div class="alert-custom mb-0" style="background:#fee2e2;border-color:#ef4444;color:#991b1b;"><i class="fas fa-times-circle me-2"></i><%= error %></div></div>
            <% } %>

            <!-- Progress -->
            <div class="progress-container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0 fw-bold" style="color:var(--primary);"><i class="fas fa-tasks me-2"></i>Verification Progress</h6>
                    <span class="fw-bold" style="color:var(--primary);" id="progressText">0% Complete</span>
                </div>
                <div class="progress"><div class="progress-bar" role="progressbar" id="progressBar" style="width:0%"></div></div>
                <small class="text-muted mt-2 d-block">Complete all sections to activate your account</small>
            </div>

            <!-- Notice -->
            <div class="document-section">
                <div class="alert-custom alert-warning-custom mb-0">
                    <h6 class="fw-bold mb-2"><i class="fas fa-exclamation-triangle me-2"></i>Important Information</h6>
                    <ul class="mb-0 ps-3">
                        <li>All documents must be clear and legible</li>
                        <li>File size should not exceed 5MB per document</li>
                        <li>Accepted formats: JPG, PNG, PDF</li>
                        <li>Documents will be reviewed within 24-48 hours</li>
                    </ul>
                </div>
            </div>

            <form id="kycForm" enctype="multipart/form-data">

                <!-- ══ PROOF OF ADDRESS ══ -->
                <div class="document-section">
                    <h5 class="fw-bold mb-4" style="color:var(--primary);"><i class="fas fa-home me-2"></i>Proof of Address</h5>
                    <div class="document-item <%= kycDocs.addressProof ? 'completed' : '' %>" id="addressProofItem">
                        <div class="d-flex align-items-start">
                            <div class="document-icon" style="background:linear-gradient(135deg,#3b82f6 0%,#2563eb 100%);color:white;"><i class="fas fa-file-invoice"></i></div>
                            <div class="document-content">
                                <div class="document-header">
                                    <div class="document-title">
                                        <h6 class="mb-1 fw-bold">Address Verification Document</h6>
                                        <small class="text-muted">Utility bill, bank statement, or official letter</small>
                                    </div>
                                    <span class="status-badge <%= kycDocs.addressProof ? 'status-completed' : 'status-pending' %>" id="addressStatus">
                                        <% if (kycDocs.addressProof) { %><i class="fas fa-check-circle"></i> Uploaded<% } else { %><i class="fas fa-clock"></i> Pending<% } %>
                                    </span>
                                </div>
                                <% if (kycDocs.addressProof) { %>
                                <div class="existing-doc-banner" id="addressExistingBanner">
                                    <div class="doc-info"><i class="fas fa-check-circle fa-lg" style="color:#10b981;"></i>Document already on file</div>
                                    <div class="doc-actions">
                                        <button type="button" class="btn-view-doc" data-url="<%= kycDocs.addressProof %>" data-title="Proof of Address" onclick="viewDocument(this.dataset.url,this.dataset.title)"><i class="fas fa-eye"></i> View</button>
                                        <button type="button" class="btn-replace-doc" onclick="toggleReplaceArea('address')"><i class="fas fa-sync-alt"></i> Replace</button>
                                    </div>
                                </div>
                                <div class="replace-area-wrapper" id="addressReplaceArea">
                                <% } %>
                                <div class="upload-area" id="addressUploadArea" onclick="document.getElementById('addressProof').click()">
                                    <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color:var(--primary-light);"></i>
                                    <p class="mb-1 fw-semibold">Click to upload or drag and drop</p>
                                    <small class="text-muted">PDF, JPG, PNG (Max 5MB)</small>
                                </div>
                                <input type="file" id="addressProof" name="addressProof" accept="image/*,.pdf" class="d-none" onchange="handleFileSelect(this,'address',5)">
                                <div class="file-preview" id="addressPreview">
                                    <div class="d-flex align-items-center gap-2"><i class="fas fa-file-alt text-primary"></i><span id="addressFileName"></span></div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFile('address')"><i class="fas fa-times"></i></button>
                                </div>
                                <% if (kycDocs.addressProof) { %></div><% } %>
                                <div class="requirements-list">
                                    <small class="text-muted fw-semibold d-block mb-2">Requirements:</small>
                                    <ul class="small mb-0 ps-0" style="list-style:none;">
                                        <li><i class="fas fa-check-circle text-success me-2"></i>Must show your full name</li>
                                        <li><i class="fas fa-check-circle text-success me-2"></i>Must show your current address</li>
                                        <li><i class="fas fa-check-circle text-success me-2"></i>Should be dated within last 3 months</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ══ PASSPORT PHOTO ══ -->
                <div class="document-section">
                    <h5 class="fw-bold mb-4" style="color:var(--primary);"><i class="fas fa-user me-2"></i>Passport Photograph</h5>
                    <div class="document-item <%= kycDocs.passportPhoto ? 'completed' : '' %>" id="passportItem">
                        <div class="d-flex align-items-start">
                            <div class="document-icon" style="background:linear-gradient(135deg,#10b981 0%,#059669 100%);color:white;"><i class="fas fa-camera"></i></div>
                            <div class="document-content">
                                <div class="document-header">
                                    <div class="document-title">
                                        <h6 class="mb-1 fw-bold">Recent Passport Photo</h6>
                                        <small class="text-muted">Clear photo with white background</small>
                                    </div>
                                    <span class="status-badge <%= kycDocs.passportPhoto ? 'status-completed' : 'status-pending' %>" id="passportStatus">
                                        <% if (kycDocs.passportPhoto) { %><i class="fas fa-check-circle"></i> Uploaded<% } else { %><i class="fas fa-clock"></i> Pending<% } %>
                                    </span>
                                </div>
                                <% if (kycDocs.passportPhoto) { %>
                                <div class="existing-doc-banner" id="passportExistingBanner">
                                    <div class="doc-info"><i class="fas fa-check-circle fa-lg" style="color:#10b981;"></i>Photo already on file</div>
                                    <div class="doc-actions">
                                        <button type="button" class="btn-view-doc" data-url="<%= kycDocs.passportPhoto %>" data-title="Passport Photo" onclick="viewDocument(this.dataset.url,this.dataset.title)"><i class="fas fa-eye"></i> View</button>
                                        <button type="button" class="btn-replace-doc" onclick="toggleReplaceArea('passport')"><i class="fas fa-sync-alt"></i> Replace</button>
                                    </div>
                                </div>
                                <div class="replace-area-wrapper" id="passportReplaceArea">
                                <% } %>
                                <div class="upload-area" id="passportUploadArea" onclick="document.getElementById('passportPhoto').click()">
                                    <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color:var(--primary-light);"></i>
                                    <p class="mb-1 fw-semibold">Click to upload or drag and drop</p>
                                    <small class="text-muted">JPG, PNG (Max 5MB)</small>
                                </div>
                                <input type="file" id="passportPhoto" name="passportPhoto" accept="image/*" class="d-none" onchange="handleFileSelect(this,'passport',5)">
                                <div class="file-preview" id="passportPreview">
                                    <div class="d-flex align-items-center gap-2"><i class="fas fa-file-image text-primary"></i><span id="passportFileName"></span></div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFile('passport')"><i class="fas fa-times"></i></button>
                                </div>
                                <% if (kycDocs.passportPhoto) { %></div><% } %>
                                <div class="requirements-list">
                                    <small class="text-muted fw-semibold d-block mb-2">Requirements:</small>
                                    <ul class="small mb-0 ps-0" style="list-style:none;">
                                        <li><i class="fas fa-check-circle text-success me-2"></i>Recent photo (within 6 months)</li>
                                        <li><i class="fas fa-check-circle text-success me-2"></i>Clear face, no sunglasses</li>
                                        <li><i class="fas fa-check-circle text-success me-2"></i>White or light background</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ══ GOVERNMENT ID ══ -->
                <div class="document-section">
                    <h5 class="fw-bold mb-4" style="color:var(--primary);"><i class="fas fa-id-card me-2"></i>Means of Identification</h5>
                    <div class="document-item <%= kycDocs.idFile ? 'completed' : '' %>" id="idItem">
                        <div class="d-flex align-items-start">
                            <div class="document-icon" style="background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%);color:white;"><i class="fas fa-id-badge"></i></div>
                            <div class="document-content">
                                <div class="document-header">
                                    <div class="document-title">
                                        <h6 class="mb-1 fw-bold">Government-Issued ID</h6>
                                        <small class="text-muted">National ID, Passport, Driver's License, or Voter's Card</small>
                                    </div>
                                    <span class="status-badge <%= kycDocs.idFile ? 'status-completed' : 'status-pending' %>" id="idStatus">
                                        <% if (kycDocs.idFile) { %><i class="fas fa-check-circle"></i> Uploaded<% } else { %><i class="fas fa-clock"></i> Pending<% } %>
                                    </span>
                                </div>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">ID Type *</label>
                                        <select class="form-select" id="idType" name="idType">
                                            <option value="">Select ID Type</option>
                                            <option value="nin"      <%= user.idType === 'nin'      ? 'selected' : '' %>>National ID (NIN)</option>
                                            <option value="passport" <%= user.idType === 'passport' ? 'selected' : '' %>>International Passport</option>
                                            <option value="drivers"  <%= user.idType === 'drivers'  ? 'selected' : '' %>>Driver's License</option>
                                            <option value="voters"   <%= user.idType === 'voters'   ? 'selected' : '' %>>Voter's Card</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">ID Number *</label>
                                        <input type="text" class="form-control" id="idNumber" name="idNumber" placeholder="Enter ID number" value="<%= user.idNumber || '' %>">
                                    </div>
                                </div>
                                <% if (kycDocs.idFile) { %>
                                <div class="existing-doc-banner" id="idExistingBanner">
                                    <div class="doc-info"><i class="fas fa-check-circle fa-lg" style="color:#10b981;"></i>ID document already on file</div>
                                    <div class="doc-actions">
                                        <button type="button" class="btn-view-doc" data-url="<%= kycDocs.idFile %>" data-title="Government ID" onclick="viewDocument(this.dataset.url,this.dataset.title)"><i class="fas fa-eye"></i> View</button>
                                        <button type="button" class="btn-replace-doc" onclick="toggleReplaceArea('id')"><i class="fas fa-sync-alt"></i> Replace</button>
                                    </div>
                                </div>
                                <div class="replace-area-wrapper" id="idReplaceArea">
                                <% } %>
                                <div class="upload-area" id="idUploadArea" onclick="document.getElementById('idFile').click()">
                                    <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color:var(--primary-light);"></i>
                                    <p class="mb-1 fw-semibold">Click to upload or drag and drop</p>
                                    <small class="text-muted">PDF, JPG, PNG (Max 5MB)</small>
                                </div>
                                <input type="file" id="idFile" name="idFile" accept="image/*,.pdf" class="d-none" onchange="handleFileSelect(this,'id',5)">
                                <div class="file-preview" id="idPreview">
                                    <div class="d-flex align-items-center gap-2"><i class="fas fa-file-alt text-primary"></i><span id="idFileName"></span></div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFile('id')"><i class="fas fa-times"></i></button>
                                </div>
                                <% if (kycDocs.idFile) { %></div><% } %>
                                <div class="requirements-list">
                                    <small class="text-muted fw-semibold d-block mb-2">Requirements:</small>
                                    <ul class="small mb-0 ps-0" style="list-style:none;">
                                        <li><i class="fas fa-check-circle text-success me-2"></i>Must be valid and not expired</li>
                                        <li><i class="fas fa-check-circle text-success me-2"></i>All text must be clearly readable</li>
                                        <li><i class="fas fa-check-circle text-success me-2"></i>Upload both front and back if applicable</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ══ SIGNATURE ══ -->
                <div class="document-section">
                    <h5 class="fw-bold mb-4" style="color:var(--primary);"><i class="fas fa-signature me-2"></i>Signature</h5>
                    <div class="document-item <%= kycDocs.signature ? 'completed' : '' %>" id="signatureItem">
                        <div class="d-flex align-items-start">
                            <div class="document-icon" style="background:linear-gradient(135deg,#06b6d4 0%,#0891b2 100%);color:white;"><i class="fas fa-pen-fancy"></i></div>
                            <div class="document-content">
                                <div class="document-header">
                                    <div class="document-title">
                                        <h6 class="mb-1 fw-bold">Digital Signature</h6>
                                        <small class="text-muted">Your signature on white paper or digital signature</small>
                                    </div>
                                    <span class="status-badge <%= kycDocs.signature ? 'status-completed' : 'status-pending' %>" id="signatureStatus">
                                        <% if (kycDocs.signature) { %><i class="fas fa-check-circle"></i> Uploaded<% } else { %><i class="fas fa-clock"></i> Pending<% } %>
                                    </span>
                                </div>
                                <% if (kycDocs.signature) { %>
                                <div class="existing-doc-banner" id="signatureExistingBanner">
                                    <div class="doc-info"><i class="fas fa-check-circle fa-lg" style="color:#10b981;"></i>Signature already on file</div>
                                    <div class="doc-actions">
                                        <button type="button" class="btn-view-doc" data-url="<%= kycDocs.signature %>" data-title="Signature" onclick="viewDocument(this.dataset.url,this.dataset.title)"><i class="fas fa-eye"></i> View</button>
                                        <button type="button" class="btn-replace-doc" onclick="toggleReplaceArea('signature')"><i class="fas fa-sync-alt"></i> Replace</button>
                                    </div>
                                </div>
                                <div class="replace-area-wrapper" id="signatureReplaceArea">
                                <% } %>
                                <div class="upload-area" id="signatureUploadArea" onclick="document.getElementById('signature').click()">
                                    <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color:var(--primary-light);"></i>
                                    <p class="mb-1 fw-semibold">Click to upload or drag and drop</p>
                                    <small class="text-muted">JPG, PNG (Max 2MB)</small>
                                </div>
                                <input type="file" id="signature" name="signature" accept="image/*" class="d-none" onchange="handleFileSelect(this,'signature',2)">
                                <div class="file-preview" id="signaturePreview">
                                    <div class="d-flex align-items-center gap-2"><i class="fas fa-file-image text-primary"></i><span id="signatureFileName"></span></div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFile('signature')"><i class="fas fa-times"></i></button>
                                </div>
                                <% if (kycDocs.signature) { %></div><% } %>
                                <div class="requirements-list">
                                    <small class="text-muted fw-semibold d-block mb-2">Requirements:</small>
                                    <ul class="small mb-0 ps-0" style="list-style:none;">
                                        <li><i class="fas fa-check-circle text-success me-2"></i>Clear and legible signature</li>
                                        <li><i class="fas fa-check-circle text-success me-2"></i>On white or light background</li>
                                        <li><i class="fas fa-check-circle text-success me-2"></i>No watermarks or logos</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit -->
                <div class="document-section">
                    <div class="alert-custom alert-info-custom mb-4">
                        <h6 class="fw-bold mb-2"><i class="fas fa-info-circle me-2"></i>Before You Submit</h6>
                        <ul class="mb-0 ps-3">
                            <li>Ensure all documents are clear and readable</li>
                            <li>Verify that your information matches across all documents</li>
                            <li>Your documents will be kept confidential and secure</li>
                            <li>You'll receive a notification once verification is complete</li>
                        </ul>
                    </div>
                    <div class="d-flex gap-3 flex-wrap justify-content-between align-items-center">
                        <a href="/cds-cooperative/dashboard" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <span id="submitText"><%= kycStatus === 'submitted' ? 'Update Documents' : 'Submit Documents' %></span>
                            <div class="loading-spinner ms-2" id="submitSpinner"></div>
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
    </div>
</div>

<div class="powered-by">
    <strong style="color:var(--primary);">Cloudbaam</strong> Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong>
</div>

<!-- Document Viewer Modal -->
<div class="modal fade" id="docViewerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:20px;overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,#1e3a8a 0%,#3b82f6 100%);color:white;border:none;">
                <h5 class="modal-title fw-bold" id="docViewerTitle"><i class="fas fa-file-alt me-2"></i>View Document</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="background:#111;min-height:400px;display:flex;align-items:center;justify-content:center;">
                <div id="docViewerContent" style="width:100%;"></div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #e2e8f0;">
                <a id="docOpenLink" href="#" target="_blank" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-external-link-alt me-1"></i>Open in New Tab
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4" style="border-radius:20px;">
            <div class="modal-body">
                <i class="fas fa-check-circle text-success fa-4x mb-3"></i>
                <h5 class="fw-bold mb-3">Documents Submitted Successfully!</h5>
                <p class="text-muted mb-4">Your documents have been submitted for verification. Our team will review them within 24–48 hours.</p>
                <button class="btn btn-success w-100" onclick="window.location.href='/cds-cooperative/kyc'">View KYC Status</button>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4" style="border-radius:20px;">
            <div class="modal-body">
                <i class="fas fa-times-circle text-danger fa-4x mb-3"></i>
                <h5 class="fw-bold mb-3">Submission Failed</h5>
                <p class="text-muted mb-4" id="errorMessage">Unable to submit documents. Please try again.</p>
                <button class="btn btn-danger w-100" data-bs-dismiss="modal">Try Again</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
    /* ── Server state from EJS ── */
    const serverDocs = {
        address:   <%= kycDocs.addressProof  ? 'true' : 'false' %>,
        passport:  <%= kycDocs.passportPhoto ? 'true' : 'false' %>,
        id:        <%= kycDocs.idFile         ? 'true' : 'false' %>,
        signature: <%= kycDocs.signature      ? 'true' : 'false' %>
    };

    const keyToItem  = { address:'addressProofItem', passport:'passportItem', id:'idItem', signature:'signatureItem' };
    const keyToInput = { address:'addressProof', passport:'passportPhoto', id:'idFile', signature:'signature' };
    const uploadedFiles = { address:false, passport:false, id:false, signature:false };

    /* ── Progress ── */
    function updateProgress() {
        const done = ['address','passport','id','signature'].filter(t => serverDocs[t] || uploadedFiles[t]).length;
        const pct  = Math.round((done / 4) * 100);
        document.getElementById('progressBar').style.width = pct + '%';
        document.getElementById('progressText').textContent = pct + '% Complete';
    }
    updateProgress();

    /* ── Toggle replace area ── */
    function toggleReplaceArea(key) {
        const area = document.getElementById(key + 'ReplaceArea');
        if (!area) return;
        const opening = !area.classList.contains('open');
        area.classList.toggle('open', opening);
        const banner = document.getElementById(key + 'ExistingBanner');
        if (banner) {
            const btn = banner.querySelector('.btn-replace-doc');
            if (btn) btn.innerHTML = opening
                ? '<i class="fas fa-times"></i> Cancel'
                : '<i class="fas fa-sync-alt"></i> Replace';
        }
    }

    /* ── Document viewer — handles both images and PDFs ── */
    function viewDocument(url, title) {
        document.getElementById('docViewerTitle').innerHTML = '<i class="fas fa-file-alt me-2"></i>' + title;
        document.getElementById('docOpenLink').href = url;

        const content = document.getElementById('docViewerContent');
        const isPdf   = url.toLowerCase().endsWith('.pdf');

        if (isPdf) {
            content.innerHTML = `<iframe src="${url}" style="width:100%;height:80vh;border:none;display:block;"></iframe>`;
        } else {
            content.innerHTML = `<img src="${url}" alt="${title}"
                onerror="this.style.display='none';this.nextElementSibling.style.display='block';"
                style="max-width:100%;max-height:80vh;object-fit:contain;display:block;margin:auto;padding:12px;">
                <div style="display:none;color:#fff;padding:2rem;text-align:center;">
                    Could not load image.
                    <br><a href="${url}" target="_blank" style="color:#5cc8ff;">Open in new tab →</a>
                </div>`;
        }

        new bootstrap.Modal(document.getElementById('docViewerModal')).show();
    }

    /* ── File selection ── */
    function handleFileSelect(input, key, maxMB) {
        const file = input.files[0];
        if (!file) return;

        if (file.size > maxMB * 1024 * 1024) {
            alert(`File size exceeds ${maxMB}MB. Please choose a smaller file.`);
            input.value = '';
            return;
        }

        const imageOnly  = (key === 'signature' || key === 'passport');
        const validTypes = imageOnly
            ? ['image/jpeg','image/png']
            : ['image/jpeg','image/png','application/pdf'];

        if (!validTypes.includes(file.type)) {
            alert('Invalid file type. Please upload JPG, PNG' + (imageOnly ? '' : ' or PDF'));
            input.value = '';
            return;
        }

        uploadedFiles[key] = true;
        updateProgress();

        const nameEl    = document.getElementById(key + 'FileName');
        const previewEl = document.getElementById(key + 'Preview');
        if (nameEl)    nameEl.textContent = file.name;
        if (previewEl) previewEl.classList.add('show');

        document.getElementById(keyToItem[key])?.classList.add('completed');
        updateStatusBadge(key, 'completed');
    }

    /* ── Remove file ── */
    function removeFile(key) {
        const input = document.getElementById(keyToInput[key]);
        if (input) input.value = '';
        uploadedFiles[key] = false;
        updateProgress();
        document.getElementById(key + 'Preview')?.classList.remove('show');
        if (!serverDocs[key]) {
            document.getElementById(keyToItem[key])?.classList.remove('completed');
            updateStatusBadge(key, 'pending');
        }
    }

    /* ── Status badge ── */
    function updateStatusBadge(key, status) {
        const badge = document.getElementById(key + 'Status');
        if (!badge) return;
        badge.className = 'status-badge ' + (status === 'completed' ? 'status-completed' : 'status-pending');
        badge.innerHTML  = status === 'completed'
            ? '<i class="fas fa-check-circle"></i> Uploaded'
            : '<i class="fas fa-clock"></i> Pending';
    }

    /* ── Drag & drop ── */
    const dropMap = {
        addressUploadArea:   { inputId:'addressProof',  key:'address',   maxMB:5 },
        passportUploadArea:  { inputId:'passportPhoto', key:'passport',  maxMB:5 },
        idUploadArea:        { inputId:'idFile',         key:'id',        maxMB:5 },
        signatureUploadArea: { inputId:'signature',      key:'signature', maxMB:2 }
    };
    document.querySelectorAll('.upload-area').forEach(area => {
        area.addEventListener('dragover', e => { e.preventDefault(); area.classList.add('dragover'); });
        area.addEventListener('dragleave', () => area.classList.remove('dragover'));
        area.addEventListener('drop', e => {
            e.preventDefault(); area.classList.remove('dragover');
            const info = dropMap[area.id];
            if (!info || !e.dataTransfer.files.length) return;
            const input = document.getElementById(info.inputId);
            input.files = e.dataTransfer.files;
            handleFileSelect(input, info.key, info.maxMB);
        });
    });

    /* ── Form submit ── */
    document.getElementById('kycForm').addEventListener('submit', async e => {
        e.preventDefault();

        const allPresent = ['address','passport','id','signature'].every(t => serverDocs[t] || uploadedFiles[t]);
        if (!allPresent) { alert('Please upload all required documents before submitting.'); return; }

        const idType   = document.getElementById('idType').value;
        const idNumber = document.getElementById('idNumber').value.trim();
        if (!idType || !idNumber) { alert('Please select ID type and enter your ID number.'); return; }

        const btn     = document.getElementById('submitBtn');
        const txt     = document.getElementById('submitText');
        const spinner = document.getElementById('submitSpinner');
        btn.disabled = true; txt.textContent = 'Uploading…'; spinner.style.display = 'inline-block';

        try {
            const res    = await fetch('/kyc/submit', { method:'POST', body:new FormData(kycForm) });
            const result = await res.json();
            if (res.ok && result.status) {
                new bootstrap.Modal(document.getElementById('successModal')).show();
            } else {
                document.getElementById('errorMessage').textContent = result.message || 'Unable to submit. Please try again.';
                new bootstrap.Modal(document.getElementById('errorModal')).show();
            }
        } catch {
            document.getElementById('errorMessage').textContent = 'Network error. Please check your connection.';
            new bootstrap.Modal(document.getElementById('errorModal')).show();
        } finally {
            btn.disabled = false; spinner.style.display = 'none';
            txt.textContent = (serverDocs.address && serverDocs.passport && serverDocs.id && serverDocs.signature)
                ? 'Update Documents' : 'Submit Documents';
        }
    });

    /* ── Loader ── */
    window.addEventListener('load', () => {
        const loader = document.getElementById('loader-screen');
        const main   = document.getElementById('main-content');
        setTimeout(() => {
            loader.style.opacity = '0'; loader.style.transition = 'opacity 0.6s ease';
            setTimeout(() => { loader.style.display = 'none'; main.classList.remove('hidden'); }, 600);
        }, 200);
    });

    /* ── Sidebar (mobile) ── */
    document.addEventListener('click', e => {
        const sidebar = document.getElementById('sidebar');
        const toggle  = document.querySelector('.fa-bars');
        if (window.innerWidth <= 992 && sidebar.classList.contains('active') &&
            !sidebar.contains(e.target) && toggle && !toggle.contains(e.target)) {
            sidebar.classList.remove('active');
        }
    });

    /* ── Entrance animation ── */
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.document-item').forEach((item, i) => {
            item.style.opacity = '0'; item.style.transform = 'translateY(20px)';
            item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            setTimeout(() => { item.style.opacity = '1'; item.style.transform = 'translateY(0)'; }, i * 150);
        });
    });
</script>
</body>
</html>
