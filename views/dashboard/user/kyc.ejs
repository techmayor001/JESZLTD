<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KYC Verification — Club De Stars | Powered by JESZ LIMITED</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ══ THEME TOKENS ══ */
:root{
  --sidebar-w:230px;--nav-h:62px;
  --r-sm:8px;--r-md:12px;--r-lg:16px;--r-xl:20px;
  --accent:#4f8ef7;--accent2:#7c5af4;
  --green:#22c78a;--red:#f05252;--amber:#f5a623;
  --tr:all .22s ease;
}
[data-theme="dark"]{
  --bg:#0a0f1e;--bg-card:#111827;--bg-card2:#1a2235;
  --bg-card3:rgba(255,255,255,.035);
  --border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.12);
  --text:#f0f4ff;--text2:#c8d4f0;--muted:#8b9ab8;
  --nav-bg:rgba(10,15,30,.93);
  --hero-bg:linear-gradient(135deg,#111827 0%,#1a2235 100%);
  --bar-bg:rgba(255,255,255,.07);--meta-bg:rgba(255,255,255,.03);
  --tog-bg:rgba(255,255,255,.08);
  --upload-bg:rgba(79,142,247,.04);--upload-border:rgba(79,142,247,.25);
  --req-bg:rgba(255,255,255,.03);
  --doc-bg:rgba(255,255,255,.02);
}
[data-theme="light"]{
  --bg:#f4f6fb;--bg-card:#ffffff;--bg-card2:#f0f3fa;
  --bg-card3:rgba(0,0,0,.025);
  --border:rgba(0,0,0,.07);--border2:rgba(0,0,0,.12);
  --text:#0f1523;--text2:#2a3550;--muted:#6b7a99;
  --nav-bg:rgba(255,255,255,.93);
  --hero-bg:linear-gradient(135deg,#dde8ff 0%,#eef1ff 100%);
  --bar-bg:rgba(0,0,0,.07);--meta-bg:rgba(0,0,0,.025);
  --tog-bg:rgba(0,0,0,.07);
  --upload-bg:rgba(79,142,247,.03);--upload-border:rgba(79,142,247,.3);
  --req-bg:rgba(0,0,0,.025);
  --doc-bg:rgba(0,0,0,.015);
}

/* ══ BASE ══ */
*{margin:0;padding:0;box-sizing:border-box;}
html,body{height:100%;font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);font-size:14px;transition:background .3s,color .3s;}
a{text-decoration:none;color:inherit;}
button,input,select,textarea{font-family:inherit;}

/* ══ LOADER ══ */
#loader{
  position:fixed;inset:0;background:var(--bg);z-index:9999;
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:20px;transition:opacity .5s;
}
.loader-ring{width:48px;height:48px;border:2.5px solid var(--border2);border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite;}
.loader-label{font-size:11px;color:var(--muted);letter-spacing:.14em;text-transform:uppercase;}
@keyframes spin{to{transform:rotate(360deg)}}

/* ══ SIDEBAR ══ */
.sidebar{
  position:fixed;left:0;top:0;bottom:0;width:var(--sidebar-w);
  background:var(--bg-card);border-right:1px solid var(--border);
  z-index:200;display:flex;flex-direction:column;overflow:hidden;
  transition:transform .3s,background .3s,border-color .3s;
}
.sidebar-logo{padding:18px 18px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-shrink:0;}
.logo-mark{width:34px;height:34px;border-radius:10px;flex-shrink:0;overflow:hidden;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;color:#fff;}
.logo-mark img{width:100%;height:100%;object-fit:cover;}
.logo-name{font-size:13px;font-weight:600;line-height:1.2;}
.logo-sub{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;}
.sidebar-user{padding:12px 14px;border-bottom:1px solid var(--border);flex-shrink:0;}
.user-chip{display:flex;align-items:center;gap:10px;background:var(--bg-card2);border-radius:10px;padding:9px 11px;border:1px solid var(--border);}
.user-avatar{width:32px;height:32px;border-radius:8px;flex-shrink:0;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:#fff;overflow:hidden;}
.user-avatar img{width:100%;height:100%;object-fit:cover;}
.user-name{font-size:13px;font-weight:500;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.user-id{font-size:10px;color:var(--muted);font-family:'DM Mono',monospace;letter-spacing:.04em;}
.sidebar-nav{flex:1;overflow-y:auto;padding:8px 10px;}
.sidebar-nav::-webkit-scrollbar{width:3px;}
.sidebar-nav::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px;}
.nav-section{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;padding:10px 8px 4px;margin-top:2px;}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:9px;color:var(--muted);font-size:13px;font-weight:400;transition:var(--tr);margin-bottom:1px;cursor:pointer;border:none;background:none;width:100%;text-align:left;}
.nav-item:hover{background:var(--bg-card2);color:var(--text);}
.nav-item.active{background:rgba(79,142,247,.1);color:var(--accent);}
.nav-item i{width:18px;text-align:center;font-size:13px;flex-shrink:0;}
.nav-badge{margin-left:auto;background:var(--red);color:#fff;font-size:10px;font-weight:700;border-radius:20px;padding:2px 7px;}
.sidebar-footer{padding:12px 14px;border-top:1px solid var(--border);flex-shrink:0;}
.member-pill{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;font-size:10px;font-weight:600;background:rgba(34,199,138,.12);color:var(--green);border:1px solid rgba(34,199,138,.2);margin-bottom:8px;}

/* ══ TOP NAV ══ */
.topnav{
  position:fixed;top:0;left:var(--sidebar-w);right:0;height:var(--nav-h);
  background:var(--nav-bg);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);z-index:100;
  display:flex;align-items:center;padding:0 20px;gap:12px;
  transition:left .3s,background .3s,border-color .3s;
}
.hamburger{display:none;cursor:pointer;padding:7px;border-radius:8px;border:none;background:none;color:var(--muted);font-size:17px;transition:var(--tr);flex-shrink:0;}
.hamburger:hover{background:var(--bg-card2);color:var(--text);}
.topnav-greeting{flex:1;min-width:0;}
.topnav-greeting h2{font-size:15px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.topnav-greeting p{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.topnav-right{display:flex;align-items:center;gap:8px;flex-shrink:0;}
.status-row{display:flex;align-items:center;gap:5px;}
.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);}
.status-label{font-size:12px;color:var(--green);font-weight:500;}
.kyc-chip{display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:8px;background:rgba(245,166,35,.1);border:1px solid rgba(245,166,35,.2);font-size:11px;font-weight:500;color:var(--amber);cursor:pointer;transition:var(--tr);text-decoration:none;white-space:nowrap;}
.kyc-chip.verified{background:rgba(34,199,138,.08);border-color:rgba(34,199,138,.2);color:var(--green);}
.theme-toggle{width:40px;height:22px;border-radius:20px;border:1px solid var(--border2);background:var(--tog-bg);cursor:pointer;position:relative;flex-shrink:0;transition:background .3s,border-color .3s;padding:0;}
.tog-thumb{position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:var(--muted);transition:transform .25s ease,background .25s;display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;pointer-events:none;}
[data-theme="light"] .tog-thumb{transform:translateX(18px);background:var(--accent);}

/* ══ MAIN ══ */
.main{margin-left:var(--sidebar-w);margin-top:var(--nav-h);padding:22px;min-height:calc(100vh - var(--nav-h));transition:margin-left .3s;}

/* ══ KYC HERO ══ */
.kyc-hero{
  background:var(--hero-bg);border:1px solid var(--border2);
  border-radius:var(--r-xl);padding:24px;margin-bottom:14px;
  display:flex;align-items:center;gap:18px;
  position:relative;overflow:hidden;
}
.kyc-hero::before{content:'';position:absolute;top:-50px;right:-50px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(79,142,247,.07) 0%,transparent 70%);pointer-events:none;}
.kyc-hero-icon{width:56px;height:56px;border-radius:16px;flex-shrink:0;background:rgba(79,142,247,.12);border:1px solid rgba(79,142,247,.2);display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--accent);}
.kyc-hero-info{flex:1;min-width:0;}
.kyc-hero-title{font-size:clamp(16px,3vw,20px);font-weight:500;letter-spacing:-.2px;margin-bottom:4px;}
.kyc-hero-sub{font-size:12px;color:var(--muted);}

/* ══ PROGRESS CARD ══ */
.progress-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);padding:18px;margin-bottom:14px;}
.progress-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
.progress-label{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;}
.progress-pct{font-size:13px;font-weight:600;color:var(--accent);font-family:'DM Mono',monospace;}
.progress-track{background:var(--bar-bg);border-radius:4px;height:5px;overflow:hidden;}
.progress-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .6s cubic-bezier(.4,0,.2,1);}
.progress-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px;}
.progress-step{display:flex;flex-direction:column;align-items:center;gap:5px;}
.step-dot{width:28px;height:28px;border-radius:50%;border:2px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--muted);transition:var(--tr);}
.step-dot.done{border-color:var(--green);background:rgba(34,199,138,.1);color:var(--green);}
.step-dot.active{border-color:var(--accent);background:rgba(79,142,247,.1);color:var(--accent);}
.step-label{font-size:10px;color:var(--muted);text-align:center;line-height:1.3;}

/* ══ ALERT BARS ══ */
.alert-bar{display:flex;align-items:flex-start;gap:10px;border-radius:var(--r-md);padding:11px 14px;margin-bottom:14px;font-size:12px;line-height:1.6;}
.alert-bar i{flex-shrink:0;margin-top:1px;}
.alert-warn{background:rgba(245,166,35,.07);border:1px solid rgba(245,166,35,.18);color:var(--amber);}
.alert-info{background:rgba(79,142,247,.07);border:1px solid rgba(79,142,247,.18);color:var(--accent);}
.alert-success{background:rgba(34,199,138,.07);border:1px solid rgba(34,199,138,.18);color:var(--green);}
.alert-error{background:rgba(240,82,82,.07);border:1px solid rgba(240,82,82,.18);color:var(--red);}
.alert-bar ul{margin:4px 0 0 14px;padding:0;}
.alert-bar li{margin-bottom:2px;}

/* ══ DOCUMENT CARD ══ */
.doc-card{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--r-lg);margin-bottom:10px;overflow:hidden;
  transition:border-color .22s;
}
.doc-card.done{border-color:rgba(34,199,138,.3);}
.doc-card-header{
  display:flex;align-items:center;gap:14px;padding:16px 18px;cursor:pointer;
  transition:background .2s;user-select:none;
}
.doc-card-header:hover{background:var(--bg-card2);}
.doc-icon{width:42px;height:42px;border-radius:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:16px;}
.doc-icon-blue{background:rgba(79,142,247,.12);color:var(--accent);}
.doc-icon-green{background:rgba(34,199,138,.12);color:var(--green);}
.doc-icon-amber{background:rgba(245,166,35,.12);color:var(--amber);}
.doc-icon-cyan{background:rgba(6,182,212,.12);color:#06b6d4;}
.doc-info{flex:1;min-width:0;}
.doc-name{font-size:13px;font-weight:500;margin-bottom:2px;}
.doc-sub{font-size:11px;color:var(--muted);}
.doc-status{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;flex-shrink:0;}
.doc-status.pending{background:rgba(245,166,35,.1);color:var(--amber);border:1px solid rgba(245,166,35,.2);}
.doc-status.uploaded{background:rgba(34,199,138,.1);color:var(--green);border:1px solid rgba(34,199,138,.2);}
.doc-chevron{color:var(--muted);font-size:12px;transition:transform .22s;flex-shrink:0;}
.doc-card.open .doc-chevron{transform:rotate(180deg);}

.doc-body{display:none;padding:0 18px 18px;}
.doc-card.open .doc-body{display:block;}

/* existing file banner */
.existing-banner{
  display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;
  padding:10px 14px;background:rgba(34,199,138,.06);border:1px solid rgba(34,199,138,.2);
  border-radius:var(--r-md);margin-bottom:12px;
}
.existing-info{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:500;color:var(--green);}
.existing-actions{display:flex;gap:8px;}
.btn-view{display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:8px;font-size:12px;font-weight:500;background:rgba(34,199,138,.12);border:1px solid rgba(34,199,138,.25);color:var(--green);cursor:pointer;transition:var(--tr);}
.btn-view:hover{background:rgba(34,199,138,.2);}
.btn-replace{display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:8px;font-size:12px;font-weight:500;background:none;border:1px solid var(--border2);color:var(--muted);cursor:pointer;transition:var(--tr);}
.btn-replace:hover{border-color:var(--accent);color:var(--accent);}
.replace-wrap{display:none;margin-bottom:12px;}
.replace-wrap.open{display:block;}

/* ID fields */
.id-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;}
.form-group{display:flex;flex-direction:column;gap:6px;}
.form-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);}
.form-control{width:100%;background:var(--bg-card2);border:1px solid var(--border2);border-radius:10px;color:var(--text);font-size:14px;padding:10px 13px;transition:border-color .18s,background .3s;outline:none;-webkit-appearance:none;}
.form-control:focus{border-color:var(--accent);}
.form-control option{background:var(--bg-card);color:var(--text);}

/* upload area */
.upload-zone{
  border:1.5px dashed var(--upload-border);border-radius:var(--r-md);
  padding:22px;text-align:center;cursor:pointer;
  background:var(--upload-bg);transition:border-color .2s,background .2s;
  margin-bottom:10px;
}
.upload-zone:hover{border-color:var(--accent);background:rgba(79,142,247,.07);}
.upload-zone.dragover{border-color:var(--green);background:rgba(34,199,138,.05);}
.upload-zone-icon{font-size:22px;color:var(--accent);margin-bottom:8px;}
.upload-zone-text{font-size:13px;font-weight:500;margin-bottom:3px;}
.upload-zone-hint{font-size:11px;color:var(--muted);}
.file-pill{
  display:none;align-items:center;justify-content:space-between;
  padding:9px 12px;background:var(--bg-card2);border:1px solid var(--border);
  border-radius:var(--r-md);margin-bottom:10px;
}
.file-pill.show{display:flex;}
.file-pill-name{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:500;min-width:0;}
.file-pill-name i{color:var(--accent);flex-shrink:0;}
.file-pill-name span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.btn-rm{background:none;border:none;color:var(--red);cursor:pointer;padding:4px 6px;border-radius:6px;font-size:12px;transition:var(--tr);}
.btn-rm:hover{background:rgba(240,82,82,.1);}

/* requirements */
.reqs{background:var(--req-bg);border:1px solid var(--border);border-radius:var(--r-md);padding:12px 14px;}
.reqs-title{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:8px;}
.req-item{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);padding:3px 0;}
.req-item i{color:var(--green);font-size:10px;flex-shrink:0;}

/* ══ SUBMIT SECTION ══ */
.submit-section{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);padding:18px;margin-top:14px;}
.submit-row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.btn-back{display:inline-flex;align-items:center;gap:7px;padding:11px 18px;border-radius:10px;font-size:13px;font-weight:500;background:var(--bg-card2);border:1px solid var(--border2);color:var(--muted);cursor:pointer;transition:var(--tr);}
.btn-back:hover{color:var(--text);border-color:var(--accent);}
.btn-submit{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:10px;font-size:13px;font-weight:500;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border:none;cursor:pointer;transition:var(--tr);}
.btn-submit:hover{opacity:.88;transform:translateY(-1px);}
.btn-submit:disabled{opacity:.5;pointer-events:none;}
.submit-spinner{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin 1s linear infinite;display:none;}

/* ══ TOAST ══ */
.toast-wrap{position:fixed;top:16px;right:16px;z-index:5000;display:flex;flex-direction:column;gap:8px;}
.toast{padding:12px 16px;border-radius:10px;font-size:13px;font-weight:500;color:#fff;max-width:320px;opacity:0;transform:translateY(-10px);transition:opacity .35s,transform .35s;pointer-events:none;display:flex;align-items:center;gap:8px;}
.toast.show{opacity:1;transform:none;pointer-events:auto;}
.toast.success{background:#22c78a;}
.toast.error{background:#f05252;}

/* ══ SIDEBAR OVERLAY ══ */
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:190;}
.sb-overlay.show{display:block;}

/* ══ MODAL ══ */
.modal-backdrop{display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.6);backdrop-filter:blur(6px);align-items:flex-end;justify-content:center;}
.modal-backdrop.open{display:flex;}
.modal-box{background:var(--bg-card);border:1px solid var(--border2);border-radius:var(--r-xl) var(--r-xl) 0 0;width:100%;max-width:520px;max-height:92vh;overflow-y:auto;animation:shup .28s cubic-bezier(.16,1,.3,1);}
@keyframes shup{from{transform:translateY(30px);opacity:0;}to{transform:none;opacity:1;}}
.modal-handle{width:36px;height:4px;border-radius:2px;background:var(--border2);margin:12px auto 0;}
.modal-header{padding:16px 20px 0;display:flex;align-items:center;justify-content:space-between;}
.modal-title{font-size:15px;font-weight:500;}
.modal-close{background:none;border:none;color:var(--muted);cursor:pointer;font-size:17px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:7px;transition:var(--tr);}
.modal-close:hover{background:var(--bg-card2);color:var(--text);}
.modal-body{padding:18px 20px;}
.modal-body img{max-width:100%;border-radius:var(--r-md);}
.modal-body iframe{width:100%;height:70vh;border:none;border-radius:var(--r-md);}
.modal-footer{padding:0 20px 24px;display:flex;gap:10px;}
.btn{border:none;border-radius:10px;padding:11px 18px;font-size:13px;font-weight:500;cursor:pointer;transition:var(--tr);flex:1;}
.btn-ghost{background:var(--bg-card2);color:var(--muted);}
.btn-ghost:hover{color:var(--text);}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;flex:2;}
.btn-primary:hover{opacity:.88;}
.result-modal{text-align:center;padding:28px 20px;}
.result-icon{width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:24px;}
.result-icon.success{background:rgba(34,199,138,.12);color:var(--green);}
.result-icon.error{background:rgba(240,82,82,.12);color:var(--red);}
.result-title{font-size:17px;font-weight:500;margin-bottom:7px;}
.result-msg{font-size:13px;color:var(--muted);margin-bottom:20px;line-height:1.6;}

/* Powered by */
.powered-by{position:fixed;bottom:12px;right:14px;font-size:11px;color:var(--muted);z-index:50;}
.powered-by strong{color:var(--accent);}

/* ══ RESPONSIVE ══ */
@media(max-width:900px){
  .sidebar{transform:translateX(calc(-1 * var(--sidebar-w)));}
  .sidebar.open{transform:none;box-shadow:4px 0 24px rgba(0,0,0,.3);}
  .topnav{left:0;}
  .main{margin-left:0;}
  .hamburger{display:flex;}
}
@media(max-width:600px){
  .main{padding:14px;}
  .topnav-greeting p{display:none;}
  .status-label{display:none;}
  .modal-box{max-width:100%;}
  .id-fields{grid-template-columns:1fr;}
  .progress-steps{grid-template-columns:repeat(2,1fr);}
  .kyc-hero{flex-direction:column;align-items:flex-start;}
  .submit-row{flex-direction:column-reverse;}
  .btn-back,.btn-submit{width:100%;justify-content:center;}
}
@media(min-width:901px){
  .modal-backdrop{align-items:center;padding:20px;}
  .modal-box{border-radius:var(--r-xl);max-width:600px;}
  .modal-handle{display:none;}
}
@media print{
  .sidebar,.topnav,.powered-by{display:none!important;}
  .main{margin:0;padding:0;}
}
</style>
</head>
<body>

<!-- LOADER -->
<div id="loader">
  <div class="loader-ring"></div>
  <div class="loader-label">Club De Stars</div>
</div>

<div class="toast-wrap" id="toastWrap"></div>

<%
  const pendingGuarantorCount = user.guarantorRequests
    ? user.guarantorRequests.filter(r => r.status === "pending").length : 0;
%>

<div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

<!-- ════ SIDEBAR ════ -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-mark">
      <img src="/media/assets/logo/log.png" alt="Logo"
           onerror="this.style.display='none';this.parentNode.innerHTML='<b>C</b>'">
    </div>
    <div style="min-width:0;">
      <div class="logo-name">Club De Stars</div>
      <div class="logo-sub">Cooperative Society</div>
    </div>
  </div>
  <div class="sidebar-user">
    <div class="user-chip">
      <div class="user-avatar">
        <% if (user.displayPicture) { %>
          <img src="<%= user.displayPicture.replace('public\\','/').replace(/\\/g,'/') %>" alt="">
        <% } else { %>
          <%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName.charAt(0).toUpperCase() %>
        <% } %>
      </div>
      <div style="min-width:0;">
        <div class="user-name"><%= user.firstName %> <%= user.lastName %></div>
        <div class="user-id"><%= user.membershipID %></div>
      </div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">Menu</div>
    <a href="/cds-cooperative/dashboard" class="nav-item"><i class="fas fa-home"></i> Dashboard</a>
    <a href="/cds-cooperative/transaction" class="nav-item"><i class="fas fa-exchange-alt"></i> Transactions</a>
    <a href="/cds-cooperative/loan" class="nav-item"><i class="fas fa-coins"></i> Loans</a>
    <a href="/cds-cooperative/guarantorRequest" class="nav-item">
      <i class="fas fa-user-check"></i> Guarantor
      <% if (pendingGuarantorCount > 0) { %><span class="nav-badge"><%= pendingGuarantorCount %></span><% } %>
    </a>
    <div class="nav-section">Account</div>
    <a href="/manage/kiddies-account" class="nav-item"><i class="fas fa-baby"></i> Kiddies Account</a>
    <a href="/cds-cooperative/profile" class="nav-item"><i class="fas fa-user"></i> Profile</a>
    <a href="/cds-cooperative/kyc" class="nav-item active"><i class="fas fa-shield-alt"></i> KYC</a>
    <a href="/cds-cooperative/referral" class="nav-item"><i class="fas fa-user-plus"></i> Referrals</a>
    <a href="/cds-cooperative/report" class="nav-item"><i class="fas fa-chart-bar"></i> Reports</a>
    <a href="/cds-cooperative/memberContract" class="nav-item"><i class="fas fa-file-alt"></i> Terms</a>
    <% if (user.role && user.role.name !== 'member') { %>
    <div class="nav-section">Admin</div>
    <a href="/admin-dashboard" class="nav-item"><i class="fas fa-tachometer-alt"></i> Administration</a>
    <% } %>
  </nav>
  <div class="sidebar-footer">
    <div class="member-pill">
      <i class="fas fa-star" style="font-size:9px;"></i>
      <%= user.membershipID.startsWith('CD') ? 'Club Member' : 'Associate Member' %>
    </div>
    <a href="/logout" class="nav-item" style="color:var(--red);margin-top:2px;">
      <i class="fas fa-sign-out-alt"></i> Sign Out
    </a>
  </div>
</aside>

<!-- ════ TOP NAV ════ -->
<header class="topnav">
  <button class="hamburger" onclick="toggleSidebar()" aria-label="Menu">
    <i class="fas fa-bars"></i>
  </button>
  <div class="topnav-greeting">
    <h2>KYC Verification</h2>
    <p>Upload your documents to activate your account</p>
  </div>
  <div class="topnav-right">
    <div class="status-row">
      <div class="status-dot"></div>
      <span class="status-label">Active</span>
    </div>
    <% if (user.Payment && user.Payment.status === "paid") { %>
      <div class="kyc-chip verified">
        <i class="fas fa-shield-alt" style="font-size:11px;"></i><span>Verified</span>
      </div>
    <% } else { %>
      <div class="kyc-chip">
        <i class="fas fa-shield-alt" style="font-size:11px;"></i><span>KYC</span>
      </div>
    <% } %>
    <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme">
      <div class="tog-thumb" id="togThumb">
        <i class="fas fa-moon" id="togIcon" style="font-size:9px;"></i>
      </div>
    </button>
  </div>
</header>

<!-- ════ MAIN ════ -->
<main class="main">

  <!-- Flash messages -->
  <% if (typeof success !== 'undefined' && success) { %>
  <div class="alert-bar alert-success" style="margin-bottom:14px;">
    <i class="fas fa-check-circle"></i>
    <span><%= success %></span>
  </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-bar alert-error" style="margin-bottom:14px;">
    <i class="fas fa-times-circle"></i>
    <span><%= error %></span>
  </div>
  <% } %>

  <!-- Hero -->
  <div class="kyc-hero">
    <div class="kyc-hero-icon"><i class="fas fa-shield-alt"></i></div>
    <div class="kyc-hero-info">
      <div class="kyc-hero-title">Identity Verification</div>
      <div class="kyc-hero-sub">Complete all 4 sections below to activate your account. Documents are reviewed within 24–48 hours.</div>
    </div>
    <% if (user.Payment && user.Payment.status === "paid") { %>
    <div style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:20px;background:rgba(34,199,138,.1);border:1px solid rgba(34,199,138,.2);color:var(--green);font-size:12px;font-weight:600;flex-shrink:0;">
      <i class="fas fa-check-circle" style="font-size:13px;"></i> Verified
    </div>
    <% } %>
  </div>

  <!-- Progress -->
  <div class="progress-card">
    <div class="progress-header">
      <span class="progress-label"><i class="fas fa-tasks" style="margin-right:6px;color:var(--accent);"></i>Verification Progress</span>
      <span class="progress-pct" id="progressText">0%</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" id="progressBar" style="width:0%"></div>
    </div>
    <div class="progress-steps">
      <div class="progress-step">
        <div class="step-dot <%= kycDocs.addressProof ? 'done' : '' %>" id="stepAddress">
          <i class="fas fa-<%= kycDocs.addressProof ? 'check' : 'home' %>"></i>
        </div>
        <span class="step-label">Address</span>
      </div>
      <div class="progress-step">
        <div class="step-dot <%= kycDocs.passportPhoto ? 'done' : '' %>" id="stepPassport">
          <i class="fas fa-<%= kycDocs.passportPhoto ? 'check' : 'camera' %>"></i>
        </div>
        <span class="step-label">Passport</span>
      </div>
      <div class="progress-step">
        <div class="step-dot <%= kycDocs.idFile ? 'done' : '' %>" id="stepId">
          <i class="fas fa-<%= kycDocs.idFile ? 'check' : 'id-card' %>"></i>
        </div>
        <span class="step-label">ID</span>
      </div>
      <div class="progress-step">
        <div class="step-dot <%= kycDocs.signature ? 'done' : '' %>" id="stepSig">
          <i class="fas fa-<%= kycDocs.signature ? 'check' : 'signature' %>"></i>
        </div>
        <span class="step-label">Signature</span>
      </div>
    </div>
  </div>

  <!-- Important notice -->
  <div class="alert-bar alert-warn">
    <i class="fas fa-exclamation-triangle"></i>
    <div>
      <strong style="display:block;margin-bottom:3px;">Important</strong>
      All documents must be clear and legible · Max 5MB per file · Accepted: JPG, PNG, PDF · Reviewed within 24–48 hours
    </div>
  </div>

  <form id="kycForm" enctype="multipart/form-data">

    <!-- ══ 1. PROOF OF ADDRESS ══ -->
    <div class="doc-card <%= kycDocs.addressProof ? 'done' : '' %> open" id="addressProofItem">
      <div class="doc-card-header" onclick="toggleCard('addressProofItem')">
        <div class="doc-icon doc-icon-blue"><i class="fas fa-file-invoice"></i></div>
        <div class="doc-info">
          <div class="doc-name">Proof of Address</div>
          <div class="doc-sub">Utility bill, bank statement, or official letter</div>
        </div>
        <div class="doc-status <%= kycDocs.addressProof ? 'uploaded' : 'pending' %>" id="addressStatus">
          <i class="fas fa-<%= kycDocs.addressProof ? 'check-circle' : 'clock' %>"></i>
          <%= kycDocs.addressProof ? 'Uploaded' : 'Pending' %>
        </div>
        <i class="fas fa-chevron-down doc-chevron"></i>
      </div>
      <div class="doc-body">
        <% if (kycDocs.addressProof) { %>
        <div class="existing-banner" id="addressExistingBanner">
          <div class="existing-info">
            <i class="fas fa-check-circle"></i> Document already on file
          </div>
          <div class="existing-actions">
            <button type="button" class="btn-view" data-url="<%= kycDocs.addressProof %>" data-title="Proof of Address" onclick="viewDocument(this.dataset.url,this.dataset.title)">
              <i class="fas fa-eye"></i> View
            </button>
            <button type="button" class="btn-replace" onclick="toggleReplaceArea('address')">
              <i class="fas fa-sync-alt"></i> Replace
            </button>
          </div>
        </div>
        <div class="replace-wrap" id="addressReplaceArea">
        <% } %>
        <div class="upload-zone" id="addressUploadArea" onclick="document.getElementById('addressProof').click()">
          <div class="upload-zone-icon"><i class="fas fa-cloud-upload-alt"></i></div>
          <div class="upload-zone-text">Click to upload or drag and drop</div>
          <div class="upload-zone-hint">PDF, JPG, PNG · Max 5MB</div>
        </div>
        <input type="file" id="addressProof" name="addressProof" accept="image/*,.pdf" style="display:none;" onchange="handleFileSelect(this,'address',5)">
        <div class="file-pill" id="addressPreview">
          <div class="file-pill-name"><i class="fas fa-file-alt"></i><span id="addressFileName"></span></div>
          <button type="button" class="btn-rm" onclick="removeFile('address')"><i class="fas fa-times"></i></button>
        </div>
        <% if (kycDocs.addressProof) { %></div><% } %>
        <div class="reqs">
          <div class="reqs-title">Requirements</div>
          <div class="req-item"><i class="fas fa-check"></i> Must show your full name</div>
          <div class="req-item"><i class="fas fa-check"></i> Must show your current address</div>
          <div class="req-item"><i class="fas fa-check"></i> Dated within last 3 months</div>
        </div>
      </div>
    </div>

    <!-- ══ 2. PASSPORT PHOTO ══ -->
    <div class="doc-card <%= kycDocs.passportPhoto ? 'done' : '' %>" id="passportItem">
      <div class="doc-card-header" onclick="toggleCard('passportItem')">
        <div class="doc-icon doc-icon-green"><i class="fas fa-camera"></i></div>
        <div class="doc-info">
          <div class="doc-name">Passport Photograph</div>
          <div class="doc-sub">Clear photo with white or light background</div>
        </div>
        <div class="doc-status <%= kycDocs.passportPhoto ? 'uploaded' : 'pending' %>" id="passportStatus">
          <i class="fas fa-<%= kycDocs.passportPhoto ? 'check-circle' : 'clock' %>"></i>
          <%= kycDocs.passportPhoto ? 'Uploaded' : 'Pending' %>
        </div>
        <i class="fas fa-chevron-down doc-chevron"></i>
      </div>
      <div class="doc-body">
        <% if (kycDocs.passportPhoto) { %>
        <div class="existing-banner" id="passportExistingBanner">
          <div class="existing-info"><i class="fas fa-check-circle"></i> Photo already on file</div>
          <div class="existing-actions">
            <button type="button" class="btn-view" data-url="<%= kycDocs.passportPhoto %>" data-title="Passport Photo" onclick="viewDocument(this.dataset.url,this.dataset.title)">
              <i class="fas fa-eye"></i> View
            </button>
            <button type="button" class="btn-replace" onclick="toggleReplaceArea('passport')">
              <i class="fas fa-sync-alt"></i> Replace
            </button>
          </div>
        </div>
        <div class="replace-wrap" id="passportReplaceArea">
        <% } %>
        <div class="upload-zone" id="passportUploadArea" onclick="document.getElementById('passportPhoto').click()">
          <div class="upload-zone-icon"><i class="fas fa-cloud-upload-alt"></i></div>
          <div class="upload-zone-text">Click to upload or drag and drop</div>
          <div class="upload-zone-hint">JPG, PNG · Max 5MB</div>
        </div>
        <input type="file" id="passportPhoto" name="passportPhoto" accept="image/*" style="display:none;" onchange="handleFileSelect(this,'passport',5)">
        <div class="file-pill" id="passportPreview">
          <div class="file-pill-name"><i class="fas fa-file-image"></i><span id="passportFileName"></span></div>
          <button type="button" class="btn-rm" onclick="removeFile('passport')"><i class="fas fa-times"></i></button>
        </div>
        <% if (kycDocs.passportPhoto) { %></div><% } %>
        <div class="reqs">
          <div class="reqs-title">Requirements</div>
          <div class="req-item"><i class="fas fa-check"></i> Recent photo — within 6 months</div>
          <div class="req-item"><i class="fas fa-check"></i> Clear face, no sunglasses</div>
          <div class="req-item"><i class="fas fa-check"></i> White or light background</div>
        </div>
      </div>
    </div>

    <!-- ══ 3. GOVERNMENT ID ══ -->
    <div class="doc-card <%= kycDocs.idFile ? 'done' : '' %>" id="idItem">
      <div class="doc-card-header" onclick="toggleCard('idItem')">
        <div class="doc-icon doc-icon-amber"><i class="fas fa-id-badge"></i></div>
        <div class="doc-info">
          <div class="doc-name">Government-Issued ID</div>
          <div class="doc-sub">National ID, Passport, Driver's License, or Voter's Card</div>
        </div>
        <div class="doc-status <%= kycDocs.idFile ? 'uploaded' : 'pending' %>" id="idStatus">
          <i class="fas fa-<%= kycDocs.idFile ? 'check-circle' : 'clock' %>"></i>
          <%= kycDocs.idFile ? 'Uploaded' : 'Pending' %>
        </div>
        <i class="fas fa-chevron-down doc-chevron"></i>
      </div>
      <div class="doc-body">
        <div class="id-fields">
          <div class="form-group">
            <label class="form-label">ID Type *</label>
            <select class="form-control" id="idType" name="idType">
              <option value="">Select type…</option>
              <option value="nin"      <%= user.idType === 'nin'      ? 'selected' : '' %>>National ID (NIN)</option>
              <option value="passport" <%= user.idType === 'passport' ? 'selected' : '' %>>International Passport</option>
              <option value="drivers"  <%= user.idType === 'drivers'  ? 'selected' : '' %>>Driver's License</option>
              <option value="voters"   <%= user.idType === 'voters'   ? 'selected' : '' %>>Voter's Card</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">ID Number *</label>
            <input type="text" class="form-control" id="idNumber" name="idNumber" placeholder="Enter ID number" value="<%= user.idNumber || '' %>">
          </div>
        </div>
        <% if (kycDocs.idFile) { %>
        <div class="existing-banner" id="idExistingBanner">
          <div class="existing-info"><i class="fas fa-check-circle"></i> ID document already on file</div>
          <div class="existing-actions">
            <button type="button" class="btn-view" data-url="<%= kycDocs.idFile %>" data-title="Government ID" onclick="viewDocument(this.dataset.url,this.dataset.title)">
              <i class="fas fa-eye"></i> View
            </button>
            <button type="button" class="btn-replace" onclick="toggleReplaceArea('id')">
              <i class="fas fa-sync-alt"></i> Replace
            </button>
          </div>
        </div>
        <div class="replace-wrap" id="idReplaceArea">
        <% } %>
        <div class="upload-zone" id="idUploadArea" onclick="document.getElementById('idFile').click()">
          <div class="upload-zone-icon"><i class="fas fa-cloud-upload-alt"></i></div>
          <div class="upload-zone-text">Click to upload or drag and drop</div>
          <div class="upload-zone-hint">PDF, JPG, PNG · Max 5MB</div>
        </div>
        <input type="file" id="idFile" name="idFile" accept="image/*,.pdf" style="display:none;" onchange="handleFileSelect(this,'id',5)">
        <div class="file-pill" id="idPreview">
          <div class="file-pill-name"><i class="fas fa-file-alt"></i><span id="idFileName"></span></div>
          <button type="button" class="btn-rm" onclick="removeFile('id')"><i class="fas fa-times"></i></button>
        </div>
        <% if (kycDocs.idFile) { %></div><% } %>
        <div class="reqs">
          <div class="reqs-title">Requirements</div>
          <div class="req-item"><i class="fas fa-check"></i> Valid and not expired</div>
          <div class="req-item"><i class="fas fa-check"></i> All text clearly readable</div>
          <div class="req-item"><i class="fas fa-check"></i> Upload front and back if applicable</div>
        </div>
      </div>
    </div>

    <!-- ══ 4. SIGNATURE ══ -->
    <div class="doc-card <%= kycDocs.signature ? 'done' : '' %>" id="signatureItem">
      <div class="doc-card-header" onclick="toggleCard('signatureItem')">
        <div class="doc-icon doc-icon-cyan"><i class="fas fa-pen-fancy"></i></div>
        <div class="doc-info">
          <div class="doc-name">Signature</div>
          <div class="doc-sub">Signature on white paper or digital signature</div>
        </div>
        <div class="doc-status <%= kycDocs.signature ? 'uploaded' : 'pending' %>" id="signatureStatus">
          <i class="fas fa-<%= kycDocs.signature ? 'check-circle' : 'clock' %>"></i>
          <%= kycDocs.signature ? 'Uploaded' : 'Pending' %>
        </div>
        <i class="fas fa-chevron-down doc-chevron"></i>
      </div>
      <div class="doc-body">
        <% if (kycDocs.signature) { %>
        <div class="existing-banner" id="signatureExistingBanner">
          <div class="existing-info"><i class="fas fa-check-circle"></i> Signature already on file</div>
          <div class="existing-actions">
            <button type="button" class="btn-view" data-url="<%= kycDocs.signature %>" data-title="Signature" onclick="viewDocument(this.dataset.url,this.dataset.title)">
              <i class="fas fa-eye"></i> View
            </button>
            <button type="button" class="btn-replace" onclick="toggleReplaceArea('signature')">
              <i class="fas fa-sync-alt"></i> Replace
            </button>
          </div>
        </div>
        <div class="replace-wrap" id="signatureReplaceArea">
        <% } %>
        <div class="upload-zone" id="signatureUploadArea" onclick="document.getElementById('signature').click()">
          <div class="upload-zone-icon"><i class="fas fa-cloud-upload-alt"></i></div>
          <div class="upload-zone-text">Click to upload or drag and drop</div>
          <div class="upload-zone-hint">JPG, PNG · Max 2MB</div>
        </div>
        <input type="file" id="signature" name="signature" accept="image/*" style="display:none;" onchange="handleFileSelect(this,'signature',2)">
        <div class="file-pill" id="signaturePreview">
          <div class="file-pill-name"><i class="fas fa-file-image"></i><span id="signatureFileName"></span></div>
          <button type="button" class="btn-rm" onclick="removeFile('signature')"><i class="fas fa-times"></i></button>
        </div>
        <% if (kycDocs.signature) { %></div><% } %>
        <div class="reqs">
          <div class="reqs-title">Requirements</div>
          <div class="req-item"><i class="fas fa-check"></i> Clear and legible signature</div>
          <div class="req-item"><i class="fas fa-check"></i> White or light background</div>
          <div class="req-item"><i class="fas fa-check"></i> No watermarks or logos</div>
        </div>
      </div>
    </div>

    <!-- ══ SUBMIT ══ -->
    <div class="submit-section">
      <div class="alert-bar alert-info" style="margin-bottom:14px;">
        <i class="fas fa-info-circle"></i>
        <span>All documents are encrypted and stored securely. You'll be notified once verification is complete.</span>
      </div>
      <div class="submit-row">
        <a href="/cds-cooperative/dashboard" class="btn-back">
          <i class="fas fa-arrow-left" style="font-size:11px;"></i> Dashboard
        </a>
        <button type="submit" class="btn-submit" id="submitBtn">
          <i class="fas fa-paper-plane" style="font-size:12px;"></i>
          <span id="submitText"><%= kycStatus === 'submitted' ? 'Update Documents' : 'Submit Documents' %></span>
          <div class="submit-spinner" id="submitSpinner"></div>
        </button>
      </div>
    </div>

  </form>

</main>

<div class="powered-by">Powered by <strong>JESZ LIMITED</strong></div>

<!-- ════ DOCUMENT VIEWER MODAL ════ -->
<div class="modal-backdrop" id="docViewerModal">
  <div class="modal-box">
    <div class="modal-handle"></div>
    <div class="modal-header">
      <span class="modal-title" id="docViewerTitle"><i class="fas fa-file-alt" style="color:var(--accent);margin-right:8px;font-size:13px;"></i>View Document</span>
      <button class="modal-close" onclick="closeModal('docViewerModal')"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body" id="docViewerContent" style="background:var(--bg-card2);border-radius:var(--r-md);min-height:300px;display:flex;align-items:center;justify-content:center;"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('docViewerModal')">Close</button>
      <a class="btn btn-primary" id="docOpenLink" href="#" target="_blank" style="text-align:center;">
        <i class="fas fa-external-link-alt" style="margin-right:6px;font-size:11px;"></i>Open in New Tab
      </a>
    </div>
  </div>
</div>

<!-- Success Modal -->
<div class="modal-backdrop" id="successModal">
  <div class="modal-box">
    <div class="modal-handle"></div>
    <div class="result-modal">
      <div class="result-icon success"><i class="fas fa-check"></i></div>
      <div class="result-title">Documents Submitted!</div>
      <div class="result-msg">Our team will review your documents within 24–48 hours. You'll receive a notification once verified.</div>
      <button class="btn btn-primary" onclick="window.location.href='/cds-cooperative/kyc'" style="max-width:220px;margin:0 auto;">
        <i class="fas fa-shield-alt" style="margin-right:6px;font-size:11px;"></i>View KYC Status
      </button>
    </div>
  </div>
</div>

<!-- Error Modal -->
<div class="modal-backdrop" id="errorModal">
  <div class="modal-box">
    <div class="modal-handle"></div>
    <div class="result-modal">
      <div class="result-icon error"><i class="fas fa-times"></i></div>
      <div class="result-title">Submission Failed</div>
      <div class="result-msg" id="errorMessage">Unable to submit documents. Please try again.</div>
      <button class="btn btn-ghost" onclick="closeModal('errorModal')" style="max-width:180px;margin:0 auto;">Try Again</button>
    </div>
  </div>
</div>

<!-- ════ SCRIPTS ════ -->
<script>
/* ── Server state ── */
const serverDocs = {
  address:   <%= kycDocs.addressProof  ? 'true' : 'false' %>,
  passport:  <%= kycDocs.passportPhoto ? 'true' : 'false' %>,
  id:        <%= kycDocs.idFile        ? 'true' : 'false' %>,
  signature: <%= kycDocs.signature     ? 'true' : 'false' %>
};
const keyToItem  = { address:'addressProofItem', passport:'passportItem', id:'idItem', signature:'signatureItem' };
const keyToInput = { address:'addressProof', passport:'passportPhoto', id:'idFile', signature:'signature' };
const uploadedFiles = { address:false, passport:false, id:false, signature:false };

/* ── Theme ── */
(function(){
  const saved = localStorage.getItem('cds-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  updateThemeUI(saved);
})();
function toggleTheme(){
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('cds-theme', next);
  updateThemeUI(next);
}
function updateThemeUI(t){
  const i = document.getElementById('togIcon');
  if(i) i.className = t === 'dark' ? 'fas fa-moon' : 'fas fa-sun';
}

/* ── Sidebar ── */
function toggleSidebar(){
  const open = document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sbOverlay').classList.toggle('show', open);
  document.body.style.overflow = open ? 'hidden' : '';
}
function closeSidebar(){
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sbOverlay').classList.remove('show');
  document.body.style.overflow = '';
}
document.addEventListener('click', e => {
  const sb = document.getElementById('sidebar');
  const hb = document.querySelector('.hamburger');
  if(window.innerWidth <= 900 && sb.classList.contains('open') && !sb.contains(e.target) && !hb.contains(e.target)) closeSidebar();
});

/* ── Modals ── */
function openModal(id){ document.getElementById(id).classList.add('open'); document.body.style.overflow='hidden'; }
function closeModal(id){ document.getElementById(id).classList.remove('open'); document.body.style.overflow=''; }
document.querySelectorAll('.modal-backdrop').forEach(el => {
  el.addEventListener('click', e => { if(e.target === el){ el.classList.remove('open'); document.body.style.overflow=''; }});
});

/* ── Toast ── */
function showToast(msg, type = 'success'){
  const wrap = document.getElementById('toastWrap');
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i> ${msg}`;
  wrap.appendChild(t);
  requestAnimationFrame(() => { requestAnimationFrame(() => t.classList.add('show')); });
  setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 400); }, 4000);
}

/* ── Collapsible doc cards ── */
function toggleCard(id){
  document.getElementById(id).classList.toggle('open');
}

/* ── Progress ── */
function updateProgress(){
  const keys = ['address','passport','id','signature'];
  const done = keys.filter(t => serverDocs[t] || uploadedFiles[t]).length;
  const pct  = Math.round((done / 4) * 100);
  document.getElementById('progressBar').style.width = pct + '%';
  document.getElementById('progressText').textContent = pct + '% Complete';
  keys.forEach((k, i) => {
    const stepIds = ['stepAddress','stepPassport','stepId','stepSig'];
    const icons   = ['home','camera','id-card','signature'];
    const dot = document.getElementById(stepIds[i]);
    if(!dot) return;
    const isDone = serverDocs[k] || uploadedFiles[k];
    dot.className = 'step-dot' + (isDone ? ' done' : '');
    dot.innerHTML = `<i class="fas fa-${isDone ? 'check' : icons[i]}"></i>`;
  });
}
updateProgress();

/* ── Toggle replace area ── */
function toggleReplaceArea(key){
  const area = document.getElementById(key + 'ReplaceArea');
  if(!area) return;
  const opening = !area.classList.contains('open');
  area.classList.toggle('open', opening);
  const banner = document.getElementById(key + 'ExistingBanner');
  if(banner){
    const btn = banner.querySelector('.btn-replace');
    if(btn) btn.innerHTML = opening
      ? '<i class="fas fa-times"></i> Cancel'
      : '<i class="fas fa-sync-alt"></i> Replace';
  }
}

/* ── Document viewer ── */
function viewDocument(url, title){
  document.getElementById('docViewerTitle').innerHTML = `<i class="fas fa-file-alt" style="color:var(--accent);margin-right:8px;font-size:13px;"></i>${title}`;
  document.getElementById('docOpenLink').href = url;
  const content = document.getElementById('docViewerContent');
  const isPdf   = url.toLowerCase().endsWith('.pdf');
  if(isPdf){
    content.innerHTML = `<iframe src="${url}" style="width:100%;height:70vh;border:none;border-radius:var(--r-md);display:block;"></iframe>`;
  } else {
    content.innerHTML = `<img src="${url}" alt="${title}"
      onerror="this.style.display='none';this.nextElementSibling.style.display='block';"
      style="max-width:100%;max-height:70vh;object-fit:contain;display:block;margin:auto;padding:12px;border-radius:var(--r-md);">
      <div style="display:none;color:var(--muted);padding:2rem;text-align:center;font-size:13px;">
        Could not load image. <br><a href="${url}" target="_blank" style="color:var(--accent);">Open in new tab →</a>
      </div>`;
  }
  openModal('docViewerModal');
}

/* ── File selection ── */
function handleFileSelect(input, key, maxMB){
  const file = input.files[0];
  if(!file) return;
  if(file.size > maxMB * 1024 * 1024){
    showToast(`File too large — max ${maxMB}MB`, 'error');
    input.value = ''; return;
  }
  const imageOnly  = (key === 'signature' || key === 'passport');
  const validTypes = imageOnly ? ['image/jpeg','image/png'] : ['image/jpeg','image/png','application/pdf'];
  if(!validTypes.includes(file.type)){
    showToast('Invalid file type. Use JPG, PNG' + (imageOnly ? '' : ' or PDF'), 'error');
    input.value = ''; return;
  }
  uploadedFiles[key] = true;
  updateProgress();
  document.getElementById(key + 'FileName').textContent = file.name;
  document.getElementById(key + 'Preview').classList.add('show');
  document.getElementById(keyToItem[key])?.classList.add('done');
  updateStatusBadge(key, 'uploaded');
}

/* ── Remove file ── */
function removeFile(key){
  const input = document.getElementById(keyToInput[key]);
  if(input) input.value = '';
  uploadedFiles[key] = false;
  updateProgress();
  document.getElementById(key + 'Preview')?.classList.remove('show');
  if(!serverDocs[key]){
    document.getElementById(keyToItem[key])?.classList.remove('done');
    updateStatusBadge(key, 'pending');
  }
}

/* ── Status badge ── */
function updateStatusBadge(key, status){
  const badge = document.getElementById(key + 'Status');
  if(!badge) return;
  badge.className = 'doc-status ' + (status === 'uploaded' ? 'uploaded' : 'pending');
  badge.innerHTML  = status === 'uploaded'
    ? '<i class="fas fa-check-circle"></i> Uploaded'
    : '<i class="fas fa-clock"></i> Pending';
}

/* ── Drag & drop ── */
const dropMap = {
  addressUploadArea:   { inputId:'addressProof',  key:'address',   maxMB:5 },
  passportUploadArea:  { inputId:'passportPhoto', key:'passport',  maxMB:5 },
  idUploadArea:        { inputId:'idFile',         key:'id',        maxMB:5 },
  signatureUploadArea: { inputId:'signature',      key:'signature', maxMB:2 }
};
document.querySelectorAll('.upload-zone').forEach(zone => {
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('dragover'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
  zone.addEventListener('drop', e => {
    e.preventDefault(); zone.classList.remove('dragover');
    const info = dropMap[zone.id];
    if(!info || !e.dataTransfer.files.length) return;
    const input = document.getElementById(info.inputId);
    input.files = e.dataTransfer.files;
    handleFileSelect(input, info.key, info.maxMB);
  });
});

/* ── Form submit ── */
document.getElementById('kycForm').addEventListener('submit', async e => {
  e.preventDefault();
  const allPresent = ['address','passport','id','signature'].every(t => serverDocs[t] || uploadedFiles[t]);
  if(!allPresent){ showToast('Please upload all required documents first.', 'error'); return; }
  const idType   = document.getElementById('idType').value;
  const idNumber = document.getElementById('idNumber').value.trim();
  if(!idType || !idNumber){ showToast('Please select ID type and enter your ID number.', 'error'); return; }

  const btn     = document.getElementById('submitBtn');
  const txt     = document.getElementById('submitText');
  const spinner = document.getElementById('submitSpinner');
  btn.disabled = true; txt.textContent = 'Uploading…'; spinner.style.display = 'inline-block';

  try{
    const res    = await fetch('/kyc/submit', { method:'POST', body: new FormData(kycForm) });
    const result = await res.json();
    if(res.ok && result.status){
      openModal('successModal');
    } else {
      document.getElementById('errorMessage').textContent = result.message || 'Unable to submit. Please try again.';
      openModal('errorModal');
    }
  } catch {
    document.getElementById('errorMessage').textContent = 'Network error. Please check your connection.';
    openModal('errorModal');
  } finally {
    btn.disabled = false; spinner.style.display = 'none';
    txt.textContent = (serverDocs.address && serverDocs.passport && serverDocs.id && serverDocs.signature)
      ? 'Update Documents' : 'Submit Documents';
  }
});

/* ── Loader ── */
window.addEventListener('load', () => {
  const l = document.getElementById('loader');
  setTimeout(() => { l.style.opacity = '0'; setTimeout(() => l.style.display = 'none', 500); }, 400);
});

/* ── Entrance animation ── */
document.querySelectorAll('.doc-card').forEach((card, i) => {
  card.style.opacity = '0'; card.style.transform = 'translateY(16px)';
  card.style.transition = 'opacity .4s ease, transform .4s ease';
  setTimeout(() => { card.style.opacity = '1'; card.style.transform = 'translateY(0)'; }, 300 + i * 100);
});

/* ── Server flash toasts ── */
<% if (typeof success !== 'undefined' && success) { %>
window.addEventListener('load', () => showToast('<%= success %>', 'success'));
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
window.addEventListener('load', () => showToast('<%= error %>', 'error'));
<% } %>
</script>
</body>
</html>
