                    <!-- Passport Photograph -->
                    <div class="document-section">
                        <h5 class="fw-bold mb-4" style="color: var(--primary);">
                            <i class="fas fa-user me-2"></i>Passport Photograph
                        </h5>
                        
                        <div class="document-item" id="passportItem">
                            <div class="d-flex align-items-start">
                                <div class="document-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                                    <i class="fas fa-camera"></i>
                                </div>
                                <div class="document-content">
                                    <div class="document-header">
                                        <div class="document-title">
                                            <h6 class="mb-1 fw-bold">Recent Passport Photo</h6>
                                            <small class="text-muted">Clear photo with white background</small>
                                        </div>
                                        <span class="status-badge status-pending" id="passportStatus">
                                            <i class="fas fa-clock"></i> Pending
                                        </span>
                                    </div>
                                    
                                    <div class="upload-area" id="passportUploadArea" onclick="document.getElementById('passportPhoto').click()">
                                        <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color: var(--primary-light);"></i>
                                        <p class="mb-1 fw-semibold">Click to upload or drag and drop</p>
                                        <small class="text-muted">JPG, PNG (Max 5MB)</small>
                                    </div>
                                    <input type="file" id="passportPhoto" name="passportPhoto" accept="image/*" class="d-none" onchange="handleFileSelect(this, 'passport')">
                                    
                                    <div class="file-preview" id="passportPreview">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fas fa-file-image text-primary"></i>
                                            <span id="passportFileName"></span>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFile('passport')">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                    
                                    <div class="requirements-list">
                                        <small class="text-muted fw-semibold d-block mb-2">Requirements:</small>
                                        <ul class="small mb-0 ps-0" style="list-style: none;">
                                            <li><i class="fas fa-check-circle text-success me-2"></i>Recent photo (within 6 months)</li>
                                            <li><i class="fas fa-check-circle text-success me-2"></i>Clear face, no sunglasses</li>
                                            <li><i class="fas fa-check-circle text-success me-2"></i>White or light background</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Means of Identification -->
                    <div class="document-section">
                        <h5 class="fw-bold mb-4" style="color: var(--primary);">
                            <i class="fas fa-id-card me-2"></i>Means of Identification
                        </h5>
                        
                        <div class="document-item" id="idItem">
                            <div class="d-flex align-items-start">
                                <div class="document-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                                    <i class="fas fa-id-badge"></i>
                                </div>
                                <div class="document-content">
                                    <div class="document-header">
                                        <div class="document-title">
                                            <h6 class="mb-1 fw-bold">Government-Issued ID</h6>
                                            <small class="text-muted">National ID, Passport, Driver's License, or Voter's Card</small>
                                        </div>
                                        <span class="status-badge status-pending" id="idStatus">
                                            <i class="fas fa-clock"></i> Pending
                                        </span>
                                    </div>
                                    
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">ID Type *</label>
                                            <select class="form-select" id="idType" name="idType" required>
                                                <option value="">Select ID Type</option>
                                                <option value="nin">National ID (NIN)</option>
                                                <option value="passport">International Passport</option>
                                                <option value="drivers">Driver's License</option>
                                                <option value="voters">Voter's Card</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">ID Number *</label>
                                            <input type="text" class="form-control" id="idNumber" name="idNumber" placeholder="Enter ID number" required>
                                        </div>
                                    </div>
                                    
                                    <div class="upload-area" id="idUploadArea" onclick="document.getElementById('idFile').click()">
                                        <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color: var(--primary-light);"></i>
                                        <p class="mb-1 fw-semibold">Click to upload or drag and drop</p>
                                        <small class="text-muted">PDF, JPG, PNG (Max 5MB)</small>
                                    </div>
                                    <input type="file" id="idFile" name="idFile" accept="image/*,.pdf" class="d-none" onchange="handleFileSelect(this, 'id')">
                                    
                                    <div class="file-preview" id="idPreview">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fas fa-file-alt text-primary"></i>
                                            <span id="idFileName"></span>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFile('id')">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                    
                                    <div class="requirements-list">
                                        <small class="text-muted fw-semibold d-block mb-2">Requirements:</small>
                                        <ul class="small mb-0 ps-0" style="list-style: none;">
                                            <li><i class="fas fa-check-circle text-success me-2"></i>Must be valid and not expired</li>
                                            <li><i class="fas fa-check-circle text-success me-2"></i>All text must be clearly readable</li>
                                            <li><i class="fas fa-check-circle text-success me-2"></i>Upload both front and back if applicable</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Signature -->
                    <div class="document-section">
                        <h5 class="fw-bold mb-4" style="color: var(--primary);">
                            <i class="fas fa-signature me-2"></i>Signature
                        </h5>
                        
                        <div class="document-item" id="signatureItem">
                            <div class="d-flex align-items-start">
                                <div class="document-icon" style="background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); color: white;">
                                    <i class="fas fa-pen-fancy"></i>
                                </div>
                                <div class="document-content">
                                    <div class="document-header">
                                        <div class="document-title">
                                            <h6 class="mb-1 fw-bold">Digital Signature</h6>
                                            <small class="text-muted">Your signature on white paper or digital signature</small>
                                        </div>
                                        <span class="status-badge status-pending" id="signatureStatus">
                                            <i class="fas fa-clock"></i> Pending
                                        </span>
                                    </div>
                                    
                                    <div class="upload-area" id="signatureUploadArea" onclick="document.getElementById('signature').click()">
                                        <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color: var(--primary-light);"></i>
                                        <p class="mb-1 fw-semibold">Click to upload or drag and drop</p>
                                        <small class="text-muted">JPG, PNG (Max 2MB)</small>
                                    </div>
                                    <input type="file" id="signature" name="signature" accept="image/*" class="d-none" onchange="handleFileSelect(this, 'signature')">
                                    
                                    <div class="file-preview" id="signaturePreview">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fas fa-file-image text-primary"></i>
                                            <span id="signatureFileName"></span>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFile('signature')">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                    
                                    <div class="requirements-list">
                                        <small class="text-muted fw-semibold d-block mb-2">Requirements:</small>
                                        <ul class="small mb-0 ps-0" style="list-style: none;">
                                            <li><i class="fas fa-check-circle text-success me-2"></i>Clear and legible signature</li>
                                            <li><i class="fas fa-check-circle text-success me-2"></i>On white or light background</li>
                                            <li><i class="fas fa-check-circle text-success me-2"></i>No watermarks or logos</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Section -->
                    <div class="document-section">
                        <div class="alert-info-custom mb-4">
                            <h6 class="fw-bold mb-2">
                                <i class="fas fa-info-circle me-2"></i>Before You Submit
                            </h6>
                            <ul class="mb-0 ps-3">
                                <li>Ensure all documents are clear and readable</li>
                                <li>Verify that your information matches across all documents</li>
                                <li>Your documents will be kept confidential and secure</li>
                                <li>You'll receive a notification once verification is complete</li>
                            </ul>
                        </div>

                        <div class="d-flex gap-3 flex-wrap justify-content-between align-items-center">
                            <a href="/club-de-star-cooperative/dashboard" class="btn btn-outline-primary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <span id="submitText">Submit Documents</span>
                                <div class="loading-spinner ms-2" id="submitSpinner"></div>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        </div>
        </div>

        <!-- Powered By Footer -->
        <div class="powered-by">
            <strong style="color: var(--primary);">Cloudbaam</strong> Powered by <strong style="color: var(--primary);">JESZ LIMITED</strong>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4" style="border-radius: 20px;">
                <div class="modal-body">
                    <i class="fas fa-check-circle text-success fa-4x mb-3"></i>
                    <h5 class="fw-bold mb-3">Documents Submitted Successfully!</h5>
                    <p class="text-muted mb-4">
                        Your documents have been submitted for verification. Our team will review them within 24-48 hours.
                        You'll receive a notification once your account is verified.
                    </p>
                    <button class="btn btn-success w-100" onclick="window.location.href='/club-de-star-cooperative/dashboard'">
                        Go to Dashboard
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div class="modal fade" id="errorModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4" style="border-radius: 20px;">
                <div class="modal-body">
                    <i class="fas fa-times-circle text-danger fa-4x mb-3"></i>
                    <h5 class="fw-bold mb-3">Submission Failed</h5>
                    <p class="text-muted mb-4" id="errorMessage">
                        Unable to submit documents. Please try again.
                    </p>
                    <button class="btn btn-danger w-100" data-bs-dismiss="modal">
                        Try Again
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        // Track uploaded files
        const uploadedFiles = {
            address: false,
            passport: false,
            id: false,
            signature: false
        };

        // Handle file selection
        function handleFileSelect(input, type) {
            const file = input.files[0];
            
            if (!file) return;

            // Validate file size
            const maxSize = type === 'signature' ? 2 : 5; // MB
            if (file.size > maxSize * 1024 * 1024) {
                alert(`File size exceeds ${maxSize}MB. Please choose a smaller file.`);
                input.value = '';
                return;
            }

            // Validate file type
            const validTypes = type === 'signature' || type === 'passport' 
                ? ['image/jpeg', 'image/png'] 
                : ['image/jpeg', 'image/png', 'application/pdf'];
            
            if (!validTypes.includes(file.type)) {
                alert('Invalid file type. Please upload JPG, PNG' + (type !== 'signature' && type !== 'passport' ? ', or PDF' : ''));
                input.value = '';
                return;
            }

            // Update UI
            uploadedFiles[type] = true;
            updateProgress();
            showFilePreview(type, file.name);
            updateStatus(type, 'completed');
        }

        // Show file preview
        function showFilePreview(type, fileName) {
            const preview = document.getElementById(`${type}Preview`);
            const fileNameSpan = document.getElementById(`${type}FileName`);
            
            fileNameSpan.textContent = fileName;
            preview.classList.add('show');
            
            // Mark item as completed
            document.getElementById(`${type}Item`).classList.add('completed');
        }

        // Remove file
        function removeFile(type) {
            const input = document.getElementById(`${type === 'passport' ? 'passportPhoto' : type === 'address' ? 'addressProof' : type === 'id' ? 'idFile' : 'signature'}`);
            input.value = '';
            
            uploadedFiles[type] = false;
            updateProgress();
            
            const preview = document.getElementById(`${type}Preview`);
            preview.classList.remove('show');
            
            // Remove completed status
            document.getElementById(`${type}Item`).classList.remove('completed');
            updateStatus(type, 'pending');
        }

        // Update status badge
        function updateStatus(type, status) {
            const statusBadge = document.getElementById(`${type}Status`);
            
            if (status === 'completed') {
                statusBadge.className = 'status-badge status-completed';
                statusBadge.innerHTML = '<i class="fas fa-check-circle"></i> Uploaded';
            } else {
                statusBadge.className = 'status-badge status-pending';
                statusBadge.innerHTML = '<i class="fas fa-clock"></i> Pending';
            }
        }

        // Update progress bar
        function updateProgress() {
            const total = Object.keys(uploadedFiles).length;
            const completed = Object.values(uploadedFiles).filter(v => v === true).length;
            const percentage = Math.round((completed / total) * 100);
            
            const progressBar = document.getElementById('progressBar');
            const progressText = document.getElementById('progressText');
            
            progressBar.style.width = percentage + '%';
            progressText.textContent = percentage + '% Complete';
        }

        // Drag and drop functionality
        document.querySelectorAll('.upload-area').forEach(area => {
            area.addEventListener('dragover', (e) => {
                e.preventDefault();
                area.classList.add('dragover');
            });

            area.addEventListener('dragleave', () => {
                area.classList.remove('dragover');
            });

            area.addEventListener('drop', (e) => {
                e.preventDefault();
                area.classList.remove('dragover');
                
                const type = area.id.replace('UploadArea', '').replace('address', 'addressProof').replace('passport', 'passportPhoto').replace('id', 'idFile');
                const input = document.getElementById(type);
                
                if (e.dataTransfer.files.length) {
                    input.files = e.dataTransfer.files;
                    handleFileSelect(input, area.id.replace('UploadArea', ''));
                }
            });
        });

        // Form submission
        document.getElementById('kycForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            // Validate all fields
            if (!uploadedFiles.address || !uploadedFiles.passport || !uploadedFiles.id || !uploadedFiles.signature) {
                alert('Please upload all required documents before submitting.');
                return;
            }

            const idType = document.getElementById('idType').value;
            const idNumber = document.getElementById('idNumber').value;

            if (!idType || !idNumber) {
                alert('Please select ID type and enter ID number.');
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            const submitText = document.getElementById('submitText');
            const submitSpinner = document.getElementById('submitSpinner');

            // Disable button and show spinner
            submitBtn.disabled = true;
            submitText.textContent = 'Uploading...';
            submitSpinner.style.display = 'inline-block';

            try {
                const formData = new FormData(document.getElementById('kycForm'));

                const response = await fetch('/kyc/submit', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (response.ok && result.status) {
                    // Show success modal
                    const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                    successModal.show();
                } else {
                    // Show error modal
                    document.getElementById('errorMessage').textContent = result.message || 'Unable to submit documents. Please try again.';
                    const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                    errorModal.show();
                }
            } catch (error) {
                console.error('KYC submission error:', error);
                document.getElementById('errorMessage').textContent = 'Network error. Please check your connection and try again.';
                const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                errorModal.show();
            } finally {
                submitBtn.disabled = false;
                submitText.textContent = 'Submit Documents';
                submitSpinner.style.display = 'none';
            }
        });

        // Loader
        window.addEventListener("load", () => {
            const loader = document.getElementById("loader-screen");
            const main = document.getElementById("main-content");

            setTimeout(() => {
                loader.style.opacity = "0";
                loader.style.transition = "opacity 0.6s ease";

                setTimeout(() => {
                    loader.style.display = "none";
                    main.classList.remove("hidden");
                }, 600);
            }, 200);
        });

        // Close sidebar when clicking outside (for mobile view)
        document.addEventListener('click', function (event) {
            const sidebar = document.getElementById('sidebar');
            const toggleButton = document.querySelector('.fa-bars');

            if (window.innerWidth <= 992) {
                if (sidebar.classList.contains('active') &&
                    !sidebar.contains(event.target) &&
                    !toggleButton.contains(event.target)) {
                    sidebar.classList.remove('active');
                }
            }
        });

        // Animation on load
        document.addEventListener('DOMContentLoaded', function() {
            const items = document.querySelectorAll('.document-item');
            items.forEach((item, index) => {
                item.style.opacity = '0';
                item.style.transform = 'translateY(20px)';
                item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                
                setTimeout(() => {
                    item.style.opacity = '1';
                    item.style.transform = 'translateY(0)';
                }, index * 150);
            });
        });
    </script>
</body>
</html>