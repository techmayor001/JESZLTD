    <script>
        // Navigation
        function showSection(sectionId, event) {
            if (event) {
                event.preventDefault();
            }
            
            document.querySelectorAll('.content-section').forEach(section => {
                section.style.display = 'none';
            });
            document.getElementById(sectionId).style.display = 'block';
            
            document.querySelectorAll('.sidebar-menu a').forEach(link => {
                link.classList.remove('active');
            });
            
            if (event && event.target) {
                event.target.classList.add('active');
            }

            if (window.innerWidth <= 992) {
                document.getElementById('sidebar').classList.remove('active');
            }
        }

        // Modal Functions
        function openModal(modalId) {
            const modal = new bootstrap.Modal(document.getElementById(modalId));
            modal.show();
        }

        // Toggle beneficiary fields based on type
        function toggleBeneficiaryFields() {
            const type = document.getElementById('beneficiaryType').value;
            const lawyerFields = document.getElementById('lawyerFields');
            
            if (type === 'lawyer') {
                lawyerFields.style.display = 'block';
            } else {
                lawyerFields.style.display = 'none';
            }
        }

        // Savings Calculator
        function calculateSavings() {
            const initial = parseFloat(document.getElementById('initialDeposit').value) || 0;
            const monthly = parseFloat(document.getElementById('monthlyContribution').value) || 0;
            const rate = parseFloat(document.getElementById('interestRate').value) / 100 || 0;
            const years = parseInt(document.getElementById('savingsPeriod').value) || 5;

            if (initial < 10000) {
                alert('Minimum initial deposit is ₦10,000');
                return;
            }

            if (years < 5) {
                alert('Minimum savings period is 5 years');
                return;
            }

            // Calculate compound interest with monthly contributions
            let balance = initial;
            let totalDeposited = initial;
            const monthlyRate = rate / 12;
            const months = years * 12;

            let yearlyData = [];
            
            for (let month = 1; month <= months; month++) {
                // Add monthly contribution
                if (month > 1) {
                    balance += monthly;
                    totalDeposited += monthly;
                }
                
                // Apply monthly interest
                balance += balance * monthlyRate;

                // Store yearly data
                if (month % 12 === 0) {
                    yearlyData.push({
                        year: month / 12,
                        balance: balance,
                        deposited: totalDeposited
                    });
                }
            }

            const totalInterest = balance - totalDeposited;
            const interestPercent = (totalInterest / balance * 100).toFixed(1);

            // Display results
            document.getElementById('calculationPlaceholder').style.display = 'none';
            document.getElementById('calculationResults').style.display = 'block';
            
            document.getElementById('maturityValue').textContent = '₦' + balance.toLocaleString('en-NG', {maximumFractionDigits: 0});
            document.getElementById('totalDeposits').textContent = '₦' + totalDeposited.toLocaleString('en-NG', {maximumFractionDigits: 0});
            document.getElementById('totalInterest').textContent = '₦' + totalInterest.toLocaleString('en-NG', {maximumFractionDigits: 0});
            document.getElementById('interestPercentage').textContent = interestPercent + '% Interest';

            // Update progress bars
            const principalPercent = (totalDeposited / balance * 100);
            const interestPct = 100 - principalPercent;
            document.getElementById('principalBar').style.width = principalPercent + '%';
            document.getElementById('interestBar').style.width = interestPct + '%';

            // Yearly breakdown
            let breakdownHTML = '<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Year</th><th>Balance</th><th>Deposited</th><th>Interest</th></tr></thead><tbody>';
            
            yearlyData.forEach(data => {
                const yearInterest = data.balance - data.deposited;
                breakdownHTML += `
                    <tr>
                        <td>Year ${data.year}</td>
                        <td class="fw-bold">₦${data.balance.toLocaleString('en-NG', {maximumFractionDigits: 0})}</td>
                        <td>₦${data.deposited.toLocaleString('en-NG', {maximumFractionDigits: 0})}</td>
                        <td class="text-success">₦${yearInterest.toLocaleString('en-NG', {maximumFractionDigits: 0})}</td>
                    </tr>
                `;
            });
            
            breakdownHTML += '</tbody></table></div>';
            document.getElementById('yearlyBreakdown').innerHTML = breakdownHTML;
        }

        // Form Submissions
document.getElementById("submitBtn").addEventListener("click", submitKiddiesAccount);

async function submitKiddiesAccount() {
    const form = document.getElementById("createAccountForm");

    // Validate form
    if (!form.reportValidity()) return;

    if (!document.getElementById('agreeTerms').checked) {
        alert('Please agree to the terms and conditions');
        return;
    }

    const submitBtn = document.getElementById("submitBtn");
    const submitSpinner = document.getElementById("submitSpinner");

    // Convert form data to normal JSON
    const data = Object.fromEntries(new FormData(form).entries());

    submitBtn.disabled = true;
    submitSpinner.style.display = "inline-block";

    try {
        const response = await fetch("/api/kiddies/create", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        submitBtn.disabled = false;
        submitSpinner.style.display = "none";

        if (response.ok && result.status) {
            alert("✅ Kiddies Account Created Successfully!\n\nPending admin approval.");

            const modal = bootstrap.Modal.getInstance(document.getElementById("createAccountModal"));
            if (modal) modal.hide();

            setTimeout(() => location.reload(), 1200);
        } else {
            alert(result.message || "Failed to create account.");
        }

    } catch (err) {
        console.error(err);
        submitBtn.disabled = false;
        submitSpinner.style.display = "none";
        alert("Network error. Try again.");
    }
}


        function submitDeposit() {
            const account = document.getElementById('depositAccount').value;
            
            if (!account) {
                alert('Please select a child account');
                return;
            }
            
            alert('✅ Deposit processed successfully!\n\nFunds have been added to the selected account.\nYou will receive a confirmation receipt via email.');
            bootstrap.Modal.getInstance(document.getElementById('depositModal')).hide();
        }

        function submitBeneficiaryUpdate() {
            alert('✅ Beneficiary update request submitted!\n\nYour request will be reviewed within 3-5 business days.\nYou will be notified once the update is approved.');
            bootstrap.Modal.getInstance(document.getElementById('editBeneficiaryModal')).hide();
        }

        // Close sidebar when clicking outside (for mobile view)
        document.addEventListener('click', function (event) {
            const sidebar = document.getElementById('sidebar');
            const toggleButton = document.querySelector('.fa-bars');

            if (window.innerWidth <= 992) {
                if (sidebar.classList.contains('active') &&
                    !sidebar.contains(event.target) &&
                    !toggleButton.contains(event.target)) {
                    sidebar.classList.remove('active');
                }
            }
        });

        // Animation on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.stat-card, .card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                
                setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
</body>
</html>