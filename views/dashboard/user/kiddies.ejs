<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club De Stars - Kiddies Account | Powered by JESZ LIMITED</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --kiddies: #ec4899;
            --kiddies-dark: #be185d;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #06b6d4;
            --sidebar-width: 260px;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 50%, #fdf4ff 100%);
            min-height: 100vh;
        }

        /* ── Loader ── */
        .loader-screen {
            position: fixed; inset: 0;
            background: linear-gradient(135deg, #2d0a1f, #4a0e2e);
            display: flex; justify-content: center; align-items: center;
            z-index: 9999;
        }
        .loader-logo span {
            font-size: 42px; font-weight: 700; color: #f9a8d4;
            display: inline-block; letter-spacing: 1px;
            animation: loaderFloat 1.5s infinite ease-in-out;
        }
        .loader-logo span:nth-child(1)  { animation-delay: 0s;   }
        .loader-logo span:nth-child(2)  { animation-delay: 0.1s; }
        .loader-logo span:nth-child(3)  { animation-delay: 0.2s; }
        .loader-logo span:nth-child(4)  { animation-delay: 0.3s; }
        .loader-logo span:nth-child(5)  { animation-delay: 0.4s; }
        .loader-logo span:nth-child(6)  { animation-delay: 0.5s; }
        .loader-logo span:nth-child(7)  { animation-delay: 0.6s; }
        .loader-logo span:nth-child(8)  { animation-delay: 0.7s; }
        .loader-logo span:nth-child(9)  { animation-delay: 0.8s; }
        @keyframes loaderFloat {
            0%,100% { transform: translateY(0); opacity:0.5; }
            50%      { transform: translateY(-12px); opacity:1; }
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed; left:0; top:0; bottom:0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #be185d 0%, #db2777 50%, #ec4899 100%);
            color: white; z-index: 1040; overflow-y: auto;
            transition: all 0.3s;
            box-shadow: 4px 0 20px rgba(236,72,153,0.2);
        }
        .sidebar::-webkit-scrollbar { width:3px; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius:3px; }
        .sidebar-header {
            padding: 1.25rem;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            background: rgba(0,0,0,0.12);
        }
        .logo-box {
            width:38px; height:38px; background:white; border-radius:9px;
            display:flex; align-items:center; justify-content:center;
            color: var(--kiddies); font-size:1.1rem; font-weight:bold;
            box-shadow:0 3px 8px rgba(0,0,0,0.2); flex-shrink:0;
        }
        .sidebar-menu a {
            color:rgba(255,255,255,0.82); text-decoration:none;
            padding:0.7rem 1.25rem; display:flex; align-items:center;
            transition:all 0.25s; border-left:3px solid transparent;
            font-weight:500; font-size:0.875rem;
        }
        .sidebar-menu a:hover  { background:rgba(255,255,255,0.1); color:white; border-left-color:rgba(255,255,255,0.7); }
        .sidebar-menu a.active { background:rgba(255,255,255,0.16); color:white; border-left-color:white; }
        .sidebar-menu a i { width:20px; margin-right:10px; font-size:0.9rem; flex-shrink:0; }

        /* ── Top Navbar ── */
        .top-navbar {
            position:fixed; top:0; left:var(--sidebar-width); right:0;
            height:62px; background:rgba(255,255,255,0.97);
            backdrop-filter:blur(10px);
            box-shadow:0 2px 12px rgba(190,24,93,0.1);
            z-index:1030; display:flex; align-items:center; padding:0 1.5rem;
            transition:all 0.3s;
            border-bottom:1px solid rgba(236,72,153,0.12);
        }

        /* ── Main content ── */
        .main-content {
            margin-left:var(--sidebar-width); margin-top:62px;
            padding:1.25rem; min-height:calc(100vh - 62px);
            transition:all 0.3s;
        }

        /* ── Welcome card ── */
        .welcome-card {
            background:linear-gradient(135deg, #be185d 0%, #db2777 50%, #ec4899 100%);
            color:white; border-radius:16px; padding:1.4rem 1.5rem;
            margin-bottom:1rem; box-shadow:0 8px 24px rgba(190,24,93,0.25);
            position:relative; overflow:hidden;
        }
        .welcome-card::before {
            content:''; position:absolute; top:-60%; right:-10%;
            width:300px; height:300px;
            background:rgba(255,255,255,0.04); border-radius:50%;
        }

        /* ── Stat cards ── */
        .stat-card {
            background:white; border-radius:14px; padding:1rem;
            box-shadow:0 3px 12px rgba(190,24,93,0.08);
            transition:transform 0.25s, box-shadow 0.25s;
            height:100%; border:1px solid rgba(236,72,153,0.06);
        }
        .stat-card:hover { transform:translateY(-4px); box-shadow:0 8px 22px rgba(190,24,93,0.15); }
        .stat-icon {
            width:40px; height:40px; border-radius:10px;
            display:flex; align-items:center; justify-content:center;
            font-size:1rem; margin-bottom:0.6rem;
        }

        /* ── Cards ── */
        .card {
            border:none; border-radius:14px;
            box-shadow:0 3px 12px rgba(190,24,93,0.07); background:white;
            border:1px solid rgba(236,72,153,0.05);
        }
        .card-header {
            background:rgba(236,72,153,0.02);
            border-bottom:1px solid rgba(236,72,153,0.1);
            padding:0.9rem 1.25rem; border-radius:14px 14px 0 0 !important;
        }

        /* ── Kid card ── */
        .kid-card {
            background:linear-gradient(135deg, rgba(236,72,153,0.04) 0%, rgba(219,39,119,0.04) 100%);
            border:2px solid rgba(236,72,153,0.12); border-radius:14px;
            padding:1.25rem; transition:all 0.25s; cursor:pointer;
        }
        .kid-card:hover {
            border-color:var(--kiddies);
            box-shadow:0 8px 25px rgba(236,72,153,0.15);
            transform:translateY(-4px);
        }
        .kid-avatar {
            width:64px; height:64px; border-radius:50%;
            background:linear-gradient(135deg, #ec4899 0%, #be185d 100%);
            display:flex; align-items:center; justify-content:center;
            font-size:1.6rem; color:white; margin:0 auto 0.75rem;
            box-shadow:0 4px 14px rgba(236,72,153,0.25);
        }

        /* ── Badges ── */
        .kid-badge {
            display:inline-flex; align-items:center; gap:5px;
            padding:4px 10px; background:rgba(255,255,255,0.18);
            backdrop-filter:blur(10px); border-radius:20px;
            border:1px solid rgba(255,255,255,0.25);
            font-weight:600; font-size:0.75rem;
        }

        /* ── Progress ── */
        .progress { height:8px; border-radius:8px; background:rgba(236,72,153,0.1); }
        .progress-bar { background:linear-gradient(90deg, #ec4899 0%, #be185d 100%); border-radius:8px; }

        /* ── Quick actions ── */
        .quick-action {
            text-align:center; padding:1rem 0.6rem; border-radius:12px;
            background:rgba(236,72,153,0.025);
            border:1.5px solid rgba(236,72,153,0.1);
            transition:all 0.25s; cursor:pointer;
            text-decoration:none; color:inherit; display:block;
        }
        .quick-action:hover {
            background:linear-gradient(135deg, #ec4899 0%, #be185d 100%);
            color:white; transform:translateY(-3px);
            box-shadow:0 8px 22px rgba(236,72,153,0.25);
            border-color:transparent;
        }
        .quick-action i { font-size:1.5rem; margin-bottom:0.4rem; display:block; }
        .quick-action h6 { font-size:0.78rem; margin:0; }

        /* ── Alerts ── */
        .alert-kiddies {
            background:#fdf2f8; border:1px solid rgba(236,72,153,0.25);
            border-radius:11px; padding:0.8rem 1rem; color:#831843;
        }
        .alert-warning-k {
            background:#fffbeb; border:1px solid rgba(245,158,11,0.3);
            border-radius:11px; padding:0.8rem 1rem; color:#92400e;
        }
        .alert-info-k {
            background:#eff6ff; border:1px solid rgba(59,130,246,0.25);
            border-radius:11px; padding:0.8rem 1rem; color:#1e40af;
        }

        /* ── Status pill ── */
        .status-pill {
            font-size:0.68rem; font-weight:700; text-transform:uppercase;
            letter-spacing:0.05em; padding:3px 9px; border-radius:20px;
        }
        .status-active   { background:rgba(16,185,129,0.1); color:#065f46; }
        .status-locked   { background:rgba(245,158,11,0.1); color:#92400e; }
        .status-pending  { background:rgba(236,72,153,0.1); color:#831843; }
        .status-closed   { background:rgba(107,114,128,0.1); color:#374151; }

        /* ── Payment notice ── */
        .payment-notice {
            background:linear-gradient(135deg, rgba(236,72,153,0.06), rgba(219,39,119,0.06));
            border:2px dashed rgba(236,72,153,0.35); border-radius:12px;
            padding:0.85rem; text-align:center;
        }

        /* ── Toast ── */
        .toast-container { position:fixed; top:70px; right:16px; z-index:9000; }

        /* ── Sidebar overlay ── */
        .sb-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.38); z-index:1039; }
        .sb-overlay.show { display:block; }

        /* ── Share stat card extras ── */
        .share-pill {
            display:inline-flex; align-items:center; gap:4px;
            background:rgba(236,72,153,0.08); border:1px solid rgba(236,72,153,0.2);
            border-radius:20px; padding:2px 8px;
            font-size:0.68rem; font-weight:700; color:var(--kiddies);
        }

        /* ── Payment method tabs ── */
        .pay-method-btn {
            border:2px solid rgba(236,72,153,0.2);
            border-radius:10px; padding:10px 12px; cursor:pointer;
            background:white; transition:all 0.2s; text-align:center;
            display:flex; flex-direction:column; align-items:center; gap:4px;
        }
        .pay-method-btn:hover { border-color:var(--kiddies); background:rgba(236,72,153,0.03); }
        .pay-method-btn.selected {
            border-color:var(--kiddies); background:rgba(236,72,153,0.06);
            box-shadow:0 0 0 3px rgba(236,72,153,0.12);
        }
        .pay-method-btn i { font-size:1.1rem; }
        .pay-method-btn span { font-size:0.7rem; font-weight:600; color:#374151; line-height:1.2; }

        /* ── Responsive ── */
        @media (max-width:992px) {
            .sidebar { left:calc(-1 * var(--sidebar-width)); }
            .sidebar.active { left:0; box-shadow:6px 0 30px rgba(0,0,0,0.25); }
            .top-navbar { left:0; }
            .main-content { margin-left:0; }
        }
        @media (max-width:576px) {
            .main-content { padding:0.85rem; }
            .welcome-card { padding:1rem; }
        }
    </style>
</head>
<body>

<!-- Loader -->
<div id="loaderScreen" class="loader-screen">
    <div class="loader-logo">
        <span>K</span><span>i</span><span>d</span><span>d</span><span>i</span><span>e</span><span>s</span><span> </span><span>✨</span>
    </div>
</div>

<div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

<!-- ══ SIDEBAR ══ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="d-flex align-items-center gap-2 mb-2">
            <div class="logo-box"><i class="fas fa-child"></i></div>
            <div>
                <h6 class="mb-0 fw-bold" style="font-size:0.82rem;text-transform:uppercase;">Kiddies Account</h6>
                <small style="opacity:0.65;font-size:0.66rem;">FUTURE SAVINGS PLAN</small>
            </div>
        </div>
        <div class="kid-badge"><i class="fas fa-star" style="font-size:0.68rem;"></i><span>Parent Dashboard</span></div>
    </div>
    <div class="sidebar-menu">
        <a href="#" onclick="showSection('dashboard',event)" class="active" id="nav-dashboard"><i class="fas fa-home"></i> Dashboard</a>
        <a href="#" onclick="showSection('accounts',event)" id="nav-accounts"><i class="fas fa-users"></i> My Kids Accounts</a>
        <a href="#" onclick="showSection('transactions',event)" id="nav-transactions"><i class="fas fa-exchange-alt"></i> Transactions</a>
        <a href="#" onclick="showSection('beneficiaries',event)" id="nav-beneficiaries"><i class="fas fa-user-shield"></i> Beneficiaries</a>
        <a href="/cds-cooperative/dashboard"><i class="fas fa-arrow-left"></i> Main Dashboard</a>
        <a href="/logout" style="color:rgba(255,255,255,0.5);margin-top:4px;"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
</div>

<!-- ══ TOP NAVBAR ══ -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--kiddies);font-size:1.2rem;" onclick="toggleSidebar()"></i>
    <div class="flex-grow-1">
        <h6 class="mb-0 fw-bold" style="color:var(--kiddies);font-size:0.9rem;">Kiddies Account Dashboard 🎈</h6>
        <small class="text-muted d-none d-md-block" style="font-size:0.72rem;">Securing your children's future, one deposit at a time — <%= user.firstName %></small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge" style="background:rgba(139,92,246,0.1);color:#6d28d9;font-size:0.7rem;padding:5px 10px;">
            <i class="fas fa-wallet me-1"></i>₦<%= parentAccountBalance.toLocaleString() %>
        </span>
        <span class="badge" style="background:rgba(236,72,153,0.1);color:var(--kiddies);font-size:0.72rem;padding:5px 10px;">
            <%= kiddiesAccounts.length %> Account<%= kiddiesAccounts.length !== 1 ? 's' : '' %>
        </span>
    </div>
</div>

<!-- ══ Toast container ══ -->
<div class="toast-container" id="toastContainer"></div>

<!-- ══ MAIN CONTENT ══ -->
<div class="main-content" id="mainContent">

    <%
        // ── Server-side calculations ──
        let totalSavings = 0, totalInterest = 0, earliestMaturity = null;
        kiddiesAccounts.forEach(ka => {
            if (ka.account) {
                totalSavings += ka.account.balance || 0;
                totalInterest += ka.account.accumulativeROI || 0;
            }
            if (ka.unlockDate && (!earliestMaturity || ka.unlockDate < earliestMaturity)) {
                earliestMaturity = ka.unlockDate;
            }
        });

        // ── Share percentage (kiddies savings / all members total savings) ──
        const kiddiesSharePercentage = allMembersTotalSavings > 0 && totalSavings > 0
            ? ((totalSavings / allMembersTotalSavings) * 100).toFixed(2)
            : 0;
    %>

    <!-- ── Payment notice banners ── -->
    <% if (typeof query !== 'undefined' && query.payment === 'success') { %>
    <div class="alert-kiddies mb-3 d-flex align-items-center gap-2">
        <i class="fas fa-check-circle text-success"></i>
        <span><strong>Payment successful!</strong> Your kiddies account has been created and is pending admin approval.</span>
    </div>
    <% } %>
    <% if (typeof query !== 'undefined' && query.payment === 'failed') { %>
    <div class="alert mb-3" style="background:#fef2f2;border:1px solid rgba(239,68,68,0.3);border-radius:11px;color:#991b1b;padding:0.8rem 1rem;">
        <i class="fas fa-times-circle me-2"></i><strong>Payment failed.</strong> Please try again or contact support.
    </div>
    <% } %>

    <!-- ══ DASHBOARD SECTION ══ -->
    <div id="dashboard" class="content-section">

        <!-- Welcome card -->
        <div class="welcome-card position-relative mb-3">
            <div class="row align-items-center position-relative" style="z-index:1;">
                <div class="col-8">
                    <h5 class="mb-2 fw-bold" style="font-size:1rem;">Welcome, <%= user.firstName %>! 🎉</h5>
                    <div class="d-flex gap-2 flex-wrap">
                        <div class="kid-badge"><i class="fas fa-lock" style="font-size:0.68rem;"></i><span>5-Year Lock</span></div>
                        <div class="kid-badge"><i class="fas fa-chart-line" style="font-size:0.68rem;"></i><span>Competitive Rates</span></div>
                        <div class="kid-badge"><i class="fas fa-shield-alt" style="font-size:0.68rem;"></i><span>Secure & Protected</span></div>
                    </div>
                </div>
                <div class="col-4 text-end">
                    <button class="btn btn-light btn-sm fw-bold px-3" onclick="openModal('createAccountModal')">
                        <i class="fas fa-plus me-1"></i>New Account
                    </button>
                </div>
            </div>
        </div>

        <!-- Info notice -->
        <div class="alert-kiddies mb-3" style="font-size:0.8rem;">
            <i class="fas fa-info-circle me-2"></i>
            Kiddies accounts have a <strong>5-year minimum savings period</strong>. A registration fee of
            <strong>₦<%= kiddiesRegistrationFee.toLocaleString() %></strong> + initial deposit is required to activate each account.
            Accounts require admin approval after payment.
        </div>

        <!-- ══ STAT CARDS ══ -->
        <div class="row g-2 g-md-3 mb-3">
            <!-- Total Accounts -->
            <div class="col-6 col-lg-4 col-xl">
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#ec4899,#be185d);color:white;">
                        <i class="fas fa-users"></i>
                    </div>
                    <div style="font-size:0.68rem;color:#6b7280;font-weight:600;text-transform:uppercase;margin-bottom:2px;">Total Accounts</div>
                    <div style="font-size:1.1rem;font-weight:800;color:#1f2937;"><%= kiddiesAccounts.length %></div>
                    <div style="font-size:0.68rem;color:var(--kiddies);font-weight:600;">
                        <%= kiddiesAccounts.filter(k => k.registrationStatus === 'paid').length %> Active
                    </div>
                </div>
            </div>

            <!-- Total Savings -->
            <div class="col-6 col-lg-4 col-xl">
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;">
                        <i class="fas fa-piggy-bank"></i>
                    </div>
                    <div style="font-size:0.68rem;color:#6b7280;font-weight:600;text-transform:uppercase;margin-bottom:2px;">Total Savings</div>
                    <div style="font-size:1rem;font-weight:800;color:#1f2937;">₦<%= totalSavings.toLocaleString() %></div>
                    <div style="font-size:0.68rem;color:#10b981;font-weight:600;">Across all accounts</div>
                </div>
            </div>

            <!-- Total Interest -->
            <div class="col-6 col-lg-4 col-xl">
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#06b6d4,#0891b2);color:white;">
                        <i class="fas fa-percentage"></i>
                    </div>
                    <div style="font-size:0.68rem;color:#6b7280;font-weight:600;text-transform:uppercase;margin-bottom:2px;">Total Interest</div>
                    <div style="font-size:1rem;font-weight:800;color:#1f2937;">₦<%= totalInterest.toLocaleString(undefined,{maximumFractionDigits:2}) %></div>
                    <div style="font-size:0.68rem;color:#06b6d4;font-weight:600;">Earned to date</div>
                </div>
            </div>

            <!-- Pool Share -->
            <div class="col-6 col-lg-6 col-xl">
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#8b5cf6,#6d28d9);color:white;">
                        <i class="fas fa-chart-pie"></i>
                    </div>
                    <div style="font-size:0.68rem;color:#6b7280;font-weight:600;text-transform:uppercase;margin-bottom:2px;">Pool Share</div>
                    <div style="font-size:1rem;font-weight:800;color:#1f2937;"><%= kiddiesSharePercentage %>%</div>
                    <div style="font-size:0.68rem;color:#8b5cf6;font-weight:600;">
                        <i class="fas fa-users me-1"></i>of all members' savings
                    </div>
                </div>
            </div>

            <!-- Earliest Maturity -->
            <div class="col-6 col-lg-6 col-xl">
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div style="font-size:0.68rem;color:#6b7280;font-weight:600;text-transform:uppercase;margin-bottom:2px;">Earliest Maturity</div>
                    <div style="font-size:1rem;font-weight:800;color:#1f2937;">
                        <% if (earliestMaturity) { %>
                            <%= new Date(earliestMaturity).getFullYear() %>
                        <% } else { %>
                            N/A
                        <% } %>
                    </div>
                    <div style="font-size:0.68rem;color:#f59e0b;font-weight:600;">First eligible</div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0 fw-bold" style="font-size:0.86rem;color:var(--kiddies);">
                    <i class="fas fa-bolt me-2"></i>Quick Actions
                </h6>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-6 col-lg-3">
                        <a href="#" class="quick-action" onclick="openModal('createAccountModal')">
                            <i class="fas fa-user-plus" style="color:var(--kiddies);"></i>
                            <h6>New Account</h6>
                        </a>
                    </div>
                    <div class="col-6 col-lg-3">
                        <a href="#" class="quick-action" onclick="openDepositModal()">
                            <i class="fas fa-plus-circle" style="color:#10b981;"></i>
                            <h6>Make Deposit</h6>
                        </a>
                    </div>
                    <div class="col-6 col-lg-3">
                        <a href="#" class="quick-action" onclick="showSection('transactions',event)">
                            <i class="fas fa-history" style="color:#06b6d4;"></i>
                            <h6>View History</h6>
                        </a>
                    </div>
                    <div class="col-6 col-lg-3">
                        <a href="#" class="quick-action" onclick="showSection('beneficiaries',event)">
                            <i class="fas fa-user-shield" style="color:#f59e0b;"></i>
                            <h6>Beneficiaries</h6>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Kids Accounts Overview -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold" style="color:var(--kiddies);font-size:0.86rem;">
                    <i class="fas fa-users me-2"></i>Kids Accounts Overview
                </h6>
                <button class="btn btn-sm" style="background:var(--kiddies);color:white;border-radius:8px;font-size:0.76rem;font-weight:600;padding:4px 12px;" onclick="showSection('accounts',event)">
                    View All
                </button>
            </div>
            <div class="card-body p-3">
                <% if (kiddiesAccounts.length === 0) { %>
                    <div class="text-center py-5">
                        <i class="fas fa-child fa-3x mb-3" style="color:rgba(236,72,153,0.3);"></i>
                        <h6 class="text-muted fw-semibold">No kiddies accounts yet</h6>
                        <p class="text-muted mb-3" style="font-size:0.82rem;">Create your first kiddies savings account for your child</p>
                        <button class="btn btn-sm fw-bold" style="background:var(--kiddies);color:white;border-radius:8px;" onclick="openModal('createAccountModal')">
                            <i class="fas fa-plus me-1"></i>Create Account
                        </button>
                    </div>
                <% } else { %>
                    <div class="row g-3">
                        <% kiddiesAccounts.slice(0,3).forEach(ka => {
                            const balance = ka.account ? ka.account.balance : 0;
                            const roi = ka.account ? (ka.account.accumulativeROI || 0) : 0;
                            const now = new Date();
                            const created = new Date(ka.createdAt);
                            const unlock = ka.unlockDate ? new Date(ka.unlockDate) : null;
                            const totalMs = unlock ? (unlock - created) : (5 * 365.25 * 24 * 3600 * 1000);
                            const elapsedMs = now - created;
                            const progress = Math.min(100, Math.round((elapsedMs / totalMs) * 100));
                            const childAge = Math.floor((now - new Date(ka.childDOB)) / (365.25*24*3600*1000));
                            const acctShare = allMembersTotalSavings > 0 && balance > 0
                                ? ((balance / allMembersTotalSavings) * 100).toFixed(2) : 0;
                        %>
                        <div class="col-md-4">
                            <div class="kid-card" onclick="viewAccountDetail('<%= ka._id %>')">
                                <div class="kid-avatar">
                                    <i class="fas fa-<%= ka.childGender === 'Female' ? 'female' : 'male' %>"></i>
                                </div>
                                <h6 class="text-center fw-bold mb-1" style="font-size:0.88rem;"><%= ka.childFirstName %> <%= ka.childLastName %></h6>
                                <p class="text-center text-muted mb-2" style="font-size:0.72rem;"><%= ka.accountID %> • Age <%= childAge %></p>

                                <% if (ka.registrationStatus !== 'paid') { %>
                                <div class="payment-notice mb-2">
                                    <div style="font-size:0.72rem;color:var(--kiddies);font-weight:700;margin-bottom:4px;">
                                        <i class="fas fa-exclamation-circle me-1"></i>Payment Required
                                    </div>
                                    <div style="font-size:0.7rem;color:#6b7280;">Registration fee + initial deposit not yet paid</div>
                                    <button class="btn btn-sm mt-2 fw-bold w-100" style="background:var(--kiddies);color:white;font-size:0.72rem;border-radius:6px;" onclick="event.stopPropagation(); payRegistration('<%= ka._id %>')">
                                        <i class="fas fa-credit-card me-1"></i>Pay Now (₦<%= kiddiesRegistrationFee.toLocaleString() %> + deposit)
                                    </button>
                                </div>
                                <% } else { %>
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between mb-1" style="font-size:0.72rem;">
                                        <span class="text-muted">Balance</span>
                                        <strong style="color:var(--kiddies);">₦<%= balance.toLocaleString() %></strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1" style="font-size:0.72rem;">
                                        <span class="text-muted">Interest</span>
                                        <span class="text-success">₦<%= roi.toLocaleString(undefined,{maximumFractionDigits:2}) %></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1" style="font-size:0.72rem;">
                                        <span class="text-muted">Pool Share</span>
                                        <span style="color:#8b5cf6;font-weight:700;"><%= acctShare %>%</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2" style="font-size:0.72rem;">
                                        <span class="text-muted">Matures</span>
                                        <span><%= unlock ? unlock.toLocaleDateString('en-US',{month:'short',year:'numeric'}) : 'N/A' %></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1" style="font-size:0.7rem;">
                                        <span class="text-muted">Progress</span>
                                        <span class="fw-bold"><%= progress %>%</span>
                                    </div>
                                    <div class="progress"><div class="progress-bar" style="width:<%= progress %>%"></div></div>
                                </div>
                                <% } %>

                                <div class="text-center">
                                    <span class="status-pill status-<%= ka.registrationStatus !== 'paid' ? 'pending' : ka.status %>">
                                        <%= ka.registrationStatus !== 'paid' ? 'Payment Pending' : (ka.status === 'locked' ? '⏳ Pending Approval' : ka.status) %>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- ══ ACCOUNTS SECTION ══ -->
    <div id="accounts" class="content-section" style="display:none;">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold" style="color:var(--kiddies);font-size:0.86rem;">
                    <i class="fas fa-users me-2"></i>All Kiddies Accounts (<%= kiddiesAccounts.length %>)
                </h6>
                <button class="btn btn-sm fw-bold" style="background:var(--kiddies);color:white;border-radius:8px;font-size:0.76rem;padding:4px 12px;" onclick="openModal('createAccountModal')">
                    <i class="fas fa-plus me-1"></i>New Account
                </button>
            </div>
            <div class="card-body p-3">
                <% if (kiddiesAccounts.length === 0) { %>
                    <div class="text-center py-5">
                        <i class="fas fa-child fa-3x mb-3" style="color:rgba(236,72,153,0.3);"></i>
                        <p class="text-muted mb-3" style="font-size:0.82rem;">No kiddies accounts yet</p>
                        <button class="btn btn-sm fw-bold" style="background:var(--kiddies);color:white;border-radius:8px;" onclick="openModal('createAccountModal')">
                            <i class="fas fa-plus me-1"></i>Create First Account
                        </button>
                    </div>
                <% } else { %>
                    <div class="row g-3">
                        <% kiddiesAccounts.forEach(ka => {
                            const balance = ka.account ? ka.account.balance : 0;
                            const roi = ka.account ? (ka.account.accumulativeROI || 0) : 0;
                            const now = new Date();
                            const created = new Date(ka.createdAt);
                            const unlock = ka.unlockDate ? new Date(ka.unlockDate) : null;
                            const totalMs = unlock ? (unlock - created) : (5*365.25*24*3600*1000);
                            const elapsedMs = now - created;
                            const progress = Math.min(100, Math.round((elapsedMs/totalMs)*100));
                            const childAge = Math.floor((now - new Date(ka.childDOB)) / (365.25*24*3600*1000));
                            const acctShare = allMembersTotalSavings > 0 && balance > 0
                                ? ((balance / allMembersTotalSavings) * 100).toFixed(2) : 0;
                        %>
                        <div class="col-md-6 col-lg-4">
                            <div class="kid-card h-100">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="fw-bold mb-0" style="font-size:0.88rem;"><%= ka.childFirstName %> <%= ka.childLastName %></h6>
                                        <small class="text-muted"><%= ka.accountID %> • Age <%= childAge %></small>
                                    </div>
                                    <span class="status-pill status-<%= ka.registrationStatus !== 'paid' ? 'pending' : ka.status %>">
                                        <%= ka.registrationStatus !== 'paid' ? 'Fee Pending' : (ka.status === 'locked' ? 'Awaiting Approval' : ka.status) %>
                                    </span>
                                </div>

                                <% if (ka.registrationStatus !== 'paid') { %>
                                <div class="payment-notice my-2">
                                    <div style="font-size:0.74rem;color:var(--kiddies);font-weight:700;"><i class="fas fa-credit-card me-1"></i>Complete Registration Payment</div>
                                    <div style="font-size:0.7rem;color:#6b7280;margin-bottom:6px;">₦<%= kiddiesRegistrationFee.toLocaleString() %> registration fee + initial deposit required</div>
                                    <button class="btn btn-sm fw-bold w-100" style="background:var(--kiddies);color:white;font-size:0.72rem;border-radius:6px;" onclick="payRegistration('<%= ka._id %>')">
                                        Pay Now
                                    </button>
                                </div>
                                <% } else { %>
                                <div class="row g-1 mb-2">
                                    <div class="col-6">
                                        <div style="background:rgba(236,72,153,0.05);border-radius:8px;padding:6px 8px;">
                                            <div style="font-size:0.64rem;color:#9ca3af;font-weight:600;">Balance</div>
                                            <div style="font-size:0.82rem;font-weight:700;color:var(--kiddies);">₦<%= balance.toLocaleString() %></div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div style="background:rgba(16,185,129,0.05);border-radius:8px;padding:6px 8px;">
                                            <div style="font-size:0.64rem;color:#9ca3af;font-weight:600;">Interest</div>
                                            <div style="font-size:0.82rem;font-weight:700;color:#10b981;">₦<%= roi.toLocaleString(undefined,{maximumFractionDigits:0}) %></div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div style="background:rgba(139,92,246,0.05);border-radius:8px;padding:5px 8px;display:flex;align-items:center;justify-content:space-between;">
                                            <div style="font-size:0.64rem;color:#9ca3af;font-weight:600;"><i class="fas fa-chart-pie me-1" style="color:#8b5cf6;"></i>Pool Share</div>
                                            <div style="font-size:0.82rem;font-weight:700;color:#8b5cf6;"><%= acctShare %>%</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between mb-1" style="font-size:0.7rem;">
                                        <span class="text-muted">Progress to maturity</span>
                                        <span class="fw-bold"><%= progress %>% (<%= Math.round(elapsedMs/(365.25*24*3600*1000)) %>/<%= ka.lockPeriodYears || 5 %> yrs)</span>
                                    </div>
                                    <div class="progress"><div class="progress-bar" style="width:<%= progress %>%"></div></div>
                                </div>
                                <div style="font-size:0.7rem;color:#6b7280;">
                                    <i class="fas fa-calendar me-1"></i>Matures: <%= unlock ? unlock.toLocaleDateString('en-US',{month:'long',year:'numeric'}) : 'N/A' %>
                                    <span class="ms-2"><i class="fas fa-user-shield me-1"></i><%= ka.beneficiaryType === 'lawyer' ? 'Lawyer' : 'Family' %></span>
                                </div>
                                <% } %>

                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn btn-sm flex-fill" style="background:rgba(236,72,153,0.08);color:var(--kiddies);border:1px solid rgba(236,72,153,0.2);font-size:0.72rem;font-weight:600;border-radius:7px;" onclick="viewAccountDetail('<%= ka._id %>')">
                                        <i class="fas fa-eye me-1"></i>Details
                                    </button>
                                    <% if (ka.registrationStatus === 'paid') { %>
                                    <button class="btn btn-sm flex-fill" style="background:rgba(16,185,129,0.08);color:#10b981;border:1px solid rgba(16,185,129,0.2);font-size:0.72rem;font-weight:600;border-radius:7px;" onclick="openDepositModal('<%= ka._id %>')">
                                        <i class="fas fa-plus me-1"></i>Deposit
                                    </button>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- ══ TRANSACTIONS SECTION ══ -->
    <div id="transactions" class="content-section" style="display:none;">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0 fw-bold" style="color:var(--kiddies);font-size:0.86rem;">
                    <i class="fas fa-exchange-alt me-2"></i>Transaction History
                </h6>
                <select class="form-select form-select-sm" id="txAccountFilter" style="max-width:200px;font-size:0.78rem;" onchange="loadTransactions()">
                    <option value="">All Accounts</option>
                    <% kiddiesAccounts.forEach(ka => { %>
                        <option value="<%= ka._id %>"><%= ka.childFirstName %> (<%= ka.accountID %>)</option>
                    <% }) %>
                </select>
            </div>
            <div class="card-body p-3" id="transactionsContainer">
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-spinner fa-spin me-2"></i>Loading transactions...
                </div>
            </div>
        </div>
    </div>

    <!-- ══ BENEFICIARIES SECTION ══ -->
    <div id="beneficiaries" class="content-section" style="display:none;">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0 fw-bold" style="color:var(--kiddies);font-size:0.86rem;">
                    <i class="fas fa-user-shield me-2"></i>Next of Kin & Beneficiaries
                </h6>
            </div>
            <div class="card-body p-3">
                <div class="alert-warning-k mb-3" style="font-size:0.78rem;">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Important:</strong> Each kiddies account must have a designated next of kin (Lawyer or Family Member). Changing beneficiary requires admin review and takes 3–5 business days.
                </div>
                <% if (kiddiesAccounts.length === 0) { %>
                    <div class="text-center py-4 text-muted" style="font-size:0.82rem;">No kiddies accounts found.</div>
                <% } else { %>
                    <div class="row g-3">
                        <% kiddiesAccounts.forEach(ka => { %>
                        <div class="col-md-6">
                            <div class="card" style="border:2px solid rgba(236,72,153,0.12);">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold mb-0" style="font-size:0.86rem;"><%= ka.childFirstName %> <%= ka.childLastName %></h6>
                                            <small class="text-muted"><%= ka.accountID %></small>
                                        </div>
                                        <span class="badge" style="background:<%= ka.beneficiaryType === 'lawyer' ? 'rgba(6,182,212,0.12)' : 'rgba(245,158,11,0.12)' %>;color:<%= ka.beneficiaryType === 'lawyer' ? '#0891b2' : '#b45309' %>;font-size:0.68rem;padding:4px 8px;">
                                            <%= ka.beneficiaryType === 'lawyer' ? 'Lawyer' : 'Family' %>
                                        </span>
                                    </div>
                                    <div class="p-2 rounded mb-2" style="background:rgba(236,72,153,0.04);font-size:0.76rem;">
                                        <div class="row g-1">
                                            <div class="col-6"><span class="text-muted d-block">Full Name</span><strong><%= ka.nextOfKin.fullName %></strong></div>
                                            <div class="col-6"><span class="text-muted d-block">Phone</span><strong><%= ka.nextOfKin.phone %></strong></div>
                                            <div class="col-6"><span class="text-muted d-block">Email</span><strong style="word-break:break-all;"><%= ka.nextOfKin.email %></strong></div>
                                            <div class="col-6"><span class="text-muted d-block">Relationship</span><strong><%= ka.nextOfKin.relationship %></strong></div>
                                            <div class="col-12"><span class="text-muted d-block">Address</span><strong><%= ka.nextOfKin.address %></strong></div>
                                            <% if (ka.nextOfKin.lawFirm) { %><div class="col-12"><span class="text-muted d-block">Law Firm</span><strong><%= ka.nextOfKin.lawFirm %></strong></div><% } %>
                                        </div>
                                    </div>
                                    <button class="btn btn-sm w-100 fw-semibold" style="border:1.5px solid var(--kiddies);color:var(--kiddies);font-size:0.74rem;border-radius:7px;" onclick="openEditBeneficiary('<%= ka._id %>')">
                                        <i class="fas fa-edit me-1"></i>Edit Beneficiary
                                    </button>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

</div><!-- end main-content -->

<div style="position:fixed;bottom:14px;right:14px;background:white;padding:6px 14px;border-radius:30px;box-shadow:0 3px 12px rgba(190,24,93,0.12);font-size:0.74rem;font-weight:600;color:var(--kiddies);z-index:1000;">
    Powered by <strong>JESZ LIMITED</strong>
</div>

<!-- ══════════════  MODALS  ══════════════ -->

<!-- Create Account Modal -->
<div class="modal fade" id="createAccountModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header py-3 px-4" style="background:linear-gradient(135deg,#be185d,#ec4899);color:white;border-radius:14px 14px 0 0;">
                <h6 class="modal-title fw-bold"><i class="fas fa-user-plus me-2"></i>Create New Kiddies Account</h6>
                <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-3">

                <div id="createError" class="alert mb-3" style="background:#fef2f2;border:1px solid rgba(239,68,68,0.3);border-radius:10px;color:#991b1b;padding:10px 14px;display:none;font-size:0.8rem;"></div>

                <div class="alert-kiddies mb-3" style="font-size:0.78rem;">
                    <strong>Cost:</strong> ₦<%= kiddiesRegistrationFee.toLocaleString() %> registration fee + minimum ₦10,000 initial deposit.
                    Choose your payment method below. Account is activated after admin approval.
                </div>

                <form id="createAccountForm">
                    <h6 class="fw-bold mb-2" style="color:var(--kiddies);font-size:0.82rem;">Child Information</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">First Name *</label>
                            <input type="text" name="childFirstName" class="form-control form-control-sm" required placeholder="Child's first name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Last Name *</label>
                            <input type="text" name="childLastName" class="form-control form-control-sm" required placeholder="Child's last name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Date of Birth *</label>
                            <input type="date" name="childDOB" class="form-control form-control-sm" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Gender *</label>
                            <select name="childGender" class="form-select form-select-sm" required>
                                <option value="">Select...</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Account Type *</label>
                            <select name="memberTypeId" class="form-select form-select-sm" required>
                                <option value="">Select type...</option>
                                <% memberTypes.forEach(mt => { %>
                                    <option value="<%= mt._id %>"><%= mt.name %> (<%= mt.interestRate %>% interest)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Initial Deposit (₦) *</label>
                            <input type="number" name="initialDeposit" class="form-control form-control-sm" required min="10000" placeholder="Min ₦10,000" oninput="updateTotalCost(this.value)">
                            <div style="font-size:0.7rem;color:#6b7280;margin-top:3px;">Total: ₦<%= kiddiesRegistrationFee.toLocaleString() %> + deposit = <span id="totalCostDisplay">₦<%= kiddiesRegistrationFee.toLocaleString() %></span></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Lock Period (Years) *</label>
                            <div style="background:rgba(236,72,153,0.04);border:1.5px solid rgba(236,72,153,0.2);border-radius:10px;padding:14px 16px;">
                                <div class="d-flex align-items-center gap-3 flex-wrap mb-2">
                                    <div class="d-flex align-items-center gap-2" style="flex:1;min-width:200px;">
                                        <button type="button" onclick="changeLockPeriod(-1)" style="width:32px;height:32px;border-radius:8px;border:2px solid rgba(236,72,153,0.3);background:white;color:var(--kiddies);font-size:1.1rem;font-weight:700;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.2s;flex-shrink:0;" onmouseover="this.style.background='var(--kiddies)';this.style.color='white';" onmouseout="this.style.background='white';this.style.color='var(--kiddies)';">−</button>
                                        <div style="flex:1;text-align:center;">
                                            <span id="lockPeriodDisplay" style="font-size:1.6rem;font-weight:800;color:var(--kiddies);line-height:1;">5</span>
                                            <span style="font-size:0.82rem;color:#6b7280;font-weight:600;margin-left:4px;">years</span>
                                        </div>
                                        <button type="button" onclick="changeLockPeriod(1)" style="width:32px;height:32px;border-radius:8px;border:2px solid rgba(236,72,153,0.3);background:white;color:var(--kiddies);font-size:1.1rem;font-weight:700;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.2s;flex-shrink:0;" onmouseover="this.style.background='var(--kiddies)';this.style.color='white';" onmouseout="this.style.background='white';this.style.color='var(--kiddies)';">+</button>
                                    </div>
                                    <input type="range" name="lockPeriodYears" id="lockPeriodSlider" min="5" max="18" value="5" class="form-range" style="flex:2;min-width:140px;accent-color:var(--kiddies);" oninput="syncLockPeriod('slider',this.value)">
                                </div>
                                <div class="d-flex justify-content-between" style="font-size:0.68rem;color:#9ca3af;font-weight:600;padding:0 2px;">
                                    <span>5 yrs (min)</span>
                                    <span>10 yrs</span>
                                    <span>14 yrs</span>
                                    <span>18 yrs</span>
                                </div>
                                <div id="lockPeriodSummary" style="margin-top:10px;padding:8px 12px;background:rgba(236,72,153,0.08);border-radius:8px;font-size:0.76rem;color:#6b7280;">
                                    <i class="fas fa-calendar-alt me-1" style="color:var(--kiddies);"></i>
                                    Account matures in <strong id="lockMaturityYear" style="color:var(--kiddies);">—</strong> · <span id="lockMaturityNote">Minimum 5-year lock period.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" style="border-color:rgba(236,72,153,0.15);">

                    <h6 class="fw-bold mb-2" style="color:var(--kiddies);font-size:0.82rem;">Next of Kin</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Beneficiary Type *</label>
                            <select name="beneficiaryType" class="form-select form-select-sm" id="beneficiaryTypeSelect" required onchange="toggleLawyerFields()">
                                <option value="">Select...</option>
                                <option value="lawyer">Lawyer</option>
                                <option value="family">Family Member</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Relationship *</label>
                            <input type="text" name="nextOfKinRelationship" class="form-control form-control-sm" required placeholder="e.g. Grandmother, Family Lawyer">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Full Name *</label>
                            <input type="text" name="nextOfKinFullName" class="form-control form-control-sm" required placeholder="Full legal name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Phone *</label>
                            <input type="tel" name="nextOfKinPhone" class="form-control form-control-sm" required placeholder="+234 xxx xxx xxxx">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Email *</label>
                            <input type="email" name="nextOfKinEmail" class="form-control form-control-sm" required placeholder="email@example.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Address *</label>
                            <input type="text" name="nextOfKinAddress" class="form-control form-control-sm" required placeholder="Full address">
                        </div>

                        <div id="lawyerFields" style="display:none;" class="col-12">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" style="font-size:0.76rem;">Bar Number</label>
                                    <input type="text" name="barNumber" class="form-control form-control-sm" placeholder="Bar association number">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" style="font-size:0.76rem;">Law Firm</label>
                                    <input type="text" name="lawFirm" class="form-control form-control-sm" placeholder="Law firm name">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="agreeKiddiesTerms" required>
                        <label class="form-check-label" for="agreeKiddiesTerms" style="font-size:0.76rem;">
                            I agree to the <strong id="agreeTermsLabel">5-year lock period</strong> and understand early withdrawals are not permitted.
                        </label>
                    </div>

                    <hr class="my-3" style="border-color:rgba(236,72,153,0.15);">

                    <!-- ── Payment Method for new account creation ── -->
                    <h6 class="fw-bold mb-2" style="color:var(--kiddies);font-size:0.82rem;">
                        <i class="fas fa-credit-card me-2"></i>Payment Method
                    </h6>
                    <div style="font-size:0.74rem;color:#6b7280;margin-bottom:10px;">
                        Total due: ₦<%= kiddiesRegistrationFee.toLocaleString() %> + deposit = <span id="createTotalDue" style="font-weight:700;color:var(--kiddies);">₦<%= kiddiesRegistrationFee.toLocaleString() %></span>
                    </div>
                    <input type="hidden" id="createPaymentMethodHidden" value="paystack">
                    <div class="row g-2 mb-3" id="createMethodPicker">
                        <div class="col-4">
                            <div class="pay-method-btn selected" id="cpm-paystack" onclick="selectCreateMethod('paystack')">
                                <i class="fas fa-bolt" style="color:var(--kiddies);"></i>
                                <span>Paystack</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="pay-method-btn" id="cpm-manual" onclick="selectCreateMethod('manual')">
                                <i class="fas fa-university" style="color:#06b6d4;"></i>
                                <span>Bank Transfer</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="pay-method-btn" id="cpm-account" onclick="selectCreateMethod('account')">
                                <i class="fas fa-wallet" style="color:#6d28d9;"></i>
                                <span>My Account</span>
                            </div>
                        </div>
                    </div>

                    <!-- Paystack info -->
                    <div id="createPaystackSection">
                        <div class="alert-info-k" style="font-size:0.76rem;">
                            <i class="fas fa-bolt me-1" style="color:#3b82f6;"></i>
                            You'll be redirected to Paystack's secure checkout immediately after submitting.
                        </div>
                    </div>

                    <!-- Manual transfer info -->
                    <div id="createManualSection" style="display:none;">
                        <%
                            const regBankName      = (companyAccount && companyAccount.bankName)      || null;
                            const regAccountName   = (companyAccount && companyAccount.accountName)   || null;
                            const regAccountNumber = (companyAccount && companyAccount.accountNumber) || null;
                            const regAccountConfigured = regBankName && regAccountNumber;
                        %>
                        <% if (regAccountConfigured) { %>
                        <div style="background:rgba(6,182,212,0.04);border:1.5px solid rgba(6,182,212,0.2);border-radius:10px;padding:12px 14px;margin-bottom:10px;">
                            <div style="font-size:0.68rem;color:#0891b2;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">
                                <i class="fas fa-university me-1"></i>Transfer To This Account
                            </div>
                            <div class="row g-1" style="font-size:0.78rem;">
                                <div class="col-5 text-muted fw-semibold">Bank</div>
                                <div class="col-7 fw-bold"><%= regBankName %></div>
                                <div class="col-5 text-muted fw-semibold">Account Name</div>
                                <div class="col-7 fw-bold"><%= regAccountName %></div>
                                <div class="col-5 text-muted fw-semibold">Account No.</div>
                                <div class="col-7 fw-bold" style="color:#0891b2;letter-spacing:0.06em;"><%= regAccountNumber %></div>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="alert-warning-k mb-3" style="font-size:0.76rem;">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Bank account details not yet configured. Please contact admin.
                        </div>
                        <% } %>
                        <div class="mb-2">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Payer Name (optional)</label>
                            <input type="text" name="payerName" id="createPayerName" class="form-control form-control-sm" placeholder="Name on the transfer receipt">
                        </div>
                        <div class="alert-warning-k" style="font-size:0.75rem;">
                            <i class="fas fa-clock me-1"></i>
                            Your account will be activated after <strong>admin confirmation</strong> of the transfer.
                        </div>
                    </div>

                    <!-- Parent cooperative account info -->
                    <div id="createAccountSection" style="display:none;">
                        <div style="background:rgba(139,92,246,0.05);border:1.5px solid rgba(139,92,246,0.2);border-radius:10px;padding:14px;">
                            <div style="font-size:0.68rem;color:#6d28d9;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">
                                <i class="fas fa-wallet me-1"></i>Your Cooperative Account Balance
                            </div>
                            <div style="font-size:1.3rem;font-weight:800;color:#6d28d9;">
                                ₦<%= parentAccountBalance.toLocaleString() %>
                            </div>
                            <div style="font-size:0.7rem;color:#9ca3af;margin-top:4px;">
                                <i class="fas fa-bolt me-1" style="color:#8b5cf6;"></i>
                                Deducted instantly — account sent for admin approval.
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer py-2 px-4">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm fw-bold px-4" id="createAccountBtn"
                        style="background:var(--kiddies);color:white;border-radius:8px;"
                        onclick="submitCreateAccount()">
                    <span id="createBtnText"><i class="fas fa-bolt me-1"></i>Create &amp; Pay via Paystack</span>
                    <span id="createBtnSpinner" class="spinner-border spinner-border-sm ms-1" style="display:none;"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     DEPOSIT MODAL — Paystack / Manual / Parent Account
     ══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="depositModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header py-3 px-4" style="background:linear-gradient(135deg,#be185d,#ec4899);color:white;border-radius:14px 14px 0 0;">
                <h6 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i>Make Deposit</h6>
                <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <div id="depositError" class="alert mb-3" style="background:#fef2f2;border:1px solid rgba(239,68,68,0.3);border-radius:10px;color:#991b1b;padding:10px 14px;display:none;font-size:0.8rem;"></div>

                <form id="depositForm">
                    <!-- Child Account selector -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:0.76rem;">Child's Account *</label>
                        <select class="form-select form-select-sm" id="depositAccountSelect" name="kiddiesAccountId" required>
                            <option value="">Select account...</option>
                            <% kiddiesAccounts.filter(k => k.registrationStatus === 'paid').forEach(ka => { %>
                                <option value="<%= ka._id %>">
                                    <%= ka.childFirstName %> <%= ka.childLastName %> (<%= ka.accountID %>) — ₦<%= (ka.account ? ka.account.balance : 0).toLocaleString() %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Amount -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:0.76rem;">Amount (₦) *</label>
                        <input type="number" name="amount" id="depositAmount" class="form-control form-control-sm" min="1000" required placeholder="Min ₦1,000">
                        <small class="text-muted" style="font-size:0.7rem;">Minimum: ₦1,000</small>
                    </div>

                    <!-- Payment Method — 3-button visual picker -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:0.76rem;">Payment Method *</label>
                        <input type="hidden" name="paymentMethod" id="depositMethodHidden">
                        <div class="row g-2" id="depositMethodPicker">
                            <div class="col-4">
                                <div class="pay-method-btn" id="pm-paystack" onclick="selectDepositMethod('paystack')">
                                    <i class="fas fa-bolt" style="color:var(--kiddies);"></i>
                                    <span>Paystack</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="pay-method-btn" id="pm-manual" onclick="selectDepositMethod('manual')">
                                    <i class="fas fa-university" style="color:#06b6d4;"></i>
                                    <span>Bank Transfer</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="pay-method-btn" id="pm-account" onclick="selectDepositMethod('account')">
                                    <i class="fas fa-wallet" style="color:#6d28d9;"></i>
                                    <span>My Account</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Paystack section ── -->
                    <div id="paystackDepositSection" style="display:none;">
                        <div class="alert-info-k" style="font-size:0.76rem;">
                            <i class="fas fa-bolt me-1" style="color:#3b82f6;"></i>
                            You'll be redirected to Paystack's secure checkout to complete your payment instantly.
                        </div>
                    </div>

                    <!-- ── Manual transfer section ── -->
                    <div id="manualDepositSection" style="display:none;">
                        <%
                            const bankName      = (companyAccount && companyAccount.bankName)      || null;
                            const accountName   = (companyAccount && companyAccount.accountName)   || null;
                            const accountNumber = (companyAccount && companyAccount.accountNumber) || null;
                            const accountConfigured = bankName && accountNumber;
                        %>
                        <% if (accountConfigured) { %>
                        <div style="background:rgba(236,72,153,0.04);border:1.5px solid rgba(236,72,153,0.15);border-radius:10px;padding:12px 14px;margin-bottom:12px;">
                            <div style="font-size:0.68rem;color:var(--kiddies);font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">
                                <i class="fas fa-university me-1"></i>Transfer To This Account
                            </div>
                            <div class="row g-1" style="font-size:0.78rem;">
                                <div class="col-5 text-muted fw-semibold">Bank</div>
                                <div class="col-7 fw-bold"><%= bankName %></div>
                                <div class="col-5 text-muted fw-semibold">Account Name</div>
                                <div class="col-7 fw-bold"><%= accountName %></div>
                                <div class="col-5 text-muted fw-semibold">Account No.</div>
                                <div class="col-7 fw-bold" style="color:var(--kiddies);letter-spacing:0.06em;"><%= accountNumber %></div>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="alert-warning-k mb-3" style="font-size:0.76rem;">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Bank account details are not yet configured. Please contact admin.
                        </div>
                        <% } %>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Payer Name (optional)</label>
                            <input type="text" name="payerName" class="form-control form-control-sm" placeholder="Name on the transfer receipt">
                        </div>
                        <div class="alert-warning-k" style="font-size:0.75rem;">
                            <i class="fas fa-clock me-1"></i>
                            Your deposit will be credited after <strong>admin confirmation</strong>. Please transfer the exact amount entered above.
                        </div>
                    </div>

                    <!-- ── Parent Account section ── -->
                    <div id="accountDepositSection" style="display:none;">
                        <div style="background:rgba(139,92,246,0.05);border:1.5px solid rgba(139,92,246,0.2);border-radius:10px;padding:14px;">
                            <div style="font-size:0.68rem;color:#6d28d9;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">
                                <i class="fas fa-wallet me-1"></i>Your Cooperative Account Balance
                            </div>
                            <div style="font-size:1.3rem;font-weight:800;color:#6d28d9;" id="parentBalanceDisplay">
                                ₦<%= parentAccountBalance.toLocaleString() %>
                            </div>
                            <div style="font-size:0.7rem;color:#9ca3af;margin-top:4px;">
                                <i class="fas fa-bolt me-1" style="color:#8b5cf6;"></i>
                                Transferred instantly — no admin approval required.
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer py-2 px-4">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm fw-bold px-4" id="depositBtn"
                        style="background:#10b981;color:white;border-radius:8px;border:none;"
                        onclick="submitDeposit()">
                    <span id="depositBtnText"><i class="fas fa-check me-1"></i>Proceed</span>
                    <span id="depositBtnSpinner" class="spinner-border spinner-border-sm ms-1" style="display:none;"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Account Detail Modal -->
<div class="modal fade" id="accountDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header py-3 px-4" style="background:linear-gradient(135deg,#be185d,#ec4899);color:white;border-radius:14px 14px 0 0;">
                <h6 class="modal-title fw-bold" id="detailModalTitle"><i class="fas fa-user-circle me-2"></i>Account Details</h6>
                <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-3" id="accountDetailContent">
                <div class="text-center py-4"><i class="fas fa-spinner fa-spin" style="color:var(--kiddies);font-size:1.5rem;"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Beneficiary Modal -->
<div class="modal fade" id="editBeneficiaryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header py-3 px-4" style="background:linear-gradient(135deg,#be185d,#ec4899);color:white;border-radius:14px 14px 0 0;">
                <h6 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i>Update Next of Kin</h6>
                <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <div class="alert-warning-k mb-3" style="font-size:0.76rem;">
                    <i class="fas fa-info-circle me-1"></i>Changes require admin approval (3–5 business days).
                </div>
                <form id="editBeneficiaryForm">
                    <input type="hidden" id="editBeneficiaryAccountId" name="accountId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Full Name</label>
                            <input type="text" id="editBeneficiaryFullName" name="fullName" class="form-control form-control-sm" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Phone</label>
                            <input type="tel" id="editBeneficiaryPhone" name="phone" class="form-control form-control-sm" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Email</label>
                            <input type="email" id="editBeneficiaryEmail" name="email" class="form-control form-control-sm" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Relationship</label>
                            <input type="text" id="editBeneficiaryRelationship" name="relationship" class="form-control form-control-sm" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Address</label>
                            <input type="text" id="editBeneficiaryAddress" name="address" class="form-control form-control-sm" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size:0.76rem;">Reason for Change</label>
                            <textarea name="reason" class="form-control form-control-sm" rows="2" required placeholder="Why are you updating this beneficiary?"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer py-2 px-4">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm fw-bold px-4" id="editBeneficiaryBtn"
                        style="background:var(--kiddies);color:white;border-radius:8px;border:none;"
                        onclick="submitBeneficiaryUpdate()">
                    <span id="editBenBtnText"><i class="fas fa-check me-1"></i>Update</span>
                    <span id="editBenBtnSpinner" class="spinner-border spinner-border-sm ms-1" style="display:none;"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Registration Payment Method Picker Modal -->
<div class="modal fade" id="regPayModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header py-3 px-4" style="background:linear-gradient(135deg,#be185d,#ec4899);color:white;border-radius:14px 14px 0 0;">
                <h6 class="modal-title fw-bold" style="font-size:0.86rem;"><i class="fas fa-credit-card me-2"></i>Pay Registration Fee</h6>
                <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <p style="font-size:0.78rem;color:#6b7280;margin-bottom:12px;">Select how you'd like to pay the registration fee + initial deposit:</p>
                <div id="regPayError" style="display:none;background:#fef2f2;border:1px solid rgba(239,68,68,0.3);border-radius:8px;color:#991b1b;padding:8px 12px;font-size:0.76rem;margin-bottom:10px;"></div>

                <!-- Balance info -->
                <div style="background:rgba(139,92,246,0.05);border:1px solid rgba(139,92,246,0.15);border-radius:8px;padding:8px 12px;margin-bottom:12px;font-size:0.76rem;">
                    <span style="color:#9ca3af;font-weight:600;">Your cooperative balance: </span>
                    <strong style="color:#6d28d9;">₦<%= parentAccountBalance.toLocaleString() %></strong>
                </div>

                <!-- Payer name — only shown when manual is chosen -->
                <div id="regManualPayerSection" style="display:none;margin-bottom:10px;">
                    <%
                        const rpBankName      = (companyAccount && companyAccount.bankName)      || null;
                        const rpAccountName   = (companyAccount && companyAccount.accountName)   || null;
                        const rpAccountNumber = (companyAccount && companyAccount.accountNumber) || null;
                    %>
                    <% if (rpBankName && rpAccountNumber) { %>
                    <div style="background:rgba(6,182,212,0.04);border:1.5px solid rgba(6,182,212,0.18);border-radius:8px;padding:10px 12px;margin-bottom:8px;">
                        <div style="font-size:0.64rem;color:#0891b2;font-weight:700;text-transform:uppercase;margin-bottom:6px;"><i class="fas fa-university me-1"></i>Transfer To</div>
                        <div style="font-size:0.76rem;">
                            <div><span style="color:#9ca3af;">Bank: </span><strong><%= rpBankName %></strong></div>
                            <div><span style="color:#9ca3af;">Name: </span><strong><%= rpAccountName %></strong></div>
                            <div><span style="color:#9ca3af;">Acct: </span><strong style="color:#0891b2;letter-spacing:0.05em;"><%= rpAccountNumber %></strong></div>
                        </div>
                    </div>
                    <% } %>
                    <input type="text" id="regManualPayerName" class="form-control form-control-sm" placeholder="Payer name (optional)">
                    <div class="alert-warning-k mt-2" style="font-size:0.73rem;">
                        <i class="fas fa-clock me-1"></i>Account activated after admin confirms your transfer.
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-sm fw-bold" id="regPayPaystackBtn"
                            style="background:var(--kiddies);color:white;border-radius:8px;border:none;font-size:0.78rem;padding:9px;"
                            onclick="doPayRegistration('paystack')">
                        <i class="fas fa-bolt me-1"></i>Paystack (Card / Bank)
                    </button>
                    <button class="btn btn-sm fw-bold" id="regPayManualBtn"
                            style="background:rgba(6,182,212,0.08);color:#0891b2;border:1.5px solid rgba(6,182,212,0.3);border-radius:8px;font-size:0.78rem;padding:9px;"
                            onclick="doPayRegistration('manual')">
                        <span id="regPayManualBtnText"><i class="fas fa-university me-1"></i>Manual Bank Transfer</span>
                        <span id="regPayManualBtnSpinner" class="spinner-border spinner-border-sm ms-1" style="display:none;"></span>
                    </button>
                    <button class="btn btn-sm fw-bold" id="regPayAccountBtn"
                            style="background:rgba(109,40,217,0.08);color:#6d28d9;border:1.5px solid rgba(109,40,217,0.25);border-radius:8px;font-size:0.78rem;padding:9px;"
                            onclick="doPayRegistration('account')">
                        <span id="regPayAccountBtnText"><i class="fas fa-wallet me-1"></i>From My Cooperative Account</span>
                        <span id="regPayAccountBtnSpinner" class="spinner-border spinner-border-sm ms-1" style="display:none;"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-3" style="border-radius:14px;">
            <div class="modal-body">
                <i class="fas fa-check-circle fa-2x mb-2" style="color:#10b981;"></i>
                <h6 class="fw-bold" id="successTitle">Success!</h6>
                <p class="text-muted mb-3" id="successMsg" style="font-size:0.8rem;">Operation completed successfully.</p>
                <button class="btn btn-sm fw-bold w-100" style="background:#10b981;color:white;border-radius:8px;border:none;" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>

/* ══ Constants ══ */
const REGISTRATION_FEE = <%= kiddiesRegistrationFee %>;

/* ══ State — registration target account ══ */
let _regTargetAccountId = null;

/* ══ Sidebar ══ */
function toggleSidebar() {
    const open = document.getElementById("sidebar").classList.toggle("active");
    document.getElementById("sbOverlay").classList.toggle("show", open);
}
function closeSidebar() {
    document.getElementById("sidebar").classList.remove("active");
    document.getElementById("sbOverlay").classList.remove("show");
}

/* ══ Section navigation ══ */
function showSection(id, e) {
    if (e) e.preventDefault();
    document.querySelectorAll(".content-section").forEach(s => s.style.display = "none");
    document.getElementById(id).style.display = "block";
    document.querySelectorAll(".sidebar-menu a").forEach(a => a.classList.remove("active"));
    const navEl = document.getElementById("nav-" + id);
    if (navEl) navEl.classList.add("active");
    if (window.innerWidth <= 992) closeSidebar();
    if (id === "transactions") loadTransactions();
}

/* ══ Modal helpers ══ */
function openModal(id) {
    new bootstrap.Modal(document.getElementById(id)).show();
}
function showSuccess(title, msg, reload) {
    document.getElementById("successTitle").textContent = title;
    document.getElementById("successMsg").textContent = msg;
    const m = new bootstrap.Modal(document.getElementById("successModal"));
    m.show();
    if (reload) {
        document.getElementById("successModal").addEventListener("hidden.bs.modal", () => location.reload(), { once: true });
    }
}
function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.style.display = "block";
}
function hideError(elId) {
    const el = document.getElementById(elId);
    if (el) el.style.display = "none";
}

/* ══ Toast ══ */
function showToast(msg, type = "success") {
    const tc = document.getElementById("toastContainer");
    const div = document.createElement("div");
    const bg = type === "success" ? "#10b981" : type === "error" ? "#ef4444" : "#f59e0b";
    div.innerHTML = `<div style="background:${bg};color:white;padding:10px 16px;border-radius:10px;font-size:0.8rem;font-weight:600;box-shadow:0 4px 14px rgba(0,0,0,0.12);margin-bottom:8px;">${msg}</div>`;
    tc.appendChild(div);
    setTimeout(() => div.remove(), 4000);
}

/* ══ Total cost updater ══ */
function updateTotalCost(val) {
    const deposit = parseFloat(val) || 0;
    const total   = REGISTRATION_FEE + deposit;
    const fmt     = "₦" + total.toLocaleString();
    const el1 = document.getElementById("totalCostDisplay");
    const el2 = document.getElementById("createTotalDue");
    if (el1) el1.textContent = fmt;
    if (el2) el2.textContent = fmt;
}

/* ══ Lock Period Controls ══ */
let _lockPeriod = 5;
const LOCK_MIN = 5;
const LOCK_MAX = 18;

function syncLockPeriod(source, val) {
    _lockPeriod = Math.min(LOCK_MAX, Math.max(LOCK_MIN, parseInt(val) || LOCK_MIN));
    const displayEl = document.getElementById('lockPeriodDisplay');
    const sliderEl  = document.getElementById('lockPeriodSlider');
    if (displayEl) displayEl.textContent = _lockPeriod;
    if (sliderEl)  sliderEl.value = _lockPeriod;

    const maturityYear = new Date().getFullYear() + _lockPeriod;
    const maturityEl = document.getElementById('lockMaturityYear');
    if (maturityEl) maturityEl.textContent = maturityYear;

    const noteEl = document.getElementById('lockMaturityNote');
    if (noteEl) {
        if (_lockPeriod === LOCK_MIN) {
            noteEl.textContent = 'Minimum 5-year lock period.';
        } else if (_lockPeriod >= 15) {
            noteEl.textContent = 'Long-term plan — ' + _lockPeriod + ' years until maturity.';
        } else {
            const extra = _lockPeriod - LOCK_MIN;
            noteEl.textContent = extra + ' year' + (extra > 1 ? 's' : '') + ' above minimum lock.';
        }
    }

    const termsLabel = document.getElementById('agreeTermsLabel');
    if (termsLabel) termsLabel.textContent = _lockPeriod + '-year lock period';

    if (source !== 'init') {
        const termsCheck = document.getElementById('agreeKiddiesTerms');
        if (termsCheck) termsCheck.checked = false;
    }
}

function changeLockPeriod(delta) {
    syncLockPeriod('btn', _lockPeriod + delta);
}

/* ══ Toggle lawyer fields ══ */
function toggleLawyerFields() {
    const v = document.getElementById("beneficiaryTypeSelect").value;
    document.getElementById("lawyerFields").style.display = v === "lawyer" ? "block" : "none";
}

/* ══ Create Account — payment method picker ══ */
const CREATE_METHOD_LABELS = {
    paystack: '<i class="fas fa-bolt me-1"></i>Create &amp; Pay via Paystack',
    manual:   '<i class="fas fa-university me-1"></i>Create &amp; Submit Transfer',
    account:  '<i class="fas fa-wallet me-1"></i>Create &amp; Deduct from Account',
};

function selectCreateMethod(method) {
    document.getElementById("createPaymentMethodHidden").value = method;

    ["paystack", "manual", "account"].forEach(m => {
        const btn = document.getElementById("cpm-" + m);
        if (btn) btn.classList.toggle("selected", m === method);
    });

    document.getElementById("createPaystackSection").style.display = method === "paystack" ? "block" : "none";
    document.getElementById("createManualSection").style.display   = method === "manual"   ? "block" : "none";
    document.getElementById("createAccountSection").style.display  = method === "account"  ? "block" : "none";

    const btnText = document.getElementById("createBtnText");
    if (btnText) btnText.innerHTML = CREATE_METHOD_LABELS[method] || CREATE_METHOD_LABELS.paystack;
}

/* ══ Deposit method — visual button picker ══ */
function selectDepositMethod(method) {
    // Update hidden input
    document.getElementById("depositMethodHidden").value = method;

    // Update button states
    ["paystack", "manual", "account"].forEach(m => {
        const btn = document.getElementById("pm-" + m);
        if (btn) btn.classList.toggle("selected", m === method);
    });

    // Show/hide sections
    document.getElementById("paystackDepositSection").style.display = method === "paystack" ? "block" : "none";
    document.getElementById("manualDepositSection").style.display   = method === "manual"   ? "block" : "none";
    document.getElementById("accountDepositSection").style.display  = method === "account"  ? "block" : "none";
}

/* ══ Create Account ══ */
async function submitCreateAccount() {
    hideError("createError");
    const form   = document.getElementById("createAccountForm");
    const method = document.getElementById("createPaymentMethodHidden").value || "paystack";

    if (!form.reportValidity()) return;
    if (!document.getElementById("agreeKiddiesTerms").checked) {
        showError("createError", "Please agree to the terms and conditions.");
        return;
    }

    const btn     = document.getElementById("createAccountBtn");
    const spinner = document.getElementById("createBtnSpinner");
    const text    = document.getElementById("createBtnText");
    btn.disabled  = true;
    spinner.style.display = "inline-block";
    text.style.display    = "none";

    const reset = () => {
        btn.disabled = false;
        spinner.style.display = "none";
        text.style.display    = "inline";
    };

    try {
        const formData = Object.fromEntries(new FormData(form).entries());
        // Inject payment method + payer name (from dedicated input, not form field name collision)
        formData.paymentMethod = method;
        if (method === "manual") {
            formData.payerName = document.getElementById("createPayerName")?.value || "";
        }

        const res    = await fetch("/api/kiddies/create", {
            method:  "POST",
            headers: { "Content-Type": "application/json" },
            body:    JSON.stringify(formData),
        });
        const result = await res.json();

        reset();

        if (!res.ok || !result.status) {
            showError("createError", result.message || "Failed to create account.");
            return;
        }

        // ── Paystack: redirect ────────────────────────────────────
        if (method === "paystack" && result.authorization_url) {
            window.location.href = result.authorization_url;
            return;
        }

        // ── Manual / Account: show success + reload ───────────────
        bootstrap.Modal.getInstance(document.getElementById("createAccountModal")).hide();
        showSuccess(
            method === "account" ? "Account Created!" : "Account Created — Transfer Pending",
            result.message,
            true  // reload so new account appears in the list
        );

    } catch (err) {
        console.error(err);
        reset();
        showError("createError", "Network error. Please try again.");
    }
}

/* ══ Open deposit modal (optionally pre-select account) ══ */
function openDepositModal(accountId) {
    // Reset method selection
    selectDepositMethod("");
    ["paystack", "manual", "account"].forEach(m => {
        const btn = document.getElementById("pm-" + m);
        if (btn) btn.classList.remove("selected");
    });
    document.getElementById("depositMethodHidden").value = "";
    hideError("depositError");

    const modal = new bootstrap.Modal(document.getElementById("depositModal"));
    modal.show();

    if (accountId) {
        setTimeout(() => {
            const sel = document.getElementById("depositAccountSelect");
            if (sel) sel.value = accountId;
        }, 200);
    }
}

/* ══ Submit Deposit — Paystack / Manual / Parent Account ══ */
async function submitDeposit() {
    hideError("depositError");

    const method = document.getElementById("depositMethodHidden").value;
    if (!method) {
        showError("depositError", "Please select a payment method.");
        return;
    }

    const form = document.getElementById("depositForm");

    // Validate account + amount manually (hidden input breaks reportValidity for method)
    const accountId = document.getElementById("depositAccountSelect").value;
    const amount    = document.getElementById("depositAmount").value;
    if (!accountId) { showError("depositError", "Please select a child's account."); return; }
    if (!amount || Number(amount) < 1000) { showError("depositError", "Minimum deposit is ₦1,000."); return; }

    const btn     = document.getElementById("depositBtn");
    const spinner = document.getElementById("depositBtnSpinner");
    const text    = document.getElementById("depositBtnText");
    btn.disabled  = true;
    spinner.style.display = "inline-block";
    text.style.display    = "none";

    const reset = () => {
        btn.disabled = false;
        spinner.style.display = "none";
        text.style.display    = "inline";
    };

    const data = {
        kiddiesAccountId: accountId,
        amount:           amount,
        paymentMethod:    method,
        payerName:        form.querySelector('[name="payerName"]')?.value || "",
    };

    try {
        if (method === "paystack") {
            const res    = await fetch("/api/kiddies/deposit", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(data) });
            const result = await res.json();
            reset();
            if (res.ok && result.status && result.authorization_url) {
                window.location.href = result.authorization_url;
            } else {
                showError("depositError", result.message || "Failed to initialise payment.");
            }

        } else if (method === "manual") {
            const res    = await fetch("/api/kiddies/deposit/manual", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(data) });
            const result = await res.json();
            reset();
            if (res.ok && result.status) {
                bootstrap.Modal.getInstance(document.getElementById("depositModal")).hide();
                showSuccess("Deposit Submitted", result.message || "Pending admin confirmation.", false);
                form.reset();
                selectDepositMethod("");
            } else {
                showError("depositError", result.message || "Deposit submission failed.");
            }

        } else if (method === "account") {
            const res    = await fetch("/api/kiddies/deposit/from-account", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(data) });
            const result = await res.json();
            reset();
            if (res.ok && result.status) {
                // Update live balance display
                if (result.newParentBalance !== undefined) {
                    document.getElementById("parentBalanceDisplay").textContent =
                        "₦" + result.newParentBalance.toLocaleString();
                }
                bootstrap.Modal.getInstance(document.getElementById("depositModal")).hide();
                showSuccess("Transfer Successful", result.message, true);
            } else {
                showError("depositError", result.message || "Transfer failed.");
            }

        } else {
            reset();
            showError("depositError", "Please select a payment method.");
        }
    } catch (err) {
        console.error(err);
        reset();
        showError("depositError", "Network error. Please try again.");
    }
}

/* ══ Pay registration fee — opens picker modal ══ */
function payRegistration(accountId) {
    _regTargetAccountId = accountId;

    // Reset all error + spinner states
    const errEl = document.getElementById("regPayError");
    errEl.style.display = "none";
    errEl.textContent   = "";

    // Reset all buttons
    [
        { btn: "regPayPaystackBtn",  spin: null,                     txt: null },
        { btn: "regPayManualBtn",    spin: "regPayManualBtnSpinner",  txt: "regPayManualBtnText" },
        { btn: "regPayAccountBtn",   spin: "regPayAccountBtnSpinner", txt: "regPayAccountBtnText" },
    ].forEach(({ btn, spin, txt }) => {
        const b = document.getElementById(btn);
        if (b) b.disabled = false;
        if (spin) { const s = document.getElementById(spin); if (s) s.style.display = "none"; }
        if (txt)  { const t = document.getElementById(txt);  if (t) t.style.display = "inline"; }
    });

    // Hide manual section
    const manualSec = document.getElementById("regManualPayerSection");
    if (manualSec) manualSec.style.display = "none";
    const payerInput = document.getElementById("regManualPayerName");
    if (payerInput) payerInput.value = "";

    openModal("regPayModal");
}

async function doPayRegistration(method) {
    const accountId = _regTargetAccountId;
    if (!accountId) return;

    const errEl = document.getElementById("regPayError");
    errEl.style.display = "none";

    // ── Show manual section on first click, submit on second ──────
    if (method === "manual") {
        const manualSec = document.getElementById("regManualPayerSection");
        if (manualSec && manualSec.style.display === "none") {
            // First click: reveal the bank details + payer name input
            manualSec.style.display = "block";
            document.getElementById("regPayManualBtnText").innerHTML =
                '<i class="fas fa-check me-1"></i>Confirm Manual Transfer';
            return;
        }
        // Second click: submit
        const spinnerEl = document.getElementById("regPayManualBtnSpinner");
        const textEl    = document.getElementById("regPayManualBtnText");
        const btn       = document.getElementById("regPayManualBtn");
        btn.disabled            = true;
        spinnerEl.style.display = "inline-block";
        textEl.style.display    = "none";

        const payerName = document.getElementById("regManualPayerName")?.value || "";

        try {
            const res    = await fetch("/api/kiddies/register/manual", {
                method:  "POST",
                headers: { "Content-Type": "application/json" },
                body:    JSON.stringify({ existingAccountId: accountId, payerName }),
            });
            const result = await res.json();

            if (res.ok && result.status) {
                bootstrap.Modal.getInstance(document.getElementById("regPayModal")).hide();
                showSuccess("Transfer Submitted", result.message, false);
            } else {
                btn.disabled            = false;
                spinnerEl.style.display = "none";
                textEl.style.display    = "inline";
                errEl.textContent       = result.message || "Submission failed.";
                errEl.style.display     = "block";
            }
        } catch {
            btn.disabled            = false;
            spinnerEl.style.display = "none";
            textEl.style.display    = "inline";
            errEl.textContent       = "Network error. Please try again.";
            errEl.style.display     = "block";
        }
        return;
    }

    if (method === "paystack") {
        document.getElementById("regPayPaystackBtn").disabled = true;
        showToast("Initializing payment...", "info");

        try {
            const res    = await fetch("/api/kiddies/create", {
                method:  "POST",
                headers: { "Content-Type": "application/json" },
                body:    JSON.stringify({ existingAccountId: accountId }),
            });
            const result = await res.json();

            if (result.authorization_url) {
                window.location.href = result.authorization_url;
            } else {
                document.getElementById("regPayPaystackBtn").disabled = false;
                errEl.textContent   = result.message || "Could not initialize payment.";
                errEl.style.display = "block";
            }
        } catch {
            document.getElementById("regPayPaystackBtn").disabled = false;
            errEl.textContent   = "Network error. Please try again.";
            errEl.style.display = "block";
        }
        return;
    }

    if (method === "account") {
        const spinnerEl = document.getElementById("regPayAccountBtnSpinner");
        const textEl    = document.getElementById("regPayAccountBtnText");
        const btn       = document.getElementById("regPayAccountBtn");
        btn.disabled            = true;
        spinnerEl.style.display = "inline-block";
        textEl.style.display    = "none";

        try {
            const res    = await fetch("/api/kiddies/register/from-account", {
                method:  "POST",
                headers: { "Content-Type": "application/json" },
                body:    JSON.stringify({ existingAccountId: accountId }),
            });
            const result = await res.json();

            if (res.ok && result.status) {
                bootstrap.Modal.getInstance(document.getElementById("regPayModal")).hide();
                showSuccess("Registration Complete", result.message, true);
            } else {
                btn.disabled            = false;
                spinnerEl.style.display = "none";
                textEl.style.display    = "inline";
                errEl.textContent       = result.message || "Registration failed.";
                errEl.style.display     = "block";
            }
        } catch {
            btn.disabled            = false;
            spinnerEl.style.display = "none";
            textEl.style.display    = "inline";
            errEl.textContent       = "Network error. Please try again.";
            errEl.style.display     = "block";
        }
    }
}

/* ══ View Account Detail ══ */
async function viewAccountDetail(accountId) {
    openModal("accountDetailModal");
    document.getElementById("accountDetailContent").innerHTML =
        '<div class="text-center py-4"><i class="fas fa-spinner fa-spin" style="color:var(--kiddies);font-size:1.5rem;"></i></div>';

    try {
        const res    = await fetch(`/api/kiddies/account/${accountId}`);
        const result = await res.json();

        if (!result.status) {
            document.getElementById("accountDetailContent").innerHTML =
                '<p class="text-muted text-center py-4" style="font-size:0.8rem;">Could not load account details.</p>';
            return;
        }

        const ka      = result.kiddiesAccount;
        const txs     = result.transactions || [];
        const balance = ka.account ? ka.account.balance : 0;
        const roi     = ka.account ? (ka.account.accumulativeROI || 0) : 0;
        const now     = new Date();
        const created = new Date(ka.createdAt);
        const unlock  = ka.unlockDate ? new Date(ka.unlockDate) : null;
        const totalMs = unlock ? (unlock - created) : (5 * 365.25 * 24 * 3600 * 1000);
        const progress = Math.min(100, Math.round(((now - created) / totalMs) * 100));

        const allMembersTotal = <%= allMembersTotalSavings %>;
        const acctShare = allMembersTotal > 0 && balance > 0
            ? ((balance / allMembersTotal) * 100).toFixed(2) : "0.00";

        document.getElementById("detailModalTitle").innerHTML =
            `<i class="fas fa-user-circle me-2"></i>${ka.childFirstName} ${ka.childLastName}`;

        const txHTML = txs.length === 0
            ? '<p class="text-muted text-center py-3" style="font-size:0.78rem;">No transactions yet.</p>'
            : txs.slice(0,8).map(tx => `
                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid rgba(236,72,153,0.07);">
                    <div>
                        <span class="badge" style="background:${tx.type==='deposit'?'rgba(16,185,129,0.1)':tx.type==='interest'?'rgba(6,182,212,0.1)':'rgba(236,72,153,0.1)'};color:${tx.type==='deposit'?'#059669':tx.type==='interest'?'#0891b2':'#be185d'};font-size:0.65rem;">${tx.type}</span>
                        <div style="font-size:0.72rem;color:#6b7280;margin-top:2px;">${new Date(tx.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</div>
                        <div style="font-size:0.7rem;color:#9ca3af;">${tx.description||''}</div>
                    </div>
                    <div style="text-align:right;">
                        <div style="font-weight:700;color:${tx.type==='withdrawal'?'#ef4444':'#10b981'};font-size:0.82rem;">${tx.type==='withdrawal'?'-':'+'}₦${tx.amount.toLocaleString()}</div>
                        <div style="font-size:0.68rem;color:#9ca3af;">Bal: ₦${(tx.balanceAfter||0).toLocaleString()}</div>
                    </div>
                </div>`).join('');

        document.getElementById("accountDetailContent").innerHTML = `
            <div style="background:linear-gradient(135deg,rgba(236,72,153,0.05),rgba(219,39,119,0.05));border:2px solid rgba(236,72,153,0.12);border-radius:12px;padding:1rem;margin-bottom:1rem;">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
                    <div>
                        <div style="font-size:0.68rem;color:#9ca3af;font-weight:700;text-transform:uppercase;">Account ID</div>
                        <div style="font-weight:700;color:var(--kiddies);">${ka.accountID}</div>
                    </div>
                    <span class="status-pill status-${ka.registrationStatus !== 'paid' ? 'pending' : ka.status}">${ka.registrationStatus !== 'paid' ? 'Payment Pending' : ka.status}</span>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <div style="background:white;border-radius:8px;padding:8px;">
                            <div style="font-size:0.64rem;color:#9ca3af;font-weight:600;">Balance</div>
                            <div style="font-weight:800;color:var(--kiddies);">₦${balance.toLocaleString()}</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="background:white;border-radius:8px;padding:8px;">
                            <div style="font-size:0.64rem;color:#9ca3af;font-weight:600;">Interest Earned</div>
                            <div style="font-weight:800;color:#10b981;">₦${roi.toLocaleString(undefined,{maximumFractionDigits:2})}</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="background:white;border-radius:8px;padding:8px;">
                            <div style="font-size:0.64rem;color:#9ca3af;font-weight:600;">Pool Share</div>
                            <div style="font-weight:800;color:#8b5cf6;">${acctShare}%</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="background:white;border-radius:8px;padding:8px;">
                            <div style="font-size:0.64rem;color:#9ca3af;font-weight:600;">Date of Birth</div>
                            <div style="font-weight:700;font-size:0.82rem;">${new Date(ka.childDOB).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="background:white;border-radius:8px;padding:8px;">
                            <div style="font-size:0.64rem;color:#9ca3af;font-weight:600;">Maturity Date</div>
                            <div style="font-weight:700;font-size:0.82rem;">${unlock ? unlock.toLocaleDateString('en-US',{month:'short',year:'numeric'}) : 'N/A'}</div>
                        </div>
                    </div>
                </div>
                <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:4px;font-size:0.7rem;">
                        <span class="text-muted">Progress to maturity</span>
                        <strong>${progress}%</strong>
                    </div>
                    <div class="progress"><div class="progress-bar" style="width:${progress}%"></div></div>
                </div>
            </div>
            <div style="margin-bottom:1rem;">
                <h6 style="font-weight:700;font-size:0.8rem;color:var(--kiddies);margin-bottom:8px;">Next of Kin</h6>
                <div style="background:rgba(236,72,153,0.04);border-radius:10px;padding:10px;font-size:0.76rem;">
                    <strong>${ka.nextOfKin.fullName}</strong> · ${ka.nextOfKin.relationship} (${ka.beneficiaryType})
                    <div class="text-muted mt-1">${ka.nextOfKin.phone} · ${ka.nextOfKin.email}</div>
                </div>
            </div>
            <div>
                <h6 style="font-weight:700;font-size:0.8rem;color:var(--kiddies);margin-bottom:8px;">Recent Transactions</h6>
                ${txHTML}
            </div>
            ${ka.registrationStatus === 'paid' ? `
            <div style="display:flex;gap:8px;margin-top:16px;">
                <button class="btn btn-sm fw-bold flex-fill" style="background:rgba(16,185,129,0.08);color:#10b981;border:1.5px solid rgba(16,185,129,0.2);border-radius:8px;font-size:0.76rem;" onclick="bootstrap.Modal.getInstance(document.getElementById('accountDetailModal')).hide(); openDepositModal('${ka._id}')">
                    <i class="fas fa-plus me-1"></i>Make Deposit
                </button>
            </div>` : `
            <div style="margin-top:12px;">
                <button class="btn btn-sm fw-bold w-100" style="background:var(--kiddies);color:white;border-radius:8px;border:none;font-size:0.76rem;" onclick="payRegistration('${ka._id}')">
                    <i class="fas fa-credit-card me-1"></i>Pay Registration Fee
                </button>
            </div>`}
        `;
    } catch (err) {
        console.error(err);
        document.getElementById("accountDetailContent").innerHTML =
            '<p class="text-muted text-center py-4" style="font-size:0.8rem;">Error loading details.</p>';
    }
}

/* ══ Load Transactions ══ */
async function loadTransactions() {
    const container = document.getElementById("transactionsContainer");
    const filter    = document.getElementById("txAccountFilter").value;

    container.innerHTML = '<div class="text-center py-4 text-muted" style="font-size:0.8rem;"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</div>';

    try {
        const accountIds = filter
            ? [filter]
            : <%- JSON.stringify(kiddiesAccounts.map(k => k._id.toString())) %>;

        if (accountIds.length === 0) {
            container.innerHTML = '<p class="text-muted text-center py-4" style="font-size:0.8rem;">No accounts found.</p>';
            return;
        }

        const allTxs = [];
        await Promise.all(accountIds.map(async id => {
            const res  = await fetch(`/api/kiddies/transactions/${id}`);
            const data = await res.json();
            if (data.status && data.transactions) {
                data.transactions.forEach(tx => {
                    tx._accountId = id;
                    allTxs.push(tx);
                });
            }
        }));

        const nameMap = {};
        <%- JSON.stringify(kiddiesAccounts).replace(/<\/script>/gi, '<\\/script>') %>.forEach(ka => {
            nameMap[ka._id] = `${ka.childFirstName} ${ka.childLastName} (${ka.accountID})`;
        });

        allTxs.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));

        if (allTxs.length === 0) {
            container.innerHTML = '<p class="text-muted text-center py-5" style="font-size:0.8rem;"><i class="fas fa-inbox fa-2x d-block mb-2" style="opacity:0.3;"></i>No transactions yet.</p>';
            return;
        }

        const totalDeposits = allTxs.filter(t=>t.type==='deposit'&&t.status==='completed').reduce((s,t)=>s+t.amount,0);
        const totalInterest = allTxs.filter(t=>t.type==='interest').reduce((s,t)=>s+t.amount,0);

        const typeColors = { deposit:'#10b981', interest:'#06b6d4', fee:'#f59e0b', withdrawal:'#ef4444' };
        const typeBg     = { deposit:'rgba(16,185,129,0.1)', interest:'rgba(6,182,212,0.1)', fee:'rgba(245,158,11,0.1)', withdrawal:'rgba(239,68,68,0.1)' };

        container.innerHTML = `
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px;">
                <div style="background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.2);border-radius:10px;padding:8px 14px;">
                    <div style="font-size:0.65rem;color:#9ca3af;font-weight:600;text-transform:uppercase;">Total Deposits</div>
                    <div style="font-weight:800;color:#10b981;font-size:0.9rem;">₦${totalDeposits.toLocaleString()}</div>
                </div>
                <div style="background:rgba(6,182,212,0.06);border:1px solid rgba(6,182,212,0.2);border-radius:10px;padding:8px 14px;">
                    <div style="font-size:0.65rem;color:#9ca3af;font-weight:600;text-transform:uppercase;">Total Interest</div>
                    <div style="font-weight:800;color:#06b6d4;font-size:0.9rem;">₦${totalInterest.toLocaleString(undefined,{maximumFractionDigits:2})}</div>
                </div>
                <div style="background:rgba(236,72,153,0.06);border:1px solid rgba(236,72,153,0.15);border-radius:10px;padding:8px 14px;">
                    <div style="font-size:0.65rem;color:#9ca3af;font-weight:600;text-transform:uppercase;">Total Records</div>
                    <div style="font-weight:800;color:var(--kiddies);font-size:0.9rem;">${allTxs.length}</div>
                </div>
            </div>
            <div>
                ${allTxs.map(tx => `
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(236,72,153,0.07);">
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
                                <span style="background:${typeBg[tx.type]||'rgba(107,114,128,0.1)'};color:${typeColors[tx.type]||'#6b7280'};font-size:0.64rem;font-weight:700;padding:2px 8px;border-radius:20px;text-transform:uppercase;">${tx.type}</span>
                                <span style="font-size:0.68rem;color:#9ca3af;">${new Date(tx.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span>
                                ${tx.status==='pending'?'<span style="background:rgba(245,158,11,0.1);color:#b45309;font-size:0.62rem;font-weight:700;padding:2px 6px;border-radius:20px;">PENDING</span>':''}
                            </div>
                            <div style="font-size:0.72rem;color:#374151;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${nameMap[tx._accountId]||'Unknown'}</div>
                            <div style="font-size:0.68rem;color:#9ca3af;">${tx.description||''}</div>
                        </div>
                        <div style="text-align:right;flex-shrink:0;margin-left:12px;">
                            <div style="font-weight:800;color:${tx.type==='withdrawal'?'#ef4444':'#10b981'};font-size:0.86rem;">${tx.type==='withdrawal'?'-':'+'}₦${tx.amount.toLocaleString()}</div>
                            ${tx.balanceAfter ? `<div style="font-size:0.66rem;color:#9ca3af;">Bal: ₦${tx.balanceAfter.toLocaleString()}</div>` : ''}
                        </div>
                    </div>`).join('')}
            </div>`;
    } catch (err) {
        console.error("Tx load error:", err);
        container.innerHTML = '<p class="text-danger text-center py-4" style="font-size:0.8rem;">Error loading transactions.</p>';
    }
}

/* ══ Open edit beneficiary modal ══ */
function openEditBeneficiary(accountId) {
    const accounts = <%- JSON.stringify(kiddiesAccounts.map(k => ({
        _id: k._id,
        nextOfKin: k.nextOfKin
    }))) %>;
    const ka = accounts.find(a => a._id === accountId);
    if (!ka) return;

    document.getElementById("editBeneficiaryAccountId").value      = accountId;
    document.getElementById("editBeneficiaryFullName").value        = ka.nextOfKin.fullName || '';
    document.getElementById("editBeneficiaryPhone").value           = ka.nextOfKin.phone || '';
    document.getElementById("editBeneficiaryEmail").value           = ka.nextOfKin.email || '';
    document.getElementById("editBeneficiaryRelationship").value    = ka.nextOfKin.relationship || '';
    document.getElementById("editBeneficiaryAddress").value         = ka.nextOfKin.address || '';

    openModal("editBeneficiaryModal");
}

/* ══ Submit beneficiary update ══ */
async function submitBeneficiaryUpdate() {
    const form = document.getElementById("editBeneficiaryForm");
    if (!form.reportValidity()) return;

    const btn     = document.getElementById("editBeneficiaryBtn");
    const spinner = document.getElementById("editBenBtnSpinner");
    const text    = document.getElementById("editBenBtnText");
    btn.disabled  = true;
    spinner.style.display = "inline-block";
    text.style.display    = "none";

    const accountId = document.getElementById("editBeneficiaryAccountId").value;
    const data      = Object.fromEntries(new FormData(form).entries());

    try {
        const res    = await fetch(`/api/kiddies/beneficiary/${accountId}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
        });
        const result = await res.json();

        btn.disabled = false;
        spinner.style.display = "none";
        text.style.display    = "inline";

        if (res.ok && result.status) {
            bootstrap.Modal.getInstance(document.getElementById("editBeneficiaryModal")).hide();
            showSuccess("Update Submitted", result.message, false);
        } else {
            showToast(result.message || "Update failed.", "error");
        }
    } catch (err) {
        btn.disabled = false;
        spinner.style.display = "none";
        text.style.display    = "inline";
        showToast("Network error.", "error");
    }
}

/* ══ Close sidebar on outside click ══ */
document.addEventListener("click", e => {
    const sb = document.getElementById("sidebar");
    if (window.innerWidth <= 992 && sb.classList.contains("active") &&
        !sb.contains(e.target) && !e.target.classList.contains("fa-bars")) {
        closeSidebar();
    }
});

/* ══ Loader ══ */
window.addEventListener("load", () => {
    const loader = document.getElementById("loaderScreen");
    setTimeout(() => {
        loader.style.opacity    = "0";
        loader.style.transition = "opacity 0.5s ease";
        setTimeout(() => loader.style.display = "none", 500);
    }, 600);
});

/* ══ Entrance animations + init ══ */
document.addEventListener("DOMContentLoaded", () => {
    syncLockPeriod('init', 5);

    document.querySelectorAll(".stat-card, .card, .kid-card").forEach((el, i) => {
        el.style.opacity   = "0";
        el.style.transform = "translateY(14px)";
        el.style.transition = "opacity 0.4s ease, transform 0.4s ease";
        setTimeout(() => { el.style.opacity = "1"; el.style.transform = "translateY(0)"; }, i * 70);
    });

    const params = new URLSearchParams(window.location.search);
    if (params.get("payment") === "success") showToast("🎉 Account created! Pending admin approval.", "success");
    if (params.get("payment") === "failed")  showToast("Payment failed. Please try again.", "error");
});
</script>
</body>
</html>
