<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club De Stars - Kiddies Account | Powered by JESZ LIMITED</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --kiddies: #ec4899;
            --sidebar-width: 280px;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #fef3c7 0%, #fed7aa 50%, #fecaca 100%);
            min-height: 100vh;
        }
        
        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #ec4899 0%, #db2777 50%, #be185d 100%);
            color: white;
            z-index: 1040;
            transition: all 0.3s;
            overflow-y: auto;
            box-shadow: 4px 0 20px rgba(236, 72, 153, 0.15);
        }
        
        .sidebar-header {
            padding: 2rem 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.1);
        }
        
        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        
        .logo-box {
            width: 45px;
            height: 45px;
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--kiddies);
            font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        
        .sidebar-menu {
            padding: 1rem 0;
        }
        
        .sidebar-menu a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            padding: 0.875rem 1.5rem;
            display: flex;
            align-items: center;
            transition: all 0.3s;
            border-left: 3px solid transparent;
            font-weight: 500;
        }
        
        .sidebar-menu a:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a.active {
            background: rgba(255,255,255,0.15);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a i {
            width: 24px;
            margin-right: 12px;
            font-size: 1.1rem;
        }
        
        /* Top Navbar */
        .top-navbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: 75px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(236, 72, 153, 0.08);
            z-index: 1030;
            display: flex;
            align-items: center;
            padding: 0 2rem;
            transition: all 0.3s;
            border-bottom: 1px solid rgba(236, 72, 153, 0.1);
        }
        
        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: 75px;
            padding: 2rem;
            min-height: calc(100vh - 75px);
            transition: all 0.3s;
        }
        
        .gradient-bg {
            background: linear-gradient(135deg, #ec4899 0%, #db2777 50%, #be185d 100%);
        }
        
        .welcome-card {
            background: linear-gradient(135deg, #ec4899 0%, #db2777 50%, #be185d 100%);
            color: white;
            border-radius: 24px;
            padding: 2.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 15px 40px rgba(236, 72, 153, 0.25);
            position: relative;
            overflow: hidden;
        }
        
        .welcome-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }
        
        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 1.75rem;
            box-shadow: 0 8px 20px rgba(236, 72, 153, 0.08);
            transition: transform 0.3s, box-shadow 0.3s;
            height: 100%;
            border: 1px solid rgba(236, 72, 153, 0.05);
        }
        
        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(236, 72, 153, 0.15);
        }
        
        .stat-icon {
            width: 65px;
            height: 65px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }
        
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 8px 20px rgba(236, 72, 153, 0.08);
            background: white;
            border: 1px solid rgba(236, 72, 153, 0.05);
        }
        
        .card-header {
            background: linear-gradient(135deg, rgba(236, 72, 153, 0.03) 0%, rgba(219, 39, 119, 0.03) 100%);
            border-bottom: 2px solid rgba(236, 72, 153, 0.1);
            padding: 1.5rem;
            border-radius: 20px 20px 0 0 !important;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #ec4899 0%, #be185d 100%);
            border: none;
            padding: 0.7rem 1.75rem;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(236, 72, 153, 0.3);
        }
        
        .btn-outline-primary {
            border: 2px solid var(--kiddies);
            color: var(--kiddies);
            border-radius: 12px;
            padding: 0.7rem 1.75rem;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-outline-primary:hover {
            background: var(--kiddies);
            color: white;
            transform: translateY(-2px);
        }
        
        .kiddies-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.3);
            font-weight: 600;
            font-size: 0.9rem;
        }
        
        .quick-action {
            text-align: center;
            padding: 1.75rem;
            border-radius: 16px;
            background: linear-gradient(135deg, rgba(236, 72, 153, 0.03) 0%, rgba(219, 39, 119, 0.03) 100%);
            border: 2px solid rgba(236, 72, 153, 0.1);
            transition: all 0.3s;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            display: block;
        }
        
        .quick-action:hover {
            background: linear-gradient(135deg, #ec4899 0%, #be185d 100%);
            color: white;
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(236, 72, 153, 0.25);
            border-color: transparent;
        }
        
        .quick-action i {
            font-size: 2.2rem;
            margin-bottom: 0.75rem;
            display: block;
        }
        
        .alert-warning-custom {
            background: linear-gradient(135d, #fef3c7 0%, #fde68a 100%);
            border: 2px solid #f59e0b;
            border-radius: 16px;
            padding: 1.25rem;
            color: #92400e;
        }
        
        .alert-info-custom {
            background: linear-gradient(135deg, #fce7f3 0%, #fbcfe8 100%);
            border: 2px solid #ec4899;
            border-radius: 16px;
            padding: 1.25rem;
            color: #831843;
        }
        
        .powered-by {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: white;
            padding: 12px 20px;
            border-radius: 30px;
            box-shadow: 0 4px 15px rgba(236, 72, 153, 0.15);
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--kiddies);
            z-index: 1000;
        }
        
        .kid-card {
            background: linear-gradient(135deg, rgba(236, 72, 153, 0.05) 0%, rgba(219, 39, 119, 0.05) 100%);
            border: 2px solid rgba(236, 72, 153, 0.1);
            border-radius: 20px;
            padding: 1.5rem;
            transition: all 0.3s;
            cursor: pointer;
        }
        
        .kid-card:hover {
            border-color: var(--kiddies);
            box-shadow: 0 8px 25px rgba(236, 72, 153, 0.15);
            transform: translateY(-5px);
        }
        
        .kid-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ec4899 0%, #be185d 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            margin: 0 auto 1rem;
            box-shadow: 0 4px 15px rgba(236, 72, 153, 0.2);
        }
        
        .progress {
            height: 10px;
            border-radius: 10px;
            background: rgba(236, 72, 153, 0.1);
        }
        
        .progress-bar {
            background: linear-gradient(90deg, #ec4899 0%, #be185d 100%);
            border-radius: 10px;
        }
        
        /* Mobile Table Styles */
        .mobile-table-card {
            display: none;
        }

        .mobile-stat-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px solid rgba(236, 72, 153, 0.1);
        }

        .mobile-stat-row:last-child {
            border-bottom: none;
        }

        /* Responsive Button Groups */
        .btn-group-responsive {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .btn-group-responsive .btn {
            flex: 1;
            min-width: 150px;
            white-space: nowrap;
        }

        @media (max-width: 992px) {
            .sidebar {
                left: calc(-1 * var(--sidebar-width));
            }
            
            .sidebar.active {
                left: 0;
            }
            
            .top-navbar {
                left: 0;
                height: 60px;
                padding: 0 1rem;
            }
            
            .main-content {
                margin-left: 0;
                margin-top: 60px;
                padding: 1rem;
            }
            
            .powered-by {
                bottom: 10px;
                right: 10px;
                font-size: 0.75rem;
                padding: 8px 12px;
            }

            .welcome-card {
                padding: 1.5rem;
            }

            .stat-card {
                padding: 1.25rem;
            }

            .stat-icon {
                width: 50px;
                height: 50px;
                font-size: 1.4rem;
            }

            .kid-avatar {
                width: 60px;
                height: 60px;
                font-size: 1.5rem;
            }
        }

        @media (max-width: 768px) {
            /* Hide desktop table, show mobile cards */
            .table-responsive table {
                display: none;
            }

            .mobile-table-card {
                display: block;
            }

            /* Stack buttons vertically */
            .btn-group-responsive .btn {
                width: 100%;
                min-width: 100%;
            }

            /* Adjust card headers */
            .card-header {
                padding: 1rem;
                flex-direction: column;
                align-items: flex-start !important;
                gap: 0.75rem;
            }

            .card-header .btn {
                width: 100%;
            }

            /* Modal adjustments */
            .modal-dialog {
                margin: 0.5rem;
            }

            .modal-body {
                padding: 1rem;
            }

            /* Welcome card text */
            .welcome-card h2 {
                font-size: 1.5rem;
            }

            .welcome-card p {
                font-size: 0.9rem;
            }

            /* Stat cards in single column */
            .row.g-4 > [class*="col-lg-3"] {
                flex: 0 0 100%;
                max-width: 100%;
            }

            /* Alert boxes */
            .alert-warning-custom, .alert-info-custom {
                padding: 1rem;
                font-size: 0.875rem;
            }

            /* Quick actions grid */
            .quick-action {
                padding: 1.25rem;
            }

            .quick-action i {
                font-size: 1.8rem;
            }

            .quick-action h6 {
                font-size: 0.875rem;
            }

            /* Kid cards spacing */
            .kid-card {
                margin-bottom: 1rem;
            }

            /* Form inputs */
            .form-control, .form-select {
                font-size: 16px; /* Prevents zoom on iOS */
            }

            /* Calculator results */
            #calculationResults h2 {
                font-size: 1.75rem;
            }

            /* Beneficiary cards */
            .row.g-4 > [class*="col-md-6"] {
                flex: 0 0 100%;
                max-width: 100%;
            }

            /* Progress bars */
            .progress {
                height: 8px;
            }

            /* Badges */
            .badge {
                font-size: 0.75rem;
                padding: 0.35rem 0.65rem;
            }

            /* Member badges */
            .kiddies-badge {
                font-size: 0.8rem;
                padding: 6px 12px;
            }

            /* Modal full width on mobile */
            .modal-lg {
                max-width: 100%;
                margin: 0;
            }

            .modal-content {
                border-radius: 0;
                min-height: 100vh;
            }

            .modal-header {
                border-radius: 0 !important;
            }
        }

        @media (max-width: 576px) {
            /* Extra small devices */
            .top-navbar {
                height: 55px;
            }

            .main-content {
                margin-top: 55px;
                padding: 0.75rem;
            }

            .welcome-card {
                padding: 1rem;
                margin-bottom: 1rem;
            }

            .welcome-card h2 {
                font-size: 1.25rem;
                margin-bottom: 0.75rem;
            }

            .welcome-card .d-flex {
                flex-direction: column !important;
                gap: 0.5rem !important;
            }

            .kiddies-badge {
                width: 100%;
                justify-content: center;
            }

            .stat-card {
                padding: 1rem;
            }

            .stat-card h3 {
                font-size: 1.5rem;
            }

            .card {
                margin-bottom: 1rem;
            }

            .card-header h5 {
                font-size: 1rem;
            }

            /* Quick actions 2 columns on mobile */
            .quick-action {
                padding: 1rem;
            }

            /* Form row adjustments */
            .row > [class*="col-md-"] {
                flex: 0 0 100%;
                max-width: 100%;
                margin-bottom: 0.75rem;
            }

            /* Calculator inputs */
            #savingsCalculator .mb-3 {
                margin-bottom: 0.75rem !important;
            }

            /* Footer buttons */
            .modal-footer {
                flex-direction: column;
                padding: 1rem;
            }

            .modal-footer .btn {
                width: 100%;
                margin: 0.25rem 0;
            }

            /* Smaller text in tables */
            .mobile-table-card small {
                font-size: 0.75rem;
            }

            /* Powered by badge */
            .powered-by {
                font-size: 0.65rem;
                padding: 6px 10px;
                bottom: 5px;
                right: 5px;
            }
        }

        @media print {
            .sidebar, .top-navbar, .btn, .quick-action, .powered-by {
                display: none !important;
            }
            
            .main-content {
                margin: 0;
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-box">
                    <i class="fas fa-child"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="text-transform: uppercase;">Kiddies Account</h5>
                    <small class="opacity-75">FUTURE SAVINGS PLAN</small>
                </div>
            </div>
            <div class="kiddies-badge">
                <i class="fas fa-star"></i>
                <span>Parent Dashboard</span>
            </div>
        </div>
        <div class="sidebar-menu">
            <a href="#" onclick="showSection('dashboard', event)" class="active">
                <i class="fas fa-home"></i> Dashboard
            </a>
            <a href="#" onclick="showSection('accounts', event)">
                <i class="fas fa-users"></i> My Kids Accounts
            </a>
            <a href="#" onclick="showSection('transactions', event)">
                <i class="fas fa-exchange-alt"></i> Transactions
            </a>
            <a href="#" onclick="showSection('beneficiaries', event)">
                <i class="fas fa-user-shield"></i> Beneficiaries
            </a>
            <a href="/club-de-star-cooperative/dashboard">
                <i class="fas fa-arrow-left"></i> Back to Main Dashboard
            </a>
            <a href="/logout" class="mt-3" style="color: rgba(255,255,255,0.6);">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <!-- Top Navbar -->
    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3"
           style="cursor: pointer; color: var(--kiddies); font-size: 1.5rem;"
           onclick="document.getElementById('sidebar').classList.toggle('active')"></i>

        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color: var(--kiddies)">Kiddies Account Dashboard 🎈</h5>
            <small class="text-muted">Securing your children's future, one deposit at a time</small>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Dashboard Section -->
        <div id="dashboard" class="content-section">
            <!-- Welcome Card -->
            <div class="welcome-card position-relative">
                <div class="row align-items-center position-relative" style="z-index: 1;">
                    <div class="col-md-8">
                        <h2 class="mb-3 fw-bold">Welcome to Kiddies Account! 🎉</h2>
                        <p class="mb-3 opacity-90 fs-5">Invest in your children's future with our secure 5-year minimum savings plan</p>
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="kiddies-badge">
                                <i class="fas fa-shield-alt"></i>
                                <span>5-Year Minimum Term</span>
                            </div>
                            <div class="kiddies-badge">
                                <i class="fas fa-chart-line"></i>
                                <span>Competitive Interest Rates</span>
                            </div>
                            <div class="kiddies-badge">
                                <i class="fas fa-lock"></i>
                                <span>Secure & Protected</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        <button class="btn btn-light btn-lg" onclick="openModal('createAccountModal')">
                            <i class="fas fa-plus-circle me-2"></i>Create New Account
                        </button>
                    </div>
                </div>
            </div>

            <!-- Important Notice -->
            <div class="alert-info-custom mb-4">
                <h6 class="fw-bold mb-2"><i class="fas fa-info-circle me-2"></i>Important Information</h6>
                <p class="mb-0">Kiddies accounts have a <strong>5-year minimum savings period</strong>. Early withdrawals are not permitted to ensure maximum growth for your child's future. Each account must have a designated next of kin (Lawyer or Family Member).</p>
            </div>

            <!-- Stats Cards -->
            <div class="row g-4 mb-4">
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #ec4899 0%, #be185d 100%); color: white;">
                            <i class="fas fa-users"></i>
                        </div>
                        <p class="text-muted mb-1 fw-semibold">Total Kids Accounts</p>
                        <h3 class="mb-2 fw-bold">3</h3>
                        <small class="fw-semibold" style="color: var(--kiddies);">
                            <i class="fas fa-check-circle me-1"></i>All Active
                        </small>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                            <i class="fas fa-piggy-bank"></i>
                        </div>
                        <p class="text-muted mb-1 fw-semibold">Total Savings</p>
                        <h3 class="mb-2 fw-bold">₦1,250,000</h3>
                        <small class="text-success fw-semibold">
                            <i class="fas fa-arrow-up me-1"></i>+₦50,000 this month
                        </small>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); color: white;">
                            <i class="fas fa-percentage"></i>
                        </div>
                        <p class="text-muted mb-1 fw-semibold">Total Interest Earned</p>
                        <h3 class="mb-2 fw-bold">₦87,500</h3>
                        <small class="text-info fw-semibold">
                            <i class="fas fa-chart-line me-1"></i>Since inception
                        </small>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <p class="text-muted mb-1 fw-semibold">Maturity Date</p>
                        <h3 class="mb-2 fw-bold">2029</h3>
                        <small class="text-warning fw-semibold">
                            <i class="fas fa-clock me-1"></i>Earliest account
                        </small>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-bolt me-2" style="color: var(--kiddies);"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6 col-6">
                            <a href="#" class="quick-action" onclick="openModal('createAccountModal')">
                                <i class="fas fa-user-plus" style="color: #ec4899;"></i>
                                <h6 class="mb-0 fw-semibold">New Account</h6>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6 col-6">
                            <a href="#" class="quick-action" onclick="openModal('depositModal')">
                                <i class="fas fa-plus-circle" style="color: #10b981;"></i>
                                <h6 class="mb-0 fw-semibold">Make Deposit</h6>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6 col-6">
                            <a href="#" class="quick-action" onclick="showSection('transactions', event)">
                                <i class="fas fa-history" style="color: #06b6d4;"></i>
                                <h6 class="mb-0 fw-semibold">View History</h6>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6 col-6">
                            <a href="#" class="quick-action" onclick="showSection('calculator', event)">
