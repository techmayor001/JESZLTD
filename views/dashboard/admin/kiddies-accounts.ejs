<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kiddies Accounts | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary:       #1e3a8a;
            --primary-dark:  #1e40af;
            --primary-light: #3b82f6;
            --success:       #10b981;
            --danger:        #ef4444;
            --warning:       #f59e0b;
            --kiddies:       #ec4899;
            --kiddies-dark:  #db2777;
            --kiddies-light: #f9a8d4;
            --sidebar-width: 280px;
            --navbar-h:      70px;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 50%, #ede9fe 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── SIDEBAR ─────────────────────────────────────── */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; z-index: 1040;
            transition: transform .3s ease;
            overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30,58,138,.15);
        }
        .sidebar-header { padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.1); }
        .logo-container { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .logo-box { width: 45px; height: 45px; background: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--primary); font-size: 1.5rem; box-shadow: 0 4px 10px rgba(0,0,0,.2); flex-shrink: 0; }
        .sidebar-title { font-size: 1.1rem; line-height: 1.2; }
        .admin-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; background: rgba(239,68,68,.2); backdrop-filter: blur(10px); border-radius: 20px; border: 1px solid rgba(239,68,68,.3); font-weight: 600; font-size: .8rem; margin-top: 8px; }
        .sidebar-menu { padding: 1rem 0; }
        .sidebar-menu a { color: rgba(255,255,255,.85); text-decoration: none; padding: .875rem 1.5rem; display: flex; align-items: center; transition: all .3s; border-left: 3px solid transparent; font-weight: 500; font-size: .95rem; }
        .sidebar-menu a:hover { background: rgba(255,255,255,.1); color: white; border-left-color: white; }
        .sidebar-menu a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-menu a i { width: 24px; margin-right: 12px; font-size: 1.1rem; flex-shrink: 0; }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }

        /* ── NAVBAR ──────────────────────────────────────── */
        .top-navbar {
            position: fixed; top: 0;
            left: var(--sidebar-width); right: 0;
            height: var(--navbar-h);
            background: rgba(255,255,255,.97);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(236,72,153,.1);
            z-index: 1030;
            display: flex; align-items: center;
            padding: 0 1.5rem; gap: 1rem;
            transition: left .3s ease;
            border-bottom: 2px solid rgba(236,72,153,.15);
        }

        /* ── MAIN ────────────────────────────────────────── */
        .main-content { margin-left: var(--sidebar-width); margin-top: var(--navbar-h); padding: 1.5rem; min-height: calc(100vh - var(--navbar-h)); }

        /* ── PAGE HEADER ─────────────────────────────────── */
        .page-header {
            background: linear-gradient(135deg, #ec4899 0%, #db2777 50%, #be185d 100%);
            border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 8px 30px rgba(236,72,153,.35);
            color: white; position: relative; overflow: hidden;
        }
        .page-header::before {
            content: ''; position: absolute; top: -50%; right: -10%;
            width: 300px; height: 300px;
            background: rgba(255,255,255,.06); border-radius: 50%;
        }
        .page-header::after {
            content: ''; position: absolute; bottom: -60%; right: 15%;
            width: 200px; height: 200px;
            background: rgba(255,255,255,.04); border-radius: 50%;
        }

        /* ── STAT CARDS ──────────────────────────────────── */
        .stat-card { background: white; border-radius: 16px; padding: 1.5rem; box-shadow: 0 8px 20px rgba(236,72,153,.08); transition: transform .3s, box-shadow .3s; height: 100%; border: 1px solid rgba(236,72,153,.08); }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(236,72,153,.18); }
        .stat-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 1rem; }

        /* ── FILTER / TABLE ──────────────────────────────── */
        .filter-section { background: white; border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 4px 15px rgba(236,72,153,.06); }
        .table-card { background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 20px rgba(236,72,153,.08); }
        .scroll-hint { display: none; align-items: center; gap: 6px; padding: .3rem 1rem; background: rgba(236,72,153,.04); font-size: .78rem; color: var(--kiddies); font-weight: 600; }
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: rgba(236,72,153,.2) transparent; }
        .table-responsive::-webkit-scrollbar { height: 4px; }
        .table-responsive::-webkit-scrollbar-thumb { background: rgba(236,72,153,.25); border-radius: 4px; }
        .table { margin-bottom: 0; font-size: .9rem; min-width: 1000px; width: 100%; }
        .table thead { background: linear-gradient(135deg, rgba(236,72,153,.05) 0%, rgba(219,39,119,.05) 100%); }
        .table thead th { border: none; padding: 1rem; font-weight: 600; color: var(--kiddies-dark); white-space: nowrap; }
        .table tbody td { padding: 1rem; vertical-align: middle; }
        .table tbody tr:hover { background: rgba(236,72,153,.03); }

        /* ── BADGES ──────────────────────────────────────── */
        .badge { padding: .45rem .85rem; border-radius: 8px; font-weight: 600; font-size: .73rem; white-space: nowrap; }
        .badge-active { background: linear-gradient(135deg,#d1fae5,#a7f3d0); color: #065f46; }
        .badge-locked { background: linear-gradient(135deg,#fef3c7,#fde68a); color: #78350f; }
        .badge-pending { background: linear-gradient(135deg,#dbeafe,#bfdbfe); color: #1e3a8a; }
        .badge-closed  { background: linear-gradient(135deg,#f3f4f6,#e5e7eb); color: #374151; }
        .badge-paid    { background: linear-gradient(135deg,#d1fae5,#a7f3d0); color: #065f46; }
        .badge-unpaid  { background: linear-gradient(135deg,#fee2e2,#fca5a5); color: #7f1d1d; }
        .badge-lawyer  { background: linear-gradient(135deg,#ede9fe,#ddd6fe); color: #4c1d95; }
        .badge-family  { background: linear-gradient(135deg,#fce7f3,#fbcfe8); color: #831843; }

        /* ── BUTTONS ─────────────────────────────────────── */
        .action-btn { padding: .35rem .7rem; border-radius: 8px; font-size: .82rem; border: none; transition: all .3s; cursor: pointer; }
        .btn-group-tight { display: flex; flex-wrap: nowrap; gap: 3px; }
        .btn-kiddies { background: linear-gradient(135deg,#ec4899,#db2777); border: none; border-radius: 10px; padding: .6rem 1.5rem; font-weight: 600; color: white; transition: all .3s; }
        .btn-kiddies:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(236,72,153,.4); color: white; }
        .btn-outline-kiddies { border: 2px solid var(--kiddies); color: var(--kiddies); background: transparent; font-weight: 600; transition: all .3s; border-radius: 10px; }
        .btn-outline-kiddies:hover { background: var(--kiddies); color: white; transform: translateY(-2px); }
        .btn-sm { padding: .4rem 1rem; font-size: .85rem; border-radius: 8px; }

        /* ── FORM CONTROLS ───────────────────────────────── */
        .form-label { font-weight: 600; color: var(--kiddies-dark); margin-bottom: .5rem; }
        .form-control, .form-select { border-radius: 10px; border: 2px solid rgba(236,72,153,.15); padding: .65rem 1rem; transition: border-color .2s; }
        .form-control:focus, .form-select:focus { border-color: var(--kiddies); box-shadow: 0 0 0 .2rem rgba(236,72,153,.12); }
        .search-box { position: relative; }
        .search-box input { padding-left: 2.5rem; }
        .search-box i { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--kiddies); }

        /* ── CARDS ───────────────────────────────────────── */
        .card { border: none; border-radius: 16px; box-shadow: 0 8px 20px rgba(236,72,153,.08); background: white; border: 1px solid rgba(236,72,153,.08); }
        .card-header { background: linear-gradient(135deg, rgba(236,72,153,.04) 0%, rgba(219,39,119,.04) 100%); border-bottom: 2px solid rgba(236,72,153,.1); padding: 1.25rem; border-radius: 16px 16px 0 0 !important; }

        /* ── MODALS ──────────────────────────────────────── */
        .modal-content { border-radius: 16px; border: none; }
        .modal-header { border-radius: 16px 16px 0 0; background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); color: white; border: none; }
        .modal-header .btn-close { filter: invert(1); }
        .modal-header.danger-header { background: linear-gradient(135deg, #7f1d1d 0%, #ef4444 100%) !important; }
        .modal-header.success-header { background: linear-gradient(135deg, #064e3b 0%, #10b981 100%) !important; }
        .modal-header.warning-header { background: linear-gradient(135deg, #78350f 0%, #f59e0b 100%) !important; }

        /* ── CHILD AVATAR ────────────────────────────────── */
        .child-avatar { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #ec4899, #db2777); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1rem; flex-shrink: 0; border: 2px solid rgba(236,72,153,.2); }
        .parent-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(30,58,138,.15); flex-shrink: 0; }

        /* ── DETAIL MODAL ────────────────────────────────── */
        .detail-section { background: rgba(236,72,153,.04); border-radius: 12px; padding: 1.25rem; border: 1px solid rgba(236,72,153,.1); }
        .detail-label { font-size: .78rem; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; margin-bottom: .2rem; }
        .detail-value { font-weight: 600; color: #1f2937; font-size: .92rem; }
        .progress-bar-kiddies { background: linear-gradient(90deg, #ec4899, #db2777); border-radius: 10px; }
        .maturity-progress { height: 8px; border-radius: 10px; background: rgba(236,72,153,.15); overflow: hidden; }

        /* ── TX ROW ──────────────────────────────────────── */
        .tx-row { display: flex; align-items: center; gap: .875rem; padding: .875rem 0; border-bottom: 1px solid rgba(236,72,153,.07); }
        .tx-row:last-child { border-bottom: none; }
        .tx-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }

        /* ── PAGINATION ──────────────────────────────────── */
        .page-link { color: var(--kiddies); border-radius: 8px; margin: 0 .25rem; border: 2px solid rgba(236,72,153,.15); }
        .page-link:hover { background: var(--kiddies); color: white; border-color: var(--kiddies); }
        .page-item.active .page-link { background: var(--kiddies); border-color: var(--kiddies); }

        /* ── NOTIFICATION MODAL ──────────────────────────── */
        #notifyModal .modal-content { border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,.18); }
        #notifyModal .modal-header { background: transparent !important; border: none; display: none; }
        #notifyModal .modal-body { padding: 2rem; text-align: center; }
        .notify-icon-wrap { width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 2.2rem; animation: notifyPop .4s cubic-bezier(.34,1.56,.64,1) both; }
        @keyframes notifyPop { from {transform:scale(.4);opacity:0;} to {transform:scale(1);opacity:1;} }
        .notify-icon-wrap.success { background: linear-gradient(135deg,#d1fae5,#6ee7b7); color:#059669; }
        .notify-icon-wrap.error   { background: linear-gradient(135deg,#fee2e2,#fca5a5); color:#dc2626; }
        .notify-icon-wrap.warning { background: linear-gradient(135deg,#fef3c7,#fcd34d); color:#d97706; }
        .notify-icon-wrap.info    { background: linear-gradient(135deg,#fce7f3,#fbcfe8); color:#ec4899; }
        .notify-title { font-size: 1.25rem; font-weight: 700; margin-bottom: .5rem; }
        .notify-title.success { color:#065f46; } .notify-title.error { color:#7f1d1d; }
        .notify-title.warning { color:#78350f; } .notify-title.info  { color:#831843; }
        .notify-message { color:#475569; font-size:.95rem; line-height:1.6; margin-bottom:1.5rem; white-space:pre-line; }
        .notify-footer { display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap; }
        .notify-btn-ok { padding:.6rem 2rem; border-radius:10px; border:none; font-weight:600; font-size:.95rem; cursor:pointer; transition:all .25s; color:white; }
        .notify-btn-ok.success { background:linear-gradient(135deg,#10b981,#059669); }
        .notify-btn-ok.error   { background:linear-gradient(135deg,#ef4444,#dc2626); }
        .notify-btn-ok.warning { background:linear-gradient(135deg,#f59e0b,#d97706); }
        .notify-btn-ok.info    { background:linear-gradient(135deg,#ec4899,#db2777); }
        .notify-btn-ok:hover   { transform:translateY(-2px); box-shadow:0 6px 18px rgba(0,0,0,.18); }
        .notify-btn-cancel { padding:.6rem 1.5rem; border-radius:10px; border:2px solid #e2e8f0; background:white; color:#64748b; font-weight:600; font-size:.95rem; cursor:pointer; transition:all .25s; }
        .notify-btn-cancel:hover { background:#f1f5f9; border-color:#cbd5e1; }

        /* ── POWERED BY ──────────────────────────────────── */
        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(236,72,153,.15); font-size: .8rem; font-weight: 600; color: var(--kiddies); z-index: 1000; }

        /* ── ANIMATIONS ──────────────────────────────────── */
        @keyframes fadeIn { from { opacity:0; transform:translateY(10px);} to {opacity:1; transform:translateY(0);} }
        .animate-in { animation: fadeIn .4s ease both; }

        /* ── EMPTY STATE ─────────────────────────────────── */
        .empty-state { padding: 3rem 1rem; text-align: center; }
        .empty-state .empty-icon { width: 80px; height: 80px; border-radius: 50%; background: rgba(236,72,153,.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 2rem; color: var(--kiddies); }

        /* ── RESPONSIVE ──────────────────────────────────── */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0 !important; }
            .main-content { margin-left: 0 !important; padding: 1rem; }
            .scroll-hint { display: flex; }
        }
        @media (max-width: 768px) {
            .page-header { padding: 1.25rem; }
            .stats-row > [class*="col-"] { flex: 0 0 50%; max-width: 50%; }
            .stat-card { display: flex; flex-direction: row; align-items: center; gap: 1rem; padding: 1rem; }
            .stat-icon { margin-bottom: 0; width: 48px; height: 48px; font-size: 1.25rem; }
        }
        @media (max-width: 576px) {
            :root { --navbar-h: 60px; }
            .main-content { padding: .75rem; }
            .stats-row > [class*="col-"] { flex: 0 0 50%; max-width: 50%; }
            .modal-dialog { margin: .4rem; max-width: calc(100vw - .8rem); }
            .notify-footer { flex-direction: column-reverse; }
            .notify-btn-ok, .notify-btn-cancel { width: 100%; }
        }
    </style>
</head>
<body>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-container">
            <div class="logo-box">C</div>
            <div>
                <h5 class="mb-0 fw-bold sidebar-title" style="text-transform:uppercase;">Club De Stars</h5>
                <small class="opacity-75" style="font-size:.75rem;">ADMIN PANEL</small>
            </div>
        </div>
        <div class="admin-badge"><i class="fas fa-shield-alt"></i><span>Super Admin</span></div>
    </div>
  <div class="sidebar-menu">
            <a href="/admin-dashboard"><i class="fas fa-users"></i> Members</a>
            <a href="/admin/kiddies-accounts" class="active"><i class="fas fa-baby"></i> Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i> Membership Types</a>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i> Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i> Approvals<span id="sidebarPendingBadge" class="badge bg-danger ms-1" style="display:none;">0</span></a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i> Deposit Management</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i> Withdrawals</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-hand-holding-usd"></i> Extra Charges</a>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i> Loan Management</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i> Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i> External Loans</a>
            <a href="/admin/finance"><i class="fas fa-landmark"></i> Company Finance</a>
            <a href="#"><i class="fas fa-chart-pie"></i> ROI Distribution</a>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i> Manage Subscription</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i> Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i> Settings</a>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i> Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i> Admin Logs</a>
            <a href="/cds-cooperative/dashboard" class="mt-3" style="color:rgba(255,255,255,.6);"><i class="fas fa-sign-in-alt"></i> Back to Dashboard</a>
        </div>
</div>

<!-- Top Navbar -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--kiddies);font-size:1.5rem;" onclick="toggleSidebar()"></i>
    <div class="flex-grow-1 d-none d-lg-block">
        <h5 class="mb-0 fw-bold" style="color:var(--kiddies)"><i class="fas fa-baby me-2"></i>Kiddies Account Management</h5>
        <small class="text-muted">Review, approve, and manage all children's savings accounts</small>
    </div>
    <div class="d-lg-none">
        <span class="fw-bold" style="color:var(--kiddies);font-size:.95rem;">Kiddies Accounts</span>
    </div>
    <div class="ms-auto d-flex gap-2 align-items-center">
        <span class="badge" style="background:rgba(236,72,153,.1);color:var(--kiddies);font-size:.8rem;padding:.5rem 1rem;">
            <i class="fas fa-baby me-1"></i>
            <span id="totalCountBadge">0</span> Total
        </span>
    </div>
</div>

<div id="sidebarOverlay" class="sidebar-overlay" onclick="closeSidebar()"></div>

<!-- MAIN CONTENT -->
<div class="main-content">

    <!-- Page Header -->
    <div class="page-header animate-in">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3" style="position:relative;z-index:1;">
            <div>
                <h3 class="mb-1 fw-bold text-white"><i class="fas fa-baby me-2"></i>Kiddies Accounts</h3>
                <p class="mb-0" style="opacity:.85;">Manage children's savings accounts — approvals, transactions, beneficiaries</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-light btn-sm fw-semibold" onclick="exportData()">
                    <i class="fas fa-download me-1"></i>Export
                </button>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4 stats-row">
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#ec4899,#db2777);color:white;"><i class="fas fa-baby"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Total Accounts</p><h3 class="mb-0 fw-bold"><%= stats.total %></h3></div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;"><i class="fas fa-check-circle"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Active</p><h3 class="mb-0 fw-bold text-success"><%= stats.active %></h3></div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;"><i class="fas fa-clock"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Awaiting Approval</p><h3 class="mb-0 fw-bold text-warning"><%= stats.locked %></h3></div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#3b82f6,#2563eb);color:white;"><i class="fas fa-hourglass-half"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Unpaid Registration</p><h3 class="mb-0 fw-bold text-primary"><%= stats.pending %></h3></div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#ec4899,#db2777);color:white;"><i class="fas fa-piggy-bank"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Total Savings</p><h4 class="mb-0 fw-bold" style="color:var(--kiddies);">₦<%= stats.totalBalance.toLocaleString() %></h4></div>
