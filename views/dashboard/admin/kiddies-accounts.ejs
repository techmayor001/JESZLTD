<div id="sidebarOverlay" class="sidebar-overlay" onclick="closeSidebar()"></div>

<!-- MAIN CONTENT -->
<div class="main-content">

    <!-- Page Header -->
    <div class="page-header animate-in">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3" style="position:relative;z-index:1;">
            <div>
                <h3 class="mb-1 fw-bold text-white"><i class="fas fa-baby me-2"></i>Kiddies Accounts</h3>
                <p class="mb-0" style="opacity:.85;">Manage children's savings accounts — approvals, transactions, beneficiaries</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-light btn-sm fw-semibold" onclick="exportData()">
                    <i class="fas fa-download me-1"></i>Export CSV
                </button>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4 stats-row">
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;"><i class="fas fa-baby"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Total Accounts</p><h3 class="mb-0 fw-bold"><%= stats.total %></h3></div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;"><i class="fas fa-check-circle"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Active</p><h3 class="mb-0 fw-bold text-success"><%= stats.active %></h3></div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;"><i class="fas fa-clock"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Awaiting Approval</p><h3 class="mb-0 fw-bold text-warning"><%= stats.locked %></h3></div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#3b82f6,#2563eb);color:white;"><i class="fas fa-hourglass-half"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Unpaid Registration</p><h3 class="mb-0 fw-bold text-primary"><%= stats.pending %></h3></div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;"><i class="fas fa-piggy-bank"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Total Savings</p><h4 class="mb-0 fw-bold" style="color:var(--primary);">₦<%= stats.totalBalance.toLocaleString() %></h4></div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="stat-card animate-in">
                <div class="stat-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:white;"><i class="fas fa-chart-line"></i></div>
                <div><p class="text-muted mb-1 fw-semibold small">Total Interest</p><h4 class="mb-0 fw-bold" style="color:#7c3aed;">₦<%= stats.totalInterest.toLocaleString() %></h4></div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-section animate-in">
        <div class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Search</label>
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" id="searchInput" placeholder="Search by child name, account ID, parent...">
                </div>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">Account Status</label>
                <select class="form-select" id="statusFilter">
                    <option value="">All Statuses</option>
                    <option value="active">Active</option>
                    <option value="locked">Locked (Awaiting)</option>
                    <option value="closed">Closed</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">Payment Status</label>
                <select class="form-select" id="paymentFilter">
                    <option value="">All</option>
                    <option value="paid">Paid</option>
                    <option value="pending">Unpaid</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">Sort By</label>
                <select class="form-select" id="sortFilter">
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                    <option value="name">Child Name (A-Z)</option>
                    <option value="balance">Balance (High-Low)</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <button class="btn btn-outline-primary w-100" onclick="resetFilters()">
                    <i class="fas fa-redo me-2"></i>Reset
                </button>
            </div>
        </div>
    </div>

    <!-- Accounts Table -->
    <div class="table-card animate-in">
        <div class="scroll-hint"><i class="fas fa-arrows-left-right"></i><span>Swipe to see all columns</span></div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Child</th>
                        <th>Account ID</th>
                        <th>Parent / Guardian</th>
                        <th>Balance</th>
                        <th>Account Status</th>
                        <th>Payment</th>
                        <th>Beneficiary</th>
                        <th>Maturity</th>
                        <th>Pending Tx</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="accountsTableBody"></tbody>
            </table>
        </div>
        <div class="p-3 border-top">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="text-muted small">Showing <strong id="showingCount">0</strong> of <strong id="totalCount">0</strong> accounts</div>
                <nav><ul class="pagination mb-0" id="paginationEl"></ul></nav>
            </div>
        </div>
    </div>

</div><!-- /main-content -->

<div class="powered-by">Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

<!-- NOTIFICATION MODAL -->
<div class="modal fade" id="notifyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content border-0" style="border-radius:20px;overflow:hidden;">
            <div class="modal-header" style="display:none;"></div>
            <div class="modal-body p-4 text-center">
                <div class="notify-icon-wrap" id="notifyIcon"><i id="notifyIconClass" class="fas fa-check-circle"></i></div>
                <div class="notify-title" id="notifyTitle">Success</div>
                <div class="notify-message" id="notifyMessage"></div>
                <div class="notify-footer" id="notifyFooter">
                    <button class="notify-btn-ok info" id="notifyOkBtn" onclick="notifyClose()">OK</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ACCOUNT DETAIL MODAL -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-baby me-2"></i>Kiddies Account Detail</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailModalBody">
                <div class="text-center py-5"><div class="spinner-border" style="color:var(--primary);" role="status"></div><p class="mt-3 text-muted">Loading account details...</p></div>
            </div>
            <div class="modal-footer" id="detailModalFooter"></div>
        </div>
    </div>
</div>

<!-- APPROVE MODAL -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header success-header">
                <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>Approve Kiddies Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="detail-section mb-3">
                    <div class="row g-2 small">
                        <div class="col-6 text-muted">Child's Name:</div><div class="col-6 fw-bold text-end" id="approve_childName">—</div>
                        <div class="col-6 text-muted">Account ID:</div><div class="col-6 fw-bold text-end" id="approve_accountID">—</div>
                        <div class="col-6 text-muted">Parent:</div><div class="col-6 fw-bold text-end" id="approve_parentName">—</div>
                        <div class="col-6 text-muted">Balance:</div><div class="col-6 fw-bold text-end" id="approve_balance">—</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Admin Note <small class="text-muted fw-normal">(optional)</small></label>
                    <textarea class="form-control" id="approve_note" rows="2" placeholder="Add a note for this approval..."></textarea>
                </div>
                <div class="alert alert-success py-2 small"><i class="fas fa-info-circle me-2"></i>Approving will set this account to <strong>Active</strong> and notify the parent.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success px-4" onclick="confirmApprove()"><i class="fas fa-check me-2"></i>Approve Account</button>
            </div>
        </div>
    </div>
</div>

<!-- DECLINE MODAL -->
<div class="modal fade" id="declineModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header danger-header">
                <h5 class="modal-title"><i class="fas fa-times-circle me-2"></i>Decline Kiddies Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="detail-section mb-3">
                    <div class="row g-2 small">
                        <div class="col-6 text-muted">Child's Name:</div><div class="col-6 fw-bold text-end" id="decline_childName">—</div>
                        <div class="col-6 text-muted">Account ID:</div><div class="col-6 fw-bold text-end" id="decline_accountID">—</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Reason for Decline <span class="text-danger">*</span></label>
                    <select class="form-select mb-2" id="decline_reason_select" onchange="handleDeclineReasonChange()">
                        <option value="">Select a reason...</option>
                        <option value="Incomplete documentation">Incomplete documentation</option>
                        <option value="Invalid next of kin details">Invalid next of kin details</option>
                        <option value="Suspicious account activity">Suspicious account activity</option>
                        <option value="Policy violation">Policy violation</option>
                        <option value="Parent account not in good standing">Parent account not in good standing</option>
                        <option value="other">Other (specify below)</option>
                    </select>
                    <textarea class="form-control" id="decline_reason" rows="2" placeholder="Additional details..."></textarea>
                </div>
                <div class="alert alert-warning py-2 small"><i class="fas fa-exclamation-triangle me-2"></i>Declining will keep the account <strong>Locked</strong> and the parent will be notified.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" onclick="confirmDecline()"><i class="fas fa-times me-2"></i>Decline Account</button>
            </div>
        </div>
    </div>
</div>

<!-- TRANSACTION APPROVE/DECLINE MODAL -->
<div class="modal fade" id="txActionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header warning-header" id="txActionHeader">
                <h5 class="modal-title" id="txActionTitle"><i class="fas fa-tasks me-2"></i>Transaction Action</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="detail-section mb-3">
                    <div class="row g-2 small">
                        <div class="col-6 text-muted">Amount:</div><div class="col-6 fw-bold text-end" id="tx_amount">—</div>
                        <div class="col-6 text-muted">Child's Account:</div><div class="col-6 fw-bold text-end" id="tx_account">—</div>
                        <div class="col-6 text-muted">Payment Method:</div><div class="col-6 fw-bold text-end" id="tx_method">—</div>
                        <div class="col-6 text-muted">Date:</div><div class="col-6 fw-bold text-end" id="tx_date">—</div>
                    </div>
                </div>
                <div class="mb-3" id="txReasonField" style="display:none;">
                    <label class="form-label">Reason for Decline <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="tx_reason" rows="2" placeholder="Provide reason for declining this transaction..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="txApproveBtn" onclick="submitTxApprove()"><i class="fas fa-check me-2"></i>Approve Deposit</button>
                <button type="button" class="btn btn-danger" id="txDeclineBtn" onclick="submitTxDecline()" style="display:none;"><i class="fas fa-times me-2"></i>Decline</button>
            </div>
        </div>
    </div>
</div>

<!-- CLOSE ACCOUNT MODAL -->
<div class="modal fade" id="closeAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header danger-header">
                <h5 class="modal-title"><i class="fas fa-lock me-2"></i>Close Kiddies Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger py-2 mb-3 small"><i class="fas fa-exclamation-triangle me-2"></i><strong>Warning:</strong> Closing this account is permanent. Ensure the parent has been notified and any balance has been handled.</div>
                <div class="detail-section mb-3">
                    <div class="row g-2 small">
                        <div class="col-6 text-muted">Child's Name:</div><div class="col-6 fw-bold text-end" id="close_childName">—</div>
                        <div class="col-6 text-muted">Balance:</div><div class="col-6 fw-bold text-end text-danger" id="close_balance">—</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Reason for Closing <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="close_reason" rows="3" placeholder="Provide detailed reason for closing this account..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Type <code>CLOSE</code> to confirm</label>
                    <input type="text" class="form-control" id="close_confirm_text" placeholder="Type CLOSE here">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" onclick="confirmCloseAccount()"><i class="fas fa-lock me-2"></i>Close Account</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>

let allAccounts = <%- JSON.stringify(kiddiesAccounts.map(k => ({
    id: String(k._id),
    accountID: k.accountID || 'N/A',
    childFirstName: k.childFirstName || '',
    childLastName: k.childLastName || '',
    childDOB: k.childDOB || null,
    childGender: k.childGender || '',
    status: k.status || 'locked',
    registrationStatus: k.registrationStatus || 'pending',
    initialDeposit: k.initialDeposit || 0,
    lockPeriodYears: k.lockPeriodYears || 5,
    unlockDate: k.unlockDate || null,
    createdAt: k.createdAt || new Date(),
    approvedAt: k.approvedAt || null,
    declineReason: k.declineReason || '',
    adminNote: k.adminNote || '',
    beneficiaryType: k.beneficiaryType || 'family',
    nextOfKin: k.nextOfKin || {},
    transactionCount: k.transactionCount || 0,
    pendingTransactionCount: k.pendingTransactionCount || 0,
    balance: k.account ? (k.account.balance || 0) : 0,
    interest: k.account ? (k.account.accumulativeROI || 0) : 0,
    parent: k.parent ? {
        id: String(k.parent._id),
        firstName: k.parent.firstName || '',
        lastName: k.parent.lastName || '',
        email: k.parent.email || '',
        phone: k.parent.phone || '',
        membershipID: k.parent.membershipID || 'N/A',
        displayPicture: k.parent.displayPicture || null
    } : null
}))) %>;

let filteredAccounts = [...allAccounts];
let currentAccountId = null;
let currentTxId = null;
let currentTxAction = null;
let currentPage = 1;
const PER_PAGE = 12;

document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('totalCountBadge').textContent = allAccounts.length;
    renderTable();
    attachFilters();
});

function renderTable() {
    const start = (currentPage - 1) * PER_PAGE;
    const pageData = filteredAccounts.slice(start, start + PER_PAGE);
    const tbody = document.getElementById('accountsTableBody');
    document.getElementById('showingCount').textContent = pageData.length;
    document.getElementById('totalCount').textContent = filteredAccounts.length;

    if (!filteredAccounts.length) {
        tbody.innerHTML = `<tr><td colspan="10"><div class="empty-state">
            <div class="empty-icon"><i class="fas fa-baby"></i></div>
            <p class="text-muted mb-0">No kiddies accounts found</p>
        </div></td></tr>`;
        renderPagination(); return;
    }

    tbody.innerHTML = pageData.map(a => {
        const childName = `${a.childFirstName} ${a.childLastName}`.trim() || 'Unknown';
        const initials = (a.childFirstName[0] || '?') + (a.childLastName[0] || '?');
        const parentName = a.parent ? `${a.parent.firstName} ${a.parent.lastName}` : 'N/A';
        const parentAvatar = a.parent?.displayPicture
            ? `<img src="${a.parent.displayPicture}" class="parent-avatar me-2" alt="">`
            : `<div class="parent-avatar me-2 d-flex align-items-center justify-content-center fw-bold" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;font-size:.7rem;">${parentName.split(' ').map(n=>n[0]).join('').slice(0,2)}</div>`;

        const statusBadge = {
            active: '<span class="badge badge-active"><i class="fas fa-check-circle me-1"></i>Active</span>',
            locked: '<span class="badge badge-locked"><i class="fas fa-lock me-1"></i>Awaiting Approval</span>',
            closed: '<span class="badge badge-closed"><i class="fas fa-ban me-1"></i>Closed</span>',
        }[a.status] || `<span class="badge badge-pending">${a.status}</span>`;

        const payBadge = a.registrationStatus === 'paid'
            ? '<span class="badge badge-paid"><i class="fas fa-check me-1"></i>Paid</span>'
            : '<span class="badge badge-unpaid"><i class="fas fa-times me-1"></i>Unpaid</span>';

        const benBadge = a.beneficiaryType === 'lawyer'
            ? '<span class="badge badge-lawyer"><i class="fas fa-gavel me-1"></i>Lawyer</span>'
            : '<span class="badge badge-family"><i class="fas fa-heart me-1"></i>Family</span>';

        const maturity = a.unlockDate ? new Date(a.unlockDate).getFullYear() : '—';
        const pendingBadge = a.pendingTransactionCount > 0
            ? `<span class="badge bg-warning text-dark">${a.pendingTransactionCount} pending</span>`
            : `<span class="text-muted small">—</span>`;

        let actions = `<button class="action-btn btn btn-sm btn-primary" onclick="viewDetail('${a.id}')" title="View Detail"><i class="fas fa-eye"></i></button>`;
        if (a.status === 'locked' && a.registrationStatus === 'paid') {
            actions += `<button class="action-btn btn btn-sm btn-success" onclick="openApprove('${a.id}')" title="Approve"><i class="fas fa-check"></i></button>`;
            actions += `<button class="action-btn btn btn-sm btn-danger" onclick="openDecline('${a.id}')" title="Decline"><i class="fas fa-times"></i></button>`;
        } else if (a.status === 'active') {
            actions += `<button class="action-btn btn btn-sm btn-danger" onclick="openCloseAccount('${a.id}')" title="Close Account"><i class="fas fa-lock"></i></button>`;
        }

        return `<tr>
            <td><div class="d-flex align-items-center gap-2"><div class="child-avatar">${initials}</div><div><div class="fw-semibold">${childName}</div><small class="text-muted">${a.childGender||'—'} · DOB: ${a.childDOB?new Date(a.childDOB).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}):'—'}</small></div></div></td>
            <td><span class="badge" style="background:rgba(30,58,138,.1);color:var(--primary);font-size:.78rem;">${a.accountID}</span></td>
            <td><div class="d-flex align-items-center">${parentAvatar}<div><div class="fw-semibold small">${parentName}</div><small class="text-muted">${a.parent?.membershipID||'—'}</small></div></div></td>
            <td><strong style="color:var(--primary);">₦${a.balance.toLocaleString()}</strong><br><small class="text-muted">+₦${a.interest.toLocaleString()} interest</small></td>
            <td>${statusBadge}</td>
            <td>${payBadge}</td>
            <td>${benBadge}</td>
            <td><small class="text-muted">${maturity}</small></td>
            <td>${pendingBadge}</td>
            <td><div class="btn-group-tight">${actions}</div></td>
        </tr>`;
    }).join('');

    renderPagination();
}

function renderPagination() {
    const totalPages = Math.ceil(filteredAccounts.length / PER_PAGE);
    const el = document.getElementById('paginationEl');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    let html = `<li class="page-item ${currentPage===1?'disabled':''}"><a class="page-link" href="#" onclick="goPage(${currentPage-1});return false;"><i class="fas fa-chevron-left"></i></a></li>`;
    for (let i = 1; i <= totalPages; i++) html += `<li class="page-item ${i===currentPage?'active':''}"><a class="page-link" href="#" onclick="goPage(${i});return false;">${i}</a></li>`;
    html += `<li class="page-item ${currentPage===totalPages?'disabled':''}"><a class="page-link" href="#" onclick="goPage(${currentPage+1});return false;"><i class="fas fa-chevron-right"></i></a></li>`;
    el.innerHTML = html;
}

function goPage(p) {
    const totalPages = Math.ceil(filteredAccounts.length / PER_PAGE);
    if (p < 1 || p > totalPages) return;
    currentPage = p; renderTable(); window.scrollTo({top:0,behavior:'smooth'});
}

function attachFilters() {
    ['searchInput','statusFilter','paymentFilter','sortFilter'].forEach(id => {
        const el = document.getElementById(id);
        el.addEventListener('change', applyFilters);
        if (id==='searchInput') el.addEventListener('keyup', applyFilters);
    });
}

function applyFilters() {
    let f = [...allAccounts];
    const s = document.getElementById('searchInput').value.toLowerCase();
    if (s) f = f.filter(a=>(a.childFirstName+a.childLastName+a.accountID+(a.parent?.firstName||'')+(a.parent?.lastName||'')).toLowerCase().includes(s));
    const st = document.getElementById('statusFilter').value;
    if (st) f = f.filter(a=>a.status===st);
    const pf = document.getElementById('paymentFilter').value;
    if (pf) f = f.filter(a=>a.registrationStatus===pf);
    const so = document.getElementById('sortFilter').value;
    if (so==='newest') f.sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));
    else if (so==='oldest') f.sort((a,b)=>new Date(a.createdAt)-new Date(b.createdAt));
    else if (so==='name') f.sort((a,b)=>a.childFirstName.localeCompare(b.childFirstName));
    else if (so==='balance') f.sort((a,b)=>b.balance-a.balance);
    filteredAccounts = f; currentPage = 1; renderTable();
}

function resetFilters() {
    ['searchInput','statusFilter','paymentFilter'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('sortFilter').value='newest';
    filteredAccounts=[...allAccounts]; currentPage=1; renderTable();
}

async function viewDetail(id) {
    currentAccountId = id;
    const modalEl = document.getElementById('detailModal');
    const body = document.getElementById('detailModalBody');
    const footer = document.getElementById('detailModalFooter');
    body.innerHTML = `<div class="text-center py-5"><div class="spinner-border" style="color:var(--primary);" role="status"></div><p class="mt-3 text-muted">Loading...</p></div>`;
    footer.innerHTML = '';
    new bootstrap.Modal(modalEl).show();

    try {
        const res = await fetch(`/api/admin/kiddies/${id}`);
        const { account: a, transactions } = await res.json();

        const childName = `${a.childFirstName} ${a.childLastName}`;
        const parentName = a.parent ? `${a.parent.firstName} ${a.parent.lastName}` : 'N/A';

        const created = new Date(a.createdAt);
        const unlock = a.unlockDate ? new Date(a.unlockDate) : null;
        let progress = 0;
        if (unlock) { const totalMs = unlock - created; const elapsedMs = Date.now() - created; progress = Math.min(100, Math.max(0, Math.round((elapsedMs / totalMs) * 100))); }

        const txHtml = transactions.length ? transactions.slice(0,8).map(tx => {
            const typeColors = { deposit:'#10b981', interest:'#8b5cf6', fee:'#ef4444', withdrawal:'#f59e0b' };
            const typeIcons  = { deposit:'fa-arrow-down', interest:'fa-chart-line', fee:'fa-minus', withdrawal:'fa-arrow-up' };
            const color = typeColors[tx.type]||'#6b7280';
            const icon  = typeIcons[tx.type]||'fa-circle';
            const statusBadge = tx.status==='pending'?`<span class="badge badge-locked ms-2" style="font-size:.68rem;">Pending</span>`:tx.status==='failed'?`<span class="badge badge-unpaid ms-2" style="font-size:.68rem;">Failed</span>`:'';
            const txActions = tx.status==='pending' ? `<div class="ms-auto d-flex gap-1"><button class="btn btn-sm btn-success py-1 px-2" onclick="openTxAction('${a._id}','${tx._id}','approve')"><i class="fas fa-check"></i></button><button class="btn btn-sm btn-danger py-1 px-2" onclick="openTxAction('${a._id}','${tx._id}','decline')"><i class="fas fa-times"></i></button></div>` : '';
            return `<div class="tx-row"><div class="tx-icon" style="background:${color}22;color:${color};"><i class="fas ${icon}"></i></div><div class="flex-grow-1"><div class="fw-semibold small">${tx.description||tx.type} ${statusBadge}</div><div class="text-muted" style="font-size:.78rem;">${new Date(tx.createdAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})} · Bal after: ₦${(tx.balanceAfter||0).toLocaleString()}</div></div><div class="fw-bold" style="color:${color};white-space:nowrap;">₦${tx.amount.toLocaleString()}</div>${txActions}</div>`;
        }).join('') : `<div class="text-center py-3 text-muted small"><i class="fas fa-inbox d-block mb-2 fa-2x"></i>No transactions yet</div>`;

        const statusBadgeHtml = {
            active: '<span class="badge badge-active fs-6"><i class="fas fa-check-circle me-1"></i>Active</span>',
            locked: '<span class="badge badge-locked fs-6"><i class="fas fa-lock me-1"></i>Awaiting Approval</span>',
            closed: '<span class="badge badge-closed fs-6"><i class="fas fa-ban me-1"></i>Closed</span>',
        }[a.status] || `<span class="badge badge-pending">${a.status}</span>`;

        body.innerHTML = `
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="text-center mb-4">
                    <div class="child-avatar mx-auto mb-3" style="width:70px;height:70px;font-size:1.6rem;">${(a.childFirstName[0]||'?')+(a.childLastName[0]||'?')}</div>
                    <h5 class="fw-bold mb-1">${childName}</h5>
                    <p class="text-muted mb-2">${a.accountID}</p>${statusBadgeHtml}
                </div>
                <div class="detail-section mb-3">
                    <h6 class="fw-bold mb-3" style="color:var(--primary);">Child Information</h6>
                    <div class="row g-2 small">
                        <div class="col-6"><div class="detail-label">Date of Birth</div><div class="detail-value">${a.childDOB?new Date(a.childDOB).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}):'—'}</div></div>
                        <div class="col-6"><div class="detail-label">Gender</div><div class="detail-value">${a.childGender||'—'}</div></div>
                        <div class="col-6"><div class="detail-label">Lock Period</div><div class="detail-value">${a.lockPeriodYears} Years</div></div>
                        <div class="col-6"><div class="detail-label">Maturity Date</div><div class="detail-value">${a.unlockDate?new Date(a.unlockDate).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}):'—'}</div></div>
