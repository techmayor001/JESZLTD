function openApprove(id) {
    currentAccountId = id;
    const a = allAccounts.find(a=>a.id===id); if(!a) return;
    document.getElementById('approve_childName').textContent = `${a.childFirstName} ${a.childLastName}`;
    document.getElementById('approve_accountID').textContent = a.accountID;
    document.getElementById('approve_parentName').textContent = a.parent?`${a.parent.firstName} ${a.parent.lastName}`:'—';
    document.getElementById('approve_balance').textContent = `₦${a.balance.toLocaleString()}`;
    document.getElementById('approve_note').value = '';
    const dm = bootstrap.Modal.getInstance(document.getElementById('detailModal'));
    if (dm) dm.hide();
    setTimeout(() => new bootstrap.Modal(document.getElementById('approveModal')).show(), dm?400:0);
}

async function confirmApprove() {
    const note = document.getElementById('approve_note').value;
    const modalEl = document.getElementById('approveModal');
    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/approve`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({note}) });
    const data = await res.json();
    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        const a = allAccounts.find(a=>a.id===currentAccountId);
        if (a) { a.status='active'; a.approvedAt=new Date(); }
        filteredAccounts=[...allAccounts]; applyFilters();
        await showNotify({type:'success',title:'Account Approved!',message:`${data.childName}'s account (${data.accountID}) has been approved and set to Active.`});
    } else { await showNotify({type:'error',title:'Approval Failed',message:data.message||'An error occurred.'}); }
}

function openDecline(id) {
    currentAccountId = id;
    const a = allAccounts.find(a=>a.id===id); if(!a) return;
    document.getElementById('decline_childName').textContent = `${a.childFirstName} ${a.childLastName}`;
    document.getElementById('decline_accountID').textContent = a.accountID;
    document.getElementById('decline_reason_select').value = '';
    document.getElementById('decline_reason').value = '';
    const dm = bootstrap.Modal.getInstance(document.getElementById('detailModal'));
    if (dm) dm.hide();
    setTimeout(() => new bootstrap.Modal(document.getElementById('declineModal')).show(), dm?400:0);
}

function handleDeclineReasonChange() {
    const val = document.getElementById('decline_reason_select').value;
    if (val && val!=='other') document.getElementById('decline_reason').value=val;
    if (val==='other') document.getElementById('decline_reason').value='';
}

async function confirmDecline() {
    const reason = document.getElementById('decline_reason_select').value==='other'
        ? document.getElementById('decline_reason').value
        : (document.getElementById('decline_reason_select').value || document.getElementById('decline_reason').value);
    if (!reason) { await showNotify({type:'warning',title:'Required',message:'Please provide a reason for declining this account.'}); return; }
    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/decline`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({reason}) });
    const data = await res.json();
    const modalEl = document.getElementById('declineModal');
    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        const a = allAccounts.find(a=>a.id===currentAccountId);
        if (a) { a.status='locked'; a.declineReason=reason; }
        applyFilters();
        await showNotify({type:'info',title:'Account Declined',message:`Account ${data.accountID} has been declined and remains locked.`});
    } else { await showNotify({type:'error',title:'Failed',message:data.message||'An error occurred.'}); }
}

function openTxAction(accountId, txId, action) {
    currentAccountId=accountId; currentTxId=txId; currentTxAction=action;
    document.getElementById('tx_amount').textContent='—';
    document.getElementById('tx_account').textContent='—';
    document.getElementById('tx_method').textContent='Manual Transfer';
    document.getElementById('tx_date').textContent='—';
    document.getElementById('tx_reason').value='';
    if (action==='approve') {
        document.getElementById('txActionTitle').innerHTML='<i class="fas fa-check-circle me-2"></i>Approve Deposit';
        document.getElementById('txActionHeader').className='modal-header success-header';
        document.getElementById('txApproveBtn').style.display='';
        document.getElementById('txDeclineBtn').style.display='none';
        document.getElementById('txReasonField').style.display='none';
    } else {
        document.getElementById('txActionTitle').innerHTML='<i class="fas fa-times-circle me-2"></i>Decline Deposit';
        document.getElementById('txActionHeader').className='modal-header danger-header';
        document.getElementById('txApproveBtn').style.display='none';
        document.getElementById('txDeclineBtn').style.display='';
        document.getElementById('txReasonField').style.display='';
    }
    const dm = bootstrap.Modal.getInstance(document.getElementById('detailModal'));
    if (dm) dm.hide();
    setTimeout(() => new bootstrap.Modal(document.getElementById('txActionModal')).show(), dm?400:0);
}

async function submitTxApprove() {
    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/approve-transaction`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({transactionId:currentTxId}) });
    const data = await res.json();
    const modalEl = document.getElementById('txActionModal');
    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        const a = allAccounts.find(a=>a.id===currentAccountId);
        if (a && data.amount) { a.balance+=data.amount; a.pendingTransactionCount=Math.max(0,a.pendingTransactionCount-1); }
        renderTable();
        await showNotify({type:'success',title:'Deposit Approved',message:`₦${data.amount?.toLocaleString()||''} has been credited to the kiddies account.`});
    } else { await showNotify({type:'error',title:'Failed',message:data.message||'An error occurred.'}); }
}

async function submitTxDecline() {
    const reason = document.getElementById('tx_reason').value;
    if (!reason) { await showNotify({type:'warning',title:'Required',message:'Please provide a reason for declining this transaction.'}); return; }
    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/decline-transaction`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({transactionId:currentTxId,reason}) });
    const data = await res.json();
    const modalEl = document.getElementById('txActionModal');
    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        const a = allAccounts.find(a=>a.id===currentAccountId);
        if (a) a.pendingTransactionCount=Math.max(0,a.pendingTransactionCount-1);
        renderTable();
        await showNotify({type:'info',title:'Transaction Declined',message:'The transaction has been declined.'});
    } else { await showNotify({type:'error',title:'Failed',message:data.message||'An error occurred.'}); }
}

function openCloseAccount(id) {
    currentAccountId=id;
    const a = allAccounts.find(a=>a.id===id); if(!a) return;
    document.getElementById('close_childName').textContent=`${a.childFirstName} ${a.childLastName}`;
    document.getElementById('close_balance').textContent=`₦${a.balance.toLocaleString()}`;
    document.getElementById('close_reason').value='';
    document.getElementById('close_confirm_text').value='';
    const dm = bootstrap.Modal.getInstance(document.getElementById('detailModal'));
    if (dm) dm.hide();
    setTimeout(() => new bootstrap.Modal(document.getElementById('closeAccountModal')).show(), dm?400:0);
}

async function confirmCloseAccount() {
    const confirm = document.getElementById('close_confirm_text').value.trim();
    const reason  = document.getElementById('close_reason').value.trim();
    if (confirm!=='CLOSE') { await showNotify({type:'warning',title:'Confirmation Required',message:'Please type CLOSE in the confirmation field to proceed.'}); return; }
    if (!reason) { await showNotify({type:'warning',title:'Required',message:'Please provide a reason for closing this account.'}); return; }
    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/close`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({reason}) });
    const data = await res.json();
    const modalEl = document.getElementById('closeAccountModal');
    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        const a = allAccounts.find(a=>a.id===currentAccountId);
        if (a) a.status='closed';
        applyFilters();
        await showNotify({type:'info',title:'Account Closed',message:'The kiddies account has been permanently closed.'});
    } else { await showNotify({type:'error',title:'Failed',message:data.message||'An error occurred.'}); }
}

function exportData() {
    const fmt = d => d ? new Date(d).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) : '';
    const cap = s => s ? s.charAt(0).toUpperCase() + s.slice(1) : '';
 
    const headers = [
        // ── Account identifiers ──
        'Account ID', 'Account Status', 'Registration Payment',
        // ── Child personal details ──
        'Child First Name', 'Child Last Name', 'Child Gender', 'Child Date of Birth',
        // ── Parent / guardian ──
        'Parent Full Name', 'Parent Email', 'Parent Phone', 'Parent Membership ID',
        // ── Financial (from Account schema) ──
        'Current Balance (₦)', 'Accumulated Interest / ROI (₦)', 'Initial Deposit (₦)',
        // ── Lock & maturity ──
        'Lock Period (Years)', 'Unlock / Maturity Date',
        // ── Next of Kin / Beneficiary ──
        'Beneficiary Type',
        'NOK Full Name', 'NOK Phone', 'NOK Email',
        'NOK Relationship', 'NOK Address',
        'NOK Bar Number (Lawyer only)', 'NOK Law Firm (Lawyer only)',
        // ── Transaction counts ──
        'Total Transactions', 'Pending Transactions',
        // ── Admin metadata ──
        'Admin Note', 'Decline Reason',
        // ── Timestamps ──
        'Date Registered', 'Date Approved'
    ];
 
    const rows = [headers];
 
    filteredAccounts.forEach(a => {
        rows.push([
            // Account identifiers
            a.accountID || '',
            cap(a.status),
            a.registrationStatus === 'paid'
                ? 'Paid'
                : a.registrationStatus === 'failed'
                ? 'Failed'
                : 'Unpaid',
            // Child
            a.childFirstName || '',
            a.childLastName  || '',
            a.childGender    || '',
            fmt(a.childDOB),
            // Parent
            a.parent ? `${a.parent.firstName} ${a.parent.lastName}`.trim() : '',
            a.parent?.email        || '',
            a.parent?.phone        || '',
            a.parent?.membershipID || '',
            // Financial
            a.balance        ?? 0,
            a.interest       ?? 0,   // accumulativeROI from Account schema
            a.initialDeposit ?? 0,
            // Lock / Maturity
            a.lockPeriodYears ?? 5,
            fmt(a.unlockDate),
            // Next of Kin / Beneficiary
            cap(a.beneficiaryType) || 'Family',
            a.nextOfKin?.fullName     || '',
            a.nextOfKin?.phone        || '',
            a.nextOfKin?.email        || '',
            a.nextOfKin?.relationship || '',
            a.nextOfKin?.address      || '',
            a.nextOfKin?.barNumber    || '',   // lawyer only
            a.nextOfKin?.lawFirm      || '',   // lawyer only
            // Transaction counts
            a.transactionCount        ?? 0,
            a.pendingTransactionCount ?? 0,
            // Admin metadata
            a.adminNote     || '',
            a.declineReason || '',
            // Timestamps
            fmt(a.createdAt),
            fmt(a.approvedAt)
        ]);
    });
 
    const csv = rows
        .map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(','))
        .join('\n');
 
    // BOM (\uFEFF) ensures Excel opens ₦ and special characters correctly
    const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href     = url;
    link.download = `kiddies-accounts-${new Date().toISOString().split('T')[0]}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
}

let _notifyResolve = null;
function showNotify({ type='info', title='', message='', confirmLabel='OK', cancelLabel=null } = {}) {
    return new Promise(resolve => {
        _notifyResolve = resolve;
        const iconMap = { success:{icon:'fa-check-circle',label:title||'Success'}, error:{icon:'fa-times-circle',label:title||'Error'}, warning:{icon:'fa-exclamation-triangle',label:title||'Warning'}, info:{icon:'fa-info-circle',label:title||'Info'} };
        const cfg = iconMap[type]||iconMap.info;
        document.getElementById('notifyIcon').className    = `notify-icon-wrap ${type}`;
        document.getElementById('notifyIconClass').className = `fas ${cfg.icon}`;
        const titleEl = document.getElementById('notifyTitle');
        titleEl.className=`notify-title ${type}`; titleEl.textContent=cfg.label;
        document.getElementById('notifyMessage').textContent=message;
        const okBtn=document.getElementById('notifyOkBtn');
        okBtn.className=`notify-btn-ok ${type}`; okBtn.textContent=confirmLabel;
        const existing=document.getElementById('notifyCancelBtn'); if(existing) existing.remove();
        if (cancelLabel) {
            const cb=document.createElement('button'); cb.className='notify-btn-cancel'; cb.id='notifyCancelBtn';
            cb.textContent=cancelLabel; cb.onclick=notifyCancel;
            document.getElementById('notifyFooter').insertBefore(cb, okBtn);
        }
        new bootstrap.Modal(document.getElementById('notifyModal'),{backdrop:'static',keyboard:false}).show();
    });
}
function notifyClose() { bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide(); if(_notifyResolve){_notifyResolve(true);_notifyResolve=null;} }
function notifyCancel() { bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide(); if(_notifyResolve){_notifyResolve(false);_notifyResolve=null;} }

function toggleSidebar() { if(window.innerWidth<=992){document.getElementById('sidebar').classList.toggle('active');document.getElementById('sidebarOverlay').classList.toggle('active');} }
function closeSidebar() { document.getElementById('sidebar').classList.remove('active'); document.getElementById('sidebarOverlay').classList.remove('active'); }

async function loadSidebarPendingCount() {
    try {
        const res=await fetch('/admin/pending-approvals-count'); const data=await res.json();
        const badge=document.getElementById('sidebarBadge'); if(!badge) return;
        badge.style.display=data.count>0?'inline-block':'none'; if(data.count>0) badge.textContent=data.count;
    } catch(e){}
}
document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
</script>
</body>
</html>