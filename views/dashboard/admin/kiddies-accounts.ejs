<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>

/* ═══════════════════════════════════════════════════════════
   PAGE DATA  (EJS-injected)
═══════════════════════════════════════════════════════════ */
let allAccounts = <%- JSON.stringify(kiddiesAccounts.map(k => ({
    id: String(k._id),
    accountID: k.accountID || 'N/A',
    childFirstName: k.childFirstName || '',
    childLastName: k.childLastName || '',
    childDOB: k.childDOB || null,
    childGender: k.childGender || '',
    status: k.status || 'locked',
    registrationStatus: k.registrationStatus || 'pending',
    initialDeposit: k.initialDeposit || 0,
    lockPeriodYears: k.lockPeriodYears || 5,
    unlockDate: k.unlockDate || null,
    createdAt: k.createdAt || new Date(),
    approvedAt: k.approvedAt || null,
    declineReason: k.declineReason || '',
    adminNote: k.adminNote || '',
    beneficiaryType: k.beneficiaryType || 'family',
    nextOfKin: k.nextOfKin || {},
    transactionCount: k.transactionCount || 0,
    pendingTransactionCount: k.pendingTransactionCount || 0,
    balance: k.account ? (k.account.balance || 0) : 0,
    interest: k.account ? (k.account.accumulativeROI || 0) : 0,
    parent: k.parent ? {
        id: String(k.parent._id),
        firstName: k.parent.firstName || '',
        lastName: k.parent.lastName || '',
        email: k.parent.email || '',
        phone: k.parent.phone || '',
        membershipID: k.parent.membershipID || 'N/A',
        displayPicture: k.parent.displayPicture || null
    } : null
}))) %>;

let filteredAccounts = [...allAccounts];
let currentAccountId = null;
let currentTxId = null;
let currentTxAction = null;
let currentPage = 1;
const PER_PAGE = 12;

/* ═══════════════════════════════════════════════════════════
   INIT
═══════════════════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('totalCountBadge').textContent = allAccounts.length;
    renderTable();
    attachFilters();
});

/* ═══════════════════════════════════════════════════════════
   RENDER TABLE
═══════════════════════════════════════════════════════════ */
function renderTable() {
    const start = (currentPage - 1) * PER_PAGE;
    const pageData = filteredAccounts.slice(start, start + PER_PAGE);
    const tbody = document.getElementById('accountsTableBody');
    document.getElementById('showingCount').textContent = pageData.length;
    document.getElementById('totalCount').textContent = filteredAccounts.length;

    if (!filteredAccounts.length) {
        tbody.innerHTML = `<tr><td colspan="10"><div class="empty-state">
            <div class="empty-icon"><i class="fas fa-baby"></i></div>
            <p class="text-muted mb-0">No kiddies accounts found</p>
        </div></td></tr>`;
        renderPagination();
        return;
    }

    tbody.innerHTML = pageData.map(a => {
        const childName = `${a.childFirstName} ${a.childLastName}`.trim() || 'Unknown';
        const initials = (a.childFirstName[0] || '?') + (a.childLastName[0] || '?');
        const parentName = a.parent ? `${a.parent.firstName} ${a.parent.lastName}` : 'N/A';
        const parentAvatar = a.parent?.displayPicture
            ? `<img src="${a.parent.displayPicture}" class="parent-avatar me-2" alt="">`
            : `<div class="parent-avatar me-2 d-flex align-items-center justify-content-center fw-bold" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;font-size:.7rem;">${parentName.split(' ').map(n=>n[0]).join('').slice(0,2)}</div>`;

        const statusBadge = {
            active: '<span class="badge badge-active"><i class="fas fa-check-circle me-1"></i>Active</span>',
            locked: '<span class="badge badge-locked"><i class="fas fa-lock me-1"></i>Awaiting Approval</span>',
            closed: '<span class="badge badge-closed"><i class="fas fa-ban me-1"></i>Closed</span>',
        }[a.status] || `<span class="badge badge-pending">${a.status}</span>`;

        const payBadge = a.registrationStatus === 'paid'
            ? '<span class="badge badge-paid"><i class="fas fa-check me-1"></i>Paid</span>'
            : '<span class="badge badge-unpaid"><i class="fas fa-times me-1"></i>Unpaid</span>';

        const benBadge = a.beneficiaryType === 'lawyer'
            ? '<span class="badge badge-lawyer"><i class="fas fa-gavel me-1"></i>Lawyer</span>'
            : '<span class="badge badge-family"><i class="fas fa-heart me-1"></i>Family</span>';

        const maturity = a.unlockDate ? new Date(a.unlockDate).getFullYear() : '—';

        const pendingBadge = a.pendingTransactionCount > 0
            ? `<span class="badge bg-warning text-dark">${a.pendingTransactionCount} pending</span>`
            : `<span class="text-muted small">—</span>`;

        // Action buttons based on status
        let actions = `<button class="action-btn btn btn-sm btn-primary" onclick="viewDetail('${a.id}')" title="View Detail"><i class="fas fa-eye"></i></button>`;
        if (a.status === 'locked' && a.registrationStatus === 'paid') {
            actions += `<button class="action-btn btn btn-sm btn-success" onclick="openApprove('${a.id}')" title="Approve"><i class="fas fa-check"></i></button>`;
            actions += `<button class="action-btn btn btn-sm btn-danger" onclick="openDecline('${a.id}')" title="Decline"><i class="fas fa-times"></i></button>`;
        } else if (a.status === 'active') {
            actions += `<button class="action-btn btn btn-sm btn-danger" onclick="openCloseAccount('${a.id}')" title="Close Account"><i class="fas fa-lock"></i></button>`;
        }

        return `<tr>
            <td>
                <div class="d-flex align-items-center gap-2">
                    <div class="child-avatar">${initials}</div>
                    <div>
                        <div class="fw-semibold">${childName}</div>
                        <small class="text-muted">${a.childGender || '—'} · DOB: ${a.childDOB ? new Date(a.childDOB).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : '—'}</small>
                    </div>
                </div>
            </td>
            <td><span class="badge" style="background:rgba(236,72,153,.1);color:var(--kiddies-dark);font-size:.78rem;">${a.accountID}</span></td>
            <td>
                <div class="d-flex align-items-center">
                    ${parentAvatar}
                    <div>
                        <div class="fw-semibold small">${parentName}</div>
                        <small class="text-muted">${a.parent?.membershipID || '—'}</small>
                    </div>
                </div>
            </td>
            <td><strong style="color:var(--kiddies);">₦${a.balance.toLocaleString()}</strong><br><small class="text-muted">+₦${a.interest.toLocaleString()} interest</small></td>
            <td>${statusBadge}</td>
            <td>${payBadge}</td>
            <td>${benBadge}</td>
            <td><small class="text-muted">${maturity}</small></td>
            <td>${pendingBadge}</td>
            <td><div class="btn-group-tight">${actions}</div></td>
        </tr>`;
    }).join('');

    renderPagination();
}

function renderPagination() {
    const totalPages = Math.ceil(filteredAccounts.length / PER_PAGE);
    const el = document.getElementById('paginationEl');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    let html = `<li class="page-item ${currentPage===1?'disabled':''}"><a class="page-link" href="#" onclick="goPage(${currentPage-1});return false;"><i class="fas fa-chevron-left"></i></a></li>`;
    for (let i = 1; i <= totalPages; i++) {
        html += `<li class="page-item ${i===currentPage?'active':''}"><a class="page-link" href="#" onclick="goPage(${i});return false;">${i}</a></li>`;
    }
    html += `<li class="page-item ${currentPage===totalPages?'disabled':''}"><a class="page-link" href="#" onclick="goPage(${currentPage+1});return false;"><i class="fas fa-chevron-right"></i></a></li>`;
    el.innerHTML = html;
}

function goPage(p) {
    const totalPages = Math.ceil(filteredAccounts.length / PER_PAGE);
    if (p < 1 || p > totalPages) return;
    currentPage = p;
    renderTable();
    window.scrollTo({top: 0, behavior: 'smooth'});
}

/* ═══════════════════════════════════════════════════════════
   FILTERS
═══════════════════════════════════════════════════════════ */
function attachFilters() {
    ['searchInput','statusFilter','paymentFilter','sortFilter'].forEach(id => {
        const el = document.getElementById(id);
        el.addEventListener('change', applyFilters);
        if (id === 'searchInput') el.addEventListener('keyup', applyFilters);
    });
}

function applyFilters() {
    let f = [...allAccounts];
    const s = document.getElementById('searchInput').value.toLowerCase();
    if (s) f = f.filter(a =>
        (a.childFirstName + a.childLastName + a.accountID + (a.parent?.firstName||'') + (a.parent?.lastName||'')).toLowerCase().includes(s)
    );
    const st = document.getElementById('statusFilter').value;
    if (st) f = f.filter(a => a.status === st);
    const pf = document.getElementById('paymentFilter').value;
    if (pf) f = f.filter(a => a.registrationStatus === pf);
    const so = document.getElementById('sortFilter').value;
    if      (so === 'newest')  f.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));
    else if (so === 'oldest')  f.sort((a,b) => new Date(a.createdAt) - new Date(b.createdAt));
    else if (so === 'name')    f.sort((a,b) => a.childFirstName.localeCompare(b.childFirstName));
    else if (so === 'balance') f.sort((a,b) => b.balance - a.balance);
    filteredAccounts = f;
    currentPage = 1;
    renderTable();
}

function resetFilters() {
    ['searchInput','statusFilter','paymentFilter'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('sortFilter').value = 'newest';
    filteredAccounts = [...allAccounts];
    currentPage = 1;
    renderTable();
}

/* ═══════════════════════════════════════════════════════════
   VIEW DETAIL MODAL
═══════════════════════════════════════════════════════════ */
async function viewDetail(id) {
    currentAccountId = id;
    const modalEl = document.getElementById('detailModal');
    const body = document.getElementById('detailModalBody');
    const footer = document.getElementById('detailModalFooter');
    body.innerHTML = `<div class="text-center py-5"><div class="spinner-border" style="color:var(--kiddies);" role="status"></div><p class="mt-3 text-muted">Loading...</p></div>`;
    footer.innerHTML = '';
    new bootstrap.Modal(modalEl).show();

    try {
        const res = await fetch(`/api/admin/kiddies/${id}`);
        const { account: a, transactions } = await res.json();

        const childName = `${a.childFirstName} ${a.childLastName}`;
        const parentName = a.parent ? `${a.parent.firstName} ${a.parent.lastName}` : 'N/A';

        // Progress towards maturity
        const created = new Date(a.createdAt);
        const unlock = a.unlockDate ? new Date(a.unlockDate) : null;
        let progress = 0;
        if (unlock) {
            const totalMs = unlock - created;
            const elapsedMs = Date.now() - created;
            progress = Math.min(100, Math.max(0, Math.round((elapsedMs / totalMs) * 100)));
        }

        const txHtml = transactions.length ? transactions.slice(0,8).map(tx => {
            const typeColors = { deposit:'#10b981', interest:'#8b5cf6', fee:'#ef4444', withdrawal:'#f59e0b' };
            const typeIcons  = { deposit:'fa-arrow-down', interest:'fa-chart-line', fee:'fa-minus', withdrawal:'fa-arrow-up' };
            const color = typeColors[tx.type] || '#6b7280';
            const icon  = typeIcons[tx.type]  || 'fa-circle';
            const statusBadge = tx.status === 'pending'
                ? `<span class="badge badge-locked ms-2" style="font-size:.68rem;">Pending</span>`
                : tx.status === 'failed'
                ? `<span class="badge badge-unpaid ms-2" style="font-size:.68rem;">Failed</span>`
                : '';
            const txActions = tx.status === 'pending'
                ? `<div class="ms-auto d-flex gap-1">
                     <button class="btn btn-sm btn-success py-1 px-2" onclick="openTxAction('${a._id}','${tx._id}','approve')"><i class="fas fa-check"></i></button>
                     <button class="btn btn-sm btn-danger py-1 px-2" onclick="openTxAction('${a._id}','${tx._id}','decline')"><i class="fas fa-times"></i></button>
                   </div>` : '';
            return `<div class="tx-row">
                <div class="tx-icon" style="background:${color}22;color:${color};"><i class="fas ${icon}"></i></div>
                <div class="flex-grow-1">
                    <div class="fw-semibold small">${tx.description || tx.type} ${statusBadge}</div>
                    <div class="text-muted" style="font-size:.78rem;">${new Date(tx.createdAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})} · Bal after: ₦${(tx.balanceAfter||0).toLocaleString()}</div>
                </div>
                <div class="fw-bold" style="color:${color};white-space:nowrap;">₦${tx.amount.toLocaleString()}</div>
                ${txActions}
            </div>`;
        }).join('') : `<div class="text-center py-3 text-muted small"><i class="fas fa-inbox d-block mb-2 fa-2x"></i>No transactions yet</div>`;

        const statusBadgeHtml = {
            active: '<span class="badge badge-active fs-6"><i class="fas fa-check-circle me-1"></i>Active</span>',
            locked: '<span class="badge badge-locked fs-6"><i class="fas fa-lock me-1"></i>Awaiting Approval</span>',
            closed: '<span class="badge badge-closed fs-6"><i class="fas fa-ban me-1"></i>Closed</span>',
        }[a.status] || `<span class="badge badge-pending">${a.status}</span>`;

        body.innerHTML = `
        <div class="row g-4">
            <!-- LEFT: Child + Account Info -->
            <div class="col-lg-5">
                <div class="text-center mb-4">
                    <div class="child-avatar mx-auto mb-3" style="width:70px;height:70px;font-size:1.6rem;">
                        ${(a.childFirstName[0]||'?') + (a.childLastName[0]||'?')}
                    </div>
                    <h5 class="fw-bold mb-1">${childName}</h5>
                    <p class="text-muted mb-2">${a.accountID}</p>
                    ${statusBadgeHtml}
                </div>

                <div class="detail-section mb-3">
                    <h6 class="fw-bold mb-3" style="color:var(--kiddies-dark);">Child Information</h6>
                    <div class="row g-2 small">
                        <div class="col-6"><div class="detail-label">Date of Birth</div><div class="detail-value">${a.childDOB ? new Date(a.childDOB).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : '—'}</div></div>
                        <div class="col-6"><div class="detail-label">Gender</div><div class="detail-value">${a.childGender || '—'}</div></div>
                        <div class="col-6"><div class="detail-label">Lock Period</div><div class="detail-value">${a.lockPeriodYears} Years</div></div>
                        <div class="col-6"><div class="detail-label">Maturity Date</div><div class="detail-value">${a.unlockDate ? new Date(a.unlockDate).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : '—'}</div></div>
                        <div class="col-6"><div class="detail-label">Initial Deposit</div><div class="detail-value">₦${(a.initialDeposit||0).toLocaleString()}</div></div>
                        <div class="col-6"><div class="detail-label">Current Balance</div><div class="detail-value" style="color:var(--kiddies);">₦${(a.account?.balance||0).toLocaleString()}</div></div>
                        <div class="col-6"><div class="detail-label">Interest Earned</div><div class="detail-value" style="color:#7c3aed;">₦${(a.account?.accumulativeROI||0).toLocaleString()}</div></div>
                        <div class="col-6"><div class="detail-label">Registration</div><div class="detail-value">${a.registrationStatus === 'paid' ? '✅ Paid' : '❌ Unpaid'}</div></div>
                    </div>
                    <div class="mt-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Lock Progress</span>
                            <span class="fw-semibold">${progress}% complete</span>
                        </div>
                        <div class="maturity-progress"><div class="progress-bar-kiddies" style="height:100%;width:${progress}%;"></div></div>
                    </div>
                </div>

                <div class="detail-section mb-3">
                    <h6 class="fw-bold mb-3" style="color:var(--kiddies-dark);">Parent / Guardian</h6>
                    <div class="row g-2 small">
                        <div class="col-12"><div class="detail-label">Name</div><div class="detail-value">${parentName}</div></div>
                        <div class="col-6"><div class="detail-label">Email</div><div class="detail-value" style="font-size:.78rem;">${a.parent?.email || '—'}</div></div>
                        <div class="col-6"><div class="detail-label">Phone</div><div class="detail-value">${a.parent?.phone || '—'}</div></div>
                        <div class="col-6"><div class="detail-label">Member ID</div><div class="detail-value">${a.parent?.membershipID || '—'}</div></div>
                    </div>
                </div>

                <div class="detail-section">
                    <h6 class="fw-bold mb-3" style="color:var(--kiddies-dark);">Next of Kin / Beneficiary</h6>
                    <div class="mb-2"><span class="badge ${a.beneficiaryType==='lawyer'?'badge-lawyer':'badge-family'}">${a.beneficiaryType === 'lawyer' ? '<i class="fas fa-gavel me-1"></i>Lawyer' : '<i class="fas fa-heart me-1"></i>Family'}</span></div>
                    <div class="row g-2 small">
                        <div class="col-12"><div class="detail-label">Full Name</div><div class="detail-value">${a.nextOfKin?.fullName || '—'}</div></div>
                        <div class="col-6"><div class="detail-label">Phone</div><div class="detail-value">${a.nextOfKin?.phone || '—'}</div></div>
                        <div class="col-6"><div class="detail-label">Relationship</div><div class="detail-value">${a.nextOfKin?.relationship || '—'}</div></div>
                        ${a.beneficiaryType === 'lawyer' ? `
                        <div class="col-6"><div class="detail-label">Bar Number</div><div class="detail-value">${a.nextOfKin?.barNumber || '—'}</div></div>
                        <div class="col-6"><div class="detail-label">Law Firm</div><div class="detail-value">${a.nextOfKin?.lawFirm || '—'}</div></div>` : ''}
                        <div class="col-12"><div class="detail-label">Address</div><div class="detail-value">${a.nextOfKin?.address || '—'}</div></div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Transactions -->
            <div class="col-lg-7">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0" style="color:var(--kiddies-dark);">Recent Transactions <span class="badge" style="background:rgba(236,72,153,.1);color:var(--kiddies);">${transactions.length}</span></h6>
                    ${transactions.length > 8 ? `<button class="btn btn-sm btn-outline-kiddies" onclick="viewAllTx('${a._id}')">View All</button>` : ''}
                </div>
                <div class="detail-section" style="max-height:420px;overflow-y:auto;">
                    ${txHtml}
                </div>

                ${a.adminNote ? `
                <div class="detail-section mt-3" style="background:rgba(245,158,11,.05);border-color:rgba(245,158,11,.2);">
                    <h6 class="fw-bold mb-2" style="color:#92400e;"><i class="fas fa-sticky-note me-2"></i>Admin Note</h6>
                    <p class="mb-0 small">${a.adminNote}</p>
                </div>` : ''}

                ${a.declineReason ? `
                <div class="detail-section mt-3" style="background:rgba(239,68,68,.05);border-color:rgba(239,68,68,.2);">
                    <h6 class="fw-bold mb-2 text-danger"><i class="fas fa-times-circle me-2"></i>Decline Reason</h6>
                    <p class="mb-0 small">${a.declineReason}</p>
                </div>` : ''}

                <div class="detail-section mt-3" style="background:rgba(30,58,138,.03);border-color:rgba(30,58,138,.1);">
                    <h6 class="fw-bold mb-2" style="color:var(--primary);"><i class="fas fa-info-circle me-2"></i>Account Timeline</h6>
                    <div class="small">
                        <div class="d-flex justify-content-between mb-1"><span class="text-muted">Registered</span><span>${new Date(a.createdAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</span></div>
                        ${a.approvedAt ? `<div class="d-flex justify-content-between mb-1"><span class="text-muted">Approved</span><span class="text-success">${new Date(a.approvedAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</span></div>` : ''}
                        ${a.declinedAt ? `<div class="d-flex justify-content-between mb-1"><span class="text-muted">Declined</span><span class="text-danger">${new Date(a.declinedAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</span></div>` : ''}
                    </div>
                </div>
            </div>
        </div>`;

        // Footer buttons
        let footerHtml = `<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>`;
        if (a.status === 'locked' && a.registrationStatus === 'paid') {
            footerHtml = `<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" onclick="openDecline('${a._id}')"><i class="fas fa-times me-2"></i>Decline</button>
                <button type="button" class="btn btn-success" onclick="openApprove('${a._id}')"><i class="fas fa-check me-2"></i>Approve Account</button>`;
        } else if (a.status === 'active') {
            footerHtml = `<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" onclick="openCloseAccount('${a._id}')"><i class="fas fa-lock me-2"></i>Close Account</button>`;
        }
        footer.innerHTML = footerHtml;

    } catch (err) {
        body.innerHTML = `<div class="text-center py-5 text-danger"><i class="fas fa-exclamation-circle fa-2x mb-3"></i><p>Failed to load account details. Please try again.</p></div>`;
    }
}

/* ═══════════════════════════════════════════════════════════
   APPROVE ACCOUNT
═══════════════════════════════════════════════════════════ */
function openApprove(id) {
    currentAccountId = id;
    const a = allAccounts.find(a => a.id === id);
    if (!a) return;
    document.getElementById('approve_childName').textContent = `${a.childFirstName} ${a.childLastName}`;
    document.getElementById('approve_accountID').textContent = a.accountID;
    document.getElementById('approve_parentName').textContent = a.parent ? `${a.parent.firstName} ${a.parent.lastName}` : '—';
    document.getElementById('approve_balance').textContent = `₦${a.balance.toLocaleString()}`;
    document.getElementById('approve_note').value = '';

    // Close detail modal if open
    const dm = bootstrap.Modal.getInstance(document.getElementById('detailModal'));
    if (dm) dm.hide();

    setTimeout(() => new bootstrap.Modal(document.getElementById('approveModal')).show(), dm ? 400 : 0);
}

async function confirmApprove() {
    const note = document.getElementById('approve_note').value;
    const modalEl = document.getElementById('approveModal');

    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ note })
    });
    const data = await res.json();

    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        // Update local data
        const a = allAccounts.find(a => a.id === currentAccountId);
        if (a) { a.status = 'active'; a.approvedAt = new Date(); }
        filteredAccounts = [...allAccounts];
        applyFilters();
        await showNotify({ type: 'success', title: 'Account Approved!', message: `${data.childName}'s account (${data.accountID}) has been approved and set to Active.` });
    } else {
        await showNotify({ type: 'error', title: 'Approval Failed', message: data.message || 'An error occurred.' });
    }
}

/* ═══════════════════════════════════════════════════════════
   DECLINE ACCOUNT
═══════════════════════════════════════════════════════════ */
function openDecline(id) {
    currentAccountId = id;
    const a = allAccounts.find(a => a.id === id);
    if (!a) return;
    document.getElementById('decline_childName').textContent = `${a.childFirstName} ${a.childLastName}`;
    document.getElementById('decline_accountID').textContent = a.accountID;
    document.getElementById('decline_reason_select').value = '';
    document.getElementById('decline_reason').value = '';

    const dm = bootstrap.Modal.getInstance(document.getElementById('detailModal'));
    if (dm) dm.hide();
    setTimeout(() => new bootstrap.Modal(document.getElementById('declineModal')).show(), dm ? 400 : 0);
}

function handleDeclineReasonChange() {
    const val = document.getElementById('decline_reason_select').value;
    if (val && val !== 'other') document.getElementById('decline_reason').value = val;
    if (val === 'other') document.getElementById('decline_reason').value = '';
}

async function confirmDecline() {
    const reason = document.getElementById('decline_reason_select').value === 'other'
        ? document.getElementById('decline_reason').value
        : (document.getElementById('decline_reason_select').value || document.getElementById('decline_reason').value);

    if (!reason) {
        await showNotify({ type: 'warning', title: 'Required', message: 'Please provide a reason for declining this account.' });
        return;
    }

    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/decline`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
    });
    const data = await res.json();
    const modalEl = document.getElementById('declineModal');

    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        const a = allAccounts.find(a => a.id === currentAccountId);
        if (a) { a.status = 'locked'; a.declineReason = reason; }
        applyFilters();
        await showNotify({ type: 'info', title: 'Account Declined', message: `Account ${data.accountID} has been declined and remains locked.` });
    } else {
        await showNotify({ type: 'error', title: 'Failed', message: data.message || 'An error occurred.' });
    }
}

/* ═══════════════════════════════════════════════════════════
   TRANSACTION APPROVE / DECLINE
═══════════════════════════════════════════════════════════ */
function openTxAction(accountId, txId, action) {
    currentAccountId = accountId;
    currentTxId = txId;
    currentTxAction = action;

    // Pre-fill from DOM context (could do a fetch too)
    document.getElementById('tx_amount').textContent = '—';
    document.getElementById('tx_account').textContent = '—';
    document.getElementById('tx_method').textContent = 'Manual Transfer';
    document.getElementById('tx_date').textContent = '—';
    document.getElementById('tx_reason').value = '';

    if (action === 'approve') {
        document.getElementById('txActionTitle').innerHTML = '<i class="fas fa-check-circle me-2"></i>Approve Deposit';
        document.getElementById('txActionHeader').className = 'modal-header success-header';
        document.getElementById('txApproveBtn').style.display = '';
        document.getElementById('txDeclineBtn').style.display = 'none';
        document.getElementById('txReasonField').style.display = 'none';
    } else {
        document.getElementById('txActionTitle').innerHTML = '<i class="fas fa-times-circle me-2"></i>Decline Deposit';
        document.getElementById('txActionHeader').className = 'modal-header danger-header';
        document.getElementById('txApproveBtn').style.display = 'none';
        document.getElementById('txDeclineBtn').style.display = '';
        document.getElementById('txReasonField').style.display = '';
    }

    // Close detail modal first
    const dm = bootstrap.Modal.getInstance(document.getElementById('detailModal'));
    if (dm) dm.hide();
    setTimeout(() => new bootstrap.Modal(document.getElementById('txActionModal')).show(), dm ? 400 : 0);
}

async function submitTxApprove() {
    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/approve-transaction`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ transactionId: currentTxId })
    });
    const data = await res.json();
    const modalEl = document.getElementById('txActionModal');
    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        // Update local balance
        const a = allAccounts.find(a => a.id === currentAccountId);
        if (a && data.amount) { a.balance += data.amount; a.pendingTransactionCount = Math.max(0, a.pendingTransactionCount - 1); }
        renderTable();
        await showNotify({ type: 'success', title: 'Deposit Approved', message: `₦${data.amount?.toLocaleString() || ''} has been credited to the kiddies account.` });
    } else {
        await showNotify({ type: 'error', title: 'Failed', message: data.message || 'An error occurred.' });
    }
}

async function submitTxDecline() {
    const reason = document.getElementById('tx_reason').value;
    if (!reason) {
        await showNotify({ type: 'warning', title: 'Required', message: 'Please provide a reason for declining this transaction.' });
        return;
    }
    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/decline-transaction`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ transactionId: currentTxId, reason })
    });
    const data = await res.json();
    const modalEl = document.getElementById('txActionModal');
    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        const a = allAccounts.find(a => a.id === currentAccountId);
        if (a) a.pendingTransactionCount = Math.max(0, a.pendingTransactionCount - 1);
        renderTable();
        await showNotify({ type: 'info', title: 'Transaction Declined', message: 'The transaction has been declined.' });
    } else {
        await showNotify({ type: 'error', title: 'Failed', message: data.message || 'An error occurred.' });
    }
}

/* ═══════════════════════════════════════════════════════════
   CLOSE ACCOUNT
═══════════════════════════════════════════════════════════ */
function openCloseAccount(id) {
    currentAccountId = id;
    const a = allAccounts.find(a => a.id === id);
    if (!a) return;
    document.getElementById('close_childName').textContent = `${a.childFirstName} ${a.childLastName}`;
    document.getElementById('close_balance').textContent = `₦${a.balance.toLocaleString()}`;
    document.getElementById('close_reason').value = '';
    document.getElementById('close_confirm_text').value = '';

    const dm = bootstrap.Modal.getInstance(document.getElementById('detailModal'));
    if (dm) dm.hide();
    setTimeout(() => new bootstrap.Modal(document.getElementById('closeAccountModal')).show(), dm ? 400 : 0);
}

async function confirmCloseAccount() {
    const confirm = document.getElementById('close_confirm_text').value.trim();
    const reason  = document.getElementById('close_reason').value.trim();
    if (confirm !== 'CLOSE') {
        await showNotify({ type: 'warning', title: 'Confirmation Required', message: 'Please type CLOSE in the confirmation field to proceed.' });
        return;
    }
    if (!reason) {
        await showNotify({ type: 'warning', title: 'Required', message: 'Please provide a reason for closing this account.' });
        return;
    }
    const res = await fetch(`/api/admin/kiddies/${currentAccountId}/close`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
    });
    const data = await res.json();
    const modalEl = document.getElementById('closeAccountModal');
    if (res.ok) {
        bootstrap.Modal.getInstance(modalEl)?.hide();
        const a = allAccounts.find(a => a.id === currentAccountId);
        if (a) a.status = 'closed';
        applyFilters();
        await showNotify({ type: 'info', title: 'Account Closed', message: 'The kiddies account has been permanently closed.' });
    } else {
        await showNotify({ type: 'error', title: 'Failed', message: data.message || 'An error occurred.' });
    }
}

/* ═══════════════════════════════════════════════════════════
   EXPORT
═══════════════════════════════════════════════════════════ */
function exportData() {
    const rows = [['Account ID','Child Name','Gender','DOB','Parent','Parent Email','Balance','Interest','Status','Payment','Maturity','Registered']];
    filteredAccounts.forEach(a => rows.push([
        a.accountID,
        `${a.childFirstName} ${a.childLastName}`,
        a.childGender,
        a.childDOB ? new Date(a.childDOB).toLocaleDateString() : '',
        a.parent ? `${a.parent.firstName} ${a.parent.lastName}` : '',
        a.parent?.email || '',
        a.balance,
        a.interest,
        a.status,
        a.registrationStatus,
        a.unlockDate ? new Date(a.unlockDate).toLocaleDateString() : '',
        new Date(a.createdAt).toLocaleDateString()
    ]));
    const csv = rows.map(r => r.map(c => `"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
    const blob = new Blob([csv], {type:'text/csv'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url;
    a.download = `kiddies-accounts-${new Date().toISOString().split('T')[0]}.csv`;
    a.click(); URL.revokeObjectURL(url);
}

/* ═══════════════════════════════════════════════════════════
   NOTIFICATION MODAL
═══════════════════════════════════════════════════════════ */
let _notifyResolve = null;

function showNotify({ type='info', title='', message='', confirmLabel='OK', cancelLabel=null } = {}) {
    return new Promise(resolve => {
        _notifyResolve = resolve;
        const iconMap = {
            success: { icon: 'fa-check-circle', label: title || 'Success' },
            error:   { icon: 'fa-times-circle',  label: title || 'Error'   },
            warning: { icon: 'fa-exclamation-triangle', label: title || 'Warning' },
            info:    { icon: 'fa-info-circle',   label: title || 'Info'    },
        };
        const cfg = iconMap[type] || iconMap.info;
        document.getElementById('notifyIcon').className    = `notify-icon-wrap ${type}`;
        document.getElementById('notifyIconClass').className = `fas ${cfg.icon}`;
        const titleEl = document.getElementById('notifyTitle');
        titleEl.className   = `notify-title ${type}`;
        titleEl.textContent = cfg.label;
        document.getElementById('notifyMessage').textContent = message;
        const okBtn = document.getElementById('notifyOkBtn');
        okBtn.className   = `notify-btn-ok ${type}`;
        okBtn.textContent = confirmLabel;
        const existing = document.getElementById('notifyCancelBtn');
        if (existing) existing.remove();
        if (cancelLabel) {
            const cb = document.createElement('button');
            cb.className = 'notify-btn-cancel'; cb.id = 'notifyCancelBtn';
            cb.textContent = cancelLabel; cb.onclick = notifyCancel;
            document.getElementById('notifyFooter').insertBefore(cb, okBtn);
        }
        new bootstrap.Modal(document.getElementById('notifyModal'), { backdrop: 'static', keyboard: false }).show();
    });
}

function notifyClose() {
    bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide();
    if (_notifyResolve) { _notifyResolve(true); _notifyResolve = null; }
}
function notifyCancel() {
    bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide();
    if (_notifyResolve) { _notifyResolve(false); _notifyResolve = null; }
}

/* ═══════════════════════════════════════════════════════════
   SIDEBAR
═══════════════════════════════════════════════════════════ */
function toggleSidebar() {
    if (window.innerWidth <= 992) {
        document.getElementById('sidebar').classList.toggle('active');
        document.getElementById('sidebarOverlay').classList.toggle('active');
    }
}
function closeSidebar() {
    document.getElementById('sidebar').classList.remove('active');
    document.getElementById('sidebarOverlay').classList.remove('active');
}

async function loadSidebarPendingCount() {
    try {
        const res = await fetch('/admin/pending-approvals-count');
        const data = await res.json();
        const badge = document.getElementById('sidebarPendingBadge');
        if (!badge) return;
        badge.style.display = data.count > 0 ? 'inline-block' : 'none';
        if (data.count > 0) badge.textContent = data.count;
    } catch (e) {}
}
document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
</script>
</body>
</html>
