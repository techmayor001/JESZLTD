                        <div class="col-6"><div class="detail-label">Phone</div><div class="detail-value">${a.nextOfKin?.phone||'—'}</div></div>
                        <div class="col-6"><div class="detail-label">Relationship</div><div class="detail-value">${a.nextOfKin?.relationship||'—'}</div></div>
                        ${a.beneficiaryType==='lawyer'?`<div class="col-6"><div class="detail-label">Bar Number</div><div class="detail-value">${a.nextOfKin?.barNumber||'—'}</div></div><div class="col-6"><div class="detail-label">Law Firm</div><div class="detail-value">${a.nextOfKin?.lawFirm||'—'}</div></div>`:''}
