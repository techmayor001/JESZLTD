<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kiddies Accounts | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary:       #1e3a8a;
            --primary-mid:   #1e40af;
            --primary-light: #3b82f6;
            --success:       #10b981;
            --danger:        #ef4444;
            --warning:       #f59e0b;
            --sidebar-width: 280px;
            --navbar-h:      70px;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }

        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18);
            position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box {
            width: 42px; height: 42px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0;
        }
        .sidebar-brand { font-size: .95rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .65rem; font-weight: 500; opacity: .55; display: block; letter-spacing: .08em; }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 10px; background: rgba(239,68,68,.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.3);
            font-weight: 700; font-size: .7rem; color: #fca5a5;
        }

        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }
        .nav-category {
            display: flex; align-items: center; gap: 7px;
            padding: .55rem 1.25rem .3rem;
            font-size: .62rem; font-weight: 800;
            color: rgba(255,255,255,.38);
            text-transform: uppercase; letter-spacing: .1em;
            user-select: none;
        }
        .nav-category::after {
            content: ''; flex: 1; height: 1px;
            background: rgba(255,255,255,.08); margin-left: 4px;
        }

        .sidebar-nav a {
            display: flex; align-items: center; gap: 11px;
            padding: .62rem 1.25rem; color: rgba(255,255,255,.72);
            text-decoration: none; font-weight: 500; font-size: .84rem;
            border-left: 3px solid transparent; transition: all .18s;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }
        .nav-badge {
            margin-left: auto; font-size: .63rem; font-weight: 800;
            padding: 2px 7px; border-radius: 10px;
            background: rgba(239,68,68,.9); color: white; flex-shrink: 0; line-height: 1.4;
        }
        .nav-back {
            display: flex; align-items: center; gap: 10px;
            padding: .7rem 1.25rem .9rem; font-size: .8rem; font-weight: 600;
            color: rgba(255,255,255,.42); text-decoration: none;
            transition: color .18s; border-top: 1px solid rgba(255,255,255,.07); margin-top: .25rem;
        }
        .nav-back:hover { color: rgba(255,255,255,.7); }

        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }

        /* ══════════ NAVBAR ══════════ */
        .top-navbar {
            position: fixed; top: 0;
            left: var(--sidebar-width); right: 0;
            height: var(--navbar-h);
            background: rgba(255,255,255,.97);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08);
            z-index: 1030;
            display: flex; align-items: center;
            padding: 0 1.5rem; gap: 1rem;
            border-bottom: 1px solid rgba(30,58,138,.1);
        }

        /* ══════════ MAIN ══════════ */
        .main-content { margin-left: var(--sidebar-width); margin-top: var(--navbar-h); padding: 1.5rem; min-height: calc(100vh - var(--navbar-h)); }

        /* ══════════ PAGE HEADER ══════════ */
        .page-header {
            background: linear-gradient(130deg, #1e3a8a 0%, #1e40af 45%, #3b82f6 100%);
            border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 10px 36px rgba(30,58,138,.28);
            color: white; position: relative; overflow: hidden;
        }
        .page-header::before {
            content: ''; position: absolute; top: -50%; right: -10%;
            width: 300px; height: 300px;
            background: rgba(255,255,255,.06); border-radius: 50%; pointer-events: none;
        }
        .page-header::after {
            content: ''; position: absolute; bottom: -60%; right: 15%;
            width: 200px; height: 200px;
            background: rgba(255,255,255,.04); border-radius: 50%; pointer-events: none;
        }

        /* ══════════ STAT CARDS ══════════ */
        .stat-card { background: white; border-radius: 16px; padding: 1.5rem; box-shadow: 0 8px 20px rgba(30,58,138,.08); transition: transform .3s, box-shadow .3s; height: 100%; border: 1px solid rgba(30,58,138,.05); }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,.15); }
        .stat-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 1rem; }

        /* ══════════ FILTER / TABLE ══════════ */
        .filter-section { background: white; border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 4px 15px rgba(30,58,138,.06); }
        .table-card { background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 20px rgba(30,58,138,.08); }
        .scroll-hint { display: none; align-items: center; gap: 6px; padding: .3rem 1rem; background: rgba(30,58,138,.04); font-size: .78rem; color: var(--primary); font-weight: 600; }
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: rgba(30,58,138,.2) transparent; }
        .table-responsive::-webkit-scrollbar { height: 4px; }
        .table-responsive::-webkit-scrollbar-thumb { background: rgba(30,58,138,.25); border-radius: 4px; }
        .table { margin-bottom: 0; font-size: .9rem; min-width: 1000px; width: 100%; }
        .table thead { background: linear-gradient(135deg, rgba(30,58,138,.05) 0%, rgba(59,130,246,.05) 100%); }
        .table thead th { border: none; padding: 1rem; font-weight: 600; color: var(--primary); white-space: nowrap; }
        .table tbody td { padding: 1rem; vertical-align: middle; }
        .table tbody tr:hover { background: rgba(59,130,246,.03); }

        /* ══════════ BADGES ══════════ */
        .badge { padding: .45rem .85rem; border-radius: 8px; font-weight: 600; font-size: .73rem; white-space: nowrap; }
        .badge-active  { background: linear-gradient(135deg,#d1fae5,#a7f3d0); color: #065f46; }
        .badge-locked  { background: linear-gradient(135deg,#fef3c7,#fde68a); color: #78350f; }
        .badge-pending { background: linear-gradient(135deg,#dbeafe,#bfdbfe); color: #1e3a8a; }
        .badge-closed  { background: linear-gradient(135deg,#f3f4f6,#e5e7eb); color: #374151; }
        .badge-paid    { background: linear-gradient(135deg,#d1fae5,#a7f3d0); color: #065f46; }
        .badge-unpaid  { background: linear-gradient(135deg,#fee2e2,#fca5a5); color: #7f1d1d; }
        .badge-lawyer  { background: linear-gradient(135deg,#ede9fe,#ddd6fe); color: #4c1d95; }
        .badge-family  { background: linear-gradient(135deg,#dbeafe,#bfdbfe); color: #1e3a8a; }

        /* ══════════ BUTTONS ══════════ */
        .action-btn { padding: .35rem .7rem; border-radius: 8px; font-size: .82rem; border: none; transition: all .3s; cursor: pointer; }
        .btn-group-tight { display: flex; flex-wrap: nowrap; gap: 3px; }
        .btn-primary { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); border: none; border-radius: 10px; padding: .6rem 1.5rem; font-weight: 600; transition: all .3s; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(30,58,138,.3); }
        .btn-outline-primary { border: 2px solid var(--primary); color: var(--primary); background: transparent; font-weight: 600; transition: all .3s; border-radius: 10px; }
        .btn-outline-primary:hover { background: var(--primary); color: white; transform: translateY(-2px); }
        .btn-sm { padding: .4rem 1rem; font-size: .85rem; border-radius: 8px; }

        /* ══════════ FORM CONTROLS ══════════ */
        .form-label { font-weight: 600; color: var(--primary); margin-bottom: .5rem; }
        .form-control, .form-select { border-radius: 10px; border: 2px solid rgba(30,58,138,.1); padding: .65rem 1rem; transition: border-color .2s; }
        .form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 .2rem rgba(30,58,138,.1); }
        .search-box { position: relative; }
        .search-box input { padding-left: 2.5rem; }
        .search-box i { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--primary); }

        /* ══════════ CARDS ══════════ */
        .card { border: none; border-radius: 16px; box-shadow: 0 8px 20px rgba(30,58,138,.08); background: white; border: 1px solid rgba(30,58,138,.05); }
        .card-header { background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%); border-bottom: 2px solid rgba(30,58,138,.1); padding: 1.25rem; border-radius: 16px 16px 0 0 !important; }

        /* ══════════ MODALS ══════════ */
        .modal-content { border-radius: 16px; border: none; }
        .modal-header { border-radius: 16px 16px 0 0; background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white; border: none; }
        .modal-header .btn-close { filter: invert(1); }
        .modal-header.danger-header  { background: linear-gradient(135deg, #7f1d1d 0%, #ef4444 100%) !important; }
        .modal-header.success-header { background: linear-gradient(135deg, #064e3b 0%, #10b981 100%) !important; }
        .modal-header.warning-header { background: linear-gradient(135deg, #78350f 0%, #f59e0b 100%) !important; }

        /* ══════════ CHILD AVATAR ══════════ */
        .child-avatar { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #1e3a8a, #3b82f6); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1rem; flex-shrink: 0; border: 2px solid rgba(30,58,138,.2); }
        .parent-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(30,58,138,.15); flex-shrink: 0; }

        /* ══════════ DETAIL MODAL ══════════ */
        .detail-section { background: rgba(30,58,138,.03); border-radius: 12px; padding: 1.25rem; border: 1px solid rgba(30,58,138,.08); }
        .detail-label { font-size: .78rem; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; margin-bottom: .2rem; }
        .detail-value { font-weight: 600; color: #1f2937; font-size: .92rem; }
        .progress-bar-primary { background: linear-gradient(90deg, #1e3a8a, #3b82f6); border-radius: 10px; }
        .maturity-progress { height: 8px; border-radius: 10px; background: rgba(30,58,138,.1); overflow: hidden; }

        /* ══════════ TX ROW ══════════ */
        .tx-row { display: flex; align-items: center; gap: .875rem; padding: .875rem 0; border-bottom: 1px solid rgba(30,58,138,.06); }
        .tx-row:last-child { border-bottom: none; }
        .tx-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }

        /* ══════════ PAGINATION ══════════ */
        .page-link { color: var(--primary); border-radius: 8px; margin: 0 .25rem; border: 2px solid rgba(30,58,138,.15); }
        .page-link:hover { background: var(--primary); color: white; border-color: var(--primary); }
        .page-item.active .page-link { background: var(--primary); border-color: var(--primary); }

        /* ══════════ NOTIFICATION MODAL ══════════ */
        #notifyModal .modal-content { border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,.18); }
        #notifyModal .modal-header { background: transparent !important; border: none; display: none; }
        #notifyModal .modal-body { padding: 2rem; text-align: center; }
        .notify-icon-wrap { width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 2.2rem; animation: notifyPop .4s cubic-bezier(.34,1.56,.64,1) both; }
        @keyframes notifyPop { from {transform:scale(.4);opacity:0;} to {transform:scale(1);opacity:1;} }
        .notify-icon-wrap.success { background: linear-gradient(135deg,#d1fae5,#6ee7b7); color:#059669; }
        .notify-icon-wrap.error   { background: linear-gradient(135deg,#fee2e2,#fca5a5); color:#dc2626; }
        .notify-icon-wrap.warning { background: linear-gradient(135deg,#fef3c7,#fcd34d); color:#d97706; }
        .notify-icon-wrap.info    { background: linear-gradient(135deg,#dbeafe,#93c5fd); color:#2563eb; }
        .notify-title { font-size: 1.25rem; font-weight: 700; margin-bottom: .5rem; }
        .notify-title.success{color:#065f46;} .notify-title.error{color:#7f1d1d;} .notify-title.warning{color:#78350f;} .notify-title.info{color:#1e3a8a;}
        .notify-message { color:#475569; font-size:.95rem; line-height:1.6; margin-bottom:1.5rem; white-space:pre-line; }
        .notify-footer { display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap; }
        .notify-btn-ok { padding:.6rem 2rem; border-radius:10px; border:none; font-weight:600; font-size:.95rem; cursor:pointer; transition:all .25s; color:white; }
        .notify-btn-ok.success{background:linear-gradient(135deg,#10b981,#059669);}
        .notify-btn-ok.error  {background:linear-gradient(135deg,#ef4444,#dc2626);}
        .notify-btn-ok.warning{background:linear-gradient(135deg,#f59e0b,#d97706);}
        .notify-btn-ok.info   {background:linear-gradient(135deg,#1e3a8a,#3b82f6);}
        .notify-btn-ok:hover  {transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.18);}
        .notify-btn-cancel { padding:.6rem 1.5rem; border-radius:10px; border:2px solid #e2e8f0; background:white; color:#64748b; font-weight:600; font-size:.95rem; cursor:pointer; transition:all .25s; }
        .notify-btn-cancel:hover { background:#f1f5f9; border-color:#cbd5e1; }

        /* ══════════ POWERED BY ══════════ */
        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,.14); font-size: .8rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        /* ══════════ ANIMATIONS ══════════ */
        @keyframes fadeIn { from { opacity:0; transform:translateY(10px);} to {opacity:1; transform:translateY(0);} }
        .animate-in { animation: fadeIn .4s ease both; }

        /* ══════════ EMPTY STATE ══════════ */
        .empty-state { padding: 3rem 1rem; text-align: center; }
        .empty-state .empty-icon { width: 80px; height: 80px; border-radius: 50%; background: rgba(30,58,138,.08); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 2rem; color: var(--primary); }

        /* ══════════ RESPONSIVE ══════════ */
        @media (max-width: 992px) { .sidebar{transform:translateX(-100%);} .sidebar.active{transform:translateX(0);} .top-navbar{left:0!important;} .main-content{margin-left:0!important;padding:1rem;} .scroll-hint{display:flex;} }
        @media (max-width: 768px) { .page-header{padding:1.25rem;} .stats-row>[class*="col-"]{flex:0 0 50%;max-width:50%;} .stat-card{display:flex;flex-direction:row;align-items:center;gap:1rem;padding:1rem;} .stat-icon{margin-bottom:0;width:48px;height:48px;font-size:1.25rem;} }
        @media (max-width: 576px) { :root{--navbar-h:60px;} .main-content{padding:.75rem;} .stats-row>[class*="col-"]{flex:0 0 50%;max-width:50%;} .modal-dialog{margin:.4rem;max-width:calc(100vw - .8rem);} .notify-footer{flex-direction:column-reverse;} .notify-btn-ok,.notify-btn-cancel{width:100%;} }
    </style>
</head>
<body>

<!-- ════════════════════════ SIDEBAR ════════════════════════ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-row">
            <div class="logo-box">C</div>
            <div>
                <div class="sidebar-brand">Club De Stars<small>Admin Panel</small></div>
            </div>
        </div>
        <div class="role-pill"><i class="fas fa-shield-alt" style="font-size:.65rem;"></i>&nbsp;Super Admin</div>
    </div>

     <div class="sidebar-nav">
        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-home" style="font-size:.6rem;"></i>Main</div>
            <a href="/admin/dashboard"><i class="fas fa-chart-pie"></i>Overview</a>
