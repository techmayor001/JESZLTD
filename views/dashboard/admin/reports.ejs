                        <div class="mini-stat"><div class="mini-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-exclamation"></i></div><div class="mini-body"><div class="mini-label">Outstanding</div><div class="mini-value">₦<%=(reportData.loans.totalOutstanding||0).toLocaleString()%></div></div></div>
