<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-light: #3b82f6;
            --sidebar-width: 280px;
            --navbar-h: 70px;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ══════════ NEW SIDEBAR STYLES ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto; transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }
        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18);
            position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box { width: 42px; height: 42px; background: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--primary); font-size: 1.3rem; box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0; }
        .sidebar-brand { font-size: .95rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .65rem; font-weight: 500; opacity: .55; display: block; letter-spacing: .08em; }
        .role-pill { display: inline-flex; align-items: center; gap: 7px; padding: 4px 10px; background: rgba(239,68,68,.2); border-radius: 20px; border: 1px solid rgba(239,68,68,.3); font-weight: 700; font-size: .7rem; color: #fca5a5; }
        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }
        .nav-category { display: flex; align-items: center; gap: 7px; padding: .55rem 1.25rem .3rem; font-size: .62rem; font-weight: 800; color: rgba(255,255,255,.38); text-transform: uppercase; letter-spacing: .1em; user-select: none; }
        .nav-category::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.08); margin-left: 4px; }
        .sidebar-nav a { display: flex; align-items: center; gap: 11px; padding: .62rem 1.25rem; color: rgba(255,255,255,.72); text-decoration: none; font-weight: 500; font-size: .84rem; border-left: 3px solid transparent; transition: all .18s; }
        .sidebar-nav a:hover { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }
        .nav-badge { margin-left: auto; font-size: .63rem; font-weight: 800; padding: 2px 7px; border-radius: 10px; background: rgba(239,68,68,.9); color: white; flex-shrink: 0; line-height: 1.4; }
        .nav-back { display: flex; align-items: center; gap: 10px; padding: .7rem 1.25rem .9rem; font-size: .8rem; font-weight: 600; color: rgba(255,255,255,.42); text-decoration: none; transition: color .18s; border-top: 1px solid rgba(255,255,255,.07); margin-top: .25rem; }
        .nav-back:hover { color: rgba(255,255,255,.7); }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }
        /* ══════════ END NEW SIDEBAR STYLES ══════════ */

        /* ── NAVBAR ── */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: var(--navbar-h);
            background: rgba(255,255,255,.97); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.25rem; gap: .75rem;
            border-bottom: 1px solid rgba(30,58,138,.1);
        }
        .navbar-title { flex-grow: 1; min-width: 0; }
        .navbar-title h5 { margin: 0; font-size: 1rem; color: var(--primary); font-weight: 700; }
        .navbar-title small { font-size: .75rem; color: #64748b; }

        /* ── MAIN ── */
        .main-content { margin-left: var(--sidebar-width); margin-top: var(--navbar-h); padding: 1.25rem; min-height: calc(100vh - var(--navbar-h)); }

        /* ── REPORT MODE SWITCHER ── */
        .mode-switcher {
            display: flex; gap: .5rem;
            background: white; border-radius: 14px;
            padding: .4rem; box-shadow: 0 4px 16px rgba(30,58,138,.08);
            border: 1px solid rgba(30,58,138,.07);
            margin-bottom: 1.25rem;
        }
        .mode-btn {
            flex: 1; padding: .65rem 1rem; border-radius: 10px; border: none;
            font-weight: 700; font-size: .85rem; cursor: pointer; transition: all .2s;
            display: flex; align-items: center; justify-content: center; gap: 7px;
            color: #64748b; background: transparent;
        }
        .mode-btn.active {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white; box-shadow: 0 4px 14px rgba(30,58,138,.3);
        }
        .mode-btn:not(.active):hover { background: rgba(30,58,138,.06); color: var(--primary); }

        /* ── PAGE HEADER ── */
        .page-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 60%, #3b82f6 100%);
            color: white; border-radius: 18px; padding: 1.5rem 1.75rem;
            margin-bottom: 1.25rem; box-shadow: 0 10px 30px rgba(30,58,138,.22);
            position: relative; overflow: hidden;
        }
        .page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:180px; height:180px; border-radius:50%; background:rgba(255,255,255,.05); pointer-events:none; }
        .page-header h4 { font-size: 1.15rem; font-weight: 800; margin: 0 0 4px; }
        .page-header p { font-size: .8rem; opacity: .85; margin: 0; }

        /* ── SEARCH CARD ── */
        .search-card {
            background: white; border-radius: 14px; padding: 1.25rem;
            margin-bottom: 1.25rem; box-shadow: 0 4px 16px rgba(30,58,138,.07);
            border: 1px solid rgba(30,58,138,.06);
        }
        .form-label { font-weight: 700; color: var(--primary); font-size: .78rem; margin-bottom: .3rem; display: block; }
        .form-control, .form-select {
            border-radius: 9px; border: 2px solid rgba(30,58,138,.12);
            padding: .55rem .85rem; font-size: .86rem; width: 100%;
            transition: border-color .2s, box-shadow .2s;
        }
        .form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(30,58,138,.1); outline: none; }
        .search-icon-wrap { position: relative; }
        .search-icon-wrap i { position: absolute; left: .85rem; top: 50%; transform: translateY(-50%); color: var(--primary); font-size: .85rem; pointer-events: none; }
        .search-icon-wrap input { padding-left: 2.4rem; }
        .preset-strip { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .75rem; align-items: center; }
        .preset-label { font-size: .72rem; color: #94a3b8; font-weight: 700; }
        .preset-btn { padding: .22rem .65rem; font-size: .72rem; font-weight: 700; border-radius: 7px; border: 1.5px solid rgba(30,58,138,.2); color: var(--primary); background: transparent; cursor: pointer; transition: all .18s; }
        .preset-btn:hover { background: var(--primary); color: white; border-color: var(--primary); }

        /* ── ACTION BUTTONS ── */
        .btn { border-radius: 9px; font-weight: 700; transition: all .2s; border: none; cursor: pointer; }
        .btn-primary { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white; padding: .55rem 1.2rem; font-size: .86rem; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 5px 16px rgba(30,58,138,.3); }
        .btn-outline { border: 2px solid rgba(30,58,138,.2); color: var(--primary); background: transparent; padding: .53rem 1rem; font-size: .86rem; }
        .btn-outline:hover { background: var(--primary); color: white; border-color: var(--primary); }
        .btn-sm { padding: .4rem .85rem; font-size: .8rem; }
        .btn-xs { padding: .28rem .65rem; font-size: .74rem; }

        /* ── MEMBER CARD ── */
        .member-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border-radius: 16px; padding: 1.25rem; color: white;
            margin-bottom: 1.25rem; box-shadow: 0 8px 24px rgba(30,58,138,.25);
            position: relative; overflow: hidden;
        }
        .member-card::after { content:''; position:absolute; right:-30px; top:-30px; width:140px; height:140px; border-radius:50%; background:rgba(255,255,255,.06); pointer-events:none; }
        .m-avatar { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 2.5px solid rgba(255,255,255,.4); flex-shrink: 0; }
        .m-name { font-size: 1rem; font-weight: 800; margin: 0 0 4px; }
        .m-badge { display: inline-block; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.3); border-radius: 6px; padding: 2px 8px; font-size: .7rem; font-weight: 700; }
        .m-meta { display: flex; flex-wrap: wrap; gap: .4rem .65rem; font-size: .76rem; opacity: .9; margin-top: .3rem; }
        .m-meta span { display: flex; align-items: center; gap: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; }
        .m-balance-wrap { text-align: right; flex-shrink: 0; }
        .m-balance-label { font-size: .68rem; opacity: .72; text-transform: uppercase; letter-spacing: .5px; }
        .m-balance-value { font-size: 1.4rem; font-weight: 800; line-height: 1.1; }

        /* ── COMPANY STATS ROW ── */
        .company-stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: .75rem; margin-bottom: 1.25rem; }
        .cstat { background: white; border-radius: 12px; padding: 1rem; box-shadow: 0 3px 12px rgba(30,58,138,.07); border: 1px solid rgba(30,58,138,.05); display: flex; align-items: center; gap: .75rem; overflow: hidden; }
        .cstat-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
        .cstat-body { min-width: 0; flex: 1; }
        .cstat-label { font-size: .68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: .3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cstat-value { font-size: .95rem; font-weight: 800; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        /* ── SUMMARY BAR ── */
        .summary-bar {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            border-radius: 14px; color: white; margin-bottom: 1.25rem;
            box-shadow: 0 6px 20px rgba(30,58,138,.22); overflow-x: auto; -webkit-overflow-scrolling: touch;
        }
        .sum-grid { display: flex; min-width: 480px; }
        .sum-item { flex: 1; padding: .9rem .65rem; text-align: center; border-right: 1px solid rgba(255,255,255,.12); }
        .sum-item:last-child { border-right: none; }
        .sum-label { font-size: .65rem; opacity: .78; text-transform: uppercase; letter-spacing: .4px; white-space: nowrap; }
        .sum-value { font-size: .95rem; font-weight: 800; margin-top: 3px; white-space: nowrap; }
        .sum-sub { font-size: .6rem; opacity: .6; margin-top: 2px; }
        .clr-pos { color: #6ee7b7; }
        .clr-neg { color: #fca5a5; }

        /* ── TABS ── */
        .report-tabs { background: white; border-radius: 14px; margin-bottom: 1.25rem; box-shadow: 0 4px 14px rgba(30,58,138,.07); overflow: hidden; }
        .tab-scroller { overflow-x: auto; -webkit-overflow-scrolling: touch; background: rgba(30,58,138,.03); border-bottom: 2px solid rgba(30,58,138,.08); scrollbar-width: none; }
        .tab-scroller::-webkit-scrollbar { display: none; }
        .tab-nav { display: flex; gap: .25rem; padding: .6rem .75rem .4rem; white-space: nowrap; flex-wrap: nowrap; }
        .tab-link { display: inline-flex; align-items: center; gap: 5px; padding: .4rem .85rem; border-radius: 8px; border: none; background: transparent; color: #64748b; font-weight: 700; font-size: .8rem; cursor: pointer; transition: all .2s; white-space: nowrap; text-decoration: none; }
        .tab-link:hover { background: rgba(30,58,138,.08); color: var(--primary); }
        .tab-link.active { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white; box-shadow: 0 3px 10px rgba(30,58,138,.25); }
        .tab-count { font-size: .65rem; padding: 1px 5px; border-radius: 10px; font-weight: 800; }
        .tab-link.active .tab-count { background: rgba(255,255,255,.25); color: white; }
        .tab-link:not(.active) .tab-count { background: rgba(30,58,138,.1); color: var(--primary); }
        .tab-body { padding: 1.1rem; }
        .tab-pane { display: none; }
        .tab-pane.active { display: block; }

        /* ── MINI STATS ── */
        .mini-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .65rem; margin-bottom: 1rem; }
        .mini-stat { background: white; border-radius: 11px; padding: .85rem; box-shadow: 0 2px 8px rgba(30,58,138,.06); border: 1px solid rgba(30,58,138,.05); display: flex; align-items: center; gap: .6rem; overflow: hidden; }
        .mini-icon { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: .9rem; flex-shrink: 0; }
        .mini-body { min-width: 0; flex: 1; }
        .mini-label { font-size: .66rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .mini-value { font-size: .88rem; font-weight: 800; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        /* ── TABLE ── */
        .tbl-card { background: white; border-radius: 11px; overflow: hidden; border: 1px solid rgba(30,58,138,.07); margin-top: .75rem; }
        .tbl-head { padding: .7rem 1rem; border-bottom: 2px solid rgba(30,58,138,.07); background: rgba(30,58,138,.02); display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; }
        .tbl-title { font-weight: 700; color: var(--primary); font-size: .85rem; display: flex; align-items: center; gap: 6px; }
        .swipe-note { display: none; align-items: center; gap: 4px; font-size: .7rem; color: var(--primary); font-weight: 600; opacity: .7; }
        .tbl-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: rgba(30,58,138,.2) transparent; }
        .tbl-scroll::-webkit-scrollbar { height: 3px; }
        .tbl-scroll::-webkit-scrollbar-thumb { background: rgba(30,58,138,.2); border-radius: 3px; }
        table.tbl { margin: 0; width: 100%; border-collapse: collapse; }
        table.tbl thead tr { background: rgba(30,58,138,.04); }
        table.tbl thead th { padding: .6rem .75rem; font-weight: 800; color: var(--primary); white-space: nowrap; font-size: .7rem; text-transform: uppercase; letter-spacing: .3px; border: none; }
        table.tbl tbody td { padding: .6rem .75rem; vertical-align: middle; border-top: 1px solid rgba(30,58,138,.05); font-size: .8rem; }
        table.tbl tbody tr:hover td { background: rgba(59,130,246,.03); }
        table.tbl tfoot td { padding: .6rem .75rem; font-weight: 800; border-top: 2px solid rgba(30,58,138,.1); background: rgba(30,58,138,.03); font-size: .8rem; }
        .tbl-min { min-width: 500px; }
        .tbl-min-md { min-width: 680px; }
        .tbl-min-lg { min-width: 860px; }

        /* ── BADGES ── */
        .badge { display: inline-block; padding: .28rem .6rem; border-radius: 6px; font-weight: 700; font-size: .68rem; white-space: nowrap; }
        .bs-approved, .bs-active, .bs-paid, .bs-confirmed, .bs-completed { background: #d1fae5; color: #065f46; }
        .bs-pending { background: #fef3c7; color: #92400e; }
        .bs-rejected, .bs-defaulted, .bs-overdue { background: #fee2e2; color: #7f1d1d; }
        .bs-active-loan, .bs-processing { background: #dbeafe; color: #1e3a8a; }
        .bs-reversed, .bs-cancelled { background: #f3f4f6; color: #374151; }
        .bs-waived { background: #e0e7ff; color: #3730a3; }
        .bs-purple { background: #e0e7ff; color: #3730a3; }
        .bs-teal { background: #ccfbf1; color: #0f766e; }

        /* ── TEXT HELPERS ── */
        .pos { font-weight: 700; color: #059669; white-space: nowrap; }
        .neg { font-weight: 700; color: #dc2626; white-space: nowrap; }
        .neu { font-size: .78rem; white-space: nowrap; }
        .dt-main { font-size: .8rem; font-weight: 600; white-space: nowrap; }
        .dt-sub { font-size: .68rem; color: #94a3b8; white-space: nowrap; }
        code { font-size: .71rem; background: rgba(30,58,138,.06); border-radius: 4px; padding: 1px 5px; color: var(--primary); }

        /* ── ACTOR PILL ── */
        .actor { display: inline-flex; align-items: center; gap: 4px; background: rgba(30,58,138,.07); border-radius: 20px; padding: 2px 8px; font-size: .7rem; font-weight: 700; color: var(--primary); white-space: nowrap; max-width: 130px; overflow: hidden; text-overflow: ellipsis; }

        /* ── LOAN CARD ── */
        .loan-card { background: white; border-radius: 12px; border: 1px solid rgba(30,58,138,.08); margin-bottom: .75rem; overflow: hidden; }
        .loan-hdr { padding: .7rem 1rem; background: rgba(30,58,138,.03); border-bottom: 1px solid rgba(30,58,138,.07); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .4rem; }
        .loan-hdr-title { font-weight: 800; color: var(--primary); font-size: .85rem; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .loan-body { padding: .9rem 1rem; }
        .loan-kv { font-size: .66rem; color: #94a3b8; text-transform: uppercase; font-weight: 700; margin-bottom: 2px; }
        .loan-val { font-weight: 800; font-size: .85rem; color: #1e293b; word-break: break-word; }
        .approver-strip { display: flex; align-items: flex-start; gap: 8px; background: rgba(30,58,138,.04); border-radius: 8px; padding: .6rem .75rem; border-left: 3px solid var(--primary); margin-bottom: .75rem; font-size: .78rem; flex-wrap: wrap; }
        .g-list { list-style: none; padding: 0; margin: 0; }
        .g-list li { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; padding: 5px 0; border-bottom: 1px solid rgba(30,58,138,.05); font-size: .78rem; }
        .g-list li:last-child { border: none; }

        /* ── ROI BANNER ── */
        .roi-banner { border-radius: 10px; padding: .75rem 1rem; margin-bottom: .75rem; display: flex; align-items: flex-start; gap: .65rem; font-size: .8rem; }

        /* ── EMPTY / CENTER ── */
        .empty-state { padding: 2.5rem 1rem; text-align: center; color: #94a3b8; }
        .empty-state i { font-size: 2.2rem; margin-bottom: .65rem; opacity: .3; display: block; }
        .empty-state p { margin: 0; font-size: .85rem; }
        .center-card { background: white; border-radius: 16px; padding: 2.5rem 1.5rem; text-align: center; box-shadow: 0 6px 18px rgba(30,58,138,.07); }
        .center-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.1rem; font-size: 1.7rem; }

        /* ── POWERED ── */
        .powered-by { position: fixed; bottom: 16px; right: 16px; background: white; padding: 9px 15px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,.12); font-size: .78rem; font-weight: 700; color: var(--primary); z-index: 1000; }

        /* ── PRINT ── */
        @media print {
            .sidebar, .top-navbar, .search-card, .mode-switcher, .no-print, .powered-by { display: none !important; }
            .main-content { margin: 0 !important; padding: 0 !important; }
            .tab-pane { display: block !important; margin-bottom: 1.5rem; }
            table.tbl { min-width: unset !important; font-size: .72rem; }
        }

        /* ── TABLET ≤992px ── */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0 !important; }
            .main-content { margin-left: 0 !important; }
            .swipe-note { display: flex; }
        }

        /* ── TABLET ≤768px ── */
        @media (max-width: 768px) {
            :root { --navbar-h: 58px; }
            .top-navbar { height: 58px; padding: 0 .9rem; gap: .5rem; }
            .main-content { padding: .9rem; }
            .mode-btn { font-size: .8rem; padding: .6rem .7rem; }
            .page-header { padding: 1.1rem 1.25rem; }
            .page-header h4 { font-size: 1rem; }
        }

        /* ── MOBILE ≤576px ── */
        @media (max-width: 576px) {
            :root { --navbar-h: 54px; }
            .top-navbar { height: 54px; padding: 0 .75rem; }
            .main-content { padding: .75rem; }
            .mode-btn { font-size: .75rem; padding: .55rem .5rem; gap: 4px; }
            .mode-btn i { font-size: .8rem; }
            .page-header { padding: .9rem 1rem; border-radius: 14px; }
            .page-header h4 { font-size: .95rem; }
            .page-header p { font-size: .75rem; }
            .search-card { padding: .85rem; }
            .form-control, .form-select { padding: .48rem .75rem; font-size: .82rem; }
            .mini-grid { grid-template-columns: repeat(2, 1fr); }
            .company-stat-grid { grid-template-columns: repeat(2, 1fr); }
            table.tbl thead th { padding: .45rem .55rem; font-size: .64rem; }
            table.tbl tbody td { padding: .45rem .55rem; font-size: .75rem; }
            .tab-link { padding: .35rem .6rem; font-size: .73rem; }
            .tab-body { padding: .75rem; }
            .loan-hdr-title { font-size: .78rem; }
            .loan-val { font-size: .8rem; }
        }

        /* ── VERY SMALL ≤380px ── */
        @media (max-width: 380px) {
            .tab-link i { display: none; }
            .main-content { padding: .55rem; }
            .mini-grid { grid-template-columns: 1fr 1fr; gap: .45rem; }
        }
    </style>
</head>
<body>

