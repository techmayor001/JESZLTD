                                    <td><span class="badge bs-purple" style="text-transform:capitalize;font-size:.65rem;"><%=(c.chargeType||'').replace(/_/g,' ')%></span></td>
                                    <td style="max-width:130px;font-size:.76rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%=c.description%></td>
                                    <td><span class="neg">₦<%=c.amount.toLocaleString()%></span></td>
                                    <td><span class="badge bs-<%=c.status%>"><%=(c.status||'').toUpperCase()%></span></td>
                                    <td><%if(c.chargedBy){%><span class="actor"><i class="fas fa-shield-alt"></i><%=c.chargedBy.firstName%> <%=c.chargedBy.lastName?.charAt(0)%>.</span><%}else{%><small style="color:#94a3b8;">—</small><%}%></td>
                                    <td><%if(c.approvedBy){%><span class="actor"><i class="fas fa-shield-alt"></i><%=c.approvedBy.firstName%> <%=c.approvedBy.lastName?.charAt(0)%>.</span><%}else{%><small style="color:#94a3b8;">—</small><%}%></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="4" style="text-align:right;">PAID TOTAL</td><td colspan="4"><span class="neg">₦<%=(reportData.extraCharges.totalPaid||0).toLocaleString()%></span></td></tr></tfoot>
                        </table></div>
                    </div>
                </div>
                <%}%>

                <!-- SUBSCRIPTIONS -->
                <%if(reportData.subscriptions){%>
                <div class="tab-pane" id="m-sub">
                    <div class="mini-grid">
                        <div class="mini-stat"><div class="mini-icon" style="background:#dbeafe;color:#1e3a8a;"><i class="fas fa-cube"></i></div><div class="mini-body"><div class="mini-label">Total Billed</div><div class="mini-value">₦<%=(reportData.subscriptions.totalAmount||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-check"></i></div><div class="mini-body"><div class="mini-label">Paid</div><div class="mini-value">₦<%=(reportData.subscriptions.totalPaid||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-clock"></i></div><div class="mini-body"><div class="mini-label">Overdue</div><div class="mini-value">₦<%=(reportData.subscriptions.totalOverdue||0).toLocaleString()%></div></div></div>
                    </div>
                    <div class="tbl-card">
                        <div class="tbl-head"><div class="tbl-title"><i class="fas fa-cube"></i>Subscription History</div><div class="swipe-note"><i class="fas fa-arrows-left-right"></i>Scroll</div></div>
                        <div class="tbl-scroll"><table class="tbl tbl-min-md">
                            <thead><tr><th>#</th><th>Date</th><th>Plan</th><th>Period</th><th>Amount</th><th>Late Fee</th><th>Due</th><th>Paid</th><th>Status</th><th>By</th></tr></thead>
                            <tbody>
                                <%if(!reportData.subscriptions.records.length){%><tr><td colspan="10"><div class="empty-state"><i class="fas fa-cube"></i><p>No subscription records</p></div></td></tr><%}%>
                                <%reportData.subscriptions.records.forEach((s,i)=>{%>
                                <tr>
                                    <td><small style="color:#94a3b8;"><%=i+1%></small></td>
                                    <td><div class="dt-main"><%=new Date(s.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div></td>
                                    <td><strong style="font-size:.78rem;white-space:nowrap;"><%=s.subscriptionPlan%></strong></td>
                                    <td><span class="badge bs-purple"><%=s.period||'—'%></span></td>
                                    <td><span class="neu" style="font-weight:700;">₦<%=s.amount.toLocaleString()%></span></td>
                                    <td><%if(s.isLateFee&&s.lateFeeAmount){%><span class="neg" style="font-size:.73rem;">+₦<%=s.lateFeeAmount.toLocaleString()%></span><%}else{%><small style="color:#94a3b8;">—</small><%}%></td>
                                    <td><small class="dt-main"><%=s.dueDate?new Date(s.dueDate).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}):'—'%></small></td>
                                    <td><small class="dt-main"><%=s.paidDate?new Date(s.paidDate).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}):'—'%></small></td>
                                    <td><span class="badge bs-<%=s.status%>"><%=(s.status||'').toUpperCase()%></span></td>
                                    <td><%if(s.processedBy){%><span class="actor"><i class="fas fa-shield-alt"></i><%=s.processedBy.firstName%> <%=s.processedBy.lastName?.charAt(0)%>.</span><%}else{%><small style="color:#94a3b8;">—</small><%}%></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="4" style="text-align:right;">PAID TOTAL</td><td colspan="6"><span class="pos">₦<%=(reportData.subscriptions.totalPaid||0).toLocaleString()%></span></td></tr></tfoot>
                        </table></div>
                    </div>
                </div>
                <%}%>

                <!-- ADMIN ACTIONS -->
                <%if(reportData.adminActions){%>
                <div class="tab-pane" id="m-act">
                    <div class="tbl-card">
                        <div class="tbl-head"><div class="tbl-title"><i class="fas fa-history"></i>Admin Actions Log</div><span class="badge bs-purple"><%=reportData.adminActions.count%> events</span></div>
                        <div class="swipe-note" style="padding:.3rem .75rem;"><i class="fas fa-arrows-left-right"></i>Scroll</div>
                        <div class="tbl-scroll"><table class="tbl tbl-min-md">
                            <thead><tr><th>#</th><th>Date &amp; Time</th><th>Admin</th><th>Role</th><th>Action</th><th>Description</th><th>Status</th><th>IP</th></tr></thead>
                            <tbody>
                                <%if(!reportData.adminActions.records.length){%><tr><td colspan="8"><div class="empty-state"><i class="fas fa-history"></i><p>No admin actions found</p></div></td></tr><%}%>
                                <%reportData.adminActions.records.forEach((act,i)=>{%>
                                <tr>
                                    <td><small style="color:#94a3b8;"><%=i+1%></small></td>
                                    <td><div class="dt-main"><%=new Date(act.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div><div class="dt-sub"><%=new Date(act.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'})%></div></td>
                                    <td><%if(act.admin){%><div style="font-size:.78rem;font-weight:700;white-space:nowrap;"><%=act.admin.firstName%> <%=act.admin.lastName%></div><div style="font-size:.68rem;color:#64748b;"><%=act.admin.membershipID%></div><%}else{%><small style="color:#94a3b8;">System</small><%}%></td>
                                    <td><span class="actor"><i class="fas fa-shield-alt"></i><%=act.adminRole||'—'%></span></td>
                                    <td><span class="badge bs-purple" style="font-size:.65rem;text-transform:uppercase;"><%=(act.actionType||'').replace(/_/g,' ')%></span></td>
                                    <td style="max-width:150px;font-size:.76rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%=act.description%>"><%=act.description%></td>
                                    <td><span class="badge <%=act.status==='success'?'bs-approved':act.status==='failed'?'bs-rejected':'bs-pending'%>"><%=(act.status||'').toUpperCase()%></span></td>
                                    <td><code><%=act.ipAddress||'—'%></code></td>
                                </tr>
                                <%})%>
                            </tbody>
                        </table></div>
                    </div>
                </div>
                <%}%>

            </div><!-- /tab-body -->
        </div><!-- /report-tabs -->

        <%} else if(query&&query.membershipID&&!member){ %>
        <div class="center-card">
            <div class="center-icon" style="background:#fee2e2;"><i class="fas fa-user-slash" style="color:#dc2626;"></i></div>
            <h5 class="fw-bold mb-2" style="color:#1e293b;">Member Not Found</h5>
            <p style="color:#64748b;margin-bottom:4px;">No member found with ID: <strong><%=query.membershipID%></strong></p>
            <p style="color:#94a3b8;font-size:.85rem;">Check the membership ID and try again.</p>
        </div>
        <%} else {%>
        <div class="center-card">
            <div class="center-icon" style="background:linear-gradient(135deg,#e0e7ff,#dbeafe);"><i class="fas fa-user" style="color:var(--primary);"></i></div>
            <h5 class="fw-bold mb-2" style="color:#1e293b;">Generate a Member Report</h5>
            <p style="color:#64748b;margin-bottom:4px;">Enter a Membership ID above and click <strong>Generate</strong>.</p>
            <p style="color:#94a3b8;font-size:.82rem;">Filter by date range and report type for targeted results.</p>
        </div>
        <%}%>
    </div><!-- /modeMember -->

