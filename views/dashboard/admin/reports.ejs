<!-- TOP NAVBAR -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none" style="cursor:pointer;color:var(--primary);font-size:1.3rem;" onclick="toggleSidebar()"></i>
    <div class="navbar-title">
        <h5>Reports &amp; Statements</h5>
        <small class="d-none d-sm-block">Member &amp; Company financial reports</small>
    </div>
    <div class="d-flex gap-2 no-print">
        <button class="btn btn-outline btn-sm" onclick="printReport()"><i class="fas fa-print"></i><span class="d-none d-sm-inline ms-1">Print</span></button>
        <button class="btn btn-primary btn-sm" onclick="exportCSV()"><i class="fas fa-download"></i><span class="d-none d-sm-inline ms-1">CSV</span></button>
    </div>
</div>

<!-- MAIN -->
<div class="main-content">

    <!-- Mode Switcher -->
    <div class="mode-switcher no-print">
        <button class="mode-btn active" id="btnModeMember" onclick="switchMode('member')">
            <i class="fas fa-user"></i><span>Member Report</span>
        </button>
        <button class="mode-btn" id="btnModeCompany" onclick="switchMode('company')">
            <i class="fas fa-building"></i><span>Company Report</span>
        </button>
    </div>

    <!-- ═══════════ MEMBER MODE ═══════════ -->
    <div id="modeMember">
        <div class="page-header">
            <div class="d-flex align-items-center gap-3" style="position:relative;z-index:1;">
                <div style="width:42px;height:42px;background:rgba(255,255,255,.15);border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="fas fa-user" style="color:white;font-size:1.1rem;"></i>
                </div>
                <div>
                    <h4>Member Financial Report</h4>
                    <p>Search by Membership ID to generate a full financial statement</p>
                </div>
            </div>
        </div>

        <!-- Search Form -->
        <div class="search-card no-print">
            <form method="GET" action="/admin/reports" id="memberForm">
                <input type="hidden" name="mode" value="member">
                <div class="row g-2">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label">Membership ID</label>
                        <div class="search-icon-wrap">
                            <i class="fas fa-search"></i>
                            <input type="text" name="membershipID" class="form-control" placeholder="e.g. CDS001234" value="<%= query?.membershipID || '' %>" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-6 col-sm-3 col-lg-2">
                        <label class="form-label">From</label>
                        <input type="date" name="dateFrom" class="form-control" value="<%= query?.dateFrom || '' %>">
                    </div>
                    <div class="col-6 col-sm-3 col-lg-2">
                        <label class="form-label">To</label>
                        <input type="date" name="dateTo" class="form-control" value="<%= query?.dateTo || '' %>">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label">Report Type</label>
                        <select name="reportType" class="form-select">
                            <option value="all"          <%=(query?.reportType==='all'||!query?.reportType)?'selected':''%>>All Transactions</option>
                            <option value="deposits"     <%=query?.reportType==='deposits'?'selected':''%>>Deposits</option>
                            <option value="withdrawals"  <%=query?.reportType==='withdrawals'?'selected':''%>>Withdrawals</option>
                            <option value="loans"        <%=query?.reportType==='loans'?'selected':''%>>Loans</option>
                            <option value="roi"          <%=query?.reportType==='roi'?'selected':''%>>ROI</option>
                            <option value="extracharges" <%=query?.reportType==='extracharges'?'selected':''%>>Extra Charges</option>
                            <option value="subscriptions"<%=query?.reportType==='subscriptions'?'selected':''%>>Subscriptions</option>
                            <option value="admin_actions"<%=query?.reportType==='admin_actions'?'selected':''%>>Admin Log</option>
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1"><i class="fas fa-search me-1"></i>Generate</button>
                        <a href="/admin/reports" class="btn btn-outline d-flex align-items-center justify-content-center" style="min-width:42px;" title="Reset"><i class="fas fa-redo"></i></a>
                    </div>
                </div>
                <div class="preset-strip">
                    <span class="preset-label">Quick:</span>
                    <button type="button" class="preset-btn" onclick="setPreset('today')">Today</button>
                    <button type="button" class="preset-btn" onclick="setPreset('week')">Week</button>
                    <button type="button" class="preset-btn" onclick="setPreset('month')">Month</button>
                    <button type="button" class="preset-btn" onclick="setPreset('quarter')">Quarter</button>
                    <button type="button" class="preset-btn" onclick="setPreset('year')">Year</button>
                    <button type="button" class="preset-btn" onclick="setPreset('all')">All Time</button>
                </div>
            </form>
        </div>

        <!-- Results -->
        <% if (member && reportData) { %>

        <!-- Member Card -->
        <div class="member-card">
            <div class="d-flex align-items-start gap-3">
                <img src="<%=member.displayPicture||member.passportPhoto||`https://ui-avatars.com/api/?name=${encodeURIComponent(member.firstName+'+'+member.lastName)}&background=ffffff&color=1e3a8a&size=80`%>" alt="Avatar" class="m-avatar mt-1">
                <div style="flex:1;min-width:0;">
                    <div class="m-name"><%=member.firstName%> <%=member.lastName%></div>
                    <div class="d-flex flex-wrap gap-1 mb-1">
                        <span class="m-badge"><i class="fas fa-id-card me-1"></i><%=member.membershipID||'N/A'%></span>
                        <%if(member.role){%><span class="m-badge"><i class="fas fa-shield-alt me-1"></i><%=member.role.name?.toUpperCase()%></span><%}%>
                        <span class="m-badge" style="background:rgba(16,185,129,.2);border-color:rgba(16,185,129,.35);"><%=member.status?.toUpperCase()%></span>
                        <%if(member.account?.accountType){%><span class="m-badge"><%=member.account.accountType.shortCode%> · <%=member.account.accountType.interestRate%>%</span><%}%>
                    </div>
                    <div class="m-meta">
                        <span><i class="fas fa-envelope me-1"></i><%=member.email%></span>
                        <%if(member.phone){%><span><i class="fas fa-phone"></i><%=member.phone%></span><%}%>
                    </div>
                </div>
                <div class="m-balance-wrap d-none d-sm-block">
                    <div class="m-balance-label">Balance</div>
                    <div class="m-balance-value">₦<%=(member.account?.balance||0).toLocaleString()%></div>
                    <%if(query?.dateFrom||query?.dateTo){%><div style="font-size:.63rem;opacity:.6;margin-top:3px;"><%=query.dateFrom||'Start'%> → <%=query.dateTo||'Now'%></div><%}%>
                </div>
            </div>
            <div class="d-sm-none mt-2 pt-2" style="border-top:1px solid rgba(255,255,255,.15);">
                <span style="font-size:.72rem;opacity:.75;">Balance: </span><strong>₦<%=(member.account?.balance||0).toLocaleString()%></strong>
            </div>
        </div>

        <!-- Summary Bar -->
        <%if(reportData.summary){%>
        <div class="summary-bar">
            <div class="sum-grid">
                <div class="sum-item"><div class="sum-label"><i class="fas fa-arrow-down"></i> Deposits</div><div class="sum-value clr-pos">₦<%=(reportData.summary.totalDeposits||0).toLocaleString()%></div></div>
                <div class="sum-item"><div class="sum-label"><i class="fas fa-arrow-up"></i> Withdrawals</div><div class="sum-value clr-neg">₦<%=(reportData.summary.totalWithdrawals||0).toLocaleString()%></div></div>
                <div class="sum-item"><div class="sum-label"><i class="fas fa-chart-line"></i> ROI</div><div class="sum-value clr-pos">₦<%=(reportData.summary.totalROI||0).toLocaleString()%></div></div>
                <div class="sum-item"><div class="sum-label"><i class="fas fa-exclamation-circle"></i> Charges</div><div class="sum-value clr-neg">₦<%=(reportData.summary.totalCharges||0).toLocaleString()%></div></div>
                <div class="sum-item"><div class="sum-label"><i class="fas fa-landmark"></i> Loans Out</div><div class="sum-value clr-neg">₦<%=(reportData.summary.totalLoansOutstanding||0).toLocaleString()%></div></div>
                <div class="sum-item">
                    <div class="sum-label"><i class="fas fa-wallet"></i> Net Flow</div>
                    <div class="sum-value <%=(reportData.summary.netFlow||0)>=0?'clr-pos':'clr-neg'%>"><%=(reportData.summary.netFlow||0)<0?'-':''%>₦<%=Math.abs(reportData.summary.netFlow||0).toLocaleString()%></div>
                    <div class="sum-sub">Live: ₦<%=(reportData.summary.currentBalance||0).toLocaleString()%></div>
                </div>
            </div>
        </div>
        <%}%>

        <!-- Tabs -->
        <div class="report-tabs">
            <div class="tab-scroller">
                <div class="tab-nav" id="memberTabs">
                    <%if(reportData.deposits){%><button class="tab-link active" onclick="switchTab(this,'m-dep')"><i class="fas fa-coins"></i>Deposits<span class="tab-count"><%=reportData.deposits.count%></span></button><%}%>
                    <%if(reportData.withdrawals){%><button class="tab-link <%=!reportData.deposits?'active':''%>" onclick="switchTab(this,'m-wdr')"><i class="fas fa-money-check-alt"></i>Withdrawals<span class="tab-count"><%=reportData.withdrawals.count%></span></button><%}%>
                    <%if(reportData.loans){%><button class="tab-link" onclick="switchTab(this,'m-loan')"><i class="fas fa-hand-holding-usd"></i>Loans<span class="tab-count"><%=reportData.loans.count%></span></button><%}%>
                    <%if(reportData.roi){%><button class="tab-link" onclick="switchTab(this,'m-roi')"><i class="fas fa-chart-pie"></i>ROI<span class="tab-count"><%=reportData.roi.count%></span></button><%}%>
                    <%if(reportData.extraCharges){%><button class="tab-link" onclick="switchTab(this,'m-chg')"><i class="fas fa-exclamation-triangle"></i>Charges<span class="tab-count"><%=reportData.extraCharges.count%></span></button><%}%>
                    <%if(reportData.subscriptions){%><button class="tab-link" onclick="switchTab(this,'m-sub')"><i class="fas fa-cube"></i>Subscriptions<span class="tab-count"><%=reportData.subscriptions.count%></span></button><%}%>
                    <%if(reportData.adminActions){%><button class="tab-link" onclick="switchTab(this,'m-act')"><i class="fas fa-history"></i>Admin Log<span class="tab-count"><%=reportData.adminActions.count%></span></button><%}%>
                </div>
            </div>
            <div class="tab-body">

                <!-- DEPOSITS -->
                <%if(reportData.deposits){%>
                <div class="tab-pane active" id="m-dep">
                    <div class="mini-grid">
                        <div class="mini-stat"><div class="mini-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-arrow-down"></i></div><div class="mini-body"><div class="mini-label">Total</div><div class="mini-value">₦<%=(reportData.deposits.totalAmount||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-check"></i></div><div class="mini-body"><div class="mini-label">Approved</div><div class="mini-value">₦<%=(reportData.deposits.totalApproved||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-clock"></i></div><div class="mini-body"><div class="mini-label">Pending</div><div class="mini-value">₦<%=(reportData.deposits.totalPending||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#dbeafe;color:#1e3a8a;"><i class="fas fa-receipt"></i></div><div class="mini-body"><div class="mini-label">Count</div><div class="mini-value"><%=reportData.deposits.count%></div></div></div>
                    </div>
                    <div class="tbl-card">
                        <div class="tbl-head"><div class="tbl-title"><i class="fas fa-coins"></i>Deposit Transactions</div><div class="swipe-note"><i class="fas fa-arrows-left-right"></i>Scroll</div></div>
                        <div class="tbl-scroll"><table class="tbl tbl-min-md">
                            <thead><tr><th>#</th><th>Date</th><th>Ref</th><th>Type</th><th>Amount</th><th>Bal Before</th><th>Bal After</th><th>Status</th><th>By</th></tr></thead>
                            <tbody>
                                <%if(!reportData.deposits.records.length){%><tr><td colspan="9"><div class="empty-state"><i class="fas fa-coins"></i><p>No deposit records</p></div></td></tr><%}%>
                                <%reportData.deposits.records.forEach((dep,i)=>{%>
                                <tr>
                                    <td><small style="color:#94a3b8;"><%=i+1%></small></td>
                                    <td><div class="dt-main"><%=new Date(dep.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div><div class="dt-sub"><%=new Date(dep.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'})%></div></td>
                                    <td><code><%=dep.reference||'—'%></code></td>
                                    <td><span class="badge bs-purple" style="text-transform:capitalize;"><%=(dep.type||'').replace(/_/g,' ')%></span></td>
                                    <td><span class="pos">+₦<%=dep.amount.toLocaleString()%></span></td>
                                    <td><span class="neu">₦<%=(dep.balanceBefore||0).toLocaleString()%></span></td>
                                    <td><span class="neu">₦<%=(dep.balanceAfter||0).toLocaleString()%></span></td>
                                    <td><span class="badge bs-<%=dep.status%>"><%=(dep.status||'').toUpperCase()%></span></td>
                                    <td><%if(dep.processedBy){%><span class="actor"><i class="fas fa-shield-alt"></i><%=dep.processedBy.firstName%> <%=dep.processedBy.lastName?.charAt(0)%>.</span><%}else{%><small style="color:#94a3b8;">—</small><%}%></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="4" style="text-align:right;">APPROVED TOTAL</td><td colspan="5"><span class="pos">₦<%=(reportData.deposits.totalApproved||0).toLocaleString()%></span></td></tr></tfoot>
                        </table></div>
                    </div>
                </div>
                <%}%>

                <!-- WITHDRAWALS -->
                <%if(reportData.withdrawals){%>
                <div class="tab-pane <%=!reportData.deposits?'active':''%>" id="m-wdr">
                    <div class="mini-grid">
                        <div class="mini-stat"><div class="mini-icon" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-arrow-up"></i></div><div class="mini-body"><div class="mini-label">Total</div><div class="mini-value">₦<%=(reportData.withdrawals.totalAmount||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-check"></i></div><div class="mini-body"><div class="mini-label">Completed</div><div class="mini-value">₦<%=(reportData.withdrawals.totalCompleted||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-tags"></i></div><div class="mini-body"><div class="mini-label">Fees</div><div class="mini-value">₦<%=(reportData.withdrawals.totalFees||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#dbeafe;color:#1e3a8a;"><i class="fas fa-receipt"></i></div><div class="mini-body"><div class="mini-label">Count</div><div class="mini-value"><%=reportData.withdrawals.count%></div></div></div>
                    </div>
                    <div class="tbl-card">
                        <div class="tbl-head"><div class="tbl-title"><i class="fas fa-money-check-alt"></i>Withdrawals</div><div class="swipe-note"><i class="fas fa-arrows-left-right"></i>Scroll</div></div>
                        <div class="tbl-scroll"><table class="tbl tbl-min-lg">
                            <thead><tr><th>#</th><th>Date</th><th>Ref</th><th>Amount</th><th>Fee</th><th>Net</th><th>Bal Before</th><th>Bal After</th><th>Bank</th><th>Status</th><th>By</th></tr></thead>
                            <tbody>
                                <%if(!reportData.withdrawals.records.length){%><tr><td colspan="11"><div class="empty-state"><i class="fas fa-money-check-alt"></i><p>No withdrawal records</p></div></td></tr><%}%>
                                <%reportData.withdrawals.records.forEach((w,i)=>{%>
                                <tr>
                                    <td><small style="color:#94a3b8;"><%=i+1%></small></td>
                                    <td><div class="dt-main"><%=new Date(w.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div><div class="dt-sub"><%=new Date(w.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'})%></div></td>
                                    <td><code><%=w.reference||'—'%></code></td>
                                    <td><span class="neg">-₦<%=w.amount.toLocaleString()%></span></td>
                                    <td><span class="neu">₦<%=(w.fee||0).toLocaleString()%></span></td>
                                    <td><span class="neu">₦<%=(w.netAmount||0).toLocaleString()%></span></td>
                                    <td><span class="neu">₦<%=(w.balanceBefore||0).toLocaleString()%></span></td>
                                    <td><span class="neu">₦<%=(w.balanceAfter||0).toLocaleString()%></span></td>
                                    <td><%if(w.bankDetails?.bankName){%><div style="font-size:.73rem;font-weight:700;"><%=w.bankDetails.bankName%></div><div style="font-size:.68rem;color:#64748b;"><%=w.bankDetails.accountNumber%></div><%}else{%><small style="color:#94a3b8;">—</small><%}%></td>
                                    <td><span class="badge bs-<%=w.status%>"><%=(w.status||'').toUpperCase()%></span></td>
                                    <td><%if(w.approvedBy){%><span class="actor"><i class="fas fa-shield-alt"></i><%=w.approvedBy.firstName%> <%=w.approvedBy.lastName?.charAt(0)%>.</span><%}else{%><small style="color:#94a3b8;">—</small><%}%></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="3" style="text-align:right;">COMPLETED TOTAL</td><td colspan="8"><span class="neg">₦<%=(reportData.withdrawals.totalCompleted||0).toLocaleString()%></span></td></tr></tfoot>
                        </table></div>
                    </div>
                </div>
                <%}%>

                <!-- LOANS -->
                <%if(reportData.loans){%>
                <div class="tab-pane" id="m-loan">
                    <div class="mini-grid">
