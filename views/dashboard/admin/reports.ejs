<div class="powered-by no-print">Powered by <strong>JESZ LIMITED</strong></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('active');
    document.getElementById('sidebarOverlay').classList.toggle('active');
}
function closeSidebar() {
    document.getElementById('sidebar').classList.remove('active');
    document.getElementById('sidebarOverlay').classList.remove('active');
}
function switchMode(mode) {
    document.getElementById('modeMember').style.display  = mode === 'member'  ? '' : 'none';
    document.getElementById('modeCompany').style.display = mode === 'company' ? '' : 'none';
    document.getElementById('btnModeMember').classList.toggle('active',  mode === 'member');
    document.getElementById('btnModeCompany').classList.toggle('active', mode === 'company');
    sessionStorage.setItem('reportMode', mode);
}
function switchTab(btn, targetId) {
    const container = btn.closest('.report-tabs');
    container.querySelectorAll('.tab-link').forEach(b => b.classList.remove('active'));
    container.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    const pane = document.getElementById(targetId);
    if (pane) pane.classList.add('active');
}
function setPreset(p) {
    const today = new Date(), fmt = d => d.toISOString().slice(0,10);
    let from, to = fmt(today);
    if (p==='today')   { from = to; }
    else if (p==='week')    { const d=new Date(today); d.setDate(d.getDate()-d.getDay()); from=fmt(d); }
    else if (p==='month')   { from=fmt(new Date(today.getFullYear(),today.getMonth(),1)); }
    else if (p==='quarter') { const q=Math.floor(today.getMonth()/3); from=fmt(new Date(today.getFullYear(),q*3,1)); }
    else if (p==='year')    { from=fmt(new Date(today.getFullYear(),0,1)); }
    else                    { from=''; to=''; }
    document.querySelector('[name="dateFrom"]').value = from;
    document.querySelector('[name="dateTo"]').value   = to;
}
function setCompanyPreset(p) {
    const today = new Date(), fmt = d => d.toISOString().slice(0,10);
    let from, to = fmt(today);
    if (p==='today')   { from = to; }
    else if (p==='week')    { const d=new Date(today); d.setDate(d.getDate()-d.getDay()); from=fmt(d); }
    else if (p==='month')   { from=fmt(new Date(today.getFullYear(),today.getMonth(),1)); }
    else if (p==='quarter') { const q=Math.floor(today.getMonth()/3); from=fmt(new Date(today.getFullYear(),q*3,1)); }
    else if (p==='year')    { from=fmt(new Date(today.getFullYear(),0,1)); }
    else                    { from=''; to=''; }
    const fromEl = document.querySelector('[name="companyFrom"]');
    const toEl   = document.querySelector('[name="companyTo"]');
    if (fromEl) fromEl.value = from;
    if (toEl)   toEl.value   = to;
}
function printReport() {
    document.querySelectorAll('.tab-pane').forEach(p=>{p.style.display='block';});
    window.print();
    setTimeout(()=>{document.querySelectorAll('.tab-pane').forEach(p=>{p.style.display='';});}, 1000);
}
function exportCSV() {
    const mode    = document.getElementById('modeCompany').style.display !== 'none' ? 'company' : 'member';
    const section = mode === 'company' ? document.getElementById('modeCompany') : document.getElementById('modeMember');
    const active  = section.querySelector('.tab-pane.active');
    if (!active) return alert('No active report tab to export.');
    const table   = active.querySelector('table');
    if (!table)   return alert('No table in current tab.');
    let csv = '';
    table.querySelectorAll('tr').forEach(row => {
        const cells = [...row.querySelectorAll('th,td')].map(c =>
            '"' + (c.innerText||c.textContent).replace(/"/g,'""').replace(/\n/g,' ').trim() + '"'
        );
        csv += cells.join(',') + '\n';
    });
    const suffix = mode === 'member'
        ? (document.querySelector('[name="membershipID"]')?.value || 'member')
        : 'company';
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
    a.download = `report_${suffix}_${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
}
async function loadSidebarPendingCount() {
    try {
        const data = await fetch('/admin/pending-approvals-count').then(r=>r.json());
        const badge = document.getElementById('sidebarPendingBadge');
        if (!badge) return;
        badge.style.display = data.count > 0 ? 'inline-block' : 'none';
        badge.textContent   = data.count;
    } catch(e) {}
}
document.addEventListener('DOMContentLoaded', () => {
    loadSidebarPendingCount();
    const saved = sessionStorage.getItem('reportMode');
    const params = new URLSearchParams(window.location.search);
    const mode = params.get('mode') || saved || 'member';
    switchMode(mode);
});
