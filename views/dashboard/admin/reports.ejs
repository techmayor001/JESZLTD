<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-light: #3b82f6;
            --sidebar-width: 280px;
            --navbar-h: 70px;
        }
        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; z-index: 1040; transition: transform .3s ease;
            overflow-y: auto; box-shadow: 4px 0 20px rgba(30,58,138,.15);
        }
        .sidebar-header { padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.1); }
        .logo-container { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .logo-box { width: 45px; height: 45px; background: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--primary); font-size: 1.5rem; flex-shrink: 0; }
        .admin-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; background: rgba(239,68,68,.2); border-radius: 20px; border: 1px solid rgba(239,68,68,.3); font-weight: 600; font-size: .78rem; margin-top: 6px; }
        .sidebar-menu { padding: 1rem 0; }
        .sidebar-menu a { color: rgba(255,255,255,.85); text-decoration: none; padding: .75rem 1.5rem; display: flex; align-items: center; transition: all .2s; border-left: 3px solid transparent; font-weight: 500; font-size: .9rem; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(255,255,255,.12); color: white; border-left-color: white; }
        .sidebar-menu a i { width: 22px; margin-right: 10px; font-size: 1rem; flex-shrink: 0; }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }

        /* ── NAVBAR ── */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: var(--navbar-h);
            background: rgba(255,255,255,.97); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.25rem; gap: .75rem;
            transition: left .3s; border-bottom: 1px solid rgba(30,58,138,.1);
        }
        .navbar-title { flex-grow: 1; min-width: 0; }
        .navbar-title h5 { margin: 0; font-size: 1rem; color: var(--primary); font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .navbar-title small { font-size: .75rem; color: #64748b; }
        .navbar-actions { display: flex; gap: .5rem; flex-shrink: 0; }

        /* ── MAIN ── */
        .main-content { margin-left: var(--sidebar-width); margin-top: var(--navbar-h); padding: 1.25rem; min-height: calc(100vh - var(--navbar-h)); transition: margin-left .3s; }

        /* ── BUTTONS ── */
        .btn { border-radius: 9px; font-weight: 600; transition: all .2s; white-space: nowrap; }
        .btn-primary { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); border: none; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(30,58,138,.3); }
        .btn-outline-primary { border: 2px solid var(--primary); color: var(--primary); background: transparent; }
        .btn-outline-primary:hover { background: var(--primary); color: white; }
        .btn-sm { padding: .35rem .8rem; font-size: .8rem; }
        .btn-xs { padding: .25rem .6rem; font-size: .75rem; border-radius: 7px; font-weight: 600; border: 1.5px solid var(--primary); color: var(--primary); background: transparent; }
        .btn-xs:hover { background: var(--primary); color: white; }

        /* ── CARDS ── */
        .card-white { background: white; border-radius: 16px; box-shadow: 0 4px 16px rgba(30,58,138,.08); border: 1px solid rgba(30,58,138,.05); }
        .page-header { background: white; border-radius: 16px; padding: 1.25rem 1.5rem; margin-bottom: 1.25rem; box-shadow: 0 4px 16px rgba(30,58,138,.08); }
        .search-card { background: white; border-radius: 16px; padding: 1.25rem; margin-bottom: 1.25rem; box-shadow: 0 4px 16px rgba(30,58,138,.08); border: 2px solid rgba(30,58,138,.06); }

        /* ── FORM ── */
        .form-label { font-weight: 600; color: var(--primary); font-size: .8rem; margin-bottom: .3rem; }
        .form-control, .form-select { border-radius: 9px; border: 2px solid rgba(30,58,138,.12); padding: .5rem .8rem; font-size: .88rem; }
        .form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(30,58,138,.1); }
        .search-wrap { position: relative; }
        .search-wrap i { position: absolute; left: .85rem; top: 50%; transform: translateY(-50%); color: var(--primary); font-size: .9rem; }
        .search-wrap input { padding-left: 2.5rem; }

        /* ── PRESETS ── */
        .preset-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .75rem; align-items: center; }
        .preset-label { font-size: .75rem; color: #94a3b8; font-weight: 600; }

        /* ── MEMBER CARD ── */
        .member-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border-radius: 16px; padding: 1.25rem; color: white;
            margin-bottom: 1.25rem; box-shadow: 0 8px 24px rgba(30,58,138,.25);
            position: relative; overflow: hidden;
        }
        .member-card::after { content:''; position:absolute; right:-30px; top:-30px; width:160px; height:160px; border-radius:50%; background:rgba(255,255,255,.06); pointer-events:none; }
        .member-avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 2.5px solid rgba(255,255,255,.4); flex-shrink: 0; }
        .member-name { font-size: 1.05rem; font-weight: 700; margin: 0 0 4px; line-height: 1.2; }
        .mem-badge { display: inline-block; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.3); border-radius: 6px; padding: 2px 8px; font-size: .72rem; font-weight: 700; }
        .member-meta { display: flex; flex-wrap: wrap; gap: .5rem .75rem; font-size: .78rem; opacity: .9; margin-top: .35rem; }
        .member-meta span { display: flex; align-items: center; gap: 4px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; }
        .member-balance { text-align: right; flex-shrink: 0; }
        .balance-label { font-size: .7rem; opacity: .75; text-transform: uppercase; letter-spacing: .5px; }
        .balance-value { font-size: 1.5rem; font-weight: 800; line-height: 1.1; }

        /* ── SUMMARY BAR ── */
        .summary-bar {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            border-radius: 14px; color: white; margin-bottom: 1.25rem;
            box-shadow: 0 6px 20px rgba(30,58,138,.22); overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .sum-grid { display: flex; min-width: 480px; }
        .sum-item { flex: 1; padding: .9rem .6rem; text-align: center; border-right: 1px solid rgba(255,255,255,.12); }
        .sum-item:last-child { border-right: none; }
        .sum-label { font-size: .68rem; opacity: .78; text-transform: uppercase; letter-spacing: .4px; white-space: nowrap; }
        .sum-value { font-size: 1rem; font-weight: 800; margin-top: 3px; white-space: nowrap; }
        .sum-sub { font-size: .63rem; opacity: .6; margin-top: 2px; }
        .positive { color: #6ee7b7; }
        .negative { color: #fca5a5; }

        /* ── STAT MINI CARDS ── */
        .stat-mini { background: white; border-radius: 12px; padding: .9rem; box-shadow: 0 3px 10px rgba(30,58,138,.07); border: 1px solid rgba(30,58,138,.05); height: 100%; overflow: hidden; }
        .stat-mini > .d-flex { min-width: 0; }
        .stat-mini .s-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
        .stat-mini .s-label { font-size: .7rem; color: #94a3b8; font-weight: 600; margin-bottom: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .stat-mini .s-value { font-size: .95rem; font-weight: 700; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }

        /* ── STAT MINI overflow guard ── */
        .stat-mini > .d-flex > div { min-width: 0; }

        /* ── TABS ── */
        .report-tabs { background: white; border-radius: 14px; overflow: hidden; margin-bottom: 1.25rem; box-shadow: 0 4px 14px rgba(30,58,138,.08); }
        .tab-nav-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; background: rgba(30,58,138,.03); border-bottom: 2px solid rgba(30,58,138,.08); scrollbar-width: none; }
        .tab-nav-wrap::-webkit-scrollbar { display: none; }
        .tab-nav { display: flex; padding: .6rem .75rem .4rem; gap: .25rem; white-space: nowrap; border: none; flex-wrap: nowrap; min-width: max-content; }
        .tab-nav .nav-link { border: none; border-radius: 8px; padding: .4rem .85rem; color: #64748b; font-weight: 600; font-size: .8rem; transition: all .2s; white-space: nowrap; display: flex; align-items: center; gap: 5px; }
        .tab-nav .nav-link:hover { background: rgba(30,58,138,.08); color: var(--primary); }
        .tab-nav .nav-link.active { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white; box-shadow: 0 3px 10px rgba(30,58,138,.25); }
        .tab-nav .nav-link .tab-count { font-size: .68rem; padding: 1px 5px; border-radius: 10px; font-weight: 700; }
        .tab-nav .nav-link.active .tab-count { background: rgba(255,255,255,.25); color: white; }
        .tab-nav .nav-link:not(.active) .tab-count { background: rgba(30,58,138,.1); color: var(--primary); }
        .tab-content-wrap { padding: 1.1rem; }

        /* ── TABLE ── */
        .tbl-card { background: white; border-radius: 12px; overflow: hidden; border: 1px solid rgba(30,58,138,.07); margin-top: .75rem; }
        .tbl-head { padding: .75rem 1rem; border-bottom: 2px solid rgba(30,58,138,.07); background: rgba(30,58,138,.02); display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; }
        .tbl-head-title { font-weight: 700; color: var(--primary); font-size: .88rem; display: flex; align-items: center; gap: 6px; }
        .swipe-hint { display: none; align-items: center; gap: 5px; padding: .25rem .75rem; background: rgba(30,58,138,.04); font-size: .72rem; color: var(--primary); font-weight: 600; }
        .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: rgba(30,58,138,.2) transparent; }
        .table-scroll::-webkit-scrollbar { height: 3px; }
        .table-scroll::-webkit-scrollbar-thumb { background: rgba(30,58,138,.2); border-radius: 3px; }
        .tbl { margin: 0; width: 100%; font-size: .82rem; }
        .tbl thead tr { background: rgba(30,58,138,.04); }
        .tbl thead th { padding: .65rem .8rem; font-weight: 700; color: var(--primary); white-space: nowrap; font-size: .73rem; text-transform: uppercase; letter-spacing: .3px; border: none; }
        .tbl tbody td { padding: .65rem .8rem; vertical-align: middle; border-color: rgba(30,58,138,.05); }
        .tbl tbody tr:hover { background: rgba(59,130,246,.03); }
        .tbl tfoot td { padding: .65rem .8rem; font-weight: 700; border-top: 2px solid rgba(30,58,138,.1); background: rgba(30,58,138,.03); font-size: .82rem; }
        .tbl-min { min-width: 520px; }
        .tbl-min-md { min-width: 700px; }
        .tbl-min-lg { min-width: 860px; }
        .cell-date-main { font-size: .82rem; font-weight: 600; white-space: nowrap; }
        .cell-date-sub { font-size: .7rem; color: #94a3b8; white-space: nowrap; }
        .cell-amount-pos { font-weight: 700; color: #059669; white-space: nowrap; }
        .cell-amount-neg { font-weight: 700; color: #dc2626; white-space: nowrap; }
        .cell-amount-neu { font-size: .8rem; white-space: nowrap; }

        /* ── BADGES ── */
        .badge { padding: .3rem .65rem; border-radius: 7px; font-weight: 600; font-size: .7rem; white-space: nowrap; }
        .bs-active, .bs-approved, .bs-paid, .bs-confirmed { background: #d1fae5; color: #065f46; }
        .bs-pending { background: #fef3c7; color: #92400e; }
        .bs-rejected, .bs-defaulted, .bs-overdue { background: #fee2e2; color: #7f1d1d; }
        .bs-completed, .bs-active-loan { background: #dbeafe; color: #1e3a8a; }
        .bs-reversed { background: #f3f4f6; color: #374151; }
        .bs-waived { background: #e0e7ff; color: #3730a3; }
        .bs-processing { background: #fdf4ff; color: #7e22ce; }
        .bs-purple { background: #e0e7ff; color: #3730a3; }
        .bs-teal { background: #ccfbf1; color: #0f766e; }

        /* ── ACTOR PILL ── */
        .actor-pill { display: inline-flex; align-items: center; gap: 4px; background: rgba(30,58,138,.07); border-radius: 20px; padding: 2px 8px; font-size: .72rem; font-weight: 600; color: var(--primary); white-space: nowrap; max-width: 130px; overflow: hidden; text-overflow: clip; vertical-align: middle; }

        /* ── GUARANTOR LIST ── */
        .g-list { list-style: none; padding: 0; margin: 0; }
        .g-list li { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; padding: 5px 0; border-bottom: 1px solid rgba(30,58,138,.05); font-size: .8rem; }
        .g-list li:last-child { border: none; }

        /* ── LOAN CARD ── */
        .loan-card { background: white; border-radius: 12px; border: 1px solid rgba(30,58,138,.08); margin-bottom: .75rem; overflow: hidden; }
        .loan-card-hdr { padding: .75rem 1rem; background: rgba(30,58,138,.03); border-bottom: 1px solid rgba(30,58,138,.07); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .4rem; }
        .loan-card-hdr-title { font-weight: 700; color: var(--primary); font-size: .88rem; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .loan-card-body { padding: .9rem 1rem; }
        .loan-kv { font-size: .7rem; color: #94a3b8; text-transform: uppercase; font-weight: 700; margin-bottom: 2px; }
        .loan-kv-val { font-weight: 700; font-size: .88rem; color: #1e293b; word-break: break-word; overflow-wrap: break-word; }
        .approver-bar { display: flex; align-items: flex-start; gap: 8px; background: rgba(30,58,138,.04); border-radius: 8px; padding: .6rem .75rem; border-left: 3px solid var(--primary); margin-bottom: .75rem; font-size: .8rem; flex-wrap: wrap; }

        /* ── ROI BANNER ── */
        .roi-banner { border-radius: 10px; padding: .75rem 1rem; margin-bottom: .75rem; display: flex; align-items: flex-start; gap: .65rem; font-size: .82rem; }

        /* ── EMPTY STATE ── */
        .empty-state { padding: 2.5rem 1rem; text-align: center; color: #94a3b8; }
        .empty-state i { font-size: 2.5rem; margin-bottom: .75rem; opacity: .35; display: block; }
        .empty-state p { margin: 0; font-size: .88rem; }

        /* ── WELCOME / 404 CARDS ── */
        .center-card { background: white; border-radius: 16px; padding: 2.5rem 1.5rem; text-align: center; box-shadow: 0 6px 18px rgba(30,58,138,.08); }
        .center-icon { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 1.8rem; }

        /* ── PRINT ── */
        @media print {
            .sidebar, .top-navbar, .search-card, .no-print { display: none !important; }
            .main-content { margin: 0 !important; padding: 0 !important; }
            .tab-nav-wrap { display: none; }
            .tab-pane { display: block !important; opacity: 1 !important; margin-bottom: 1.5rem; }
            .tbl { min-width: unset !important; font-size: .75rem; }
        }

        /* ── TABLET (<=992px) — sidebar off-canvas ── */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0 !important; }
            .main-content { margin-left: 0 !important; }
            .swipe-hint { display: flex; }
        }

        /* ── TABLET PORTRAIT (<=768px) ── */
        @media (max-width: 768px) {
            :root { --navbar-h: 58px; }
            .top-navbar { height: 58px; padding: 0 .9rem; gap: .5rem; }
            .main-content { padding: .9rem; }
            .page-header { padding: .9rem 1rem; margin-bottom: 1rem; }
            .search-card { padding: 1rem; margin-bottom: 1rem; }
            .member-card { padding: 1rem; margin-bottom: 1rem; }
            .member-name { font-size: .95rem; }
            .balance-value { font-size: 1.2rem; }
            .tab-content-wrap { padding: .9rem; }
            .stat-mini .s-icon { width: 34px; height: 34px; font-size: .9rem; }
            .stat-mini .s-value { font-size: .88rem; }
            .stat-mini .s-label { font-size: .67rem; }
            .loan-kv-val { font-size: .82rem; white-space: normal; word-break: break-word; }
        }

        /* ── MOBILE (<=576px) ── */
        @media (max-width: 576px) {
            :root { --navbar-h: 54px; }
            .top-navbar { height: 54px; padding: 0 .75rem; gap: .4rem; }
            .btn-sm { padding: .38rem .7rem; font-size: .78rem; }
            .main-content { padding: .75rem; }
            .page-header { padding: .75rem; border-radius: 12px; margin-bottom: .75rem; }
            .page-header h5 { font-size: .9rem !important; }
            .page-header p { font-size: .72rem !important; }
            .search-card { padding: .75rem; border-radius: 12px; margin-bottom: .75rem; }
            .form-label { font-size: .75rem; margin-bottom: .2rem; }
            .form-control, .form-select { padding: .45rem .7rem; font-size: .82rem; border-radius: 8px; }
            .preset-row { gap: .3rem; margin-top: .6rem; }
            .btn-xs { padding: .22rem .55rem; font-size: .7rem; }
            .member-card { padding: .85rem; border-radius: 12px; margin-bottom: .75rem; }
            .member-avatar { width: 42px; height: 42px; }
            .member-name { font-size: .88rem; }
            .mem-badge { font-size: .67rem; padding: 2px 6px; }
            .member-meta { font-size: .72rem; gap: .3rem .5rem; }
            .member-meta span { max-width: 100%; }
            .balance-value { font-size: 1rem; }
            .summary-bar { border-radius: 12px; margin-bottom: .75rem; }
            .sum-item { padding: .65rem .45rem; }
            .sum-label { font-size: .6rem; letter-spacing: 0; }
            .sum-value { font-size: .82rem; margin-top: 2px; }
            .sum-sub { font-size: .58rem; }
            .tab-nav { padding: .45rem .5rem .3rem; gap: .2rem; }
            .tab-nav .nav-link { padding: .35rem .6rem; font-size: .73rem; gap: 3px; border-radius: 7px; }
            .tab-nav .nav-link i { font-size: .72rem; }
            .tab-nav .nav-link .tab-count { font-size: .62rem; padding: 0 4px; }
            .tab-content-wrap { padding: .75rem; }
            .stat-mini { padding: .65rem .6rem; }
            .stat-mini .s-icon { width: 30px; height: 30px; font-size: .82rem; }
            .stat-mini .s-value { font-size: .82rem; }
            .stat-mini .s-label { font-size: .64rem; }
            .tbl-head { padding: .55rem .75rem; }
            .tbl-head-title { font-size: .82rem; }
            .tbl thead th { padding: .45rem .55rem; font-size: .65rem; }
            .tbl tbody td { padding: .45rem .55rem; font-size: .78rem; }
            .tbl tfoot td { padding: .45rem .55rem; font-size: .78rem; }
            .cell-date-main { font-size: .76rem; }
            .cell-date-sub { font-size: .65rem; }
            .cell-amount-pos, .cell-amount-neg { font-size: .8rem; }
            .cell-amount-neu { font-size: .74rem; }
            .badge { padding: .25rem .5rem; font-size: .64rem; border-radius: 5px; }
            .actor-pill { font-size: .65rem; padding: 2px 6px; max-width: 110px; }
            code { font-size: .68rem !important; }
            .loan-card-hdr { padding: .6rem .75rem; }
            .loan-card-hdr-title { font-size: .8rem; }
            .loan-card-body { padding: .7rem .75rem; }
            .loan-kv { font-size: .64rem; }
            .loan-kv-val { font-size: .8rem; white-space: normal; word-break: break-word; }
            .approver-bar { padding: .5rem .6rem; font-size: .75rem; }
            .g-list li { font-size: .74rem; }
            .roi-banner { padding: .65rem .75rem; font-size: .76rem; }
            .center-card { padding: 1.75rem 1rem; }
            .center-icon { width: 58px; height: 58px; font-size: 1.4rem; margin-bottom: 1rem; }
        }

        /* ── VERY SMALL (<=380px) ── */
        @media (max-width: 380px) {
            .main-content { padding: .6rem; }
            .tab-nav .nav-link { padding: .3rem .5rem; font-size: .68rem; }
            .tab-nav .nav-link i { display: none; }
            .sum-label { font-size: .56rem; }
            .sum-value { font-size: .76rem; }
            .stat-mini .s-value { font-size: .76rem; }
            .loan-kv-val { font-size: .76rem; }
        }
    </style>
</head>
<body>

<!-- ── SIDEBAR ── -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-container">
            <div class="logo-box">C</div>
            <div>
                <div class="fw-bold" style="text-transform:uppercase;font-size:1rem;line-height:1.2;">Club De Stars</div>
                <small class="opacity-75" style="font-size:.72rem;">ADMIN PANEL</small>
            </div>
        </div>
