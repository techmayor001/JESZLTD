                                <div class="col-6 col-md-2"><div class="loan-kv">Total Due</div><div class="loan-val">₦<%=(loan.totalRepayable||0).toLocaleString()%></div></div>
                                <div class="col-6 col-md-2"><div class="loan-kv">Monthly</div><div class="loan-val">₦<%=(loan.monthlyInstalment||0).toLocaleString()%></div></div>
                                <div class="col-6 col-md-2"><div class="loan-kv">Repaid</div><div class="loan-val" style="color:#059669;">₦<%=(loan.amountRepaid||0).toLocaleString()%></div></div>
                                <div class="col-6 col-md-2"><div class="loan-kv">Outstanding</div><div class="loan-val" style="color:#dc2626;">₦<%=(loan.outstandingBalance||0).toLocaleString()%></div></div>
                            </div>
                            <%if(loan.guarantors&&loan.guarantors.length){%>
