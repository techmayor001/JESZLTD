<!-- ── TOP NAVBAR ── -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none" style="cursor:pointer;color:var(--primary);font-size:1.3rem;" onclick="toggleSidebar()"></i>
    <div class="navbar-title d-none d-md-block">
        <h5>Reports &amp; Statements</h5>
        <small>Generate member financial reports</small>
    </div>
    <div class="d-md-none fw-bold" style="color:var(--primary);font-size:.9rem;flex-grow:1;margin-left:.5rem;">Reports</div>
    <div class="navbar-actions no-print">
        <button class="btn btn-outline-primary btn-sm" onclick="printReport()" title="Print">
            <i class="fas fa-print"></i><span class="d-none d-sm-inline ms-1">Print</span>
        </button>
        <button class="btn btn-primary btn-sm" onclick="exportCSV()" title="Export CSV">
            <i class="fas fa-download"></i><span class="d-none d-sm-inline ms-1">CSV</span>
        </button>
    </div>
</div>

<div id="sidebarOverlay" class="sidebar-overlay" onclick="closeSidebar()"></div>

<!-- ── MAIN CONTENT ── -->
<div class="main-content">

    <!-- Page Header -->
    <div class="page-header no-print">
        <div class="d-flex align-items-center gap-3">
            <div style="width:44px;height:44px;background:linear-gradient(135deg,#1e3a8a,#3b82f6);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-file-alt" style="color:white;font-size:1.15rem;"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold" style="color:var(--primary);font-size:1rem;">Member Reports</h5>
                <p class="text-muted mb-0" style="font-size:.78rem;">Search by Membership ID to generate a full financial statement</p>
            </div>
        </div>
    </div>

    <!-- Search Form -->
    <div class="search-card no-print">
        <form method="GET" action="/admin/reports" id="reportForm">
            <div class="row g-2 align-items-end gy-2">
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label">Membership ID</label>
                    <div class="search-wrap">
                        <i class="fas fa-search"></i>
                        <input type="text" name="membershipID" class="form-control"
                               placeholder="e.g. CDS001234"
                               value="<%= query?.membershipID || '' %>"
                               autocomplete="off">
                    </div>
                </div>
                <div class="col-6 col-sm-3 col-lg-2">
                    <label class="form-label">From</label>
                    <input type="date" name="dateFrom" class="form-control" value="<%= query?.dateFrom || '' %>">
                </div>
                <div class="col-6 col-sm-3 col-lg-2">
                    <label class="form-label">To</label>
                    <input type="date" name="dateTo" class="form-control" value="<%= query?.dateTo || '' %>">
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label">Report Type</label>
                    <select name="reportType" class="form-select">
                        <option value="all"          <%=(query?.reportType==='all'||!query?.reportType)?'selected':''%>>All Transactions</option>
                        <option value="deposits"     <%=query?.reportType==='deposits'?'selected':''%>>Deposits</option>
                        <option value="withdrawals"  <%=query?.reportType==='withdrawals'?'selected':''%>>Withdrawals</option>
                        <option value="loans"        <%=query?.reportType==='loans'?'selected':''%>>Loans</option>
                        <option value="roi"          <%=query?.reportType==='roi'?'selected':''%>>ROI</option>
                        <option value="extracharges" <%=query?.reportType==='extracharges'?'selected':''%>>Extra Charges</option>
                        <option value="subscriptions"<%=query?.reportType==='subscriptions'?'selected':''%>>Subscriptions</option>
                        <option value="admin_actions"<%=query?.reportType==='admin_actions'?'selected':''%>>Admin Log</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1" style="padding:.5rem .8rem;font-size:.88rem;">
                            <i class="fas fa-search me-1"></i>Generate
                        </button>
                        <a href="/admin/reports" class="btn btn-outline-primary d-flex align-items-center justify-content-center" style="padding:.5rem .8rem;min-width:44px;" title="Reset">
                            <i class="fas fa-redo"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="preset-row">
                <span class="preset-label">Quick:</span>
                <button type="button" class="btn-xs" onclick="setPreset('today')">Today</button>
                <button type="button" class="btn-xs" onclick="setPreset('week')">Week</button>
                <button type="button" class="btn-xs" onclick="setPreset('month')">Month</button>
                <button type="button" class="btn-xs" onclick="setPreset('quarter')">Quarter</button>
                <button type="button" class="btn-xs" onclick="setPreset('year')">Year</button>
                <button type="button" class="btn-xs" onclick="setPreset('all')">All Time</button>
            </div>
        </form>
    </div>

    <!-- ═══ RESULTS ═══ -->
    <% if (member && reportData) { %>

    <!-- Member Card -->
    <div class="member-card">
        <div class="d-flex align-items-start gap-3">
            <img src="<%=member.displayPicture||member.passportPhoto||`https://ui-avatars.com/api/?name=${encodeURIComponent(member.firstName+'+'+member.lastName)}&background=ffffff&color=1e3a8a&size=80`%>"
                 alt="Avatar" class="member-avatar mt-1">
            <div style="flex:1;min-width:0;overflow:hidden;">
                <div class="member-name"><%=member.firstName%> <%=member.lastName%></div>
                <div class="d-flex flex-wrap gap-1 mb-1">
                    <span class="mem-badge"><i class="fas fa-id-card me-1"></i><%=member.membershipID||'N/A'%></span>
                    <%if(member.role){%>
                    <span class="mem-badge"><i class="fas fa-shield-alt me-1"></i><%=member.role.name?.toUpperCase()%></span>
                    <%}%>
                    <span class="mem-badge" style="background:rgba(16,185,129,.2);border-color:rgba(16,185,129,.35);"><%=member.status?.toUpperCase()%></span>
                    <%if(member.account?.accountType){%>
                    <span class="mem-badge"><%=member.account.accountType.shortCode%> · <%=member.account.accountType.interestRate%>%</span>
                    <%}%>
                </div>
                <div class="member-meta">
                    <span style="overflow:hidden;text-overflow:ellipsis;min-width:0;"><i class="fas fa-envelope me-1"></i><%=member.email%></span>
                    <%if(member.phone){%><span><i class="fas fa-phone"></i><%=member.phone%></span><%}%>
                </div>
            </div>
            <div class="member-balance d-none d-sm-block">
                <div class="balance-label">Balance</div>
                <div class="balance-value">₦<%=(member.account?.balance||0).toLocaleString()%></div>
                <%if(query?.dateFrom||query?.dateTo){%>
                <div style="font-size:.65rem;opacity:.65;margin-top:3px;"><%=query.dateFrom||'Start'%> → <%=query.dateTo||'Now'%></div>
                <%}%>
            </div>
        </div>
        <!-- mobile balance -->
        <div class="d-sm-none mt-2 pt-2" style="border-top:1px solid rgba(255,255,255,.15);">
            <span class="balance-label">Balance: </span>
            <span class="fw-bold">₦<%=(member.account?.balance||0).toLocaleString()%></span>
        </div>
    </div>

    <!-- Summary Bar -->
    <%if(reportData.summary){%>
    <div class="summary-bar">
        <div class="sum-grid">
            <div class="sum-item">
                <div class="sum-label"><i class="fas fa-arrow-down"></i> Deposits</div>
                <div class="sum-value positive">₦<%=(reportData.summary.totalDeposits||0).toLocaleString()%></div>
            </div>
            <div class="sum-item">
                <div class="sum-label"><i class="fas fa-arrow-up"></i> Withdrawals</div>
                <div class="sum-value negative">₦<%=(reportData.summary.totalWithdrawals||0).toLocaleString()%></div>
            </div>
            <div class="sum-item">
                <div class="sum-label"><i class="fas fa-chart-line"></i> ROI</div>
                <div class="sum-value positive">₦<%=(reportData.summary.totalROI||0).toLocaleString()%></div>
            </div>
            <div class="sum-item">
                <div class="sum-label"><i class="fas fa-exclamation-circle"></i> Charges</div>
                <div class="sum-value negative">₦<%=(reportData.summary.totalCharges||0).toLocaleString()%></div>
            </div>
            <div class="sum-item">
                <div class="sum-label"><i class="fas fa-landmark"></i> Loans Out</div>
                <div class="sum-value negative">₦<%=(reportData.summary.totalLoansOutstanding||0).toLocaleString()%></div>
            </div>
            <div class="sum-item">
                <div class="sum-label"><i class="fas fa-wallet"></i> Net Flow</div>
                <div class="sum-value <%=(reportData.summary.netFlow||0)>=0?'positive':'negative'%>">
                    <%=(reportData.summary.netFlow||0)<0?'-':''%>₦<%=Math.abs(reportData.summary.netFlow||0).toLocaleString()%>
                </div>
                <div class="sum-sub">Live: ₦<%=(reportData.summary.currentBalance||0).toLocaleString()%></div>
            </div>
        </div>
    </div>
    <%}%>

    <!-- Tabs -->
    <div class="report-tabs">
        <div class="tab-nav-wrap">
            <ul class="tab-nav nav" id="rTabs">
                <%if(reportData.deposits){%>
                <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-dep">
                    <i class="fas fa-coins"></i> Deposits <span class="tab-count"><%=reportData.deposits.count%></span>
                </a></li>
                <%}%>
                <%if(reportData.withdrawals){%>
                <li class="nav-item"><a class="nav-link <%=!reportData.deposits?'active':''%>" data-bs-toggle="tab" href="#tab-wdr">
                    <i class="fas fa-money-check-alt"></i> Withdrawals <span class="tab-count"><%=reportData.withdrawals.count%></span>
                </a></li>
                <%}%>
                <%if(reportData.loans){%>
                <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-loan">
                    <i class="fas fa-hand-holding-usd"></i> Loans <span class="tab-count"><%=reportData.loans.count%></span>
                </a></li>
                <%}%>
                <%if(reportData.roi){%>
                <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-roi">
                    <i class="fas fa-chart-pie"></i> ROI <span class="tab-count"><%=reportData.roi.count%></span>
                </a></li>
                <%}%>
                <%if(reportData.extraCharges){%>
                <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-chg">
                    <i class="fas fa-exclamation-triangle"></i> Charges <span class="tab-count"><%=reportData.extraCharges.count%></span>
                </a></li>
                <%}%>
                <%if(reportData.subscriptions){%>
                <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-sub">
                    <i class="fas fa-cube"></i> Subscriptions <span class="tab-count"><%=reportData.subscriptions.count%></span>
                </a></li>
                <%}%>
                <%if(reportData.adminActions){%>
                <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-act">
                    <i class="fas fa-history"></i> Admin Log <span class="tab-count"><%=reportData.adminActions.count%></span>
                </a></li>
                <%}%>
            </ul>
        </div>

        <div class="tab-content tab-content-wrap">

            <!-- ═══ DEPOSITS ═══ -->
            <%if(reportData.deposits){%>
            <div class="tab-pane fade show active" id="tab-dep">
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-arrow-down"></i></div>
                        <div style="min-width:0;flex:1;"><div class="s-label">Total</div><div class="s-value">₦<%=(reportData.deposits.totalAmount||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-check"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Approved</div><div class="s-value">₦<%=(reportData.deposits.totalApproved||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-clock"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Pending</div><div class="s-value">₦<%=(reportData.deposits.totalPending||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#dbeafe;color:#1e3a8a;"><i class="fas fa-receipt"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Count</div><div class="s-value"><%=reportData.deposits.count%></div></div>
                    </div></div>
                </div>
                <div class="tbl-card">
                    <div class="tbl-head">
                        <div class="tbl-head-title"><i class="fas fa-coins"></i> Deposit Transactions</div>
                    </div>
                    <div class="swipe-hint"><i class="fas fa-arrows-left-right"></i> Swipe to view all columns</div>
                    <div class="table-scroll">
                        <table class="tbl tbl-min-md">
                            <thead><tr><th>#</th><th>Date</th><th>Ref</th><th>Type</th><th>Amount</th><th>Bal Before</th><th>Bal After</th><th>Status</th><th>By</th></tr></thead>
                            <tbody>
                                <%if(reportData.deposits.records.length===0){%>
                                <tr><td colspan="9"><div class="empty-state"><i class="fas fa-coins"></i><p>No deposit records</p></div></td></tr>
                                <%}%>
                                <%reportData.deposits.records.forEach((dep,i)=>{%>
                                <tr>
                                    <td><small class="text-muted"><%=i+1%></small></td>
                                    <td><div class="cell-date-main"><%=new Date(dep.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div><div class="cell-date-sub"><%=new Date(dep.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'})%></div></td>
                                    <td><code style="font-size:.72rem;"><%=dep.reference||'—'%></code></td>
                                    <td><span class="badge bs-purple" style="text-transform:capitalize;"><%=(dep.type||'').replace(/_/g,' ')%></span></td>
                                    <td><span class="cell-amount-pos">+₦<%=dep.amount.toLocaleString()%></span></td>
                                    <td><span class="cell-amount-neu">₦<%=(dep.balanceBefore||0).toLocaleString()%></span></td>
                                    <td><span class="cell-amount-neu">₦<%=(dep.balanceAfter||0).toLocaleString()%></span></td>
                                    <td><span class="badge bs-<%=dep.status%>"><%=(dep.status||'').toUpperCase()%></span></td>
                                    <td><%if(dep.processedBy){%><span class="actor-pill"><i class="fas fa-shield-alt"></i><%=dep.processedBy.firstName%> <%=dep.processedBy.lastName?.charAt(0)%>.</span><%}else{%><small class="text-muted">—</small><%}%></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="4" class="text-end">APPROVED TOTAL</td><td colspan="5"><span class="cell-amount-pos">₦<%=(reportData.deposits.totalApproved||0).toLocaleString()%></span></td></tr></tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <%}%>

            <!-- ═══ WITHDRAWALS ═══ -->
            <%if(reportData.withdrawals){%>
            <div class="tab-pane fade <%=!reportData.deposits?'show active':''%>" id="tab-wdr">
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-arrow-up"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Total</div><div class="s-value">₦<%=(reportData.withdrawals.totalAmount||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-check"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Completed</div><div class="s-value">₦<%=(reportData.withdrawals.totalCompleted||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-tags"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Fees</div><div class="s-value">₦<%=(reportData.withdrawals.totalFees||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#dbeafe;color:#1e3a8a;"><i class="fas fa-receipt"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Count</div><div class="s-value"><%=reportData.withdrawals.count%></div></div>
                    </div></div>
                </div>
                <div class="tbl-card">
                    <div class="tbl-head"><div class="tbl-head-title"><i class="fas fa-money-check-alt"></i> Withdrawal Transactions</div></div>
                    <div class="swipe-hint"><i class="fas fa-arrows-left-right"></i> Swipe to view all columns</div>
                    <div class="table-scroll">
                        <table class="tbl tbl-min-lg">
                            <thead><tr><th>#</th><th>Date</th><th>Ref</th><th>Amount</th><th>Fee</th><th>Net</th><th>Bal Before</th><th>Bal After</th><th>Bank</th><th>Status</th><th>By</th></tr></thead>
                            <tbody>
                                <%if(reportData.withdrawals.records.length===0){%>
                                <tr><td colspan="11"><div class="empty-state"><i class="fas fa-money-check-alt"></i><p>No withdrawal records</p></div></td></tr>
                                <%}%>
                                <%reportData.withdrawals.records.forEach((w,i)=>{%>
                                <tr>
                                    <td><small class="text-muted"><%=i+1%></small></td>
                                    <td><div class="cell-date-main"><%=new Date(w.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div><div class="cell-date-sub"><%=new Date(w.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'})%></div></td>
                                    <td><code style="font-size:.72rem;"><%=w.reference||'—'%></code></td>
                                    <td><span class="cell-amount-neg">-₦<%=w.amount.toLocaleString()%></span></td>
                                    <td><span class="cell-amount-neu">₦<%=(w.fee||0).toLocaleString()%></span></td>
                                    <td><span class="cell-amount-neu">₦<%=(w.netAmount||0).toLocaleString()%></span></td>
                                    <td><span class="cell-amount-neu">₦<%=(w.balanceBefore||0).toLocaleString()%></span></td>
                                    <td><span class="cell-amount-neu">₦<%=(w.balanceAfter||0).toLocaleString()%></span></td>
                                    <td><%if(w.bankDetails?.bankName){%><div style="font-size:.75rem;font-weight:600;white-space:nowrap;"><%=w.bankDetails.bankName%></div><div style="font-size:.7rem;color:#64748b;"><%=w.bankDetails.accountNumber%></div><%}else{%><small class="text-muted">—</small><%}%></td>
                                    <td><span class="badge bs-<%=w.status%>"><%=(w.status||'').toUpperCase()%></span></td>
                                    <td><%if(w.approvedBy){%><span class="actor-pill"><i class="fas fa-shield-alt"></i><%=w.approvedBy.firstName%> <%=w.approvedBy.lastName?.charAt(0)%>.</span><%}else{%><small class="text-muted">—</small><%}%></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="3" class="text-end">COMPLETED TOTAL</td><td colspan="8"><span class="cell-amount-neg">₦<%=(reportData.withdrawals.totalCompleted||0).toLocaleString()%></span></td></tr></tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <%}%>

            <!-- ═══ LOANS ═══ -->
            <%if(reportData.loans){%>
            <div class="tab-pane fade" id="tab-loan">
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-landmark"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Borrowed</div><div class="s-value">₦<%=(reportData.loans.totalBorrowed||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-undo"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Repaid</div><div class="s-value">₦<%=(reportData.loans.totalRepaid||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-exclamation"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Outstanding</div><div class="s-value">₦<%=(reportData.loans.totalOutstanding||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#e0e7ff;color:#3730a3;"><i class="fas fa-percent"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Interest</div><div class="s-value">₦<%=(reportData.loans.totalInterest||0).toLocaleString()%></div></div>
                    </div></div>
                </div>

                <%if(reportData.loans.records.length===0){%>
                <div class="empty-state"><i class="fas fa-hand-holding-usd"></i><p>No loan records found</p></div>
                <%}%>

                <%reportData.loans.records.forEach((loan,li)=>{%>
                <div class="loan-card">
                    <div class="loan-card-hdr">
                        <div class="loan-card-hdr-title">
                            <i class="fas fa-hand-holding-usd" style="color:var(--primary);"></i>
                            Loan #<%=li+1%> — <span style="font-family:monospace;font-size:.82rem;"><%=loan.loanRef||loan._id.toString().slice(-8).toUpperCase()%></span>
                            <span class="badge bs-<%=loan.status%>"><%=(loan.status||'').toUpperCase()%></span>
                        </div>
                        <span style="font-size:.75rem;color:#64748b;"><%=new Date(loan.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></span>
                    </div>
                    <div class="loan-card-body">
                        <!-- Loan KV Grid -->
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-md-2"><div class="loan-kv">Principal</div><div class="loan-kv-val">₦<%=loan.principalAmount.toLocaleString()%></div></div>
                            <div class="col-6 col-md-2"><div class="loan-kv">Rate</div><div class="loan-kv-val"><%=loan.interestRate%>% · ₦<%=(loan.interestAmount||0).toLocaleString()%></div></div>
                            <div class="col-6 col-md-2"><div class="loan-kv">Total Due</div><div class="loan-kv-val">₦<%=(loan.totalRepayable||0).toLocaleString()%></div></div>
                            <div class="col-6 col-md-2"><div class="loan-kv">Monthly</div><div class="loan-kv-val">₦<%=(loan.monthlyInstalment||0).toLocaleString()%></div></div>
                            <div class="col-6 col-md-2"><div class="loan-kv">Repaid</div><div class="loan-kv-val" style="color:#059669;">₦<%=(loan.amountRepaid||0).toLocaleString()%></div></div>
                            <div class="col-6 col-md-2"><div class="loan-kv">Outstanding</div><div class="loan-kv-val" style="color:#dc2626;">₦<%=(loan.outstandingBalance||0).toLocaleString()%></div></div>
                        </div>

                        <!-- Guarantors -->
                        <%if(loan.guarantors&&loan.guarantors.length>0){%>
                        <div style="font-size:.72rem;font-weight:700;color:#94a3b8;text-transform:uppercase;margin-bottom:5px;"><i class="fas fa-users me-1"></i>Guarantors</div>
                        <ul class="g-list mb-3">
                            <%loan.guarantors.forEach(g=>{%>
                            <li>
                                <span class="badge bs-<%=g.status%>" style="min-width:60px;"><%=(g.status||'').toUpperCase()%></span>
                                <%if(g.guarantor){%>
                                <strong style="font-size:.8rem;"><%=g.guarantor.firstName%> <%=g.guarantor.lastName%></strong>
                                <span class="text-muted" style="font-size:.75rem;">(<%=g.guarantor.membershipID%>)</span>
                                <%}else{%><span class="text-muted" style="font-size:.78rem;">Unknown</span><%}%>
                                <span class="ms-auto" style="color:var(--primary);font-weight:700;font-size:.8rem;white-space:nowrap;">₦<%=g.amount.toLocaleString()%></span>
                            </li>
                            <%})%>
                        </ul>
                        <%}%>

                        <!-- Approver -->
                        <%if(loan.reviewedBy){%>
                        <div class="approver-bar">
                            <i class="fas fa-user-shield" style="color:var(--primary);flex-shrink:0;margin-top:2px;"></i>
                            <div>
                                <strong style="font-size:.8rem;">Decision by:</strong>
                                <span style="font-size:.8rem;"> <%=loan.reviewedBy.firstName%> <%=loan.reviewedBy.lastName%></span>
                                <span class="actor-pill ms-1"><i class="fas fa-shield-alt"></i><%=loan.reviewedByRole||'Admin'%></span>
                                <%if(loan.reviewedAt){%><span class="text-muted ms-1" style="font-size:.75rem;"><%=new Date(loan.reviewedAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></span><%}%>
                            </div>
                        </div>
                        <%}%>

                        <!-- Repayments -->
                        <%if(loan.repayments&&loan.repayments.length>0){%>
                        <div style="font-size:.72rem;font-weight:700;color:#94a3b8;text-transform:uppercase;margin-bottom:6px;"><i class="fas fa-undo me-1"></i>Repayments (<%=loan.repayments.length%>)</div>
                        <div class="tbl-card">
                            <div class="table-scroll">
                                <table class="tbl tbl-min">
                                    <thead><tr><th>#</th><th>Date</th><th>Amount</th><th>Principal</th><th>Interest</th><th>Bal After</th><th>Received By</th><th>Status</th></tr></thead>
                                    <tbody>
                                        <%loan.repayments.forEach((r,ri)=>{%>
                                        <tr>
                                            <td><%=ri+1%></td>
                                            <td><span class="cell-date-main"><%=new Date(r.paidAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></span></td>
                                            <td><span class="cell-amount-pos">₦<%=r.amount.toLocaleString()%></span></td>
                                            <td><span class="cell-amount-neu">₦<%=(r.principal||0).toLocaleString()%></span></td>
                                            <td><span class="cell-amount-neu">₦<%=(r.interest||0).toLocaleString()%></span></td>
                                            <td><span class="cell-amount-neu">₦<%=(r.balanceAfter||0).toLocaleString()%></span></td>
                                            <td><%if(r.receivedBy){%><span class="actor-pill"><i class="fas fa-shield-alt"></i><%=r.receivedBy.firstName||''%></span><%}else{%><small class="text-muted">—</small><%}%></td>
                                            <td><span class="badge bs-<%=r.status%>"><%=(r.status||'').toUpperCase()%></span></td>
                                        </tr>
                                        <%})%>
                                    </tbody>
                                    <tfoot><tr><td colspan="2" class="text-end">TOTAL</td><td colspan="6"><span class="cell-amount-pos">₦<%=(loan.amountRepaid||0).toLocaleString()%></span></td></tr></tfoot>
                                </table>
                            </div>
                        </div>
                        <%}else{%>
                        <p style="font-size:.8rem;color:#94a3b8;margin:0;"><i class="fas fa-info-circle me-1"></i>No repayments yet.</p>
                        <%}%>
                    </div>
                </div>
                <%})%>
            </div>
            <%}%>

            <!-- ═══ ROI ═══ -->
            <%
              const isAccumulative = (member && member.account && member.account.accumulativeROI > 0);
            %>
            <%if(reportData.roi){%>
            <div class="tab-pane fade" id="tab-roi">
                <div class="roi-banner" style="background:<%=isAccumulative?'#d1fae5':'#dbeafe'%>;border-left:4px solid <%=isAccumulative?'#059669':'#2563eb'%>;">
                    <i class="fas <%=isAccumulative?'fa-piggy-bank':'fa-money-bill-wave'%>" style="font-size:1.2rem;color:<%=isAccumulative?'#059669':'#2563eb'%>;flex-shrink:0;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;color:<%=isAccumulative?'#065f46':'#1e3a8a'%>;font-size:.85rem;"><%=isAccumulative?'Accumulative ROI Mode':'Monthly Payout ROI Mode'%></div>
                        <div style="font-size:.75rem;color:#475569;margin-top:2px;">
                            <%if(isAccumulative){%>ROI is compounded into balance. Lifetime total: <strong>₦<%=(reportData.roi.accumulativeROI||0).toLocaleString()%></strong>
                            <%}else{%>ROI paid out each cycle. Last payout: <strong><%=reportData.roi.lastRoiPayout?new Date(reportData.roi.lastRoiPayout).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}):'Never'%></strong><%}%>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-chart-line"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Period ROI</div><div class="s-value">₦<%=(reportData.roi.totalROI||0).toLocaleString()%></div><div style="font-size:.67rem;color:#94a3b8;"><%=reportData.roi.count%>/<%=reportData.roi.totalHistoryCount%> mo</div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#e0e7ff;color:#3730a3;"><i class="fas fa-piggy-bank"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Lifetime</div><div class="s-value">₦<%=(reportData.roi.accumulativeROI||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-calendar-check"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Last Payout</div><div class="s-value" style="font-size:.82rem;"><%=reportData.roi.lastRoiPayout?new Date(reportData.roi.lastRoiPayout).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}):'—'%></div></div>
                    </div></div>
                    <div class="col-6 col-md-3"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#dbeafe;color:#1e3a8a;"><i class="fas fa-history"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Total Cycles</div><div class="s-value"><%=reportData.roi.totalHistoryCount%> mo</div></div>
                    </div></div>
                </div>

                <div class="tbl-card">
                    <div class="tbl-head">
                        <div class="tbl-head-title"><i class="fas fa-chart-pie"></i> Monthly ROI History</div>
                        <%if(query.dateFrom||query.dateTo){%><small class="text-muted"><%=query.dateFrom||'start'%> → <%=query.dateTo||'today'%></small><%}%>
                    </div>
                    <div class="swipe-hint"><i class="fas fa-arrows-left-right"></i> Swipe to view all columns</div>
                    <div class="table-scroll">
                        <%
                          const roiAsc=[...reportData.roi.records].sort((a,b)=>new Date(a.createdAt)-new Date(b.createdAt));
                          let rMap={},rRun=0;
                          roiAsc.forEach(r=>{rRun+=(r.roi||0);rMap[String(r._id||r.month)]=rRun;});
                        %>
                        <table class="tbl tbl-min">
                            <thead><tr><th>#</th><th>Month</th><th>Credited</th><th>ROI Amount</th><th>Running Total</th></tr></thead>
                            <tbody>
                                <%if(reportData.roi.records.length===0){%>
                                <tr><td colspan="5"><div class="empty-state"><i class="fas fa-chart-pie"></i><p>No ROI records for this period</p></div></td></tr>
                                <%}%>
                                <%reportData.roi.records.forEach((r,i)=>{%>
                                <tr>
                                    <td><small class="text-muted"><%=i+1%></small></td>
                                    <td><span class="badge bs-purple" style="font-size:.75rem;"><%=r.month%></span></td>
                                    <td><div class="cell-date-main"><%=new Date(r.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div><div class="cell-date-sub"><%=new Date(r.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'})%></div></td>
                                    <td><span class="cell-amount-pos">+₦<%=(r.roi||0).toLocaleString()%></span></td>
                                    <td><span style="font-size:.82rem;color:var(--primary);font-weight:600;">₦<%=(rMap[String(r._id||r.month)]||0).toLocaleString()%></span></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="3" class="text-end">PERIOD TOTAL</td><td colspan="2"><span class="cell-amount-pos">₦<%=(reportData.roi.totalROI||0).toLocaleString()%></span></td></tr></tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <%}%>

            <!-- ═══ EXTRA CHARGES ═══ -->
            <%if(reportData.extraCharges){%>
            <div class="tab-pane fade" id="tab-chg">
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-4"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-exclamation-triangle"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Total Charged</div><div class="s-value">₦<%=(reportData.extraCharges.totalAmount||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-4"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-check"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Paid</div><div class="s-value">₦<%=(reportData.extraCharges.totalPaid||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-4"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#e0e7ff;color:#3730a3;"><i class="fas fa-hand-paper"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Waived</div><div class="s-value">₦<%=(reportData.extraCharges.totalWaived||0).toLocaleString()%></div></div>
                    </div></div>
                </div>
                <div class="tbl-card">
                    <div class="tbl-head"><div class="tbl-head-title"><i class="fas fa-exclamation-triangle"></i> Extra Charges</div></div>
                    <div class="swipe-hint"><i class="fas fa-arrows-left-right"></i> Swipe to view all columns</div>
                    <div class="table-scroll">
                        <table class="tbl tbl-min-md">
                            <thead><tr><th>#</th><th>Date</th><th>Type</th><th>Description</th><th>Amount</th><th>Status</th><th>Charged By</th><th>Approved By</th></tr></thead>
                            <tbody>
                                <%if(reportData.extraCharges.records.length===0){%>
                                <tr><td colspan="8"><div class="empty-state"><i class="fas fa-exclamation-triangle"></i><p>No charge records</p></div></td></tr>
                                <%}%>
                                <%reportData.extraCharges.records.forEach((c,i)=>{%>
                                <tr>
                                    <td><small class="text-muted"><%=i+1%></small></td>
                                    <td><div class="cell-date-main"><%=new Date(c.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div></td>
                                    <td><span class="badge bs-purple" style="text-transform:capitalize;font-size:.68rem;"><%=(c.chargeType||'').replace(/_/g,' ')%></span></td>
                                    <td style="max-width:140px;font-size:.78rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%=c.description%></td>
                                    <td><span class="cell-amount-neg">₦<%=c.amount.toLocaleString()%></span></td>
                                    <td><span class="badge bs-<%=c.status%>"><%=(c.status||'').toUpperCase()%></span></td>
                                    <td><%if(c.chargedBy){%><span class="actor-pill"><i class="fas fa-shield-alt"></i><%=c.chargedBy.firstName%> <%=c.chargedBy.lastName?.charAt(0)%>.</span><%}else{%><small class="text-muted">—</small><%}%></td>
                                    <td><%if(c.approvedBy){%><span class="actor-pill"><i class="fas fa-shield-alt"></i><%=c.approvedBy.firstName%> <%=c.approvedBy.lastName?.charAt(0)%>.</span><%}else{%><small class="text-muted">—</small><%}%></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="4" class="text-end">PAID TOTAL</td><td colspan="4"><span class="cell-amount-neg">₦<%=(reportData.extraCharges.totalPaid||0).toLocaleString()%></span></td></tr></tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <%}%>

            <!-- ═══ SUBSCRIPTIONS ═══ -->
            <%if(reportData.subscriptions){%>
            <div class="tab-pane fade" id="tab-sub">
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-4"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#dbeafe;color:#1e3a8a;"><i class="fas fa-cube"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Total Billed</div><div class="s-value">₦<%=(reportData.subscriptions.totalAmount||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-4"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-check"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Paid</div><div class="s-value">₦<%=(reportData.subscriptions.totalPaid||0).toLocaleString()%></div></div>
                    </div></div>
                    <div class="col-6 col-md-4"><div class="stat-mini d-flex align-items-center gap-2">
                        <div class="s-icon" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-clock"></i></div>
                        <div style="min-width:0;flex:1;overflow:hidden;">Overdue</div><div class="s-value">₦<%=(reportData.subscriptions.totalOverdue||0).toLocaleString()%></div></div>
                    </div></div>
                </div>
                <div class="tbl-card">
                    <div class="tbl-head"><div class="tbl-head-title"><i class="fas fa-cube"></i> Subscription / Maintenance History</div></div>
                    <div class="swipe-hint"><i class="fas fa-arrows-left-right"></i> Swipe to view all columns</div>
                    <div class="table-scroll">
                        <table class="tbl tbl-min-md">
                            <thead><tr><th>#</th><th>Date</th><th>Plan</th><th>Period</th><th>Amount</th><th>Late Fee</th><th>Due</th><th>Paid</th><th>Status</th><th>By</th></tr></thead>
                            <tbody>
                                <%if(reportData.subscriptions.records.length===0){%>
                                <tr><td colspan="10"><div class="empty-state"><i class="fas fa-cube"></i><p>No subscription records</p></div></td></tr>
                                <%}%>
                                <%reportData.subscriptions.records.forEach((s,i)=>{%>
                                <tr>
                                    <td><small class="text-muted"><%=i+1%></small></td>
                                    <td><div class="cell-date-main"><%=new Date(s.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div></td>
                                    <td><strong style="font-size:.8rem;white-space:nowrap;"><%=s.subscriptionPlan%></strong></td>
                                    <td><span class="badge bs-purple"><%=s.period||'—'%></span></td>
                                    <td><span class="cell-amount-neu" style="font-weight:700;">₦<%=s.amount.toLocaleString()%></span></td>
                                    <td><%if(s.isLateFee&&s.lateFeeAmount){%><span class="cell-amount-neg" style="font-size:.75rem;">+₦<%=s.lateFeeAmount.toLocaleString()%></span><%}else{%><small class="text-muted">—</small><%}%></td>
                                    <td><small class="cell-date-main"><%=s.dueDate?new Date(s.dueDate).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}):'—'%></small></td>
                                    <td><small class="cell-date-main"><%=s.paidDate?new Date(s.paidDate).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}):'—'%></small></td>
                                    <td><span class="badge bs-<%=s.status%>"><%=(s.status||'').toUpperCase()%></span></td>
                                    <td><%if(s.processedBy){%><span class="actor-pill"><i class="fas fa-shield-alt"></i><%=s.processedBy.firstName%> <%=s.processedBy.lastName?.charAt(0)%>.</span><%}else{%><small class="text-muted">—</small><%}%></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="4" class="text-end">PAID TOTAL</td><td colspan="6"><span class="cell-amount-pos">₦<%=(reportData.subscriptions.totalPaid||0).toLocaleString()%></span></td></tr></tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <%}%>

            <!-- ═══ ADMIN ACTIONS ═══ -->
            <%if(reportData.adminActions){%>
            <div class="tab-pane fade" id="tab-act">
                <div class="tbl-card">
                    <div class="tbl-head">
                        <div class="tbl-head-title"><i class="fas fa-history"></i> Admin Actions Log</div>
                        <span class="badge bs-purple"><%=reportData.adminActions.count%> events</span>
                    </div>
                    <div class="swipe-hint"><i class="fas fa-arrows-left-right"></i> Swipe to view all columns</div>
                    <div class="table-scroll">
                        <table class="tbl tbl-min-md">
                            <thead><tr><th>#</th><th>Date &amp; Time</th><th>Admin</th><th>Role</th><th>Action</th><th>Description</th><th>Status</th><th>IP</th></tr></thead>
                            <tbody>
                                <%if(reportData.adminActions.records.length===0){%>
                                <tr><td colspan="8"><div class="empty-state"><i class="fas fa-history"></i><p>No admin actions found</p></div></td></tr>
                                <%}%>
                                <%reportData.adminActions.records.forEach((act,i)=>{%>
                                <tr>
                                    <td><small class="text-muted"><%=i+1%></small></td>
                                    <td><div class="cell-date-main"><%=new Date(act.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div><div class="cell-date-sub"><%=new Date(act.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'})%></div></td>
                                    <td>
                                        <%if(act.admin){%>
                                        <div style="font-size:.8rem;font-weight:600;white-space:nowrap;"><%=act.admin.firstName%> <%=act.admin.lastName%></div>
                                        <div style="font-size:.7rem;color:#64748b;"><%=act.admin.membershipID%></div>
                                        <%}else{%><small class="text-muted">System</small><%}%>
                                    </td>
                                    <td><span class="actor-pill"><i class="fas fa-shield-alt"></i><%=act.adminRole||'—'%></span></td>
                                    <td><span class="badge bs-purple" style="font-size:.68rem;text-transform:uppercase;"><%=(act.actionType||'').replace(/_/g,' ')%></span></td>
                                    <td style="max-width:160px;font-size:.78rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%=act.description%>"><%=act.description%></td>
                                    <td><span class="badge <%=act.status==='success'?'bs-approved':act.status==='failed'?'bs-rejected':'bs-pending'%>"><%=(act.status||'').toUpperCase()%></span></td>
                                    <td><code style="font-size:.7rem;white-space:nowrap;"><%=act.ipAddress||'—'%></code></td>
                                </tr>
                                <%})%>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <%}%>

        </div><!-- /tab-content -->
    </div><!-- /report-tabs -->

    <%}else if(query&&query.membershipID&&!member){%>
    <div class="center-card">
        <div class="center-icon" style="background:#fee2e2;">
            <i class="fas fa-user-slash" style="color:#dc2626;"></i>
        </div>
        <h5 class="fw-bold mb-2" style="color:#1e293b;">Member Not Found</h5>
        <p class="text-muted mb-1">No member found with ID: <strong><%=query.membershipID%></strong></p>
        <p class="text-muted mb-0" style="font-size:.85rem;">Check the membership ID and try again.</p>
    </div>

    <%}else{%>
    <div class="center-card">
        <div class="center-icon" style="background:linear-gradient(135deg,#e0e7ff,#dbeafe);">
            <i class="fas fa-file-alt" style="color:var(--primary);"></i>
        </div>
        <h5 class="fw-bold mb-2" style="color:#1e293b;">Generate a Member Report</h5>
        <p class="text-muted mb-1">Enter a Membership ID and click <strong>Generate</strong>.</p>
        <p class="text-muted mb-0" style="font-size:.82rem;">Filter by date range and report type for targeted results.</p>
    </div>
    <%}%>

</div><!-- /main-content -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
function toggleSidebar() {
    if (window.innerWidth <= 992) {
        document.getElementById('sidebar').classList.toggle('active');
        document.getElementById('sidebarOverlay').classList.toggle('active');
    }
}
function closeSidebar() {
    document.getElementById('sidebar').classList.remove('active');
    document.getElementById('sidebarOverlay').classList.remove('active');
}

function setPreset(p) {
    const today = new Date(), fmt = d => d.toISOString().slice(0,10);
    let from, to = fmt(today);
    if (p==='today')   { from=to; }
    else if (p==='week')    { const d=new Date(today); d.setDate(d.getDate()-d.getDay()); from=fmt(d); }
    else if (p==='month')   { from=fmt(new Date(today.getFullYear(),today.getMonth(),1)); }
    else if (p==='quarter') { const q=Math.floor(today.getMonth()/3); from=fmt(new Date(today.getFullYear(),q*3,1)); }
    else if (p==='year')    { from=fmt(new Date(today.getFullYear(),0,1)); }
    else                    { from=''; to=''; }
    document.querySelector('[name="dateFrom"]').value = from;
    document.querySelector('[name="dateTo"]').value   = to;
}

function printReport() {
    document.querySelectorAll('.tab-pane').forEach(p=>{p.style.display='block';p.style.opacity='1';});
    window.print();
    setTimeout(()=>{ document.querySelectorAll('.tab-pane').forEach(p=>{p.style.display='';p.style.opacity='';});},1000);
}

function exportCSV() {
    const active = document.querySelector('.tab-pane.show.active');
    if (!active) return alert('No report data to export.');
    const table = active.querySelector('table');
    if (!table) return alert('No table in current tab.');
    let csv='';
    table.querySelectorAll('tr').forEach(row=>{
        const cells=[...row.querySelectorAll('th,td')].map(c=>'"'+(c.innerText||c.textContent).replace(/"/g,'""').replace(/\n/g,' ').trim()+'"');
        csv+=cells.join(',')+'\n';
    });
    const mid = document.querySelector('[name="membershipID"]')?.value||'member';
    const a=document.createElement('a');
    a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
    a.download=`report_${mid}_${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
}

async function loadSidebarPendingCount() {
    try {
        const data = await fetch('/admin/pending-approvals-count').then(r=>r.json());
        const badge = document.getElementById('sidebarPendingBadge');
        if (!badge) return;
        badge.style.display = data.count>0?'inline-block':'none';
        badge.textContent = data.count;
    } catch(e){}
}
document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
</script>

</body>
</html>
