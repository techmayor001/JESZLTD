                            <tbody>
                                <%if(!reportData.roi.records.length){%><tr><td colspan="5"><div class="empty-state"><i class="fas fa-chart-pie"></i><p>No ROI records for this period</p></div></td></tr><%}%>
                                <%reportData.roi.records.forEach((r,i)=>{%>
                                <tr>
                                    <td><small style="color:#94a3b8;"><%=i+1%></small></td>
                                    <td><span class="badge bs-purple"><%=r.month%></span></td>
                                    <td><div class="dt-main"><%=new Date(r.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></div><div class="dt-sub"><%=new Date(r.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'})%></div></td>
                                    <td><span class="pos">+₦<%=(r.roi||0).toLocaleString()%></span></td>
                                    <td><span style="font-size:.82rem;color:var(--primary);font-weight:700;">₦<%=(rMap[String(r._id||r.month)]||0).toLocaleString()%></span></td>
                                </tr>
                                <%})%>
                            </tbody>
                            <tfoot><tr><td colspan="3" style="text-align:right;">PERIOD TOTAL</td><td colspan="2"><span class="pos">₦<%=(reportData.roi.totalROI||0).toLocaleString()%></span></td></tr></tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <%}%>

                <!-- EXTRA CHARGES -->
                <%if(reportData.extraCharges){%>
                <div class="tab-pane" id="m-chg">
                    <div class="mini-grid">
                        <div class="mini-stat"><div class="mini-icon" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-exclamation-triangle"></i></div><div class="mini-body"><div class="mini-label">Total Charged</div><div class="mini-value">₦<%=(reportData.extraCharges.totalAmount||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-check"></i></div><div class="mini-body"><div class="mini-label">Paid</div><div class="mini-value">₦<%=(reportData.extraCharges.totalPaid||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#e0e7ff;color:#3730a3;"><i class="fas fa-hand-paper"></i></div><div class="mini-body"><div class="mini-label">Waived</div><div class="mini-value">₦<%=(reportData.extraCharges.totalWaived||0).toLocaleString()%></div></div></div>
                    </div>
                    <div class="tbl-card">
                        <div class="tbl-head"><div class="tbl-title"><i class="fas fa-exclamation-triangle"></i>Extra Charges</div><div class="swipe-note"><i class="fas fa-arrows-left-right"></i>Scroll</div></div>
                        <div class="tbl-scroll"><table class="tbl tbl-min-md">
                            <thead><tr><th>#</th><th>Date</th><th>Type</th><th>Description</th><th>Amount</th><th>Status</th><th>Charged By</th><th>Approved By</th></tr></thead>
                            <tbody>
                                <%if(!reportData.extraCharges.records.length){%><tr><td colspan="8"><div class="empty-state"><i class="fas fa-exclamation-triangle"></i><p>No charge records</p></div></td></tr><%}%>
                                <%reportData.extraCharges.records.forEach((c,i)=>{%>
                                <tr>
                                    <td><small style="color:#94a3b8;"><%=i+1%></small></td>
