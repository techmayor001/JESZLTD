                        <i class="fas <%=isAccum?'fa-piggy-bank':'fa-money-bill-wave'%>" style="font-size:1.1rem;color:<%=isAccum?'#059669':'#2563eb'%>;flex-shrink:0;margin-top:2px;"></i>
                        <div>
                            <div style="font-weight:800;color:<%=isAccum?'#065f46':'#1e3a8a'%>;font-size:.83rem;"><%=isAccum?'Accumulative ROI Mode':'Monthly Payout ROI Mode'%></div>
