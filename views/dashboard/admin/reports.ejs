                            <div class="tbl-card"><div class="tbl-scroll"><table class="tbl tbl-min">
                                <thead><tr><th>#</th><th>Date</th><th>Amount</th><th>Principal</th><th>Interest</th><th>Bal After</th><th>By</th><th>Status</th></tr></thead>
                                <tbody>
                                    <%loan.repayments.forEach((r,ri)=>{%>
                                    <tr>
                                        <td><%=ri+1%></td>
                                        <td><span class="dt-main"><%=new Date(r.paidAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})%></span></td>
                                        <td><span class="pos">₦<%=r.amount.toLocaleString()%></span></td>
                                        <td><span class="neu">₦<%=(r.principal||0).toLocaleString()%></span></td>
                                        <td><span class="neu">₦<%=(r.interest||0).toLocaleString()%></span></td>
                                        <td><span class="neu">₦<%=(r.balanceAfter||0).toLocaleString()%></span></td>
                                        <td><%if(r.receivedBy){%><span class="actor"><i class="fas fa-shield-alt"></i><%=r.receivedBy.firstName||''%></span><%}else{%><small style="color:#94a3b8;">—</small><%}%></td>
                                        <td><span class="badge bs-<%=r.status%>"><%=(r.status||'').toUpperCase()%></span></td>
                                    </tr>
                                    <%})%>
                                </tbody>
                                <tfoot><tr><td colspan="2" style="text-align:right;">TOTAL</td><td colspan="6"><span class="pos">₦<%=(loan.amountRepaid||0).toLocaleString()%></span></td></tr></tfoot>
                            </table></div></div>
                            <%}else{%><p style="font-size:.78rem;color:#94a3b8;margin:0;"><i class="fas fa-info-circle me-1"></i>No repayments yet.</p><%}%>
