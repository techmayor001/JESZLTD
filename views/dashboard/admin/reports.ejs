                                <%if(isAccum){%>ROI compounded into balance. Lifetime: <strong>₦<%=(reportData.roi.accumulativeROI||0).toLocaleString()%></strong>
                                <%}else{%>Last payout: <strong><%=reportData.roi.lastRoiPayout?new Date(reportData.roi.lastRoiPayout).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}):'Never'%></strong><%}%>
                            </div>
                        </div>
                    </div>
                    <div class="mini-grid">
                        <div class="mini-stat"><div class="mini-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-chart-line"></i></div><div class="mini-body"><div class="mini-label">Period ROI</div><div class="mini-value">₦<%=(reportData.roi.totalROI||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#e0e7ff;color:#3730a3;"><i class="fas fa-piggy-bank"></i></div><div class="mini-body"><div class="mini-label">Lifetime</div><div class="mini-value">₦<%=(reportData.roi.accumulativeROI||0).toLocaleString()%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-calendar-check"></i></div><div class="mini-body"><div class="mini-label">Last Payout</div><div class="mini-value" style="font-size:.82rem;"><%=reportData.roi.lastRoiPayout?new Date(reportData.roi.lastRoiPayout).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}):'—'%></div></div></div>
                        <div class="mini-stat"><div class="mini-icon" style="background:#dbeafe;color:#1e3a8a;"><i class="fas fa-history"></i></div><div class="mini-body"><div class="mini-label">Total Cycles</div><div class="mini-value"><%=reportData.roi.totalHistoryCount%> mo</div></div></div>
                    </div>
                    <div class="tbl-card">
                        <div class="tbl-head"><div class="tbl-title"><i class="fas fa-chart-pie"></i>Monthly ROI History</div></div>
                        <div class="tbl-scroll">
                            <%const roiAsc=[...reportData.roi.records].sort((a,b)=>new Date(a.createdAt)-new Date(b.createdAt));let rMap={},rRun=0;roiAsc.forEach(r=>{rRun+=(r.roi||0);rMap[String(r._id||r.month)]=rRun;});%>
