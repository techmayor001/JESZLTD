<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club De Stars – Operating Earnings</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        :root {
            --primary:#1e3a8a; --primary-dark:#1e40af; --primary-light:#3b82f6;
            --success:#10b981; --danger:#ef4444; --warning:#f59e0b;
            --sidebar-width:280px; --navbar-h:70px;
        }
        *{margin:0;padding:0;box-sizing:border-box;}
        body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f1f5f9;min-height:100vh;overflow-x:hidden;}

        /* ══════════ SIDEBAR ══════════ */
        .sidebar{
            position:fixed;left:0;top:0;bottom:0;width:var(--sidebar-width);
            background:linear-gradient(180deg,#0f2357 0%,#1e3a8a 40%,#1e40af 100%);
            z-index:1040;overflow-y:auto;transition:transform .3s ease;
            box-shadow:4px 0 24px rgba(30,58,138,.25);
            scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar{width:4px;}
        .sidebar::-webkit-scrollbar-track{background:transparent;}
        .sidebar::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:4px;}
        .sidebar-header{
            padding:1.4rem 1.25rem 1.1rem;border-bottom:1px solid rgba(255,255,255,.08);
            background:rgba(0,0,0,.18);position:sticky;top:0;z-index:2;
        }
        .logo-row{display:flex;align-items:center;gap:11px;margin-bottom:10px;}
        .logo-box{width:42px;height:42px;background:white;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--primary);font-size:1.3rem;box-shadow:0 4px 12px rgba(0,0,0,.25);flex-shrink:0;}
        .sidebar-brand{font-size:.95rem;font-weight:800;color:white;text-transform:uppercase;letter-spacing:.05em;line-height:1.2;}
        .sidebar-brand small{font-size:.65rem;font-weight:500;opacity:.55;display:block;letter-spacing:.08em;}
        .role-pill{display:inline-flex;align-items:center;gap:7px;padding:4px 10px;background:rgba(239,68,68,.2);border-radius:20px;border:1px solid rgba(239,68,68,.3);font-weight:700;font-size:.7rem;color:#fca5a5;}
        .nav-group{padding:.5rem 0;border-bottom:1px solid rgba(255,255,255,.06);}
        .nav-group:last-child{border-bottom:none;}
        .nav-category{display:flex;align-items:center;gap:7px;padding:.55rem 1.25rem .3rem;font-size:.62rem;font-weight:800;color:rgba(255,255,255,.38);text-transform:uppercase;letter-spacing:.1em;user-select:none;}
        .nav-category::after{content:'';flex:1;height:1px;background:rgba(255,255,255,.08);margin-left:4px;}
        .sidebar-nav a{display:flex;align-items:center;gap:11px;padding:.62rem 1.25rem;color:rgba(255,255,255,.72);text-decoration:none;font-weight:500;font-size:.84rem;border-left:3px solid transparent;transition:all .18s;}
        .sidebar-nav a:hover{background:rgba(255,255,255,.09);color:white;border-left-color:rgba(255,255,255,.4);}
        .sidebar-nav a.active{background:rgba(255,255,255,.15);color:white;border-left-color:white;}
        .sidebar-nav a i{width:18px;font-size:.9rem;flex-shrink:0;opacity:.8;text-align:center;}
        .sidebar-nav a.active i{opacity:1;}
        .nav-badge{margin-left:auto;font-size:.63rem;font-weight:800;padding:2px 7px;border-radius:10px;background:rgba(239,68,68,.9);color:white;flex-shrink:0;line-height:1.4;}
        .nav-back{display:flex;align-items:center;gap:10px;padding:.7rem 1.25rem .9rem;font-size:.8rem;font-weight:600;color:rgba(255,255,255,.42);text-decoration:none;transition:color .18s;border-top:1px solid rgba(255,255,255,.07);margin-top:.25rem;}
        .nav-back:hover{color:rgba(255,255,255,.7);}
        .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1035;}
        .sidebar-overlay.active{display:block;}

        /* ══ EXPORT DROPDOWN ══ */
        .export-wrapper{position:relative;display:inline-block;}
        .btn-export{background:white;color:var(--primary);border:none;font-weight:700;border-radius:8px;padding:.35rem .9rem;font-size:.82rem;display:inline-flex;align-items:center;gap:.4rem;box-shadow:0 2px 6px rgba(0,0,0,.1);transition:all .2s;cursor:pointer;}
        .btn-export:hover{background:#f8fafc;transform:translateY(-1px);}
        .btn-export .caret{font-size:.65rem;transition:transform .2s;}
        .btn-export.open .caret{transform:rotate(180deg);}
        .export-dropdown-menu{position:absolute;top:calc(100% + 5px);right:0;min-width:210px;background:white;border-radius:12px;box-shadow:0 16px 40px rgba(30,58,138,.2),0 4px 12px rgba(0,0,0,.08);padding:.4rem;z-index:99999;}
        .export-dropdown-menu .drop-header{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;padding:.45rem .7rem .2rem;}
        .export-dropdown-menu .drop-item{border-radius:8px;padding:.55rem .8rem;font-weight:600;font-size:.82rem;color:#1e293b;display:flex;align-items:center;gap:.55rem;transition:background .15s;text-decoration:none;cursor:pointer;}
        .export-dropdown-menu .drop-item:hover{background:rgba(30,58,138,.06);}
        .export-dropdown-menu .drop-divider{margin:.3rem .4rem;border-top:1px solid rgba(30,58,138,.08);}

        /* ══ TOPBAR ══ */
        .top-navbar{position:fixed;top:0;left:var(--sidebar-width);right:0;height:var(--navbar-h);background:rgba(255,255,255,.97);box-shadow:0 2px 10px rgba(30,58,138,.08);z-index:1030;display:flex;align-items:center;padding:0 1.5rem;border-bottom:1px solid rgba(30,58,138,.1);}
        .main-content{margin-left:var(--sidebar-width);margin-top:var(--navbar-h);padding:1.5rem;min-height:calc(100vh - var(--navbar-h));}

        /* ══ CARDS ══ */
        .card{border:1px solid rgba(30,58,138,.07);border-radius:14px;box-shadow:0 4px 12px rgba(30,58,138,.06);background:#fff;}
        .card-header{background:#f8faff;border-bottom:1px solid rgba(30,58,138,.1);padding:1rem 1.25rem;border-radius:14px 14px 0 0 !important;}
        .card-header h5,.card-header h6{color:var(--primary);font-weight:700;margin:0;}
        .stat-card{background:#fff;border-radius:14px;padding:1.25rem;border:1px solid rgba(30,58,138,.07);box-shadow:0 4px 12px rgba(30,58,138,.06);height:100%;}
        .stat-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;margin-bottom:.8rem;}

        .balance-highlight{background:linear-gradient(135deg,#1e3a8a 0%,#1e40af 60%,#2563eb 100%);border-radius:16px;padding:1.5rem;color:#fff;box-shadow:0 8px 24px rgba(30,58,138,.25);position:relative;overflow:hidden;height:100%;}
        .balance-highlight::after{content:'';position:absolute;right:-30px;top:-30px;width:140px;height:140px;background:rgba(255,255,255,.06);border-radius:50%;}
        .balance-highlight::before{content:'';position:absolute;right:40px;bottom:-20px;width:90px;height:90px;background:rgba(255,255,255,.04);border-radius:50%;}

        .charge-banner{background:linear-gradient(135deg,#fef3c7,#fde68a);border:1px solid #f59e0b;border-radius:12px;padding:1rem 1.25rem;margin-bottom:1.25rem;}

        .summary-bar{background:#fff;border-radius:14px;border:1px solid rgba(30,58,138,.08);padding:1.1rem 1.4rem;margin-bottom:1.25rem;box-shadow:0 2px 8px rgba(30,58,138,.05);}
        .summary-item{display:flex;flex-direction:column;align-items:center;text-align:center;padding:.5rem .75rem;}
        .summary-item .label{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:#64748b;margin-bottom:.25rem;}
        .summary-item .value{font-size:1rem;font-weight:700;}
        .summary-divider{width:1px;background:#e2e8f0;align-self:stretch;margin:.25rem 0;}

        .filter-wrap{background:#fff;border-radius:12px;padding:.9rem 1.1rem;margin-bottom:1.1rem;border:1px solid rgba(30,58,138,.08);box-shadow:0 2px 6px rgba(30,58,138,.04);}
        .page-header{background:#fff;border-radius:14px;padding:1.4rem 1.6rem;margin-bottom:1.25rem;border:1px solid rgba(30,58,138,.08);box-shadow:0 2px 8px rgba(30,58,138,.05);}
        .balance-pill{background:#eff6ff;border:2px solid #bfdbfe;border-radius:50px;padding:.45rem 1.1rem;color:var(--primary);font-weight:700;font-size:.9rem;display:inline-flex;align-items:center;gap:.45rem;}

        /* ══ TABLE ══ */
        .table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
        table.earn-table{width:100%;min-width:790px;border-collapse:separate;border-spacing:0;}
        table.earn-table thead th{background:#f8faff;color:var(--primary);font-weight:700;font-size:.73rem;text-transform:uppercase;letter-spacing:.04em;padding:.75rem .85rem;border-bottom:2px solid rgba(30,58,138,.1);white-space:nowrap;position:sticky;top:0;z-index:2;}
        table.earn-table tbody td{padding:.75rem .85rem;font-size:.875rem;vertical-align:middle;border-bottom:1px solid #f1f5f9;}
        table.earn-table tbody tr:last-child td{border-bottom:none;}
        table.earn-table tbody tr:hover td{background:#fafbff;}
        .amount-in{color:#059669;font-weight:700;}
        .amount-out{color:#dc2626;font-weight:700;}
        .balance-cell{color:#1e3a8a;font-weight:600;font-size:.82rem;}

        .type-chip{display:inline-block;padding:.22rem .6rem;border-radius:6px;font-size:.7rem;font-weight:700;text-transform:capitalize;white-space:nowrap;}
        .chip-operating_charge{background:#fef3c7;color:#92400e;}
        .chip-staff_payment{background:#fee2e2;color:#991b1b;}
        .chip-expense{background:#fce7f3;color:#9d174d;}
        .chip-external_income{background:#f3e8ff;color:#6b21a8;}
        .chip-manual_credit{background:#d1fae5;color:#065f46;}
        .chip-manual_debit{background:#fee2e2;color:#991b1b;}
        .chip-interest_income{background:#dbeafe;color:#1e40af;}
        .chip-other_income{background:#e0f2fe;color:#0369a1;}
        .chip-other_expense{background:#fce7f3;color:#9d174d;}
        .dir-in{background:#d1fae5;color:#065f46;padding:.2rem .55rem;border-radius:5px;font-size:.7rem;font-weight:700;}
        .dir-out{background:#fee2e2;color:#991b1b;padding:.2rem .55rem;border-radius:5px;font-size:.7rem;font-weight:700;}
        .row-charge td{background:#fffbeb !important;}
        .row-charge:hover td{background:#fef9c3 !important;}
        .charge-source-tag{display:inline-flex;align-items:center;gap:4px;background:#fef3c7;border:1px solid #fde68a;color:#92400e;padding:.18rem .5rem;border-radius:5px;font-size:.68rem;font-weight:700;}

        .btn-view-entry{width:32px;height:32px;border-radius:8px;border:1px solid rgba(30,58,138,.15);background:#fff;color:var(--primary);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;font-size:.8rem;}
        .btn-view-entry:hover{background:var(--primary);color:#fff;border-color:var(--primary);transform:translateY(-1px);}

        .btn-primary{background:var(--primary);border:none;padding:.5rem 1.2rem;border-radius:9px;font-weight:600;}
        .btn-primary:hover{background:var(--primary-dark);}
        .form-control,.form-select{border-radius:8px;border:1.5px solid #e2e8f0;font-size:.875rem;}
        .form-control:focus,.form-select:focus{border-color:var(--primary-light);box-shadow:0 0 0 3px rgba(59,130,246,.12);}
        .form-label{font-weight:600;font-size:.85rem;color:#374151;}
        .modal-content{border-radius:14px;border:none;}
        .modal-header{border-radius:14px 14px 0 0;border-bottom:1px solid #e2e8f0;}
        .modal-header.credit{background:#ecfdf5;} .modal-header.credit h5{color:#065f46;}
        .modal-header.expense-hdr{background:#fef9c3;} .modal-header.expense-hdr h5{color:#92400e;}
        .modal-header.view-hdr{background:#eff6ff;} .modal-header.view-hdr h5{color:var(--primary);}

        /* ══ View Entry modal ══ */
        .view-amount-block{background:#f8faff;border-radius:12px;padding:1.1rem;text-align:center;margin-bottom:1rem;}
        .view-amount-block .amt{font-size:1.9rem;font-weight:800;letter-spacing:-.5px;}
        .view-source-card{background:#f8faff;border:1px solid rgba(30,58,138,.08);border-radius:12px;padding:.9rem 1.05rem;margin-bottom:.75rem;}
        .view-source-card .vs-label{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;margin-bottom:.35rem;}
        .view-source-card .vs-name{font-size:.95rem;font-weight:700;color:#1e293b;}
        .view-source-card .vs-sub{font-size:.78rem;color:#64748b;margin-top:.1rem;}
        .view-row{display:flex;justify-content:space-between;align-items:center;padding:.5rem 0;border-bottom:1px solid #f1f5f9;font-size:.85rem;}
        .view-row:last-child{border-bottom:none;}
        .view-row .vr-label{color:#64748b;font-weight:600;}
        .view-row .vr-value{color:#1e293b;font-weight:700;text-align:right;}
        .view-loading{text-align:center;padding:2.5rem 1rem;color:#94a3b8;}
        .view-loading i{font-size:1.8rem;margin-bottom:.6rem;display:block;}

        .powered-by{position:fixed;bottom:15px;right:15px;background:#fff;padding:9px 15px;border-radius:25px;box-shadow:0 4px 15px rgba(30,58,138,.12);font-size:.78rem;font-weight:600;color:var(--primary);z-index:1000;}
        .toast-container{position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%);z-index:9999;}
        .empty-state{text-align:center;padding:3rem 1rem;color:#94a3b8;}
        .empty-state i{font-size:2.5rem;opacity:.35;display:block;margin-bottom:.75rem;}

        @media(max-width:992px){
            .sidebar{transform:translateX(-100%);}
            .sidebar.active{transform:translateX(0);}
            .top-navbar{left:0;}
            .main-content{margin-left:0;padding:1rem;}
        }
        @media(max-width:768px){
            :root{--navbar-h:60px;}
            .main-content{padding:.75rem;}
            table.earn-table thead th{font-size:.67rem;padding:.6rem;}
            table.earn-table tbody td{font-size:.8rem;padding:.6rem;}
            .export-dropdown-menu{right:auto;left:0;}
        }
        .pagination .page-link{border-radius:7px;margin:0 2px;color:var(--primary);border-color:#e2e8f0;font-size:.85rem;}
        .pagination .page-item.active .page-link{background:var(--primary);border-color:var(--primary);}
    </style>
</head>
<body>

<!-- ════════════════════════ SIDEBAR ════════════════════════ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-row">
            <div class="logo-box">C</div>
            <div><div class="sidebar-brand">Club De Stars<small>Admin Panel</small></div></div>
        </div>
        <div class="role-pill">
            <i class="fas fa-shield-alt" style="font-size:.65rem;"></i>&nbsp;<%= admin.role?.name?.toUpperCase() || 'SUPER ADMIN' %>
        </div>
    </div>
    <div class="sidebar-nav">
        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-home" style="font-size:.6rem;"></i>Main</div>
            <a href="/admin/dashboard"><i class="fas fa-chart-pie"></i>Overview</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-users" style="font-size:.6rem;"></i>Members</div>
            <a href="/admin/manage-members"><i class="fas fa-users"></i>Manage Members</a>
            <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i>Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i>Membership Types</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-exchange-alt" style="font-size:.6rem;"></i>Transactions</div>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i>Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i>Approvals<span id="sidebarPendingBadge" class="nav-badge" style="display:none;">0</span></a>
            <a href="/admin/manage-deposit"><i class="fas fa-coins"></i>Deposits</a>
            <a href="/admin/kiddies-deposits"><i class="fas fa-piggy-bank"></i>Kiddies Deposits</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i>Withdrawals</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-hand-holding-usd" style="font-size:.6rem;"></i>Loans</div>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i>Loan Management</a>
            <a href="/admin/loan-payments"><i class="fas fa-file-invoice-dollar"></i>Loan Payments</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i>Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i>External Loans</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-landmark" style="font-size:.6rem;"></i>Finance</div>
            <a href="/admin/finance"><i class="fas fa-landmark"></i>Company Finance</a>
            <a href="/admin/operating-earnings" class="active"><i class="fas fa-chart-line"></i>Operating Earnings</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-chart-bar"></i>Company Revenue</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-cog" style="font-size:.6rem;"></i>System</div>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i>Manage Subscriptions</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i>Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i>Settings</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-file-alt" style="font-size:.6rem;"></i>Reporting</div>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i>Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i>Admin Logs</a>
        </div>
    </div>
    <a href="/cds-cooperative/dashboard" class="nav-back"><i class="fas fa-arrow-left"></i>Back to Dashboard</a>
</div>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- ── Top Navbar ── -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.4rem;" onclick="toggleSidebar(event)"></i>
    <div class="flex-grow-1">
        <h6 class="mb-0 fw-bold" style="color:var(--primary);">Operating Earnings</h6>
        <small class="text-muted d-none d-sm-block">Welcome, <%= admin.fullName || admin.firstName %></small>
    </div>
</div>

<!-- ── Main Content ── -->
<div class="main-content">

    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h2 class="fw-bold mb-1" style="color:var(--primary);font-size:1.3rem;">
                <i class="fas fa-chart-line me-2"></i>Operating Earnings
            </h2>
            <p class="text-muted mb-0" style="font-size:.82rem;">All company operating income and expenses — loan charges, staff salaries, admin entries &amp; more</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <div class="balance-pill"><i class="fas fa-coins"></i>Operating Balance: ₦<%= operatingBalance.toLocaleString() %></div>
            <button class="btn btn-success btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#incomeModal">
                <i class="fas fa-plus-circle me-1"></i>Add Income
            </button>
            <button class="btn btn-warning btn-sm fw-semibold text-white" data-bs-toggle="modal" data-bs-target="#expenseModal">
                <i class="fas fa-minus-circle me-1"></i>Record Expense
            </button>
        </div>
    </div>

    <!-- Loan Operating Charge Banner -->
    <div class="charge-banner d-flex flex-wrap align-items-center gap-3 mb-3">
        <div style="background:#d97706;border-radius:10px;width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fas fa-percentage text-white" style="font-size:1.1rem;"></i>
        </div>
        <div class="flex-grow-1">
            <div class="fw-bold" style="color:#92400e;font-size:.9rem;">Loan Operating Charges — Auto-Recorded</div>
            <div style="font-size:.78rem;color:#a16207;">
                Every approved loan automatically captures an operating charge from the interest earned.
                Current rate: <strong><%= roiOperatingCharge %>%</strong> of total loan interest goes to operating earnings.
            </div>
        </div>
        <div class="text-end flex-shrink-0">
            <div style="font-size:.7rem;color:#92400e;font-weight:700;text-transform:uppercase;letter-spacing:.04em;">This Month's Charges</div>
            <div style="font-size:1.2rem;font-weight:800;color:#92400e;">₦<%= monthlyCharges.toLocaleString() %></div>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-2 mb-3">
        <div class="col-12 col-md-4 col-lg-3">
            <div class="balance-highlight">
                <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;opacity:.7;margin-bottom:.5rem;">Operating Balance</div>
                <div style="font-size:1.65rem;font-weight:800;letter-spacing:-.5px;position:relative;z-index:1;">₦<%= operatingBalance.toLocaleString() %></div>
                <div style="font-size:.78rem;opacity:.7;margin-top:.5rem;position:relative;z-index:1;">Net of all income &amp; expenses</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-arrow-down"></i></div>
                <p class="text-muted mb-1 fw-semibold" style="font-size:.72rem;"><%= (filterFrom||filterTo) ? 'Period Income' : 'Total Income' %></p>
                <h5 class="mb-0 fw-bold amount-in">₦<%= periodIn.toLocaleString() %></h5>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon" style="background:#fee2e2;color:#b91c1c;"><i class="fas fa-arrow-up"></i></div>
                <p class="text-muted mb-1 fw-semibold" style="font-size:.72rem;"><%= (filterFrom||filterTo) ? 'Period Expenses' : 'Total Expenses' %></p>
                <h5 class="mb-0 fw-bold amount-out">₦<%= periodOut.toLocaleString() %></h5>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon" style="background:#fef9c3;color:#a16207;"><i class="fas fa-percentage"></i></div>
                <p class="text-muted mb-1 fw-semibold" style="font-size:.72rem;">Loan Charges (All Time)</p>
                <h5 class="mb-0 fw-bold" style="color:#d97706;">₦<%= totalLoanCharges.toLocaleString() %></h5>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:#fee2e2;color:#b91c1c;"><i class="fas fa-users-cog"></i></div>
                <p class="text-muted mb-1 fw-semibold" style="font-size:.72rem;">Staff Payments (All Time)</p>
                <h5 class="mb-0 fw-bold amount-out">₦<%= totalStaffPayments.toLocaleString() %></h5>
            </div>
        </div>
    </div>

    <!-- Period summary bar -->
    <% if(filterFrom || filterTo) { %>
    <div class="summary-bar d-flex flex-wrap align-items-center gap-0 mb-3">
        <div class="summary-item"><span class="label">Period</span><span class="value" style="font-size:.85rem;color:#475569;"><%= filterFrom || '—' %> → <%= filterTo || 'Today' %></span></div>
        <div class="summary-divider d-none d-sm-block"></div>
        <div class="summary-item"><span class="label">Opening Balance</span><span class="value" style="color:var(--primary);">₦<%= openingBalance.toLocaleString() %></span></div>
        <div class="summary-divider d-none d-sm-block"></div>
        <div class="summary-item"><span class="label">+ Income</span><span class="value amount-in">₦<%= periodIn.toLocaleString() %></span></div>
        <div class="summary-divider d-none d-sm-block"></div>
        <div class="summary-item"><span class="label">− Expenses</span><span class="value amount-out">₦<%= periodOut.toLocaleString() %></span></div>
        <div class="summary-divider d-none d-sm-block"></div>
        <div class="summary-item"><span class="label">Closing Balance</span><span class="value fw-bold" style="color:var(--primary);font-size:1.05rem;">₦<%= closingBalance.toLocaleString() %></span></div>
    </div>
    <% } %>

    <!-- Filters -->
    <div class="filter-wrap mb-3">
        <form method="GET" action="/admin/operating-earnings">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label mb-1" style="font-size:.72rem;">Type</label>
                    <select name="type" class="form-select form-select-sm">
                        <option value="">All Types</option>
                        <option value="operating_charge" <%=filterType==='operating_charge'?'selected':''%>>Loan Op. Charge</option>
                        <option value="interest_income"  <%=filterType==='interest_income'?'selected':''%>>Interest Income</option>
                        <option value="external_income"  <%=filterType==='external_income'?'selected':''%>>External Income</option>
                        <option value="manual_credit"    <%=filterType==='manual_credit'?'selected':''%>>Manual Credit</option>
                        <option value="other_income"     <%=filterType==='other_income'?'selected':''%>>Other Income</option>
                        <option value="staff_payment"    <%=filterType==='staff_payment'?'selected':''%>>Staff Payment</option>
                        <option value="expense"          <%=filterType==='expense'?'selected':''%>>General Expense</option>
                        <option value="manual_debit"     <%=filterType==='manual_debit'?'selected':''%>>Manual Debit</option>
                        <option value="other_expense"    <%=filterType==='other_expense'?'selected':''%>>Other Expense</option>
                    </select>
                </div>
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label mb-1" style="font-size:.72rem;">Direction</label>
                    <select name="direction" class="form-select form-select-sm">
                        <option value="">All</option>
                        <option value="in"  <%=filterDirection==='in'?'selected':''%>>In (Income)</option>
                        <option value="out" <%=filterDirection==='out'?'selected':''%>>Out (Expense)</option>
                    </select>
                </div>
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label mb-1" style="font-size:.72rem;">From</label>
                    <input type="date" name="from" value="<%=filterFrom%>" class="form-control form-control-sm">
                </div>
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label mb-1" style="font-size:.72rem;">To</label>
                    <input type="date" name="to" value="<%=filterTo%>" class="form-control form-control-sm">
                </div>
                <div class="col-12 col-sm-8 col-md-4">
                    <label class="form-label mb-1 d-none d-md-block" style="font-size:.72rem;">&nbsp;</label>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search me-1"></i>Filter</button>
                        <a href="/admin/operating-earnings" class="btn btn-outline-secondary btn-sm"><i class="fas fa-times me-1"></i>Reset</a>
                        <!-- Client-side export dropdown -->
                        <div class="export-wrapper">
                            <button type="button" class="btn-export" id="exportBtn" onclick="toggleExportMenu(event)">
                                <i class="fas fa-download"></i>Export<i class="fas fa-chevron-down caret"></i>
                            </button>
                            <div class="export-dropdown-menu" id="exportMenu" style="display:none;">
                                <div class="drop-header">Current View</div>
                                <a class="drop-item" onclick="exportExcel();closeExportMenu();return false;">
                                    <i class="fas fa-file-excel" style="color:#10b981;font-size:.95rem;"></i>Excel — All Entries
                                </a>
                                <a class="drop-item" onclick="exportPDF();closeExportMenu();return false;">
                                    <i class="fas fa-file-pdf" style="color:#ef4444;font-size:.95rem;"></i>PDF — All Entries
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Ledger Table -->
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h6><i class="fas fa-table me-2"></i>Operating Earnings Ledger</h6>
            <small class="text-muted"><%= totalEntries %> total entries &nbsp;|&nbsp; Page <%= currentPage %> of <%= totalPages %></small>
        </div>
        <div class="card-body p-0">
            <div class="table-wrap">
                <table class="earn-table" id="earningsTable">
                    <thead>
                        <tr>
                            <th>#</th><th>Date</th><th>Type</th><th>Dir</th>
                            <th>Amount</th><th>Balance</th><th>Source / Staff</th>
                            <th>Description</th><th>Recorded By</th><th>Source</th>
                        </tr>
                    </thead>
                    <tbody>
                    <% if(entries.length === 0) { %>
                        <tr><td colspan="10"><div class="empty-state"><i class="fas fa-chart-line"></i><p class="fw-semibold mb-1">No entries found</p><small>Try adjusting your filters or add a new entry</small></div></td></tr>
                    <% } else { %>
                    <% entries.forEach((e, i) => { %>
                        <tr class="<%= e.type==='operating_charge' ? 'row-charge' : '' %>"
                            data-id="<%= e._id %>"
                            data-type="<%= e.type %>"
                            data-direction="<%= e.direction %>"
                            data-amount="<%= e.amount %>"
                            data-balance="<%= e.runningBalance %>"
                            data-date="<%= new Date(e.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}) %>"
                            data-time="<%= new Date(e.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'}) %>"
                            data-desc="<%= (e.description||'').replace(/"/g,'&quot;') %>"
                            data-source="<%= e.type==='staff_payment'&&e.meta?.staffName ? e.meta.staffName+(e.meta.staffRole?' · '+e.meta.staffRole:'') : e.relatedUser ? e.relatedUser.firstName+' '+e.relatedUser.lastName+' ('+e.relatedUser.membershipID+')' : '' %>"
                            data-by="<%= e.recordedBy ? (e.recordedBy.fullName||[e.recordedBy.firstName,e.recordedBy.lastName].filter(Boolean).join(' ')||'—') : 'System' %>"
                            data-loan="<%= e.relatedLoan ? e.relatedLoan.toString().slice(-6).toUpperCase() : '' %>">
                            <td class="text-muted" style="font-size:.75rem;"><%= (currentPage-1)*perPage + i + 1 %></td>
                            <td style="white-space:nowrap;">
                                <div style="font-size:.8rem;font-weight:600;"><%= new Date(e.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}) %></div>
                                <div style="font-size:.72rem;color:#94a3b8;"><%= new Date(e.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'}) %></div>
                            </td>
                            <td>
                                <span class="type-chip chip-<%= e.type %>"><%= e.type.replace(/_/g,' ') %></span>
                                <% if(e.type==='operating_charge' && e.relatedLoan) { %>
                                <div class="mt-1"><span class="charge-source-tag"><i class="fas fa-link" style="font-size:.6rem;"></i>Loan #<%= e.relatedLoan.toString().slice(-6).toUpperCase() %></span></div>
                                <% } %>
                            </td>
                            <td>
                                <% if(e.direction==='in') { %><span class="dir-in"><i class="fas fa-arrow-down me-1"></i>In</span>
                                <% } else { %><span class="dir-out"><i class="fas fa-arrow-up me-1"></i>Out</span><% } %>
                            </td>
                            <td class="<%= e.direction==='in' ? 'amount-in' : 'amount-out' %>" style="white-space:nowrap;">
                                <%= e.direction==='in' ? '+' : '-' %>₦<%= e.amount.toLocaleString() %>
                            </td>
                            <td class="balance-cell" style="white-space:nowrap;">₦<%= e.runningBalance.toLocaleString() %></td>
                            <td>
                                <% if(e.type==='staff_payment' && e.meta && e.meta.staffName) { %>
                                    <div style="font-size:.8rem;font-weight:600;"><%= e.meta.staffName %></div>
                                    <% if(e.meta.staffRole) { %><div style="font-size:.7rem;color:#94a3b8;"><%= e.meta.staffRole %></div><% } %>
                                    <% if(e.meta.paymentPeriod) { %><div style="font-size:.68rem;color:#94a3b8;"><%= e.meta.paymentPeriod %></div><% } %>
                                <% } else if(e.relatedUser) { %>
                                    <div style="font-size:.8rem;font-weight:600;white-space:nowrap;"><%= e.relatedUser.firstName %> <%= e.relatedUser.lastName %></div>
                                    <div style="font-size:.7rem;color:#94a3b8;"><%= e.relatedUser.membershipID %></div>
                                <% } else { %><span class="text-muted" style="font-size:.8rem;">—</span><% } %>
                            </td>
                            <td style="max-width:160px;">
                                <span style="font-size:.8rem;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= e.description %>">
                                    <%= e.description ? e.description.substring(0,50)+(e.description.length>50?'…':'') : '—' %>
                                </span>
                            </td>
                            <td style="white-space:nowrap;">
                                <% if(e.recordedBy) { %>
                                    <span style="font-size:.78rem;color:#475569;font-weight:600;">
                                        <%= e.recordedBy.fullName || [e.recordedBy.firstName, e.recordedBy.lastName].filter(Boolean).join(' ') || '—' %>
                                    </span>
                                <% } else { %><span style="font-size:.78rem;color:#94a3b8;">System</span><% } %>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn-view-entry" title="View source of this entry" onclick="viewEntryDetails('<%= e._id %>')">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if(totalPages > 1) { %>
        <div class="card-footer bg-white" style="border-radius:0 0 14px 14px;border-top:1px solid #f1f5f9;padding:.9rem;">
            <nav>
                <ul class="pagination pagination-sm mb-0 justify-content-center flex-wrap">
                    <li class="page-item <%=currentPage<=1?'disabled':''%>">
                        <a class="page-link" href="?page=<%=currentPage-1%>&type=<%=filterType%>&direction=<%=filterDirection%>&from=<%=filterFrom%>&to=<%=filterTo%>"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    <% for(let p=Math.max(1,currentPage-2); p<=Math.min(totalPages,currentPage+2); p++) { %>
                    <li class="page-item <%=p===currentPage?'active':''%>">
                        <a class="page-link" href="?page=<%=p%>&type=<%=filterType%>&direction=<%=filterDirection%>&from=<%=filterFrom%>&to=<%=filterTo%>"><%=p%></a>
                    </li>
                    <% } %>
                    <li class="page-item <%=currentPage>=totalPages?'disabled':''%>">
                        <a class="page-link" href="?page=<%=currentPage+1%>&type=<%=filterType%>&direction=<%=filterDirection%>&from=<%=filterFrom%>&to=<%=filterTo%>"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
        <% } %>
    </div>

</div><!-- /main-content -->

