<div class="powered-by">Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
/* ══ Sidebar ══ */
function toggleSidebar(e) { e.stopPropagation(); document.getElementById('sidebar').classList.toggle('active'); document.getElementById('sidebarOverlay').classList.toggle('active'); }
function closeSidebar()   { document.getElementById('sidebar').classList.remove('active'); document.getElementById('sidebarOverlay').classList.remove('active'); }
document.addEventListener('click', e => {
    const sb = document.getElementById('sidebar');
    if (window.innerWidth <= 992 && !sb.contains(e.target) && !e.target.closest('.fa-bars') && sb.classList.contains('active')) closeSidebar();
    if (!e.target.closest('.export-wrapper')) closeExportMenu();
});
async function loadSidebarPendingCount() {
    try {
        const res = await fetch('/admin/pending-approvals-count');
        const data = await res.json();
        const badge = document.getElementById('sidebarBadge'); if (!badge) return;
        badge.style.display = data.count > 0 ? 'inline-block' : 'none';
        if (data.count > 0) badge.textContent = data.count;
    } catch {}
}

/* ══ Export dropdown ══ */
function toggleExportMenu(e) {
    e.stopPropagation();
    const menu = document.getElementById('exportMenu');
    const btn  = document.getElementById('exportBtn');
    const open = menu.style.display !== 'none';
    menu.style.display = open ? 'none' : 'block';
    btn.classList.toggle('open', !open);
}
function closeExportMenu() {
    document.getElementById('exportMenu').style.display = 'none';
    document.getElementById('exportBtn').classList.remove('open');
}

/* ══ Read rows from table (current page) ══ */
function getRows() {
    const rows = [];
    document.querySelectorAll('#earningsTable tbody tr[data-type]').forEach((tr, i) => {
        const d = tr.dataset;
        rows.push({
            '#':             i + 1,
            'Date':          d.date,
            'Time':          d.time,
            'Type':          d.type.replace(/_/g, ' '),
            'Direction':     d.direction === 'in' ? 'In (Income)' : 'Out (Expense)',
            'Amount (₦)':    Number(d.amount),
            'Running Balance (₦)': Number(d.balance),
            'Source / Staff': d.source || '—',
            'Linked Loan':   d.loan   || '—',
            'Description':   d.desc   || '—',
            'Recorded By':   d.by,
        });
    });
    return rows;
}

/* ══ Excel export ══ */
function exportExcel() {
    const rows = getRows();
    if (!rows.length) { alert('No entries on this page to export.'); return; }
    const now = new Date().toLocaleString('en-US', {year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit'});
    const totalIn  = rows.filter(r => r['Direction'].startsWith('In')).reduce((s,r) => s + r['Amount (₦)'], 0);
    const totalOut = rows.filter(r => r['Direction'].startsWith('Out')).reduce((s,r) => s + r['Amount (₦)'], 0);

    const ws = XLSX.utils.json_to_sheet(rows);
    ws['!cols'] = [{wch:4},{wch:14},{wch:8},{wch:18},{wch:14},{wch:16},{wch:20},{wch:24},{wch:14},{wch:36},{wch:22}];

    /* Header styling */
    const range = XLSX.utils.decode_range(ws['!ref']);
    for (let C = range.s.c; C <= range.e.c; C++) {
        const addr = XLSX.utils.encode_cell({r:0,c:C});
        if (!ws[addr]) continue;
        ws[addr].s = { fill:{fgColor:{rgb:'1E3A8A'}}, font:{bold:true,color:{rgb:'FFFFFF'},sz:9}, alignment:{horizontal:'center',wrapText:true} };
    }
    /* Row striping + number format */
    for (let R = 1; R <= range.e.r; R++) {
        const fill = R%2===0 ? 'EEF2FF' : 'FFFFFF';
        for (let C = range.s.c; C <= range.e.c; C++) {
            const addr = XLSX.utils.encode_cell({r:R,c:C});
            if (!ws[addr]) ws[addr] = {v:'',t:'s'};
            ws[addr].s = { fill:{fgColor:{rgb:fill}}, alignment:{vertical:'center'}, border:{bottom:{style:'thin',color:{rgb:'E0E7FF'}}} };
        }
        [5,6].forEach(C => { // amount + balance columns
            const addr = XLSX.utils.encode_cell({r:R,c:C});
            if (ws[addr] && typeof ws[addr].v === 'number') { ws[addr].t = 'n'; ws[addr].z = '#,##0.00'; }
        });
    }

    /* Summary sheet */
    const summaryData = [
        ['Club De Stars — Operating Earnings Export', ''],
        ['Generated', now],
        ['Page Entries', rows.length],
        ['', ''],
        ['SUMMARY', ''],
        ['Total Income (this page)',   totalIn],
        ['Total Expenses (this page)', totalOut],
        ['Net (this page)',            totalIn - totalOut],
        ['', ''],
        ['BY TYPE', ''],
        ...Object.entries(rows.reduce((acc, r) => { acc[r['Type']] = (acc[r['Type']]||0) + 1; return acc; }, {})).map(([k,v]) => [k, v]),
    ];
    const ws2 = XLSX.utils.aoa_to_sheet(summaryData);
    ws2['!cols'] = [{wch:32},{wch:20}];

    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Operating Earnings');
    XLSX.utils.book_append_sheet(wb, ws2, 'Summary');
    XLSX.writeFile(wb, `CDS_OperatingEarnings_${new Date().toISOString().split('T')[0]}.xlsx`);
}

