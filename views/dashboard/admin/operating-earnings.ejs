<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club De Stars – Operating Earnings</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        :root {
            --primary:#1e3a8a; --primary-dark:#1e40af; --primary-light:#3b82f6;
            --success:#10b981; --danger:#ef4444; --warning:#f59e0b;
            --sidebar-width:280px;
        }
        *{margin:0;padding:0;box-sizing:border-box;}
        body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f1f5f9;min-height:100vh;overflow-x:hidden;}

        .sidebar{position:fixed;left:0;top:0;bottom:0;width:var(--sidebar-width);background:#1e3a8a;color:#fff;z-index:1040;transition:all .3s;overflow-y:auto;box-shadow:4px 0 20px rgba(30,58,138,.15);}
        .sidebar-header{padding:1.5rem;border-bottom:1px solid rgba(255,255,255,.1);background:rgba(0,0,0,.1);}
        .logo-container{display:flex;align-items:center;gap:12px;margin-bottom:8px;}
        .logo-box{width:45px;height:45px;background:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--primary);font-size:1.5rem;box-shadow:0 4px 10px rgba(0,0,0,.2);flex-shrink:0;}
        .admin-badge{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;background:rgba(239,68,68,.2);border-radius:20px;border:1px solid rgba(239,68,68,.3);font-weight:600;font-size:.8rem;margin-top:8px;}
        .sidebar-menu{padding:1rem 0;}
        .sidebar-menu a{color:rgba(255,255,255,.85);text-decoration:none;padding:.875rem 1.5rem;display:flex;align-items:center;transition:all .3s;border-left:3px solid transparent;font-weight:500;font-size:.95rem;}
        .sidebar-menu a:hover,.sidebar-menu a.active{background:rgba(255,255,255,.15);color:#fff;border-left-color:#fff;}
        .sidebar-menu a i{width:24px;margin-right:12px;font-size:1.1rem;flex-shrink:0;}

        .top-navbar{position:fixed;top:0;left:var(--sidebar-width);right:0;height:70px;background:rgba(255,255,255,.97);box-shadow:0 2px 10px rgba(30,58,138,.08);z-index:1030;display:flex;align-items:center;padding:0 1.5rem;border-bottom:1px solid rgba(30,58,138,.1);}
        .main-content{margin-left:var(--sidebar-width);margin-top:70px;padding:1.5rem;min-height:calc(100vh - 70px);}

        .card{border:1px solid rgba(30,58,138,.07);border-radius:14px;box-shadow:0 4px 12px rgba(30,58,138,.06);background:#fff;}
        .card-header{background:#f8faff;border-bottom:1px solid rgba(30,58,138,.1);padding:1rem 1.25rem;border-radius:14px 14px 0 0 !important;}
        .card-header h5,.card-header h6{color:var(--primary);font-weight:700;margin:0;}

        .stat-card{background:#fff;border-radius:14px;padding:1.25rem;border:1px solid rgba(30,58,138,.07);box-shadow:0 4px 12px rgba(30,58,138,.06);height:100%;}
        .stat-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;margin-bottom:.8rem;}

        .balance-highlight{background:linear-gradient(135deg,#1e3a8a 0%,#1e40af 60%,#2563eb 100%);border-radius:16px;padding:1.5rem;color:#fff;box-shadow:0 8px 24px rgba(30,58,138,.25);position:relative;overflow:hidden;height:100%;}
        .balance-highlight::after{content:'';position:absolute;right:-30px;top:-30px;width:140px;height:140px;background:rgba(255,255,255,.06);border-radius:50%;}
        .balance-highlight::before{content:'';position:absolute;right:40px;bottom:-20px;width:90px;height:90px;background:rgba(255,255,255,.04);border-radius:50%;}

        .charge-banner{background:linear-gradient(135deg,#fef3c7,#fde68a);border:1px solid #f59e0b;border-radius:12px;padding:1rem 1.25rem;margin-bottom:1.25rem;}

        .summary-bar{background:#fff;border-radius:14px;border:1px solid rgba(30,58,138,.08);padding:1.1rem 1.4rem;margin-bottom:1.25rem;box-shadow:0 2px 8px rgba(30,58,138,.05);}
        .summary-item{display:flex;flex-direction:column;align-items:center;text-align:center;padding:.5rem .75rem;}
        .summary-item .label{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:#64748b;margin-bottom:.25rem;}
        .summary-item .value{font-size:1rem;font-weight:700;}
        .summary-divider{width:1px;background:#e2e8f0;align-self:stretch;margin:.25rem 0;}

        .filter-wrap{background:#fff;border-radius:12px;padding:.9rem 1.1rem;margin-bottom:1.1rem;border:1px solid rgba(30,58,138,.08);box-shadow:0 2px 6px rgba(30,58,138,.04);}

        .table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
        table.earn-table{width:100%;min-width:720px;border-collapse:separate;border-spacing:0;}
        table.earn-table thead th{background:#f8faff;color:var(--primary);font-weight:700;font-size:.73rem;text-transform:uppercase;letter-spacing:.04em;padding:.75rem .85rem;border-bottom:2px solid rgba(30,58,138,.1);white-space:nowrap;position:sticky;top:0;z-index:2;}
        table.earn-table tbody td{padding:.75rem .85rem;font-size:.875rem;vertical-align:middle;border-bottom:1px solid #f1f5f9;}
        table.earn-table tbody tr:last-child td{border-bottom:none;}
        table.earn-table tbody tr:hover td{background:#fafbff;}

        .amount-in{color:#059669;font-weight:700;}
        .amount-out{color:#dc2626;font-weight:700;}
        .balance-cell{color:#1e3a8a;font-weight:600;font-size:.82rem;}

        .type-chip{display:inline-block;padding:.22rem .6rem;border-radius:6px;font-size:.7rem;font-weight:700;text-transform:capitalize;white-space:nowrap;}
        .chip-operating_charge{background:#fef3c7;color:#92400e;}
        .chip-staff_payment{background:#fee2e2;color:#991b1b;}
        .chip-expense{background:#fce7f3;color:#9d174d;}
        .chip-external_income{background:#f3e8ff;color:#6b21a8;}
        .chip-manual_credit{background:#d1fae5;color:#065f46;}
        .chip-manual_debit{background:#fee2e2;color:#991b1b;}
        .chip-interest_income{background:#dbeafe;color:#1e40af;}
        .chip-other_income{background:#e0f2fe;color:#0369a1;}
        .chip-other_expense{background:#fce7f3;color:#9d174d;}

        .dir-in{background:#d1fae5;color:#065f46;padding:.2rem .55rem;border-radius:5px;font-size:.7rem;font-weight:700;}
        .dir-out{background:#fee2e2;color:#991b1b;padding:.2rem .55rem;border-radius:5px;font-size:.7rem;font-weight:700;}

        .row-charge td{background:#fffbeb !important;}
        .row-charge:hover td{background:#fef9c3 !important;}

        .charge-source-tag{display:inline-flex;align-items:center;gap:4px;background:#fef3c7;border:1px solid #fde68a;color:#92400e;padding:.18rem .5rem;border-radius:5px;font-size:.68rem;font-weight:700;}

        .page-header{background:#fff;border-radius:14px;padding:1.4rem 1.6rem;margin-bottom:1.25rem;border:1px solid rgba(30,58,138,.08);box-shadow:0 2px 8px rgba(30,58,138,.05);}
        .balance-pill{background:#eff6ff;border:2px solid #bfdbfe;border-radius:50px;padding:.45rem 1.1rem;color:var(--primary);font-weight:700;font-size:.9rem;display:inline-flex;align-items:center;gap:.45rem;}

        .btn-primary{background:var(--primary);border:none;padding:.5rem 1.2rem;border-radius:9px;font-weight:600;}
        .btn-primary:hover{background:var(--primary-dark);}
        .form-control,.form-select{border-radius:8px;border:1.5px solid #e2e8f0;font-size:.875rem;}
        .form-control:focus,.form-select:focus{border-color:var(--primary-light);box-shadow:0 0 0 3px rgba(59,130,246,.12);}
        .form-label{font-weight:600;font-size:.85rem;color:#374151;}
        .modal-content{border-radius:14px;border:none;}
        .modal-header{border-radius:14px 14px 0 0;border-bottom:1px solid #e2e8f0;}
        .modal-header.credit{background:#ecfdf5;} .modal-header.credit h5{color:#065f46;}
        .modal-header.expense-hdr{background:#fef9c3;} .modal-header.expense-hdr h5{color:#92400e;}

        .powered-by{position:fixed;bottom:15px;right:15px;background:#fff;padding:9px 15px;border-radius:25px;box-shadow:0 4px 15px rgba(30,58,138,.12);font-size:.78rem;font-weight:600;color:var(--primary);z-index:1000;}
        .toast-container{position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%);z-index:9999;}
        .empty-state{text-align:center;padding:3rem 1rem;color:#94a3b8;}
        .empty-state i{font-size:2.5rem;opacity:.35;display:block;margin-bottom:.75rem;}

        @media(max-width:992px){
            .sidebar{transform:translateX(-100%);}
            .sidebar.active{transform:translateX(0);}
            .top-navbar{left:0;}
            .main-content{margin-left:0;padding:1rem;}
        }
        @media(max-width:768px){
            .top-navbar{height:60px;padding:0 1rem;}
            .main-content{margin-top:60px;padding:.75rem;}
            table.earn-table thead th{font-size:.67rem;padding:.6rem;}
            table.earn-table tbody td{font-size:.8rem;padding:.6rem;}
        }
        .pagination .page-link{border-radius:7px;margin:0 2px;color:var(--primary);border-color:#e2e8f0;font-size:.85rem;}
        .pagination .page-item.active .page-link{background:var(--primary);border-color:var(--primary);}
    </style>
</head>
<body>

<!-- ── Sidebar ── -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-container">
            <div class="logo-box">C</div>
            <div>
                <h5 class="mb-0 fw-bold" style="text-transform:uppercase;font-size:1rem;">Club De Stars</h5>
                <small class="opacity-75" style="font-size:.7rem;">ADMIN PANEL</small>
            </div>
        </div>
        <div class="admin-badge"><i class="fas fa-shield-alt"></i><span>SuperAdmin</span></div>
    </div>
    <div class="sidebar-menu">
        <a href="/admin-dashboard"><i class="fas fa-users"></i> Members</a>
        <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i> Kiddies Accounts</a>
        <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i> Membership Types</a>
        <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i> Payments</a>
        <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i> Approvals<span id="sidebarPendingBadge" class="badge bg-danger ms-1" style="display:none;">0</span></a>
        <a href="/admin/manage-deposits"><i class="fas fa-coins"></i> Deposit Management</a>
        <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i> Withdrawals</a>
        <a href="/admin/manage-extra-charges"><i class="fas fa-hand-holding-usd"></i> Extra Charges</a>
        <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i> Loan Management</a>
        <a href="/admin/loan/settings"><i class="fas fa-cogs"></i> Loan Settings</a>
        <a href="/admin/external-loans"><i class="fas fa-building"></i> External Loans</a>
        <a href="/admin/finance"><i class="fas fa-landmark"></i> Company Finance</a>
        <a href="/admin/operating-earnings" class="active"><i class="fas fa-chart-line"></i> Operating Earnings</a>
        <a href="#"><i class="fas fa-chart-pie"></i> ROI Distribution</a>
        <a href="/manage-subscriptions"><i class="fas fa-cube"></i> Manage Subscription</a>
        <a href="/manage-roles"><i class="fas fa-user-shield"></i> Roles &amp; Permissions</a>
        <a href="/admin/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/admin/reports"><i class="fas fa-file-alt"></i> Reports</a>
        <a href="/admin/logs"><i class="fas fa-history"></i> Admin Logs</a>
        <a href="/cds-cooperative/dashboard" class="mt-3" style="color:rgba(255,255,255,.6);"><i class="fas fa-sign-in-alt"></i> Back to Dashboard</a>
    </div>
</div>

<!-- ── Top Navbar ── -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.4rem;"
       onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
    <div class="flex-grow-1">
        <h6 class="mb-0 fw-bold" style="color:var(--primary);">Operating Earnings</h6>
        <small class="text-muted d-none d-sm-block">Welcome, <%= admin.fullName %></small>
    </div>
    <div class="position-relative">
        <i class="fas fa-bell" style="color:var(--primary);font-size:1.2rem;cursor:pointer;"></i>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.6rem;">5</span>
    </div>
</div>

<!-- ── Main Content ── -->
<div class="main-content">

    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h2 class="fw-bold mb-1" style="color:var(--primary);font-size:1.3rem;">
                <i class="fas fa-chart-line me-2"></i>Operating Earnings
            </h2>
            <p class="text-muted mb-0" style="font-size:.82rem;">All company operating income and expenses — loan charges, staff salaries, admin entries &amp; more</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <div class="balance-pill">
                <i class="fas fa-coins"></i>
                Operating Balance: ₦<%= operatingBalance.toLocaleString() %>
            </div>
            <button class="btn btn-success btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#incomeModal">
                <i class="fas fa-plus-circle me-1"></i>Add Income
            </button>
            <button class="btn btn-warning btn-sm fw-semibold text-white" data-bs-toggle="modal" data-bs-target="#expenseModal">
                <i class="fas fa-minus-circle me-1"></i>Record Expense
            </button>
        </div>
    </div>

    <!-- Loan Operating Charge Banner -->
    <div class="charge-banner d-flex flex-wrap align-items-center gap-3 mb-3">
        <div style="background:#d97706;border-radius:10px;width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fas fa-percentage text-white" style="font-size:1.1rem;"></i>
        </div>
        <div class="flex-grow-1">
            <div class="fw-bold" style="color:#92400e;font-size:.9rem;">Loan Operating Charges — Auto-Recorded</div>
            <div style="font-size:.78rem;color:#a16207;">
                Every approved loan automatically captures an operating charge from the interest earned and logs it here as income.
                Current rate: <strong><%= roiOperatingCharge %>%</strong> of total loan interest goes to operating earnings.
            </div>
        </div>
        <div class="text-end flex-shrink-0">
            <div style="font-size:.7rem;color:#92400e;font-weight:700;text-transform:uppercase;letter-spacing:.04em;">This Month's Charges</div>
            <div style="font-size:1.2rem;font-weight:800;color:#92400e;">₦<%= monthlyCharges.toLocaleString() %></div>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-2 mb-3">
        <div class="col-12 col-md-4 col-lg-3">
            <div class="balance-highlight">
                <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;opacity:.7;margin-bottom:.5rem;">Operating Balance</div>
                <div style="font-size:1.65rem;font-weight:800;letter-spacing:-.5px;position:relative;z-index:1;">₦<%= operatingBalance.toLocaleString() %></div>
                <div style="font-size:.78rem;opacity:.7;margin-top:.5rem;position:relative;z-index:1;">Net of all income &amp; expenses</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-arrow-down"></i></div>
                <p class="text-muted mb-1 fw-semibold" style="font-size:.72rem;"><%= (filterFrom||filterTo) ? 'Period Income' : 'Total Income' %></p>
                <h5 class="mb-0 fw-bold amount-in">₦<%= periodIn.toLocaleString() %></h5>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon" style="background:#fee2e2;color:#b91c1c;"><i class="fas fa-arrow-up"></i></div>
                <p class="text-muted mb-1 fw-semibold" style="font-size:.72rem;"><%= (filterFrom||filterTo) ? 'Period Expenses' : 'Total Expenses' %></p>
                <h5 class="mb-0 fw-bold amount-out">₦<%= periodOut.toLocaleString() %></h5>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon" style="background:#fef9c3;color:#a16207;"><i class="fas fa-percentage"></i></div>
                <p class="text-muted mb-1 fw-semibold" style="font-size:.72rem;">Loan Charges (All Time)</p>
                <h5 class="mb-0 fw-bold" style="color:#d97706;">₦<%= totalLoanCharges.toLocaleString() %></h5>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:#fee2e2;color:#b91c1c;"><i class="fas fa-users-cog"></i></div>
                <p class="text-muted mb-1 fw-semibold" style="font-size:.72rem;">Staff Payments (All Time)</p>
                <h5 class="mb-0 fw-bold amount-out">₦<%= totalStaffPayments.toLocaleString() %></h5>
            </div>
        </div>
    </div>

    <!-- Period summary bar (only when date filter active) -->
    <% if(filterFrom || filterTo) { %>
    <div class="summary-bar d-flex flex-wrap align-items-center gap-0 mb-3">
        <div class="summary-item">
            <span class="label">Period</span>
            <span class="value" style="font-size:.85rem;color:#475569;"><%= filterFrom || '—' %> → <%= filterTo || 'Today' %></span>
        </div>
        <div class="summary-divider d-none d-sm-block"></div>
        <div class="summary-item">
            <span class="label">Opening Balance</span>
            <span class="value" style="color:var(--primary);">₦<%= openingBalance.toLocaleString() %></span>
        </div>
        <div class="summary-divider d-none d-sm-block"></div>
        <div class="summary-item">
            <span class="label">+ Income</span>
            <span class="value amount-in">₦<%= periodIn.toLocaleString() %></span>
        </div>
        <div class="summary-divider d-none d-sm-block"></div>
        <div class="summary-item">
            <span class="label">− Expenses</span>
            <span class="value amount-out">₦<%= periodOut.toLocaleString() %></span>
        </div>
        <div class="summary-divider d-none d-sm-block"></div>
        <div class="summary-item">
            <span class="label">Closing Balance</span>
            <span class="value fw-bold" style="color:var(--primary);font-size:1.05rem;">₦<%= closingBalance.toLocaleString() %></span>
        </div>
    </div>
    <% } %>

    <!-- Filters -->
    <div class="filter-wrap mb-3">
        <form method="GET" action="/admin/operating-earnings">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label mb-1" style="font-size:.72rem;">Type</label>
                    <select name="type" class="form-select form-select-sm">
                        <option value="">All Types</option>
                        <option value="operating_charge" <%=filterType==='operating_charge'?'selected':''%>>Loan Op. Charge</option>
                        <option value="interest_income"  <%=filterType==='interest_income'?'selected':''%>>Interest Income</option>
                        <option value="external_income"  <%=filterType==='external_income'?'selected':''%>>External Income</option>
                        <option value="manual_credit"    <%=filterType==='manual_credit'?'selected':''%>>Manual Credit</option>
                        <option value="other_income"     <%=filterType==='other_income'?'selected':''%>>Other Income</option>
                        <option value="staff_payment"    <%=filterType==='staff_payment'?'selected':''%>>Staff Payment</option>
                        <option value="expense"          <%=filterType==='expense'?'selected':''%>>General Expense</option>
                        <option value="manual_debit"     <%=filterType==='manual_debit'?'selected':''%>>Manual Debit</option>
                        <option value="other_expense"    <%=filterType==='other_expense'?'selected':''%>>Other Expense</option>
                    </select>
                </div>
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label mb-1" style="font-size:.72rem;">Direction</label>
                    <select name="direction" class="form-select form-select-sm">
                        <option value="">All</option>
                        <option value="in"  <%=filterDirection==='in'?'selected':''%>>In (Income)</option>
                        <option value="out" <%=filterDirection==='out'?'selected':''%>>Out (Expense)</option>
                    </select>
                </div>
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label mb-1" style="font-size:.72rem;">From</label>
                    <input type="date" name="from" value="<%=filterFrom%>" class="form-control form-control-sm">
                </div>
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label mb-1" style="font-size:.72rem;">To</label>
                    <input type="date" name="to" value="<%=filterTo%>" class="form-control form-control-sm">
                </div>
                <div class="col-12 col-sm-8 col-md-4">
                    <label class="form-label mb-1 d-none d-md-block" style="font-size:.72rem;">&nbsp;</label>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search me-1"></i>Filter</button>
                        <a href="/admin/operating-earnings" class="btn btn-outline-secondary btn-sm"><i class="fas fa-times me-1"></i>Reset</a>
                        <a href="/admin/operating-earnings/export/csv?type=<%=filterType%>&direction=<%=filterDirection%>&from=<%=filterFrom%>&to=<%=filterTo%>"
                           class="btn btn-outline-success btn-sm"><i class="fas fa-file-csv me-1"></i>CSV</a>
                        <a href="/admin/operating-earnings/export/pdf?type=<%=filterType%>&direction=<%=filterDirection%>&from=<%=filterFrom%>&to=<%=filterTo%>"
                           target="_blank" class="btn btn-outline-danger btn-sm"><i class="fas fa-file-pdf me-1"></i>PDF</a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Ledger Table -->
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h6><i class="fas fa-table me-2"></i>Operating Earnings Ledger</h6>
            <small class="text-muted"><%= totalEntries %> total entries &nbsp;|&nbsp; Page <%= currentPage %> of <%= totalPages %></small>
        </div>
        <div class="card-body p-0">
            <div class="table-wrap">
                <table class="earn-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Dir</th>
                            <th>Amount</th>
                            <th>Balance</th>
                            <th>Source / Staff</th>
                            <th>Description</th>
                            <th>Recorded By</th>
                        </tr>
                    </thead>
                    <tbody>
                    <% if(entries.length === 0) { %>
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    <i class="fas fa-chart-line"></i>
                                    <p class="fw-semibold mb-1">No entries found</p>
                                    <small>Try adjusting your filters or add a new entry</small>
                                </div>
                            </td>
                        </tr>
                    <% } else { %>
                    <% entries.forEach((e, i) => { %>
                        <tr class="<%= e.type==='operating_charge' ? 'row-charge' : '' %>">
                            <td class="text-muted" style="font-size:.75rem;"><%= (currentPage-1)*perPage + i + 1 %></td>
                            <td style="white-space:nowrap;">
                                <div style="font-size:.8rem;font-weight:600;">
                                    <%= new Date(e.createdAt).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'}) %>
                                </div>
                                <div style="font-size:.72rem;color:#94a3b8;">
                                    <%= new Date(e.createdAt).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'}) %>
                                </div>
                            </td>
                            <td>
                                <span class="type-chip chip-<%= e.type %>">
                                    <%= e.type.replace(/_/g,' ') %>
                                </span>
                                <% if(e.type==='operating_charge' && e.relatedLoan) { %>
                                <div class="mt-1">
                                    <span class="charge-source-tag">
                                        <i class="fas fa-link" style="font-size:.6rem;"></i>
                                        Loan #<%= e.relatedLoan.toString().slice(-6).toUpperCase() %>
                                    </span>
                                </div>
                                <% } %>
                            </td>
                            <td>
                                <% if(e.direction==='in') { %>
                                    <span class="dir-in"><i class="fas fa-arrow-down me-1"></i>In</span>
                                <% } else { %>
                                    <span class="dir-out"><i class="fas fa-arrow-up me-1"></i>Out</span>
                                <% } %>
                            </td>
                            <td class="<%= e.direction==='in' ? 'amount-in' : 'amount-out' %>" style="white-space:nowrap;">
                                <%= e.direction==='in' ? '+' : '-' %>₦<%= e.amount.toLocaleString() %>
                            </td>
                            <td class="balance-cell" style="white-space:nowrap;">₦<%= e.runningBalance.toLocaleString() %></td>
                            <td>
                                <% if(e.type==='staff_payment' && e.meta && e.meta.staffName) { %>
                                    <div style="font-size:.8rem;font-weight:600;"><%= e.meta.staffName %></div>
                                    <% if(e.meta.staffRole) { %><div style="font-size:.7rem;color:#94a3b8;"><%= e.meta.staffRole %></div><% } %>
                                    <% if(e.meta.paymentPeriod) { %><div style="font-size:.68rem;color:#94a3b8;"><%= e.meta.paymentPeriod %></div><% } %>
                                <% } else if(e.relatedUser) { %>
                                    <div style="font-size:.8rem;font-weight:600;white-space:nowrap;"><%= e.relatedUser.firstName %> <%= e.relatedUser.lastName %></div>
                                    <div style="font-size:.7rem;color:#94a3b8;"><%= e.relatedUser.membershipID %></div>
                                <% } else { %>
                                    <span class="text-muted" style="font-size:.8rem;">—</span>
                                <% } %>
                            </td>
                            <td style="max-width:160px;">
                                <span style="font-size:.8rem;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= e.description %>">
                                    <%= e.description ? e.description.substring(0,50)+(e.description.length>50?'…':'') : '—' %>
                                </span>
                            </td>
                            <td style="white-space:nowrap;">
                                <% if(e.recordedBy) { %>
                                    <span style="font-size:.78rem;color:#475569;font-weight:600;">
                                        <%= e.recordedBy.fullName || (e.recordedBy.firstName+' '+e.recordedBy.lastName) %>
                                    </span>
                                <% } else { %>
                                    <span style="font-size:.78rem;color:#94a3b8;">System</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if(totalPages > 1) { %>
        <div class="card-footer bg-white" style="border-radius:0 0 14px 14px;border-top:1px solid #f1f5f9;padding:.9rem;">
            <nav>
                <ul class="pagination pagination-sm mb-0 justify-content-center flex-wrap">
                    <li class="page-item <%=currentPage<=1?'disabled':''%>">
                        <a class="page-link" href="?page=<%=currentPage-1%>&type=<%=filterType%>&direction=<%=filterDirection%>&from=<%=filterFrom%>&to=<%=filterTo%>">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                    <% for(let p=Math.max(1,currentPage-2); p<=Math.min(totalPages,currentPage+2); p++) { %>
                    <li class="page-item <%=p===currentPage?'active':''%>">
                        <a class="page-link" href="?page=<%=p%>&type=<%=filterType%>&direction=<%=filterDirection%>&from=<%=filterFrom%>&to=<%=filterTo%>"><%=p%></a>
                    </li>
                    <% } %>
                    <li class="page-item <%=currentPage>=totalPages?'disabled':''%>">
                        <a class="page-link" href="?page=<%=currentPage+1%>&type=<%=filterType%>&direction=<%=filterDirection%>&from=<%=filterFrom%>&to=<%=filterTo%>">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
        <% } %>
    </div>

</div><!-- /main-content -->

<!-- ── Add Income Modal ── -->
<div class="modal fade" id="incomeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header credit">
                <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2 text-success"></i>Add Operating Income</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="incomeForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Income Type <span class="text-danger">*</span></label>
                        <select class="form-select" name="type" required>
                            <option value="" disabled selected>Select type</option>
                            <option value="manual_credit">Manual Credit</option>
                            <option value="external_income">External Income</option>
                            <option value="interest_income">Interest Income</option>
                            <option value="other_income">Other Income</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount (₦) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="amount" min="1" placeholder="e.g. 50000" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="description" rows="3" placeholder="Source or reason for this income..." required></textarea>
                    </div>
                    <div id="incomeError" class="alert alert-danger d-none py-2" style="font-size:.85rem;border-radius:9px;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-semibold" id="incomeSubmitBtn">
                        <i class="fas fa-check-circle me-1"></i>Confirm Income
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Record Expense Modal ── -->
<div class="modal fade" id="expenseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header expense-hdr">
                <h5 class="modal-title fw-bold"><i class="fas fa-minus-circle me-2" style="color:#d97706;"></i>Record Expense / Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="expenseForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Expense Type <span class="text-danger">*</span></label>
                        <select class="form-select" name="type" id="expenseTypeSelect" required onchange="toggleStaffFields()">
                            <option value="" disabled selected>Select type</option>
                            <option value="staff_payment">Staff Payment / Salary</option>
                            <option value="expense">General Expense</option>
                            <option value="manual_debit">Manual Debit</option>
                            <option value="other_expense">Other Expense</option>
                        </select>
                    </div>

                    <!-- Staff fields — shown only for staff_payment -->
                    <div id="staffFields" style="display:none;">
                        <div class="mb-3 p-3" style="background:#fff8f0;border-radius:10px;border:1px solid #fed7aa;">
                            <div class="fw-semibold mb-2" style="font-size:.83rem;color:#9a3412;"><i class="fas fa-user-tie me-1"></i>Staff Details</div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label" style="font-size:.8rem;">Staff Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm" name="staffName" placeholder="Full name" id="staffNameInput">
                                </div>
                                <div class="col-6">
                                    <label class="form-label" style="font-size:.8rem;">Role / Position</label>
                                    <input type="text" class="form-control form-control-sm" name="staffRole" placeholder="e.g. Accountant">
                                </div>
                                <div class="col-12">
                                    <label class="form-label" style="font-size:.8rem;">Payment Period</label>
                                    <input type="text" class="form-control form-control-sm" name="paymentPeriod" placeholder="e.g. March 2025">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Amount (₦) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="amount" min="1" placeholder="e.g. 80000" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="description" rows="3" placeholder="Details for this expense..." required></textarea>
                    </div>
                    <div class="alert py-2 mb-0" style="background:#fef2f2;border:1.5px solid #fca5a5;border-radius:9px;color:#991b1b;font-size:.82rem;">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        This will <strong>deduct</strong> from the operating balance.
                    </div>
                    <div id="expenseError" class="alert alert-danger d-none py-2 mt-2" style="font-size:.85rem;border-radius:9px;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-semibold text-white" id="expenseSubmitBtn">
                        <i class="fas fa-paper-plane me-1"></i>Confirm Expense
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Toast ── -->
<div class="toast-container">
    <div id="mainToast" class="toast align-items-center border-0 text-white" style="border-radius:11px;min-width:270px;">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<div class="powered-by">Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

<script>
function showToast(msg, success=true) {
    const el = document.getElementById('mainToast');
    el.style.background = success ? '#059669' : '#dc2626';
    document.getElementById('toastMsg').textContent = msg;
    new bootstrap.Toast(el, { delay: 4000 }).show();
}

function toggleStaffFields() {
    const type = document.getElementById('expenseTypeSelect').value;
    const sf   = document.getElementById('staffFields');
    const sn   = document.getElementById('staffNameInput');
    if (type === 'staff_payment') { sf.style.display = 'block'; sn.required = true; }
    else                          { sf.style.display = 'none';  sn.required = false; }
}

function setupForm(formId, url, btnId, errId, modalId, defaultLabel) {
    document.getElementById(formId).addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById(btnId);
        const err = document.getElementById(errId);
        err.classList.add('d-none');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing…';
        const body = {};
        new FormData(e.target).forEach((v, k) => body[k] = v);
        try {
            const res  = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const data = await res.json();
            if (data.status) {
                bootstrap.Modal.getInstance(document.getElementById(modalId)).hide();
                e.target.reset();
                if (modalId === 'expenseModal') toggleStaffFields();
                showToast(data.message, true);
                setTimeout(() => location.reload(), 1600);
            } else {
                err.textContent = data.message || 'Something went wrong';
                err.classList.remove('d-none');
            }
        } catch (ex) {
            err.textContent = 'Network error. Please try again.';
            err.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.innerHTML = defaultLabel;
        }
    });
}

setupForm('incomeForm',  '/admin/operating-earnings/income',  'incomeSubmitBtn',  'incomeError',  'incomeModal',
    '<i class="fas fa-check-circle me-1"></i>Confirm Income');
setupForm('expenseForm', '/admin/operating-earnings/expense', 'expenseSubmitBtn', 'expenseError', 'expenseModal',
    '<i class="fas fa-paper-plane me-1"></i>Confirm Expense');
</script>
</body>
</html>
