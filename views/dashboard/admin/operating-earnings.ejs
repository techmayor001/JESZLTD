/* ══ Toast ══ */
function showToast(msg, success=true) {
    const el = document.getElementById('mainToast');
    el.style.background = success ? '#059669' : '#dc2626';
    document.getElementById('toastMsg').textContent = msg;
    new bootstrap.Toast(el, { delay: 4000 }).show();
}

/* ══ Staff fields toggle ══ */
function toggleStaffFields() {
    const type = document.getElementById('expenseTypeSelect').value;
    const sf   = document.getElementById('staffFields');
    const sn   = document.getElementById('staffNameInput');
    sf.style.display = type === 'staff_payment' ? 'block' : 'none';
    sn.required      = type === 'staff_payment';
}

/* ══ Form submit ══ */
function setupForm(formId, url, btnId, errId, modalId, defaultLabel) {
    document.getElementById(formId).addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById(btnId);
        const err = document.getElementById(errId);
        err.classList.add('d-none');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing…';
        const body = {};
        new FormData(e.target).forEach((v, k) => body[k] = v);
        try {
            const res  = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
            const data = await res.json();
            if (data.status) {
                bootstrap.Modal.getInstance(document.getElementById(modalId)).hide();
                e.target.reset();
                if (modalId === 'expenseModal') toggleStaffFields();
                showToast(data.message, true);
                setTimeout(() => location.reload(), 1600);
            } else {
                err.textContent = data.message || 'Something went wrong';
                err.classList.remove('d-none');
            }
        } catch (ex) {
            err.textContent = 'Network error. Please try again.';
            err.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.innerHTML = defaultLabel;
        }
    });
}

setupForm('incomeForm',  '/admin/operating-earnings/income',  'incomeSubmitBtn',  'incomeError',  'incomeModal',  '<i class="fas fa-check-circle me-1"></i>Confirm Income');
setupForm('expenseForm', '/admin/operating-earnings/expense', 'expenseSubmitBtn', 'expenseError', 'expenseModal', '<i class="fas fa-paper-plane me-1"></i>Confirm Expense');

/* ══ View Source / Entry Details ══ */
const viewEntryModalEl = document.getElementById('viewEntryModal');
const viewEntryModal   = new bootstrap.Modal(viewEntryModalEl);
const TYPE_LABELS = {
    operating_charge: 'Loan Operating Charge', staff_payment: 'Staff Payment / Salary',
    expense: 'General Expense', external_income: 'External Income', manual_credit: 'Manual Credit',
    manual_debit: 'Manual Debit', interest_income: 'Interest Income', other_income: 'Other Income',
    other_expense: 'Other Expense',
};
function fmtNaira(n) { return '₦' + Number(n || 0).toLocaleString('en-NG', { minimumFractionDigits: 2 }); }
function fmtDateTime(d) {
    if (!d) return '—';
    const dt = new Date(d);
    return dt.toLocaleDateString('en-NG', { day: '2-digit', month: 'short', year: 'numeric' }) +
           ' · ' + dt.toLocaleTimeString('en-NG', { hour: '2-digit', minute: '2-digit' });
}

async function viewEntryDetails(id) {
    const body = document.getElementById('viewEntryBody');
    body.innerHTML = `<div class="view-loading"><i class="fas fa-circle-notch fa-spin"></i>Loading entry details…</div>`;
    viewEntryModal.show();

    try {
        const res  = await fetch(`/admin/operating-earnings/entry/${id}`);
        const data = await res.json();

        if (!data.status) {
            body.innerHTML = `<div class="view-loading"><i class="fas fa-exclamation-circle" style="color:#ef4444;"></i>${data.message || 'Could not load this entry.'}</div>`;
            return;
        }

        const e       = data.entry;
        const isIn    = e.direction === 'in';
        const typeLbl = TYPE_LABELS[e.type] || e.type.replace(/_/g, ' ');

        /* Build the "source" block depending on entry type */
        let sourceHTML = '';
        if (e.type === 'staff_payment' && e.meta && e.meta.staffName) {
            sourceHTML = `
                <div class="view-source-card">
                    <div class="vs-label"><i class="fas fa-user-tie me-1"></i>Paid To</div>
                    <div class="vs-name">${e.meta.staffName}</div>
                    ${e.meta.staffRole ? `<div class="vs-sub">${e.meta.staffRole}</div>` : ''}
                    ${e.meta.paymentPeriod ? `<div class="vs-sub">Period: ${e.meta.paymentPeriod}</div>` : ''}
                </div>`;
        } else if (e.relatedUser) {
            const u = e.relatedUser;
            sourceHTML = `
                <div class="view-source-card">
                    <div class="vs-label"><i class="fas fa-user me-1"></i>${isIn ? 'Money Came From' : 'Related Member'}</div>
                    <div class="vs-name">${u.firstName || ''} ${u.lastName || ''}</div>
                    <div class="vs-sub">Membership ID: ${u.membershipID || '—'}</div>
                    ${u.email ? `<div class="vs-sub">${u.email}</div>` : ''}
                    ${u.phoneNumber ? `<div class="vs-sub">${u.phoneNumber}</div>` : ''}
                </div>`;
        } else if (e.type === 'operating_charge') {
            sourceHTML = `
                <div class="view-source-card">
                    <div class="vs-label"><i class="fas fa-percentage me-1"></i>Source</div>
                    <div class="vs-name">Auto-recorded from loan interest</div>
                    <div class="vs-sub">Captured automatically when a loan was approved</div>
                </div>`;
        } else {
            sourceHTML = `
                <div class="view-source-card">
                    <div class="vs-label"><i class="fas fa-info-circle me-1"></i>Source</div>
                    <div class="vs-name">Manually recorded entry</div>
                    <div class="vs-sub">No linked member or staff record</div>
                </div>`;
        }

        if (e.relatedLoan && e.relatedLoan._id) {
            sourceHTML += `
                <div class="view-source-card">
                    <div class="vs-label"><i class="fas fa-hand-holding-usd me-1"></i>Linked Loan</div>
                    <div class="vs-name">Loan #${e.relatedLoan._id.toString().slice(-6).toUpperCase()}</div>
                    ${e.relatedLoan.amount ? `<div class="vs-sub">Principal: ${fmtNaira(e.relatedLoan.amount)}</div>` : ''}
                    ${e.relatedLoan.status ? `<div class="vs-sub">Status: ${e.relatedLoan.status}</div>` : ''}
                </div>`;
        }

        const recordedByName = e.recordedBy
            ? (e.recordedBy.fullName || [e.recordedBy.firstName, e.recordedBy.lastName].filter(Boolean).join(' ') || '—')
            : 'System (Automated)';

        body.innerHTML = `
            <div class="view-amount-block">
                <span class="type-chip chip-${e.type}">${typeLbl}</span>
                <div class="amt ${isIn ? 'amount-in' : 'amount-out'}">${isIn ? '+' : '-'}${fmtNaira(e.amount)}</div>
                <div style="font-size:.78rem;color:#94a3b8;">${isIn ? 'Income · money coming in' : 'Expense · money going out'}</div>
            </div>
            ${sourceHTML}
            <div class="view-source-card" style="background:#fff;">
                <div class="vs-label"><i class="fas fa-align-left me-1"></i>Description</div>
                <div style="font-size:.85rem;color:#334155;">${e.description || '—'}</div>
            </div>
            <div class="view-row"><span class="vr-label">Date &amp; Time</span><span class="vr-value">${fmtDateTime(e.createdAt)}</span></div>
            <div class="view-row"><span class="vr-label">Running Balance After Entry</span><span class="vr-value">${fmtNaira(e.runningBalance)}</span></div>
            <div class="view-row"><span class="vr-label">Recorded By</span><span class="vr-value">${recordedByName}</span></div>
            <div class="view-row"><span class="vr-label">Entry ID</span><span class="vr-value" style="font-size:.72rem;color:#94a3b8;">${e._id}</span></div>
        `;
    } catch (ex) {
        body.innerHTML = `<div class="view-loading"><i class="fas fa-exclamation-circle" style="color:#ef4444;"></i>Network error. Please try again.</div>`;
    }
}

