                    <h5 class="modal-title fw-bold" style="color: var(--primary);">
                        <i class="fas fa-sync-alt me-2"></i>Record Payment
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="paymentForm">
                    <div class="modal-body">
                        <div id="renewalContent"></div>
                        
                        <!-- Payment Info -->
                        <div class="payment-info-box mt-3">
                            <h6 class="fw-bold mb-2" style="color: var(--primary);">
                                <i class="fas fa-university me-2"></i>Payment Details
                            </h6>
                            <div class="row g-2 small">
                                <div class="col-6"><strong>Bank Name:</strong></div>
                                <div class="col-6">OPAY</div>
                                <div class="col-6"><strong>Account Number:</strong></div>
                                <div class="col-6">6409765034</div>
                                <div class="col-6"><strong>Account Name:</strong></div>
                                <div class="col-6">Techmayor Company Limited</div>
                            </div>
                        </div>

                        <!-- Payment Confirmation Form -->
                        <div class="mt-3">
                            <h6 class="fw-bold mb-3">Payment Information</h6>
                            
                            <input type="hidden" id="serviceId" name="serviceId">
                            
                            <div class="mb-3">
                                <label class="form-label">Transaction Reference <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="transactionReference" name="transactionReference" 
                                       placeholder="Enter payment reference" required>
                                <small class="text-muted">Enter the bank transaction reference number</small>
