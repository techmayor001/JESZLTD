                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="color: var(--primary);">
                        <i class="fas fa-receipt me-2"></i>Payment Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
