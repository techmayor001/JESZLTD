                        <option value="<%= service.serviceKey %>"><%= service.name %></option>
                        <% }); %>
                    </select>
                </div>
            </div>
            <div class="card-body">
                <!-- Desktop Table View -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover" id="paymentTable">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Service</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Reference</th>
                                <th>Recorded By</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="paymentHistoryBody">
                            <% paymentHistory.forEach(function(payment) { 
                                let amountDisplay = '';
                                if (payment.currency === 'NGN') {
                                    amountDisplay = `₦${payment.amount.toLocaleString('en-NG', {minimumFractionDigits: 2})}`;
                                } else {
                                    amountDisplay = `$${payment.amount} (₦${payment.amountInNaira.toLocaleString('en-NG')})`;
                                }
                                
                                const statusColors = {
                                    'Paid': 'success',
                                    'Pending': 'warning',
                                    'Failed': 'danger',
                                    'Refunded': 'secondary'
                                };
                                const statusColor = statusColors[payment.status] || 'secondary';
                            %>
                            <tr data-service="<%= payment.service.serviceKey %>">
                                <td><%= new Date(payment.paymentDate).toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'}) %></td>
                                <td><%= payment.serviceName %></td>
                                <td><%= amountDisplay %></td>
                                <td><span class="badge bg-<%= statusColor %>"><%= payment.status %></span></td>
                                <td class="small"><%= payment.transactionReference %></td>
                                <td class="small"><%= payment.recordedBy ? payment.recordedBy.firstName + ' ' + payment.recordedBy.lastName : 'System' %></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" onclick='viewPaymentDetails(<%= JSON.stringify(payment) %>)'>
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div id="mobilePaymentsList" class="d-md-none">
                    <% paymentHistory.forEach(function(payment) { 
                        let amountDisplay = '';
                        if (payment.currency === 'NGN') {
                            amountDisplay = `₦${payment.amount.toLocaleString('en-NG', {minimumFractionDigits: 2})}`;
                        } else {
                            amountDisplay = `$${payment.amount} (₦${payment.amountInNaira.toLocaleString('en-NG')})`;
                        }
                        
                        const statusColors = {
                            'Paid': 'success',
                            'Pending': 'warning',
                            'Failed': 'danger',
                            'Refunded': 'secondary'
                        };
                        const statusColor = statusColors[payment.status] || 'secondary';
                    %>
                    <div class="mobile-payment-card" data-service="<%= payment.service.serviceKey %>">
                        <div class="mobile-payment-header">
                            <div>
                                <div class="mobile-payment-service"><%= payment.serviceName %></div>
                                <small class="text-muted"><%= new Date(payment.paymentDate).toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'}) %></small>
                            </div>
                            <span class="badge bg-<%= statusColor %>"><%= payment.status %></span>
                        </div>
                        <div class="mobile-payment-detail">
                            <span class="label">Amount:</span>
                            <span class="value text-primary"><%= amountDisplay %></span>
                        </div>
                        <div class="mobile-payment-detail">
                            <span class="label">Reference:</span>
                            <span class="value"><%= payment.transactionReference %></span>
                        </div>
                        <div class="mobile-payment-detail">
                            <span class="label">Recorded By:</span>
                            <span class="value"><%= payment.recordedBy ? payment.recordedBy.firstName + ' ' + payment.recordedBy.lastName : 'System' %></span>
                        </div>
                        <div class="mobile-payment-actions">
                            <button class="btn btn-outline-primary btn-sm w-100" onclick='viewPaymentDetails(<%= JSON.stringify(payment) %>)'>
                                <i class="fas fa-eye me-2"></i>View Details
                            </button>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>

    <!-- Calculator Modal -->
    <div class="modal fade" id="calculatorModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="color: var(--primary);">
                        <i class="fas fa-calculator me-2"></i>Payment Calculator
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Currency Toggle -->
                    <div class="currency-toggle">
                        <button class="currency-btn active" id="nairaBtn" onclick="setCurrency('NGN')">
                            <i class="fas fa-naira-sign me-1"></i> Naira (₦)
                        </button>
                        <button class="currency-btn" id="dollarBtn" onclick="setCurrency('USD')">
                            <i class="fas fa-dollar-sign me-1"></i> Dollar ($)
                        </button>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Exchange Rate:</strong> $1 = ₦<%= exchangeRate.toLocaleString() %>
                    </div>

                    <!-- Services Checklist -->
                    <div class="row g-3 mb-3">
                        <% services.forEach(function(service) { 
                            let priceDisplay = '';
                            if (service.currency === 'NGN') {
                                priceDisplay = `₦${service.price.toLocaleString('en-NG', {minimumFractionDigits: 2})}/${service.billingPeriod}`;
                            } else {
                                if (service.billingPeriod === 'month') {
                                    const yearlyUSD = service.price * 12;
                                    priceDisplay = `$${service.price}/month × 12 = $${yearlyUSD}`;
                                } else {
                                    priceDisplay = `$${service.price}/${service.billingPeriod}`;
                                }
                            }
                        %>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" 
                                       id="calc<%= service.serviceKey %>" 
                                       data-service="<%= service.serviceKey %>"
                                       data-price="<%= service.price %>"
                                       data-currency="<%= service.currency %>"
                                       data-period="<%= service.billingPeriod %>"
                                       onchange="calculateTotal()">
                                <label class="form-check-label fw-semibold" for="calc<%= service.serviceKey %>">
                                    <%= service.name %>
                                    <span class="text-muted small d-block"><%= priceDisplay %></span>
                                </label>
                            </div>
                        </div>
                        <% }); %>
                    </div>

                    <!-- Total Display -->
                    <div class="calculator-box text-center">
                        <h6 class="text-muted mb-2">TOTAL AMOUNT</h6>
                        <div class="price-display" id="totalAmount">₦0</div>
                        <div class="text-muted small mt-2" id="conversionNote"></div>
                    </div>

                    <!-- Payment Info -->
                    <div class="payment-info-box">
                        <h6 class="fw-bold mb-2" style="color: var(--primary);">
                            <i class="fas fa-university me-2"></i>Payment Information
                        </h6>
                        <div class="row g-2 small">
                            <div class="col-6"><strong>Bank Name:</strong></div>
                            <div class="col-6">OPAY</div>
                            <div class="col-6"><strong>Account Number:</strong></div>
                            <div class="col-6">6409765034</div>
                            <div class="col-6"><strong>Account Name:</strong></div>
                            <div class="col-6">Techmayor Company Limited</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
