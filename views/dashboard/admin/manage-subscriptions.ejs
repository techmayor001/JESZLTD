    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global Variables
        let currentCurrency = 'NGN';
        let currentService = null;
        const EXCHANGE_RATE = <%= exchangeRate %>;
        
        // Services data from backend
        const servicesData = <%- JSON.stringify(services) %>;
        
        // Summary data for timer
        const summaryData = <%- JSON.stringify(summary) %>;

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            updateCurrentDate();
            setTodayDate();
            updateCountdownTimer();
            // Update timer every hour
            setInterval(updateCountdownTimer, 3600000);
        });

        function updateCurrentDate() {
            const today = new Date();
            const options = { year: 'numeric', month: 'short', day: 'numeric' };
            document.getElementById('currentDate').textContent = today.toLocaleDateString('en-US', options);
        }

        function updateCountdownTimer() {
            if (!summaryData.nextRenewal || !summaryData.nextRenewal.nextRenewalDate) {
                return;
            }
            
            const now = new Date();
            const renewalDate = new Date(summaryData.nextRenewal.nextRenewalDate);
            const diffTime = renewalDate - now;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            const daysLeftElement = document.getElementById('daysLeft');
            if (daysLeftElement) {
                daysLeftElement.textContent = diffDays >= 0 ? diffDays : 0;
            }
            
            const progressElement = document.getElementById('timeProgress');
            if (progressElement && summaryData.nextRenewal.currentPeriodStart) {
                const startDate = new Date(summaryData.nextRenewal.currentPeriodStart);
                const totalPeriod = renewalDate - startDate;
                const elapsed = now - startDate;
                const progress = (elapsed / totalPeriod) * 100;
                progressElement.style.width = Math.min(100, Math.max(0, progress)) + '%';
            }
        }

        function setTodayDate() {
            const today = new Date().toISOString().split('T')[0];
            const paymentDateInput = document.getElementById('paymentDate');
            if (paymentDateInput) {
                paymentDateInput.value = today;
            }
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            sidebar.classList.toggle('active');
            overlay.classList.toggle('active');
        }

        function closeSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            sidebar.classList.remove('active');
            overlay.classList.remove('active');
        }

        function openCalculator() {
            const modal = new bootstrap.Modal(document.getElementById('calculatorModal'));
            modal.show();
            calculateTotal();
        }

        function setCurrency(currency) {
            currentCurrency = currency;
            
            const nairaBtn = document.getElementById('nairaBtn');
            const dollarBtn = document.getElementById('dollarBtn');
            
            if (currency === 'NGN') {
                nairaBtn.classList.add('active');
                dollarBtn.classList.remove('active');
            } else {
                dollarBtn.classList.add('active');
                nairaBtn.classList.remove('active');
            }
            
            calculateTotal();
        }

        function calculateTotal() {
            let totalNGN = 0;
            
            servicesData.forEach(function(service) {
                const checkbox = document.getElementById('calc' + service.serviceKey);
                if (checkbox && checkbox.checked) {
                    let servicePrice = service.price;
                    
                    // Convert to NGN if needed
                    if (service.currency === 'USD') {
                        if (service.billingPeriod === 'month') {
                            servicePrice = service.price * 12 * EXCHANGE_RATE;
                        } else {
                            servicePrice = service.price * EXCHANGE_RATE;
                        }
                    } else {
                        if (service.billingPeriod === 'month') {
                            servicePrice = service.price * 12;
                        }
                    }
                    
                    totalNGN += servicePrice;
                }
            });
            
            const totalElement = document.getElementById('totalAmount');
            const conversionNote = document.getElementById('conversionNote');
            
            if (currentCurrency === 'NGN') {
                totalElement.textContent = '₦' + totalNGN.toLocaleString('en-NG', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                conversionNote.textContent = '';
            } else {
                const usdTotal = totalNGN / EXCHANGE_RATE;
                totalElement.textContent = '$' + usdTotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                conversionNote.textContent = '≈ ₦' + totalNGN.toLocaleString('en-NG', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            }
        }

        function openRenewalModal(serviceKey) {
            const service = servicesData.find(s => s.serviceKey === serviceKey);
            
            if (!service) {
                showErrorModal('Error', 'Service not found');
                return;
            }
            
            currentService = service;
            
            let priceDisplay = '';
            let amountForPayment = service.price;
            let currencyForPayment = service.currency;
            
            if (service.currency === 'NGN') {
                if (service.billingPeriod === 'month') {
                    amountForPayment = service.price * 12;
                    priceDisplay = `₦${service.price.toLocaleString('en-NG', {minimumFractionDigits: 2})}/month (₦${amountForPayment.toLocaleString('en-NG')}/year)`;
                } else {
                    priceDisplay = `₦${service.price.toLocaleString('en-NG', {minimumFractionDigits: 2})}/${service.billingPeriod}`;
                }
            } else {
                const nairaPrice = service.price * EXCHANGE_RATE;
                if (service.billingPeriod === 'month') {
                    const yearlyUSD = service.price * 12;
                    amountForPayment = yearlyUSD;
                    const yearlyNGN = yearlyUSD * EXCHANGE_RATE;
                    priceDisplay = `$${service.price}/month ($${yearlyUSD}/year or ₦${yearlyNGN.toLocaleString('en-NG')}/year)`;
                } else {
                    priceDisplay = `$${service.price}/${service.billingPeriod} (₦${nairaPrice.toLocaleString('en-NG')})`;
                }
            }
            
            const content = `
                <div class="text-center mb-3">
                    <h5 class="fw-bold">${service.name}</h5>
                    <p class="text-muted">${service.provider}</p>
                </div>
                <div class="service-detail">
                    <span class="text-muted">Price:</span>
                    <span class="fw-bold text-primary">${priceDisplay}</span>
                </div>
                ${service.nextRenewalDate ? `
                <div class="service-detail">
                    <span class="text-muted">Due Date:</span>
                    <span class="fw-bold text-danger">${new Date(service.nextRenewalDate).toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'})}</span>
                </div>
                ` : ''}
                ${service.providerLink ? `
                <div class="service-detail">
                    <span class="text-muted">Provider Link:</span>
                    <a href="${service.providerLink}" target="_blank" class="fw-semibold">${service.provider} <i class="fas fa-external-link-alt"></i></a>
                </div>
                ` : ''}
            `;
            
            document.getElementById('renewalContent').innerHTML = content;
            document.getElementById('serviceId').value = service._id;
            document.getElementById('amount').value = amountForPayment;
            document.getElementById('currency').value = currencyForPayment;
            
            setTodayDate();
            
            const modal = new bootstrap.Modal(document.getElementById('renewalModal'));
            modal.show();
        }

        function viewPaymentDetails(payment) {
            let amountDisplay = '';
            if (payment.currency === 'NGN') {
                amountDisplay = `₦${payment.amount.toLocaleString('en-NG', {minimumFractionDigits: 2})}`;
            } else {
                amountDisplay = `$${payment.amount} (₦${payment.amountInNaira.toLocaleString('en-NG')})`;
            }
            
            const statusColors = {
                'Paid': 'success',
                'Pending': 'warning',
                'Failed': 'danger',
                'Refunded': 'secondary'
            };
            const statusColor = statusColors[payment.status] || 'secondary';
            
            const recordedByName = payment.recordedBy 
                ? `${payment.recordedBy.firstName} ${payment.recordedBy.lastName}` 
                : 'System';
            
            const recordedByEmail = payment.recordedBy 
                ? payment.recordedBy.email 
                : 'N/A';
            
            const content = `
                <div class="payment-details-grid">
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-calendar me-2"></i>Payment Date</div>
                        <div class="detail-value fw-bold">${new Date(payment.paymentDate).toLocaleDateString('en-US', {year: 'numeric', month: 'long', day: 'numeric'})}</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-cog me-2"></i>Service</div>
                        <div class="detail-value fw-bold">${payment.serviceName}</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-building me-2"></i>Provider</div>
                        <div class="detail-value">${payment.provider}</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-money-bill-wave me-2"></i>Amount</div>
                        <div class="detail-value text-primary fw-bold fs-5">${amountDisplay}</div>
                    </div>
                    ${payment.exchangeRate > 1 ? `
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-exchange-alt me-2"></i>Exchange Rate</div>
                        <div class="detail-value">$1 = ₦${payment.exchangeRate.toLocaleString('en-NG')}</div>
                    </div>
                    ` : ''}
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-check-circle me-2"></i>Status</div>
                        <div class="detail-value"><span class="badge bg-${statusColor}">${payment.status}</span></div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-hashtag me-2"></i>Transaction Reference</div>
                        <div class="detail-value fw-bold">${payment.transactionReference}</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-credit-card me-2"></i>Payment Method</div>
                        <div class="detail-value">${payment.paymentMethod}</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-university me-2"></i>Bank Details</div>
                        <div class="detail-value">
                            ${payment.bankDetails.bankName} - ${payment.bankDetails.accountNumber}<br>
                            <small class="text-muted">${payment.bankDetails.accountName}</small>
                        </div>
                    </div>
                    ${payment.renewalPeriod ? `
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-calendar-alt me-2"></i>Renewal Period</div>
                        <div class="detail-value">
                            ${new Date(payment.renewalPeriod.startDate).toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'})} 
                            - 
                            ${new Date(payment.renewalPeriod.endDate).toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'})}
                        </div>
                    </div>
                    ` : ''}
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-user me-2"></i>Recorded By</div>
                        <div class="detail-value">
                            ${recordedByName}<br>
                            <small class="text-muted">${recordedByEmail}</small>
                        </div>
                    </div>
                    ${payment.notes ? `
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-sticky-note me-2"></i>Notes</div>
                        <div class="detail-value">${payment.notes}</div>
                    </div>
                    ` : ''}
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-clock me-2"></i>Recorded On</div>
                        <div class="detail-value text-muted small">${new Date(payment.createdAt).toLocaleString('en-US', {year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'})}</div>
                    </div>
                </div>
            `;
            
            document.getElementById('paymentDetailsContent').innerHTML = content;
            
            const modal = new bootstrap.Modal(document.getElementById('paymentDetailsModal'));
            modal.show();
        }

        // Handle payment form submission
        document.getElementById('paymentForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const btn = document.getElementById('recordPaymentBtn');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
            
            const formData = {
                serviceId: document.getElementById('serviceId').value,
                transactionReference: document.getElementById('transactionReference').value,
                paymentDate: document.getElementById('paymentDate').value,
                amount: document.getElementById('amount').value,
                currency: document.getElementById('currency').value,
                notes: document.getElementById('notes').value
            };
            
            try {
                const response = await fetch('/admin/record-payment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(formData)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Close renewal modal
                    const renewalModal = bootstrap.Modal.getInstance(document.getElementById('renewalModal'));
                    renewalModal.hide();
                    
                    // Show success modal
                    showSuccessModal('Payment Recorded Successfully!', `Payment for ${currentService.name} has been recorded with reference: ${formData.transactionReference}`);
                } else {
                    showErrorModal('Payment Recording Failed', data.message || 'An error occurred while recording the payment');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (error) {
                console.error('Error:', error);
                showErrorModal('Network Error', 'Failed to connect to the server. Please try again.');
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });

        function showSuccessModal(title, message) {
            document.getElementById('successTitle').textContent = title;
            document.getElementById('successMessage').textContent = message;
            const modal = new bootstrap.Modal(document.getElementById('successModal'));
            modal.show();
        }

        function showErrorModal(title, message) {
            document.getElementById('errorTitle').textContent = title;
            document.getElementById('errorMessage').textContent = message;
            const modal = new bootstrap.Modal(document.getElementById('errorModal'));
            modal.show();
        }

        function filterPayments() {
            const filter = document.getElementById('serviceFilter').value;
            const desktopRows = document.querySelectorAll('#paymentHistoryBody tr');
            const mobileCards = document.querySelectorAll('#mobilePaymentsList .mobile-payment-card');
            
            // Filter desktop table
            desktopRows.forEach(row => {
                const serviceKey = row.getAttribute('data-service');
                if (filter === 'all' || serviceKey === filter) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Filter mobile cards
            mobileCards.forEach(card => {
                const serviceKey = card.getAttribute('data-service');
                if (filter === 'all' || serviceKey === filter) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>


<script>
async function loadSidebarPendingCount() {
  try {
    console.log("Loading sidebar approval count...");

    const res = await fetch('/admin/pending-approvals-count');
    const data = await res.json();

    console.log("Pending approvals count:", data);

    const badge = document.getElementById('sidebarPendingBadge');

    if (!badge) {
      console.log("Sidebar badge not found on page");
      return;
    }

    if (data.count > 0) {
      badge.style.display = 'inline-block';
      badge.textContent = data.count;
    } else {
      badge.style.display = 'none';
    }

  } catch (err) {
    console.error("Sidebar count error:", err);
  }
}

document.addEventListener("DOMContentLoaded", loadSidebarPendingCount);
</script>
</body>
</html>
