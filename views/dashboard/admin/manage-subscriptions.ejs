                </div>
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-check-circle" style="font-size: 4rem; color: var(--success);"></i>
                    </div>
                    <h5 class="fw-bold mb-2" id="successTitle">Success!</h5>
                    <p class="text-muted" id="successMessage"></p>
