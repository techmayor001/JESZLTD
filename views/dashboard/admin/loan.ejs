<script>
/* ============================
   FILTER + COUNTS (MERGED)
============================ */

function updateLoanCounts() {
    const rows = document.querySelectorAll("#loansTable tbody tr");

    const counts = {
        all: rows.length,
        pending: 0,
        approved: 0,
        rejected: 0,
        overdue: 0,
        rollover: 0
    };

    rows.forEach(row => {
        const status = row.dataset.status;
        if (counts.hasOwnProperty(status)) {
            counts[status]++;
        }
    });

    Object.keys(counts).forEach(status => {
        const el = document.getElementById(`count-${status}`);
        if (el) el.textContent = counts[status];
    });
}

function filterLoans(status, event) {
    // Active tab state
    document.querySelectorAll(".filter-tab").forEach(tab =>
        tab.classList.remove("active")
    );
    event.currentTarget.classList.add("active");

    const rows = document.querySelectorAll("#loansTable tbody tr");

    rows.forEach(row => {
        const rowStatus = row.dataset.status;
        row.style.display =
            status === "all" || rowStatus === status ? "" : "none";
    });
}

// Init on load
document.addEventListener("DOMContentLoaded", () => {
    updateLoanCounts();
});
</script>

<script>
function updateLoanStats() {
    const rows = document.querySelectorAll("#loansTable tbody tr");

    let pending = 0;
    let approved = 0;
    let overdue = 0;
    let rollover = 0;

    let approvedAmount = 0;
    let overdueAmount = 0;

    rows.forEach(row => {
        const status = row.dataset.status;
        const amount = Number(row.dataset.amount) || 0;

        switch (status) {
            case "pending":
                pending++;
                break;

            case "approved":
                approved++;
                approvedAmount += amount;
                break;

            case "overdue":
                overdue++;
                overdueAmount += amount;
                break;

            case "rollover":
                rollover++;
                break;
        }
    });

    // Update counts
    document.getElementById("stat-pending").textContent = pending;
    document.getElementById("stat-approved").textContent = approved;
    document.getElementById("stat-overdue").textContent = overdue;
    document.getElementById("stat-rollover").textContent = rollover;

    // Update amounts
    document.getElementById("stat-approved-amount").textContent =
        approvedAmount.toLocaleString();

    document.getElementById("stat-overdue-amount").textContent =
        overdueAmount.toLocaleString();
}

// Init
document.addEventListener("DOMContentLoaded", () => {
    updateLoanCounts();   // your filter counts
    updateLoanStats();    // stat cards
});
</script>

<script>
async function loadSidebarPendingCount() {
  try {
    console.log("Loading sidebar approval count...");

    const res = await fetch('/admin/pending-approvals-count');
    const data = await res.json();

    console.log("Pending approvals count:", data);

    const badge = document.getElementById('sidebarPendingBadge');

    if (!badge) {
      console.log("Sidebar badge not found on page");
      return;
    }

    if (data.count > 0) {
      badge.style.display = 'inline-block';
      badge.textContent = data.count;
    } else {
      badge.style.display = 'none';
    }

  } catch (err) {
    console.error("Sidebar count error:", err);
  }
}

document.addEventListener("DOMContentLoaded", loadSidebarPendingCount);
</script>
