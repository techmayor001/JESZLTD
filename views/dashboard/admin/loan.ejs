    <!-- Top Navbar -->
    <div class="top-navbar">
<i class="fas fa-bars d-lg-none me-3"
   style="cursor: pointer; color: var(--primary); font-size: 1.5rem;"
   onclick="toggleSidebar(event)">
</i>

        
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color: var(--primary)">Loan Management</h5>
            <small class="text-muted">Manage loan applications and active loans</small>
        </div>
        
        <!-- <div class="d-flex align-items-center gap-3">
            <div class="position-relative">
                <i class="fas fa-bell" style="color: var(--primary); font-size: 1.25rem; cursor: pointer;"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">15</span>
            </div>
        </div> -->
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Welcome Card -->
        <div class="welcome-card position-relative">
            <div class="row align-items-center position-relative" style="z-index: 1;">
                <div class="col-md-8">
                    <h2 class="mb-2 fw-bold">Loan Management Center</h2>
                    <p class="mb-3 opacity-90">Review applications, approve loans, and manage repayments</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <div class="badge bg-light text-dark">
                            <i class="fas fa-calendar me-1"></i>
                            <span id="currentDate"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <button class="btn btn-light fw-semibold" onclick="generateLoanReport()">
                        <i class="fas fa-download me-2"></i>Export Loan Report
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
<div class="row g-3 mb-4">

    <div class="col-lg-3 col-md-6 col-6">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                <i class="fas fa-file-invoice"></i>
            </div>
            <p class="text-muted mb-1 fw-semibold small">Pending Applications</p>
            <h3 class="mb-1 fw-bold" id="stat-pending">0</h3>
            <small class="text-warning fw-semibold">
                <i class="fas fa-clock me-1"></i>Needs Review
            </small>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-6">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                <i class="fas fa-check-circle"></i>
            </div>
            <p class="text-muted mb-1 fw-semibold small">Active Loans</p>
            <h3 class="mb-1 fw-bold" id="stat-approved">0</h3>
            <small class="text-success fw-semibold">
                <i class="fas fa-arrow-up me-1"></i>
                ₦<span id="stat-approved-amount">0</span>
            </small>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-6">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <p class="text-muted mb-1 fw-semibold small">Overdue Payments</p>
            <h3 class="mb-1 fw-bold" id="stat-overdue">0</h3>
            <small class="text-danger fw-semibold">
                <i class="fas fa-exclamation me-1"></i>
                ₦<span id="stat-overdue-amount">0</span>
            </small>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-6">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white;">
                <i class="fas fa-sync-alt"></i>
            </div>
            <p class="text-muted mb-1 fw-semibold small">Rollover Requests</p>
            <h3 class="mb-1 fw-bold" id="stat-rollover">0</h3>
            <small class="text-info fw-semibold">
                <i class="fas fa-clock me-1"></i>Pending
            </small>
        </div>
    </div>

</div>


      <div class="filter-tabs">
    <button class="filter-tab active" onclick="filterLoans('all', event)">
        <i class="fas fa-th-large me-1"></i>
        All Loans (<span id="count-all">0</span>)
    </button>

    <button class="filter-tab" onclick="filterLoans('pending', event)">
        <i class="fas fa-clock me-1"></i>
        Pending (<span id="count-pending">0</span>)
    </button>

    <button class="filter-tab" onclick="filterLoans('approved', event)">
        <i class="fas fa-check me-1"></i>
        Approved (<span id="count-approved">0</span>)
    </button>

    <button class="filter-tab" onclick="filterLoans('rejected', event)">
        <i class="fas fa-times me-1"></i>
        Rejected (<span id="count-rejected">0</span>)
    </button>

    <button class="filter-tab" onclick="filterLoans('overdue', event)">
        <i class="fas fa-exclamation-triangle me-1"></i>
        Overdue (<span id="count-overdue">0</span>)
    </button>

    <button class="filter-tab" onclick="filterLoans('rollover', event)">
        <i class="fas fa-sync-alt me-1"></i>
        Rollover (<span id="count-rollover">0</span>)
    </button>
</div>

        <!-- Loan Applications Table -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0 fw-bold" style="color: var(--primary);"><i class="fas fa-hand-holding-usd me-2"></i>Loan Applications</h5>
                <div class="d-flex gap-2 flex-wrap">
                    <input type="search" class="form-control form-control-sm" placeholder="Search loans..." style="max-width: 200px;" id="searchInput">
                    <select class="form-select form-select-sm" style="max-width: 150px;" onchange="sortLoans(this.value)">
                        <option value="date">Sort by Date</option>
                        <option value="amount">Sort by Amount</option>
                        <option value="member">Sort by Member</option>
                        <option value="status">Sort by Status</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="loansTable">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Member</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Interest</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        <% loans.forEach(loan => { %>

                            <% 
                                // Dynamic Account Type
                                const accType = loan?.user?.account?.accountType?.name || "Unknown";

                                // Badge text mapping
                                const isClub = accType.toLowerCase().includes("club"); 
                            %>

                        <tr class="loan-row" data-status="<%= loan.status.toLowerCase() %>">

                            <!-- DATE -->
                            <td>
                                <small class="fw-semibold">
                                    <%= loan.createdAt.toDateString() %>
                                </small>
                            </td>

                            <!-- BORROWER -->
                            <td>
                                <div class="fw-semibold">
                                    <%= loan.user
                                        ? (loan.user.firstName + ' ' + loan.user.lastName)
                                        : (loan.external?.borrowerName || 'External Loan')
                                    %>
                                </div>
                                <small class="text-muted">
                                    <%= loan.user
                                        ? loan.user.membershipID
                                        : (loan.external?.borrowerType
                                            ? loan.external.borrowerType.toUpperCase()
                                            : '')
                                    %>
                                </small>
                            </td>

                            <!-- ACCOUNT TYPE -->
                            <td>
                                <span class="badge <%= loan.user ? 'bg-success' : 'bg-warning' %>">
                                    <%= loan.user
                                        ? accType
                                        : loan.external?.borrowerType?.toUpperCase()
                                    %>
                                </span>
                            </td>

                            <!-- AMOUNT -->
                            <td class="fw-bold">
                                ₦<%= loan.amount.toLocaleString() %>
                            </td>

                            <!-- INTEREST RATE -->
                            <td>
                                <span class="badge 
                                    <%= loan.user ? 'bg-info-subtle text-info' : 'bg-warning-subtle text-warning' %>">
                                    <%= loan.interestRate %>%
                                </span>
                            </td>

                            <!-- DURATION -->
                            <td>
                                <%= loan.duration
                                    ? loan.duration.duration
                                    : (loan.externalDuration || 'N/A')
                                %> months
                            </td>

                            <!-- STATUS -->
                            <td>
                                <% 
                                    const statusColors = {
                                        pending: "bg-warning",
                                        approved: "bg-success",
                                        rejected: "bg-danger",
                                        paid: "bg-primary",
                                    };
                                %>

                                <span class="badge <%= statusColors[loan.status] %>">
                                    <%= loan.status.toUpperCase() %>
                                </span>
                            </td>

                            <!-- ACTIONS -->
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button
                                        class="btn btn-info viewLoanBtn"
                                        data-loan='<%- JSON.stringify(loan) %>'
                                        title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </button>

                                    <% if (loan.status === "approved") { %>
                                        <button
