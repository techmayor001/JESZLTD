<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club De Stars - Loan Management | Powered by JESZ LIMITED</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white;
            z-index: 1040;
            transition: all 0.3s;
            overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30, 58, 138, 0.15);
            transform: translateX(0);
        }
        
        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.1);
        }
        
        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        
        .logo-box {
            width: 45px;
            height: 45px;
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--primary);
            font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            flex-shrink: 0;
        }
        
        .sidebar-title {
            font-size: 1.1rem;
            line-height: 1.2;
        }
        
        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: rgba(239, 68, 68, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(239, 68, 68, 0.3);
            font-weight: 600;
            font-size: 0.8rem;
            margin-top: 8px;
        }
        
        .sidebar-menu {
            padding: 1rem 0;
        }
        
        .sidebar-menu a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            padding: 0.875rem 1.5rem;
            display: flex;
            align-items: center;
            transition: all 0.3s;
            border-left: 3px solid transparent;
            font-weight: 500;
            font-size: 0.95rem;
        }
        
        .sidebar-menu a:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a.active {
            background: rgba(255,255,255,0.15);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a i {
            width: 24px;
            margin-right: 12px;
            font-size: 1.1rem;
            flex-shrink: 0;
        }
        
        .top-navbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: 70px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.08);
            z-index: 1030;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            transition: all 0.3s;
            border-bottom: 1px solid rgba(30, 58, 138, 0.1);
        }
        
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: 70px;
            padding: 1.5rem;
            min-height: calc(100vh - 70px);
            transition: all 0.3s;
        }
        
        .welcome-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white;
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30, 58, 138, 0.25);
            position: relative;
            overflow: hidden;
        }
        
        .welcome-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }
        
        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            transition: transform 0.3s, box-shadow 0.3s;
            height: 100%;
            border: 1px solid rgba(30, 58, 138, 0.05);
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(30, 58, 138, 0.15);
        }
        
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 1rem;
        }
        
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            background: white;
            border: 1px solid rgba(30, 58, 138, 0.05);
        }
        
        .card-header {
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.03) 0%, rgba(59, 130, 246, 0.03) 100%);
            border-bottom: 2px solid rgba(30, 58, 138, 0.1);
            padding: 1.25rem;
            border-radius: 16px 16px 0 0 !important;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(30, 58, 138, 0.3);
        }
        
        .table {
            font-size: 0.9rem;
        }
        
        .table th {
            font-weight: 600;
            color: var(--primary);
            border-bottom: 2px solid rgba(30, 58, 138, 0.1);
            white-space: nowrap;
        }
        
        .badge {
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.75rem;
        }
        
        .powered-by {
            position: fixed;
            bottom: 15px;
            right: 15px;
            background: white;
            padding: 10px 16px;
            border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.15);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--primary);
            z-index: 1000;
        }
        
        .filter-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }
        
        .filter-tab {
            padding: 0.5rem 1rem;
            border-radius: 10px;
            border: 2px solid rgba(30, 58, 138, 0.1);
            background: white;
            color: var(--primary);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.85rem;
        }
        
        .filter-tab:hover {
            background: rgba(30, 58, 138, 0.05);
        }
        
        .filter-tab.active {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white;
            border-color: transparent;
        }
        
        .loan-details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1rem;
        }
        
        .detail-item {
            padding: 1rem;
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.03) 0%, rgba(59, 130, 246, 0.03) 100%);
            border-radius: 10px;
            border: 1px solid rgba(30, 58, 138, 0.1);
        }
        
        .detail-label {
            font-size: 0.75rem;
            color: #6b7280;
            margin-bottom: 0.25rem;
        }
        
        .detail-value {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary);
        }
        
        .action-buttons {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        @media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }
            
            .sidebar.active {
                transform: translateX(0);
            }
            
            .top-navbar {
                left: 0;
            }
            
            .main-content {
                margin-left: 0;
                padding: 1rem;
            }
            
            .welcome-card {
                padding: 1.5rem;
            }
            
            .stat-card {
                padding: 1.25rem;
            }
            
            .powered-by {
                bottom: 10px;
                right: 10px;
                font-size: 0.7rem;
                padding: 8px 12px;
            }
        }
        
        @media (max-width: 576px) {
            .top-navbar {
                height: 60px;
                padding: 0 1rem;
            }
            
            .main-content {
                margin-top: 60px;
                padding: 0.75rem;
            }
            
            .welcome-card {
                padding: 1.25rem;
                border-radius: 16px;
            }
            
            .stat-card {
                padding: 1rem;
            }
            
            .stat-icon {
                width: 50px;
                height: 50px;
                font-size: 1.4rem;
            }
            
            .card-header {
                padding: 1rem;
            }
            
            .filter-tab {
                font-size: 0.75rem;
                padding: 0.4rem 0.8rem;
            }
            
            .table {
                font-size: 0.8rem;
            }
            
            .action-buttons {
                flex-direction: column;
            }
            
            .action-buttons .btn {
                width: 100%;
            }
        }
        
        .modal-content {
            border-radius: 16px;
        }
        
        .modal-header {
            border-radius: 16px 16px 0 0;
        }
        
        .alert-info-custom {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border: 2px solid #3b82f6;
            border-radius: 12px;
            padding: 1rem;
            color: #1e40af;
        }
        
        .alert-warning-custom {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border: 2px solid #f59e0b;
            border-radius: 12px;
            padding: 1rem;
            color: #92400e;
        }
        
        .alert-success-custom {
            background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
            border: 2px solid #10b981;
            border-radius: 12px;
            padding: 1rem;
            color: #065f46;
        }
        
        .alert-danger-custom {
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            border: 2px solid #ef4444;
            border-radius: 12px;
            padding: 1rem;
            color: #991b1b;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-box">C</div>
                <div>
                    <h5 class="mb-0 fw-bold sidebar-title" style="text-transform: uppercase;">Club De Stars</h5>
                    <small class="opacity-75" style="font-size: 0.75rem;">ADMIN PANEL</small>
                </div>
            </div>
            <div class="admin-badge">
                <i class="fas fa-shield-alt"></i>
                <span>Super Admin</span>
            </div>
        </div>
           <div class="sidebar-menu">
            <a href="/admin-dashboard">
                <i class="fas fa-home"></i> Dashboard
            </a>

            <a href="/admin/manage/members">
                <i class="fas fa-users"></i> Members
            </a>
            <a href="/admin/manage/memberType">
                <i class="fas fa-id-card"></i> Membership Types
            </a>
            <a href="#" >
                <i class="fas fa-exchange-alt"></i> Transactions
            </a>
            <a href="/admin/manage-loan" class="active">
                <i class="fas fa-hand-holding-usd"></i> Loan Management
            </a>

            <a href="/admin/loan/settings">
                <i class="fas fa-cogs"></i> Loan Settings
            </a>

            <a href="#" onclick="showSection('roi', event)">
                <i class="fas fa-chart-pie"></i> ROI Distribution
            </a>
            <a href="#" onclick="showSection('withdrawals', event)">
                <i class="fas fa-money-check-alt"></i> Withdrawals
            </a>
            <a href="#" onclick="showSection('reports', event)">
                <i class="fas fa-file-alt"></i> Reports
            </a>
            <a href="#" onclick="showSection('settings', event)">
                <i class="fas fa-cog"></i> Payments
            </a>
            <a href="/admin/settings">
                <i class="fas fa-cog"></i> Settings
            </a>
            <a href="#" class="mt-3" style="color: rgba(255,255,255,0.6);">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <!-- Top Navbar -->
    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3"
           style="cursor: pointer; color: var(--primary); font-size: 1.5rem;"
           onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
        
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color: var(--primary)">Loan Management</h5>
            <small class="text-muted">Manage loan applications and active loans</small>
        </div>
        
        <div class="d-flex align-items-center gap-3">
            <div class="position-relative">
                <i class="fas fa-bell" style="color: var(--primary); font-size: 1.25rem; cursor: pointer;"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">15</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Welcome Card -->
        <div class="welcome-card position-relative">
            <div class="row align-items-center position-relative" style="z-index: 1;">
                <div class="col-md-8">
                    <h2 class="mb-2 fw-bold">Loan Management Center</h2>
                    <p class="mb-3 opacity-90">Review applications, approve loans, and manage repayments</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <div class="badge bg-light text-dark">
                            <i class="fas fa-calendar me-1"></i>
                            <span id="currentDate"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <button class="btn btn-light fw-semibold" onclick="generateLoanReport()">
                        <i class="fas fa-download me-2"></i>Export Loan Report
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Pending Applications</p>
                    <h3 class="mb-1 fw-bold">15</h3>
                    <small class="text-warning fw-semibold"><i class="fas fa-clock me-1"></i>Needs Review</small>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Active Loans</p>
                    <h3 class="mb-1 fw-bold">342</h3>
                    <small class="text-success fw-semibold"><i class="fas fa-arrow-up me-1"></i>₦28.7M</small>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Overdue Payments</p>
                    <h3 class="mb-1 fw-bold">8</h3>
                    <small class="text-danger fw-semibold"><i class="fas fa-exclamation me-1"></i>₦1.2M</small>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white;">
                        <i class="fas fa-sync-alt"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Rollover Requests</p>
                    <h3 class="mb-1 fw-bold">5</h3>
                    <small class="text-info fw-semibold"><i class="fas fa-clock me-1"></i>Pending</small>
                </div>
            </div>
        </div>

        <!-- Filter Tabs -->
        <div class="filter-tabs">
            <button class="filter-tab active" onclick="filterLoans('all')">
                <i class="fas fa-th-large me-1"></i> All Loans
            </button>
            <button class="filter-tab" onclick="filterLoans('pending')">
                <i class="fas fa-clock me-1"></i> Pending (15)
            </button>
            <button class="filter-tab" onclick="filterLoans('approved')">
                <i class="fas fa-check me-1"></i> Approved (342)
            </button>
            <button class="filter-tab" onclick="filterLoans('rejected')">
                <i class="fas fa-times me-1"></i> Rejected (23)
            </button>
            <button class="filter-tab" onclick="filterLoans('overdue')">
                <i class="fas fa-exclamation-triangle me-1"></i> Overdue (8)
            </button>
            <button class="filter-tab" onclick="filterLoans('rollover')">
                <i class="fas fa-sync-alt me-1"></i> Rollover (5)
            </button>
        </div>

        <!-- Loan Applications Table -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0 fw-bold" style="color: var(--primary);"><i class="fas fa-hand-holding-usd me-2"></i>Loan Applications</h5>
                <div class="d-flex gap-2 flex-wrap">
                    <input type="search" class="form-control form-control-sm" placeholder="Search loans..." style="max-width: 200px;" id="searchInput">
                    <select class="form-select form-select-sm" style="max-width: 150px;" onchange="sortLoans(this.value)">
                        <option value="date">Sort by Date</option>
                        <option value="amount">Sort by Amount</option>
                        <option value="member">Sort by Member</option>
                        <option value="status">Sort by Status</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="loansTable">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Member</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Interest</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
<tbody>
<% loans.forEach(loan => { %>

    <% 
        // Dynamic Account Type
        const accType = loan?.user?.account?.accountType?.name || "Unknown";

        // Badge text mapping
        const isClub = accType.toLowerCase().includes("club"); 
    %>

    <tr>

        <!-- DATE -->
        <td>
            <small class="fw-semibold">
                <%= loan.createdAt.toDateString() %>
            </small>
        </td>

        <!-- MEMBER -->
        <td>
            <div class="fw-semibold">
                <%= loan.user.firstName %> <%= loan.user.lastName %>
            </div>
            <small class="text-muted"><%= loan.user.membershipID %></small>
        </td>

        <!-- ACCOUNT TYPE (FULLY DYNAMIC) -->
        <td>
            <span class="badge <%= isClub ? 'bg-success' : 'bg-warning' %>">
                <%= accType %>
            </span>
        </td>

        <!-- AMOUNT -->
        <td class="fw-bold">
            ₦<%= loan.amount.toLocaleString() %>
        </td>

       

        <!-- INTEREST RATE (DYNAMIC FROM loan.interestRate) -->
        <td>
            <span class="badge 
                <%= isClub ? 'bg-info-subtle text-info' : 'bg-warning-subtle text-warning' %>">
                <%= loan.interestRate %>%
            </span>
        </td>

        <!-- DURATION (DYNAMIC LoanSettings) -->
        <td>
            <%= loan.duration ? loan.duration.duration : 'N/A' %> months
        </td>

        <!-- STATUS (DYNAMIC BADGE COLORS) -->
        <td>
            <% 
                const statusColors = {
                    pending: "bg-warning",
                    approved: "bg-success",
                    rejected: "bg-danger",
                    paid: "bg-primary",
                };
            %>

            <span class="badge <%= statusColors[loan.status] %>">
                <%= loan.status.toUpperCase() %>
            </span>
        </td>

        <!-- ACTIONS -->
        <td>
            <div class="btn-group btn-group-sm">
           <button class="btn btn-info viewLoanBtn"
        data-loan='<%- JSON.stringify(loan) %>'
        title="View Details">
    <i class="fas fa-eye"></i>
</button>


                <% if (loan.status === "approved") { %>
                <button class="btn btn-danger"
                        onclick="sendReminder('<%= loan._id %>')"
                        title="Send Reminder">
                    <i class="fas fa-bell"></i>
                </button>
                <% } %>
            </div>
        </td>

    </tr>

<% }) %>
</tbody>


                    </table>
                </div>
            </div>
            <div class="card-footer">
                <nav>
                    <ul class="pagination pagination-sm mb-0 justify-content-center">
                        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#">Next</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Powered By Footer -->
    <div class="powered-by">
        Powered by <strong style="color: var(--primary);">JESZ LIMITED</strong>
    </div>

<div class="modal fade" id="viewLoanModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white;">
