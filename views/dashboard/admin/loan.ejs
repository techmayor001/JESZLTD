function getFilteredData(useFilter) {
    if (!useFilter) return loansData;
    return loansData.filter(l => {
        const st   = (l.status || '').toLowerCase();
        const name = l.user ? `${l.user.firstName} ${l.user.lastName}` : (l.external?.borrowerName || '');
        const matchFilter = currentFilter === 'all' || st === currentFilter;
        const matchSearch = !currentSearch || name.toLowerCase().includes(currentSearch) || (l.user?.membershipID || '').toLowerCase().includes(currentSearch);
        return matchFilter && matchSearch;
    });
}

function buildExportRows(data) {
    return data.map((l, i) => {
        const isInt   = !!l.user;
        const name    = isInt ? `${l.user.firstName} ${l.user.lastName}` : (l.external?.borrowerName || 'External');
        const id      = isInt ? l.user.membershipID : (l.external?.borrowerType?.toUpperCase() || 'EXTERNAL');
        const email   = isInt ? l.user.email : (l.external?.email || '');
        const phone   = isInt ? l.user.phone : (l.external?.phone || '');
        const addr    = isInt ? '' : (l.external?.address || '');
        const accType = isInt ? (l.user?.account?.accountType?.name || 'Unknown') : 'External';
        const dur     = l.duration ? l.duration.duration : (l.externalDuration || 'N/A');
        const gNames  = (l.guarantors || []).map(g => g.guarantor
            ? `${g.guarantor.firstName} ${g.guarantor.lastName} [${g.guarantor.membershipID || 'N/A'}] (${g.status})`
            : 'N/A').join('; ');
        const createdDate = new Date(l.createdAt);
        const repayDate   = new Date(createdDate);
        repayDate.setMonth(repayDate.getMonth() + (l.duration?.duration || l.externalDuration || 0));
        return {
            '#': i + 1,
            'Borrower Name':           name,
            'Member ID / Type':        id,
            'Email':                   email,
            'Phone':                   phone,
            'Address':                 addr,
            'Account / Borrower Type': accType,
            'Loan Amount (₦)':         l.amount,
            'Interest Rate (%)':       l.interestRate,
            'Interest Amount (₦)':     l.interestAmount,
            'Total Repayment (₦)':     l.totalRepay,
            'Amount Paid (₦)':         l.paidAmount,
            'Outstanding Balance (₦)': l.outstandingBalance,
            'Duration (months)':       dur,
            'Status':                  capSt(l.status),
            'Disbursement Method':     l.disbursementMethod || '—',
            'Application Date':        createdDate.toDateString(),
            'Disbursement Date':       fmtD(l.disbursementDate),
            'Due Date':                fmtD(l.dueDate),
            'Approved At':             fmtD(l.approvedAt),
            'Paid At':                 fmtD(l.paidAt),
            'Overdue At':              fmtD(l.overdueAt),
            'Rejected At':             fmtD(l.rejectedAt),
            'Rejection Reason':        l.rejectionReason  || '—',
            'Rejection Details':       l.rejectionDetails || '—',
            'Penalty Rate (%)':        l.penaltyPercentage || 0,
            'Total Penalty (₦)':       l.totalPenalty      || 0,
            'Last Penalty Applied':    fmtD(l.lastPenaltyAppliedAt),
            'Rollover Count':          l.rolloverCount      || 0,
            'Rollover Rate (%)':       l.rolloverPercentage || 0,
            'Rolled Into Loan ID':     l.rolledIntoLoan    || '—',
            'Expected Repay Date':     repayDate.toDateString(),
            'Guarantors':              gNames || 'None',
        };
    });
}

/* ── Excel ── */
function exportToExcel(useFilter) {
    const data = getFilteredData(useFilter);
    if (!data.length) { alert('No loans to export.'); return; }
    const rows = buildExportRows(data);
    const ws   = XLSX.utils.json_to_sheet(rows);
    ws['!cols'] = [
        {wch:4},{wch:24},{wch:16},{wch:28},{wch:16},{wch:26},{wch:18},
        {wch:16},{wch:14},{wch:16},{wch:18},{wch:16},{wch:20},{wch:16},
        {wch:14},{wch:18},{wch:18},{wch:18},{wch:16},{wch:18},{wch:18},
        {wch:18},{wch:16},{wch:24},{wch:24},{wch:14},{wch:16},{wch:22},
        {wch:14},{wch:14},{wch:20},{wch:20},{wch:40}
    ];
    const range = XLSX.utils.decode_range(ws['!ref']);
    for (let C = range.s.c; C <= range.e.c; C++) {
        const addr = XLSX.utils.encode_cell({ r: 0, c: C });
        if (!ws[addr]) continue;
        ws[addr].s = { fill: { fgColor: { rgb: '1E3A8A' } }, font: { bold: true, color: { rgb: 'FFFFFF' }, sz: 10 }, alignment: { horizontal: 'center', vertical: 'center', wrapText: true } };
    }
    const numCols = [7, 9, 10, 11, 12, 26, 28];
    for (let R = 1; R <= range.e.r; R++) {
        const fill = R % 2 === 0 ? 'EEF2FF' : 'FFFFFF';
        for (let C = range.s.c; C <= range.e.c; C++) {
            const addr = XLSX.utils.encode_cell({ r: R, c: C });
            if (!ws[addr]) ws[addr] = { v: '', t: 's' };
            ws[addr].s = { fill: { fgColor: { rgb: fill } }, alignment: { vertical: 'center' }, border: { bottom: { style: 'thin', color: { rgb: 'E0E7FF' } } } };
        }
        numCols.forEach(C => { const addr = XLSX.utils.encode_cell({ r: R, c: C }); if (ws[addr]) { ws[addr].t = 'n'; ws[addr].z = '#,##0.00'; } });
    }
    const approvedAmt = data.filter(l => l.status === 'approved' || l.status === 'rolled_over').reduce((s, l) => s + l.amount, 0);
    const overdueAmt  = data.filter(l => l.status === 'overdue').reduce((s, l) => s + l.amount, 0);
    const now = new Date().toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    const summaryData = [
        ['Club De Stars Cooperative — Loan Export', ''],
        ['Generated', now],
        ['Export Scope', useFilter ? `Filter: ${currentFilter}` : 'All Loans'],
        ['', ''],
        ['LOAN COUNTS', ''],
        ['Total Records',        data.length],
        ['Pending',              data.filter(l=>l.status==='pending').length],
        ['Approved (Active)',    data.filter(l=>l.status==='approved').length],
        ['Rolled Over (Active)', data.filter(l=>l.status==='rolled_over').length],
        ['Total Active',         data.filter(l=>l.status==='approved'||l.status==='rolled_over').length],
        ['Overdue',              data.filter(l=>l.status==='overdue').length],
        ['Rejected',             data.filter(l=>l.status==='rejected').length],
        ['Paid / Settled',       data.filter(l=>l.status==='paid').length],
        ['', ''],
        ['FINANCIAL TOTALS', ''],
        ['Total Active Amount',              approvedAmt],
        ['Total Overdue Amount',             overdueAmt],
        ['Total Outstanding Balance',        data.reduce((s,l)=>s+(l.outstandingBalance||0),0)],
        ['Total Amount Paid Back',           data.reduce((s,l)=>s+(l.paidAmount||0),0)],
        ['Total Penalties Charged',          data.reduce((s,l)=>s+(l.totalPenalty||0),0)],
        ['Grand Total (All Loan Amounts)',   data.reduce((s,l)=>s+l.amount,0)],
    ];
    const ws2 = XLSX.utils.aoa_to_sheet(summaryData);
    ws2['!cols'] = [{ wch: 38 }, { wch: 22 }];
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Loans');
    XLSX.utils.book_append_sheet(wb, ws2, 'Summary');
    XLSX.writeFile(wb, `CDS_Loans_${new Date().toISOString().split('T')[0]}${useFilter ? '_' + currentFilter : ''}.xlsx`);
}

