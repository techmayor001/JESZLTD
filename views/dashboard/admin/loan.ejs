<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loan Management | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh; overflow-x: hidden;
        }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }
        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18); position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box {
            width: 42px; height: 42px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0;
        }
        .sidebar-brand { font-size: .95rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .65rem; font-weight: 500; opacity: .55; display: block; letter-spacing: .08em; }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 10px; background: rgba(239,68,68,.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.3);
            font-weight: 700; font-size: .7rem; color: #fca5a5;
        }
        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }
        .nav-category {
            display: flex; align-items: center; gap: 7px;
            padding: .55rem 1.25rem .3rem; font-size: .62rem; font-weight: 800;
            color: rgba(255,255,255,.38); text-transform: uppercase; letter-spacing: .1em; user-select: none;
        }
        .nav-category::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.08); margin-left: 4px; }
        .sidebar-nav a {
            display: flex; align-items: center; gap: 11px;
            padding: .62rem 1.25rem; color: rgba(255,255,255,.72);
            text-decoration: none; font-weight: 500; font-size: .84rem;
            border-left: 3px solid transparent; transition: all .18s;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }
        .nav-badge {
            margin-left: auto; font-size: .63rem; font-weight: 800;
            padding: 2px 7px; border-radius: 10px;
            background: rgba(239,68,68,.9); color: white; flex-shrink: 0; line-height: 1.4;
        }
        .nav-back {
            display: flex; align-items: center; gap: 10px;
            padding: .7rem 1.25rem .9rem; font-size: .8rem; font-weight: 600;
            color: rgba(255,255,255,.42); text-decoration: none; transition: color .18s;
            border-top: 1px solid rgba(255,255,255,.07); margin-top: .25rem;
        }
        .nav-back:hover { color: rgba(255,255,255,.7); }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }

        /* ══════════ TOPBAR ══════════ */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: 70px;
            background: rgba(255,255,255,.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            border-bottom: 1px solid rgba(30,58,138,.1); transition: all .3s;
        }
        .main-content {
            margin-left: var(--sidebar-width); margin-top: 70px;
            padding: 1.5rem; min-height: calc(100vh - 70px); transition: all .3s;
        }

        /* ══════════ PAGE HEADER ══════════
           KEY FIX: overflow must NOT be hidden — the dropdown needs to escape.
           Use a pseudo-element circle instead of overflow:hidden.
        ══════════ */
        .welcome-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30,58,138,.25);
            /* NO overflow:hidden here — that clips the dropdown */
            position: relative;
        }
        .welcome-card::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,.05); border-radius: 50%;
            /* pointer-events:none so it doesn't block clicks */
            pointer-events: none;
        }

        /* ══════════ EXPORT DROPDOWN — always on top ══════════ */
        .export-wrapper {
            position: relative;
            /* Establish its own stacking context so dropdown escapes welcome-card */
            z-index: 100;
        }
        .export-dropdown-menu {
            /* Override Bootstrap to guarantee visibility */
            position: absolute !important;
            top: calc(100% + 6px) !important;
            right: 0 !important;
            left: auto !important;
            min-width: 230px !important;
            background: white;
            border-radius: 14px !important;
            border: none !important;
            box-shadow: 0 20px 50px rgba(30,58,138,.22), 0 4px 16px rgba(0,0,0,.1) !important;
            padding: .5rem !important;
            z-index: 99999 !important;
        }
        .export-dropdown-menu .dropdown-header {
            font-size: .68rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: .08em; color: #94a3b8; padding: .5rem .75rem .25rem;
        }
        .export-dropdown-menu .dropdown-item {
            border-radius: 9px; padding: .6rem .875rem;
            font-weight: 600; font-size: .85rem; color: #1e293b;
            display: flex; align-items: center; gap: .6rem;
            transition: background .15s;
        }
        .export-dropdown-menu .dropdown-item:hover { background: rgba(30,58,138,.06); }
        .export-dropdown-menu .dropdown-divider {
            margin: .35rem .5rem; border-color: rgba(30,58,138,.1);
        }
        .btn-export {
            background: white; color: var(--primary); border: none;
            font-weight: 700; border-radius: 10px; padding: .55rem 1.1rem;
            font-size: .88rem; display: flex; align-items: center; gap: .5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,.12); transition: all .2s; cursor: pointer;
        }
        .btn-export:hover { background: rgba(255,255,255,.92); transform: translateY(-1px); box-shadow: 0 6px 18px rgba(0,0,0,.15); }
        .btn-export .caret { font-size: .7rem; transition: transform .2s; }
        .btn-export.open .caret { transform: rotate(180deg); }

        /* ══════════ STAT CARDS ══════════ */
        .stat-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,.08); transition: transform .3s, box-shadow .3s;
            height: 100%; border: 1px solid rgba(30,58,138,.05);
        }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,.15); }
        .stat-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 1rem; }
        .stat-sub { font-size: .78rem; font-weight: 700; margin-top: .3rem; }

        /* ══════════ CARDS ══════════ */
        .card { border: none; border-radius: 16px; box-shadow: 0 8px 20px rgba(30,58,138,.08); background: white; border: 1px solid rgba(30,58,138,.05); }
        .card-header { background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%); border-bottom: 2px solid rgba(30,58,138,.1); padding: 1.25rem; border-radius: 16px 16px 0 0 !important; }

        /* ══════════ FILTER TABS ══════════ */
        .filter-tabs { display: flex; gap: .5rem; margin-bottom: 1rem; flex-wrap: wrap; }
        .filter-tab {
            padding: .5rem 1rem; border-radius: 10px; border: 2px solid rgba(30,58,138,.1);
            background: white; color: var(--primary); font-weight: 600; cursor: pointer;
            transition: all .3s; font-size: .85rem; white-space: nowrap;
        }
        .filter-tab:hover { background: rgba(30,58,138,.05); }
        .filter-tab.active { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white; border-color: transparent; }

        /* ══════════ TABLE ══════════ */
        .table { font-size: .9rem; }
        .table th { font-weight: 600; color: var(--primary); border-bottom: 2px solid rgba(30,58,138,.1); white-space: nowrap; }
        .badge { padding: .4rem .8rem; border-radius: 8px; font-weight: 600; font-size: .75rem; }

        /* ══════════ MODALS ══════════ */
        .modal-content { border-radius: 16px; border: none; }
        .modal-header { border-radius: 16px 16px 0 0; }
        .loan-details-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
        .detail-item { padding: 1rem; background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%); border-radius: 10px; border: 1px solid rgba(30,58,138,.1); }
        .detail-label { font-size: .75rem; color: #6b7280; margin-bottom: .25rem; }
        .detail-value { font-size: 1.05rem; font-weight: 700; color: var(--primary); }
        .alert-info-custom    { background: linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%); border: 2px solid #3b82f6; border-radius: 12px; padding: 1rem; color: #1e40af; }
        .alert-warning-custom { background: linear-gradient(135deg,#fef3c7 0%,#fde68a 100%); border: 2px solid #f59e0b; border-radius: 12px; padding: 1rem; color: #92400e; }
        .alert-success-custom { background: linear-gradient(135deg,#d1fae5 0%,#a7f3d0 100%); border: 2px solid #10b981; border-radius: 12px; padding: 1rem; color: #065f46; }
        .alert-danger-custom  { background: linear-gradient(135deg,#fee2e2 0%,#fecaca 100%); border: 2px solid #ef4444; border-radius: 12px; padding: 1rem; color: #991b1b; }

        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,.15); font-size: .8rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; } .main-content { margin-left: 0; padding: 1rem; }
        }
        @media (max-width: 576px) {
            .top-navbar { height: 60px; padding: 0 1rem; }
            .main-content { margin-top: 60px; padding: .75rem; }
            .welcome-card { padding: 1.25rem; border-radius: 16px; }
            .stat-icon { width: 50px; height: 50px; font-size: 1.4rem; }
            .filter-tab { font-size: .75rem; padding: .4rem .8rem; }
            .table { font-size: .8rem; }
            .export-dropdown-menu { right: auto !important; left: 0 !important; }
        }
    </style>
</head>
<body>

<!-- ════════════════════════ SIDEBAR ════════════════════════ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-row">
            <div class="logo-box">C</div>
            <div><div class="sidebar-brand">Club De Stars<small>Admin Panel</small></div></div>
        </div>
        <div class="role-pill">
            <i class="fas fa-shield-alt" style="font-size:.65rem;"></i>&nbsp;<%= admin.role?.name?.toUpperCase() || 'SUPER ADMIN' %>
        </div>
    </div>
  <div class="sidebar-nav">
        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-home" style="font-size:.6rem;"></i>Main</div>
            <a href="/admin/dashboard"><i class="fas fa-chart-pie"></i>Overview</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-users" style="font-size:.6rem;"></i>Members</div>
            <a href="/admin/manage-members"><i class="fas fa-users"></i>Manage Members</a>
            <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i>Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i>Membership Types</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-exchange-alt" style="font-size:.6rem;"></i>Transactions</div>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i>Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i>Approvals<span id="sidebarPendingBadge" class="nav-badge" style="display:none;">0</span></a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i>Deposits</a>
            <a href="/admin/kiddies-deposits"><i class="fas fa-piggy-bank"></i>Kiddies Deposits</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i>Withdrawals</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-hand-holding-usd" style="font-size:.6rem;"></i>Loans</div>
            <a href="/admin/manage-loan" class='active'><i class="fas fa-hand-holding-usd"></i>Loan Management</a>
            <a href="/admin/loan-payments"><i class="fas fa-file-invoice-dollar"></i>Loan Payments</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i>Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i>External Loans</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-landmark" style="font-size:.6rem;"></i>Finance</div>
            <a href="/admin/finance"><i class="fas fa-landmark"></i>Company Finance</a>
            <a href="/admin/operating-earnings"><i class="fas fa-chart-line"></i>Operating Earnings</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-chart-bar"></i>Company Revenue</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-cog" style="font-size:.6rem;"></i>System</div>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i>Manage Subscriptions</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i>Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i>Settings</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-file-alt" style="font-size:.6rem;"></i>Reporting</div>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i>Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i>Admin Logs</a>
        </div>
    </div>
    <a href="/cds-cooperative/dashboard" class="nav-back"><i class="fas fa-arrow-left"></i>Back to Dashboard</a>
</div>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- Top Navbar -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;" onclick="toggleSidebar(event)"></i>
    <div class="flex-grow-1 d-none d-lg-block">
        <h5 class="mb-0 fw-bold" style="color:var(--primary)">Loan Management</h5>
        <small class="text-muted">Manage loan applications and active loans</small>
    </div>
    <div class="d-lg-none fw-bold" style="color:var(--primary);font-size:.95rem;">Loan Management</div>
</div>

<!-- Main Content -->
<div class="main-content">

    <!-- WELCOME CARD — no overflow:hidden so dropdown is never clipped -->
    <div class="welcome-card position-relative">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-md-8">
                <h2 class="mb-2 fw-bold"><i class="fas fa-hand-holding-usd me-3"></i>Loan Management Center</h2>
                <p class="mb-3 opacity-90">Review applications, approve loans, and manage repayments</p>
                <div class="badge bg-light text-dark">
                    <i class="fas fa-calendar me-1"></i><span id="currentDate"></span>
                </div>
            </div>

            <!-- EXPORT BUTTON — custom dropdown, not Bootstrap dropdown (avoids clipping) -->
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="export-wrapper d-inline-block">
                    <button class="btn-export" id="exportBtn" onclick="toggleExportMenu(event)">
                        <i class="fas fa-download"></i>
                        Export Loans
                        <i class="fas fa-chevron-down caret" id="exportCaret"></i>
                    </button>
                    <div class="export-dropdown-menu" id="exportMenu" style="display:none;">
                        <div class="dropdown-header">Export All</div>
                        <a class="dropdown-item" href="#" onclick="exportToExcel(false);closeExportMenu();return false;">
                            <i class="fas fa-file-excel" style="color:#10b981;font-size:1rem;"></i>Excel — All Loans
                        </a>
                        <a class="dropdown-item" href="#" onclick="exportToPDF(false);closeExportMenu();return false;">
                            <i class="fas fa-file-pdf" style="color:#ef4444;font-size:1rem;"></i>PDF — All Loans
                        </a>
                        <div class="dropdown-divider"></div>
                        <div class="dropdown-header">Export Current Filter</div>
                        <a class="dropdown-item" href="#" onclick="exportToExcel(true);closeExportMenu();return false;">
                            <i class="fas fa-file-excel" style="color:#059669;font-size:1rem;"></i>Excel — Filtered View
                        </a>
                        <a class="dropdown-item" href="#" onclick="exportToPDF(true);closeExportMenu();return false;">
                            <i class="fas fa-file-pdf" style="color:#dc2626;font-size:1rem;"></i>PDF — Filtered View
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- STATS CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%);color:white;"><i class="fas fa-file-invoice"></i></div>
                <p class="text-muted mb-1 fw-semibold small">Pending Applications</p>
                <h3 class="mb-0 fw-bold" id="stat-pending">0</h3>
                <div class="stat-sub text-warning"><i class="fas fa-clock me-1"></i>Needs Review</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#10b981 0%,#059669 100%);color:white;"><i class="fas fa-check-circle"></i></div>
                <p class="text-muted mb-1 fw-semibold small">Active Loans <small class="text-muted fw-normal" style="font-size:.65rem;">(approved + rolled)</small></p>
                <h3 class="mb-0 fw-bold" id="stat-active">0</h3>
                <div class="stat-sub text-success fw-bold">₦<span id="stat-active-amount">0</span> disbursed</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%);color:white;"><i class="fas fa-exclamation-triangle"></i></div>
                <p class="text-muted mb-1 fw-semibold small">Overdue Payments</p>
                <h3 class="mb-0 fw-bold" id="stat-overdue">0</h3>
                <div class="stat-sub text-danger fw-bold">₦<span id="stat-overdue-amount">0</span> at risk</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#8b5cf6 0%,#7c3aed 100%);color:white;"><i class="fas fa-sync-alt"></i></div>
                <p class="text-muted mb-1 fw-semibold small">Rolled Over Loans</p>
                <h3 class="mb-0 fw-bold" id="stat-rolled">0</h3>
                <div class="stat-sub" style="color:#7c3aed;">₦<span id="stat-rolled-amount">0</span> rolled</div>
            </div>
        </div>
    </div>

    <!-- FILTER TABS -->
    <div class="filter-tabs">
        <button class="filter-tab active"  data-filter="all"          onclick="filterLoans('all',event)">         <i class="fas fa-th-large me-1"></i>All             <span class="ms-1">(<span id="count-all">0</span>)</span></button>
        <button class="filter-tab"         data-filter="pending"      onclick="filterLoans('pending',event)">     <i class="fas fa-clock me-1"></i>Pending         <span class="ms-1">(<span id="count-pending">0</span>)</span></button>
        <button class="filter-tab"         data-filter="approved"     onclick="filterLoans('approved',event)">    <i class="fas fa-check me-1"></i>Approved        <span class="ms-1">(<span id="count-approved">0</span>)</span></button>
        <button class="filter-tab"         data-filter="overdue"      onclick="filterLoans('overdue',event)">     <i class="fas fa-exclamation-triangle me-1"></i>Overdue  <span class="ms-1">(<span id="count-overdue">0</span>)</span></button>
        <button class="filter-tab"         data-filter="rejected"     onclick="filterLoans('rejected',event)">    <i class="fas fa-times me-1"></i>Rejected        <span class="ms-1">(<span id="count-rejected">0</span>)</span></button>
        <button class="filter-tab"         data-filter="paid"         onclick="filterLoans('paid',event)">        <i class="fas fa-check-double me-1"></i>Paid       <span class="ms-1">(<span id="count-paid">0</span>)</span></button>
        <button class="filter-tab"         data-filter="rolled_over"  onclick="filterLoans('rolled_over',event)"> <i class="fas fa-sync-alt me-1"></i>Rolled Over    <span class="ms-1">(<span id="count-rolled_over">0</span>)</span></button>
    </div>

    <!-- LOANS TABLE -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0 fw-bold" style="color:var(--primary);"><i class="fas fa-hand-holding-usd me-2"></i>Loan Applications</h5>
            <div class="d-flex gap-2 flex-wrap">
                <input type="search" class="form-control form-control-sm" placeholder="Search loans..." style="max-width:200px;" id="searchInput" oninput="searchLoans()">
                <select class="form-select form-select-sm" style="max-width:150px;" onchange="sortLoans(this.value)">
                    <option value="date">Sort by Date</option>
                    <option value="amount">Sort by Amount</option>
                    <option value="member">Sort by Member</option>
                    <option value="status">Sort by Status</option>
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="loansTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Member / Borrower</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Outstanding</th>
                            <th>Interest</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="loansTableBody">
                    <% loans.forEach(loan => {
                        const accType = loan?.user?.account?.accountType?.name || 'Unknown';
                        const statusLower = (loan.status || '').toLowerCase();
                        const statusMap = {
                            pending:    'bg-warning',
                            approved:   'bg-success',
                            rejected:   'bg-danger',
                            overdue:    'bg-danger',
                            paid:       'bg-primary',
                            rolled_over:'bg-secondary'
                        };
                        const statusBadgeClass = statusMap[statusLower] || 'bg-secondary';
                        const memberName = loan.user
                            ? (loan.user.firstName + ' ' + loan.user.lastName)
                            : (loan.external && loan.external.borrowerName ? loan.external.borrowerName : 'External');
                    %>
                        <tr class="loan-row"
                            data-status="<%= statusLower %>"
                            data-amount="<%= loan.amount %>"
                            data-outstanding="<%= loan.outstandingBalance || 0 %>"
                            data-member="<%= memberName %>">

                            <td><small class="fw-semibold"><%= new Date(loan.createdAt).toDateString() %></small></td>

                            <td>
                                <div class="fw-semibold"><%= memberName %></div>
                                <small class="text-muted">
                                    <%= loan.user
                                        ? loan.user.membershipID
                                        : (loan.external && loan.external.borrowerType ? loan.external.borrowerType.toUpperCase() : '') %>
                                </small>
                            </td>

                            <td>
                                <span class="badge <%= loan.user ? 'bg-success' : 'bg-warning text-dark' %>">
                                    <%= loan.user ? accType : (loan.external && loan.external.borrowerType ? loan.external.borrowerType.toUpperCase() : 'EXTERNAL') %>
                                </span>
                            </td>

                            <td class="fw-bold text-primary">₦<%= loan.amount.toLocaleString() %></td>

                            <td>
                                <% if (loan.outstandingBalance && loan.outstandingBalance > 0) { %>
                                    <span class="fw-bold text-danger">₦<%= loan.outstandingBalance.toLocaleString() %></span>
                                <% } else { %>
                                    <span class="text-muted">—</span>
                                <% } %>
                            </td>

                            <td><span class="badge bg-info-subtle text-info"><%= loan.interestRate %>%</span></td>

                            <td><%= loan.duration ? loan.duration.duration : (loan.externalDuration || 'N/A') %> mo</td>

                            <td>
                                <span class="badge <%= statusBadgeClass %>">
                                    <%= (loan.status || '').replace('_', ' ').toUpperCase() %>
                                </span>
                            </td>

                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-info viewLoanBtn" data-loan='<%- JSON.stringify(loan) %>' title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <% if (statusLower === 'approved' || statusLower === 'overdue') { %>
                                        <button class="btn btn-warning" onclick="sendReminder('<%= loan._id %>')" title="Send Reminder">
                                            <i class="fas fa-bell"></i>
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <small class="text-muted" id="tableInfo">Showing all records</small>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationEl"></ul></nav>
            </div>
        </div>
    </div>

</div><!-- /main-content -->

<div class="powered-by">Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

