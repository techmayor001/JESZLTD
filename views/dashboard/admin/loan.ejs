*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#1e293b;background:#fff;}
.header{background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;padding:22px 28px;}
.header h1{font-size:20px;font-weight:800;margin-bottom:3px;}.header p{font-size:11px;opacity:.8;}
.meta{display:flex;gap:14px;padding:10px 28px;background:#f8fafc;border-bottom:1px solid #e2e8f0;flex-wrap:wrap;}
.mi{display:flex;flex-direction:column;min-width:80px;}
.mi span:first-child{font-size:9px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.07em;}
.mi span:last-child{font-size:13px;font-weight:800;color:#1e3a8a;}
.mi.g span:last-child{color:#059669;}.mi.r span:last-child{color:#dc2626;}.mi.a span:last-child{color:#d97706;}.mi.p span:last-child{color:#7c3aed;}
table{width:100%;border-collapse:collapse;}
thead tr{background:#1e3a8a;color:white;}
thead th{padding:8px 9px;text-align:left;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap;}
thead th:first-child{text-align:center;width:28px;}
tbody td{padding:7px 9px;border-bottom:1px solid #f1f5f9;vertical-align:middle;}
.footer{padding:14px 28px;font-size:10px;color:#9ca3af;border-top:2px solid #e2e8f0;display:flex;justify-content:space-between;margin-top:6px;}
@media print{@page{size:A4 landscape;margin:7mm;}.no-print{display:none;}}
</style></head><body>
<div class="header">
    <h1>Club De Stars Cooperative — Loan Report</h1>
    <p>Generated: ${now} &nbsp;|&nbsp; ${useFilter && currentFilter !== 'all' ? 'Filter: ' + capSt(currentFilter) : 'Full Export'}</p>
</div>
<div class="meta">
    <div class="mi"><span>Total</span><span>${data.length}</span></div>
    <div class="mi a"><span>Pending</span><span>${counts.pending}</span></div>
    <div class="mi g"><span>Active</span><span>${counts.approved + counts.rolled_over}</span></div>
    <div class="mi r"><span>Overdue</span><span>${counts.overdue}</span></div>
    <div class="mi p"><span>Rolled Over</span><span>${counts.rolled_over}</span></div>
    <div class="mi r"><span>Rejected</span><span>${counts.rejected}</span></div>
    <div class="mi g"><span>Paid</span><span>${counts.paid}</span></div>
    <div class="mi g"><span>Active Total</span><span>₦${activeAmt.toLocaleString('en-NG',{minimumFractionDigits:2})}</span></div>
    <div class="mi r"><span>Overdue Total</span><span>₦${overdueAmt.toLocaleString('en-NG',{minimumFractionDigits:2})}</span></div>
    <div class="mi"><span>Grand Total</span><span>₦${totalAmt.toLocaleString('en-NG',{minimumFractionDigits:2})}</span></div>
</div>
<div style="padding:0 0 10px;">
<table>
<thead><tr>
    <th>#</th><th>Borrower</th><th style="text-align:right;">Amount</th>
    <th style="text-align:right;">Outstanding</th><th style="text-align:right;">Paid</th>
    <th style="text-align:center;">Rate</th><th style="text-align:center;">Duration</th>
    <th style="text-align:center;">Status</th><th>Date Applied</th><th>Due Date</th>
</tr></thead>
<tbody>${rows}</tbody>
</table>
</div>
<div class="footer">
    <span>Club De Stars Cooperative &nbsp;·&nbsp; Powered by JESZ LIMITED</span>
    <span>${data.length} loan records exported</span>
</div>
<div style="text-align:center;padding:14px;" class="no-print">
    <button onclick="window.print()" style="padding:10px 28px;background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;border:none;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;margin-right:8px;">🖨 Print / Save as PDF</button>
    <button onclick="window.close()" style="padding:10px 20px;background:#f1f5f9;color:#374151;border:1px solid #e2e8f0;border-radius:8px;font-weight:600;font-size:14px;cursor:pointer;">Close</button>
</div>
</body></html>`;
