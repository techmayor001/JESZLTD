// Reject loan from modal
function rejectLoanFromModal() {
    if (!selectedLoan) return;

    // Populate Reject Loan modal dynamically
    document.getElementById("rejectMemberName").innerText =
        `${selectedLoan.user.firstName} ${selectedLoan.user.lastName}`;
    document.getElementById("rejectLoanAmount").innerText =
        "₦" + selectedLoan.amount.toLocaleString();

    // Reset form fields
    document.getElementById("rejectionReason").value = "";
    document.getElementById("rejectionDetails").value = "";

    // Hide View Loan modal and show Reject Loan modal
    const viewModal = bootstrap.Modal.getInstance(document.getElementById("viewLoanModal"));
    viewModal.hide();

    const rejectModal = new bootstrap.Modal(document.getElementById("rejectLoanModal"));
    rejectModal.show();
}

// Confirm Rejection
function confirmRejection() {
    const reason = document.getElementById("rejectionReason").value;
    const details = document.getElementById("rejectionDetails").value.trim();

    if (!reason || !details) {
        alert("Please provide a rejection reason and additional details.");
        return;
    }

    console.log("Loan rejected:", selectedLoan._id, reason, details);

    alert(`Loan for ${selectedLoan.user.firstName} has been rejected.`);

    const rejectModal = bootstrap.Modal.getInstance(document.getElementById("rejectLoanModal"));
    rejectModal.hide();
}

</script>

