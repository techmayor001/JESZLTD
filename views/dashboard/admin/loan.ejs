<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
/* ══════════════════════════════════════
   FULL LOAN DATA FROM SERVER
══════════════════════════════════════ */
const loansData = <%- JSON.stringify(loans.map(l => ({
    _id:   String(l._id),
    status: l.status || 'pending',
    amount: l.amount || 0,
    interestAmount:     l.interestAmount     || 0,
    outstandingBalance: l.outstandingBalance || 0,
    totalRepay:         l.totalRepay         || 0,
    paidAmount:         l.paidAmount         || 0,
    interestRate:       l.interestRate       || 0,
    penaltyPercentage:  l.penaltyPercentage  || 0,
    totalPenalty:       l.totalPenalty       || 0,
    rolloverPercentage: l.rolloverPercentage || 0,
    rolloverCount:      l.rolloverCount      || 0,
    disbursementMethod: l.disbursementMethod || '',
    disbursementDate:   l.disbursementDate   || null,
    dueDate:            l.dueDate            || null,
    approvedAt:         l.approvedAt         || null,
    rejectedAt:         l.rejectedAt         || null,
    paidAt:             l.paidAt             || null,
    overdueAt:          l.overdueAt          || null,
    lastPenaltyAppliedAt: l.lastPenaltyAppliedAt || null,
    rejectionReason:    l.rejectionReason    || '',
    rejectionDetails:   l.rejectionDetails   || '',
    externalDuration:   l.externalDuration   || null,
    rolledIntoLoan:     l.rolledIntoLoan     ? String(l.rolledIntoLoan) : null,
    createdAt:          l.createdAt,
    penaltyHistory: (l.penaltyHistory || []).map(p => ({
        appliedAt: p.appliedAt, periodLabel: p.periodLabel || '',
        penaltyRate: p.penaltyRate || 0, penaltyAmount: p.penaltyAmount || 0,
        balanceBefore: p.balanceBefore || 0, balanceAfter: p.balanceAfter || 0
    })),
    rolloverHistory: (l.rolloverHistory || []).map(r => ({
        rolledOverAt: r.rolledOverAt, rolloverFee: r.rolloverFee || 0,
        balanceBefore: r.balanceBefore || 0, balanceAfter: r.balanceAfter || 0,
        newDueDate: r.newDueDate || null
    })),
    duration: l.duration ? { duration: l.duration.duration } : null,
    user: l.user ? {
        firstName:    l.user.firstName    || '',
        lastName:     l.user.lastName     || '',
        membershipID: l.user.membershipID || '',
        email:        l.user.email        || '',
        phone:        l.user.phone        || '',
        account: l.user.account ? {
            balance: l.user.account.balance || 0,
            accountType: l.user.account.accountType ? { name: l.user.account.accountType.name } : null
        } : null
    } : null,
    external: l.external ? {
        borrowerType: l.external.borrowerType || '',
        borrowerName: l.external.borrowerName || '',
        email:        l.external.email        || '',
        phone:        l.external.phone        || '',
        address:      l.external.address      || ''
    } : null,
    guarantors: (l.guarantors || []).map(g => ({
        status: g.status || 'pending',
        respondedAt: g.respondedAt || null,
        guarantor: g.guarantor ? {
            firstName:    g.guarantor.firstName    || '',
            lastName:     g.guarantor.lastName     || '',
            membershipID: g.guarantor.membershipID || '',
            email:        g.guarantor.email        || '',
            phone:        g.guarantor.phone        || '',
            account: g.guarantor.account ? { balance: g.guarantor.account.balance || 0 } : null
        } : null
    }))
}))) %>;

let selectedLoan  = null;
let currentFilter = 'all';
let currentSearch = '';

document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', {
    weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
});

/* ── Helpers ── */
function fmt(n)   { return '₦' + Number(n || 0).toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
function fmtN(n)  { return Number(n || 0).toLocaleString(); }
function fmtD(d)  { return d ? new Date(d).toDateString() : '—'; }
function capSt(s) { return (s || '').replace('_', ' ').replace(/\b\w/g, c => c.toUpperCase()); }

/* ══════════════════════════════════════
   EXPORT DROPDOWN — custom (not Bootstrap)
   Avoids clipping by welcome-card
══════════════════════════════════════ */
function toggleExportMenu(e) {
    e.stopPropagation();
    const menu  = document.getElementById('exportMenu');
    const btn   = document.getElementById('exportBtn');
    const caret = document.getElementById('exportCaret');
    const isOpen = menu.style.display !== 'none';
    menu.style.display  = isOpen ? 'none' : 'block';
    btn.classList.toggle('open', !isOpen);
}
function closeExportMenu() {
    document.getElementById('exportMenu').style.display = 'none';
    document.getElementById('exportBtn').classList.remove('open');
}
// Close dropdown when clicking anywhere else
document.addEventListener('click', e => {
    if (!e.target.closest('.export-wrapper')) closeExportMenu();
});

/* ══════════════════════════════════════
   STATS — approved + rolled_over = "active"
══════════════════════════════════════ */
function computeStats() {
    let pending = 0, active = 0, overdue = 0, rolled = 0, rejected = 0, paid = 0;
    let activeAmt = 0, overdueAmt = 0, rolledAmt = 0;
    loansData.forEach(l => {
        const st  = (l.status || '').toLowerCase();
        const amt = Number(l.amount) || 0;
        if (st === 'pending')     { pending++;  }
        if (st === 'approved')    { active++;   activeAmt  += amt; }
        if (st === 'rolled_over') { rolled++;   rolledAmt  += amt; active++; activeAmt += amt; }
        if (st === 'overdue')     { overdue++;  overdueAmt += amt; }
        if (st === 'rejected')    { rejected++; }
        if (st === 'paid')        { paid++;     }
    });
    document.getElementById('stat-pending').textContent        = pending;
    document.getElementById('stat-active').textContent         = active;
    document.getElementById('stat-active-amount').textContent  = fmtN(activeAmt);
    document.getElementById('stat-overdue').textContent        = overdue;
    document.getElementById('stat-overdue-amount').textContent = fmtN(overdueAmt);
    document.getElementById('stat-rolled').textContent         = rolled;
    document.getElementById('stat-rolled-amount').textContent  = fmtN(rolledAmt);
}

/* ── Filter counts ── */
function computeFilterCounts() {
    const c = { all: loansData.length, pending: 0, approved: 0, overdue: 0, rejected: 0, paid: 0, rolled_over: 0 };
    loansData.forEach(l => { const st = (l.status || '').toLowerCase(); if (c.hasOwnProperty(st)) c[st]++; });
    Object.keys(c).forEach(k => { const el = document.getElementById(`count-${k}`); if (el) el.textContent = c[k]; });
}

/* ── Filter tabs ── */
function filterLoans(status, event) {
    currentFilter = status;
    document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
    event.currentTarget.classList.add('active');
    applyVisibility();
}

/* ── Search ── */
function searchLoans() {
    currentSearch = document.getElementById('searchInput').value.toLowerCase();
    applyVisibility();
}

/* ── Visibility ── */
function applyVisibility() {
    let visible = 0;
    document.querySelectorAll('.loan-row').forEach(row => {
        const matchFilter = currentFilter === 'all' || row.dataset.status === currentFilter;
        const matchSearch = !currentSearch || row.textContent.toLowerCase().includes(currentSearch);
        const show = matchFilter && matchSearch;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    const total = document.querySelectorAll('.loan-row').length;
    document.getElementById('tableInfo').textContent =
        currentFilter === 'all' && !currentSearch
            ? `Showing all ${total} records`
            : `Showing ${visible} of ${total} records`;
}

/* ── Sort ── */
function sortLoans(by) {
    const tbody = document.getElementById('loansTableBody');
    const rows  = [...tbody.querySelectorAll('tr')];
    rows.sort((a, b) => {
        if (by === 'amount') return Number(b.dataset.amount) - Number(a.dataset.amount);
        if (by === 'member') return (a.dataset.member || '').localeCompare(b.dataset.member || '');
        if (by === 'status') return (a.dataset.status || '').localeCompare(b.dataset.status || '');
        return 0;
    });
    rows.forEach(r => tbody.appendChild(r));
}

/* ══════════════════════════════════════
   VIEW LOAN MODAL
══════════════════════════════════════ */
function viewLoan(loan) {
    selectedLoan = loan;
    const isInt = !!loan.user;
    const name    = isInt ? `${loan.user.firstName} ${loan.user.lastName}` : (loan.external?.borrowerName || 'Company/External');
    const id      = isInt ? `Member ID: ${loan.user.membershipID}` : `Type: ${(loan.external?.borrowerType || 'external').toUpperCase()}`;
    const email   = isInt ? (loan.user.email || 'N/A') : (loan.external?.email || 'N/A');
    const phone   = isInt ? (loan.user.phone || 'N/A') : (loan.external?.phone || 'N/A');
    const address = isInt ? '' : (loan.external?.address || '');
    const accType = isInt ? (loan.user?.account?.accountType?.name || 'Unknown') : (loan.external?.borrowerType?.toUpperCase() || 'EXTERNAL');

    document.getElementById('loanMemberName').textContent    = name;
    document.getElementById('loanMemberID').textContent      = id;
    document.getElementById('loanMemberEmail').textContent   = `Email: ${email}`;
    document.getElementById('loanMemberPhone').textContent   = `Phone: ${phone}`;
    document.getElementById('loanMemberAddress').textContent = address ? `Address: ${address}` : '';

    const badge = document.getElementById('loanAccountBadge');
    badge.textContent = accType;
    badge.className   = 'badge fs-6 ' + (isInt ? 'bg-success' : 'bg-warning text-dark');

    document.getElementById('loanAmount').textContent             = fmt(loan.amount);
    document.getElementById('loanTotalRepay').textContent         = fmt(loan.totalRepay);
    document.getElementById('loanOutstanding').textContent        = loan.outstandingBalance > 0 ? fmt(loan.outstandingBalance) : '₦0.00';
    document.getElementById('loanPaidAmount').textContent         = fmt(loan.paidAmount);
    document.getElementById('loanInterest').textContent           = loan.interestRate + '%';
    document.getElementById('loanInterestAmount').textContent     = fmt(loan.interestAmount);
    document.getElementById('loanDuration').textContent           = (loan.duration ? loan.duration.duration : (loan.externalDuration || 'N/A')) + ' Months';
    document.getElementById('loanDisbursementMethod').textContent = loan.disbursementMethod ? capSt(loan.disbursementMethod) : '—';
    document.getElementById('loanCreatedAt').textContent          = fmtD(loan.createdAt);
    document.getElementById('loanDisbursementDate').textContent   = fmtD(loan.disbursementDate);
    document.getElementById('loanDueDate').textContent            = fmtD(loan.dueDate);
    document.getElementById('loanApprovedAt').textContent         = fmtD(loan.approvedAt);
    document.getElementById('loanPaidAt').textContent             = fmtD(loan.paidAt);

    const stBadge  = document.getElementById('loanStatusBadge');
    const stColors = { pending:'bg-warning', approved:'bg-success', rejected:'bg-danger', overdue:'bg-danger', paid:'bg-primary', rolled_over:'bg-secondary' };
    stBadge.className   = 'badge fs-6 ' + (stColors[loan.status] || 'bg-secondary');
    stBadge.textContent = capSt(loan.status);

    // Penalty
    const penSec = document.getElementById('penaltySection');
    if (loan.totalPenalty > 0 || loan.penaltyPercentage > 0) {
        penSec.style.display = '';
        document.getElementById('loanPenaltyRate').textContent  = loan.penaltyPercentage + '%';
        document.getElementById('loanTotalPenalty').textContent = fmt(loan.totalPenalty);
        document.getElementById('loanLastPenalty').textContent  = fmtD(loan.lastPenaltyAppliedAt);
    } else { penSec.style.display = 'none'; }

    // Rollover
    const rolSec = document.getElementById('rolloverSection');
    if (loan.rolloverCount > 0 || loan.status === 'rolled_over') {
        rolSec.style.display = '';
        document.getElementById('loanRolloverCount').textContent = loan.rolloverCount;
        document.getElementById('loanRolloverRate').textContent  = loan.rolloverPercentage + '%';
        const histList = document.getElementById('rolloverHistoryList');
        histList.innerHTML = '';
        (loan.rolloverHistory || []).forEach((r, i) => {
            histList.innerHTML += `
                <div class="card mb-2" style="font-size:.82rem;">
                    <div class="card-body py-2">
                        <strong>Rollover ${i + 1}</strong> — ${fmtD(r.rolledOverAt)}<br>
                        Fee: <span class="text-danger fw-bold">${fmt(r.rolloverFee)}</span> &nbsp;|&nbsp;
                        Balance: ${fmt(r.balanceBefore)} → ${fmt(r.balanceAfter)}<br>
                        New Due Date: ${fmtD(r.newDueDate)}
                    </div>
                </div>`;
        });
    } else { rolSec.style.display = 'none'; }

    // Rejection
    const rejSec = document.getElementById('rejectionSection');
    if (loan.status === 'rejected') {
        rejSec.style.display = '';
        document.getElementById('loanRejectionReason').textContent = loan.rejectionReason || '—';
        if (loan.rejectionDetails) {
            document.getElementById('rejectionDetailsRow').style.display = '';
            document.getElementById('loanRejectionDetails').textContent  = loan.rejectionDetails;
        } else { document.getElementById('rejectionDetailsRow').style.display = 'none'; }
    } else { rejSec.style.display = 'none'; }

    // Guarantors
    const gList = document.getElementById('guarantorList');
    gList.innerHTML = '';
    if (!loan.guarantors || loan.guarantors.length === 0) {
        gList.innerHTML = '<p class="text-muted mb-0">No guarantors attached.</p>';
    } else {
        loan.guarantors.forEach(g => {
            const gua    = g.guarantor;
            const bal    = gua?.account?.balance || 0;
            const gSt    = g.status || 'pending';
            const gBadge = gSt === 'accepted' ? 'bg-success' : gSt === 'declined' ? 'bg-danger' : 'bg-warning';
            gList.innerHTML += `
                <div class="card mb-2">
                    <div class="card-body py-2">
                        <div class="row g-1" style="font-size:.82rem;">
                            <div class="col-md-6">
                                <strong>${gua?.firstName || ''} ${gua?.lastName || ''}</strong>
                                <span class="badge ${gBadge} ms-1" style="font-size:.65rem;">${gSt.toUpperCase()}</span><br>
                                <span class="text-muted">ID: ${gua?.membershipID || 'N/A'}</span><br>
                                <span class="text-muted">Phone: ${gua?.phone || 'N/A'}</span>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted">Email: ${gua?.email || 'N/A'}</span><br>
                                <span class="text-muted">Balance: </span><strong class="text-success">₦${bal.toLocaleString()}</strong><br>
                                ${g.respondedAt ? `<span class="text-muted">Responded: ${new Date(g.respondedAt).toDateString()}</span>` : ''}
                            </div>
                        </div>
                    </div>
                </div>`;
        });
    }

    const isPending = loan.status === 'pending';
    document.getElementById('approveBtnModal').style.display = isPending ? 'inline-block' : 'none';
    document.getElementById('rejectBtnModal').style.display  = isPending ? 'inline-block' : 'none';

    new bootstrap.Modal(document.getElementById('viewLoanModal')).show();
}

document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.viewLoanBtn').forEach(btn => {
        btn.addEventListener('click', () => viewLoan(JSON.parse(btn.dataset.loan)));
    });
    computeStats();
    computeFilterCounts();
});

/* ══════════════════════════════════════
   APPROVE
══════════════════════════════════════ */
function approveLoan() {
    if (!selectedLoan) return;
    const isInt = !!selectedLoan.user;
    const name  = isInt ? `${selectedLoan.user.firstName} ${selectedLoan.user.lastName}` : (selectedLoan.external?.borrowerName || 'Company Loan');
    const dur   = selectedLoan.duration ? `${selectedLoan.duration.duration} Months` : `${selectedLoan.externalDuration || 'N/A'} Months`;
    document.getElementById('approveMemberName').textContent   = name;
    document.getElementById('approveLoanAmount').textContent   = fmt(selectedLoan.amount);
    document.getElementById('approveLoanInterest').textContent = selectedLoan.interestRate + '%';
    document.getElementById('approveLoanDuration').textContent = dur;
    document.getElementById('disbursementMethod').value = '';
    document.getElementById('disbursementDate').value   = '';
    bootstrap.Modal.getInstance(document.getElementById('viewLoanModal')).hide();
    new bootstrap.Modal(document.getElementById('approveLoanModal')).show();
}
async function confirmApproval() {
    if (!selectedLoan) { alert('No loan selected.'); return; }
    const method = document.getElementById('disbursementMethod').value;
    const date   = document.getElementById('disbursementDate').value;
    if (!method || !date) { alert('Please select a disbursement method and date.'); return; }
    try {
        const res = await fetch('/api/loans/approve', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ loanId: selectedLoan._id, disbursementMethod: method, disbursementDate: date })
        });
        if (!res.ok) { const e = await res.json(); throw new Error(e.message || 'Failed to approve.'); }
        alert('Loan approved successfully!');
        bootstrap.Modal.getInstance(document.getElementById('approveLoanModal')).hide();
        location.reload();
    } catch (err) { alert(`Error: ${err.message}`); }
}

/* ══════════════════════════════════════
   REJECT
══════════════════════════════════════ */
document.getElementById('rejectionReason').addEventListener('change', function () {
    document.getElementById('otherReasonDiv').style.display = this.value === 'Other' ? 'block' : 'none';
    if (this.value !== 'Other') document.getElementById('rejectionDetails').value = '';
});
function rejectLoanFromModal() {
    if (!selectedLoan) return;
    const isInt = !!selectedLoan.user;
    document.getElementById('rejectMemberName').textContent = isInt
        ? `${selectedLoan.user.firstName} ${selectedLoan.user.lastName}`
        : (selectedLoan.external?.borrowerName || 'Company Loan');
    document.getElementById('rejectLoanAmount').textContent = fmt(selectedLoan.amount);
    document.getElementById('rejectionReason').value  = '';
    document.getElementById('rejectionDetails').value = '';
    document.getElementById('otherReasonDiv').style.display = 'none';
    bootstrap.Modal.getInstance(document.getElementById('viewLoanModal')).hide();
    new bootstrap.Modal(document.getElementById('rejectLoanModal')).show();
}
async function confirmRejection() {
    if (!selectedLoan) return;
    const reason  = document.getElementById('rejectionReason').value.trim();
    const details = document.getElementById('rejectionDetails').value.trim();
    if (!reason) { alert('Please select a rejection reason.'); return; }
    if (reason === 'Other' && !details) { alert("Please specify the rejection details for 'Other'."); return; }
    try {
        const res = await fetch('/api/loans/reject', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ loanId: selectedLoan._id, reason, details: details || reason })
        });
        if (!res.ok) { const e = await res.json(); throw new Error(e.message || 'Failed to reject.'); }
        const result = await res.json();
        alert(result.message || 'Loan rejected.');
        bootstrap.Modal.getInstance(document.getElementById('rejectLoanModal')).hide();
        location.reload();
    } catch (err) { alert(`Error: ${err.message}`); }
}

async function sendReminder(loanId) {
    try {
        const res  = await fetch(`/api/loans/${loanId}/reminder`, { method: 'POST' });
        const data = await res.json();
        alert(data.message || 'Reminder sent successfully.');
    } catch { alert('Failed to send reminder.'); }
}

