<script>
    let selectedLoan = null;

// When user clicks Approve in View Loan modal
function approveLoan(loanId) {
    if (!selectedLoan || selectedLoan._id !== loanId) return;

    // Populate Approve Loan modal fields dynamically
    document.getElementById("approveMemberName").innerText =
        `${selectedLoan.user.firstName} ${selectedLoan.user.lastName}`;
    document.getElementById("approveLoanAmount").innerText =
        "₦" + selectedLoan.amount.toLocaleString();
    document.getElementById("approveLoanInterest").innerText =
        selectedLoan.interestRate + "%";
    document.getElementById("approveLoanDuration").innerText =
        selectedLoan.duration.duration + " Months";

    // Reset disbursement fields
    document.getElementById("disbursementMethod").value = "";
    document.getElementById("disbursementDate").value = "";

    // Hide view modal and show approve modal
    const viewModal = bootstrap.Modal.getInstance(document.getElementById("viewLoanModal"));
    viewModal.hide();

    const approveModal = new bootstrap.Modal(document.getElementById("approveLoanModal"));
    approveModal.show();
}

// Confirm Approval
async function confirmApproval() {
    if (!selectedLoan) {
        alert("No loan selected.");
        return;
    }

    const method = document.getElementById("disbursementMethod").value;
    const date = document.getElementById("disbursementDate").value;

    if (!method || !date) {
        alert("Please select a disbursement method and date.");
        return;
    }

    // Prepare payload
    const payload = {
        loanId: selectedLoan._id,
        disbursementMethod: method,
        disbursementDate: date
    };

    try {
        const response = await fetch("/api/loans/approve", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                // Add authorization header if needed, e.g.:
                // "Authorization": "Bearer YOUR_TOKEN"
            },
            body: JSON.stringify(payload)
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || "Failed to approve loan.");
        }

        const result = await response.json();
        console.log("Loan approved successfully:", result);

        alert(`Loan for ${selectedLoan.user.firstName} approved successfully! Member has been notified.`);

        // Hide modal
        const approveModal = bootstrap.Modal.getInstance(document.getElementById("approveLoanModal"));
        approveModal.hide();

        // Optionally, refresh loan list or update UI
        // loadLoans();

    } catch (error) {
        console.error("Error approving loan:", error);
        alert(`Error: ${error.message}`);
    }
}


