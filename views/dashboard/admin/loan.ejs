<script>
function viewLoan(loan) {
    // Member Info
    document.getElementById("loanMemberName").innerText =
        `${loan.user.firstName} ${loan.user.lastName}`;

    document.getElementById("loanMemberID").innerText =
        `Member ID: ${loan.user.membershipID}`;

    document.getElementById("loanMemberEmail").innerText =
        `Email: ${loan.user.email || 'N/A'}`;

    document.getElementById("loanMemberPhone").innerText =
        `Phone: ${loan.user.phone || 'N/A'}`;

    // Account Type Badge
    const accType = loan?.user?.account?.accountType?.name || "Unknown";
    const badge = document.getElementById("loanAccountBadge");

    badge.innerText = accType;
    badge.className = "badge " + 
        (accType.toLowerCase().includes("club") ? "bg-success" : "bg-warning");

    // Loan Details
    document.getElementById("loanAmount").innerText =
        "₦" + loan.amount.toLocaleString();

    document.getElementById("loanInterest").innerText =
        loan.interestRate + "%";

    document.getElementById("loanDuration").innerText =
        loan.duration?.duration + " Months";

    document.getElementById("loanTotalRepay").innerText =
        "₦" + loan.totalRepay.toLocaleString();

    const createdDate = new Date(loan.createdAt);
    document.getElementById("loanCreatedAt").innerText =
        createdDate.toDateString();

    const repayDate = new Date(createdDate);
    repayDate.setMonth(repayDate.getMonth() + loan.duration.duration);
    document.getElementById("loanRepayDate").innerText =
        repayDate.toDateString();

    // Guarantors Section
    const gList = document.getElementById("guarantorList");
    gList.innerHTML = "";

    if (!loan.guarantors || loan.guarantors.length === 0) {
        gList.innerHTML =
            `<p class="text-muted">No guarantors attached.</p>`;
    } else {
        loan.guarantors.forEach(g => {
            const bal = g.guarantor?.account?.balance || 0;

            gList.innerHTML += `
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Name:</strong> ${g.guarantor.firstName} ${g.guarantor.lastName}<br>
                                <strong>Member ID:</strong> ${g.guarantor.membershipID}<br>
                                <strong>Phone:</strong> ${g.guarantor.phone || 'N/A'}
                            </div>
                            <div class="col-md-6">
                                <strong>Email:</strong> ${g.guarantor.email || 'N/A'}<br>
                                <strong>Account Balance:</strong> ₦${bal.toLocaleString()}<br>
                                <strong>Status:</strong> ${g.status}
                            </div>
                        </div>
                    </div>
                </div>
            `;
        });
    }

    // Show Modal
    const modal = new bootstrap.Modal(document.getElementById("viewLoanModal"));
    modal.show();
}

// Global function
window.viewLoan = viewLoan;

// Dataset-based click handlers
document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".viewLoanBtn").forEach(btn => {
        btn.addEventListener("click", () => {
            const loan = JSON.parse(btn.dataset.loan);
            viewLoan(loan);
        });
    });
});
</script>


