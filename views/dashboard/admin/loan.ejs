<script>
    let selectedLoan = null;

// When user clicks Approve in View Loan modal
function approveLoan(loanId) {
    if (!selectedLoan || selectedLoan._id !== loanId) return;

    const isInternal = !!selectedLoan.user;

    const borrowerName = isInternal
        ? `${selectedLoan.user.firstName} ${selectedLoan.user.lastName}`
        : (selectedLoan.external?.borrowerName || "Company Loan");

    const durationText = isInternal
        ? `${selectedLoan.duration.duration} Months`
        : `${selectedLoan.externalDuration} Months`;

    document.getElementById("approveMemberName").innerText = borrowerName;
    document.getElementById("approveLoanAmount").innerText =
        "₦" + selectedLoan.amount.toLocaleString();
    document.getElementById("approveLoanInterest").innerText =
        selectedLoan.interestRate + "%";
    document.getElementById("approveLoanDuration").innerText =
        durationText;

    document.getElementById("disbursementMethod").value = "";
    document.getElementById("disbursementDate").value = "";

    const viewModal = bootstrap.Modal.getInstance(
        document.getElementById("viewLoanModal")
    );
    viewModal.hide();

    new bootstrap.Modal(
        document.getElementById("approveLoanModal")
    ).show();
}


// Confirm Approval
async function confirmApproval() {
    if (!selectedLoan) {
        alert("No loan selected.");
        return;
    }

    const method = document.getElementById("disbursementMethod").value;
    const date = document.getElementById("disbursementDate").value;

    if (!method || !date) {
        alert("Please select a disbursement method and date.");
        return;
    }

    // Prepare payload
    const payload = {
        loanId: selectedLoan._id,
        disbursementMethod: method,
        disbursementDate: date
    };

    try {
        const response = await fetch("/api/loans/approve", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                // Add authorization header if needed, e.g.:
                // "Authorization": "Bearer YOUR_TOKEN"
            },
            body: JSON.stringify(payload)
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || "Failed to approve loan.");
        }

        const result = await response.json();
        console.log("Loan approved successfully:", result);

        // Determine borrower name safely
        const borrowerName = selectedLoan.user
            ? `${selectedLoan.user.firstName} ${selectedLoan.user.lastName}`
            : selectedLoan.external?.borrowerName || "Company Loan";

        alert(`Loan for ${borrowerName} approved successfully!`);

        // Hide modal
        const approveModal = bootstrap.Modal.getInstance(
            document.getElementById("approveLoanModal")
        );
        approveModal.hide();

        // Optionally, refresh loan list or update UI
        // loadLoans();

    } catch (error) {
        console.error("Error approving loan:", error);
        alert(`Error: ${error.message}`);
    }
}


// Update viewLoan to set selectedLoan
function viewLoan(loan) {
    selectedLoan = loan;

    const isInternal = !!loan.user;
    const borrowerName = isInternal
        ? `${loan.user.firstName} ${loan.user.lastName}`
        : (loan.external?.borrowerName || "Company Loan");

    const borrowerId = isInternal
        ? `Member ID: ${loan.user.membershipID}`
        : `Type: ${loan.external?.borrowerType?.toUpperCase() || 'EXTERNAL'}`;

    const borrowerEmail = isInternal
        ? loan.user.email || "N/A"
        : loan.external?.email || "N/A";

    const borrowerPhone = isInternal
        ? loan.user.phone || "N/A"
        : loan.external?.phone || "N/A";

    // Header
    document.getElementById("loanMemberName").innerText = borrowerName;
    document.getElementById("loanMemberID").innerText = borrowerId;
    document.getElementById("loanMemberEmail").innerText = `Email: ${borrowerEmail}`;
    document.getElementById("loanMemberPhone").innerText = `Phone: ${borrowerPhone}`;

    // Account badge
    const accType = isInternal
        ? loan?.user?.account?.accountType?.name || "Unknown"
        : loan.external?.borrowerType?.toUpperCase() || "EXTERNAL";

    const badge = document.getElementById("loanAccountBadge");
    badge.innerText = accType;
    badge.className = "badge " + (isInternal ? "bg-success" : "bg-warning");

    // Loan details
    document.getElementById("loanAmount").innerText =
        "₦" + loan.amount.toLocaleString();
    document.getElementById("loanInterest").innerText =
        loan.interestRate + "%";

    document.getElementById("loanDuration").innerText =
        loan.duration
            ? loan.duration.duration + " Months"
            : (loan.externalDuration + " Months");

    document.getElementById("loanTotalRepay").innerText =
        "₦" + loan.totalRepay.toLocaleString();

    // Dates
    const createdDate = new Date(loan.createdAt);
    document.getElementById("loanCreatedAt").innerText =
        createdDate.toDateString();

    const repayDate = new Date(createdDate);
    repayDate.setMonth(
        repayDate.getMonth() +
        (loan.duration?.duration || loan.externalDuration || 0)
    );
    document.getElementById("loanRepayDate").innerText =
        repayDate.toDateString();

    // Guarantors
    const gList = document.getElementById("guarantorList");
    gList.innerHTML = "";

    if (!loan.guarantors || loan.guarantors.length === 0) {
        gList.innerHTML = `<p class="text-muted">No guarantors attached.</p>`;
    } else {
        loan.guarantors.forEach(g => {
            const gua = g.guarantor;
            const bal = gua?.account?.balance || 0;

            gList.innerHTML += `
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Name:</strong> ${gua?.firstName || ''} ${gua?.lastName || ''}<br>
                                <strong>Member ID:</strong> ${gua?.membershipID || 'N/A'}<br>
                                <strong>Phone:</strong> ${gua?.phone || 'N/A'}
                            </div>
                            <div class="col-md-6">
                                <strong>Email:</strong> ${gua?.email || 'N/A'}<br>
                                <strong>Account Balance:</strong> ₦${bal.toLocaleString()}<br>
                                <strong>Status:</strong> ${g.status}
                            </div>
                        </div>
                    </div>
                </div>`;
        });
    }

    // Show modal
    new bootstrap.Modal(document.getElementById("viewLoanModal")).show();
}

        // Reject loan from modal
        document.getElementById("rejectionReason").addEventListener("change", function() {
    const otherDiv = document.getElementById("otherReasonDiv");
    if (this.value === "other") {
        otherDiv.style.display = "block";
    } else {
        otherDiv.style.display = "none";
        document.getElementById("rejectionDetails").value = "";
    }
});

// Open reject modal and populate fields
function rejectLoanFromModal() {
    if (!selectedLoan) return;

    document.getElementById("rejectMemberName").innerText =
        `${selectedLoan.user.firstName} ${selectedLoan.user.lastName}`;
    document.getElementById("rejectLoanAmount").innerText =
        "₦" + selectedLoan.amount.toLocaleString();

    // Reset form fields
    document.getElementById("rejectionReason").value = "";
    document.getElementById("rejectionDetails").value = "";
    document.getElementById("otherReasonDiv").style.display = "none";

    // Hide view modal, show reject modal
    const viewModal = bootstrap.Modal.getInstance(document.getElementById("viewLoanModal"));
    viewModal.hide();

    const rejectModal = new bootstrap.Modal(document.getElementById("rejectLoanModal"));
    rejectModal.show();
}

    // Confirm rejection and send to backend
    async function confirmRejection() {
        if (!selectedLoan) return;

    let reason = document.getElementById("rejectionReason").value.trim();
    let details = document.getElementById("rejectionDetails").value.trim();

    // If "Other", require details
    if (reason === "Other" && !details) {
        alert("Please specify the rejection details for 'Other'.");
        return;
    }

    // Use details if "Other", otherwise just the reason message
    const messageToSend = (reason === "Other") ? details : reason;


    try {
        const response = await fetch("/api/loans/reject", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                loanId: selectedLoan._id,
                reason,
                details: details || reason // if not 'other', use reason as details
            })
        });

        if (!response.ok) {
            const err = await response.json();
            throw new Error(err.message || "Failed to reject loan.");
        }

        const result = await response.json();
        alert(result.message);

        const rejectModal = bootstrap.Modal.getInstance(document.getElementById("rejectLoanModal"));
        rejectModal.hide();

        // Refresh UI dynamically
        updateLoanCounts();
        updateLoanStats();

    } catch (error) {
        console.error("Error rejecting loan:", error);
        alert(`Error: ${error.message}`);
    }
}



</script>


