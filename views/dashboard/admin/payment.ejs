<!-- ════════════════════════ MAIN CONTENT ════════════════════════ -->
<div class="main-content">

    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-md-8">
                <h2 class="mb-2 fw-bold"><i class="fas fa-credit-card me-3"></i>Payment Management</h2>
                <p class="mb-0 opacity-90">All transactions require approval from 3 officers before processing</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="badge bg-light text-dark p-2">
                    <i class="fas fa-calendar me-1"></i><span id="currentDate"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Approval Notice -->
    <div class="approval-notice d-flex align-items-start gap-3">
        <i class="fas fa-info-circle mt-1" style="color:var(--warning);font-size:1.2rem;flex-shrink:0;"></i>
        <div>
            <strong style="color:#92400e;">Transaction Approval Required</strong>
            <p class="mb-0 mt-1 text-muted" style="font-size:.9rem;">
                Every transaction submitted here will be placed in a <strong>pending</strong> state.
                You must select 3 non-member officers who will each review and approve the transaction
                before it is processed. A single decline will reject the transaction immediately.
                Supports both <strong>regular members</strong> and <strong>kiddies accounts</strong>.
            </p>
        </div>
    </div>

    <!-- Payment Type Selection -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-list me-2" style="color:var(--primary);"></i>Select Payment Type
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-3 col-md-6 col-6">
                    <div class="payment-type-card" id="card-deposit" onclick="handlePaymentTypeClick('deposit', this)">
                        <div class="payment-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;">
                            <i class="fas fa-plus-circle"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Member Deposit</h6>
                        <small class="text-muted">Add funds to member / kiddies account</small>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <div class="payment-type-card" id="card-withdrawal" onclick="handlePaymentTypeClick('withdrawal', this)">
                        <div class="payment-icon" style="background:linear-gradient(135deg,#ef4444,#dc2626);color:white;">
                            <i class="fas fa-minus-circle"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Process Withdrawal</h6>
                        <small class="text-muted">Debit member / kiddies account</small>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <div class="payment-type-card" id="card-loan-repayment" onclick="handlePaymentTypeClick('loan-repayment', this)">
                        <div class="payment-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;">
                            <i class="fas fa-hand-holding-usd"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Loan Repayment</h6>
                        <small class="text-muted">Process loan payment (members only)</small>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <div class="payment-type-card" id="card-direct-debit" onclick="handlePaymentTypeClick('direct-debit', this)">
                        <div class="payment-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:white;">
                            <i class="fas fa-university"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Direct Debit</h6>
                        <small class="text-muted">Deduct charges / fees</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Form -->
    <div id="paymentForm" class="card fade-in" style="display:none;">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-bold" id="formTitle">
                <i class="fas fa-file-invoice-dollar me-2" style="color:var(--primary);"></i>Payment Details
            </h5>
            <button class="btn btn-sm btn-outline-secondary" onclick="resetForm()">
                <i class="fas fa-times me-1"></i>Cancel
            </button>
        </div>
        <div class="card-body">
            <div class="row g-4">

                <!-- Left Column -->
                <div class="col-lg-8">

                    <!-- Member Search -->
                    <div class="mb-4">
                        <label class="form-label">
                            <i class="fas fa-search me-2"></i>Search Member or Kiddies Account
                            <span class="text-danger">*</span>
                        </label>
                        <div class="autocomplete-wrapper">
                            <input type="text" class="form-control" id="memberSearch"
                                   placeholder="Type name, account ID, or email…"
                                   autocomplete="off"
                                   oninput="handleMemberSearch()"
                                   onfocus="handleMemberSearch()">
                            <div class="autocomplete-dropdown" id="autocompleteDropdown"></div>
                        </div>
                    </div>

                    <!-- Member Details Card -->
                    <div id="memberDetails" style="display:none;">
                        <div class="member-search-result mb-4" id="memberResultCard">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h6 class="mb-0 fw-bold" id="memberName"></h6>
                                        <span id="kiddiesAccountBadge" class="badge"
                                              style="background:linear-gradient(135deg,#ec4899,#db2777);color:white;display:none;">
                                            <i class="fas fa-baby me-1"></i>Kiddies
                                        </span>
                                    </div>
                                    <small class="text-muted d-block">
                                        <span id="memberID"></span> &bull; <span id="memberEmail"></span>
                                    </small>
                                    <div id="kiddiesParentInfo" style="display:none;" class="kiddies-info-panel">
                                        <i class="fas fa-user-friends fa-fw"></i>
                                        <span>Parent: <strong id="kiddiesParentName">—</strong>
                                              &bull; ID: <strong id="kiddiesParentID">—</strong></span>
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge bg-success me-2">
                                            <i class="fas fa-wallet me-1"></i>Balance: ₦<span id="memberBalance">0</span>
                                        </span>
                                        <span class="badge bg-warning text-dark" id="loanBadge" style="display:none;">
                                            <i class="fas fa-hand-holding-usd me-1"></i>Active loan
                                        </span>
                                    </div>
                                </div>
                                <div class="col-md-4 text-md-end mt-2 mt-md-0">
                                    <button class="btn btn-sm btn-outline-danger" onclick="clearMember()">
                                        <i class="fas fa-times me-1"></i>Clear
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Kiddies + loan-repayment warning -->
                        <div id="kiddiesLoanWarning"
                             class="alert alert-warning d-flex align-items-center gap-2 mb-3"
                             style="display:none!important;font-size:.88rem;">
                            <i class="fas fa-exclamation-triangle flex-shrink-0"></i>
                            Kiddies accounts do not support loan repayment. Please select a different payment type.
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-money-bill-wave me-2"></i>Amount (₦)
                                <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control" id="paymentAmount"
                                   placeholder="Enter amount" min="1" step="0.01"
                                   oninput="calculateTotal()">
                        </div>

                        <!-- Loan Selection -->
                        <div id="loanSelection" style="display:none;" class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-file-contract me-2"></i>Select Loan
                                <span class="text-danger">*</span>
                            </label>
                            <select id="loanSelect" class="form-select" onchange="updateLoanDetails()">
                                <option value="">— Select a loan —</option>
                            </select>
                            <div id="loanDetailsBox" class="mt-2 p-3 rounded-3 d-none"
                                 style="background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.3);">
                                <div class="row g-2 text-sm">
                                    <div class="col-6">
                                        <small class="text-muted d-block">Total Repayable</small>
                                        <strong>₦<span id="loanTotalRepay">0</span></strong>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted d-block">Balance Remaining</small>
                                        <strong class="text-danger">₦<span id="loanBalanceRemaining">0</span></strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Charge Type -->
                        <div id="chargeTypeDiv" style="display:none;" class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-tags me-2"></i>Charge Type
                                <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="chargeSelect">
                                <option value="">— Select charge type —</option>
                                <option value="admin-fee">Administrative Fee</option>
                                <option value="penalty">Late Payment Penalty</option>
                                <option value="service">Service Charge</option>
                                <option value="other">Other</option>
                            </select>
                        </div>

                        <!-- Payment Method -->
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-credit-card me-2"></i>Payment Method
                            </label>
                            <select class="form-select" id="paymentMethod">
                                <option value="cash">Cash</option>
                                <option value="bank-transfer">Bank Transfer</option>
                                <option value="pos">POS</option>
                                <option value="online">Online Payment</option>
                                <option value="cheque">Cheque</option>
                            </select>
                        </div>

                        <!-- Reference Number -->
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-hashtag me-2"></i>Reference Number
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="referenceNumber"
                                   placeholder="Enter bank / receipt reference number"
                                   oninput="updateSubmitButton()">
                            <div class="ref-required-notice mt-2">
                                <i class="fas fa-exclamation-triangle fa-fw"></i>
                                <span>
                                    A reference number is <strong>required</strong> before this transaction
                                    can be submitted or approved. Enter the bank receipt or transfer reference
                                    provided by the member.
                                </span>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="mb-4">
                            <label class="form-label">
                                <i class="fas fa-comment me-2"></i>Notes / Description
                            </label>
                            <textarea class="form-control" id="paymentNotes" rows="3"
                                      placeholder="Add any additional notes or context for this transaction"></textarea>
                        </div>

                        <!-- Approver Selection -->
                        <div class="mb-3" id="approverSection">
                            <label class="form-label d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span>
                                    <i class="fas fa-user-check me-2"></i>Select Approvers
                                    <span class="text-danger">*</span>
                                </span>
                                <span id="approverCountBadge" class="approval-count-badge insufficient">
                                    <i class="fas fa-exclamation-circle" id="approverCountIcon"></i>
                                    <span id="approverCountText">0 / 3 selected</span>
                                </span>
                            </label>
                            <p class="text-muted mb-2" style="font-size:.85rem;">
                                Choose exactly 3 officers with non-member roles to approve this transaction.
                            </p>

                            <div class="approver-locked-notice" id="approverLockedNotice" style="display:none;">
                                <i class="fas fa-lock fa-fw"></i>
                                <span>
                                    You don't have the permission to <strong>Authorize transactions</strong>
                                    and cannot assign approvers or submit transactions.
                                </span>
                            </div>

                            <div class="approver-selector" id="approverList">
                                <% if (!availableApprovers || availableApprovers.length === 0) { %>
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-users-slash fa-2x mb-2 d-block opacity-50"></i>
                                    No eligible approvers found. Ensure other users have non-member roles.
                                </div>
                                <% } else { %>
                                <% availableApprovers.forEach(function(approver) {
                                    const initials = (
                                        ((approver.firstName || '')[0] || '') +
                                        ((approver.lastName  || '')[0] || '')
                                    ).toUpperCase();
                                %>
                                <label class="approver-item" data-id="<%= approver._id %>">
                                    <input type="checkbox"
                                           value="<%= approver._id %>"
                                           data-name="<%= approver.firstName %> <%= approver.lastName %>"
                                           onchange="handleApproverToggle(this)">
                                    <div class="approver-avatar"><%= initials %></div>
                                    <div class="approver-info">
                                        <div class="approver-name"><%= approver.firstName %> <%= approver.lastName %></div>
                                        <div class="approver-role">
                                            <%= approver.role ? approver.role.name : 'Officer' %>
                                            &middot; <%= approver.email %>
                                        </div>
                                    </div>
                                    <i class="fas fa-check-circle approver-check"></i>
                                </label>
                                <% }) %>
                                <% } %>
                            </div>
                        </div>

                    </div><!-- /memberDetails -->
                </div><!-- /col-lg-8 -->

                <!-- Right Column: Summary -->
                <div class="col-lg-4">
                    <div class="card" style="position:sticky;top:90px;">
                        <div class="card-header">
                            <h6 class="mb-0 fw-bold"><i class="fas fa-receipt me-2"></i>Payment Summary</h6>
                        </div>
                        <div class="card-body">
                            <div id="summaryPlaceholder" class="text-center text-muted py-5">
                                <i class="fas fa-calculator fa-3x mb-3 d-block opacity-25"></i>
                                <p class="mb-0 small">Select a member and enter an amount to see the summary</p>
                            </div>

                            <div id="summaryDetails" style="display:none;">
                                <div class="payment-summary">
                                    <div class="summary-row">
                                        <span class="text-muted">Payment Type:</span>
                                        <span class="fw-semibold" id="summaryType">—</span>
                                    </div>
                                    <div class="summary-row" id="summaryMemberTypeRow" style="display:none;">
                                        <span class="text-muted">Account Type:</span>
                                        <span class="fw-semibold" id="summaryMemberTypeLabel" style="color:#db2777;">Kiddies Account</span>
                                    </div>
                                    <div class="summary-row">
                                        <span class="text-muted">Amount:</span>
                                        <span class="fw-bold">₦<span id="summaryAmount">0</span></span>
                                    </div>
                                    <div class="summary-row" id="chargeRow" style="display:none;">
                                        <span class="text-muted">Processing Fee:</span>
                                        <span class="fw-bold text-danger">₦<span id="summaryCharge">0</span></span>
                                    </div>
                                    <div class="summary-row">
                                        <span>Total:</span>
                                        <span class="fw-bold text-success">₦<span id="summaryTotal">0</span></span>
                                    </div>
                                </div>

                                <div class="mt-3 p-3 rounded-3"
                                     style="background:rgba(30,58,138,.03);border:1px solid rgba(30,58,138,.1);">
                                    <div class="d-flex justify-content-between mb-2">
                                        <small class="text-muted">Current Balance</small>
                                        <strong>₦<span id="summaryCurrentBalance">0</span></strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <small class="text-muted">Balance After</small>
                                        <strong class="text-primary">₦<span id="summaryNewBalance">0</span></strong>
                                    </div>
                                </div>

                                <div class="mt-3 p-3 rounded-3" id="summaryRefPanel"
                                     style="background:rgba(239,68,68,.05);border:1px solid rgba(239,68,68,.2);">
                                    <small class="d-block mb-1 fw-semibold" style="color:#dc2626;">
                                        <i class="fas fa-hashtag me-1"></i>Reference
                                    </small>
                                    <div id="summaryRefValue" class="fst-italic" style="color:#94a3b8;font-size:.85rem;">
                                        Not entered yet
                                    </div>
                                </div>

                                <div class="mt-3 p-3 rounded-3"
                                     style="background:rgba(30,58,138,.03);border:1px solid rgba(30,58,138,.1);">
                                    <small class="text-muted d-block mb-2 fw-semibold">
                                        <i class="fas fa-user-check me-1"></i>Selected Approvers
                                    </small>
                                    <div id="sidebarApproverList">
                                        <small class="text-muted fst-italic">None selected yet</small>
                                    </div>
                                </div>

                                <button class="btn btn-primary w-100 mt-4" id="submitBtn"
                                        onclick="submitForApproval()" disabled>
                                    <i class="fas fa-paper-plane me-2"></i>Submit for Approval
                                </button>
                                <small class="text-muted d-block text-center mt-2">
                                    <i class="fas fa-lock me-1"></i>Requires reference + 3 approvals before processing
                                </small>
                            </div>
                        </div>
                    </div>
                </div><!-- /col-lg-4 -->

            </div>
        </div>
    </div><!-- /paymentForm -->

    <form method="GET" action="/admin/manage-payment" class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <select name="range" class="form-select form-select-sm" style="width:auto;" onchange="toggleCustomRange(this.value)">
        <option value="all"       <%= currentRange==='all' ? 'selected':'' %>>All Time</option>
        <option value="today"     <%= currentRange==='today' ? 'selected':'' %>>Today</option>
        <option value="yesterday" <%= currentRange==='yesterday' ? 'selected':'' %>>Yesterday</option>
        <option value="7days"     <%= currentRange==='7days' ? 'selected':'' %>>Last 7 Days</option>
        <option value="thismonth" <%= currentRange==='thismonth' ? 'selected':'' %>>This Month</option>
        <option value="lastmonth" <%= currentRange==='lastmonth' ? 'selected':'' %>>Last Month</option>
        <option value="custom"    <%= currentRange==='custom' ? 'selected':'' %>>Custom Range</option>
    </select>
    <input type="date" name="from" id="rangeFrom" value="<%= currentFrom %>" class="form-control form-control-sm" style="width:auto; display:<%= currentRange==='custom'?'inline-block':'none' %>;">
    <input type="date" name="to"   id="rangeTo"   value="<%= currentTo %>"   class="form-control form-control-sm" style="width:auto; display:<%= currentRange==='custom'?'inline-block':'none' %>;">
    <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-filter me-1"></i>Apply</button>
    <% if (currentRange !== 'all') { %><a href="/admin/manage-payment" class="btn btn-sm btn-outline-secondary">Clear</a><% } %>
    </form>
    <script>
    function toggleCustomRange(val) {
    const show = val === 'custom';
    document.getElementById('rangeFrom').style.display = show ? 'inline-block' : 'none';
    document.getElementById('rangeTo').style.display   = show ? 'inline-block' : 'none';
    }
    </script>

    <!-- Recent Transactions Table -->
    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-history me-2" style="color:var(--primary);"></i>Recent Transactions
            </h5>
            <div class="d-flex gap-2 align-items-center">
                <select class="form-select form-select-sm" id="filterStatus" onchange="filterTable()" style="width:auto;">
                    <option value="">All Statuses</option>
                    <option value="successful">Successful</option>
                    <option value="pending">Pending</option>
                    <option value="rejected">Rejected</option>
                </select>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-download me-1"></i>Export
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm"
                        style="border:2px solid rgba(30,58,138,.1);border-radius:12px;min-width:220px;">
                        <li>
                            <a class="dropdown-item py-2" href="#" onclick="exportTransactions(); return false;">
                                <i class="fas fa-file-csv me-2 text-success"></i>
                                <span class="fw-semibold">Export as CSV</span>
                                <small class="d-block text-muted ps-4" style="font-size:.72rem;">Excel-compatible spreadsheet</small>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item py-2" href="#" onclick="exportTransactionsPDF(); return false;">
                                <i class="fas fa-file-pdf me-2 text-danger"></i>
                                <span class="fw-semibold">Export as PDF</span>
                                <small class="d-block text-muted ps-4" style="font-size:.72rem;">Printable branded report</small>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>Date / Time</th>
                            <th>Member</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="transactionTableBody">
                        <% if (!adminPayments || adminPayments.length === 0) { %>
                        <tr id="emptyRow">
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-2x d-block mb-2 opacity-25"></i>
                                No transactions yet
                            </td>
                        </tr>
                        <% } else {
                            const typesMap = {
                                'deposit':        { label: 'Deposit',        cls: 'success', sign: '+' },
                                'withdrawal':     { label: 'Withdrawal',     cls: 'danger',  sign: '-' },
                                'loan-repayment': { label: 'Loan Repayment', cls: 'warning', sign: ''  },
                                'direct-debit':   { label: 'Direct Debit',   cls: 'info',    sign: '-' }
                            };
                            const statusMap = { successful: 'success', pending: 'warning', rejected: 'danger' };
                            adminPayments.forEach(function(txn) {
                                const d          = new Date(txn.createdAt);
                                const type       = typesMap[txn.paymentType] || { label: txn.paymentType, cls: 'secondary', sign: '' };
                                const isKiddies  = txn.memberType === 'kiddies' || !!txn.kiddiesMember;
                                const memberName = isKiddies
                                    ? (txn.kiddiesMember ? (txn.kiddiesMember.childFirstName + ' ' + txn.kiddiesMember.childLastName) : 'Kiddies Account')
                                    : (txn.member ? (txn.member.firstName + ' ' + txn.member.lastName) : 'Deleted Member');
                                const membershipID = isKiddies
                                    ? (txn.kiddiesMember?.accountID || 'N/A')
                                    : (txn.member?.membershipID || 'N/A');
                                const processedBy = txn.admin ? (txn.admin.firstName + ' ' + txn.admin.lastName) : 'System';
                                const txnStatus    = txn.status || 'successful';
                                const txnStatusCls = statusMap[txnStatus] || 'secondary';
                                const approverNames = (txn.selectedApprovers || [])
                                    .filter(function(a) { return a && a.firstName; })
                                    .map(function(a) { return a.firstName + ' ' + a.lastName; })
                                    .join(' | ');
                                const approvalDetail = (txn.approvals || [])
                                    .map(function(ap) {
                                        const approver = (txn.selectedApprovers || []).find(function(u) {
                                            return u && String(u._id) === String(ap.user?._id || ap.user);
                                        });
                                        const name = approver
                                            ? (approver.firstName + ' ' + approver.lastName)
                                            : (ap.user?.firstName ? ap.user.firstName + ' ' + ap.user.lastName : 'Unknown');
                                        const when = new Date(ap.respondedAt).toLocaleString('en-US', { month:'short', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit' });
                                        return name + ' (' + ap.action + ' — ' + when + ')';
                                    })
                                    .join(' | ');
                                const txnData = {
                                    id:             txn._id.toString(),
                                    date:           d.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }),
                                    time:           d.toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit' }),
                                    dateRaw:        d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'),
                                    timeRaw:        d.toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit', hour12: true }),
                                    type:           type.label,
                                    typeClass:      type.cls,
                                    status:         txnStatus,
                                    statusClass:    txnStatusCls,
                                    reference:      txn.reference || 'N/A',
                                    memberName:     memberName,
                                    memberId:       membershipID,
                                    memberEmail:    isKiddies ? (txn.kiddiesMember?.parent?.email || 'N/A') : (txn.member?.email || 'N/A'),
                                    memberPhone:    isKiddies ? (txn.kiddiesMember?.parent?.phone || 'N/A') : (txn.member?.phone || 'N/A'),
                                    isKiddies:      isKiddies,
                                    amount:         txn.amount,
                                    method:         txn.paymentMethod.replace(/-/g,' ').toUpperCase(),
                                    fee:            txn.chargeAmount || 0,
                                    balanceBefore:  txn.balanceBefore,
                                    balanceAfter:   txn.balanceAfter,
                                    processedBy:    processedBy,
                                    notes:          txn.notes || 'No additional notes',
                                    approverNames:  approverNames  || 'N/A',
                                    approvalDetail: approvalDetail || 'N/A',
                                    source:      txn.source,
                                    rawType:     txn.paymentType,
                                    isReversed:  !!txn.isReversed,
                                    finalizedAt:    txn.finalizedAt
                                        ? new Date(txn.finalizedAt).toLocaleString('en-US', { month:'short', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit' })
                                        : 'N/A',
                                };
                        %>
                        <tr data-status="<%= txnStatus %>"
                            data-txn='<%- JSON.stringify(txnData) %>'
                            class="<%= isKiddies ? 'kiddies-row' : '' %>">
                            <td data-label="Date/Time">
                                <small class="fw-semibold d-block"><%= d.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %></small>
                                <small class="text-muted"><%= d.toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit' }) %></small>
                            </td>
                            <td data-label="Member">
                                <div class="fw-semibold d-flex align-items-center gap-1">
                                    <%= memberName %>
                                    <% if (isKiddies) { %>
                                    <span class="badge" style="background:rgba(236,72,153,.15);color:#db2777;font-size:.65rem;border:1px solid rgba(236,72,153,.3);">
                                        <i class="fas fa-baby me-1"></i>Kiddies
                                    </span>
                                    <% } %>
                                </div>
                                <small class="text-muted"><%= membershipID %></small>
                            </td>
                            <td data-label="Type"><span class="badge bg-<%= type.cls %>"><%= type.label %></span></td>
                            <td data-label="Amount" class="fw-bold text-<%= type.cls %>">
                                <%= type.sign %>₦<%= txn.amount.toLocaleString() %>
                            </td>
                            <td data-label="Method"><small><%= txn.paymentMethod.replace(/-/g,' ').toUpperCase() %></small></td>
                            <td data-label="Status">
                                <span class="badge bg-<%= txnStatusCls %>">
                                    <%= txnStatus.charAt(0).toUpperCase() + txnStatus.slice(1) %>
                                </span>
                            </td>
                            <td data-label="Actions">
                                <button class="btn btn-sm btn-outline-primary" title="View details"
                                        onclick='viewTransactionDetails(<%- JSON.stringify(txnData) %>)'>
                                    <i class="fas fa-eye"></i>
                                </button>
                                <% if (txn.source === 'workflow' && txnStatus === 'successful' && !txn.isReversed && ['deposit','withdrawal','direct-debit'].includes(txn.paymentType)) { %>
                                <button class="btn btn-sm btn-outline-danger" title="Reverse transaction"
                                        onclick='openReverseModal(<%- JSON.stringify(txnData) %>)'>
                                    <i class="fas fa-undo"></i>
                                </button>
                                <% } %>
                                <% if (txn.isReversed) { %><span class="badge bg-secondary ms-1">Reversed</span><% } %>
                            </td>
                        </tr>
                        <% }); } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div><!-- /main-content -->

<div class="powered-by">Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

