                    Generated on: <span id="printGeneratedDate"></span><br>
                    Powered by <strong>JESZ LIMITED</strong>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentPaymentType = '';
        let selectedMember = null;
        let searchTimeout = null;
 

        // Display current date
        document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', { 
            weekday: 'short', 
            year: 'numeric', 
            month: 'short', 
            day: 'numeric' 
        });

        function selectPaymentType(type) {
            currentPaymentType = type;
            
            // Update active state
            document.querySelectorAll('.payment-type-card').forEach(card => {
                card.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
            
            // Update form title
            const titles = {
                'deposit': 'Member Deposit',
                'withdrawal': 'Process Withdrawal',
                'loan-repayment': 'Loan Repayment',
                'direct-debit': 'Direct Debit'
            };
            
            document.getElementById('formTitle').innerHTML = `
                <i class="fas fa-file-invoice-dollar me-2" style="color: var(--primary);"></i>
                ${titles[type]}
            `;
            
            // Show/hide relevant fields
            document.getElementById('loanSelection').style.display = type === 'loan-repayment' ? 'block' : 'none';
            document.getElementById('chargeType').style.display = type === 'direct-debit' ? 'block' : 'none';
            document.getElementById('loanBadge').style.display = type === 'loan-repayment' ? 'inline-block' : 'none';
            
            // Show form
            document.getElementById('paymentForm').style.display = 'block';
            
            // Scroll to form
            document.getElementById('paymentForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
            
            // Clear previous data
            clearMember();
        }


function handleMemberSearch() {
  const searchTerm = document
    .getElementById('memberSearch')
    .value
    .trim()
    .toLowerCase();

  const dropdown = document.getElementById('autocompleteDropdown');

  if (searchTimeout) {
    clearTimeout(searchTimeout);
  }

  if (!searchTerm) {
    dropdown.classList.remove('show');
    dropdown.innerHTML = '';
    return;
  }

  searchTimeout = setTimeout(async () => {
    try {
      const res = await fetch(
        `/admin/search-member?q=${encodeURIComponent(searchTerm)}`
      );
      const members = await res.json();

      if (!members.length) {
        dropdown.innerHTML = `
          <div class="autocomplete-item text-center text-muted py-3">
            <i class="fas fa-search mb-2"></i>
            <div>No members found</div>
          </div>
        `;
        dropdown.classList.add('show');
        return;
      }

      dropdown.innerHTML = members.map(member => `
        <div class="autocomplete-item" onclick='selectMember(${JSON.stringify(member)})'>
          <div class="autocomplete-item-name">${member.name}</div>
          <div class="autocomplete-item-details">
            ${member.membershipID} | ${member.email}
          </div>
          <div class="autocomplete-item-balance">
            Balance: ₦${Number(member.balance).toLocaleString()}
          </div>
        </div>
      `).join('');

      dropdown.classList.add('show');

    } catch (err) {
      console.error('Live member search failed:', err);
    }
  }, 300);
}



function selectMember(member) {
  selectedMember = member;

  document.getElementById('memberSearch').value = member.name;
  document.getElementById('autocompleteDropdown').classList.remove('show');

  document.getElementById('memberName').textContent = member.name;
  document.getElementById('memberID').textContent = member.membershipID;
  document.getElementById('memberEmail').textContent = member.email;
  document.getElementById('memberBalance').textContent =
    Number(member.balance).toLocaleString();

  document.getElementById('summaryCurrentBalance').textContent =
    Number(member.balance).toLocaleString();

  document.getElementById('memberDetails').style.display = 'block';

  /** 🔹 POPULATE LOANS */
  const loanSelect = document.getElementById('loanSelect');
  loanSelect.innerHTML = `<option value="">Select Loan</option>`;

  if (member.loans && member.loans.length > 0) {
    member.loans.forEach(loan => {
      loanSelect.insertAdjacentHTML(
        'beforeend',
        `<option value="${loan.id}"
          data-total="${loan.totalRepay}"
          data-balance="${loan.balanceRemaining}">
          ₦${loan.originalAmount.toLocaleString()} — ${loan.duration}
        </option>`
      );
    });
  } else {
    loanSelect.innerHTML += `<option disabled>No active loans</option>`;
  }
}


        function clearMember() {
            selectedMember = null;
            document.getElementById('memberDetails').style.display = 'none';
            document.getElementById('memberSearch').value = '';
            document.getElementById('paymentAmount').value = '';
            document.getElementById('summaryDetails').style.display = 'none';
            document.getElementById('summaryContent').style.display = 'block';
            document.getElementById('autocompleteDropdown').classList.remove('show');
        }

        function calculateTotal() {
            const amount = parseFloat(document.getElementById('paymentAmount').value) || 0;
            
            if (!selectedMember || amount <= 0) {
                return;
            }
            
            let charge = 0;
            let total = amount;
            let newBalance = selectedMember.balance;
            
            // Calculate based on payment type
            switch(currentPaymentType) {
                case 'deposit':
                    newBalance = selectedMember.balance + amount;
                    break;
                case 'withdrawal':
                    if (amount > selectedMember.balance) {
                        alert('Insufficient balance!');
                        document.getElementById('paymentAmount').value = '';
                        return;
                    }
                    newBalance = selectedMember.balance - amount;
                    break;
                case 'loan-repayment':
                    // Loan repayment doesn't affect main balance directly
                    newBalance = selectedMember.balance;
                    break;
                case 'direct-debit':
                    if (amount > selectedMember.balance) {
                        alert('Insufficient balance for debit!');
                        document.getElementById('paymentAmount').value = '';
                        return;
                    }
                    newBalance = selectedMember.balance - amount;
                    break;
            }
            
            // Update summary
            document.getElementById('summaryAmount').textContent = amount.toLocaleString();
            document.getElementById('summaryCharge').textContent = charge.toLocaleString();
            document.getElementById('summaryTotal').textContent = total.toLocaleString();
            document.getElementById('summaryNewBalance').textContent = newBalance.toLocaleString();
            
            // Show summary
            document.getElementById('summaryContent').style.display = 'none';
            document.getElementById('summaryDetails').style.display = 'block';
            
            // Show/hide charge row
            document.getElementById('chargeRow').style.display = charge > 0 ? 'flex' : 'none';
        }

function updateLoanDetails() {
  const loanSelect = document.getElementById('loanSelect');
  const selectedOption = loanSelect.options[loanSelect.selectedIndex];

  if (!selectedOption || !selectedOption.value) {
    document.getElementById('paymentAmount').value = '';
    return;
  }

  const balanceRemaining = Number(selectedOption.dataset.balance || 0);

  // Default repayment amount = remaining balance
  document.getElementById('paymentAmount').value = balanceRemaining;

  calculateTotal();
}


        function processPayment() {
            const amount = parseFloat(document.getElementById('paymentAmount').value);
            const method = document.getElementById('paymentMethod').value;
            const notes = document.getElementById('paymentNotes').value;
            
            if (!selectedMember || !amount || amount <= 0) {
                alert('Please fill in all required fields');
                return;
            }
            
            // Additional validation for specific payment types
            if (currentPaymentType === 'loan-repayment' && !document.getElementById('loanSelect').value) {
                alert('Please select a loan');
                return;
            }
            
            if (currentPaymentType === 'direct-debit' && !document.getElementById('chargeSelect').value) {
                alert('Please select charge type');
                return;
            }
            
            // Show confirmation modal
            const confirmationHTML = `
                <div class="payment-summary">
                    <div class="summary-row">
                        <span>Member:</span>
                        <span class="fw-bold">${selectedMember.name} (${selectedMember.id})</span>
                    </div>
                    <div class="summary-row">
                        <span>Type:</span>
                        <span class="fw-bold text-capitalize">${currentPaymentType.replace('-', ' ')}</span>
                    </div>
                    <div class="summary-row">
                        <span>Amount:</span>
                        <span class="fw-bold">₦${amount.toLocaleString()}</span>
                    </div>
                    <div class="summary-row">
                        <span>Method:</span>
                        <span class="fw-bold text-capitalize">${method.replace('-', ' ')}</span>
                    </div>
                    ${notes ? `
                    <div class="summary-row">
                        <span>Notes:</span>
                        <span class="fw-bold">${notes}</span>
                    </div>
                    ` : ''}
                </div>
            `;
            
            document.getElementById('confirmationDetails').innerHTML = confirmationHTML;
            new bootstrap.Modal(document.getElementById('confirmationModal')).show();
        }

async function confirmPayment() {
  bootstrap.Modal
    .getInstance(document.getElementById("confirmationModal"))
    .hide();

  const amount = parseFloat(document.getElementById("paymentAmount").value);
  const method = document.getElementById("paymentMethod").value;
  const notes = document.getElementById("paymentNotes").value;
  const referenceInput = document.getElementById("referenceNumber").value;

  try {
    const res = await fetch("/admin/confirm-payment", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        memberId: selectedMember.id,
        paymentType: currentPaymentType,
        amount,
        paymentMethod: method,
        reference: referenceInput,
        notes,
      }),
    });

    const data = await res.json();
    if (!data.success) {
      alert(data.message || "Payment failed");
      return;
    }

    const txn = data.transaction;
    const now = new Date(txn.date);

    const types = {
      "deposit": { label: "Deposit", class: "success" },
      "withdrawal": { label: "Withdrawal", class: "danger" },
      "loan-repayment": { label: "Loan Repayment", class: "warning" },
      "direct-debit": { label: "Direct Debit", class: "info" },
    };

    const type = types[txn.type];

    window.currentTransaction = {
      id: txn.reference,
      date: now.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      }),
      time: now.toLocaleTimeString("en-US", {
        hour: "2-digit",
        minute: "2-digit",
      }),
      type: type.label,
      typeClass: type.class,
      status: "Completed",
      statusClass: "success",
      reference: txn.reference,
      memberName: txn.member.name,
      memberId: txn.member.membershipID,
      memberEmail: txn.member.email,
      memberPhone: txn.member.phone || "N/A",
      amount: txn.amount,
      method: txn.paymentMethod.replace("-", " ").toUpperCase(),
      fee: txn.chargeAmount || 0,
      balanceBefore: txn.balanceBefore,
      balanceAfter: txn.balanceAfter,
      processedBy: txn.processedBy,
      notes: txn.notes || "No additional notes",
    };

    populatePrintReceipt(window.currentTransaction);
    addTransactionToTable();
    new bootstrap.Modal(document.getElementById("successModal")).show();

  } catch (err) {
    console.error("Payment error:", err);
    alert("Something went wrong while processing payment");
  }
}

        function addTransactionToTable() {
            const tbody = document.getElementById('transactionTableBody');
            const amount = parseFloat(document.getElementById('paymentAmount').value);
