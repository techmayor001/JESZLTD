<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Management - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; z-index: 1040; transition: all 0.3s;
            overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30,58,138,0.15);
            transform: translateX(0);
        }
        .sidebar-header { padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.1); }
        .logo-container { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .logo-box {
            width: 45px; height: 45px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; color: var(--primary); font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2); flex-shrink: 0;
        }
        .sidebar-title { font-size: 1.1rem; line-height: 1.2; }
        .admin-badge {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 12px; background: rgba(239,68,68,0.2);
            backdrop-filter: blur(10px); border-radius: 20px;
            border: 1px solid rgba(239,68,68,0.3); font-weight: 600; font-size: 0.8rem; margin-top: 8px;
        }
        .sidebar-menu { padding: 1rem 0; }
        .sidebar-menu a {
            color: rgba(255,255,255,0.85); text-decoration: none;
            padding: 0.875rem 1.5rem; display: flex; align-items: center;
            transition: all 0.3s; border-left: 3px solid transparent;
            font-weight: 500; font-size: 0.95rem;
        }
        .sidebar-menu a:hover { background: rgba(255,255,255,0.1); color: white; border-left-color: white; }
        .sidebar-menu a.active { background: rgba(255,255,255,0.15); color: white; border-left-color: white; }
        .sidebar-menu a i { width: 24px; margin-right: 12px; font-size: 1.1rem; flex-shrink: 0; }

        /* ── Top Navbar ── */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: 70px;
            background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,0.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            transition: all 0.3s; border-bottom: 1px solid rgba(30,58,138,0.1);
        }

        /* ── Main Content ── */
        .main-content {
            margin-left: var(--sidebar-width); margin-top: 70px;
            padding: 1.5rem; min-height: calc(100vh - 70px); transition: all 0.3s;
        }

        /* ── Page Header ── */
        .page-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30,58,138,0.25); position: relative; overflow: hidden;
        }
        .page-header::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,0.05); border-radius: 50%;
        }

        /* ── Cards ── */
        .card {
            border: none; border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30,58,138,0.08);
            background: white; border: 1px solid rgba(30,58,138,0.05);
        }
        .card-header {
            background: linear-gradient(135deg, rgba(30,58,138,0.03) 0%, rgba(59,130,246,0.03) 100%);
            border-bottom: 2px solid rgba(30,58,138,0.1);
            padding: 1.25rem; border-radius: 16px 16px 0 0 !important;
        }

        /* ── Payment Type Cards ── */
        .payment-type-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,0.08); transition: all 0.3s;
            cursor: pointer; border: 2px solid transparent; height: 100%;
        }
        .payment-type-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,0.15); border-color: var(--primary); }
        .payment-type-card.active { border-color: var(--primary); background: linear-gradient(135deg, rgba(30,58,138,0.03) 0%, rgba(59,130,246,0.03) 100%); }
        .payment-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 1rem; }

        /* ── Form Controls ── */
        .form-label { font-weight: 600; color: var(--primary); margin-bottom: 0.5rem; }
        .form-control, .form-select {
            border: 2px solid rgba(30,58,138,0.1); border-radius: 10px;
            padding: 0.75rem; transition: all 0.3s;
        }
        .form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 0.2rem rgba(30,58,138,0.1); }

        /* ── Buttons ── */
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none; padding: 0.75rem 1.5rem; border-radius: 10px; font-weight: 600; transition: all 0.3s;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(30,58,138,0.3); }

        /* ── Autocomplete ── */
        .autocomplete-wrapper { position: relative; }
        .autocomplete-dropdown {
            position: absolute; top: 100%; left: 0; right: 0; background: white;
            border: 2px solid var(--primary); border-top: none;
            border-radius: 0 0 10px 10px; max-height: 300px; overflow-y: auto;
            z-index: 1000; box-shadow: 0 8px 20px rgba(30,58,138,0.15); display: none;
        }
        .autocomplete-dropdown.show { display: block; }
        .autocomplete-item { padding: 1rem; cursor: pointer; border-bottom: 1px solid rgba(30,58,138,0.1); transition: all 0.2s; }
        .autocomplete-item:last-child { border-bottom: none; }
        .autocomplete-item:hover { background: linear-gradient(135deg, rgba(30,58,138,0.05) 0%, rgba(59,130,246,0.05) 100%); }
        .autocomplete-item-name { font-weight: 600; color: var(--primary); margin-bottom: 0.25rem; }
        .autocomplete-item-details { font-size: 0.85rem; color: var(--secondary); }
        .autocomplete-item-balance {
            display: inline-block; margin-top: 0.25rem; padding: 0.25rem 0.5rem;
            background: rgba(16,185,129,0.1); color: var(--success);
            border-radius: 6px; font-size: 0.8rem; font-weight: 600;
        }

        /* ── Member Result ── */
        .member-search-result {
            padding: 1rem; border: 2px solid rgba(30,58,138,0.1);
            border-radius: 10px; margin-bottom: 1rem; background: rgba(30,58,138,0.02);
        }

        /* ── Table ── */
        .table-responsive { border-radius: 0 0 16px 16px; overflow: hidden; }
        .table { margin: 0; }
        .table thead { background: linear-gradient(135deg, rgba(30,58,138,0.05) 0%, rgba(59,130,246,0.05) 100%); }
        .table thead th { border: none; padding: 1rem; font-weight: 600; color: var(--primary); white-space: nowrap; }
        .table tbody td { padding: 1rem; vertical-align: middle; border-bottom: 1px solid rgba(30,58,138,0.05); }
        .table tbody tr:last-child td { border-bottom: none; }
        .table tbody tr:hover { background: rgba(30,58,138,0.02); }

        /* ── Powered By ── */
        .powered-by {
            position: fixed; bottom: 15px; right: 15px; background: white;
            padding: 10px 16px; border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30,58,138,0.15);
            font-size: 0.8rem; font-weight: 600; color: var(--primary); z-index: 1000;
        }

        /* ── Payment Summary ── */
        .payment-summary {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border: 2px solid #10b981; border-radius: 12px; padding: 1.5rem; margin-top: 1rem;
        }
        .summary-row { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid rgba(16,185,129,0.2); }
        .summary-row:last-child { border-bottom: none; font-weight: bold; font-size: 1.1rem; padding-top: 1rem; }

        /* ── Approver Selector ── */
        .approver-selector {
            border: 2px solid rgba(30,58,138,0.1); border-radius: 12px;
            padding: 1rem; background: #fafbff; max-height: 300px; overflow-y: auto;
        }
        .approver-item {
            display: flex; align-items: center; gap: 10px; padding: 0.75rem;
            border-radius: 10px; border: 2px solid transparent; cursor: pointer;
            transition: all 0.2s; background: white; margin-bottom: 0.5rem;
            box-shadow: 0 2px 6px rgba(30,58,138,0.06);
        }
        .approver-item:last-child { margin-bottom: 0; }
        .approver-item:hover { border-color: rgba(30,58,138,0.3); background: rgba(30,58,138,0.02); }
        .approver-item.selected {
            border-color: var(--primary);
            background: linear-gradient(135deg, rgba(30,58,138,0.05) 0%, rgba(59,130,246,0.05) 100%);
        }
        .approver-item input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--primary); flex-shrink: 0; cursor: pointer; }
        .approver-avatar {
            width: 38px; height: 38px; border-radius: 50%;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white; display: flex; align-items: center; justify-content: center;
            font-weight: bold; font-size: 0.9rem; flex-shrink: 0;
        }
        .approver-info { flex: 1; min-width: 0; }
        .approver-name { font-weight: 600; font-size: 0.9rem; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .approver-role { font-size: 0.75rem; color: var(--secondary); }
        .approver-check { color: var(--primary); display: none; flex-shrink: 0; }
        .approver-item.selected .approver-check { display: block; }

        /* ── Approval Count Badge ── */
        .approval-count-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 12px; border-radius: 20px; font-weight: 600; font-size: 0.8rem;
        }
        .approval-count-badge.insufficient { background: rgba(239,68,68,0.1); color: var(--danger); border: 1px solid rgba(239,68,68,0.3); }
        .approval-count-badge.sufficient { background: rgba(16,185,129,0.1); color: var(--success); border: 1px solid rgba(16,185,129,0.3); }

        /* ── Approval Notice Banner ── */
        .approval-notice {
            background: linear-gradient(135deg, rgba(245,158,11,0.08) 0%, rgba(217,119,6,0.08) 100%);
            border: 2px solid rgba(245,158,11,0.3); border-radius: 12px;
            padding: 1rem 1.25rem; margin-bottom: 1.5rem;
        }

        /* ── Animations ── */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .fade-in { animation: fadeIn 0.5s ease; }

        /* ── Receipt (Print) ── */
        .receipt-container { max-width: 800px; margin: 0 auto; background: white; padding: 2rem; border: 2px solid #e5e7eb; }
        .receipt-header { text-align: center; border-bottom: 3px solid var(--primary); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
        .receipt-logo {
            width: 80px; height: 80px;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white; border-radius: 50%; display: flex; align-items: center;
            justify-content: center; font-size: 2.5rem; font-weight: bold; margin: 0 auto 1rem;
        }
        .receipt-title { font-size: 1.8rem; font-weight: bold; color: var(--primary); margin-bottom: 0.5rem; }
        .receipt-subtitle { color: var(--secondary); font-size: 0.9rem; }
        .receipt-section { margin-bottom: 1.5rem; }
        .receipt-section-title { font-weight: bold; color: var(--primary); border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem; margin-bottom: 1rem; }
        .receipt-row { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px dashed #e5e7eb; }
        .receipt-row:last-child { border-bottom: none; }
        .receipt-label { color: var(--secondary); font-weight: 500; }
        .receipt-value { font-weight: 600; color: #1f2937; }
        .receipt-amount {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border: 2px solid var(--success); border-radius: 10px;
            padding: 1rem; text-align: center; margin: 1.5rem 0;
        }
        .receipt-amount-label { color: var(--secondary); font-size: 0.9rem; margin-bottom: 0.5rem; }
        .receipt-amount-value { font-size: 2.5rem; font-weight: bold; color: var(--success); }
        .receipt-footer { text-align: center; border-top: 3px solid var(--primary); padding-top: 1.5rem; margin-top: 2rem; }
        .receipt-stamp {
            display: inline-block; border: 3px solid var(--success); color: var(--success);
            padding: 0.5rem 1.5rem; border-radius: 10px; font-weight: bold;
            transform: rotate(-5deg); margin: 1rem 0;
        }

        /* ── Responsive ── */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
            .table thead { display: none; }
            .table tbody tr { display: block; margin-bottom: 1rem; border: 2px solid rgba(30,58,138,0.1); border-radius: 12px; overflow: hidden; background: white; }
            .table tbody td { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-bottom: 1px solid rgba(30,58,138,0.05); }
            .table tbody td::before { content: attr(data-label); font-weight: 600; color: var(--primary); margin-right: 1rem; }
        }
        @media (max-width: 576px) {
            .top-navbar { height: 60px; padding: 0 1rem; }
            .main-content { margin-top: 60px; padding: 0.75rem; }
            .page-header { padding: 1.25rem; border-radius: 16px; }
            .powered-by { bottom: 10px; right: 10px; font-size: 0.7rem; padding: 8px 12px; }
        }
        @media print {
            body * { visibility: hidden; }
            #printReceipt, #printReceipt * { visibility: visible; }
            #printReceipt { position: absolute; left: 0; top: 0; width: 100%; }
            .sidebar, .top-navbar, .powered-by { display: none !important; }
        }
    </style>
</head>
<body>

    <!-- ══════════════════ SIDEBAR ══════════════════ -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-box">C</div>
                <div>
                    <h5 class="mb-0 fw-bold sidebar-title" style="text-transform:uppercase;">Club De Stars</h5>
                    <small class="opacity-75" style="font-size:0.75rem;">ADMIN PANEL</small>
                </div>
            </div>
            <div class="admin-badge">
                <i class="fas fa-shield-alt"></i>
                <span><%= admin.role?.name?.toUpperCase() || 'ADMIN' %></span>
            </div>
        </div>
        <div class="sidebar-menu">
            <a href="/admin-dashboard"><i class="fas fa-users"></i> Members</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i> Membership Types</a>
            <a href="/admin/manage-payment" class="active"><i class="fas fa-credit-card"></i> Payments</a>
            <a href="/admin/transaction-approvals">
                <i class="fas fa-tasks"></i> Approvals
                <span id="sidebarPendingBadge" class="badge bg-danger ms-1" style="display:none;">0</span>
            </a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i> Deposit Management</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i> Withdrawals</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-hand-holding-usd"></i> Extra Charges</a>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i> Loan Management</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i> Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i> External Loans</a>
            <a href="#"><i class="fas fa-chart-pie"></i> ROI Distribution</a>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i> Manage Subscription</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i> Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i> Settings</a>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i> Reports</a>
             <a href="/admin/logs"><i class="fas fa-history"></i> Admin Logs</a>
            <a href="/club-de-star-cooperative/dashboard" class="mt-3" style="color:rgba(255,255,255,.6);">
                <i class="fas fa-sign-in-alt"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- ══════════════════ TOP NAVBAR ══════════════════ -->
    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3"
           style="cursor:pointer;color:var(--primary);font-size:1.5rem;"
           onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color:var(--primary)">Payment Management</h5>
            <small class="text-muted">Process member payments — requires 3 approvals</small>
        </div>
        <a href="/admin/transaction-approvals" class="btn btn-outline-primary btn-sm ms-auto position-relative">
            <i class="fas fa-tasks me-1"></i>My Approvals
            <span id="navbarPendingBadge"
                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                  style="display:none;">0</span>
        </a>
    </div>

    <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
    <div class="main-content">

        <!-- Page Header -->
        <div class="page-header position-relative">
            <div class="row align-items-center position-relative" style="z-index:1;">
                <div class="col-md-8">
                    <h2 class="mb-2 fw-bold"><i class="fas fa-credit-card me-3"></i>Payment Management</h2>
                    <p class="mb-0 opacity-90">All transactions require approval from 3 officers before processing</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="badge bg-light text-dark p-2">
                        <i class="fas fa-calendar me-1"></i><span id="currentDate"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Approval Notice -->
        <div class="approval-notice d-flex align-items-start gap-3">
            <i class="fas fa-info-circle mt-1" style="color:var(--warning);font-size:1.2rem;flex-shrink:0;"></i>
            <div>
                <strong style="color:#92400e;">Transaction Approval Required</strong>
                <p class="mb-0 mt-1 text-muted" style="font-size:0.9rem;">
                    Every transaction submitted here will be placed in a <strong>pending</strong> state.
                    You must select 3 non-member officers who will each review and approve the transaction
                    before it is processed. A single decline will reject the transaction immediately.
                </p>
            </div>
        </div>

        <!-- Payment Type Selection -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-list me-2" style="color:var(--primary);"></i>Select Payment Type
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6 col-6">
                        <div class="payment-type-card" onclick="selectPaymentType('deposit', this)">
                            <div class="payment-icon" style="background:linear-gradient(135deg,#10b981 0%,#059669 100%);color:white;">
                                <i class="fas fa-plus-circle"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Member Deposit</h6>
                            <small class="text-muted">Add funds to member account</small>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-6">
                        <div class="payment-type-card" onclick="selectPaymentType('withdrawal', this)">
                            <div class="payment-icon" style="background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%);color:white;">
                                <i class="fas fa-minus-circle"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Process Withdrawal</h6>
                            <small class="text-muted">Debit member account</small>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-6">
                        <div class="payment-type-card" onclick="selectPaymentType('loan-repayment', this)">
                            <div class="payment-icon" style="background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%);color:white;">
                                <i class="fas fa-hand-holding-usd"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Loan Repayment</h6>
                            <small class="text-muted">Process loan payment</small>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-6">
                        <div class="payment-type-card" onclick="selectPaymentType('direct-debit', this)">
                            <div class="payment-icon" style="background:linear-gradient(135deg,#8b5cf6 0%,#7c3aed 100%);color:white;">
                                <i class="fas fa-university"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Direct Debit</h6>
                            <small class="text-muted">Deduct charges/fees</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Form -->
        <div id="paymentForm" class="card fade-in" style="display:none;">
            <div class="card-header">
                <h5 class="mb-0 fw-bold" id="formTitle">
                    <i class="fas fa-file-invoice-dollar me-2" style="color:var(--primary);"></i>Payment Details
                </h5>
            </div>
            <div class="card-body">
                <div class="row">

                    <!-- ── Left: Transaction Details ── -->
                    <div class="col-lg-8">

                        <!-- Member Search -->
                        <div class="mb-4">
                            <label class="form-label"><i class="fas fa-search me-2"></i>Search Member</label>
                            <div class="autocomplete-wrapper">
                                <input type="text" class="form-control" id="memberSearch"
                                       placeholder="Type member name, ID, or email..."
                                       autocomplete="off"
                                       oninput="handleMemberSearch()"
                                       onfocus="handleMemberSearch()">
                                <div class="autocomplete-dropdown" id="autocompleteDropdown"></div>
                            </div>
                        </div>

                        <!-- Member Details (shown after selection) -->
                        <div id="memberDetails" style="display:none;">
                            <div class="member-search-result">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h6 class="mb-1 fw-bold" id="memberName"></h6>
                                        <small class="text-muted d-block">
                                            <span id="memberID"></span> | <span id="memberEmail"></span>
                                        </small>
                                        <div class="mt-2">
                                            <span class="badge bg-success me-2">
                                                <i class="fas fa-wallet me-1"></i>Balance: ₦<span id="memberBalance">0</span>
                                            </span>
                                            <span class="badge bg-warning" id="loanBadge" style="display:none;">
                                                <i class="fas fa-hand-holding-usd me-1"></i>Loan active
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                        <button class="btn btn-sm btn-outline-danger" onclick="clearMember()">
                                            <i class="fas fa-times me-1"></i>Clear
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Amount -->
                            <div class="mb-3">
                                <label class="form-label"><i class="fas fa-money-bill-wave me-2"></i>Amount (₦)</label>
                                <input type="number" class="form-control" id="paymentAmount"
                                       placeholder="Enter amount" min="1" oninput="calculateTotal()">
                            </div>

                            <!-- Loan Selection (loan-repayment only) -->
                            <div id="loanSelection" style="display:none;" class="mb-3">
                                <label class="form-label"><i class="fas fa-file-contract me-2"></i>Select Loan</label>
                                <select id="loanSelect" class="form-select" onchange="updateLoanDetails()">
                                    <option value="">Select Loan</option>
                                </select>
                            </div>

                            <!-- Charge Type (direct-debit only) -->
                            <div id="chargeTypeDiv" style="display:none;" class="mb-3">
                                <label class="form-label"><i class="fas fa-tags me-2"></i>Charge Type</label>
                                <select class="form-select" id="chargeSelect">
                                    <option value="">Select charge type</option>
                                    <option value="admin-fee">Administrative Fee</option>
                                    <option value="penalty">Late Payment Penalty</option>
                                    <option value="service">Service Charge</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>

                            <!-- Payment Method -->
                            <div class="mb-3">
                                <label class="form-label"><i class="fas fa-credit-card me-2"></i>Payment Method</label>
                                <select class="form-select" id="paymentMethod">
                                    <option value="cash">Cash</option>
                                    <option value="bank-transfer">Bank Transfer</option>
                                    <option value="pos">POS</option>
                                    <option value="online">Online Payment</option>
                                    <option value="cheque">Cheque</option>
                                </select>
                            </div>

                            <!-- Reference -->
                            <div class="mb-3">
                                <label class="form-label"><i class="fas fa-hashtag me-2"></i>Reference Number <span class="text-muted fw-normal">(Optional)</span></label>
                                <input type="text" class="form-control" id="referenceNumber"
                                       placeholder="Enter transaction reference">
                            </div>

                            <!-- Notes -->
                            <div class="mb-4">
                                <label class="form-label"><i class="fas fa-comment me-2"></i>Notes / Description</label>
                                <textarea class="form-control" id="paymentNotes" rows="3"
                                          placeholder="Add any additional notes or description"></textarea>
                            </div>

                            <!-- ── Approver Selection ── -->
                            <div class="mb-3">
                                <label class="form-label d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <span><i class="fas fa-user-check me-2"></i>Select Approvers</span>
                                    <span id="approverCountBadge" class="approval-count-badge insufficient">
                                        <i class="fas fa-exclamation-circle" id="approverCountIcon"></i>
                                        <span id="approverCountText">0 / 3 selected</span>
                                    </span>
                                </label>
                                <p class="text-muted mb-2" style="font-size:0.85rem;">
                                    Choose exactly 3 officers with non-member roles to approve this transaction.
                                </p>

                                <div class="approver-selector" id="approverList">
                                    <% if (!availableApprovers || availableApprovers.length === 0) { %>
                                    <div class="text-center text-muted py-4">
                                        <i class="fas fa-users-slash fa-2x mb-2 d-block opacity-50"></i>
                                        No eligible approvers found. Ensure other users have non-member roles.
                                    </div>
                                    <% } else { %>
                                    <% availableApprovers.forEach(function(approver) {
                                        const initials = ((approver.firstName || '')[0] + (approver.lastName || '')[0]).toUpperCase();
                                    %>
                                    <label class="approver-item" data-id="<%= approver._id %>">
                                        <input type="checkbox" value="<%= approver._id %>"
                                               data-name="<%= approver.firstName %> <%= approver.lastName %>"
                                               onchange="handleApproverToggle(this)">
                                        <div class="approver-avatar"><%= initials %></div>
                                        <div class="approver-info">
                                            <div class="approver-name"><%= approver.firstName %> <%= approver.lastName %></div>
                                            <div class="approver-role">
                                                <%= approver.role ? approver.role.name : 'Officer' %> &middot; <%= approver.email %>
                                            </div>
                                        </div>
                                        <i class="fas fa-check-circle approver-check"></i>
                                    </label>
                                    <% }) %>
                                    <% } %>
                                </div>
                            </div>
                        </div><!-- /memberDetails -->
                    </div><!-- /col-lg-8 -->

                    <!-- ── Right: Payment Summary Sidebar ── -->
                    <div class="col-lg-4">
                        <div class="card" style="position:sticky;top:90px;">
                            <div class="card-header">
                                <h6 class="mb-0 fw-bold"><i class="fas fa-receipt me-2"></i>Payment Summary</h6>
                            </div>
                            <div class="card-body">

                                <!-- Placeholder -->
                                <div id="summaryPlaceholder" class="text-center text-muted py-5">
                                    <i class="fas fa-calculator fa-3x mb-3 d-block opacity-25"></i>
                                    <p class="mb-0">Select a member and enter payment details to see summary</p>
                                </div>

                                <!-- Summary Details -->
                                <div id="summaryDetails" style="display:none;">
                                    <div class="payment-summary">
                                        <div class="summary-row">
                                            <span>Amount:</span>
                                            <span class="fw-bold">₦<span id="summaryAmount">0</span></span>
                                        </div>
                                        <div class="summary-row" id="chargeRow" style="display:none;">
                                            <span>Processing Fee:</span>
                                            <span class="fw-bold text-danger">₦<span id="summaryCharge">0</span></span>
                                        </div>
                                        <div class="summary-row">
                                            <span>Total:</span>
                                            <span class="fw-bold text-success">₦<span id="summaryTotal">0</span></span>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <small class="text-muted d-block mb-1">Current Balance:</small>
                                        <div class="fw-bold" style="font-size:1.1rem;">₦<span id="summaryCurrentBalance">0</span></div>
                                    </div>

                                    <div class="mt-2">
                                        <small class="text-muted d-block mb-1">Balance After Approval:</small>
                                        <div class="fw-bold text-primary" style="font-size:1.1rem;">₦<span id="summaryNewBalance">0</span></div>
                                    </div>

                                    <!-- Selected Approvers in Sidebar -->
                                    <div class="mt-3 p-3 rounded-3"
                                         style="background:rgba(30,58,138,0.04);border:1px solid rgba(30,58,138,0.1);">
                                        <small class="text-muted d-block mb-2 fw-semibold">
                                            <i class="fas fa-user-check me-1"></i>Selected Approvers
                                        </small>
                                        <div id="sidebarApproverList">
                                            <small class="text-muted fst-italic">None selected yet</small>
                                        </div>
                                    </div>

                                    <button class="btn btn-primary w-100 mt-4" id="submitBtn"
                                            onclick="submitForApproval()" disabled>
                                        <i class="fas fa-paper-plane me-2"></i>Submit for Approval
                                    </button>
                                    <small class="text-muted d-block text-center mt-2">
                                        <i class="fas fa-lock me-1"></i>Requires 3 approvals before processing
                                    </small>
                                </div>

                            </div>
                        </div>
                    </div><!-- /col-lg-4 -->

                </div><!-- /row -->
            </div><!-- /card-body -->
        </div><!-- /paymentForm -->

        <!-- Recent Transactions Table -->
        <div class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-history me-2" style="color:var(--primary);"></i>Recent Transactions
                </h5>
                <button class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-download me-1"></i>Export
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Date / Time</th>
                                <th>Member</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="transactionTableBody">
                            <% if (!adminPayments || adminPayments.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="fas fa-inbox fa-2x d-block mb-2 opacity-25"></i>
                                    No transactions yet
                                </td>
                            </tr>
                            <% } else {
                                const typesMap = {
                                    'deposit':        { label: 'Deposit',        cls: 'success', sign: '+' },
                                    'withdrawal':     { label: 'Withdrawal',     cls: 'danger',  sign: '-' },
                                    'loan-repayment': { label: 'Loan Repayment', cls: 'warning', sign: ''  },
                                    'direct-debit':   { label: 'Direct Debit',   cls: 'info',    sign: '-' }
                                };
                                adminPayments.forEach(function(txn) {
                                    const d    = new Date(txn.createdAt);
                                    const type = typesMap[txn.paymentType] || { label: txn.paymentType, cls: 'secondary', sign: '' };
                                    const memberName  = txn.member ? (txn.member.firstName + ' ' + txn.member.lastName) : 'Deleted Member';
                                    const membershipID = txn.member ? (txn.member.membershipID || 'N/A') : 'N/A';
                                    const processedBy  = txn.admin  ? (txn.admin.firstName  + ' ' + txn.admin.lastName)  : 'System';
                                    const txnData = {
                                        id:           txn.reference || txn._id,
                                        date:         d.toLocaleDateString('en-US',  { month:'short', day:'numeric', year:'numeric' }),
                                        time:         d.toLocaleTimeString('en-US',  { hour:'2-digit', minute:'2-digit' }),
                                        type:         type.label,
                                        typeClass:    type.cls,
                                        status:       txn.status || 'successful',
                                        statusClass:  'success',
                                        reference:    txn.reference || 'N/A',
                                        memberName:   memberName,
                                        memberId:     membershipID,
                                        memberEmail:  txn.member ? (txn.member.email  || 'N/A') : 'N/A',
                                        memberPhone:  txn.member ? (txn.member.phone  || 'N/A') : 'N/A',
                                        amount:       txn.amount,
                                        method:       txn.paymentMethod.replace(/-/g,' ').toUpperCase(),
                                        fee:          txn.chargeAmount || 0,
                                        balanceBefore: txn.balanceBefore,
                                        balanceAfter:  txn.balanceAfter,
                                        processedBy:   processedBy,
                                        notes:         txn.notes || 'No additional notes'
                                    };
                            %>
                            <tr>
                                <td data-label="Date/Time">
                                    <small class="fw-semibold d-block">
                                        <%= d.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
                                    </small>
                                    <small class="text-muted">
                                        <%= d.toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit' }) %>
                                    </small>
                                </td>
                                <td data-label="Member">
                                    <div class="fw-semibold"><%= memberName %></div>
                                    <small class="text-muted"><%= membershipID %></small>
                                </td>
                                <td data-label="Type">
                                    <span class="badge bg-<%= type.cls %>"><%= type.label %></span>
                                </td>
                                <td data-label="Amount" class="fw-bold text-<%= type.cls %>">
                                    <%= type.sign %>₦<%= txn.amount.toLocaleString() %>
                                </td>
                                <td data-label="Method">
                                    <small><%= txn.paymentMethod.replace(/-/g,' ').toUpperCase() %></small>
                                </td>
                                <td data-label="Status">
                                    <span class="badge bg-success"><%= txn.status || 'successful' %></span>
                                </td>
                                <td data-label="Actions">
                                    <button class="btn btn-sm btn-outline-primary"
                                            onclick='viewTransactionDetails(<%- JSON.stringify(txnData) %>)'>
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                            <% }); } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div><!-- /main-content -->

    <!-- Powered By -->
    <div class="powered-by">
        <strong style="color:var(--primary);">Cloudbaam</strong>
        Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong>
    </div>

    <!-- ══════════════════ MODALS ══════════════════ -->

    <!-- Submission Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title"><i class="fas fa-clock me-2"></i>Transaction Submitted</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fas fa-hourglass-half fa-5x text-warning mb-3 d-block"></i>
                    <h4 class="mb-3">Awaiting Approval</h4>
                    <p class="text-muted">
                        Your transaction has been submitted and is now pending review.
                        The selected approvers have been notified.
                    </p>
                    <div class="mt-3 p-3 rounded" style="background:#fffbeb;border:1px solid #fde68a;">
                        <small class="fw-semibold" style="color:#92400e;">Approval ID:</small><br>
                        <strong id="approvalIdDisplay" style="font-family:monospace;font-size:0.9rem;color:#92400e;"></strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="/admin/transaction-approvals" class="btn btn-outline-primary">
                        <i class="fas fa-tasks me-1"></i>View All Approvals
                    </a>
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal" onclick="resetForm()">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction Details Modal -->
    <div class="modal fade" id="transactionDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
