  <% } else { 
      const typesMap = {
        deposit: { label: "Deposit", class: "success", sign: "+" },
        withdrawal: { label: "Withdrawal", class: "danger", sign: "-" },
        "loan-repayment": { label: "Loan Repayment", class: "warning", sign: "" },
        "direct-debit": { label: "Direct Debit", class: "info", sign: "-" }
