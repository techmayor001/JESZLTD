                    <td data-label="Type"><span class="badge bg-${type.class}">${type.label}</span></td>
                    <td data-label="Amount" class="fw-bold text-${type.class}">${type.sign}₦${amount.toLocaleString()}</td>
                    <td data-label="Method"><small>${method.replace('-', ' ')}</small></td>
                    <td data-label="Status"><span class="badge bg-success">Completed</span></td>
                    <td data-label="Actions">
                        <button class="btn btn-sm btn-outline-primary" onclick="viewTransactionDetails()">
                            <i class="fas fa-eye"></i>
                        </button>
                    </td>
                </tr>
            `;
            
            tbody.insertAdjacentHTML('afterbegin', row);
        }

        function resetForm() {
            clearMember();
            document.getElementById('paymentNotes').value = '';
            document.getElementById('referenceNumber').value = '';
            document.getElementById('paymentAmount').value = '';
            document.getElementById('loanSelect').value = '';
            document.getElementById('chargeSelect').value = '';
        }

        function printReceipt() {
            // Use the current transaction data
            if (window.currentTransaction) {
                // Show the receipt div temporarily
                const receiptDiv = document.getElementById('printReceipt');
                receiptDiv.style.display = 'block';
                
                // Wait a moment for rendering, then print
                setTimeout(() => {
                    window.print();
                    // Hide it again after printing
                    receiptDiv.style.display = 'none';
