                <div class="modal-header"
                     style="background:linear-gradient(135deg,#1e3a8a 0%,#3b82f6 100%);color:white;">
                    <h5 class="modal-title"><i class="fas fa-file-invoice me-2"></i>Transaction Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">

                        <!-- Transaction Info -->
                        <div class="col-md-6">
                            <div class="card h-100"
                                 style="background:linear-gradient(135deg,rgba(30,58,138,0.03) 0%,rgba(59,130,246,0.03) 100%);border:2px solid rgba(30,58,138,0.1);">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-3" style="color:var(--primary);">
                                        <i class="fas fa-info-circle me-2"></i>Transaction Information
                                    </h6>
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Transaction ID</small>
                                        <strong id="detailTxnId">—</strong>
                                    </div>
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Date &amp; Time</small>
                                        <strong id="detailDateTime">—</strong>
                                    </div>
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Transaction Type</small>
                                        <span id="detailType" class="badge bg-success">—</span>
                                    </div>
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Status</small>
                                        <span id="detailStatus" class="badge bg-success">—</span>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block mb-1">Reference</small>
                                        <strong id="detailReference">—</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Member Info -->
                        <div class="col-md-6">
                            <div class="card h-100"
                                 style="background:linear-gradient(135deg,rgba(16,185,129,0.03) 0%,rgba(5,150,105,0.03) 100%);border:2px solid rgba(16,185,129,0.1);">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-3" style="color:var(--success);">
                                        <i class="fas fa-user me-2"></i>Member Information
                                    </h6>
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Name</small>
                                        <strong id="detailMemberName">—</strong>
                                    </div>
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Member ID</small>
                                        <strong id="detailMemberId">—</strong>
                                    </div>
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Email</small>
                                        <strong id="detailMemberEmail">—</strong>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block mb-1">Phone</small>
                                        <strong id="detailMemberPhone">—</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Details -->
                        <div class="col-12">
                            <div class="card"
                                 style="background:linear-gradient(135deg,rgba(245,158,11,0.03) 0%,rgba(217,119,6,0.03) 100%);border:2px solid rgba(245,158,11,0.1);">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-3" style="color:var(--warning);">
                                        <i class="fas fa-money-bill-wave me-2"></i>Payment Details
                                    </h6>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <small class="text-muted d-block mb-1">Amount</small>
                                            <h4 class="mb-0 fw-bold text-success" id="detailAmount">—</h4>
                                        </div>
                                        <div class="col-md-4">
                                            <small class="text-muted d-block mb-1">Payment Method</small>
                                            <strong id="detailMethod">—</strong>
                                        </div>
                                        <div class="col-md-4">
                                            <small class="text-muted d-block mb-1">Processing Fee</small>
                                            <strong id="detailFee">—</strong>
                                        </div>
                                    </div>
                                    <hr>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <small class="text-muted d-block mb-1">Balance Before</small>
                                            <strong id="detailBalanceBefore">—</strong>
                                        </div>
                                        <div class="col-md-6">
                                            <small class="text-muted d-block mb-1">Balance After</small>
                                            <strong id="detailBalanceAfter" style="color:var(--success);">—</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Info -->
                        <div class="col-12">
                            <div class="card" style="border:2px solid rgba(30,58,138,0.1);">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-3" style="color:var(--primary);">
                                        <i class="fas fa-comment-alt me-2"></i>Additional Information
                                    </h6>
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Processed By</small>
                                        <strong id="detailProcessedBy">—</strong>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block mb-1">Notes</small>
                                        <p class="mb-0" id="detailNotes">—</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div><!-- /row -->
                </div><!-- /modal-body -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" onclick="printReceipt()">
                        <i class="fas fa-print me-2"></i>Print Receipt
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden Printable Receipt -->
