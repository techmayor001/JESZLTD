        <h5 class="mb-0 fw-bold" style="color:var(--primary)">Payment Management</h5>
        <small class="text-muted">Process member &amp; kiddies account payments — requires 3 approvals</small>
    </div>
    <div class="d-lg-none"><span class="fw-bold" style="color:var(--primary);font-size:.95rem;">Payments</span></div>
    <a href="/admin/transaction-approvals" class="btn btn-outline-primary btn-sm ms-auto position-relative">
        <i class="fas fa-tasks me-1"></i>My Approvals
