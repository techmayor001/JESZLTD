olor:${statusColor};font-weight:700;font-size:.65rem;text-transform:uppercase;">${escHtml(t.status||'—')}</span></td><td style="padding:7px 5px;font-size:.7rem;border-bottom:1px solid #e2e8f0;"><strong style="color:#1e3a8a;display:block;font-size:.68rem;">${escHtml(t.processedBy||'—')}</strong>${approverLines}</td><td style="padding:7px 5px;font-size:.65rem;border-bottom:1px solid #e2e8f0;color:#64748b;max-width:110px;word-break:break-word;">${escHtml((t.notes||'').slice(0,80))}${(t.notes||'').length>80?'…':''}</td></tr>`;
    }).join('');
    const html=`<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Transaction Report — Club De Stars</title><style>*{margin:0;padding:0;box-sizing:border-box;}body{font-family:Arial,Helvetica,sans-serif;color:#1f2937;background:#fff;}@page{size:A4 landscape;margin:12mm 8mm;}@media print{.no-print{display:none!important;}body{-webkit-print-color-adjust:exact;print-color-adjust:exact;}table{page-break-inside:auto;}tr{page-break-inside:avoid;page-break-after:auto;}}</style></head><body>
