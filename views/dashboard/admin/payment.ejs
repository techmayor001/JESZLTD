}

/* ════ MEMBER SEARCH ════ */
function handleMemberSearch() {
    const q=document.getElementById('memberSearch').value.trim();
    const dropdown=document.getElementById('autocompleteDropdown');
    if(searchTimeout) clearTimeout(searchTimeout);
    if(!q){dropdown.classList.remove('show');dropdown.innerHTML='';return;}
    searchTimeout=setTimeout(async()=>{
        try {
            const res=await fetch(`/admin/search-member?q=${encodeURIComponent(q)}`);
            if(!res.ok) return;
            const results=await res.json();
            if(!Array.isArray(results)||!results.length){
                dropdown.innerHTML=`<div class="autocomplete-item text-center text-muted py-3"><i class="fas fa-search fa-lg d-block mb-2 opacity-50"></i>No members found for "<strong>${escHtml(q)}</strong>"</div>`;
                dropdown.classList.add('show'); return;
            }
            dropdown.innerHTML=results.map(m=>{
                const isKiddies=m.entityType==='kiddies';
                const badgeHtml=isKiddies?`<span class="kiddies-tag"><i class="fas fa-baby"></i> Kiddies</span><br>`:'';
                const subDetail=isKiddies?`${escHtml(m.membershipID)} &bull; Parent: ${escHtml(m.parentName||'—')}`:`${escHtml(m.membershipID)} &bull; ${escHtml(m.email)}`;
                return `<div class="autocomplete-item ${isKiddies?'kiddies-item':''}" onclick='selectMember(${JSON.stringify(m).replace(/'/g,"&#39;")})'>
                    ${badgeHtml}<div class="autocomplete-item-name">${escHtml(m.name)}</div>
                    <div class="autocomplete-item-details">${subDetail}</div>
                    <span class="autocomplete-item-balance">Balance: ₦${Number(m.balance).toLocaleString()}</span>
                </div>`;
            }).join('');
            dropdown.classList.add('show');
        } catch(e){console.error('Member search error:',e);}
    },300);
}

function selectMember(member) {
    selectedMember=member;
    const isKiddies=member.entityType==='kiddies';
    document.getElementById('memberSearch').value=member.name;
    document.getElementById('autocompleteDropdown').classList.remove('show');
    document.getElementById('memberName').textContent=member.name;
    document.getElementById('memberID').textContent=member.membershipID;
    document.getElementById('memberEmail').textContent=isKiddies?(member.email||'N/A'):member.email;
    document.getElementById('memberBalance').textContent=Number(member.balance).toLocaleString();
    document.getElementById('summaryCurrentBalance').textContent=Number(member.balance).toLocaleString();
    document.getElementById('kiddiesAccountBadge').style.display=isKiddies?'':'none';
    const parentInfoEl=document.getElementById('kiddiesParentInfo');
    if(isKiddies&&(member.parentName||member.parentID)){
        parentInfoEl.style.display='flex';
        document.getElementById('kiddiesParentName').textContent=member.parentName||'—';
        document.getElementById('kiddiesParentID').textContent=member.parentID||'—';
    } else { parentInfoEl.style.display='none'; }
    const resultCard=document.getElementById('memberResultCard');
    if(isKiddies) resultCard.classList.add('kiddies-result'); else resultCard.classList.remove('kiddies-result');
    const loanSelect=document.getElementById('loanSelect');
    loanSelect.innerHTML='<option value="">— Select a loan —</option>';
    if(!isKiddies&&member.loans&&member.loans.length>0){
        member.loans.forEach(loan=>{
            const opt=document.createElement('option'); opt.value=loan.id;
            opt.dataset.total=loan.totalRepay; opt.dataset.balance=loan.balanceRemaining; opt.dataset.original=loan.originalAmount;
            opt.textContent=`₦${Number(loan.originalAmount).toLocaleString()} — ${loan.duration}`;
            loanSelect.appendChild(opt);
        });
    } else {
        const opt=document.createElement('option'); opt.disabled=true;
        opt.textContent=isKiddies?'Not applicable for kiddies accounts':'No active loans found'; loanSelect.appendChild(opt);
    }
    document.getElementById('loanBadge').style.display=(!isKiddies&&currentPaymentType==='loan-repayment'&&member.loans?.length>0)?'inline-flex':'none';
    document.getElementById('memberDetails').style.display='block';
    refreshKiddiesUI(); calculateTotal();
}

function refreshKiddiesUI() {
    if(!selectedMember) return;
    const isKiddies=selectedMember.entityType==='kiddies';
    const warnEl=document.getElementById('kiddiesLoanWarning');
    const amountInput=document.getElementById('paymentAmount');
    const loanSel=document.getElementById('loanSelection');
    if(isKiddies&&currentPaymentType==='loan-repayment'){
        warnEl.style.setProperty('display','flex','important'); amountInput.disabled=true; loanSel.style.display='none';
    } else {
        warnEl.style.setProperty('display','none','important'); amountInput.disabled=false;
        loanSel.style.display=(currentPaymentType==='loan-repayment')?'block':'none';
    }
    updateSubmitButton();
}

function clearMember() {
    selectedMember=null;
    document.getElementById('memberSearch').value='';
    document.getElementById('memberDetails').style.display='none';
    document.getElementById('paymentAmount').value='';
    document.getElementById('paymentAmount').disabled=false;
    document.getElementById('loanSelect').value='';
    document.getElementById('chargeSelect').value='';
    document.getElementById('referenceNumber').value='';
    document.getElementById('referenceNumber').classList.remove('is-invalid','is-valid');
    document.getElementById('paymentNotes').value='';
    document.getElementById('loanDetailsBox').classList.add('d-none');
    document.getElementById('autocompleteDropdown').classList.remove('show');
    document.getElementById('kiddiesLoanWarning').style.setProperty('display','none','important');
    document.getElementById('kiddiesParentInfo').style.display='none';
    document.getElementById('kiddiesAccountBadge').style.display='none';
    document.getElementById('memberResultCard').classList.remove('kiddies-result');
    document.getElementById('summaryDetails').style.display='none';
    document.getElementById('summaryPlaceholder').style.display='block';
    updateSubmitButton();
}

/* ════ AMOUNT & TOTAL CALCULATION ════ */
async function calculateTotal() {
    const amount=parseFloat(document.getElementById('paymentAmount').value)||0;
    if(!selectedMember||amount<=0){ document.getElementById('summaryDetails').style.display='none'; document.getElementById('summaryPlaceholder').style.display='block'; updateSubmitButton(); return; }
    if((currentPaymentType==='withdrawal'||currentPaymentType==='direct-debit')&&amount>Number(selectedMember.balance)){
        await showNotify({type:'error',title:'Insufficient Balance',message:`This amount (₦${amount.toLocaleString()}) exceeds the account's\ncurrent balance of ₦${Number(selectedMember.balance).toLocaleString()}.`});
        document.getElementById('paymentAmount').value=''; updateSubmitButton(); return;
    }
    let newBalance=Number(selectedMember.balance);
    if(currentPaymentType==='deposit') newBalance+=amount;
    else if(currentPaymentType==='withdrawal'||currentPaymentType==='direct-debit') newBalance-=amount;
    const typeLabels={'deposit':'Deposit','withdrawal':'Withdrawal','loan-repayment':'Loan Repayment','direct-debit':'Direct Debit'};
    const isKiddies=selectedMember.entityType==='kiddies';
    document.getElementById('summaryType').textContent=typeLabels[currentPaymentType]||'—';
    document.getElementById('summaryAmount').textContent=amount.toLocaleString();
    document.getElementById('summaryCharge').textContent='0';
    document.getElementById('summaryTotal').textContent=amount.toLocaleString();
    document.getElementById('summaryCurrentBalance').textContent=Number(selectedMember.balance).toLocaleString();
    document.getElementById('summaryNewBalance').textContent=newBalance.toLocaleString();
    document.getElementById('summaryMemberTypeRow').style.display=isKiddies?'':'none';
    document.getElementById('chargeRow').style.display='none';
    document.getElementById('summaryPlaceholder').style.display='none';
    document.getElementById('summaryDetails').style.display='block';
    updateSubmitButton();
}

function updateLoanDetails() {
    const sel=document.getElementById('loanSelect'); const opt=sel.options[sel.selectedIndex];
    const box=document.getElementById('loanDetailsBox');
    if(!opt||!opt.value){document.getElementById('paymentAmount').value='';box.classList.add('d-none');calculateTotal();return;}
    document.getElementById('loanTotalRepay').textContent=Number(opt.dataset.total||0).toLocaleString();
    document.getElementById('loanBalanceRemaining').textContent=Number(opt.dataset.balance||0).toLocaleString();
    box.classList.remove('d-none');
    document.getElementById('paymentAmount').value=Number(opt.dataset.balance||0);
    calculateTotal();
}

/* ════ APPROVER SELECTION ════ */
function handleApproverToggle(checkbox) {
    if(!PERMISSIONS.authorizeTransactions){checkbox.checked=false;showUnauthorized('authorize_transactions');return;}
    const item=checkbox.closest('.approver-item'); const id=checkbox.value; const name=checkbox.dataset.name;
    if(checkbox.checked){
        if(selectedApproverIds.length>=3){checkbox.checked=false;showNotify({type:'warning',title:'Selection Limit',message:'You can only select up to 3 approvers.\nDeselect one before choosing another.'});return;}
        selectedApproverIds.push(id); selectedApproverNames[id]=name; item.classList.add('selected');
    } else { selectedApproverIds=selectedApproverIds.filter(a=>a!==id); delete selectedApproverNames[id]; item.classList.remove('selected'); }
    updateApproverUI();
}

function updateApproverUI() {
    const count=selectedApproverIds.length;
    const badge=document.getElementById('approverCountBadge');
    document.getElementById('approverCountText').textContent=`${count} / 3 selected`;
    if(count>=3){badge.className='approval-count-badge sufficient';document.getElementById('approverCountIcon').className='fas fa-check-circle';}
    else{badge.className='approval-count-badge insufficient';document.getElementById('approverCountIcon').className='fas fa-exclamation-circle';}
    const listEl=document.getElementById('sidebarApproverList');
    if(!count){listEl.innerHTML='<small class="text-muted fst-italic">None selected yet</small>';}
    else{listEl.innerHTML=Object.entries(selectedApproverNames).map(([,name])=>`<div class="d-flex align-items-center gap-2 mb-1"><i class="fas fa-check-circle text-success" style="font-size:.75rem;flex-shrink:0;"></i><small class="fw-semibold">${escHtml(name)}</small></div>`).join('');}
    updateSubmitButton();
}

/* ════ SUBMIT BUTTON STATE ════ */
function updateSubmitButton() {
    const amount=parseFloat(document.getElementById('paymentAmount')?.value)||0;
    const reference=document.getElementById('referenceNumber')?.value?.trim()||'';
    const isKiddies=selectedMember?.entityType==='kiddies';
    const typeBlocked=isKiddies&&currentPaymentType==='loan-repayment';
    const canSubmit=selectedMember&&amount>0&&reference.length>0&&selectedApproverIds.length>=3&&PERMISSIONS.processDeposits&&PERMISSIONS.authorizeTransactions&&!typeBlocked;
    const btn=document.getElementById('submitBtn'); if(btn) btn.disabled=!canSubmit;
    const refInput=document.getElementById('referenceNumber');
    if(refInput&&selectedMember){
        if(reference.length>0){refInput.classList.remove('is-invalid');refInput.classList.add('is-valid');}
        else{refInput.classList.remove('is-valid');refInput.classList.add('is-invalid');}
    }
    const summaryRefPanel=document.getElementById('summaryRefPanel');
    const summaryRefValue=document.getElementById('summaryRefValue');
    if(summaryRefPanel&&summaryRefValue){
        if(reference.length>0){summaryRefPanel.style.background='rgba(16,185,129,.05)';summaryRefPanel.style.border='1px solid rgba(16,185,129,.3)';summaryRefValue.style.color='#065f46';summaryRefValue.style.fontStyle='normal';summaryRefValue.style.fontWeight='600';summaryRefValue.textContent=reference;}
        else{summaryRefPanel.style.background='rgba(239,68,68,.05)';summaryRefPanel.style.border='1px solid rgba(239,68,68,.2)';summaryRefValue.style.color='#94a3b8';summaryRefValue.style.fontStyle='italic';summaryRefValue.style.fontWeight='normal';summaryRefValue.textContent='Not entered yet';}
    }
}

/* ════ SUBMIT FOR APPROVAL ════ */
async function submitForApproval() {
    if(!PERMISSIONS.processDeposits){showUnauthorized('process_deposits');return;}
    if(!PERMISSIONS.authorizeTransactions){showUnauthorized('authorize_transactions');return;}
    const amount=parseFloat(document.getElementById('paymentAmount').value);
    const method=document.getElementById('paymentMethod').value;
    const notes=document.getElementById('paymentNotes').value.trim();
    const reference=document.getElementById('referenceNumber').value.trim();
    const loanId=document.getElementById('loanSelect')?.value||null;
    const chargeType=document.getElementById('chargeSelect')?.value||null;
    if(!selectedMember){await showNotify({type:'warning',title:'No Member Selected',message:'Please search and select a member or kiddies account first.'});return;}
    if(!amount||amount<=0){await showNotify({type:'warning',title:'Invalid Amount',message:'Please enter a valid amount greater than zero.'});return;}
    if(!reference){const refInput=document.getElementById('referenceNumber');refInput.classList.add('is-invalid');refInput.focus();await showNotify({type:'error',title:'Reference Required',message:'A transaction reference number is required.\n\nPlease enter the bank receipt or transfer reference number before submitting. This is needed to trace and audit the transaction.'});return;}
    if(selectedApproverIds.length<3){await showNotify({type:'warning',title:'Approvers Required',message:`You have selected ${selectedApproverIds.length} approver(s).\nPlease select exactly 3 approvers.`});return;}
    if(selectedMember.entityType==='kiddies'&&currentPaymentType==='loan-repayment'){await showNotify({type:'error',title:'Not Supported',message:'Kiddies accounts do not support loan repayment.'});return;}
    if(currentPaymentType==='loan-repayment'&&!loanId){await showNotify({type:'warning',title:'Loan Not Selected',message:'Please select the loan you are repaying.'});return;}
    if(currentPaymentType==='direct-debit'&&!chargeType){await showNotify({type:'warning',title:'Charge Type Required',message:'Please select a charge type for the direct debit.'});return;}
    const isKiddies=selectedMember.entityType==='kiddies';
    const memberLabel=isKiddies?`${selectedMember.name} (Kiddies Account)`:selectedMember.name;
    const confirmed=await showNotify({type:'info',title:'Confirm Submission',message:`Submit a ₦${amount.toLocaleString()} ${currentPaymentType.replace(/-/g,' ')} for ${memberLabel}?\n\nReference: ${reference}\n\nThis will notify all 3 selected approvers.`,confirmLabel:'Yes, Submit',cancelLabel:'Cancel'});
    if(!confirmed) return;
    const btn=document.getElementById('submitBtn'); const originalBtnHTML=btn.innerHTML;
    btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2" role="status"></span>Submitting…';
    const result=await permFetch('/admin/submit-payment-for-approval',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({memberId:selectedMember.id,memberType:selectedMember.entityType,paymentType:currentPaymentType,amount,chargeAmount:0,paymentMethod:method,reference,notes:notes||undefined,loanId:loanId||undefined,chargeType:chargeType||undefined,selectedApprovers:selectedApproverIds})});
    if(!result.ok){btn.disabled=false;btn.innerHTML=originalBtnHTML;return;}
    if(!result.data?.success){await showNotify({type:'error',title:'Submission Failed',message:result.data?.message||'The server rejected the submission. Please try again.'});btn.disabled=false;btn.innerHTML=originalBtnHTML;return;}
    document.getElementById('approvalIdDisplay').textContent=result.data.approvalId||'—';
    new bootstrap.Modal(document.getElementById('successModal')).show();
}

/* ════ RESET FORM ════ */
function resetForm() {
    clearMember();
    selectedApproverIds=[]; selectedApproverNames={};
    document.querySelectorAll('.approver-item').forEach(el=>{el.classList.remove('selected');const cb=el.querySelector('input[type="checkbox"]');if(cb)cb.checked=false;});
    updateApproverUI();
    const btn=document.getElementById('submitBtn'); if(btn){btn.disabled=true;btn.innerHTML='<i class="fas fa-paper-plane me-2"></i>Submit for Approval';}
    document.querySelectorAll('.payment-type-card').forEach(c=>c.classList.remove('active'));
    document.getElementById('paymentForm').style.display='none';
    currentPaymentType='';
    window.scrollTo({top:0,behavior:'smooth'});
}

/* ════ TABLE FILTER ════ */
function filterTable() {
    const filter=document.getElementById('filterStatus').value.toLowerCase();
    const rows=document.querySelectorAll('#transactionTableBody tr[data-status]');
    let visible=0;
    rows.forEach(row=>{const match=!filter||(row.dataset.status||'').toLowerCase()===filter;row.style.display=match?'':'none';if(match)visible++;});
    let emptyRow=document.getElementById('filterEmptyRow');
    if(visible===0){
        if(!emptyRow){emptyRow=document.createElement('tr');emptyRow.id='filterEmptyRow';emptyRow.innerHTML=`<td colspan="7" class="text-center text-muted py-4"><i class="fas fa-filter fa-2x d-block mb-2 opacity-25"></i>No transactions match the selected filter</td>`;document.getElementById('transactionTableBody').appendChild(emptyRow);}
        emptyRow.style.display='';
    } else if(emptyRow){emptyRow.style.display='none';}
}

/* ════ GATHER EXPORT ROWS ════ */
function gatherExportRows() {
    const filter=document.getElementById('filterStatus').value;
    const rows=document.querySelectorAll('#transactionTableBody tr[data-txn]');
    const result=[];
    rows.forEach(row=>{
        if(filter&&(row.dataset.status||'').toLowerCase()!==filter.toLowerCase()) return;
        if(row.style.display==='none') return;
        try{result.push(JSON.parse(row.dataset.txn));}catch(_){}
    });
    return result;
}

/* ════ EXPORT CSV ════ */
function exportTransactions() {
    const txns=gatherExportRows();
    if(!txns.length){showNotify({type:'info',title:'Nothing to Export',message:'No transactions match the selected filter.'});return;}
    const headers=['Transaction ID','Date','Time','Account Type','Member / Account Name','Member / Account ID','Email','Phone','Payment Type','Amount (N)','Processing Fee (N)','Total (N)','Payment Method','Balance Before (N)','Balance After (N)','Reference','Status','Processed By','Selected Approvers','Approval Detail','Finalized At','Notes'];
    const lines=[headers.join(',')];
    txns.forEach(t=>{
        const fee=Number(t.fee||0),amt=Number(t.amount||0),total=amt+fee;
        const cols=[t.id||'—',t.dateRaw||t.date||'—',t.timeRaw||t.time||'—',t.isKiddies?'Kiddies Account':'Member Account',t.memberName||'—',t.memberId||'—',t.memberEmail||'—',t.memberPhone||'—',t.type||'—',amt,fee,total,t.method||'—',Number(t.balanceBefore||0),Number(t.balanceAfter||0),t.reference||'—',t.status||'—',t.processedBy||'—',t.approverNames||'—',t.approvalDetail||'—',t.finalizedAt||'—',(t.notes||'No additional notes').replace(/\n/g,' ')].map(v=>`"${String(v).replace(/"/g,'""')}"`);
        lines.push(cols.join(','));
    });
    const bom='\uFEFF';
    const blob=new Blob([bom+lines.join('\r\n')],{type:'text/csv;charset=utf-8;'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a'); a.href=url; a.download=`transactions-${new Date().toISOString().slice(0,10)}.csv`; a.click(); URL.revokeObjectURL(url);
    showNotify({type:'success',title:'CSV Export Complete',message:`${txns.length} transaction${txns.length!==1?'s':''} exported successfully.`});
}

