      adminPayments.forEach(txn => {
        const date = new Date(txn.createdAt);
        const type = typesMap[txn.paymentType];
  %>
    <tr>
      <!-- Date / Time -->
      <td data-label="Date/Time">
        <small class="fw-semibold"><%= date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></small><br>
        <small class="text-muted"><%= date.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" }) %></small>
      </td>

      <!-- Member -->
      <td data-label="Member">
        <div class="fw-semibold"><%= txn.member ? txn.member.firstName + " " + txn.member.lastName : "Deleted Member" %></div>
        <small class="text-muted"><%= txn.member?.membershipID || "N/A" %></small>
      </td>

      <!-- Type -->
      <td data-label="Type">
        <span class="badge bg-<%= type.class %>"><%= type.label %></span>
      </td>

      <!-- Amount -->
      <td data-label="Amount" class="fw-bold text-<%= type.class %>">
        <%= type.sign %>₦<%= txn.amount.toLocaleString() %>
      </td>

      <!-- Method -->
      <td data-label="Method"><small><%= txn.paymentMethod.replace("-", " ").toUpperCase() %></small></td>

      <!-- Status -->
      <td data-label="Status">
        <span class="badge bg-success"><%= txn.status || "successful" %></span>
      </td>

      <!-- Actions -->
      <td data-label="Actions">
<button
  class="btn btn-sm btn-outline-primary"
  onclick='viewTransactionDetails(<%- JSON.stringify({
    id: txn.reference || "N/A",
    date: date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }),
    time: date.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" }),
    type: type.label,
    typeClass: type.class,
    status: txn.status || "Completed",
    statusClass: "success",
    reference: txn.reference || "N/A",
    memberName: txn.member ? txn.member.firstName + " " + txn.member.lastName : "Deleted Member",
    memberId: txn.member?.membershipID || "N/A",
    memberEmail: txn.member?.email || "N/A",
