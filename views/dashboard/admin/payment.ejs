<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Management - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white;
            z-index: 1040;
            transition: all 0.3s;
            overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30, 58, 138, 0.15);
            transform: translateX(0);
        }
        
        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.1);
        }
        
        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        
        .logo-box {
            width: 45px;
            height: 45px;
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--primary);
            font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            flex-shrink: 0;
        }
        
        .sidebar-title {
            font-size: 1.1rem;
            line-height: 1.2;
        }
        
        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: rgba(239, 68, 68, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(239, 68, 68, 0.3);
            font-weight: 600;
            font-size: 0.8rem;
            margin-top: 8px;
        }
        
        .sidebar-menu {
            padding: 1rem 0;
        }
        
        .sidebar-menu a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            padding: 0.875rem 1.5rem;
            display: flex;
            align-items: center;
            transition: all 0.3s;
            border-left: 3px solid transparent;
            font-weight: 500;
            font-size: 0.95rem;
        }
        
        .sidebar-menu a:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a.active {
            background: rgba(255,255,255,0.15);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a i {
            width: 24px;
            margin-right: 12px;
            font-size: 1.1rem;
            flex-shrink: 0;
        }
        
        /* Top Navbar */
        .top-navbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: 70px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.08);
            z-index: 1030;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            transition: all 0.3s;
            border-bottom: 1px solid rgba(30, 58, 138, 0.1);
        }
        
        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: 70px;
            padding: 1.5rem;
            min-height: calc(100vh - 70px);
            transition: all 0.3s;
        }
        
        .page-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white;
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30, 58, 138, 0.25);
            position: relative;
            overflow: hidden;
        }
        
        .page-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }
        
        .payment-type-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            transition: all 0.3s;
            cursor: pointer;
            border: 2px solid transparent;
            height: 100%;
        }
        
        .payment-type-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(30, 58, 138, 0.15);
            border-color: var(--primary);
        }
        
        .payment-type-card.active {
            border-color: var(--primary);
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.03) 0%, rgba(59, 130, 246, 0.03) 100%);
        }
        
        .payment-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }
        
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            background: white;
            border: 1px solid rgba(30, 58, 138, 0.05);
        }
        
        .card-header {
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.03) 0%, rgba(59, 130, 246, 0.03) 100%);
            border-bottom: 2px solid rgba(30, 58, 138, 0.1);
            padding: 1.25rem;
            border-radius: 16px 16px 0 0 !important;
        }
        
        .form-label {
            font-weight: 600;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }
        
        .form-control, .form-select {
            border: 2px solid rgba(30, 58, 138, 0.1);
            border-radius: 10px;
            padding: 0.75rem;
            transition: all 0.3s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(30, 58, 138, 0.1);
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(30, 58, 138, 0.3);
        }
        
        .amount-display {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border: 2px solid var(--primary);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
        }
        
        .member-search-result {
            padding: 1rem;
            border: 2px solid rgba(30, 58, 138, 0.1);
            border-radius: 10px;
            margin-bottom: 1rem;
            background: rgba(30, 58, 138, 0.02);
        }
        
        .powered-by {
            position: fixed;
            bottom: 15px;
            right: 15px;
            background: white;
            padding: 10px 16px;
            border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.15);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--primary);
            z-index: 1000;
        }
        
        .alert-custom {
            border-radius: 12px;
            padding: 1rem;
            border: 2px solid;
        }
        
        .alert-info-custom {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border-color: #3b82f6;
            color: #1e40af;
        }
        
        .payment-summary {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border: 2px solid #10b981;
            border-radius: 12px;
            padding: 1.5rem;
            margin-top: 1rem;
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px solid rgba(16, 185, 129, 0.2);
        }
        
        .summary-row:last-child {
            border-bottom: none;
            font-weight: bold;
            font-size: 1.1rem;
            padding-top: 1rem;
        }
        
        /* Mobile Responsive */
        @media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }
            
            .sidebar.active {
                transform: translateX(0);
            }
            
            .top-navbar {
                left: 0;
            }
            
            .main-content {
                margin-left: 0;
                padding: 1rem;
            }
            
            .page-header {
                padding: 1.5rem;
            }
            
            .payment-type-card {
                padding: 1.25rem;
            }
            
            .powered-by {
                bottom: 10px;
                right: 10px;
                font-size: 0.7rem;
                padding: 8px 12px;
            }
        }
        
        @media (max-width: 576px) {
            .top-navbar {
                height: 60px;
                padding: 0 1rem;
            }
            
            .main-content {
                margin-top: 60px;
                padding: 0.75rem;
            }
            
            .page-header {
                padding: 1.25rem;
                border-radius: 16px;
            }
            
            .payment-type-card {
                padding: 1rem;
            }
            
            .payment-icon {
                width: 50px;
                height: 50px;
                font-size: 1.5rem;
            }
            
            .sidebar-header {
                padding: 1.25rem;
            }
            
            .logo-box {
                width: 40px;
                height: 40px;
                font-size: 1.25rem;
            }
            
            .sidebar-title {
                font-size: 1rem;
            }
        }
        
        .modal-content {
            border-radius: 16px;
        }
        
        .modal-header {
            border-radius: 16px 16px 0 0;
        }
        
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .fade-in {
            animation: fadeIn 0.5s ease;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-box">C</div>
                <div>
                    <h5 class="mb-0 fw-bold sidebar-title" style="text-transform: uppercase;">Club De Stars</h5>
                    <small class="opacity-75" style="font-size: 0.75rem;">ADMIN PANEL</small>
                </div>
            </div>
            <div class="admin-badge">
                <i class="fas fa-shield-alt"></i>
                <span>SUPER ADMIN</span>
            </div>
        </div>
        <div class="sidebar-menu">
            <a href="/admin-dashboard">
                <i class="fas fa-home"></i> Dashboard
            </a>
            <a href="/admin/manage/members">
                <i class="fas fa-users"></i> Members
            </a>
            <a href="/admin/manage/memberType">
                <i class="fas fa-id-card"></i> Membership Types
            </a>
            <a href="/admin/manage-payment" class="active">
                <i class="fas fa-credit-card"></i> Payments
            </a>
            <a href="#">
                <i class="fas fa-exchange-alt"></i> Transactions
            </a>
            <a href="/admin/manage-loan">
                <i class="fas fa-hand-holding-usd"></i> Loan Management
            </a>
            <a href="/admin/loan/settings">
                <i class="fas fa-cogs"></i> Loan Settings
            </a>
            <a href="#">
                <i class="fas fa-chart-pie"></i> ROI Distribution
            </a>
            <a href="#">
                <i class="fas fa-money-check-alt"></i> Withdrawals
            </a>
            <a href="#">
                <i class="fas fa-file-alt"></i> Reports
            </a>
            <a href="/admin/settings">
                <i class="fas fa-cog"></i> Settings
            </a>
            <a href="#" class="mt-3" style="color: rgba(255,255,255,0.6);">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <!-- Top Navbar -->
    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3"
           style="cursor: pointer; color: var(--primary); font-size: 1.5rem;"
           onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
        
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color: var(--primary)">Payment Management</h5>
            <small class="text-muted">Process member payments and transactions</small>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Page Header -->
        <div class="page-header position-relative">
            <div class="row align-items-center position-relative" style="z-index: 1;">
                <div class="col-md-8">
                    <h2 class="mb-2 fw-bold"><i class="fas fa-credit-card me-3"></i>Payment Management</h2>
                    <p class="mb-0 opacity-90">Process deposits, withdrawals, loan repayments and direct debits</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="badge bg-light text-dark">
                        <i class="fas fa-calendar me-1"></i>
                        <span id="currentDate"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Type Selection -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2" style="color: var(--primary);"></i>Select Payment Type</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6 col-6">
                        <div class="payment-type-card" onclick="selectPaymentType('deposit')">
                            <div class="payment-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                                <i class="fas fa-plus-circle"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Member Deposit</h6>
                            <small class="text-muted">Add funds to member account</small>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-6">
                        <div class="payment-type-card" onclick="selectPaymentType('withdrawal')">
                            <div class="payment-icon" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
                                <i class="fas fa-minus-circle"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Process Withdrawal</h6>
                            <small class="text-muted">Debit member account</small>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-6">
                        <div class="payment-type-card" onclick="selectPaymentType('loan-repayment')">
                            <div class="payment-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                                <i class="fas fa-hand-holding-usd"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Loan Repayment</h6>
                            <small class="text-muted">Process loan payment</small>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-6">
                        <div class="payment-type-card" onclick="selectPaymentType('direct-debit')">
                            <div class="payment-icon" style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white;">
                                <i class="fas fa-university"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Direct Debit</h6>
                            <small class="text-muted">Deduct charges/fees</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Form -->
        <div id="paymentForm" class="card fade-in" style="display: none;">
            <div class="card-header">
                <h5 class="mb-0 fw-bold" id="formTitle">
                    <i class="fas fa-file-invoice-dollar me-2" style="color: var(--primary);"></i>
                    Payment Details
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-8">
                        <!-- Member Search -->
                        <div class="mb-4">
                            <label class="form-label">
                                <i class="fas fa-search me-2"></i>Search Member
                            </label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="memberSearch" placeholder="Enter Member ID, Name, or Email">
                                <button class="btn btn-primary" onclick="searchMember()">
                                    <i class="fas fa-search"></i> Search
                                </button>
                            </div>
                        </div>

                        <!-- Member Details Display -->
                        <div id="memberDetails" style="display: none;">
                            <div class="member-search-result">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h6 class="mb-1 fw-bold" id="memberName">John Doe</h6>
                                        <small class="text-muted d-block">
                                            <span id="memberID">CDS001</span> | 
                                            <span id="memberEmail">john@example.com</span>
                                        </small>
                                        <div class="mt-2">
                                            <span class="badge bg-success me-2">
                                                <i class="fas fa-wallet me-1"></i>Balance: ₦<span id="memberBalance">150,000</span>
                                            </span>
                                            <span class="badge bg-warning" id="loanBadge">
                                                <i class="fas fa-hand-holding-usd me-1"></i>Loan: ₦<span id="memberLoan">50,000</span>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                        <button class="btn btn-sm btn-outline-danger" onclick="clearMember()">
                                            <i class="fas fa-times me-1"></i>Clear
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment Amount -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-money-bill-wave me-2"></i>Amount (₦)
                                </label>
                                <input type="number" class="form-control" id="paymentAmount" placeholder="Enter amount" oninput="calculateTotal()">
                            </div>

                            <!-- Loan Selection (for loan repayment) -->
                            <div id="loanSelection" style="display: none;" class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-file-contract me-2"></i>Select Loan
                                </label>
                                <select class="form-select" id="loanSelect" onchange="updateLoanDetails()">
                                    <option value="">Choose a loan</option>
                                    <option value="loan1">Loan #L001 - ₦100,000 (₦50,000 remaining)</option>
                                    <option value="loan2">Loan #L002 - ₦75,000 (₦30,000 remaining)</option>
                                </select>
                            </div>

                            <!-- Charge Type (for direct debit) -->
                            <div id="chargeType" style="display: none;" class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-tags me-2"></i>Charge Type
                                </label>
                                <select class="form-select" id="chargeSelect">
                                    <option value="">Select charge type</option>
                                    <option value="admin">Administrative Fee</option>
                                    <option value="penalty">Late Payment Penalty</option>
                                    <option value="service">Service Charge</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>

                            <!-- Payment Method -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-credit-card me-2"></i>Payment Method
                                </label>
                                <select class="form-select" id="paymentMethod">
                                    <option value="cash">Cash</option>
                                    <option value="bank-transfer">Bank Transfer</option>
                                    <option value="pos">POS</option>
                                    <option value="online">Online Payment</option>
                                    <option value="cheque">Cheque</option>
                                </select>
                            </div>

                            <!-- Reference Number -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-hashtag me-2"></i>Reference Number (Optional)
                                </label>
                                <input type="text" class="form-control" id="referenceNumber" placeholder="Enter transaction reference">
                            </div>

                            <!-- Notes/Description -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-comment me-2"></i>Notes/Description
                                </label>
                                <textarea class="form-control" id="paymentNotes" rows="3" placeholder="Add any additional notes or description"></textarea>
                            </div>

                            <!-- Alert for withdrawal -->
                            <div id="withdrawalAlert" class="alert-custom alert-info-custom mb-3" style="display: none;">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>Withdrawal Notice:</strong> Ensure member has sufficient balance and has met withdrawal conditions.
                            </div>
                        </div>
                    </div>

                    <!-- Payment Summary Sidebar -->
                    <div class="col-lg-4">
                        <div class="card" style="position: sticky; top: 90px;">
                            <div class="card-header">
                                <h6 class="mb-0 fw-bold">
                                    <i class="fas fa-receipt me-2"></i>Payment Summary
                                </h6>
                            </div>
                            <div class="card-body">
                                <div id="summaryContent">
                                    <div class="text-center text-muted py-5">
                                        <i class="fas fa-calculator fa-3x mb-3 opacity-25"></i>
                                        <p>Select a member and enter payment details to see summary</p>
                                    </div>
                                </div>

                                <div id="summaryDetails" style="display: none;">
                                    <div class="payment-summary">
                                        <div class="summary-row">
                                            <span>Amount:</span>
                                            <span class="fw-bold">₦<span id="summaryAmount">0</span></span>
                                        </div>
                                        <div class="summary-row" id="chargeRow" style="display: none;">
                                            <span>Processing Fee:</span>
                                            <span class="fw-bold text-danger">₦<span id="summaryCharge">0</span></span>
                                        </div>
                                        <div class="summary-row">
                                            <span>Total:</span>
                                            <span class="fw-bold text-success">₦<span id="summaryTotal">0</span></span>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <small class="text-muted d-block mb-1">Current Balance:</small>
                                        <div class="fw-bold" style="font-size: 1.1rem;">₦<span id="summaryCurrentBalance">0</span></div>
                                    </div>

                                    <div class="mt-2" id="newBalanceDiv">
                                        <small class="text-muted d-block mb-1">New Balance:</small>
                                        <div class="fw-bold text-primary" style="font-size: 1.1rem;">₦<span id="summaryNewBalance">0</span></div>
                                    </div>

                                    <button class="btn btn-primary w-100 mt-4" onclick="processPayment()">
                                        <i class="fas fa-check-circle me-2"></i>Process Payment
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Payment Transactions -->
        <div class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-history me-2" style="color: var(--primary);"></i>
                    Recent Transactions
                </h5>
                <button class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-download me-1"></i>Export
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                <table class="table table-hover mb-0">
  <thead>
    <tr>
      <th>Date/Time</th>
      <th>Member</th>
      <th>Type</th>
      <th>Amount</th>
      <th>Payee</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody id="transactionTableBody">

    <% if (payments && payments.length > 0) { %>
      <% payments.forEach(payment => { %>

        <tr>
          <!-- DATE / TIME -->
          <td>
            <small class="fw-semibold">
              <%= new Date(payment.createdAt).toLocaleDateString("en-NG", {
                year: "numeric",
                month: "short",
                day: "numeric"
              }) %>
            </small><br>
            <small class="text-muted">
              <%= new Date(payment.createdAt).toLocaleTimeString("en-NG", {
                hour: "2-digit",
                minute: "2-digit"
              }) %>
            </small>
          </td>

          <!-- MEMBER -->
          <td>
            <div class="fw-semibold">
              <%= payment.user?.firstName %> <%= payment.user?.lastName %>
            </div>
            <small class="text-muted">
              <%= payment.user?.membershipID || "N/A" %>
            </small>
          </td>

          <!-- TYPE -->
          <td>
            <% if (payment.loanId) { %>
              <span class="badge bg-warning-subtle text-warning">
                Loan Payment
              </span>
            <% } else { %>
              <span class="badge bg-success-subtle text-success">
                Deposit
              </span>
            <% } %>
          </td>

          <!-- AMOUNT -->
          <td class="fw-bold
            <%= payment.status === 'paid' ? 'text-success' : 'text-warning' %>">
            ₦<%= payment.amount.toLocaleString() %>
          </td>

          <!-- PAYEE -->
          <td>
            <small>
              <%= payment.payeeName || `${payment.user?.firstName} ${payment.user?.lastName}` %>
            </small>
          </td>

          <!-- STATUS -->
          <td>
            <% if (payment.status === "paid") { %>
              <span class="badge bg-success">Completed</span>
            <% } else if (payment.status === "pending") { %>
              <span class="badge bg-warning">Pending</span>
            <% } else { %>
              <span class="badge bg-danger">Failed</span>
            <% } %>
          </td>

          <!-- ACTIONS -->
          <td>
            <button
              class="btn btn-sm btn-outline-primary"
              onclick="viewPaymentDetails('<%= payment._id %>')">
              <i class="fas fa-eye"></i>
            </button>
          </td>
        </tr>

      <% }) %>
    <% } else { %>
      <tr>
        <td colspan="7" class="text-center text-muted py-4">
          No payment records found.
        </td>
      </tr>
    <% } %>

  </tbody>
</table>

                </div>
            </div>
        </div>
    </div>

    <!-- Powered By Footer -->
    <div class="powered-by">
        Powered by <strong style="color: var(--primary);">JESZ LIMITED</strong>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmationModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-check-circle me-2"></i>Confirm Payment
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert-custom alert-info-custom mb-3">
                        <i class="fas fa-info-circle me-2"></i>
                        Please review the payment details before confirming
                    </div>
                    <div id="confirmationDetails"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="confirmPayment()">
                        <i class="fas fa-check me-2"></i>Confirm & Process
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-check-circle me-2"></i>Payment Successful
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fas fa-check-circle fa-5x text-success mb-3"></i>
                    <h4 class="mb-3">Payment Processed Successfully!</h4>
                    <p class="text-muted mb-0">Transaction reference: <strong id="txnReference">TXN001234567</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="printReceipt()">
                        <i class="fas fa-print me-2"></i>Print Receipt
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="resetForm()">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentPaymentType = '';
        let selectedMember = null;

        // Display current date
        document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', { 
            weekday: 'short', 
            year: 'numeric', 
            month: 'short', 
            day: 'numeric' 
        });

        function selectPaymentType(type) {
            currentPaymentType = type;
            
            // Update active state
            document.querySelectorAll('.payment-type-card').forEach(card => {
                card.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
            
            // Update form title
            const titles = {
                'deposit': 'Member Deposit',
                'withdrawal': 'Process Withdrawal',
                'loan-repayment': 'Loan Repayment',
                'direct-debit': 'Direct Debit'
            };
            
            document.getElementById('formTitle').innerHTML = `
                <i class="fas fa-file-invoice-dollar me-2" style="color: var(--primary);"></i>
                ${titles[type]}
            `;
            
            // Show/hide relevant fields
            document.getElementById('loanSelection').style.display = type === 'loan-repayment' ? 'block' : 'none';
            document.getElementById('chargeType').style.display = type === 'direct-debit' ? 'block' : 'none';
            document.getElementById('withdrawalAlert').style.display = type === 'withdrawal' ? 'block' : 'none';
            document.getElementById('loanBadge').style.display = type === 'loan-repayment' ? 'inline-block' : 'none';
            
            // Show form
            document.getElementById('paymentForm').style.display = 'block';
            
            // Clear previous data
            clearMember();
        }

        function searchMember() {
            const searchTerm = document.getElementById('memberSearch').value;
            
            if (!searchTerm) {
                alert('Please enter a search term');
                return;
            }
            
            // Simulate API call - replace with actual API
            setTimeout(() => {
                selectedMember = {
                    id: 'CDS001',
                    name: 'John Doe',
                    email: 'john.doe@example.com',
                    balance: 150000,
                    loanBalance: 50000
                };
                
                // Display member details
                document.getElementById('memberName').textContent = selectedMember.name;
                document.getElementById('memberID').textContent = selectedMember.id;
                document.getElementById('memberEmail').textContent = selectedMember.email;
                document.getElementById('memberBalance').textContent = selectedMember.balance.toLocaleString();
                document.getElementById('memberLoan').textContent = selectedMember.loanBalance.toLocaleString();
                
                document.getElementById('memberDetails').style.display = 'block';
                document.getElementById('summaryCurrentBalance').textContent = selectedMember.balance.toLocaleString();
            }, 500);
        }

        function clearMember() {
            selectedMember = null;
            document.getElementById('memberDetails').style.display = 'none';
            document.getElementById('memberSearch').value = '';
            document.getElementById('paymentAmount').value = '';
            document.getElementById('summaryDetails').style.display = 'none';
            document.getElementById('summaryContent').style.display = 'block';
        }

        function calculateTotal() {
            const amount = parseFloat(document.getElementById('paymentAmount').value) || 0;
            
            if (!selectedMember || amount <= 0) {
                return;
            }
            
            let charge = 0;
            let total = amount;
            let newBalance = selectedMember.balance;
            
            // Calculate based on payment type
            switch(currentPaymentType) {
                case 'deposit':
                    newBalance = selectedMember.balance + amount;
                    break;
                case 'withdrawal':
                    if (amount > selectedMember.balance) {
                        alert('Insufficient balance!');
                        return;
                    }
                    newBalance = selectedMember.balance - amount;
                    break;
                case 'loan-repayment':
                    // Loan repayment doesn't affect main balance directly
                    break;
                case 'direct-debit':
                    newBalance = selectedMember.balance - amount;
                    break;
            }
            
            // Update summary
            document.getElementById('summaryAmount').textContent = amount.toLocaleString();
            document.getElementById('summaryCharge').textContent = charge.toLocaleString();
            document.getElementById('summaryTotal').textContent = total.toLocaleString();
            document.getElementById('summaryNewBalance').textContent = newBalance.toLocaleString();
            
            // Show summary
            document.getElementById('summaryContent').style.display = 'none';
            document.getElementById('summaryDetails').style.display = 'block';
            
            // Show/hide charge row
            document.getElementById('chargeRow').style.display = charge > 0 ? 'flex' : 'none';
        }

        function updateLoanDetails() {
            const loanSelect = document.getElementById('loanSelect').value;
            if (loanSelect) {
                // Pre-fill amount based on selected loan
                // This is a placeholder - implement actual logic
            }
        }

        function processPayment() {
            const amount = parseFloat(document.getElementById('paymentAmount').value);
            const method = document.getElementById('paymentMethod').value;
            const notes = document.getElementById('paymentNotes').value;
            
            if (!selectedMember || !amount || amount <= 0) {
                alert('Please fill in all required fields');
                return;
            }
            
            // Additional validation for specific payment types
            if (currentPaymentType === 'loan-repayment' && !document.getElementById('loanSelect').value) {
                alert('Please select a loan');
                return;
            }
            
            if (currentPaymentType === 'direct-debit' && !document.getElementById('chargeSelect').value) {
                alert('Please select charge type');
                return;
            }
            
            // Show confirmation modal
            const confirmationHTML = `
                <div class="payment-summary">
                    <div class="summary-row">
                        <span>Member:</span>
                        <span class="fw-bold">${selectedMember.name} (${selectedMember.id})</span>
                    </div>
                    <div class="summary-row">
                        <span>Type:</span>
                        <span class="fw-bold text-capitalize">${currentPaymentType.replace('-', ' ')}</span>
                    </div>
                    <div class="summary-row">
                        <span>Amount:</span>
                        <span class="fw-bold">₦${amount.toLocaleString()}</span>
                    </div>
                    <div class="summary-row">
                        <span>Method:</span>
                        <span class="fw-bold text-capitalize">${method}</span>
                    </div>
                    ${notes ? `
                    <div class="summary-row">
                        <span>Notes:</span>
                        <span class="fw-bold">${notes}</span>
                    </div>
                    ` : ''}
                </div>
            `;
            
            document.getElementById('confirmationDetails').innerHTML = confirmationHTML;
            new bootstrap.Modal(document.getElementById('confirmationModal')).show();
        }

        function confirmPayment() {
            // Close confirmation modal
            bootstrap.Modal.getInstance(document.getElementById('confirmationModal')).hide();
            
            // Simulate API call
            setTimeout(() => {
                // Generate transaction reference
                const txnRef = 'TXN' + Date.now();
                document.getElementById('txnReference').textContent = txnRef;
                
                // Add to transaction table
                addTransactionToTable();
                
                // Show success modal
                new bootstrap.Modal(document.getElementById('successModal')).show();
            }, 1000);
        }

        function addTransactionToTable() {
            const tbody = document.getElementById('transactionTableBody');
            const amount = parseFloat(document.getElementById('paymentAmount').value);
            const method = document.getElementById('paymentMethod').value;
            const now = new Date();
            
            const types = {
                'deposit': { label: 'Deposit', class: 'success', sign: '+' },
                'withdrawal': { label: 'Withdrawal', class: 'danger', sign: '-' },
                'loan-repayment': { label: 'Loan Repayment', class: 'warning', sign: '' },
                'direct-debit': { label: 'Direct Debit', class: 'purple', sign: '-' }
            };
            
            const type = types[currentPaymentType];
            
            const row = `
                <tr>
                    <td>
                        <small class="fw-semibold">${now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</small><br>
                        <small class="text-muted">${now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}</small>
                    </td>
                    <td>
                        <div class="fw-semibold">${selectedMember.name}</div>
                        <small class="text-muted">${selectedMember.id}</small>
                    </td>
                    <td><span class="badge bg-${type.class}-subtle text-${type.class}">${type.label}</span></td>
                    <td class="fw-bold text-${type.class}">${type.sign}₦${amount.toLocaleString()}</td>
                    <td><small>${method}</small></td>
                    <td><span class="badge bg-success">Completed</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="viewTransactionDetails()">
                            <i class="fas fa-eye"></i>
                        </button>
                    </td>
                </tr>
            `;
            
            tbody.insertAdjacentHTML('afterbegin', row);
        }

        function resetForm() {
            clearMember();
            document.getElementById('paymentForm').style.display = 'none';
            document.querySelectorAll('.payment-type-card').forEach(card => {
                card.classList.remove('active');
            });
            currentPaymentType = '';
        }

        function printReceipt() {
            // Implement print functionality
            alert('Receipt printing functionality would be implemented here');
        }

        function viewTransactionDetails() {
            alert('Transaction details would be displayed here');
        }

        // Close sidebar on mobile when clicking outside
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const hamburger = event.target.closest('.fa-bars');
            
            if (window.innerWidth <= 992 && 
                !sidebar.contains(event.target) && 
                !hamburger && 
                sidebar.classList.contains('active')) {
                sidebar.classList.remove('active');
            }
        });
    </script>

    <script>
async function searchMember() {
  const q = document.getElementById("memberSearch").value.trim();
  if (!q) return alert("Enter search value");

  const res = await fetch(`/admin/search-member?q=${q}`);
  const members = await res.json();

  if (!members.length) {
    alert("No member found");
    return;
  }

  // pick first result (or show dropdown later)
  const m = members[0];
  selectedMember = m;

  document.getElementById("memberName").textContent = m.name;
  document.getElementById("memberID").textContent = m.membershipID;
  document.getElementById("memberEmail").textContent = m.email;
  document.getElementById("memberBalance").textContent = m.balance.toLocaleString();
  document.getElementById("summaryCurrentBalance").textContent = m.balance.toLocaleString();

  document.getElementById("memberDetails").style.display = "block";
}
</script>

</body>
</html>