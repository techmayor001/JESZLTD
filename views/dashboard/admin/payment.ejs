<div class="modal fade" id="reverseModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header" style="background:linear-gradient(135deg,#7f1d1d 0%,#ef4444 100%);color:white;">
        <h5 class="modal-title"><i class="fas fa-undo me-2"></i>Reverse Transaction</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-danger">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Reversing <strong id="reverseTxnRef">—</strong> (₦<span id="reverseTxnAmount">0</span>).
          Requires 3 approvals, same as a new transaction.
        </div>
        <label class="form-label fw-bold">Reason for Reversal <span class="text-danger">*</span></label>
        <textarea class="form-control mb-3" id="reversalNotes" rows="2"></textarea>
        <label class="form-label d-flex justify-content-between">
          <span>Select 3 Approvers</span>
          <span id="reverseApproverCount" class="approval-count-badge insufficient">0 / 3 selected</span>
        </label>
        <div class="approver-selector" id="reverseApproverList">
          <% availableApprovers.forEach(function(approver){ %>
          <label class="approver-item" data-id="<%= approver._id %>">
            <input type="checkbox" value="<%= approver._id %>"
                   data-name="<%= approver.firstName %> <%= approver.lastName %>"
                   onchange="handleReverseApproverToggle(this)">
            <div class="approver-avatar"><%= (approver.firstName[0]||'')+(approver.lastName[0]||'') %></div>
            <div class="approver-info">
              <div class="approver-name"><%= approver.firstName %> <%= approver.lastName %></div>
              <div class="approver-role"><%= approver.role?approver.role.name:'Officer' %></div>
            </div>
            <i class="fas fa-check-circle approver-check"></i>
          </label>
          <% }) %>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-danger" id="reverseSubmitBtn" onclick="submitReversal()" disabled>
          <i class="fas fa-undo me-2"></i>Submit Reversal for Approval
        </button>
      </div>
    </div>
  </div>
</div>

