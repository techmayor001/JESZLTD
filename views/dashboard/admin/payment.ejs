<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
    let reverseTargetId = null;
let reverseApproverIds = [];
let reverseApproverNames = {};

function openReverseModal(txn) {
    reverseTargetId = txn.id;
    reverseApproverIds = []; reverseApproverNames = {};
    document.getElementById('reverseTxnRef').textContent = txn.reference;
    document.getElementById('reverseTxnAmount').textContent = Number(txn.amount).toLocaleString();
    document.getElementById('reversalNotes').value = '';
    document.querySelectorAll('#reverseApproverList .approver-item').forEach(el=>{
        el.classList.remove('selected');
        const cb=el.querySelector('input[type="checkbox"]'); if(cb) cb.checked=false;
    });
    updateReverseApproverUI();
    new bootstrap.Modal(document.getElementById('reverseModal')).show();
}

function handleReverseApproverToggle(checkbox) {
    const item=checkbox.closest('.approver-item'); const id=checkbox.value; const name=checkbox.dataset.name;
    if(checkbox.checked){
        if(reverseApproverIds.length>=3){checkbox.checked=false;showNotify({type:'warning',title:'Selection Limit',message:'You can only select up to 3 approvers.'});return;}
        reverseApproverIds.push(id); reverseApproverNames[id]=name; item.classList.add('selected');
    } else {
        reverseApproverIds=reverseApproverIds.filter(a=>a!==id); delete reverseApproverNames[id]; item.classList.remove('selected');
    }
    updateReverseApproverUI();
}

function updateReverseApproverUI() {
    const count=reverseApproverIds.length;
    const badge=document.getElementById('reverseApproverCount');
    badge.textContent=`${count} / 3 selected`;
    badge.className=`approval-count-badge ${count>=3?'sufficient':'insufficient'}`;
    document.getElementById('reverseSubmitBtn').disabled = count<3;
}

async function submitReversal() {
    const notes = document.getElementById('reversalNotes').value.trim();
    if(!notes){await showNotify({type:'warning',title:'Reason Required',message:'Please provide a reason for this reversal.'});return;}
    if(reverseApproverIds.length<3){await showNotify({type:'warning',title:'Approvers Required',message:'Select exactly 3 approvers.'});return;}
    const confirmed = await showNotify({type:'error',title:'Confirm Reversal',message:'This will submit a reversal for approval.\nIt only takes effect once 3 officers approve it.',confirmLabel:'Yes, Submit',cancelLabel:'Cancel'});
    if(!confirmed) return;
    const btn=document.getElementById('reverseSubmitBtn'); const orig=btn.innerHTML;
    btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Submitting…';
    const result = await permFetch(`/admin/reverse-transaction/${reverseTargetId}`, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ selectedApprovers: reverseApproverIds, notes })
    }, document.getElementById('reverseModal'));
    if(!result.ok){btn.disabled=false;btn.innerHTML=orig;return;}
    if(!result.data?.success){await showNotify({type:'error',title:'Failed',message:result.data?.message||'Could not submit reversal.'});btn.disabled=false;btn.innerHTML=orig;return;}
    bootstrap.Modal.getInstance(document.getElementById('reverseModal'))?.hide();
    await showNotify({type:'success',title:'Reversal Submitted',message:'Pending approval from the 3 selected officers.'});
    window.location.reload();
}
</script>
<script>
'use strict';

/* ════ PERMISSIONS ════ */
const PERMISSIONS = {
    processDeposits:       <%- JSON.stringify(!!admin.role?.permissions?.some(p => p.name === 'process_deposits'))      %>,
    authorizeTransactions: <%- JSON.stringify(!!admin.role?.permissions?.some(p => p.name === 'authorize_transactions')) %>,
};

/* ════ NOTIFICATION MODAL ════ */
let _notifyResolve = null;
function showNotify({ type='info', title='', message='', confirmLabel='OK', cancelLabel=null } = {}) {
    return new Promise(resolve => {
        _notifyResolve = resolve;
        const iconMap = { success:{icon:'fa-check-circle',label:title||'Success'}, error:{icon:'fa-times-circle',label:title||'Error'}, warning:{icon:'fa-exclamation-triangle',label:title||'Warning'}, info:{icon:'fa-info-circle',label:title||'Info'} };
        const cfg = iconMap[type] ?? iconMap.info;
        document.getElementById('notifyIconWrap').className = `notify-icon-wrap ${type}`;
        document.getElementById('notifyIconEl').className   = `fas ${cfg.icon}`;
        const titleEl = document.getElementById('notifyTitle');
        titleEl.className=`notify-title ${type}`; titleEl.textContent=cfg.label;
        document.getElementById('notifyMessage').textContent=message;
        const okBtn=document.getElementById('notifyOkBtn');
        okBtn.className=`notify-btn-ok ${type}`; okBtn.textContent=confirmLabel;
        document.getElementById('notifyCancelBtn')?.remove();
        if (cancelLabel) {
            const cb=document.createElement('button'); cb.className='notify-btn-cancel'; cb.id='notifyCancelBtn';
            cb.textContent=cancelLabel; cb.onclick=notifyCancel;
            document.getElementById('notifyFooter').insertBefore(cb,okBtn);
        }
        new bootstrap.Modal(document.getElementById('notifyModal'),{backdrop:'static',keyboard:false}).show();
    });
}
function notifyClose()  { bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide(); if(_notifyResolve){_notifyResolve(true);_notifyResolve=null;} }
function notifyCancel() { bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide(); if(_notifyResolve){_notifyResolve(false);_notifyResolve=null;} }

/* ════ UNAUTHORIZED MODAL ════ */
const UNAUTH_MESSAGES = {
    auth:                   'Your session has expired. Please log in again.',
    permission:             "You don't have permission to perform this action.",
    inactive:               'Your admin role is currently inactive. Contact a super-admin.',
    norole:                 'No role is assigned to your account. Contact a super-admin.',
    member:                 'Member accounts are not permitted to perform admin actions.',
    process_deposits:       "You don't have the permission to Authorize transaction\nand cannot assign approvers or submit transactions.",
    authorize_transactions: 'You need the authorize_transactions permission to assign approvers.',
};
function showUnauthorized(reason='permission', onClose=null) {
    document.getElementById('unauthorizedMessage').textContent = UNAUTH_MESSAGES[reason] ?? UNAUTH_MESSAGES.permission;
    const modalEl = document.getElementById('unauthorizedModal');
    if (onClose) modalEl.addEventListener('hidden.bs.modal', function h(){ modalEl.removeEventListener('hidden.bs.modal',h); onClose(); });
    new bootstrap.Modal(modalEl).show();
}

/* ════ PERMISSION-AWARE FETCH ════ */
async function permFetch(url, options={}, sourceModalEl=null) {
    const headers={'X-Requested-With':'XMLHttpRequest',...(options.headers||{})};
    let res;
    try { res=await fetch(url,{...options,headers}); }
    catch(networkErr) { await showNotify({type:'error',title:'Network Error',message:'Could not reach the server. Check your connection and try again.'}); return {ok:false}; }
    const hideSource=()=>{ if(sourceModalEl) bootstrap.Modal.getInstance(sourceModalEl)?.hide(); };
    if (res.status===401) {
        hideSource();
        const doRedirect=()=>showUnauthorized('auth',()=>setTimeout(()=>{window.location.href='/login';},800));
        if(sourceModalEl) sourceModalEl.addEventListener('hidden.bs.modal',function h(){sourceModalEl.removeEventListener('hidden.bs.modal',h);doRedirect();}); else doRedirect();
        return {ok:false};
    }
    if (res.status===403) {
        let errorData={}; try{errorData=await res.json();}catch(_){}
        hideSource();
        const doShow=()=>showUnauthorized(errorData.reason||'permission');
        if(sourceModalEl) sourceModalEl.addEventListener('hidden.bs.modal',function h(){sourceModalEl.removeEventListener('hidden.bs.modal',h);doShow();}); else doShow();
        return {ok:false};
    }
    let data; try{data=await res.json();}catch(_){data={};}
    return {ok:res.ok, status:res.status, data};
}

/* ════ APP STATE ════ */
let currentPaymentType    = '';
let selectedMember        = null;
let searchTimeout         = null;
let selectedApproverIds   = [];
let selectedApproverNames = {};
let currentTransaction    = null;

/* ════ INIT ════ */
document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US',{weekday:'short',year:'numeric',month:'short',day:'numeric'});
    loadPendingCount();
    applyPermissionUI();
});

function applyPermissionUI() {
    if (!PERMISSIONS.processDeposits) {
        document.querySelectorAll('.payment-type-card').forEach(card=>{
            card.classList.add('locked');
            if (!card.querySelector('.lock-overlay')) {
                const overlay=document.createElement('div'); overlay.className='lock-overlay';
                overlay.innerHTML='<i class="fas fa-lock"></i><span>NO PERMISSION</span>'; card.appendChild(overlay);
            }
        });
    }
    if (!PERMISSIONS.authorizeTransactions) {
        document.getElementById('approverList')?.classList.add('locked');
        const notice=document.getElementById('approverLockedNotice'); if(notice) notice.style.display='flex';
    }
}

function toggleSidebar() { document.getElementById('sidebar').classList.toggle('active'); document.getElementById('sidebarOverlay').classList.toggle('active'); }
function closeSidebar()  { document.getElementById('sidebar').classList.remove('active'); document.getElementById('sidebarOverlay').classList.remove('active'); }

async function loadPendingCount() {
    try {
        const res=await fetch('/admin/pending-approvals-count'); if(!res.ok) return;
        const data=await res.json();
        if (data.count>0) {
            ['navbarPendingBadge','sidebarBadge'].forEach(id=>{
                const el=document.getElementById(id);
                if(el){el.style.display='inline';el.textContent=data.count;}
