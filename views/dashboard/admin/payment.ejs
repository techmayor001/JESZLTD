/* ════ VIEW TRANSACTION DETAILS ════ */
function viewTransactionDetails(transaction) {
    currentTransaction=transaction;
    const fmt=n=>`₦${Number(n||0).toLocaleString()}`;
    document.getElementById('detailTxnId').textContent=transaction.id||'—';
    document.getElementById('detailDateTime').textContent=`${transaction.date} at ${transaction.time}`;
    document.getElementById('detailReference').textContent=transaction.reference||'—';
    const typeEl=document.getElementById('detailType'); typeEl.textContent=transaction.type; typeEl.className=`badge bg-${transaction.typeClass||'secondary'}`;
    const statusEl=document.getElementById('detailStatus'); statusEl.innerHTML=`<i class="fas fa-circle me-1" style="font-size:.6em;"></i>${transaction.status}`; statusEl.className=`badge bg-${transaction.statusClass||'secondary'}`;
    document.getElementById('detailKiddiesBadge').style.display=transaction.isKiddies?'':'none';
    document.getElementById('detailMemberName').textContent=transaction.memberName||'—';
    document.getElementById('detailMemberId').textContent=transaction.memberId||'—';
    document.getElementById('detailMemberEmail').textContent=transaction.memberEmail||'—';
    document.getElementById('detailMemberPhone').textContent=transaction.memberPhone||'—';
    document.getElementById('detailAmount').textContent=fmt(transaction.amount);
    document.getElementById('detailMethod').textContent=transaction.method||'—';
    document.getElementById('detailFee').textContent=fmt(transaction.fee);
    document.getElementById('detailBalanceBefore').textContent=fmt(transaction.balanceBefore);
    document.getElementById('detailBalanceAfter').textContent=fmt(transaction.balanceAfter);
    document.getElementById('detailProcessedBy').textContent=transaction.processedBy||'—';
    const approversEl=document.getElementById('detailApprovers');
    if(transaction.approvalDetail&&transaction.approvalDetail!=='N/A'){approversEl.innerHTML=transaction.approvalDetail.split(' | ').map(line=>`<span class="d-block" style="font-size:.85rem;">${escHtml(line)}</span>`).join('');}
    else{approversEl.textContent=transaction.approverNames||'—';}
    document.getElementById('detailNotes').textContent=transaction.notes||'No additional notes.';
    populatePrintReceipt(transaction);
    new bootstrap.Modal(document.getElementById('transactionDetailsModal')).show();
}

/* ════ RECEIPT ════ */
function populatePrintReceipt(t) {
    const fmt=n=>`₦${Number(n||0).toLocaleString()}.00`;
    document.getElementById('printTxnId').textContent=t.id||'—';
    document.getElementById('printDateTime').textContent=`${t.date} at ${t.time}`;
    document.getElementById('printType').textContent=t.type||'—';
    document.getElementById('printStatus').textContent=t.status||'—';
    document.getElementById('printReference').textContent=t.reference||'—';
    document.getElementById('printMemberName').textContent=t.memberName||'—';
    document.getElementById('printMemberId').textContent=t.memberId||'—';
    document.getElementById('printAccountType').textContent=t.isKiddies?'Kiddies Account':'Member Account';
    document.getElementById('printMemberEmail').textContent=t.memberEmail||'—';
    document.getElementById('printMemberPhone').textContent=t.memberPhone||'—';
    document.getElementById('printAmount').textContent=fmt(t.amount);
    document.getElementById('printMethod').textContent=t.method||'—';
    document.getElementById('printFee').textContent=fmt(t.fee);
    document.getElementById('printBalanceBefore').textContent=fmt(t.balanceBefore);
    document.getElementById('printBalanceAfter').textContent=fmt(t.balanceAfter);
    document.getElementById('printProcessedBy').textContent=t.processedBy||'—';
    document.getElementById('printApprovers').textContent=t.approverNames||'—';
    document.getElementById('printFinalizedAt').textContent=t.finalizedAt||'—';
    document.getElementById('printNotes').textContent=t.notes||'No additional notes.';
    document.getElementById('printGeneratedDate').textContent=new Date().toLocaleString('en-US',{year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'});
}

async function printReceipt() {
    if(!currentTransaction){await showNotify({type:'warning',title:'No Data',message:'No transaction is currently loaded. Please open a transaction first.'});return;}
    populatePrintReceipt(currentTransaction);
    const el=document.getElementById('printReceipt'); el.style.display='block';
    setTimeout(()=>{window.print();el.style.display='none';},150);
}

/* ════ UTILITY ════ */
function escHtml(str) {
    return String(str??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

document.addEventListener('click', function(e) {
    const wrapper=document.querySelector('.autocomplete-wrapper');
    const dropdown=document.getElementById('autocompleteDropdown');
    if(wrapper&&dropdown&&!wrapper.contains(e.target)) dropdown.classList.remove('show');
    const sidebar=document.getElementById('sidebar');
    if(window.innerWidth<=992&&sidebar.classList.contains('active')&&!sidebar.contains(e.target)&&!e.target.closest('.fa-bars')){sidebar.classList.remove('active');document.getElementById('sidebarOverlay').classList.remove('active');}
});

document.addEventListener('input',function(e){if(e.target.id==='paymentAmount'&&parseFloat(e.target.value)<0)e.target.value='';});
</script>
