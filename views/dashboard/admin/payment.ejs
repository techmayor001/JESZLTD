        <div class="receipt-container">
            <div class="receipt-header">
                <div class="receipt-logo">C</div>
                <div class="receipt-title">CLUB DE STARS</div>
                <div class="receipt-subtitle">Official Payment Receipt</div>
                <div class="receipt-subtitle mt-2">
                    123 Business Avenue, Port Harcourt, Rivers State, Nigeria<br>
                    +234 800 123 4567 | info@clubdestars.com
                </div>
            </div>

            <div class="receipt-section">
                <div class="receipt-section-title">TRANSACTION INFORMATION</div>
                <div class="receipt-row"><span class="receipt-label">Transaction ID:</span><span class="receipt-value" id="printTxnId">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Date &amp; Time:</span><span class="receipt-value" id="printDateTime">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Type:</span><span class="receipt-value" id="printType">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Status:</span><span class="receipt-value" id="printStatus">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Reference:</span><span class="receipt-value" id="printReference">—</span></div>
            </div>

            <div class="receipt-section">
                <div class="receipt-section-title">MEMBER INFORMATION</div>
                <div class="receipt-row"><span class="receipt-label">Name:</span><span class="receipt-value" id="printMemberName">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Member ID:</span><span class="receipt-value" id="printMemberId">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Email:</span><span class="receipt-value" id="printMemberEmail">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Phone:</span><span class="receipt-value" id="printMemberPhone">—</span></div>
            </div>

            <div class="receipt-amount">
                <div class="receipt-amount-label">TRANSACTION AMOUNT</div>
                <div class="receipt-amount-value" id="printAmount">₦0.00</div>
            </div>

            <div class="receipt-section">
                <div class="receipt-section-title">PAYMENT DETAILS</div>
                <div class="receipt-row"><span class="receipt-label">Method:</span><span class="receipt-value" id="printMethod">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Processing Fee:</span><span class="receipt-value" id="printFee">₦0.00</span></div>
                <div class="receipt-row"><span class="receipt-label">Balance Before:</span><span class="receipt-value" id="printBalanceBefore">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Balance After:</span><span class="receipt-value" id="printBalanceAfter">—</span></div>
            </div>

            <div class="receipt-section">
                <div class="receipt-section-title">ADDITIONAL INFORMATION</div>
                <div class="receipt-row"><span class="receipt-label">Processed By:</span><span class="receipt-value" id="printProcessedBy">—</span></div>
                <div class="receipt-row"><span class="receipt-label">Notes:</span><span class="receipt-value" id="printNotes">—</span></div>
            </div>

            <div class="receipt-footer">
                <div class="receipt-stamp">VERIFIED &amp; COMPLETED</div>
                <p style="font-size:0.8rem;color:var(--secondary);margin-top:1rem;">
                    This is a computer-generated receipt and does not require a signature.<br>
                    For inquiries contact: support@clubdestars.com
                </p>
                <p style="font-size:0.7rem;color:var(--secondary);margin-top:0.5rem;">
                    Generated on: <span id="printGeneratedDate">—</span><br>
                    Powered by <strong>JESZ LIMITED</strong>
                </p>
            </div>
        </div>
    </div>

    <!-- ══════════════════ SCRIPTS ══════════════════ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        /* ──────────────────────────────────────────
           STATE
        ────────────────────────────────────────── */
        let currentPaymentType  = '';
        let selectedMember      = null;
        let searchTimeout       = null;
        let selectedApproverIds   = [];   // array of id strings
        let selectedApproverNames = {};   // { id: 'Full Name' }
        let currentTransaction  = null;   // last processed / viewed txn

        /* ──────────────────────────────────────────
           INIT
        ────────────────────────────────────────── */
        document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', {
            weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
        });

        loadPendingCount();

        /* ──────────────────────────────────────────
           PENDING APPROVALS BADGE
        ────────────────────────────────────────── */
        async function loadPendingCount() {
            try {
                const res  = await fetch('/admin/pending-approvals-count');
                const data = await res.json();
                if (data.count > 0) {
                    const nb = document.getElementById('navbarPendingBadge');
                    const sb = document.getElementById('sidebarPendingBadge');
                    nb.style.display = 'inline';
                    nb.textContent   = data.count;
                    sb.style.display = 'inline';
                    sb.textContent   = data.count;
                }
            } catch (e) { /* silent */ }
        }

        /* ──────────────────────────────────────────
           PAYMENT TYPE SELECTION
        ────────────────────────────────────────── */
        function selectPaymentType(type, el) {
            currentPaymentType = type;

            document.querySelectorAll('.payment-type-card').forEach(c => c.classList.remove('active'));
            el.classList.add('active');

            const titles = {
                'deposit':        'Member Deposit',
                'withdrawal':     'Process Withdrawal',
                'loan-repayment': 'Loan Repayment',
                'direct-debit':   'Direct Debit'
            };
            document.getElementById('formTitle').innerHTML =
                `<i class="fas fa-file-invoice-dollar me-2" style="color:var(--primary);"></i>${titles[type]}`;

            document.getElementById('loanSelection').style.display  = (type === 'loan-repayment') ? 'block' : 'none';
            document.getElementById('chargeTypeDiv').style.display  = (type === 'direct-debit')   ? 'block' : 'none';
            document.getElementById('loanBadge').style.display      = (type === 'loan-repayment') ? 'inline-flex' : 'none';

            document.getElementById('paymentForm').style.display = 'block';
            document.getElementById('paymentForm').scrollIntoView({ behavior: 'smooth', block: 'start' });

            clearMember();
        }

        /* ──────────────────────────────────────────
           MEMBER SEARCH AUTOCOMPLETE
        ────────────────────────────────────────── */
        function handleMemberSearch() {
            const q        = document.getElementById('memberSearch').value.trim();
            const dropdown = document.getElementById('autocompleteDropdown');

            if (searchTimeout) clearTimeout(searchTimeout);

            if (!q) {
                dropdown.classList.remove('show');
                dropdown.innerHTML = '';
                return;
            }

            searchTimeout = setTimeout(async () => {
                try {
                    const res     = await fetch(`/admin/search-member?q=${encodeURIComponent(q)}`);
                    const members = await res.json();

                    if (!members.length) {
                        dropdown.innerHTML = `
                            <div class="autocomplete-item text-center text-muted py-3">
                                <i class="fas fa-search d-block mb-2"></i>No members found
                            </div>`;
                        dropdown.classList.add('show');
                        return;
                    }

                    dropdown.innerHTML = members.map(m => `
                        <div class="autocomplete-item" onclick='selectMember(${JSON.stringify(m).replace(/'/g, "&#39;")})'>
                            <div class="autocomplete-item-name">${escHtml(m.name)}</div>
                            <div class="autocomplete-item-details">${escHtml(m.membershipID)} | ${escHtml(m.email)}</div>
                            <span class="autocomplete-item-balance">Balance: ₦${Number(m.balance).toLocaleString()}</span>
                        </div>`).join('');

                    dropdown.classList.add('show');
                } catch (e) { console.error('Member search error:', e); }
            }, 300);
        }

        function selectMember(member) {
            selectedMember = member;

            document.getElementById('memberSearch').value    = member.name;
            document.getElementById('autocompleteDropdown').classList.remove('show');

            document.getElementById('memberName').textContent    = member.name;
            document.getElementById('memberID').textContent      = member.membershipID;
            document.getElementById('memberEmail').textContent   = member.email;
            document.getElementById('memberBalance').textContent = Number(member.balance).toLocaleString();

            document.getElementById('summaryCurrentBalance').textContent = Number(member.balance).toLocaleString();
            document.getElementById('memberDetails').style.display = 'block';

            /* Populate loan dropdown */
            const loanSelect = document.getElementById('loanSelect');
            loanSelect.innerHTML = '<option value="">Select Loan</option>';
            if (member.loans && member.loans.length > 0) {
                member.loans.forEach(loan => {
                    loanSelect.insertAdjacentHTML('beforeend', `
                        <option value="${loan.id}"
                                data-total="${loan.totalRepay}"
                                data-balance="${loan.balanceRemaining}">
                            ₦${Number(loan.originalAmount).toLocaleString()} — ${loan.duration}
                        </option>`);
                });
            } else {
                loanSelect.innerHTML += '<option disabled>No active loans</option>';
            }

            calculateTotal();
        }

        function clearMember() {
            selectedMember = null;

            document.getElementById('memberSearch').value = '';
            document.getElementById('memberDetails').style.display = 'none';
            document.getElementById('paymentAmount').value = '';
            document.getElementById('loanSelect').value   = '';
            document.getElementById('chargeSelect').value = '';

            document.getElementById('summaryDetails').style.display    = 'none';
            document.getElementById('summaryPlaceholder').style.display = 'block';
            document.getElementById('autocompleteDropdown').classList.remove('show');

            updateSubmitButton();
        }

        /* ──────────────────────────────────────────
           AMOUNT & TOTAL CALCULATION
        ────────────────────────────────────────── */
        function calculateTotal() {
            const amount = parseFloat(document.getElementById('paymentAmount').value) || 0;
            if (!selectedMember || amount <= 0) return;

            let newBalance = Number(selectedMember.balance);

            switch (currentPaymentType) {
                case 'deposit':
                    newBalance += amount;
                    break;
                case 'withdrawal':
                case 'direct-debit':
                    if (amount > selectedMember.balance) {
                        showAlert('danger', 'Insufficient balance for this transaction.');
                        document.getElementById('paymentAmount').value = '';
                        return;
                    }
                    newBalance -= amount;
                    break;
                case 'loan-repayment':
                    /* balance unchanged at submission; loan ledger updated after approval */
                    break;
            }

            document.getElementById('summaryAmount').textContent     = amount.toLocaleString();
            document.getElementById('summaryCharge').textContent     = '0';
            document.getElementById('summaryTotal').textContent      = amount.toLocaleString();
            document.getElementById('summaryNewBalance').textContent = newBalance.toLocaleString();

            document.getElementById('summaryPlaceholder').style.display = 'none';
            document.getElementById('summaryDetails').style.display     = 'block';
            document.getElementById('chargeRow').style.display          = 'none';

            updateSubmitButton();
        }

        function updateLoanDetails() {
            const sel = document.getElementById('loanSelect');
            const opt = sel.options[sel.selectedIndex];
            if (!opt || !opt.value) { document.getElementById('paymentAmount').value = ''; return; }
            document.getElementById('paymentAmount').value = Number(opt.dataset.balance || 0);
            calculateTotal();
        }

        /* ──────────────────────────────────────────
           APPROVER SELECTION
        ────────────────────────────────────────── */
        function handleApproverToggle(checkbox) {
            const item = checkbox.closest('.approver-item');
            const id   = checkbox.value;
            const name = checkbox.dataset.name;

            if (checkbox.checked) {
                if (selectedApproverIds.length >= 3) {
                    checkbox.checked = false;
                    showAlert('warning', 'You can only select up to 3 approvers.');
                    return;
                }
                selectedApproverIds.push(id);
                selectedApproverNames[id] = name;
                item.classList.add('selected');
            } else {
                selectedApproverIds = selectedApproverIds.filter(a => a !== id);
                delete selectedApproverNames[id];
                item.classList.remove('selected');
            }

            updateApproverUI();
        }

        function updateApproverUI() {
            const count  = selectedApproverIds.length;
            const badge  = document.getElementById('approverCountBadge');
            const text   = document.getElementById('approverCountText');
            const icon   = document.getElementById('approverCountIcon');

            text.textContent = `${count} / 3 selected`;

            if (count >= 3) {
                badge.classList.replace('insufficient', 'sufficient');
                icon.className = 'fas fa-check-circle';
            } else {
                badge.classList.replace('sufficient', 'insufficient');
                icon.className = 'fas fa-exclamation-circle';
            }

            /* Update sidebar approver list */
            const listEl = document.getElementById('sidebarApproverList');
            if (count === 0) {
                listEl.innerHTML = '<small class="text-muted fst-italic">None selected yet</small>';
            } else {
                listEl.innerHTML = Object.entries(selectedApproverNames).map(([, name]) => `
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="fas fa-check-circle text-success" style="font-size:0.75rem;flex-shrink:0;"></i>
                        <small class="fw-semibold">${escHtml(name)}</small>
                    </div>`).join('');
            }

            updateSubmitButton();
        }

        function updateSubmitButton() {
            const amount = parseFloat(document.getElementById('paymentAmount')?.value) || 0;
            const ready  = selectedMember && amount > 0 && selectedApproverIds.length >= 3;
            const btn    = document.getElementById('submitBtn');
            if (btn) btn.disabled = !ready;
        }

        /* ──────────────────────────────────────────
           SUBMIT FOR APPROVAL
        ────────────────────────────────────────── */
        async function submitForApproval() {
            const amount    = parseFloat(document.getElementById('paymentAmount').value);
            const method    = document.getElementById('paymentMethod').value;
            const notes     = document.getElementById('paymentNotes').value;
            const reference = document.getElementById('referenceNumber').value;
            const loanId    = document.getElementById('loanSelect')?.value    || null;
            const chargeType= document.getElementById('chargeSelect')?.value  || null;

            /* Validation */
            if (!selectedMember || !amount || amount <= 0) {
                showAlert('danger', 'Please fill in all required fields.'); return;
            }
            if (selectedApproverIds.length < 3) {
                showAlert('danger', 'Please select exactly 3 approvers.'); return;
            }
            if (currentPaymentType === 'loan-repayment' && !loanId) {
                showAlert('danger', 'Please select a loan.'); return;
            }
            if (currentPaymentType === 'direct-debit' && !chargeType) {
                showAlert('danger', 'Please select a charge type.'); return;
            }

            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';

            try {
                const res  = await fetch('/admin/submit-payment-for-approval', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        memberId:          selectedMember.id,
                        paymentType:       currentPaymentType,
                        amount,
                        chargeAmount:      0,
                        paymentMethod:     method,
                        reference,
                        notes,
                        loanId,
                        chargeType,
                        selectedApprovers: selectedApproverIds,
                    })
                });
                const data = await res.json();

                if (!data.success) {
                    showAlert('danger', data.message || 'Submission failed.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Submit for Approval';
                    return;
                }

                document.getElementById('approvalIdDisplay').textContent = data.approvalId;
                new bootstrap.Modal(document.getElementById('successModal')).show();

            } catch (err) {
                console.error('Submit error:', err);
                showAlert('danger', 'Something went wrong while submitting.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Submit for Approval';
            }
        }

        /* ──────────────────────────────────────────
           RESET FORM
        ────────────────────────────────────────── */
        function resetForm() {
            clearMember();
            document.getElementById('paymentNotes').value    = '';
            document.getElementById('referenceNumber').value = '';
            document.getElementById('paymentAmount').value   = '';

            selectedApproverIds   = [];
            selectedApproverNames = {};

            document.querySelectorAll('.approver-item').forEach(el => {
                el.classList.remove('selected');
                el.querySelector('input[type="checkbox"]').checked = false;
            });

            updateApproverUI();

            const btn = document.getElementById('submitBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Submit for Approval';
            }

            /* Deactivate payment type cards */
            document.querySelectorAll('.payment-type-card').forEach(c => c.classList.remove('active'));
            document.getElementById('paymentForm').style.display = 'none';
            currentPaymentType = '';
        }

        /* ──────────────────────────────────────────
           VIEW TRANSACTION DETAILS MODAL
        ────────────────────────────────────────── */
        function viewTransactionDetails(transaction) {
            currentTransaction = transaction;

            document.getElementById('detailTxnId').textContent     = transaction.id       || '—';
            document.getElementById('detailDateTime').textContent   = `${transaction.date} at ${transaction.time}`;
            document.getElementById('detailReference').textContent  = transaction.reference || '—';
            document.getElementById('detailMemberName').textContent = transaction.memberName;
            document.getElementById('detailMemberId').textContent   = transaction.memberId;
            document.getElementById('detailMemberEmail').textContent= transaction.memberEmail;
            document.getElementById('detailMemberPhone').textContent= transaction.memberPhone;
            document.getElementById('detailProcessedBy').textContent= transaction.processedBy;
            document.getElementById('detailNotes').textContent      = transaction.notes || 'No additional notes';

            document.getElementById('detailAmount').textContent       = `₦${Number(transaction.amount).toLocaleString()}`;
            document.getElementById('detailFee').textContent          = `₦${Number(transaction.fee).toLocaleString()}`;
            document.getElementById('detailBalanceBefore').textContent = `₦${Number(transaction.balanceBefore).toLocaleString()}`;
            document.getElementById('detailBalanceAfter').textContent  = `₦${Number(transaction.balanceAfter).toLocaleString()}`;
            document.getElementById('detailMethod').textContent       = transaction.method;

            const typeEl   = document.getElementById('detailType');
            typeEl.textContent = transaction.type;
            typeEl.className   = `badge bg-${transaction.typeClass}`;

            const statusEl = document.getElementById('detailStatus');
            statusEl.innerHTML  = `<i class="fas fa-check-circle me-1"></i>${transaction.status}`;
            statusEl.className  = `badge bg-${transaction.statusClass}`;

            /* Populate receipt for printing */
            populatePrintReceipt(transaction);

            new bootstrap.Modal(document.getElementById('transactionDetailsModal')).show();
        }

        /* ──────────────────────────────────────────
           RECEIPT HELPERS
        ────────────────────────────────────────── */
        function populatePrintReceipt(t) {
            document.getElementById('printTxnId').textContent      = t.id       || '—';
            document.getElementById('printDateTime').textContent   = `${t.date} at ${t.time}`;
            document.getElementById('printType').textContent       = t.type;
            document.getElementById('printStatus').textContent     = t.status;
            document.getElementById('printReference').textContent  = t.reference || '—';
            document.getElementById('printMemberName').textContent = t.memberName;
            document.getElementById('printMemberId').textContent   = t.memberId;
            document.getElementById('printMemberEmail').textContent= t.memberEmail;
            document.getElementById('printMemberPhone').textContent= t.memberPhone;
            document.getElementById('printAmount').textContent     = `₦${Number(t.amount).toLocaleString()}.00`;
            document.getElementById('printMethod').textContent     = t.method;
            document.getElementById('printFee').textContent        = `₦${Number(t.fee).toLocaleString()}.00`;
            document.getElementById('printBalanceBefore').textContent = `₦${Number(t.balanceBefore).toLocaleString()}.00`;
            document.getElementById('printBalanceAfter').textContent  = `₦${Number(t.balanceAfter).toLocaleString()}.00`;
            document.getElementById('printProcessedBy').textContent   = t.processedBy;
            document.getElementById('printNotes').textContent         = t.notes || 'No additional notes';
            document.getElementById('printGeneratedDate').textContent = new Date().toLocaleString('en-US', {
                year:'numeric', month:'long', day:'numeric', hour:'2-digit', minute:'2-digit', second:'2-digit'
            });
        }

        function printReceipt() {
            if (!currentTransaction) { showAlert('warning', 'No transaction data available.'); return; }
            populatePrintReceipt(currentTransaction);
            const el = document.getElementById('printReceipt');
            el.style.display = 'block';
            setTimeout(() => { window.print(); el.style.display = 'none'; }, 150);
        }

        /* ──────────────────────────────────────────
           UTILITY
        ────────────────────────────────────────── */
        function escHtml(str) {
            return String(str)
                .replace(/&/g,  '&amp;')
                .replace(/</g,  '&lt;')
                .replace(/>/g,  '&gt;')
                .replace(/"/g,  '&quot;')
                .replace(/'/g,  '&#39;');
        }

        function showAlert(type, message) {
            /* Remove any existing alert */
            const existing = document.getElementById('inlineAlert');
            if (existing) existing.remove();

            const div = document.createElement('div');
            div.id = 'inlineAlert';
            div.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            div.style.cssText = 'top:80px;right:1.5rem;z-index:9999;min-width:300px;max-width:450px;box-shadow:0 8px 25px rgba(0,0,0,0.15);';
            div.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
            document.body.appendChild(div);
            setTimeout(() => div.remove(), 4000);
        }

        /* ──────────────────────────────────────────
           GLOBAL CLICK HANDLER
           - Close autocomplete when clicking outside
           - Close sidebar on mobile when clicking outside
        ────────────────────────────────────────── */
        document.addEventListener('click', function(e) {
            /* Autocomplete */
            const wrapper  = document.querySelector('.autocomplete-wrapper');
            const dropdown = document.getElementById('autocompleteDropdown');
            if (wrapper && !wrapper.contains(e.target)) {
                dropdown.classList.remove('show');
            }

            /* Mobile sidebar */
            const sidebar   = document.getElementById('sidebar');
            const hamburger = e.target.closest('.fa-bars');
            if (window.innerWidth <= 992 &&
                sidebar.classList.contains('active') &&
                !sidebar.contains(e.target) &&
                !hamburger) {
                sidebar.classList.remove('active');
            }
        });
    </script>
</body>
</html>
