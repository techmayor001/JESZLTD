<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Management - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary:       #1e3a8a;
            --primary-dark:  #1e40af;
            --primary-light: #3b82f6;
            --secondary:     #64748b;
            --success:       #10b981;
            --danger:        #ef4444;
            --warning:       #f59e0b;
            --info:          #06b6d4;
            --sidebar-width: 280px;
            --navbar-h:      70px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }

        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18);
            position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box {
            width: 42px; height: 42px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0;
        }
        .sidebar-brand { font-size: .95rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .65rem; font-weight: 500; opacity: .55; display: block; letter-spacing: .08em; }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 10px; background: rgba(239,68,68,.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.3);
            font-weight: 700; font-size: .7rem; color: #fca5a5;
        }

        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }
        .nav-category {
            display: flex; align-items: center; gap: 7px;
            padding: .55rem 1.25rem .3rem;
            font-size: .62rem; font-weight: 800;
            color: rgba(255,255,255,.38);
            text-transform: uppercase; letter-spacing: .1em;
            user-select: none;
        }
        .nav-category::after {
            content: ''; flex: 1; height: 1px;
            background: rgba(255,255,255,.08); margin-left: 4px;
        }

        .sidebar-nav a {
            display: flex; align-items: center; gap: 11px;
            padding: .62rem 1.25rem; color: rgba(255,255,255,.72);
            text-decoration: none; font-weight: 500; font-size: .84rem;
            border-left: 3px solid transparent; transition: all .18s;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }
        .nav-badge {
            margin-left: auto; font-size: .63rem; font-weight: 800;
            padding: 2px 7px; border-radius: 10px;
            background: rgba(239,68,68,.9); color: white; flex-shrink: 0; line-height: 1.4;
        }
        .nav-back {
            display: flex; align-items: center; gap: 10px;
            padding: .7rem 1.25rem .9rem; font-size: .8rem; font-weight: 600;
            color: rgba(255,255,255,.42); text-decoration: none;
            transition: color .18s; border-top: 1px solid rgba(255,255,255,.07); margin-top: .25rem;
        }
        .nav-back:hover { color: rgba(255,255,255,.7); }

        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }

        /* ══════════ NAVBAR ══════════ */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: var(--navbar-h);
            background: rgba(255,255,255,.97); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            border-bottom: 1px solid rgba(30,58,138,.1);
        }

        /* ══════════ MAIN ══════════ */
        .main-content {
            margin-left: var(--sidebar-width); margin-top: var(--navbar-h);
            padding: 1.5rem; min-height: calc(100vh - var(--navbar-h));
        }

        /* ══════════ PAGE HEADER ══════════ */
        .page-header {
            background: linear-gradient(130deg, #1e3a8a 0%, #1e40af 45%, #3b82f6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 10px 36px rgba(30,58,138,.28); position: relative; overflow: hidden;
        }
        .page-header::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,.05); border-radius: 50%; pointer-events: none;
        }

        /* ══════════ CARDS ══════════ */
        .card {
            border: 1px solid rgba(30,58,138,.05); border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30,58,138,.08); background: white;
        }
        .card-header {
            background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%);
            border-bottom: 2px solid rgba(30,58,138,.1);
            padding: 1.25rem; border-radius: 16px 16px 0 0 !important;
        }

        /* ══════════ PAYMENT TYPE CARDS ══════════ */
        .payment-type-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,.08); transition: all .3s;
            cursor: pointer; border: 2px solid transparent; height: 100%; position: relative;
        }
        .payment-type-card:hover {
            transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,.15);
            border-color: var(--primary);
        }
        .payment-type-card.active {
            border-color: var(--primary);
            background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%);
        }
        .payment-type-card.locked { cursor: not-allowed; opacity: .6; }
        .payment-type-card.locked:hover {
            transform: none; box-shadow: 0 8px 20px rgba(30,58,138,.08); border-color: transparent;
        }
        .lock-overlay {
            position: absolute; inset: 0; display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 6px; border-radius: 14px;
            background: rgba(255,255,255,.6); backdrop-filter: blur(2px);
        }
        .lock-overlay i   { font-size: 1.8rem; color: var(--danger); }
        .lock-overlay span { font-size: .7rem; font-weight: 700; color: var(--danger); letter-spacing: .03em; }

        .payment-icon {
            width: 60px; height: 60px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.8rem; margin-bottom: 1rem;
        }

        /* ══════════ FORM CONTROLS ══════════ */
        .form-label { font-weight: 600; color: var(--primary); margin-bottom: .5rem; }
        .form-control, .form-select {
            border: 2px solid rgba(30,58,138,.1); border-radius: 10px;
            padding: .75rem; transition: all .3s;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary); box-shadow: 0 0 0 .2rem rgba(30,58,138,.1);
        }
        .form-control.is-invalid { border-color: var(--danger) !important; }
        .form-control.is-valid   { border-color: var(--success) !important; }

        /* ══════════ BUTTONS ══════════ */
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none; padding: .75rem 1.5rem; border-radius: 10px;
            font-weight: 600; transition: all .3s;
        }
        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px); box-shadow: 0 8px 25px rgba(30,58,138,.3);
        }

        /* ══════════ AUTOCOMPLETE ══════════ */
        .autocomplete-wrapper { position: relative; }
        .autocomplete-dropdown {
            position: absolute; top: 100%; left: 0; right: 0;
            background: white; border: 2px solid var(--primary); border-top: none;
            border-radius: 0 0 10px 10px; max-height: 340px; overflow-y: auto;
            z-index: 1050; box-shadow: 0 8px 20px rgba(30,58,138,.15); display: none;
        }
        .autocomplete-dropdown.show { display: block; }
        .autocomplete-item {
            padding: 1rem; cursor: pointer;
            border-bottom: 1px solid rgba(30,58,138,.1); transition: all .2s;
        }
        .autocomplete-item:last-child { border-bottom: none; }
        .autocomplete-item:hover {
            background: linear-gradient(135deg, rgba(30,58,138,.05) 0%, rgba(59,130,246,.05) 100%);
        }
        .autocomplete-item.kiddies-item:hover {
            background: linear-gradient(135deg, rgba(236,72,153,.05) 0%, rgba(219,39,119,.05) 100%);
        }
        .autocomplete-item-name    { font-weight: 600; color: var(--primary); margin-bottom: .25rem; }
        .autocomplete-item.kiddies-item .autocomplete-item-name { color: #db2777; }
        .autocomplete-item-details { font-size: .85rem; color: var(--secondary); }
        .autocomplete-item-balance {
            display: inline-block; margin-top: .25rem; padding: .2rem .5rem;
            background: rgba(16,185,129,.1); color: var(--success);
            border-radius: 6px; font-size: .8rem; font-weight: 600;
        }
        .kiddies-tag {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 2px 8px; border-radius: 20px; font-size: .72rem; font-weight: 700;
            background: rgba(236,72,153,.12); color: #db2777;
            border: 1px solid rgba(236,72,153,.25); margin-bottom: 2px;
        }

        /* ══════════ MEMBER RESULT CARD ══════════ */
        .member-search-result {
            padding: 1rem; border: 2px solid rgba(30,58,138,.1);
            border-radius: 10px; margin-bottom: 1rem; background: rgba(30,58,138,.02);
        }
        .member-search-result.kiddies-result {
            border-color: rgba(236,72,153,.25); background: rgba(236,72,153,.03);
        }
        .kiddies-info-panel {
            display: flex; align-items: center; gap: 8px;
            padding: 6px 10px; margin-top: 8px;
            background: rgba(236,72,153,.07); border: 1px solid rgba(236,72,153,.2);
            border-radius: 8px; font-size: .82rem;
        }
        .kiddies-info-panel i { color: #db2777; flex-shrink: 0; }
        .ref-required-notice {
            display: flex; align-items: flex-start; gap: 8px;
            padding: 8px 12px; margin-top: 8px;
            background: rgba(245,158,11,.08); border: 1px solid rgba(245,158,11,.3);
            border-radius: 8px; font-size: .82rem; color: #92400e;
        }
        .ref-required-notice i { flex-shrink: 0; margin-top: 1px; }

        /* ══════════ TABLE ══════════ */
        .table-responsive { border-radius: 0 0 16px 16px; overflow: hidden; }
        .table { margin: 0; }
        .table thead {
            background: linear-gradient(135deg, rgba(30,58,138,.05) 0%, rgba(59,130,246,.05) 100%);
        }
        .table thead th {
            border: none; padding: 1rem; font-weight: 600;
            color: var(--primary); white-space: nowrap;
        }
        .table tbody td {
            padding: 1rem; vertical-align: middle;
            border-bottom: 1px solid rgba(30,58,138,.05);
        }
        .table tbody tr:last-child td { border-bottom: none; }
        .table tbody tr:hover { background: rgba(30,58,138,.02); }
        .table tbody tr.kiddies-row { background: rgba(236,72,153,.02); }
        .table tbody tr.kiddies-row:hover { background: rgba(236,72,153,.04); }

        /* ══════════ PAYMENT SUMMARY ══════════ */
        .payment-summary {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border: 2px solid #10b981; border-radius: 12px; padding: 1.5rem; margin-top: 1rem;
        }
        .summary-row {
            display: flex; justify-content: space-between;
            padding: .5rem 0; border-bottom: 1px solid rgba(16,185,129,.2);
        }
        .summary-row:last-child {
            border-bottom: none; font-weight: bold; font-size: 1.1rem; padding-top: 1rem;
        }

        /* ══════════ APPROVER SELECTOR ══════════ */
        .approver-selector {
            border: 2px solid rgba(30,58,138,.1); border-radius: 12px;
            padding: 1rem; background: #fafbff; max-height: 300px; overflow-y: auto;
            transition: opacity .2s;
        }
        .approver-selector.locked { pointer-events: none; opacity: .45; }
        .approver-item {
            display: flex; align-items: center; gap: 10px; padding: .75rem;
            border-radius: 10px; border: 2px solid transparent; cursor: pointer;
            transition: all .2s; background: white; margin-bottom: .5rem;
            box-shadow: 0 2px 6px rgba(30,58,138,.06);
        }
        .approver-item:last-child { margin-bottom: 0; }
        .approver-item:hover { border-color: rgba(30,58,138,.3); background: rgba(30,58,138,.02); }
        .approver-item.selected {
            border-color: var(--primary);
            background: linear-gradient(135deg, rgba(30,58,138,.05) 0%, rgba(59,130,246,.05) 100%);
        }
        .approver-item input[type="checkbox"] {
            width: 18px; height: 18px; accent-color: var(--primary); flex-shrink: 0; cursor: pointer;
        }
        .approver-avatar {
            width: 38px; height: 38px; border-radius: 50%;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white; display: flex; align-items: center; justify-content: center;
            font-weight: bold; font-size: .9rem; flex-shrink: 0;
        }
        .approver-info { flex: 1; min-width: 0; }
        .approver-name { font-weight: 600; font-size: .9rem; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .approver-role { font-size: .75rem; color: var(--secondary); }
        .approver-check { color: var(--primary); display: none; flex-shrink: 0; }
        .approver-item.selected .approver-check { display: block; }

        .approval-count-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 12px; border-radius: 20px; font-weight: 600; font-size: .8rem;
        }
        .approval-count-badge.insufficient {
            background: rgba(239,68,68,.1); color: var(--danger); border: 1px solid rgba(239,68,68,.3);
        }
        .approval-count-badge.sufficient {
            background: rgba(16,185,129,.1); color: var(--success); border: 1px solid rgba(16,185,129,.3);
        }
        .approver-locked-notice {
            display: flex; align-items: flex-start; gap: 10px;
            padding: .875rem 1rem;
            background: rgba(239,68,68,.06); border: 2px solid rgba(239,68,68,.2);
            border-radius: 12px; margin-bottom: .75rem; font-size: .875rem;
        }
        .approver-locked-notice i { color: var(--danger); flex-shrink: 0; margin-top: 2px; }
        .approval-notice {
            background: linear-gradient(135deg, rgba(245,158,11,.08) 0%, rgba(217,119,6,.08) 100%);
            border: 2px solid rgba(245,158,11,.3); border-radius: 12px;
            padding: 1rem 1.25rem; margin-bottom: 1.5rem;
        }

        /* ══════════ NOTIFICATION MODAL ══════════ */
        #notifyModal .modal-content {
            border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,.18);
        }
        #notifyModal .modal-body { padding: 2rem; text-align: center; }
        .notify-icon-wrap {
            width: 80px; height: 80px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.25rem; font-size: 2.2rem;
            animation: notifyPop .4s cubic-bezier(.34,1.56,.64,1) both;
        }
        @keyframes notifyPop { from{transform:scale(.4);opacity:0;} to{transform:scale(1);opacity:1;} }
        .notify-icon-wrap.success { background: linear-gradient(135deg,#d1fae5,#6ee7b7); color: #059669; }
        .notify-icon-wrap.error   { background: linear-gradient(135deg,#fee2e2,#fca5a5); color: #dc2626; }
        .notify-icon-wrap.warning { background: linear-gradient(135deg,#fef3c7,#fcd34d); color: #d97706; }
        .notify-icon-wrap.info    { background: linear-gradient(135deg,#dbeafe,#93c5fd); color: #2563eb; }
        .notify-title { font-size: 1.25rem; font-weight: 700; margin-bottom: .5rem; }
        .notify-title.success{color:#065f46;} .notify-title.error{color:#7f1d1d;}
        .notify-title.warning{color:#78350f;} .notify-title.info{color:#1e3a8a;}
        .notify-message { color: #475569; font-size: .95rem; line-height: 1.6; margin-bottom: 1.5rem; white-space: pre-line; }
        .notify-footer { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }
        .notify-btn-ok {
            padding: .6rem 2rem; border-radius: 10px; border: none;
            font-weight: 600; font-size: .95rem; cursor: pointer; transition: all .25s; color: white;
        }
        .notify-btn-ok.success{background:linear-gradient(135deg,#10b981,#059669);}
        .notify-btn-ok.error  {background:linear-gradient(135deg,#ef4444,#dc2626);}
        .notify-btn-ok.warning{background:linear-gradient(135deg,#f59e0b,#d97706);}
        .notify-btn-ok.info   {background:linear-gradient(135deg,#1e3a8a,#3b82f6);}
        .notify-btn-ok:hover  {transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.18);}
        .notify-btn-cancel {
            padding: .6rem 1.5rem; border-radius: 10px;
            border: 2px solid #e2e8f0; background: white; color: #64748b;
            font-weight: 600; font-size: .95rem; cursor: pointer; transition: all .25s;
        }
        .notify-btn-cancel:hover { background: #f1f5f9; border-color: #cbd5e1; }

        /* ══════════ MODALS ══════════ */
        #unauthorizedModal .modal-content { border: none; border-radius: 16px; overflow: hidden; }
        #unauthorizedModal .modal-header { background: linear-gradient(135deg, #7f1d1d 0%, #ef4444 100%); }

        /* ══════════ RECEIPT ══════════ */
        .receipt-container { max-width: 800px; margin: 0 auto; background: white; padding: 2rem; border: 2px solid #e5e7eb; }
        .receipt-header { text-align: center; border-bottom: 3px solid var(--primary); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
        .receipt-logo { width: 80px; height: 80px; background: linear-gradient(135deg,#1e3a8a,#3b82f6); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; margin: 0 auto 1rem; }
        .receipt-title    { font-size: 1.8rem; font-weight: bold; color: var(--primary); margin-bottom: .5rem; }
        .receipt-subtitle { color: var(--secondary); font-size: .9rem; }
        .receipt-section  { margin-bottom: 1.5rem; }
        .receipt-section-title { font-weight: bold; color: var(--primary); border-bottom: 2px solid #e5e7eb; padding-bottom: .5rem; margin-bottom: 1rem; }
        .receipt-row { display: flex; justify-content: space-between; padding: .5rem 0; border-bottom: 1px dashed #e5e7eb; }
        .receipt-row:last-child { border-bottom: none; }
        .receipt-label { color: var(--secondary); font-weight: 500; }
        .receipt-value { font-weight: 600; color: #1f2937; }
        .receipt-amount { background: linear-gradient(135deg,#f0fdf4,#dcfce7); border: 2px solid var(--success); border-radius: 10px; padding: 1rem; text-align: center; margin: 1.5rem 0; }
        .receipt-amount-label { color: var(--secondary); font-size: .9rem; margin-bottom: .5rem; }
        .receipt-amount-value { font-size: 2.5rem; font-weight: bold; color: var(--success); }
        .receipt-footer { text-align: center; border-top: 3px solid var(--primary); padding-top: 1.5rem; margin-top: 2rem; }
        .receipt-stamp { display: inline-block; border: 3px solid var(--success); color: var(--success); padding: .5rem 1.5rem; border-radius: 10px; font-weight: bold; transform: rotate(-5deg); margin: 1rem 0; }

        /* ══════════ POWERED BY ══════════ */
        .powered-by {
            position: fixed; bottom: 15px; right: 15px; background: white;
            padding: 10px 16px; border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30,58,138,.15);
            font-size: .8rem; font-weight: 600; color: var(--primary); z-index: 1000;
        }

        /* ══════════ ANIMATIONS ══════════ */
        @keyframes fadeIn { from{opacity:0;transform:translateY(10px);} to{opacity:1;transform:translateY(0);} }
        .fade-in { animation: fadeIn .4s ease; }

        /* ══════════ RESPONSIVE ══════════ */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
            .table thead { display: none; }
            .table tbody tr { display: block; margin-bottom: 1rem; border: 2px solid rgba(30,58,138,.1); border-radius: 12px; overflow: hidden; background: white; }
            .table tbody td { display: flex; justify-content: space-between; align-items: center; padding: .75rem 1rem; border-bottom: 1px solid rgba(30,58,138,.05); }
            .table tbody td::before { content: attr(data-label); font-weight: 600; color: var(--primary); margin-right: 1rem; flex-shrink: 0; }
        }
        @media (max-width: 576px) {
            :root { --navbar-h: 60px; }
            .main-content { padding: .75rem; }
            .page-header { padding: 1.25rem; border-radius: 16px; }
            .powered-by { bottom: 10px; right: 10px; font-size: .7rem; padding: 8px 12px; }
        }
        @media print {
            body * { visibility: hidden; }
            #printReceipt, #printReceipt * { visibility: visible; }
            #printReceipt { position: absolute; left: 0; top: 0; width: 100%; }
            .sidebar, .top-navbar, .powered-by { display: none !important; }
        }
    </style>
</head>
<body>

