    selectPaymentType(type, el);
}

function selectPaymentType(type, el) {
    currentPaymentType=type;
    document.querySelectorAll('.payment-type-card').forEach(c=>c.classList.remove('active'));
    el.classList.add('active');
    const titles={
        'deposit':        '<i class="fas fa-plus-circle me-2" style="color:var(--success);"></i>Member / Kiddies Deposit',
        'withdrawal':     '<i class="fas fa-minus-circle me-2" style="color:var(--danger);"></i>Process Withdrawal',
