<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Withdrawal Management - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white;
            z-index: 1040;
            transition: all 0.3s;
            overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30, 58, 138, 0.15);
            transform: translateX(0);
        }
        
        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.1);
        }
        
        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        
        .logo-box {
            width: 45px;
            height: 45px;
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--primary);
            font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            flex-shrink: 0;
        }
        
        .sidebar-title {
            font-size: 1.1rem;
            line-height: 1.2;
        }
        
        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: rgba(239, 68, 68, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(239, 68, 68, 0.3);
            font-weight: 600;
            font-size: 0.8rem;
            margin-top: 8px;
        }
        
        .sidebar-menu {
            padding: 1rem 0;
        }
        
        .sidebar-menu a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            padding: 0.875rem 1.5rem;
            display: flex;
            align-items: center;
            transition: all 0.3s;
            border-left: 3px solid transparent;
            font-weight: 500;
            font-size: 0.95rem;
        }
        
        .sidebar-menu a:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a.active {
            background: rgba(255,255,255,0.15);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a i {
            width: 24px;
            margin-right: 12px;
            font-size: 1.1rem;
            flex-shrink: 0;
        }
        
        /* Top Navbar */
        .top-navbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: 70px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.08);
            z-index: 1030;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            transition: all 0.3s;
            border-bottom: 1px solid rgba(30, 58, 138, 0.1);
        }
        
        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: 70px;
            padding: 1.5rem;
            min-height: calc(100vh - 70px);
            transition: all 0.3s;
        }
        
        .page-header {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 50%, #b91c1c 100%);
            color: white;
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(239, 68, 68, 0.25);
            position: relative;
            overflow: hidden;
        }
        
        .page-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }
        
        .stats-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            transition: all 0.3s;
            border: 2px solid transparent;
            height: 100%;
        }
        
        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(30, 58, 138, 0.15);
        }
        
        .stats-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }
        
        .stats-label {
            color: var(--secondary);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }
        
        .stats-value {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--primary);
        }
        
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            background: white;
            border: 1px solid rgba(30, 58, 138, 0.05);
        }
        
        .card-header {
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.03) 0%, rgba(59, 130, 246, 0.03) 100%);
            border-bottom: 2px solid rgba(30, 58, 138, 0.1);
            padding: 1.25rem;
            border-radius: 16px 16px 0 0 !important;
        }
        
        .status-badge {
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .status-pending {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
            border: 1px solid rgba(245, 158, 11, 0.3);
        }
        
        .status-approved {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }
        
        .status-rejected {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
            border: 1px solid rgba(239, 68, 68, 0.3);
        }
        
        .status-processing {
            background: rgba(59, 130, 246, 0.1);
            color: var(--primary-light);
            border: 1px solid rgba(59, 130, 246, 0.3);
        }
        
        .withdrawal-card {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            border: 2px solid rgba(30, 58, 138, 0.1);
            transition: all 0.3s;
        }
        
        .withdrawal-card:hover {
            border-color: var(--primary);
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.15);
        }
        
        .withdrawal-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 1rem;
        }
        
        .member-info {
            flex: 1;
        }
        
        .member-name {
            font-weight: bold;
            color: var(--primary);
            font-size: 1.1rem;
            margin-bottom: 0.25rem;
        }
        
        .member-id {
            color: var(--secondary);
            font-size: 0.85rem;
        }
        
        .withdrawal-amount {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--danger);
        }
        
        .withdrawal-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            padding: 1rem;
            background: rgba(30, 58, 138, 0.02);
            border-radius: 10px;
            margin: 1rem 0;
        }
        
        .detail-item {
            display: flex;
            flex-direction: column;
        }
        
        .detail-label {
            color: var(--secondary);
            font-size: 0.8rem;
            margin-bottom: 0.25rem;
        }
        
        .detail-value {
            font-weight: 600;
            color: var(--primary);
        }
        
        .action-buttons {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .btn-approve {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            border: none;
            padding: 0.5rem 1.25rem;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-approve:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
            color: white;
        }
        
        .btn-reject {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            border: none;
            padding: 0.5rem 1.25rem;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-reject:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.3);
            color: white;
        }
        
        .form-label {
            font-weight: 600;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }
        
        .form-control, .form-select {
            border: 2px solid rgba(30, 58, 138, 0.1);
            border-radius: 10px;
            padding: 0.75rem;
            transition: all 0.3s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(30, 58, 138, 0.1);
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(30, 58, 138, 0.3);
        }
        
        .table-responsive {
            border-radius: 0 0 16px 16px;
            overflow: hidden;
        }
        
        .table {
            margin: 0;
        }
        
        .table thead {
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.05) 0%, rgba(59, 130, 246, 0.05) 100%);
        }
        
        .table thead th {
            border: none;
            padding: 1rem;
            font-weight: 600;
            color: var(--primary);
            white-space: nowrap;
        }
        
        .table tbody td {
            padding: 1rem;
            vertical-align: middle;
            border-bottom: 1px solid rgba(30, 58, 138, 0.05);
        }
        
        .table tbody tr:last-child td {
            border-bottom: none;
        }
        
        .table tbody tr:hover {
            background: rgba(30, 58, 138, 0.02);
        }
        
        .filter-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }
        
        .filter-tab {
            padding: 0.75rem 1.5rem;
            background: white;
            border: 2px solid rgba(30, 58, 138, 0.1);
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
            color: var(--secondary);
        }
        
        .filter-tab:hover {
            border-color: var(--primary);
            color: var(--primary);
        }
        
        .filter-tab.active {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white;
            border-color: var(--primary);
        }
        
        .powered-by {
            position: fixed;
            bottom: 15px;
            right: 15px;
            background: white;
            padding: 10px 16px;
            border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.15);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--primary);
            z-index: 1000;
        }
        
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--secondary);
        }
        
        .empty-state i {
            font-size: 4rem;
            opacity: 0.25;
            margin-bottom: 1rem;
        }
        
        /* Receipt Styles */
        .receipt-container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            padding: 2rem;
            border: 2px solid #e5e7eb;
        }
        
        .receipt-header {
            text-align: center;
            border-bottom: 3px solid var(--primary);
            padding-bottom: 1.5rem;
            margin-bottom: 1.5rem;
        }
        
        .receipt-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            margin: 0 auto 1rem;
        }
        
        .receipt-title {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }
        
        .receipt-subtitle {
            color: var(--secondary);
            font-size: 0.9rem;
        }
        
        .receipt-section {
            margin-bottom: 1.5rem;
        }
        
        .receipt-section-title {
            font-weight: bold;
            color: var(--primary);
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
        }
        
        .receipt-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px dashed #e5e7eb;
        }
        
        .receipt-row:last-child {
            border-bottom: none;
        }
        
        .receipt-label {
            color: var(--secondary);
            font-weight: 500;
        }
        
        .receipt-value {
            font-weight: 600;
            color: #1f2937;
        }
        
        .receipt-amount {
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
            border: 2px solid var(--danger);
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
            margin: 1.5rem 0;
        }
        
        .receipt-amount-label {
            color: var(--secondary);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }
        
        .receipt-amount-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--danger);
        }
        
        .receipt-footer {
            text-align: center;
            border-top: 3px solid var(--primary);
            padding-top: 1.5rem;
            margin-top: 2rem;
        }
        
        .receipt-stamp {
            display: inline-block;
            border: 3px solid var(--danger);
            color: var(--danger);
            padding: 0.5rem 1.5rem;
            border-radius: 10px;
            font-weight: bold;
            transform: rotate(-5deg);
            margin: 1rem 0;
        }
        
        /* Responsive Styles */
        @media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }
            
            .sidebar.active {
                transform: translateX(0);
            }
            
            .top-navbar {
                left: 0;
            }
            
            .main-content {
                margin-left: 0;
                padding: 1rem;
            }
            
            .withdrawal-details {
                grid-template-columns: 1fr;
            }
            
            .withdrawal-header {
                flex-direction: column;
                gap: 1rem;
            }
            
            .table thead {
                display: none;
            }
            
            .table tbody tr {
                display: block;
                margin-bottom: 1rem;
                border: 2px solid rgba(30, 58, 138, 0.1);
                border-radius: 12px;
                overflow: hidden;
                background: white;
            }
            
            .table tbody td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0.75rem 1rem;
                border-bottom: 1px solid rgba(30, 58, 138, 0.05);
            }
            
            .table tbody td:last-child {
                border-bottom: none;
            }
            
            .table tbody td::before {
                content: attr(data-label);
                font-weight: 600;
                color: var(--primary);
                margin-right: 1rem;
            }
        }
        
        @media (max-width: 576px) {
            .top-navbar {
                height: 60px;
                padding: 0 1rem;
            }
            
            .main-content {
                margin-top: 60px;
                padding: 0.75rem;
            }
            
            .page-header {
                padding: 1.25rem;
                border-radius: 16px;
            }
            
            .stats-value {
                font-size: 1.5rem;
            }
            
            .withdrawal-amount {
                font-size: 1.2rem;
            }
            
            .action-buttons {
                width: 100%;
            }
            
            .action-buttons button {
                flex: 1;
            }
        }
        
        @media print {
            body * {
                visibility: hidden;
            }
            
            #printReceipt, #printReceipt * {
                visibility: visible;
            }
            
            #printReceipt {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
            
            .no-print {
                display: none !important;
            }
            
            .sidebar, .top-navbar, .powered-by {
                display: none !important;
            }
        }
        
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .fade-in {
            animation: fadeIn 0.5s ease;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-box">C</div>
                <div>
                    <h5 class="mb-0 fw-bold sidebar-title" style="text-transform: uppercase;">Club De Stars</h5>
                    <small class="opacity-75" style="font-size: 0.75rem;">ADMIN PANEL</small>
                </div>
            </div>
            <div class="admin-badge">
                <i class="fas fa-shield-alt"></i>
                <span>SUPER ADMIN</span>
            </div>
        </div>
        <div class="sidebar-menu">
            <a href="/admin-dashboard">
                <i class="fas fa-users"></i> Members
            </a>
            <a href="/admin/manage/memberType">
                <i class="fas fa-id-card"></i> Membership Types
            </a>
            <a href="/admin/manage-payment">
                <i class="fas fa-credit-card"></i> Payments
            </a>
            <a href="/admin/manage-deposits">
                <i class="fas fa-coins"></i> Deposit Management
            </a>
            <a href="/admin/manage-withdrawals" class="active">
                <i class="fas fa-money-check-alt"></i> Withdrawals
            </a>
            <a href="/admin/manage-extra-charges">
                <i class="fas fa-hand-holding-usd"></i> Extra Charges
            </a>
            <a href="/admin/manage-loan">
                <i class="fas fa-hand-holding-usd"></i> Loan Management
            </a>
            <a href="/admin/loan/settings">
                <i class="fas fa-cogs"></i> Loan Settings
            </a>
            <a href="/admin/external-loans">
                <i class="fas fa-building"></i> External Loans
            </a>
            <a href="#">
                <i class="fas fa-chart-pie"></i> ROI Distribution
            </a>
            <a href="#">
                <i class="fas fa-file-alt"></i> Reports
            </a>
            <a href="/admin/settings">
                <i class="fas fa-cog"></i> Settings
            </a>
            <a href="#" class="mt-3" style="color: rgba(255,255,255,0.6);">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <!-- Top Navbar -->
    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3"
           style="cursor: pointer; color: var(--primary); font-size: 1.5rem;"
           onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
        
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color: var(--primary)">Withdrawal Management</h5>
            <small class="text-muted">Process and manage member withdrawal requests</small>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Page Header -->
        <div class="page-header position-relative">
            <div class="row align-items-center position-relative" style="z-index: 1;">
                <div class="col-md-8">
                    <h2 class="mb-2 fw-bold"><i class="fas fa-money-check-alt me-3"></i>Withdrawal Management</h2>
                    <p class="mb-0 opacity-90">Review and process member withdrawal requests</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="badge bg-light text-dark">
                        <i class="fas fa-calendar me-1"></i>
                        <span id="currentDate"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
      <div class="row mb-4">
  <!-- Pending Requests -->
  <div class="col-lg-3 col-md-6 mb-3">
    <div class="stats-card">
      <div class="stats-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
        <i class="fas fa-clock"></i>
      </div>
      <div class="stats-label">Pending Requests</div>
      <div class="stats-value">
        <%= stats.pendingRequests %>
      </div>
    </div>
  </div>

  <!-- Approved Today -->
  <div class="col-lg-3 col-md-6 mb-3">
    <div class="stats-card">
      <div class="stats-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
        <i class="fas fa-check-circle"></i>
      </div>
      <div class="stats-label">Approved Today</div>
      <div class="stats-value">
        <%= stats.approvedToday %>
      </div>
    </div>
  </div>

  <!-- Rejected Today -->
  <div class="col-lg-3 col-md-6 mb-3">
    <div class="stats-card">
      <div class="stats-icon" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
        <i class="fas fa-ban"></i>
      </div>
      <div class="stats-label">Rejected Today</div>
      <div class="stats-value">
        <%= stats.rejectedToday %>
      </div>
    </div>
  </div>

  <!-- Total Amount -->
