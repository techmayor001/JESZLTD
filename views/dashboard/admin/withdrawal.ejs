<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Withdrawal Management - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; z-index: 1040; overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30,58,138,.15);
            transition: all 0.3s; transform: translateX(0);
        }
        .sidebar-header { padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.1); }
        .logo-container { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .logo-box {
            width: 45px; height: 45px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; color: var(--primary); font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,.2); flex-shrink: 0; overflow: hidden;
        }
        .logo-box img { width: 100%; height: 100%; object-fit: cover; }
        .sidebar-title { font-size: 1.1rem; line-height: 1.2; }
        .admin-badge {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 12px; background: rgba(239,68,68,.2);
            backdrop-filter: blur(10px); border-radius: 20px;
            border: 1px solid rgba(239,68,68,.3);
            font-weight: 600; font-size: .8rem; margin-top: 8px;
        }
        .sidebar-menu { padding: 1rem 0; }
        .sidebar-menu a {
            color: rgba(255,255,255,.85); text-decoration: none;
            padding: .875rem 1.5rem; display: flex; align-items: center;
            transition: all .3s; border-left: 3px solid transparent;
            font-weight: 500; font-size: .95rem;
        }
        .sidebar-menu a:hover { background: rgba(255,255,255,.1); color: white; border-left-color: white; }
        .sidebar-menu a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-menu a i { width: 24px; margin-right: 12px; font-size: 1.1rem; flex-shrink: 0; }
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: 70px;
            background: rgba(255,255,255,.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            border-bottom: 1px solid rgba(30,58,138,.1); transition: all .3s;
        }
        .main-content {
            margin-left: var(--sidebar-width); margin-top: 70px;
            padding: 1.5rem; min-height: calc(100vh - 70px); transition: all .3s;
        }
        .page-header {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 50%, #b91c1c 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(239,68,68,.25);
            position: relative; overflow: hidden;
        }
        .page-header::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,.05); border-radius: 50%;
        }
        .stats-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,.08); transition: all .3s;
            border: 2px solid transparent; height: 100%;
        }
        .stats-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,.15); }
        .stats-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 1rem; }
        .stats-label { color: var(--secondary); font-size: .9rem; margin-bottom: .5rem; }
        .stats-value { font-size: 1.8rem; font-weight: bold; color: var(--primary); }
        .card { border: none; border-radius: 16px; box-shadow: 0 8px 20px rgba(30,58,138,.08); background: white; border: 1px solid rgba(30,58,138,.05); }
        .card-header { background: linear-gradient(135deg,rgba(30,58,138,.03) 0%,rgba(59,130,246,.03) 100%); border-bottom: 2px solid rgba(30,58,138,.1); padding: 1.25rem; border-radius: 16px 16px 0 0 !important; }

        /* ── Status badges ── */
        .status-badge { padding: .4rem .85rem; border-radius: 8px; font-weight: 600; font-size: .8rem; display: inline-flex; align-items: center; gap: .4rem; }
        .status-pending   { background: rgba(245,158,11,.1);  color: var(--warning); border: 1px solid rgba(245,158,11,.3); }
        .status-approved  { background: rgba(16,185,129,.1);  color: var(--success); border: 1px solid rgba(16,185,129,.3); }
        .status-rejected  { background: rgba(239,68,68,.1);   color: var(--danger);  border: 1px solid rgba(239,68,68,.3); }
        .status-processing{ background: rgba(59,130,246,.1);  color: var(--primary-light); border: 1px solid rgba(59,130,246,.3); }

        /* ── Type badges ── */
        .type-badge { padding: .3rem .75rem; border-radius: 6px; font-weight: 700; font-size: .75rem; display: inline-flex; align-items: center; gap: .35rem; letter-spacing: .02em; }
        .type-regular  { background: rgba(16,185,129,.1);  color: #059669; border: 1px solid rgba(16,185,129,.3); }
        .type-ondemand { background: rgba(245,158,11,.1);  color: #b45309; border: 1px solid rgba(245,158,11,.3); }

        /* ── Withdrawal card ── */
        .withdrawal-card {
            background: white; border-radius: 14px; padding: 0;
            margin-bottom: 1.25rem; border: 2px solid rgba(30,58,138,.08);
            transition: all .3s; overflow: hidden;
        }
        .withdrawal-card:hover { border-color: rgba(30,58,138,.25); box-shadow: 0 10px 28px rgba(30,58,138,.12); }
        .wc-top {
            display: flex; justify-content: space-between; align-items: flex-start;
            padding: 1.25rem 1.5rem 1rem; gap: 1rem; flex-wrap: wrap;
        }
        .wc-member-info { flex: 1; min-width: 0; }
        .wc-member-name { font-weight: 700; color: var(--primary); font-size: 1.05rem; margin-bottom: .2rem; }
        .wc-member-meta { color: var(--secondary); font-size: .82rem; }
        .wc-right { display: flex; flex-direction: column; align-items: flex-end; gap: .4rem; flex-shrink: 0; }
        .wc-gross { font-size: 1.6rem; font-weight: 800; color: var(--danger); line-height: 1; }
        .wc-gross small { font-size: .65em; font-weight: 600; opacity: .7; }
        .wc-badges { display: flex; gap: .4rem; flex-wrap: wrap; justify-content: flex-end; }

        /* ── Financial breakdown strip ── */
        .wc-financials {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 0;
            border-top: 1px solid rgba(30,58,138,.07);
            border-bottom: 1px solid rgba(30,58,138,.07);
            background: linear-gradient(135deg, rgba(30,58,138,.025) 0%, rgba(59,130,246,.015) 100%);
        }
        .wc-fin-item {
            padding: .9rem 1.25rem;
            border-right: 1px solid rgba(30,58,138,.07);
        }
        .wc-fin-item:last-child { border-right: none; }
        .wc-fin-label { font-size: .73rem; text-transform: uppercase; letter-spacing: .07em; color: var(--secondary); margin-bottom: .3rem; font-weight: 600; }
        .wc-fin-value { font-size: 1rem; font-weight: 700; color: var(--primary); }
        .wc-fin-value.fee-color     { color: var(--danger); }
        .wc-fin-value.net-color     { color: var(--success); }
        .wc-fin-value.bal-color     { color: #7c3aed; }
        .wc-fin-value.rate-color    { color: var(--warning); }
        .wc-fin-note { font-size: .72rem; color: var(--secondary); margin-top: .15rem; }

        /* Deactivation flag pill */
        .deact-pill {
            display: inline-flex; align-items: center; gap: .35rem;
            padding: .25rem .7rem; border-radius: 6px; font-size: .73rem; font-weight: 600;
            background: rgba(239,68,68,.08); color: var(--danger);
            border: 1px solid rgba(239,68,68,.2); margin-left: .5rem;
        }

        /* ── Bank details strip ── */
        .wc-bank {
            display: flex; gap: 1.5rem; flex-wrap: wrap;
            padding: .85rem 1.5rem;
            border-bottom: 1px solid rgba(30,58,138,.07);
        }
        .wc-bank-item { display: flex; flex-direction: column; }
        .wc-bank-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--secondary); margin-bottom: .15rem; font-weight: 600; }
        .wc-bank-value { font-size: .9rem; font-weight: 600; color: #1f2937; }

        /* ── Actions row ── */
        .wc-actions {
            display: flex; gap: .6rem; flex-wrap: wrap;
            padding: 1rem 1.5rem;
            background: rgba(248,250,252,.6);
        }
        .btn-approve {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white; border: none; padding: .5rem 1.25rem; border-radius: 8px;
            font-weight: 600; transition: all .3s; font-size: .85rem;
        }
        .btn-approve:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(16,185,129,.3); color: white; }
        .btn-reject {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white; border: none; padding: .5rem 1.25rem; border-radius: 8px;
            font-weight: 600; transition: all .3s; font-size: .85rem;
        }
        .btn-reject:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(239,68,68,.3); color: white; }
        .btn-view {
            background: rgba(30,58,138,.07); color: var(--primary);
            border: 1.5px solid rgba(30,58,138,.2); padding: .5rem 1.25rem;
            border-radius: 8px; font-weight: 600; transition: all .3s; font-size: .85rem;
        }
        .btn-view:hover { background: rgba(30,58,138,.12); }
        .wc-ref { margin-left: auto; font-size: .75rem; color: var(--secondary); font-family: monospace; align-self: center; }

        /* ── Filter tabs ── */
        .filter-tabs { display: flex; gap: .5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
        .filter-tab {
            padding: .6rem 1.25rem; background: white; border: 2px solid rgba(30,58,138,.1);
            border-radius: 10px; cursor: pointer; transition: all .3s;
            font-weight: 600; color: var(--secondary); font-size: .85rem;
        }
        .filter-tab:hover { border-color: var(--primary); color: var(--primary); }
        .filter-tab.active { background: linear-gradient(135deg,#1e3a8a 0%,#3b82f6 100%); color: white; border-color: var(--primary); }

        /* ── Modals ── */
        .form-label { font-weight: 600; color: var(--primary); margin-bottom: .5rem; }
        .form-control, .form-select { border: 2px solid rgba(30,58,138,.1); border-radius: 10px; padding: .75rem; transition: all .3s; }
        .form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 .2rem rgba(30,58,138,.1); }
        .btn-primary { background: linear-gradient(135deg,#1e3a8a 0%,#3b82f6 100%); border: none; padding: .75rem 1.5rem; border-radius: 10px; font-weight: 600; transition: all .3s; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(30,58,138,.3); }
        .financial-summary-box {
            background: linear-gradient(135deg,rgba(30,58,138,.03) 0%,rgba(59,130,246,.03) 100%);
            border: 2px solid rgba(30,58,138,.1); border-radius: 12px; padding: 1rem; margin-bottom: 1rem;
        }
        .fin-sum-row { display: flex; justify-content: space-between; padding: .4rem 0; font-size: .9rem; border-bottom: 1px dashed rgba(30,58,138,.08); }
        .fin-sum-row:last-child { border-bottom: none; font-weight: 700; font-size: 1rem; }
        .fin-sum-label { color: var(--secondary); }
        .fin-sum-val { font-weight: 600; }
        .fin-sum-val.gross { color: var(--danger); }
        .fin-sum-val.fee   { color: var(--warning); }
        .fin-sum-val.net   { color: var(--success); }

        /* ── Receipt ── */
        .receipt-container { max-width: 800px; margin: 0 auto; background: white; padding: 2rem; border: 2px solid #e5e7eb; }
        .receipt-header { text-align: center; border-bottom: 3px solid var(--primary); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
        .receipt-logo { width: 80px; height: 80px; background: linear-gradient(135deg,#1e3a8a 0%,#3b82f6 100%); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; margin: 0 auto 1rem; }
        .receipt-title { font-size: 1.8rem; font-weight: bold; color: var(--primary); margin-bottom: .5rem; }
        .receipt-subtitle { color: var(--secondary); font-size: .9rem; }
        .receipt-section { margin-bottom: 1.5rem; }
        .receipt-section-title { font-weight: bold; color: var(--primary); border-bottom: 2px solid #e5e7eb; padding-bottom: .5rem; margin-bottom: 1rem; }
        .receipt-row { display: flex; justify-content: space-between; padding: .5rem 0; border-bottom: 1px dashed #e5e7eb; }
        .receipt-row:last-child { border-bottom: none; }
        .receipt-label { color: var(--secondary); font-weight: 500; }
        .receipt-value { font-weight: 600; color: #1f2937; }
        .receipt-amount { background: linear-gradient(135deg,#fef2f2 0%,#fee2e2 100%); border: 2px solid var(--danger); border-radius: 10px; padding: 1rem; text-align: center; margin: 1.5rem 0; }
        .receipt-amount-label { color: var(--secondary); font-size: .9rem; margin-bottom: .5rem; }
        .receipt-amount-value { font-size: 2.5rem; font-weight: bold; color: var(--danger); }
        .receipt-footer { text-align: center; border-top: 3px solid var(--primary); padding-top: 1.5rem; margin-top: 2rem; }
        .receipt-stamp { display: inline-block; border: 3px solid var(--danger); color: var(--danger); padding: .5rem 1.5rem; border-radius: 10px; font-weight: bold; transform: rotate(-5deg); margin: 1rem 0; }

        .empty-state { text-align: center; padding: 3rem 1rem; color: var(--secondary); }
        .empty-state i { font-size: 4rem; opacity: .25; margin-bottom: 1rem; }
        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,.15); font-size: .8rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
            .wc-financials { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 576px) {
            .top-navbar { height: 60px; padding: 0 1rem; }
            .main-content { margin-top: 60px; padding: .75rem; }
            .page-header { padding: 1.25rem; border-radius: 16px; }
            .wc-gross { font-size: 1.3rem; }
            .wc-financials { grid-template-columns: 1fr 1fr; }
            .wc-ref { display: none; }
        }
        @media print {
            body * { visibility: hidden; }
            #printReceipt, #printReceipt * { visibility: visible; }
            #printReceipt { position: absolute; left: 0; top: 0; width: 100%; }
            .no-print, .sidebar, .top-navbar, .powered-by { display: none !important; }
        }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .fade-in { animation: fadeIn .4s ease; }
    </style>
</head>
<body>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-container">
            <div class="logo-box">
                <img src="/media/assets/logo/log.png" alt="Logo" onerror="this.style.display='none';this.parentNode.innerHTML='<b>C</b>'">
            </div>
            <div>
                <h5 class="mb-0 fw-bold sidebar-title" style="text-transform:uppercase;">Club De Stars</h5>
                <small class="opacity-75" style="font-size:.75rem;">ADMIN PANEL</small>
            </div>
        </div>
        <div class="admin-badge"><i class="fas fa-shield-alt"></i><span><%= admin.role?.name?.toUpperCase() || 'ADMIN' %></span></div>
    </div>
    <div class="sidebar-menu">
        <a href="/admin-dashboard"><i class="fas fa-users"></i>Members</a>
        <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i>Kiddies Accounts</a>
        <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i>Membership Types</a>
        <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i>Payments</a>
        <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i>Approvals<span id="sidebarPendingBadge" class="badge bg-danger ms-1" style="display:none;">0</span></a>
        <a href="/admin/manage-deposits"><i class="fas fa-coins"></i>Deposit Management</a>
        <a href="/admin/manage-withdrawals" class="active"><i class="fas fa-money-check-alt"></i>Withdrawals</a>
        <a href="/admin/manage-extra-charges"><i class="fas fa-hand-holding-usd"></i>Extra Charges</a>
        <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i>Loan Management</a>
        <a href="/admin/loan/settings"><i class="fas fa-cogs"></i>Loan Settings</a>
        <a href="/admin/external-loans"><i class="fas fa-building"></i>External Loans</a>
        <a href="/admin/finance"><i class="fas fa-landmark"></i>Company Finance</a>
        <a href="#"><i class="fas fa-chart-pie"></i>ROI Distribution</a>
        <a href="/manage-subscriptions"><i class="fas fa-cube"></i>Manage Subscription</a>
        <a href="/manage-roles"><i class="fas fa-user-shield"></i>Roles &amp; Permissions</a>
        <a href="/admin/settings"><i class="fas fa-cog"></i>Settings</a>
        <a href="/admin/reports"><i class="fas fa-file-alt"></i>Reports</a>
        <a href="/admin/logs"><i class="fas fa-history"></i>Admin Logs</a>
        <a href="/cds-cooperative/dashboard" class="mt-3" style="color:rgba(255,255,255,.6);"><i class="fas fa-sign-in-alt"></i>Back to Dashboard</a>
    </div>
</div>

<!-- Top Navbar -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;"
       onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
    <div class="flex-grow-1 d-none d-lg-block">
        <h5 class="mb-0 fw-bold" style="color:var(--primary)">Withdrawal Management</h5>
        <small class="text-muted">Process and manage member withdrawal requests</small>
    </div>
</div>

<!-- Main Content -->
<div class="main-content">

    <!-- Page Header -->
    <div class="page-header position-relative">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-md-8">
                <h2 class="mb-2 fw-bold"><i class="fas fa-money-check-alt me-3"></i>Withdrawal Management</h2>
                <p class="mb-0 opacity-90">Review gross amounts, charges, and net payouts before approving</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="badge bg-light text-dark">
                    <i class="fas fa-calendar me-1"></i><span id="currentDate"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%);color:white;"><i class="fas fa-clock"></i></div>
                <div class="stats-label">Pending Requests</div>
                <div class="stats-value"><%= stats.pendingRequests %></div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#10b981 0%,#059669 100%);color:white;"><i class="fas fa-check-circle"></i></div>
                <div class="stats-label">Approved Today</div>
                <div class="stats-value"><%= stats.approvedToday %></div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%);color:white;"><i class="fas fa-ban"></i></div>
                <div class="stats-label">Rejected Today</div>
                <div class="stats-value"><%= stats.rejectedToday %></div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#8b5cf6 0%,#7c3aed 100%);color:white;"><i class="fas fa-wallet"></i></div>
                <div class="stats-label">Total Approved</div>
                <div class="stats-value" style="font-size:1.4rem;">₦<%= stats.totalAmount.toLocaleString() %></div>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
        <div class="filter-tab active" onclick="filterWithdrawals('all', this)"><i class="fas fa-list me-2"></i>All</div>
        <div class="filter-tab" onclick="filterWithdrawals('pending', this)"><i class="fas fa-clock me-2"></i>Pending</div>
        <div class="filter-tab" onclick="filterWithdrawals('approved', this)"><i class="fas fa-check-circle me-2"></i>Approved</div>
        <div class="filter-tab" onclick="filterWithdrawals('rejected', this)"><i class="fas fa-times-circle me-2"></i>Rejected</div>
        <div class="filter-tab" onclick="filterWithdrawals('processing', this)"><i class="fas fa-spinner me-2"></i>Processing</div>
    </div>

    <!-- Withdrawal Cards -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2" style="color:var(--primary);"></i>Withdrawal Requests</h5>
            <button class="btn btn-sm btn-outline-primary" onclick="exportWithdrawals()"><i class="fas fa-download me-1"></i>Export</button>
        </div>
        <div class="card-body p-3" id="withdrawalContainer">

          <% if (withdrawals.length === 0) { %>
            <div class="empty-state">
                <i class="fas fa-folder-open d-block"></i>
                <p>No withdrawal requests found</p>
            </div>
          <% } %>

          <% withdrawals.forEach((w) => {
               const isOnDemand  = w.type === 'ondemand';
               const hasFee      = w.penaltyAmount > 0;
               const feeRateStr  = w.penaltyRate > 0 ? w.penaltyRate + '%' : '—';
          %>
            <div class="withdrawal-card fade-in" data-status="<%= w.status %>">

              <!-- Top row: member + gross amount + badges -->
              <div class="wc-top">
                <div class="wc-member-info">
                  <div class="wc-member-name">
                    <%= w.memberName %>
                    <% if (w.triggeredDeactivation) { %>
                      <span class="deact-pill"><i class="fas fa-lock" style="font-size:.65rem;"></i>Deactivated</span>
                    <% } %>
                  </div>
                  <div class="wc-member-meta">
                    <%= w.memberId %> &nbsp;·&nbsp; <%= w.memberEmail %> &nbsp;·&nbsp; <%= w.date %> <%= w.time %>
                  </div>
                </div>
                <div class="wc-right">
                  <div class="wc-gross">
                    <small>₦</small><%= w.amount.toLocaleString() %>
                    <span style="font-size:.55em;font-weight:500;color:var(--secondary);"> gross</span>
                  </div>
                  <div class="wc-badges">
                    <!-- Withdrawal type -->
                    <span class="type-badge type-<%= w.type %>">
                      <% if (isOnDemand) { %><i class="fas fa-bolt" style="font-size:.7em;"></i>On-demand
                      <% } else { %><i class="fas fa-calendar-check" style="font-size:.7em;"></i>Regular<% } %>
                    </span>
                    <!-- Status -->
                    <span class="status-badge status-<%= w.status %>">
                      <i class="fas fa-<%=
                        w.status === 'pending'    ? 'clock' :
                        w.status === 'approved'   ? 'check-circle' :
                        w.status === 'rejected'   ? 'times-circle' :
                        'spinner fa-spin'
                      %>"></i>
                      <%= w.status.charAt(0).toUpperCase() + w.status.slice(1) %>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Financial breakdown strip -->
              <div class="wc-financials">
                <div class="wc-fin-item">
                  <div class="wc-fin-label">Gross Requested</div>
                  <div class="wc-fin-value">₦<%= w.amount.toLocaleString() %></div>
                  <div class="wc-fin-note">Full deducted amount</div>
                </div>
                <div class="wc-fin-item">
                  <div class="wc-fin-label">Fee Rate</div>
                  <div class="wc-fin-value rate-color"><%= feeRateStr %></div>
                  <div class="wc-fin-note"><%= isOnDemand ? 'On-demand charge' : 'No fee (regular)' %></div>
                </div>
                <div class="wc-fin-item">
                  <div class="wc-fin-label">Fee Amount</div>
                  <div class="wc-fin-value fee-color">
                    <% if (hasFee) { %>₦<%= w.penaltyAmount.toLocaleString() %><% } else { %>₦0<% } %>
                  </div>
                  <div class="wc-fin-note">Cooperative income</div>
                </div>
                <div class="wc-fin-item">
                  <div class="wc-fin-label">Net to Pay Out</div>
                  <div class="wc-fin-value net-color">₦<%= w.netAmount.toLocaleString() %></div>
                  <div class="wc-fin-note">Transfer to member</div>
                </div>
                <div class="wc-fin-item">
                  <div class="wc-fin-label">Member Balance</div>
                  <div class="wc-fin-value bal-color">₦<%= w.balance.toLocaleString() %></div>
                  <div class="wc-fin-note">After deduction</div>
                </div>
              </div>

              <!-- Bank details -->
              <div class="wc-bank">
                <div class="wc-bank-item">
                  <div class="wc-bank-label">Bank</div>
                  <div class="wc-bank-value"><%= w.bankName %></div>
                </div>
                <div class="wc-bank-item">
                  <div class="wc-bank-label">Account Number</div>
                  <div class="wc-bank-value" style="font-family:monospace;letter-spacing:.05em;"><%= w.accountNumber %></div>
                </div>
                <div class="wc-bank-item">
                  <div class="wc-bank-label">Account Name</div>
                  <div class="wc-bank-value"><%= w.accountName %></div>
                </div>
                <% if (w.memberPhone) { %>
                <div class="wc-bank-item">
                  <div class="wc-bank-label">Phone</div>
                  <div class="wc-bank-value"><%= w.memberPhone %></div>
                </div>
                <% } %>
              </div>

              <!-- Actions -->
              <div class="wc-actions">
                <% if (w.status === 'pending' || w.status === 'processing') { %>
                  <button class="btn-approve" onclick="approveWithdrawal('<%= w.id %>')">
                    <i class="fas fa-check me-1"></i>Approve &amp; Pay ₦<%= w.netAmount.toLocaleString() %>
                  </button>
                  <button class="btn-reject" onclick="rejectWithdrawal('<%= w.id %>')">
                    <i class="fas fa-times me-1"></i>Reject
                  </button>
                <% } %>
                <button class="btn-view" onclick="viewDetails('<%= w.id %>')">
                  <i class="fas fa-eye me-1"></i>Details
                </button>
                <span class="wc-ref">Ref: <%= w.reference %></span>
              </div>

            </div>
          <% }) %>

        </div>
    </div>
</div>

<div class="powered-by"><strong style="color:var(--primary);">Cloudbaam</strong> · <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

