<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
    let currentWithdrawal = null;
    const withdrawalsData = <%- JSON.stringify(withdrawals) %>;

    document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US',{weekday:'short',year:'numeric',month:'short',day:'numeric'});

    function getWD(id){ return withdrawalsData.find(w => String(w.id) === String(id)); }
    function fmt(n){ return '₦' + Number(n).toLocaleString(); }
    function capFirst(s){ return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }

    /* ── Filter tabs ── */
    function filterWithdrawals(status, el){
        document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
        el.classList.add('active');
        document.querySelectorAll('.withdrawal-card').forEach(c => {
            c.style.display = (status === 'all' || c.dataset.status === status) ? 'block' : 'none';
        });
    }

    /* ── Financial summary HTML ── */
    function financialSummaryHTML(w){
        const hasFee = w.penaltyAmount > 0;
        return `
        <div class="fin-sum-row">
            <span class="fin-sum-label">Gross Requested</span>
            <span class="fin-sum-val gross">${fmt(w.amount)}</span>
        </div>
        <div class="fin-sum-row">
            <span class="fin-sum-label">Fee (${w.penaltyRate || 0}% ${w.type === 'ondemand' ? 'on-demand' : 'none'})</span>
            <span class="fin-sum-val fee">${hasFee ? fmt(w.penaltyAmount) : '₦0'}</span>
        </div>
        <div class="fin-sum-row">
            <span class="fin-sum-label"><strong>Net to Pay Out</strong></span>
            <span class="fin-sum-val net"><strong>${fmt(w.netAmount)}</strong></span>
        </div>
        <div class="fin-sum-row" style="font-size:.85rem;">
            <span class="fin-sum-label">Member: ${w.memberName}</span>
            <span class="fin-sum-val">${w.bankName} &middot; ${w.accountNumber}</span>
        </div>`;
    }

    /* ── Approve ── */
    function approveWithdrawal(id){
        currentWithdrawal = getWD(id);
        document.getElementById('approvalFinancials').innerHTML = financialSummaryHTML(currentWithdrawal);
        document.getElementById('approvalNotes').value = '';
        new bootstrap.Modal(document.getElementById('approvalModal')).show();
    }

    async function confirmApproval(){
        const notes = document.getElementById('approvalNotes').value;
        if(!currentWithdrawal) return;
        const btn = document.querySelector('#approvalModal .btn-success');
        btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing…';
        try {
            const res  = await fetch(`/admin/withdrawals/${currentWithdrawal.id}/approve`, {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ notes })
            });
            const data = await res.json();
            if(data.success){
                bootstrap.Modal.getInstance(document.getElementById('approvalModal')).hide();
                document.getElementById('successMessage').textContent = `Withdrawal Approved — ${fmt(currentWithdrawal.netAmount)} will be paid to ${currentWithdrawal.memberName}`;
                document.getElementById('successReference').textContent = currentWithdrawal.reference;
                populateReceipt(currentWithdrawal, 'Approved');
                new bootstrap.Modal(document.getElementById('successModal')).show();
                setTimeout(() => location.reload(), 2500);
            } else {
                alert(data.message || 'Approval failed');
            }
        } catch(e){ alert('An error occurred. Please try again.'); }
        finally { btn.disabled = false; btn.innerHTML = '<i class="fas fa-check me-2"></i>Confirm Approval'; }
    }

    /* ── Reject ── */
    function rejectWithdrawal(id){
        currentWithdrawal = getWD(id);
        document.getElementById('rejectionDetails').innerHTML = financialSummaryHTML(currentWithdrawal);
        document.getElementById('rejectionReason').value = '';
        document.getElementById('rejectionNotes').value  = '';
        new bootstrap.Modal(document.getElementById('rejectionModal')).show();
    }

    async function confirmRejection(){
        const reason = document.getElementById('rejectionReason').value;
        const notes  = document.getElementById('rejectionNotes').value;
        if(!reason){ alert('Please select a rejection reason.'); return; }
        if(!currentWithdrawal) return;
        const btn = document.querySelector('#rejectionModal .btn-danger');
        btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing…';
        try {
            const res  = await fetch(`/admin/withdrawals/${currentWithdrawal.id}/reject`, {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ reason, notes })
            });
            const data = await res.json();
            if(data.success){
                bootstrap.Modal.getInstance(document.getElementById('rejectionModal')).hide();
                document.getElementById('successMessage').textContent = `Withdrawal Rejected — ${fmt(currentWithdrawal.amount)} refunded to ${currentWithdrawal.memberName}`;
                document.getElementById('successReference').textContent = currentWithdrawal.reference;
                populateReceipt(currentWithdrawal, 'Rejected');
                new bootstrap.Modal(document.getElementById('successModal')).show();
                setTimeout(() => location.reload(), 2500);
            } else {
                alert(data.message || 'Rejection failed');
            }
        } catch(e){ alert('An error occurred. Please try again.'); }
        finally { btn.disabled = false; btn.innerHTML = '<i class="fas fa-times me-2"></i>Confirm Rejection'; }
    }

    /* ── Details modal ── */
    function viewDetails(id){
        const w = getWD(id); currentWithdrawal = w;
        document.getElementById('dm-name').textContent    = w.memberName;
        document.getElementById('dm-id').textContent      = w.memberId;
        document.getElementById('dm-email').textContent   = w.memberEmail  || '—';
        document.getElementById('dm-phone').textContent   = w.memberPhone  || '—';
        document.getElementById('dm-type').textContent    = w.typeLabel    || capFirst(w.type);
        document.getElementById('dm-ref').textContent     = w.reference;
        document.getElementById('dm-date').textContent    = w.date + ' ' + w.time;
        const sb = document.getElementById('dm-status');
        sb.className = 'status-badge status-' + w.status;
        sb.innerHTML = capFirst(w.status);
        document.getElementById('dm-deact').textContent   = w.triggeredDeactivation ? '⚠️ Deactivated' : 'Active';
        document.getElementById('dm-gross').textContent   = fmt(w.amount);
        document.getElementById('dm-rate').textContent    = w.penaltyRate > 0 ? w.penaltyRate + '%' : '—';
        document.getElementById('dm-fee').textContent     = fmt(w.penaltyAmount);
        document.getElementById('dm-net').textContent     = fmt(w.netAmount);
        document.getElementById('dm-bal').textContent     = fmt(w.balance);
        document.getElementById('dm-payout').textContent  = capFirst(w.payoutType || 'immediate');
        document.getElementById('dm-bank').textContent    = w.bankName;
        document.getElementById('dm-acctno').textContent  = w.accountNumber;
        document.getElementById('dm-acctname').textContent= w.accountName;
        populateReceipt(w, capFirst(w.status));
        new bootstrap.Modal(document.getElementById('detailsModal')).show();
    }

    /* ── Receipt populate ── */
    function populateReceipt(w, status){
        document.getElementById('pr-ref').textContent     = w.reference;
        document.getElementById('pr-date').textContent    = w.date + ' ' + w.time;
        document.getElementById('pr-type').textContent    = w.typeLabel || capFirst(w.type);
        document.getElementById('pr-status').textContent  = status;
        document.getElementById('pr-name').textContent    = w.memberName;
        document.getElementById('pr-memberid').textContent= w.memberId;
        document.getElementById('pr-email').textContent   = w.memberEmail || '—';
        document.getElementById('pr-gross').textContent   = fmt(w.amount);
        document.getElementById('pr-gross2').textContent  = fmt(w.amount);
        document.getElementById('pr-rate').textContent    = w.penaltyRate > 0 ? w.penaltyRate + '%' : 'None';
        document.getElementById('pr-fee').textContent     = fmt(w.penaltyAmount);
        document.getElementById('pr-net').textContent     = fmt(w.netAmount);
        document.getElementById('pr-bank').textContent    = w.bankName;
        document.getElementById('pr-acctno').textContent  = w.accountNumber;
        document.getElementById('pr-acctname').textContent= w.accountName;
        document.getElementById('pr-generated').textContent = new Date().toLocaleString('en-US',{year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit'});
    }

    function printWithdrawalReceipt(){
        document.getElementById('printReceipt').style.display = 'block';
        setTimeout(()=>{ window.print(); document.getElementById('printReceipt').style.display='none'; }, 120);
    }

    function exportWithdrawals(){
        const rows = [['Reference','Member','Member ID','Type','Gross','Fee Rate','Fee Amount','Net Payout','Balance After','Bank','Acct No','Status','Date']];
        withdrawalsData.forEach(w=>{
            rows.push([w.reference, w.memberName, w.memberId, w.typeLabel||w.type, w.amount, (w.penaltyRate||0)+'%', w.penaltyAmount||0, w.netAmount, w.balance, w.bankName, w.accountNumber, w.status, w.date+' '+w.time]);
        });
        const csv = rows.map(r=>r.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(',')).join('\n');
        const a = document.createElement('a');
        a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
        a.download = 'withdrawals-' + new Date().toISOString().slice(0,10) + '.csv';
        a.click();
    }

    /* ── Sidebar close on outside click (mobile) ── */
    document.addEventListener('click', e=>{
        const sb = document.getElementById('sidebar');
        if(window.innerWidth<=992 && !sb.contains(e.target) && !e.target.closest('.fa-bars') && sb.classList.contains('active'))
            sb.classList.remove('active');
    });

    /* ── Sidebar pending badge ── */
    async function loadSidebarPendingCount(){
        try {
            const res  = await fetch('/admin/pending-approvals-count');
            const data = await res.json();
            const badge = document.getElementById('sidebarPendingBadge');
            if(!badge) return;
            if(data.count > 0){ badge.style.display='inline-block'; badge.textContent=data.count; }
            else badge.style.display='none';
        } catch(e){ console.error('Sidebar count error:',e); }
    }
    document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
</script>
</body>
</html>
