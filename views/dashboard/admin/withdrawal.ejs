    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentWithdrawal = null;
        function getWithdrawalById(id) {
        return withdrawalsData.find(w => w.id === id || w._id === id);
        }

        
        const withdrawalsData = <%- JSON.stringify(withdrawals) %>;

        // Display current date
        document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', { 
            weekday: 'short', 
            year: 'numeric', 
            month: 'short', 
            day: 'numeric' 
        });

        // Filter withdrawals
        function filterWithdrawals(status) {
            const cards = document.querySelectorAll('.withdrawal-card');
            const tabs = document.querySelectorAll('.filter-tab');
            
            // Update active tab
            tabs.forEach(tab => tab.classList.remove('active'));
            event.currentTarget.classList.add('active');
            
            // Filter cards
            cards.forEach(card => {
                if (status === 'all' || card.dataset.status === status) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
            
            // Check if any cards are visible
            const visibleCards = Array.from(cards).filter(card => card.style.display !== 'none');
            const container = document.getElementById('withdrawalContainer');
            
            if (visibleCards.length === 0) {
                if (!document.querySelector('.empty-state')) {
                    container.innerHTML += `
                        <div class="empty-state">
                            <i class="fas fa-folder-open"></i>
                            <p>No withdrawal requests found for this filter</p>
                        </div>
                    `;
                }
            } else {
                const emptyState = document.querySelector('.empty-state');
                if (emptyState) {
                    emptyState.remove();
                }
            }
        }

        // Approve withdrawal
        function approveWithdrawal(id) {
            currentWithdrawal = getWithdrawalById(id);
            
            const detailsHTML = `
                <div class="withdrawal-details">
                    <div class="detail-item">
                        <div class="detail-label">Member</div>
                        <div class="detail-value">${currentWithdrawal.memberName} (${currentWithdrawal.memberId})</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Amount</div>
                        <div class="detail-value">₦${currentWithdrawal.amount.toLocaleString()}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Bank</div>
                        <div class="detail-value">${currentWithdrawal.bankName}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Account Number</div>
                        <div class="detail-value">${currentWithdrawal.accountNumber}</div>
                    </div>
                </div>
            `;
            
            document.getElementById('approvalDetails').innerHTML = detailsHTML;
            new bootstrap.Modal(document.getElementById('approvalModal')).show();
        }

        // Reject withdrawal
        function rejectWithdrawal(id) {
            currentWithdrawal = getWithdrawalById(id);
            
            const detailsHTML = `
                <div class="withdrawal-details">
                    <div class="detail-item">
                        <div class="detail-label">Member</div>
                        <div class="detail-value">${currentWithdrawal.memberName} (${currentWithdrawal.memberId})</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Amount</div>
                        <div class="detail-value">₦${currentWithdrawal.amount.toLocaleString()}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Current Balance</div>
                        <div class="detail-value">₦${currentWithdrawal.balance.toLocaleString()}</div>
                    </div>
                </div>
            `;
            
            document.getElementById('rejectionDetails').innerHTML = detailsHTML;
            new bootstrap.Modal(document.getElementById('rejectionModal')).show();
        }

        // Confirm approval
async function confirmApproval() {
    const notes = document.getElementById('approvalNotes').value;
    
    if (!currentWithdrawal) return;

    try {
        // Send approval request to backend
        const response = await fetch(`/admin/withdrawals/${currentWithdrawal.id}/approve`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ notes })
        });

        const data = await response.json();

        if (data.success) {
            // Hide approval modal
            bootstrap.Modal.getInstance(document.getElementById('approvalModal')).hide();

            // Show success modal
            document.getElementById('successMessage').textContent = data.message;
            document.getElementById('successReference').textContent = currentWithdrawal.id;

            // Populate receipt data with updated withdrawal info
            currentWithdrawal.balance = data.newBalance; // update balance in UI
            populateReceiptData(currentWithdrawal, data.status, notes);

            new bootstrap.Modal(document.getElementById('successModal')).show();

            // Reload page after 2s
            setTimeout(() => {
                location.reload();
            }, 2000);
        } else {
            alert(data.message || 'Failed to approve withdrawal');
        }

    } catch (error) {
        console.error('Approval error:', error);
        alert('An error occurred while approving the withdrawal.');
    }
}


        // Confirm rejection
        function confirmRejection() {
            const reason = document.getElementById('rejectionReason').value;
            const notes = document.getElementById('rejectionNotes').value;
            
            if (!reason) {
                alert('Please select a reason for rejection');
                return;
            }
            
            // In production, this would make an API call
            console.log('Rejecting withdrawal:', currentWithdrawal.id, reason, notes);
            
            // Hide rejection modal
            bootstrap.Modal.getInstance(document.getElementById('rejectionModal')).hide();
            
            // Show success modal
            document.getElementById('successMessage').textContent = 'Withdrawal Rejected';
            document.getElementById('successReference').textContent = currentWithdrawal.id;
            
            new bootstrap.Modal(document.getElementById('successModal')).show();
            
            // Update UI (in production, reload data from server)
            setTimeout(() => {
                location.reload();
            }, 2000);
        }

function viewWithdrawalDetails(id) {
    const withdrawal = getWithdrawalById(id);
    currentWithdrawal = withdrawal;

    // Populate modal
    document.getElementById('detailMemberName').textContent = withdrawal.memberName;
    document.getElementById('detailMemberId').textContent = withdrawal.memberId;
    document.getElementById('detailMemberEmail').textContent = withdrawal.memberEmail || 'N/A';
    document.getElementById('detailMemberPhone').textContent = withdrawal.memberPhone || 'N/A';
    document.getElementById('detailWithdrawalType').textContent = capitalizeFirst(withdrawal.type || 'normal');

    document.getElementById('detailRequestId').textContent = withdrawal.id;
    document.getElementById('detailRequestDate').textContent = withdrawal.date + " " + withdrawal.time;
    document.getElementById('detailReason').textContent = withdrawal.reason || '';

    // Update status badge
    const statusBadge = document.getElementById('detailStatus');
    statusBadge.className = 'status-badge status-' + withdrawal.status;
    statusBadge.innerHTML = `<i class="fas fa-${getStatusIcon(withdrawal.status)}"></i>${capitalizeFirst(withdrawal.status)}`;

    document.getElementById('detailAmount').textContent = '₦' + withdrawal.amount.toLocaleString();
    document.getElementById('detailBalance').textContent = '₦' + withdrawal.balance.toLocaleString();
    document.getElementById('detailBalanceAfter').textContent = '₦' + (withdrawal.balance - withdrawal.amount).toLocaleString();

    document.getElementById('detailBankName').textContent = withdrawal.bankName;
    document.getElementById('detailAccountNumber').textContent = withdrawal.accountNumber;
    document.getElementById('detailAccountName').textContent = withdrawal.accountName;

    // Show additional info for processed withdrawals
    const additionalSection = document.getElementById('additionalInfoSection');
    if (withdrawal.status === 'approved' || withdrawal.status === 'rejected') {
        additionalSection.style.display = 'block';
        document.getElementById('detailProcessedBy').textContent = withdrawal.processedBy || withdrawal.rejectedBy || 'Admin User';
        document.getElementById('detailProcessingDate').textContent = withdrawal.approvalDate || withdrawal.rejectionDate || 'N/A';
        document.getElementById('detailNotes').textContent = withdrawal.notes || withdrawal.rejectionReason || 'No additional notes';
    } else {
        additionalSection.style.display = 'none';
    }

    // Populate receipt data
    populateReceiptData(withdrawal, withdrawal.status);

    // Show modal
    new bootstrap.Modal(document.getElementById('withdrawalDetailsModal')).show();
}


        // Populate receipt data
        function populateReceiptData(withdrawal, status, notes = '') {
            document.getElementById('printReference').textContent = withdrawal.id;
            document.getElementById('printRequestDate').textContent = withdrawal.requestDate;
            document.getElementById('printApprovalDate').textContent = withdrawal.approvalDate || new Date().toLocaleString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
            document.getElementById('printStatus').textContent = capitalizeFirst(status);
            
            document.getElementById('printMemberName').textContent = withdrawal.memberName;
            document.getElementById('printMemberId').textContent = withdrawal.memberId;
            document.getElementById('printEmail').textContent = withdrawal.memberEmail;
            document.getElementById('printPhone').textContent = withdrawal.memberPhone;
            
            document.getElementById('printAmount').textContent = '₦' + withdrawal.amount.toLocaleString() + '.00';
            
            document.getElementById('printBankName').textContent = withdrawal.bankName;
            document.getElementById('printAccountNumber').textContent = withdrawal.accountNumber;
            document.getElementById('printAccountName').textContent = withdrawal.accountName;
            
            document.getElementById('printBalanceBefore').textContent = '₦' + withdrawal.balance.toLocaleString() + '.00';
            document.getElementById('printWithdrawalAmount').textContent = '₦' + withdrawal.amount.toLocaleString() + '.00';
            document.getElementById('printBalanceAfter').textContent = '₦' + (withdrawal.balance - withdrawal.amount).toLocaleString() + '.00';
            
            document.getElementById('printProcessedBy').textContent = 'Admin User';
            document.getElementById('printNotes').textContent = notes || 'Withdrawal approved and processed successfully';
            
            // Set generated date
            const now = new Date();
            document.getElementById('printGeneratedDate').textContent = now.toLocaleString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
        }

        // Print withdrawal receipt
        function printWithdrawalReceipt(id) {
            if (id && getWithdrawalById(id)) {
                populateReceiptData(getWithdrawalById(id), getWithdrawalById(id).status);
            }
            
            // Show the receipt div temporarily
            const receiptDiv = document.getElementById('printReceipt');
            receiptDiv.style.display = 'block';
            
            // Wait a moment for rendering, then print
            setTimeout(() => {
                window.print();
                // Hide it again after printing
                receiptDiv.style.display = 'none';
            }, 100);
        }

        // Update status (for processing withdrawals)
        function updateStatus(id) {
            const withdrawal = getWithdrawalById(id);
            const newStatus = prompt('Update status to (completed/failed):', 'completed');
            
            if (newStatus) {
                console.log('Updating status for:', withdrawal.id, 'to', newStatus);
                alert('Status updated successfully!');
                // In production, reload data from server
                location.reload();
            }
        }

        // Export withdrawals
        function exportWithdrawals() {
            alert('Export functionality: In production, this would generate a CSV/Excel file with all withdrawal data');
        }

        // Helper functions
        function getStatusIcon(status) {
            const icons = {
                'pending': 'clock',
                'approved': 'check-circle',
                'rejected': 'times-circle',
                'processing': 'spinner fa-spin'
            };
            return icons[status] || 'circle';
        }

        function capitalizeFirst(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

        // Close sidebar on outside click (mobile)
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const hamburger = event.target.closest('.fa-bars');
            
            if (window.innerWidth <= 992 && 
                !sidebar.contains(event.target) && 
                !hamburger && 
                sidebar.classList.contains('active')) {
                sidebar.classList.remove('active');
            }
        });
    </script>
</body>
</html>