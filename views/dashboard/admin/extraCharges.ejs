<div class="powered-by"><strong style="color:var(--primary);">Cloudbaam</strong> · <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
let charges = <%- JSON.stringify(charges || []) %>;
let currentPage = 1;
const pageSize  = 10;
let currentData = [...charges];

const STREAM_CONFIG = [
    { key: 'loan-interest',       label: 'Loan Interest',        color: '#1e3a8a', icon: 'fa-percentage',         variant: '' },
    { key: 'loan-penalty',        label: 'Loan Penalties',       color: '#ef4444', icon: 'fa-exclamation-circle', variant: 'danger' },
    { key: 'forceful-withdrawal', label: 'Withdrawal Penalties', color: '#f59e0b', icon: 'fa-money-check-alt',    variant: 'warning' },
    { key: 'registration',        label: 'Registration Fees',    color: '#10b981', icon: 'fa-user-plus',          variant: 'success' },
    { key: 'late-payment',        label: 'Late Payment Fees',    color: '#3b82f6', icon: 'fa-clock',              variant: '' },
    { key: 'service',             label: 'Service Charges',      color: '#06b6d4', icon: 'fa-cog',                variant: 'info' },
    { key: 'other',               label: 'Other',                color: '#94a3b8', icon: 'fa-ellipsis-h',         variant: 'muted' },
];

const TYPE_BADGE_HTML = (type) => {
    const map = {
        'registration':        ['fa-user-plus',         '',        'Registration'],
        'loan-penalty':        ['fa-exclamation-circle','danger',  'Loan Penalty'],
        'loan-interest':       ['fa-percentage',        '',        'Loan Interest'],
        'forceful-withdrawal': ['fa-money-check-alt',   'warning', 'W/D Penalty'],
        'late-payment':        ['fa-clock',             '',        'Late Payment'],
        'service':             ['fa-cog',               'info',    'Service'],
        'other':               ['fa-ellipsis-h',        'muted',   'Other'],
    };
    const [icon, variant, label] = map[type] || ['fa-circle','muted', type || 'Unknown'];
    return `<span class="type-pill ${variant}"><i class="fas ${icon}" style="font-size:.65em;"></i>${label}</span>`;
};

const STATUS_BADGE_HTML = (status) => ({
    paid:    '<span class="badge-pill badge-paid"><i class="fas fa-check-circle" style="font-size:.65em;"></i>Paid</span>',
    pending: '<span class="badge-pill badge-pending"><i class="fas fa-clock" style="font-size:.65em;"></i>Pending</span>',
    waived:  '<span class="badge-pill badge-waived"><i class="fas fa-minus-circle" style="font-size:.65em;"></i>Waived</span>',
})[status] || `<span class="badge-pill badge-waived">${status}</span>`;

function fmt(n) { return '₦' + Number(n || 0).toLocaleString(); }

document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('headerDate').textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    buildKPIs(); buildStreams(); buildDonut(); buildSummaryTiles(); buildMonthBars(); buildTopMembers(); renderCharges(charges, 1);
});

function buildKPIs() {
    const paid = (type) => charges.filter(c => c.chargeType === type && c.status === 'paid').reduce((s, c) => s + c.amount, 0);
    const wdPenalty = ['forceful-withdrawal','loan-penalty'].reduce((s, t) => s + paid(t), 0);
    const other = charges.filter(c => !['loan-interest','forceful-withdrawal','loan-penalty','registration'].includes(c.chargeType) && c.status === 'paid').reduce((s, c) => s + c.amount, 0);
    const total = charges.filter(c => c.status === 'paid').reduce((s, c) => s + c.amount, 0);
    document.getElementById('heroTotal').textContent       = fmt(total);
    document.getElementById('kpiLoanInterest').textContent = fmt(paid('loan-interest'));
    document.getElementById('kpiWdPenalty').textContent    = fmt(wdPenalty);
    document.getElementById('kpiRegFees').textContent      = fmt(paid('registration'));
    document.getElementById('kpiOther').textContent        = fmt(other);
    document.getElementById('kpiLoanCount').textContent    = charges.filter(c => c.chargeType === 'loan-interest').length + ' loans';
    document.getElementById('kpiWdCount').textContent      = charges.filter(c => ['forceful-withdrawal','loan-penalty'].includes(c.chargeType)).length + ' charges';
    document.getElementById('kpiRegCount').textContent     = charges.filter(c => c.chargeType === 'registration').length + ' members';
    document.getElementById('kpiOtherCount').textContent   = charges.filter(c => !['loan-interest','forceful-withdrawal','loan-penalty','registration'].includes(c.chargeType)).length + ' items';
}

function buildStreams() {
    const total = charges.filter(c => c.status === 'paid').reduce((s, c) => s + c.amount, 0) || 1;
    const el = document.getElementById('streamsList');
    el.innerHTML = '';
    STREAM_CONFIG.forEach(stream => {
        const amt = charges.filter(c => c.chargeType === stream.key && c.status === 'paid').reduce((s, c) => s + c.amount, 0);
        if (!amt) return;
        const pct = Math.round((amt / total) * 100);
        el.insertAdjacentHTML('beforeend', `
            <div class="rev-stream">
                <div class="rev-stream-ico type-pill ${stream.variant}" style="width:40px;height:40px;border-radius:10px;flex-shrink:0;justify-content:center;">
                    <i class="fas ${stream.icon}"></i>
                </div>
                <div class="rev-stream-body">
                    <div class="rev-stream-name">${stream.label}</div>
                    <div class="rev-stream-desc">${charges.filter(c => c.chargeType === stream.key).length} records</div>
                    <div class="rev-stream-bar"><div class="rev-stream-fill" style="width:${pct}%;background:${stream.color};"></div></div>
                </div>
                <div class="rev-stream-right">
                    <div class="rev-stream-amt" style="color:${stream.color};">${fmt(amt)}</div>
                    <div class="rev-stream-pct">${pct}%</div>
                </div>
            </div>`);
    });
    if (!el.innerHTML) el.innerHTML = '<div style="text-align:center;padding:2rem;color:#9ca3af;font-size:.85rem;"><i class="fas fa-inbox d-block mb-2" style="font-size:2rem;opacity:.2;"></i>No revenue data available</div>';
}

function buildDonut() {
    const total = charges.filter(c => c.status === 'paid').reduce((s, c) => s + c.amount, 0);
    document.getElementById('donutCenter').textContent = total >= 1000000 ? '₦' + (total/1000000).toFixed(1)+'M' : total >= 1000 ? '₦'+Math.round(total/1000)+'K' : fmt(total);
    const svg = document.getElementById('donutSvg');
    const legend = document.getElementById('donutLegend');
    const C = 314; let offset = 0; const used = [];
    STREAM_CONFIG.forEach(stream => {
        const amt = charges.filter(c => c.chargeType === stream.key && c.status === 'paid').reduce((s, c) => s + c.amount, 0);
        if (!amt || !total) return;
        const arc = (amt / total) * C;
        const circle = document.createElementNS('http://www.w3.org/2000/svg','circle');
        ['cx','cy','r'].forEach((a,i)=>circle.setAttribute(a,[60,60,50][i]));
        circle.setAttribute('fill','none'); circle.setAttribute('stroke',stream.color); circle.setAttribute('stroke-width',14);
        circle.setAttribute('stroke-dasharray',`${arc} ${C}`); circle.setAttribute('stroke-dashoffset',-offset);
        circle.setAttribute('transform','rotate(-90 60 60)');
        svg.appendChild(circle); offset += arc;
        used.push({ label: stream.label, color: stream.color, pct: Math.round((amt/total)*100) });
    });
    legend.innerHTML = used.map(u => `<div class="dleg"><div class="dleg-dot" style="background:${u.color};"></div>${u.label} (${u.pct}%)</div>`).join('');
}

function buildSummaryTiles() {
    const get = (s) => charges.filter(c => c.status === s).reduce((sum, c) => sum + c.amount, 0);
    document.getElementById('sumCollected').textContent = fmt(get('paid'));
    document.getElementById('sumPending').textContent   = fmt(get('pending'));
    document.getElementById('sumWaived').textContent    = fmt(get('waived'));
    document.getElementById('sumCount').textContent     = charges.length;
}

function buildMonthBars() {
    const now = new Date();
    const months = [];
    for (let i = 5; i >= 0; i--) {
        const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        const total = charges.filter(c => { const cd = new Date(c.appliedAt); return cd.getFullYear()===d.getFullYear() && cd.getMonth()===d.getMonth() && c.status==='paid'; }).reduce((s,c)=>s+c.amount,0);
        months.push({ label: d.toLocaleDateString('en-US',{month:'short'}), total });
    }
    const max = Math.max(...months.map(m=>m.total),1);
    document.getElementById('monthBars').innerHTML = months.map(m => {
        const h = Math.max(Math.round((m.total/max)*70),4);
        return `<div class="month-bar-wrap"><div class="month-bar" style="height:${h}px;" title="${m.label}: ${fmt(m.total)}"></div></div>`;
    }).join('');
    document.getElementById('monthLabels').innerHTML = months.map(m =>
        `<div style="flex:1;text-align:center;font-size:.58rem;font-weight:700;color:#94a3b8;">${m.label}</div>`
    ).join('');
}

function buildTopMembers() {
    const map = {};
    charges.filter(c=>c.status==='paid').forEach(c=>{ if(!map[c.memberId]) map[c.memberId]={name:c.memberName,id:c.memberId,total:0}; map[c.memberId].total+=c.amount; });
    const top = Object.values(map).sort((a,b)=>b.total-a.total).slice(0,6);
    const el  = document.getElementById('topMembersList');
    if (!top.length) { el.innerHTML='<div style="text-align:center;padding:1.5rem;color:#9ca3af;font-size:.83rem;">No data available</div>'; return; }
    const medals = ['🥇','🥈','🥉'];
    el.innerHTML = top.map((m,i)=>`
        <div style="display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid rgba(30,58,138,.05);">
            <div style="font-size:.85rem;width:22px;text-align:center;">${medals[i]||(i+1)}</div>
            <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#1e3a8a,#3b82f6);display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-size:.65rem;flex-shrink:0;">${m.name.slice(0,2).toUpperCase()}</div>
            <div style="flex:1;min-width:0;">
                <div style="font-size:.82rem;font-weight:700;color:#1f2937;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${m.name}</div>
                <div style="font-size:.67rem;color:#9ca3af;">${m.id}</div>
            </div>
            <div style="font-size:.85rem;font-weight:800;color:var(--primary);">${fmt(m.total)}</div>
        </div>`).join('');
}

function renderCharges(data, page) {
    currentData = data; currentPage = page;
    const tbody = document.getElementById('chargesTableBody');
    const total = data.length; const pages = Math.ceil(total/pageSize);
    const start = (page-1)*pageSize; const slice = data.slice(start,start+pageSize);
    tbody.innerHTML = '';
    if (!slice.length) { tbody.innerHTML='<tr><td colspan="6" style="text-align:center;padding:3rem;color:#9ca3af;"><i class="fas fa-inbox d-block mb-2" style="font-size:2rem;opacity:.2;"></i>No records found</td></tr>'; updatePagination(0,0,0,0); return; }
    slice.forEach(c => {
        const date = c.appliedAt ? new Date(c.appliedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—';
        tbody.insertAdjacentHTML('beforeend', `
            <tr>
                <td style="padding-left:1.4rem;"><div style="font-weight:700;font-size:.84rem;color:#1f2937;">${c.memberName}</div><div style="font-size:.7rem;color:#9ca3af;">${c.memberId}</div></td>
                <td>${TYPE_BADGE_HTML(c.chargeType)}</td>
                <td style="font-weight:800;font-size:.88rem;color:var(--primary);">${fmt(c.amount)}</td>
                <td>${STATUS_BADGE_HTML(c.status)}</td>
                <td style="font-size:.78rem;color:#64748b;">${date}</td>
                <td style="padding-right:1.4rem;"><button class="btn btn-sm btn-outline-primary" onclick="viewCharge('${c.id}')" style="border-radius:8px;font-size:.8rem;font-weight:600;padding:.3rem .75rem;"><i class="fas fa-eye me-1"></i>View</button></td>
            </tr>`);
    });
    updatePagination(start+1, Math.min(start+pageSize,total), total, pages);
}

function updatePagination(from, to, total, pages) {
    const info = document.getElementById('paginationInfo');
    const ctrl = document.getElementById('paginationControls');
    info.textContent = total ? `Showing ${from}–${to} of ${total} records` : 'No records';
    ctrl.innerHTML = '';
    if (pages<=1) return;
    const li = (label,page,disabled,active) => ctrl.insertAdjacentHTML('beforeend',`<li class="page-item ${disabled?'disabled':''} ${active?'active':''}"><a class="page-link" href="#" onclick="goToPage(${page});return false;">${label}</a></li>`);
    li('<i class="fas fa-chevron-left"></i>',currentPage-1,currentPage===1,false);
    for(let i=1;i<=pages;i++){ if(pages>7&&i>2&&i<pages-1&&Math.abs(i-currentPage)>1){if(i===3||i===pages-2)ctrl.insertAdjacentHTML('beforeend','<li class="page-item disabled"><a class="page-link">…</a></li>');}else{li(i,i,false,i===currentPage);} }
    li('<i class="fas fa-chevron-right"></i>',currentPage+1,currentPage===pages,false);
}
function goToPage(p){ const pages=Math.ceil(currentData.length/pageSize); if(p<1||p>pages)return; renderCharges(currentData,p); }

['searchInput','statusFilter','typeFilter','dateFilter'].forEach(id => {
    document.getElementById(id).addEventListener(id==='searchInput'?'input':'change', applyFilters);
});
function applyFilters() {
    let f = [...charges];
    const srch = document.getElementById('searchInput').value.toLowerCase();
    const stat = document.getElementById('statusFilter').value;
    const type = document.getElementById('typeFilter').value;
    const dt   = document.getElementById('dateFilter').value;
    if(srch) f=f.filter(c=>(c.memberName+c.memberId+(c.reason||'')).toLowerCase().includes(srch));
    if(stat) f=f.filter(c=>c.status===stat);
    if(type) f=f.filter(c=>c.chargeType===type);
    if(dt){ const now=new Date(); f=f.filter(c=>{ const d=new Date(c.appliedAt); if(dt==='today')return d.toDateString()===now.toDateString(); if(dt==='week')return d>=new Date(now-7*86400000); if(dt==='month')return d.getMonth()===now.getMonth()&&d.getFullYear()===now.getFullYear(); if(dt==='year')return d.getFullYear()===now.getFullYear(); return true; }); }
    renderCharges(f,1);
}
function resetFilters(){ ['searchInput','statusFilter','typeFilter','dateFilter'].forEach(id=>document.getElementById(id).value=''); renderCharges(charges,1); }

function viewCharge(id) {
    const c=charges.find(x=>x.id===id); if(!c)return;
    document.getElementById('viewMember').textContent   = c.memberName;
    document.getElementById('viewMemberId').textContent = c.memberId;
    document.getElementById('viewChargeType').innerHTML = TYPE_BADGE_HTML(c.chargeType);
    document.getElementById('viewAmount').textContent   = fmt(c.amount);
    document.getElementById('viewStatus').innerHTML     = STATUS_BADGE_HTML(c.status);
    document.getElementById('viewDate').textContent     = c.appliedAt ? new Date(c.appliedAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) : '—';
    document.getElementById('viewReason').textContent   = c.reason || '—';
    new bootstrap.Modal(document.getElementById('viewChargeModal')).show();
}

function exportRevenue() {
    const rows=[['Member','Member ID','Type','Amount','Status','Date','Reason']];
    charges.forEach(c=>rows.push([c.memberName,c.memberId,c.chargeType,c.amount,c.status,c.appliedAt,c.reason||'']));
    const csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\n');
    const a=document.createElement('a'); a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);
    a.download='company-revenue-'+new Date().toISOString().slice(0,10)+'.csv'; a.click();
}

function toggleSidebar(){ document.getElementById('sidebar').classList.toggle('active'); document.getElementById('sidebarOverlay').classList.toggle('active'); }
function closeSidebar(){ document.getElementById('sidebar').classList.remove('active'); document.getElementById('sidebarOverlay').classList.remove('active'); }

async function loadSidebarPendingCount(){
    try{ const res=await fetch('/admin/pending-approvals-count'); const data=await res.json(); const badge=document.getElementById('sidebarPendingBadge'); if(!badge)return; if(data.count>0){badge.style.display='inline-block';badge.textContent=data.count;}else badge.style.display='none'; }catch(e){ console.error('Sidebar count error:',e); }
}
document.addEventListener('DOMContentLoaded',loadSidebarPendingCount);
</script>
</body>
