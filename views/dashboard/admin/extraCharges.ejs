<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Company Revenue | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --sidebar-width: 280px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
            color: #1e293b;
        }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }

        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18);
            position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box {
            width: 42px; height: 42px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0;
        }
        .sidebar-brand { font-size: .95rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .65rem; font-weight: 500; opacity: .55; display: block; letter-spacing: .08em; }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 10px; background: rgba(239,68,68,.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.3);
            font-weight: 700; font-size: .7rem; color: #fca5a5;
        }
        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }
        .nav-category {
            display: flex; align-items: center; gap: 7px;
            padding: .55rem 1.25rem .3rem;
            font-size: .62rem; font-weight: 800;
            color: rgba(255,255,255,.38);
            text-transform: uppercase; letter-spacing: .1em; user-select: none;
        }
        .nav-category::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.08); margin-left: 4px; }
        .sidebar-nav a {
            display: flex; align-items: center; gap: 11px;
            padding: .62rem 1.25rem; color: rgba(255,255,255,.72);
            text-decoration: none; font-weight: 500; font-size: .84rem;
            border-left: 3px solid transparent; transition: all .18s;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }
        .nav-badge {
            margin-left: auto; font-size: .63rem; font-weight: 800;
            padding: 2px 7px; border-radius: 10px;
            background: rgba(239,68,68,.9); color: white; flex-shrink: 0; line-height: 1.4;
        }
        .nav-back {
            display: flex; align-items: center; gap: 10px;
            padding: .7rem 1.25rem .9rem; font-size: .8rem; font-weight: 600;
            color: rgba(255,255,255,.42); text-decoration: none; transition: color .18s;
            border-top: 1px solid rgba(255,255,255,.07); margin-top: .25rem;
        }
        .nav-back:hover { color: rgba(255,255,255,.7); }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }

        /* ══════════ TOP NAVBAR ══════════ */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: 70px;
            background: rgba(255,255,255,.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            border-bottom: 1px solid rgba(30,58,138,.1); transition: all .3s;
        }
        .main-content {
            margin-left: var(--sidebar-width); margin-top: 70px;
            padding: 1.75rem; min-height: calc(100vh - 70px); transition: all .3s;
        }

        /* ══════════ PAGE HEADER ══════════ */
        .page-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30,58,138,.25); position: relative; overflow: hidden;
        }
        .page-header::before {
            content: ''; position: absolute; top: -50%; right: -15%;
            width: 380px; height: 380px; background: rgba(255,255,255,.05); border-radius: 50%;
        }
        .page-header::after {
            content: ''; position: absolute; bottom: -60%; left: -5%;
            width: 240px; height: 240px; background: rgba(255,255,255,.04); border-radius: 50%;
        }

        /* ══════════ KPI CARDS ══════════ */
        .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; margin-bottom: 1.5rem; }
        .kpi-card {
            background: white; border-radius: 16px; padding: 1.4rem;
            box-shadow: 0 4px 20px rgba(30,58,138,.08); transition: transform .26s, box-shadow .26s;
            border: 1px solid rgba(30,58,138,.05);
        }
        .kpi-card:hover { transform: translateY(-5px); box-shadow: 0 12px 32px rgba(30,58,138,.14); }
        .kpi-icon { width: 50px; height: 50px; border-radius: 13px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: .875rem; }
        .kpi-label { font-size: .68rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .25rem; }
        .kpi-value { font-size: 1.4rem; font-weight: 900; color: #0f172a; line-height: 1.15; margin-bottom: .35rem; }
        .kpi-sub { display: inline-flex; align-items: center; gap: 4px; font-size: .7rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; }
        .kpi-sub.up      { color: #059669; background: rgba(16,185,129,.1); }
        .kpi-sub.down    { color: #dc2626; background: rgba(239,68,68,.1); }
        .kpi-sub.neutral { color: #64748b; background: rgba(100,116,139,.1); }
        .kpi-sub.blue    { color: var(--primary); background: rgba(30,58,138,.1); }

        /* ══════════ SECTION CARDS ══════════ */
        .s-card { background: white; border-radius: 18px; box-shadow: 0 4px 20px rgba(30,58,138,.08); overflow: hidden; border: 1px solid rgba(30,58,138,.05); }
        .s-head {
            padding: 1rem 1.4rem; border-bottom: 1px solid rgba(30,58,138,.07);
            display: flex; align-items: center; justify-content: space-between; gap: .75rem;
            background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%);
        }
        .s-head-title { font-size: .9rem; font-weight: 800; color: var(--primary); display: flex; align-items: center; gap: 9px; }
        .s-head-icon { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: .82rem; }
        .s-body { padding: 1.25rem 1.4rem; }

        /* ══════════ REVENUE STREAMS ══════════ */
        .rev-stream { display: flex; align-items: center; gap: .875rem; padding: .875rem 0; border-bottom: 1px solid rgba(30,58,138,.05); }
        .rev-stream:last-child { border-bottom: none; }
        .rev-stream-ico { width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: .9rem; }
        .rev-stream-body { flex: 1; min-width: 0; }
        .rev-stream-name { font-size: .85rem; font-weight: 700; color: #1f2937; }
        .rev-stream-desc { font-size: .72rem; color: #9ca3af; margin-top: 2px; }
        .rev-stream-bar  { margin-top: .4rem; height: 4px; background: rgba(30,58,138,.07); border-radius: 3px; }
        .rev-stream-fill { height: 100%; border-radius: 3px; }
        .rev-stream-right { text-align: right; flex-shrink: 0; }
        .rev-stream-amt  { font-size: .95rem; font-weight: 800; }
        .rev-stream-pct  { font-size: .7rem; font-weight: 700; color: #94a3b8; margin-top: 2px; }

        /* ══════════ CHARGE TABLE ══════════ */
        .charge-table { width: 100%; border-collapse: collapse; }
        .charge-table th {
            font-size: .69rem; font-weight: 800; color: #94a3b8;
            text-transform: uppercase; letter-spacing: .07em; padding: .6rem 1rem; border: none;
            background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%);
        }
        .charge-table td { font-size: .83rem; padding: .85rem 1rem; border-bottom: 1px solid rgba(30,58,138,.05); vertical-align: middle; }
        .charge-table tbody tr:last-child td { border-bottom: none; }
        .charge-table tbody tr:hover td { background: rgba(30,58,138,.02); }

        /* ══════════ BADGES ══════════ */
        .badge-pill { padding: .3rem .75rem; border-radius: 20px; font-size: .72rem; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; }
        .badge-paid    { background: rgba(16,185,129,.1);  color: #059669; border: 1px solid rgba(16,185,129,.25); }
        .badge-pending { background: rgba(245,158,11,.1);  color: #d97706; border: 1px solid rgba(245,158,11,.25); }
        .badge-waived  { background: rgba(100,116,139,.1); color: #475569; border: 1px solid rgba(100,116,139,.2); }
        .type-pill { padding: .28rem .7rem; border-radius: 7px; font-size: .71rem; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; background: rgba(30,58,138,.08); color: var(--primary); border: 1px solid rgba(30,58,138,.15); }
        .type-pill.danger  { background: rgba(239,68,68,.08);  color: #dc2626; border-color: rgba(239,68,68,.2); }
        .type-pill.warning { background: rgba(245,158,11,.08); color: #b45309; border-color: rgba(245,158,11,.2); }
        .type-pill.success { background: rgba(16,185,129,.08); color: #059669; border-color: rgba(16,185,129,.2); }
        .type-pill.info    { background: rgba(6,182,212,.08);  color: #0891b2; border-color: rgba(6,182,212,.2); }
        .type-pill.muted   { background: rgba(100,116,139,.08);color: #475569; border-color: rgba(100,116,139,.2); }

        /* ══════════ FILTER BAR ══════════ */
        .filter-bar {
            background: rgba(30,58,138,.02); border-bottom: 1px solid rgba(30,58,138,.07);
            padding: 1rem 1.4rem; display: flex; align-items: flex-end; gap: .875rem; flex-wrap: wrap;
        }
        .filter-bar .form-label { font-weight: 700; color: var(--primary); font-size: .75rem; margin-bottom: .35rem; }
        .filter-bar .form-control,
        .filter-bar .form-select { border-radius: 9px; border: 1.5px solid rgba(30,58,138,.12); padding: .5rem .875rem; font-size: .82rem; }
        .filter-bar .form-control:focus,
        .filter-bar .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 .2rem rgba(30,58,138,.1); }

        /* ══════════ LAYOUT ══════════ */
        .layout-two { display: grid; grid-template-columns: 1.55fr 1fr; gap: 1.25rem; margin-bottom: 1.5rem; align-items: start; }

        /* ══════════ DONUT ══════════ */
        .donut-legend { display: flex; flex-wrap: wrap; gap: .4rem .875rem; margin-top: .75rem; justify-content: center; }
        .dleg { display: flex; align-items: center; gap: 6px; font-size: .72rem; font-weight: 600; color: #475569; }
        .dleg-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

        /* ══════════ SUMMARY TILES ══════════ */
        .summary-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin-bottom: 1rem; }
        .sum-tile { padding: .9rem 1rem; border-radius: 11px; text-align: center; }
        .sum-tile-label { font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .2rem; }
        .sum-tile-value { font-size: 1rem; font-weight: 900; }

        /* ══════════ MONTH BARS ══════════ */
        .month-bars { display: flex; align-items: flex-end; gap: .35rem; height: 80px; margin-bottom: .5rem; }
        .month-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; }
        .month-bar { width: 100%; border-radius: 4px 4px 0 0; background: linear-gradient(180deg, #3b82f6, #1e3a8a); opacity: .7; transition: opacity .2s; min-height: 4px; }
        .month-bar:hover { opacity: 1; }

        /* ══════════ PAGINATION ══════════ */
        .page-link { color: var(--primary); border-radius: 8px; margin: 0 .2rem; border: 1.5px solid rgba(30,58,138,.12); font-size: .82rem; }
        .page-link:hover { background: var(--primary); color: white; border-color: var(--primary); }
        .page-item.active .page-link { background: var(--primary); border-color: var(--primary); }

        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,.15); font-size: .8rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        @media (max-width: 1200px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } .layout-two { grid-template-columns: 1fr; } }
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
        }
        @media (max-width: 640px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); gap: .65rem; } .main-content { padding: .75rem; } .page-header { padding: 1.25rem; border-radius: 16px; } }
    </style>
</head>
<body>

<!-- ════════════════════════ SIDEBAR ════════════════════════ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-row">
            <div class="logo-box">C</div>
            <div><div class="sidebar-brand">Club De Stars<small>Admin Panel</small></div></div>
        </div>
        <div class="role-pill">
            <i class="fas fa-shield-alt" style="font-size:.65rem;"></i>&nbsp;<%= admin.role?.name?.toUpperCase() || 'SUPER ADMIN' %>
        </div>
    </div>

    <div class="sidebar-nav">
        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-home" style="font-size:.6rem;"></i>Main</div>
            <a href="/admin/dashboard"><i class="fas fa-chart-pie"></i>Overview</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-users" style="font-size:.6rem;"></i>Members</div>
            <a href="/admin/manage-members"><i class="fas fa-users"></i>Manage Members</a>
            <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i>Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i>Membership Types</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-exchange-alt" style="font-size:.6rem;"></i>Transactions</div>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i>Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i>Approvals<span id="sidebarPendingBadge" class="nav-badge" style="display:none;">0</span></a>
            <a href="/admin/manage-deposit"><i class="fas fa-coins"></i>Deposits</a>
            <a href="/admin/kiddies-deposits"><i class="fas fa-piggy-bank"></i>Kiddies Deposits</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i>Withdrawals</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-hand-holding-usd" style="font-size:.6rem;"></i>Loans</div>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i>Loan Management</a>
            <a href="/admin/loan-payments"><i class="fas fa-file-invoice-dollar"></i>Loan Payments</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i>Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i>External Loans</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-landmark" style="font-size:.6rem;"></i>Finance</div>
            <a href="/admin/finance"><i class="fas fa-landmark"></i>Company Finance</a>
            <a href="/admin/operating-earnings"><i class="fas fa-chart-line"></i>Operating Earnings</a>
            <a href="/admin/manage-extra-charges" class="active"><i class="fas fa-chart-bar"></i>Company Revenue</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-cog" style="font-size:.6rem;"></i>System</div>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i>Manage Subscriptions</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i>Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i>Settings</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-file-alt" style="font-size:.6rem;"></i>Reporting</div>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i>Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i>Admin Logs</a>
        </div>
    </div>

    <a href="/cds-cooperative/dashboard" class="nav-back"><i class="fas fa-arrow-left"></i>Back to Dashboard</a>
</div>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- Top Navbar -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;" onclick="toggleSidebar()"></i>
    <div class="flex-grow-1 d-none d-lg-block">
        <h5 class="mb-0 fw-bold" style="color:var(--primary)">Company Revenue</h5>
        <small class="text-muted">All income streams — charges, interest, fees and penalties</small>
    </div>
    <div class="d-lg-none fw-bold" style="color:var(--primary);font-size:.95rem;">Company Revenue</div>
    <button class="btn btn-sm btn-outline-primary ms-auto" onclick="location.reload()" style="border-radius:8px;font-weight:700;font-size:.78rem;">
        <i class="fas fa-sync-alt me-1"></i><span class="d-none d-sm-inline">Refresh</span>
    </button>
</div>

<!-- Main Content -->
<div class="main-content">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-md-7">
                <div style="display:inline-flex;align-items:center;gap:8px;padding:5px 13px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.22);border-radius:20px;font-size:.75rem;font-weight:600;margin-bottom:.875rem;">
                    <i class="fas fa-calendar-alt" style="font-size:.8rem;"></i><span id="headerDate"></span>
                </div>
                <h2 class="mb-2 fw-bold"><i class="fas fa-chart-bar me-3"></i>Company Revenue</h2>
                <p class="mb-0 opacity-90">Total earnings across all revenue streams — interest, penalties, fees &amp; charges</p>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                <div style="display:inline-block;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.22);border-radius:14px;padding:.75rem 1.5rem;text-align:center;">
                    <div style="font-size:.67rem;font-weight:800;opacity:.7;text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px;">Total Revenue Collected</div>
                    <div style="font-size:2rem;font-weight:900;" id="heroTotal">₦0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI GRID -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(30,58,138,.1);color:var(--primary);"><i class="fas fa-percentage"></i></div>
            <div class="kpi-label">Loan Interest</div>
            <div class="kpi-value" id="kpiLoanInterest">₦0</div>
            <div class="kpi-sub blue"><i class="fas fa-hand-holding-usd"></i><span id="kpiLoanCount">0 loans</span></div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(239,68,68,.1);color:#dc2626;"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="kpi-label">Withdrawal Penalties</div>
            <div class="kpi-value" id="kpiWdPenalty">₦0</div>
            <div class="kpi-sub down"><i class="fas fa-money-check-alt"></i><span id="kpiWdCount">0 charges</span></div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(16,185,129,.1);color:#059669;"><i class="fas fa-user-plus"></i></div>
            <div class="kpi-label">Registration Fees</div>
            <div class="kpi-value" id="kpiRegFees">₦0</div>
            <div class="kpi-sub up"><i class="fas fa-users"></i><span id="kpiRegCount">0 members</span></div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(245,158,11,.1);color:#d97706;"><i class="fas fa-coins"></i></div>
