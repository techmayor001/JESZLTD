    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
/* ============================
   DATA FROM BACKEND
============================ */
let charges = <%- JSON.stringify(charges || []) %>;
let currentChargeId = null;

/* ============================
   PAGINATION STATE
============================ */
let currentPage = 1;
const pageSize = 10;
let currentData = [...charges];

/* ============================
   INIT
============================ */
document.addEventListener('DOMContentLoaded', () => {
    updateStats();
    renderCharges(currentData, currentPage);
});

/* ============================
   STATS (EXTRA CHARGES ONLY)
============================ */
function updateStats() {
    const totalCollected = charges
        .filter(c => c.status === 'paid')
        .reduce((sum, c) => sum + c.amount, 0);

    const pendingAmount = charges
        .filter(c => c.status === 'pending')
        .reduce((sum, c) => sum + c.amount, 0);

    const totalChargeCount = charges.length;

    const lastCharge = charges
        .slice()
        .sort((a, b) => new Date(b.appliedAt) - new Date(a.appliedAt))[0];

    document.getElementById('totalCollected').textContent =
        `₦${totalCollected.toLocaleString()}`;

    document.getElementById('pendingAmount').textContent =
        `₦${pendingAmount.toLocaleString()}`;

    document.getElementById('totalChargeCount').textContent =
        totalChargeCount;

    document.getElementById('lastChargeDate').textContent =
        lastCharge
            ? new Date(lastCharge.appliedAt).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric'
              })
            : '—';
}

/* ============================
   RENDER TABLE + PAGINATION
============================ */
function renderCharges(data = currentData, page = 1) {
    currentData = data;
    currentPage = page;

    const tbody = document.getElementById('chargesTableBody');
    tbody.innerHTML = '';

    const totalItems = data.length;
    const totalPages = Math.ceil(totalItems / pageSize);
    const start = (page - 1) * pageSize;
    const end = start + pageSize;
    const pageData = data.slice(start, end);

    if (pageData.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                    No charges found
                </td>
            </tr>`;
        updatePagination(0, 0, 0);
        return;
    }

    pageData.forEach(charge => {
        // Status badge
        const statusBadge = {
            paid: '<span class="badge bg-success">Paid</span>',
            pending: '<span class="badge bg-warning">Pending</span>',
        }[charge.status] || '<span class="badge bg-secondary">Unknown</span>';

        // Charge type badge
        const chargeTypeBadge = {
            registration: '<span class="badge bg-primary">Registration</span>',
            'loan-penalty': '<span class="badge bg-danger">Loan Penalty</span>',
            'forceful-withdrawal': '<span class="badge bg-warning">Forceful Withdrawal</span>',
            'late-payment': '<span class="badge bg-orange">Late Payment</span>',
            service: '<span class="badge bg-purple">Service</span>',
            other: '<span class="badge bg-secondary">Other</span>',
        }[charge.chargeType?.trim()] || '<span class="badge bg-secondary">Unknown</span>';

        tbody.insertAdjacentHTML('beforeend', `
            <tr>
                <td>
                    <strong>${charge.memberName}</strong><br>
                    <small class="text-muted">${charge.memberId}</small>
                </td>
                <td>${chargeTypeBadge}</td>
                <td><strong>₦${charge.amount.toLocaleString()}</strong></td>
                <td>${statusBadge}</td>
                <td>
                    <button class="btn btn-sm btn-primary" onclick="viewCharge('${charge.id}')">
                        <i class="fas fa-eye"></i>
                    </button>
                </td>
            </tr>
        `);
    });

    updatePagination(
        start + 1,
        Math.min(end, totalItems),
        totalItems,
        totalPages
    );
}

/* ============================
   PAGINATION UI
============================ */
function updatePagination(from, to, total, totalPages = 1) {
    const info = document.getElementById('paginationInfo');
    const controls = document.getElementById('paginationControls');

    info.textContent = total
        ? `Showing ${from}-${to} of ${total} charges`
        : 'Showing 0 charges';

    controls.innerHTML = '';
    if (totalPages <= 1) return;

    // Previous
    controls.insertAdjacentHTML('beforeend', `
        <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="goToPage(${currentPage - 1})">
                <i class="fas fa-chevron-left"></i>
            </a>
        </li>
    `);

    // Page numbers
    for (let i = 1; i <= totalPages; i++) {
        controls.insertAdjacentHTML('beforeend', `
            <li class="page-item ${i === currentPage ? 'active' : ''}">
                <a class="page-link" href="#" onclick="goToPage(${i})">${i}</a>
            </li>
        `);
    }

    // Next
    controls.insertAdjacentHTML('beforeend', `
        <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="goToPage(${currentPage + 1})">
                <i class="fas fa-chevron-right"></i>
            </a>
        </li>
    `);
}

function goToPage(page) {
    const totalPages = Math.ceil(currentData.length / pageSize);
    if (page < 1 || page > totalPages) return;
    renderCharges(currentData, page);
}

/* ============================
   VIEW MODAL
============================ */
function viewCharge(id) {
    const charge = charges.find(c => c.id === id);
    if (!charge) return;

    document.getElementById('viewMember').textContent =
        `${charge.memberName} (${charge.memberId})`;

    document.getElementById('viewChargeType').textContent =
        charge.chargeType?.replace('-', ' ').toUpperCase() || 'UNKNOWN';

    document.getElementById('viewAmount').textContent =
        `₦${charge.amount.toLocaleString()}`;

    document.getElementById('viewStatus').innerHTML = {
        paid: '<span class="badge bg-success">Paid</span>',
        pending: '<span class="badge bg-warning">Pending</span>',
    }[charge.status] || '<span class="badge bg-secondary">Unknown</span>';

    document.getElementById('viewDate').textContent = charge.appliedAt;
    document.getElementById('viewReason').textContent = charge.reason || '—';

    openModal('viewChargeModal');
}

/* ============================
   FILTERS
============================ */
document.getElementById('searchInput').addEventListener('input', applyFilters);
document.getElementById('statusFilter').addEventListener('change', applyFilters);
document.getElementById('typeFilter').addEventListener('change', applyFilters);
document.getElementById('dateFilter').addEventListener('change', applyFilters);

function applyFilters() {
    let filtered = [...charges];

    const search = document.getElementById('searchInput').value.toLowerCase();
    const status = document.getElementById('statusFilter').value;
    const type = document.getElementById('typeFilter').value;
    const dateRange = document.getElementById('dateFilter').value;

    if (search) {
        filtered = filtered.filter(c =>
            c.memberName.toLowerCase().includes(search) ||
            c.memberId.toLowerCase().includes(search) ||
            (c.reason || '').toLowerCase().includes(search)
        );
    }

    if (status) filtered = filtered.filter(c => c.status === status);
    if (type) filtered = filtered.filter(c => c.chargeType === type);

    if (dateRange) {
        const now = new Date();
        filtered = filtered.filter(c => {
            const d = new Date(c.appliedAt);
            if (dateRange === 'today') return d.toDateString() === now.toDateString();
            if (dateRange === 'week') return d >= new Date(now - 7 * 86400000);
            if (dateRange === 'month') return d.getMonth() === now.getMonth();
            if (dateRange === 'year') return d.getFullYear() === now.getFullYear();
            return true;
        });
    }

    currentPage = 1;
    renderCharges(filtered, 1);
}

/* ============================
   MODAL HELPER
============================ */
function openModal(id) {
    new bootstrap.Modal(document.getElementById(id)).show();
}
</script>



