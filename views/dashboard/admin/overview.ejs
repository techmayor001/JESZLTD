<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Overview | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary:       #1e3a8a;
            --primary-mid:   #1e40af;
            --primary-light: #3b82f6;
            --success:       #10b981;
            --danger:        #ef4444;
            --warning:       #f59e0b;
            --purple:        #8b5cf6;
            --cyan:          #06b6d4;
            --pink:          #ec4899;
            --sidebar-w:     280px;
            --nav-h:         70px;
            --radius-lg:     20px;
            --radius-md:     14px;
            --radius-sm:     10px;
            --shadow-card:   0 4px 20px rgba(30,58,138,.08);
            --shadow-hover:  0 12px 32px rgba(30,58,138,.16);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f0f4ff;
            min-height: 100vh;
            overflow-x: hidden;
            color: #1e293b;
        }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-w);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 55%, #3b82f6 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.18);
            scrollbar-width: none;
        }
        .sidebar::-webkit-scrollbar { display: none; }
        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
            background: rgba(0,0,0,.12);
        }
        .logo-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
        .logo-box {
            width: 44px; height: 44px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.4rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.2); flex-shrink: 0;
        }
        .sidebar-brand { font-size: 1rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .68rem; font-weight: 500; opacity: .65; display: block; letter-spacing: .08em; }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 5px 11px; background: rgba(239,68,68,.22);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.35);
            font-weight: 700; font-size: .73rem; color: #fca5a5;
        }
        .sidebar-nav { padding: .75rem 0 2rem; }
        .sidebar-nav a {
            display: flex; align-items: center; gap: 12px;
            padding: .78rem 1.5rem; color: rgba(255,255,255,.8);
            text-decoration: none; font-weight: 500; font-size: .88rem;
            border-left: 3px solid transparent; transition: all .2s;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.1); color: white; border-left-color: rgba(255,255,255,.5); }
        .sidebar-nav a.active { background: rgba(255,255,255,.16); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 20px; font-size: 1rem; flex-shrink: 0; opacity: .9; }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.show { display: block; }

        /* ══════════ TOP NAVBAR ══════════ */
        .topbar {
            position: fixed; top: 0;
            left: var(--sidebar-w); right: 0;
            height: var(--nav-h);
            background: rgba(255,255,255,.97);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(30,58,138,.09);
            box-shadow: 0 2px 16px rgba(30,58,138,.07);
            z-index: 1030;
            display: flex; align-items: center;
            padding: 0 1.75rem; gap: 1rem;
        }
        .topbar-title { font-weight: 800; font-size: 1.05rem; color: var(--primary); }
        .topbar-sub   { font-size: .75rem; color: #94a3b8; margin-top: 1px; }

        /* ══════════ MAIN CONTENT ══════════ */
        .main {
            margin-left: var(--sidebar-w);
            margin-top: var(--nav-h);
            padding: 1.75rem;
            min-height: calc(100vh - var(--nav-h));
        }

        /* ══════════ HERO BANNER ══════════ */
        .hero {
            background: linear-gradient(130deg, #1e3a8a 0%, #1e40af 45%, #3b82f6 100%);
            border-radius: var(--radius-lg);
            padding: 1.875rem 2.25rem;
            color: white;
            position: relative; overflow: hidden;
            margin-bottom: 1.5rem;
            box-shadow: 0 10px 36px rgba(30,58,138,.28);
        }
        .hero::before {
            content: '';
            position: absolute; top: -70px; right: -50px;
            width: 260px; height: 260px;
            background: rgba(255,255,255,.07); border-radius: 50%;
            pointer-events: none;
        }
        .hero::after {
            content: '';
            position: absolute; bottom: -90px; right: 160px;
            width: 180px; height: 180px;
            background: rgba(255,255,255,.04); border-radius: 50%;
            pointer-events: none;
        }
        .hero-inner { position: relative; z-index: 1; }
        .hero-date-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 5px 13px; background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.22); border-radius: 20px;
            font-size: .75rem; font-weight: 600; margin-bottom: .875rem;
        }
        .hero h3 { font-weight: 800; font-size: 1.45rem; margin-bottom: .3rem; }
        .hero p  { font-size: .88rem; opacity: .82; margin: 0; }
        .hero-stats {
            display: flex; flex-direction: column; align-items: flex-end; gap: .6rem;
        }
        .hero-portfolio {
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.22);
            border-radius: 12px;
            padding: .65rem 1.4rem;
            text-align: center;
        }
        .hero-portfolio small { display: block; font-size: .67rem; opacity: .7; text-transform: uppercase; letter-spacing: .07em; margin-bottom: 2px; }
        .hero-portfolio strong { font-size: 1.4rem; font-weight: 800; }
        .hero-badges { display: flex; gap: .5rem; flex-wrap: wrap; justify-content: flex-end; }
        .hero-badge {
            padding: .35rem .9rem; border-radius: 8px;
            font-size: .73rem; font-weight: 700;
        }

        /* ══════════ FILTER BAR ══════════ */
        .filter-bar {
            background: white;
            border-radius: var(--radius-md);
            padding: .875rem 1.25rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-card);
            display: flex; align-items: center; gap: .6rem; flex-wrap: wrap;
        }
        .filter-label {
            font-size: .72rem; font-weight: 800; color: #94a3b8;
            text-transform: uppercase; letter-spacing: .07em; flex-shrink: 0;
            display: flex; align-items: center; gap: 6px;
        }
        .period-btn {
            padding: .38rem .9rem; border-radius: 7px; font-size: .78rem; font-weight: 600;
            cursor: pointer; transition: all .18s;
            background: transparent; border: 1.5px solid rgba(30,58,138,.13); color: #64748b;
            white-space: nowrap;
        }
        .period-btn:hover  { background: rgba(30,58,138,.06); border-color: rgba(30,58,138,.28); color: var(--primary); }
        .period-btn.active { background: var(--primary); color: white; border-color: var(--primary); }
        .filter-divider { width: 1px; height: 22px; background: rgba(30,58,138,.11); flex-shrink: 0; }
        .custom-range { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
        .custom-range label { font-size: .72rem; font-weight: 700; color: #94a3b8; flex-shrink: 0; }
        .date-input {
            padding: .36rem .7rem; border-radius: 7px; font-size: .78rem; font-weight: 500;
            border: 1.5px solid rgba(30,58,138,.13); color: #374151; background: white;
            cursor: pointer; transition: border-color .15s;
        }
        .date-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(30,58,138,.1); }
        .btn-apply {
            padding: .38rem .9rem; border-radius: 7px; font-size: .78rem; font-weight: 700;
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            color: white; border: none; cursor: pointer; transition: all .18s;
            white-space: nowrap;
        }
        .btn-apply:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(30,58,138,.3); }
        .period-pill {
            margin-left: auto; display: inline-flex; align-items: center; gap: 6px;
            padding: 5px 12px; background: rgba(30,58,138,.07);
            border-radius: 20px; font-size: .75rem; font-weight: 700; color: var(--primary);
            border: 1px solid rgba(30,58,138,.13); white-space: nowrap;
        }

        /* ══════════ KPI GRID (8 cards, 4 per row on desktop) ══════════ */
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.1rem;
            margin-bottom: 1.1rem;
        }
        .kpi-card {
            background: white;
            border-radius: var(--radius-md);
            padding: 1.35rem 1.4rem;
            box-shadow: var(--shadow-card);
            transition: transform .26s, box-shadow .26s;
            display: flex; flex-direction: column; gap: .3rem;
        }
        .kpi-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
        .kpi-icon {
            width: 44px; height: 44px; border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem; margin-bottom: .5rem; flex-shrink: 0;
        }
        .kpi-label { font-size: .68rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: .07em; }
        .kpi-value { font-size: 1.35rem; font-weight: 900; color: #0f172a; line-height: 1.15; }
        .kpi-sub   { display: inline-flex; align-items: center; gap: 4px; font-size: .7rem; font-weight: 700; padding: 3px 7px; border-radius: 6px; width: fit-content; }
        .kpi-sub.up      { color: #059669; background: rgba(16,185,129,.1); }
        .kpi-sub.down    { color: #dc2626; background: rgba(239,68,68,.1); }
        .kpi-sub.neutral { color: #64748b; background: rgba(100,116,139,.1); }

        /* ══════════ SECTION CARD ══════════ */
        .s-card {
            background: white;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            overflow: hidden;
        }
        .s-head {
            padding: 1rem 1.4rem;
            border-bottom: 1px solid rgba(30,58,138,.07);
            display: flex; align-items: center; justify-content: space-between;
            gap: .75rem;
        }
        .s-head-title {
            font-size: .88rem; font-weight: 800; color: var(--primary);
            display: flex; align-items: center; gap: 8px;
        }
        .s-head-icon {
            width: 28px; height: 28px; border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            font-size: .8rem;
        }
        .s-body { padding: 1.25rem 1.4rem; }

        /* ══════════ METRIC ROW ══════════ */
        .mrow {
            display: flex; align-items: center; justify-content: space-between;
            padding: .6rem .4rem; border-radius: 8px; transition: background .15s;
        }
        .mrow:hover { background: rgba(30,58,138,.03); }
        .mrow-left { display: flex; align-items: center; gap: .6rem; }
        .mdot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        .mrow-label { font-size: .82rem; font-weight: 600; color: #374151; }
        .mrow-sub   { font-size: .68rem; color: #9ca3af; }
        .mrow-val   { font-size: .88rem; font-weight: 800; color: #0f172a; }

        /* ══════════ PROGRESS ══════════ */
        .prog-track { height: 5px; background: rgba(30,58,138,.08); border-radius: 3px; overflow: hidden; margin-top: .35rem; }
        .prog-fill  { height: 100%; border-radius: 3px; }

        /* ══════════ REVENUE ITEMS ══════════ */
        .rev-row {
            display: flex; align-items: center; gap: .7rem;
            padding: .55rem 0; border-bottom: 1px solid rgba(30,58,138,.05);
        }
        .rev-row:last-child { border-bottom: none; }
        .rev-dot  { width: 9px; height: 9px; border-radius: 3px; flex-shrink: 0; }
        .rev-name { flex: 1; font-size: .8rem; font-weight: 600; color: #475569; }
        .rev-pct  { font-size: .7rem; font-weight: 700; color: #94a3b8; min-width: 30px; text-align: right; }
        .rev-amt  { font-size: .82rem; font-weight: 800; min-width: 85px; text-align: right; }

        /* coloured progress bar strip at bottom of revenue card */
        .rev-strip { display: flex; height: 4px; border-radius: 0 0 var(--radius-lg) var(--radius-lg); overflow: hidden; }
        .rev-strip-seg { height: 100%; }

        /* ══════════ QUICK LINKS ══════════ */
        .qlink {
            display: flex; align-items: center; gap: .875rem;
            padding: .72rem .75rem; border-radius: 10px;
            text-decoration: none; color: inherit;
            transition: all .18s; margin-bottom: .45rem;
        }
        .qlink:last-child { margin-bottom: 0; }
        .qlink:hover { background: rgba(30,58,138,.04); transform: translateX(3px); }
        .qlink-ico { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: .9rem; flex-shrink: 0; }
        .qlink-title { font-size: .83rem; font-weight: 700; color: var(--primary); }
        .qlink-desc  { font-size: .7rem; color: #9ca3af; }
        .qlink-badge { font-size: .68rem; font-weight: 700; padding: 2px 7px; border-radius: 5px; margin-left: auto; flex-shrink: 0; }
        .qlink-arrow { font-size: .65rem; color: #cbd5e1; flex-shrink: 0; }

        /* ══════════ ACTIVITY FEED ══════════ */
        .act-row {
            display: flex; align-items: center; gap: .875rem;
            padding: .75rem 0; border-bottom: 1px solid rgba(30,58,138,.05);
        }
        .act-row:last-child { border-bottom: none; padding-bottom: 0; }
        .act-ico { width: 35px; height: 35px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: .84rem; flex-shrink: 0; }
        .act-body { flex: 1; min-width: 0; }
        .act-name  { font-size: .83rem; font-weight: 700; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .act-meta  { font-size: .7rem; color: #9ca3af; margin-top: 2px; display: flex; align-items: center; gap: .35rem; flex-wrap: wrap; }
        .act-status-tag { padding: 1px 6px; border-radius: 4px; font-size: .66rem; font-weight: 700; }
        .act-amt { font-size: .88rem; font-weight: 800; flex-shrink: 0; }

        /* ══════════ MINI TABLE ══════════ */
        .mtable { width: 100%; border-collapse: collapse; }
        .mtable th { font-size: .69rem; font-weight: 800; color: #9ca3af; text-transform: uppercase; letter-spacing: .07em; padding: .45rem .75rem; border: none; }
        .mtable td { font-size: .82rem; padding: .65rem .75rem; border-bottom: 1px solid rgba(30,58,138,.05); vertical-align: middle; }
        .mtable tbody tr:last-child td { border-bottom: none; }
        .mtable tbody tr:hover td { background: rgba(30,58,138,.025); }
        .m-ava { width: 29px; height: 29px; border-radius: 50%; background: linear-gradient(135deg, #1e3a8a, #3b82f6); display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: .63rem; flex-shrink: 0; }

        /* ══════════ FINANCE GRID (2×2) ══════════ */
        .fin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
        .fin-tile {
            padding: .875rem;
            border-radius: 10px;
            text-align: center;
        }
        .fin-tile-label { font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .2rem; }
        .fin-tile-value { font-size: .95rem; font-weight: 900; }

        /* ══════════ MEMBER DONUT ══════════ */
        .donut-wrap { display: flex; flex-direction: column; align-items: center; margin-bottom: .75rem; }
        .donut-legend { display: flex; flex-wrap: wrap; gap: .4rem .7rem; justify-content: center; margin-top: .5rem; }
        .dleg { display: flex; align-items: center; gap: 5px; font-size: .7rem; font-weight: 600; color: #475569; }
        .dleg-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

        /* ══════════ LAYOUT SECTIONS ══════════ */

        /* Row A: Member (narrow) + Loan (narrow) + Revenue (wide) + Quick Actions (wide) */
        .layout-a {
            display: grid;
            grid-template-columns: 1fr 1fr 1.15fr 1.15fr;
            gap: 1.1rem;
            margin-bottom: 1.5rem;
            align-items: start;
        }

        /* Row B: Transactions (wide) + [ Finance Grid top + Top Members below ] */
        .layout-b {
            display: grid;
            grid-template-columns: 1.55fr 1fr;
            gap: 1.1rem;
            align-items: start;
        }

        /* ══════════ POWERED BY ══════════ */
        .powered-by {
            position: fixed; bottom: 14px; right: 14px;
            background: white; padding: 8px 15px; border-radius: 22px;
            box-shadow: 0 4px 14px rgba(30,58,138,.14);
            font-size: .75rem; font-weight: 700; color: var(--primary); z-index: 999;
        }

        /* ══════════ ANIMATIONS ══════════ */
        @keyframes riseIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
        .r1 { animation: riseIn .42s .00s both; }
        .r2 { animation: riseIn .42s .07s both; }
        .r3 { animation: riseIn .42s .14s both; }
        .r4 { animation: riseIn .42s .21s both; }
        .r5 { animation: riseIn .42s .28s both; }

        /* ══════════ RESPONSIVE ══════════ */
        @media (max-width: 1280px) {
            .layout-a { grid-template-columns: 1fr 1fr; }
            .layout-b { grid-template-columns: 1fr; }
        }

        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .topbar  { left: 0; }
            .main    { margin-left: 0; padding: 1.1rem; }
            .kpi-row { grid-template-columns: repeat(2, 1fr); }
            .layout-a { grid-template-columns: 1fr 1fr; }
            .layout-b { grid-template-columns: 1fr; }
        }

        @media (max-width: 640px) {
            :root { --nav-h: 58px; }
            .main { padding: .75rem; }
            .kpi-row { grid-template-columns: repeat(2, 1fr); gap: .65rem; }
            .kpi-value { font-size: 1.15rem; }
            .hero { padding: 1.25rem 1.3rem; border-radius: 16px; }
            .filter-bar { gap: .45rem; }
            .period-btn { padding: .32rem .7rem; font-size: .74rem; }
            .layout-a { grid-template-columns: 1fr; }
            .hero-stats { align-items: flex-start; }
            .hero-badges { justify-content: flex-start; }
            .fin-grid { grid-template-columns: 1fr 1fr; }
        }

        @media (max-width: 400px) {
            .kpi-row { grid-template-columns: 1fr 1fr; gap: .5rem; }
            .kpi-card { padding: 1rem; }
        }
    </style>
</head>
