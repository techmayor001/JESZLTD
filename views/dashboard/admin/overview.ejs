        <a href="/cds-cooperative/dashboard" style="color:rgba(255,255,255,.5);margin-top:.5rem;"><i class="fas fa-sign-in-alt"></i>Back to Dashboard</a>
    </div>
</div>
<div class="sidebar-overlay" id="overlay" onclick="closeSidebar()"></div>

<!-- ════════════════════════ TOPBAR ════════════════════════ -->
<div class="topbar">
    <button class="d-lg-none btn btn-sm" style="border:none;background:transparent;padding:0;" onclick="toggleSidebar()">
        <i class="fas fa-bars" style="color:var(--primary);font-size:1.3rem;"></i>
    </button>
    <div class="d-none d-lg-block">
        <div class="topbar-title">Overview Dashboard</div>
        <div class="topbar-sub">Cooperative snapshot &middot; <%= periodLabel %></div>
    </div>
    <div class="d-lg-none topbar-title">Overview</div>
    <button class="btn btn-sm btn-outline-primary ms-auto" onclick="location.reload()" style="border-radius:8px;font-weight:700;font-size:.78rem;">
        <i class="fas fa-sync-alt me-1"></i><span class="d-none d-sm-inline">Refresh</span>
    </button>
</div>

<!-- ════════════════════════ MAIN ════════════════════════ -->
<div class="main">

    <!-- HERO -->
    <div class="hero r1">
        <div class="hero-inner">
            <div class="row align-items-center g-3">
                <div class="col-md-7">
                    <div class="hero-date-pill"><i class="fas fa-calendar-alt" style="font-size:.8rem;"></i><span id="heroDate"></span></div>
                    <h3>Good <%= timeGreeting %>, <%= admin.firstName %>! 👋</h3>
                    <p>Financial snapshot for <strong>Club De Stars Cooperative</strong> · <em><%= periodLabel %></em></p>
                </div>
                <div class="col-md-5">
                    <div class="hero-stats">
                        <div class="hero-portfolio">
                            <small>Total Portfolio</small>
                            <strong>₦<%= totalPortfolio.toLocaleString() %></strong>
                        </div>
                        <div class="hero-badges">
                            <div class="hero-badge" style="background:rgba(16,185,129,.28);border:1px solid rgba(16,185,129,.4);"><i class="fas fa-users me-1"></i><%= stats.members.active %> Active</div>
                            <div class="hero-badge" style="background:rgba(139,92,246,.28);border:1px solid rgba(139,92,246,.4);"><i class="fas fa-chart-line me-1"></i>₦<%= stats.finance.companyRevenue.toLocaleString() %> Revenue</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="filter-bar r2">
        <span class="filter-label"><i class="fas fa-filter"></i>Period</span>

        <button class="period-btn <%= (!filterValues.period && !filterValues.from) ? 'active' : '' %>" onclick="applyPeriod('all')">All Time</button>
        <button class="period-btn <%= filterValues.period === 'today'      ? 'active' : '' %>" onclick="applyPeriod('today')">Today</button>
        <button class="period-btn <%= filterValues.period === '7d'         ? 'active' : '' %>" onclick="applyPeriod('7d')">7 Days</button>
        <button class="period-btn <%= filterValues.period === '30d'        ? 'active' : '' %>" onclick="applyPeriod('30d')">30 Days</button>
        <button class="period-btn <%= filterValues.period === 'this_month' ? 'active' : '' %>" onclick="applyPeriod('this_month')">This Month</button>
        <button class="period-btn <%= filterValues.period === 'last_month' ? 'active' : '' %>" onclick="applyPeriod('last_month')">Last Month</button>
        <button class="period-btn <%= filterValues.period === 'this_year'  ? 'active' : '' %>" onclick="applyPeriod('this_year')">This Year</button>

        <div class="filter-divider d-none d-xl-block"></div>

        <div class="custom-range d-none d-xl-flex">
            <label>Custom:</label>
            <input type="date" class="date-input" id="fromDate" value="<%= filterValues.from %>">
            <span style="font-size:.75rem;color:#94a3b8;">–</span>
            <input type="date" class="date-input" id="toDate" value="<%= filterValues.to %>">
            <button class="btn-apply" onclick="applyCustom()"><i class="fas fa-check me-1"></i>Apply</button>
        </div>

        <div class="period-pill">
            <i class="fas fa-clock" style="font-size:.65rem;"></i>
            <%= periodLabel %>
        </div>
    </div>

    <!-- Mobile custom date (shown below filter bar on small screens) -->
    <div class="filter-bar d-xl-none r2" style="margin-top:-.75rem;padding:.75rem 1.1rem;">
        <label class="filter-label" style="flex-shrink:0;">Custom Range:</label>
        <input type="date" class="date-input" id="fromDateMob" value="<%= filterValues.from %>">
        <span style="font-size:.75rem;color:#94a3b8;">–</span>
        <input type="date" class="date-input" id="toDateMob" value="<%= filterValues.to %>">
        <button class="btn-apply" onclick="applyCustomMob()"><i class="fas fa-check me-1"></i>Apply</button>
    </div>

    <!-- ═══ KPI ROW 1: Finance ═══ -->
    <div class="kpi-row r3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(30,58,138,.1);color:#1e3a8a;"><i class="fas fa-wallet"></i></div>
            <div class="kpi-label">Member Balances</div>
            <div class="kpi-value">₦<%= stats.finance.totalMemberBalance.toLocaleString() %></div>
            <div class="kpi-sub neutral"><i class="fas fa-users"></i> User accounts</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(16,185,129,.1);color:#059669;"><i class="fas fa-arrow-circle-down"></i></div>
            <div class="kpi-label">Total Deposits</div>
            <div class="kpi-value">₦<%= stats.finance.totalDeposits.toLocaleString() %></div>
            <div class="kpi-sub up"><i class="fas fa-arrow-up"></i><%= stats.finance.depositsInPeriod %> transactions</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(239,68,68,.1);color:#dc2626;"><i class="fas fa-arrow-circle-up"></i></div>
            <div class="kpi-label">Total Withdrawals</div>
            <div class="kpi-value">₦<%= stats.finance.totalWithdrawals.toLocaleString() %></div>
            <div class="kpi-sub down"><i class="fas fa-arrow-down"></i><%= stats.finance.withdrawalsInPeriod %> transactions</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(16,185,129,.1);color:#059669;"><i class="fas fa-balance-scale"></i></div>
            <div class="kpi-label">Net Position</div>
            <div class="kpi-value" style="color:<%= stats.finance.netPosition >= 0 ? '#059669' : '#dc2626' %>;">₦<%= Math.abs(stats.finance.netPosition).toLocaleString() %></div>
            <div class="kpi-sub <%= stats.finance.netPosition >= 0 ? 'up' : 'down' %>">
                <i class="fas fa-<%= stats.finance.netPosition >= 0 ? 'arrow-up' : 'arrow-down' %>"></i>
                <%= stats.finance.netPosition >= 0 ? 'Positive' : 'Negative' %>
            </div>
        </div>
    </div>

    <!-- ═══ KPI ROW 2: Loans + Revenue ═══ -->
    <div class="kpi-row r3" style="margin-bottom:1.5rem;">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(245,158,11,.1);color:#d97706;"><i class="fas fa-hand-holding-usd"></i></div>
            <div class="kpi-label">Loans Disbursed</div>
            <div class="kpi-value">₦<%= stats.loans.totalDisbursed.toLocaleString() %></div>
            <div class="kpi-sub neutral"><i class="fas fa-circle" style="font-size:.5rem;"></i><%= stats.loans.totalCount %> loans</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(239,68,68,.1);color:#dc2626;"><i class="fas fa-exclamation-circle"></i></div>
            <div class="kpi-label">Outstanding Balance</div>
            <div class="kpi-value">₦<%= stats.loans.outstandingBalance.toLocaleString() %></div>
            <div class="kpi-sub <%= stats.loans.overdueCount > 0 ? 'down' : 'neutral' %>">
                <i class="fas fa-<%= stats.loans.overdueCount > 0 ? 'exclamation-triangle' : 'check-circle' %>"></i>
                <%= stats.loans.overdueCount %> overdue
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(236,72,153,.1);color:#db2777;"><i class="fas fa-baby"></i></div>
            <div class="kpi-label">Kiddies Savings</div>
            <div class="kpi-value">₦<%= stats.kiddies.totalBalance.toLocaleString() %></div>
            <div class="kpi-sub neutral"><i class="fas fa-circle" style="font-size:.5rem;"></i><%= stats.kiddies.totalAccounts %> accounts</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(139,92,246,.1);color:#7c3aed;"><i class="fas fa-chart-line"></i></div>
            <div class="kpi-label">Company Revenue</div>
            <div class="kpi-value" style="color:#7c3aed;">₦<%= stats.finance.companyRevenue.toLocaleString() %></div>
            <div class="kpi-sub up"><i class="fas fa-arrow-up"></i>All streams</div>
        </div>
    </div>

    <!-- ═══ ROW A: Member | Loan | Revenue | Quick Actions ═══ -->
    <div class="layout-a r4">

        <!-- 1. Member Breakdown -->
       <div class="s-card">
    <div class="s-head">
        <div class="s-head-title">
            <div class="s-head-icon" style="background:rgba(30,58,138,.1);color:var(--primary);"><i class="fas fa-users"></i></div>
            Members
        </div>
        <a href="/admin-dashboard" class="btn btn-sm btn-outline-primary" style="border-radius:7px;font-size:.73rem;font-weight:700;padding:.28rem .75rem;">View All</a>
    </div>
    <div class="s-body">
        <%
            const combinedTotal = stats.members.active + stats.kiddies.activeAccounts;
            const donutBase = stats.members.active + stats.members.pending + stats.kiddies.activeAccounts || 1;
            const actPx     = Math.round((stats.members.active              / donutBase) * 314);
            const penPx     = Math.round((stats.members.pending             / donutBase) * 314);
            const kiddiesPx = Math.round((stats.kiddies.activeAccounts      / donutBase) * 314);
        %>
        <div class="donut-wrap">
            <div style="position:relative;display:inline-flex;align-items:center;justify-content:center;">
                <svg width="106" height="106" viewBox="0 0 120 120">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(30,58,138,.07)" stroke-width="13"/>
                    <circle cx="60" cy="60" r="50" fill="none" stroke="#10b981" stroke-width="13"
                        stroke-dasharray="<%= actPx %> 314" stroke-dashoffset="0" transform="rotate(-90 60 60)"/>
                    <circle cx="60" cy="60" r="50" fill="none" stroke="#f59e0b" stroke-width="13"
                        stroke-dasharray="<%= penPx %> 314" stroke-dashoffset="-<%= actPx %>" transform="rotate(-90 60 60)"/>
                    <circle cx="60" cy="60" r="50" fill="none" stroke="#ec4899" stroke-width="13"
                        stroke-dasharray="<%= kiddiesPx %> 314" stroke-dashoffset="-<%= actPx + penPx %>" transform="rotate(-90 60 60)"/>
                </svg>
                <div style="position:absolute;text-align:center;">
                    <div style="font-size:1.4rem;font-weight:900;color:#0f172a;line-height:1;"><%= combinedTotal %></div>
                    <div style="font-size:.58rem;font-weight:800;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em;">Active</div>
                </div>
            </div>
            <div class="donut-legend">
                <div class="dleg"><div class="dleg-dot" style="background:#10b981;"></div>Active (<%= stats.members.active %>)</div>
                <div class="dleg"><div class="dleg-dot" style="background:#f59e0b;"></div>Pending (<%= stats.members.pending %>)</div>
                <div class="dleg"><div class="dleg-dot" style="background:#ec4899;"></div>Kiddies (<%= stats.kiddies.activeAccounts %>)</div>
            </div>
        </div>

        <div class="mrow">
            <div class="mrow-left"><div class="mdot" style="background:#8b5cf6;"></div><div><div class="mrow-label">New in Period</div><div class="mrow-sub">Registered</div></div></div>
            <div class="mrow-val" style="color:#7c3aed;"><%= stats.members.newInPeriod %></div>
        </div>
        <div class="mrow">
            <div class="mrow-left"><div class="mdot" style="background:#f59e0b;"></div><div><div class="mrow-label">Pending Members</div><div class="mrow-sub">Awaiting approval</div></div></div>
            <div class="mrow-val" style="color:#d97706;"><%= stats.members.pending %></div>
        </div>
        <div class="mrow">
            <div class="mrow-left"><div class="mdot" style="background:#ef4444;"></div><div><div class="mrow-label">Rejected Members</div><div class="mrow-sub">Not counted in total</div></div></div>
            <div class="mrow-val" style="color:#dc2626;"><%= stats.members.rejected %></div>
        </div>
        <div class="mrow">
            <div class="mrow-left"><div class="mdot" style="background:#ec4899;"></div><div><div class="mrow-label">Kiddies Accounts</div><div class="mrow-sub"><%= stats.kiddies.pendingApproval %> awaiting</div></div></div>
            <div class="mrow-val" style="color:#db2777;"><%= stats.kiddies.totalAccounts %></div>
        </div>
    </div>
</div>

        <!-- 2. Loan Health -->
        <div class="s-card">
            <div class="s-head">
                <div class="s-head-title">
                    <div class="s-head-icon" style="background:rgba(245,158,11,.1);color:#d97706;"><i class="fas fa-hand-holding-usd"></i></div>
                    Loan Health
                </div>
                <a href="/admin/manage-loan" class="btn btn-sm btn-outline-primary" style="border-radius:7px;font-size:.73rem;font-weight:700;padding:.28rem .75rem;">Manage</a>
            </div>
            <div class="s-body">
                <div style="text-align:center;padding:.875rem;background:rgba(245,158,11,.06);border-radius:11px;margin-bottom:.875rem;">
                    <div style="font-size:1.9rem;font-weight:900;color:#d97706;line-height:1;"><%= stats.loans.recoveryRate %>%</div>
                    <div style="font-size:.67rem;font-weight:800;color:#92400e;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.3rem;">Recovery Rate</div>
                    <div class="prog-track"><div class="prog-fill" style="width:<%= stats.loans.recoveryRate %>%;background:linear-gradient(90deg,#f59e0b,#d97706);"></div></div>
                </div>
                <div class="mrow"><div class="mrow-left"><div class="mdot" style="background:#f59e0b;"></div><div class="mrow-label">Active</div></div><div class="mrow-val" style="color:#d97706;"><%= stats.loans.activeCount %></div></div>
                <div class="mrow"><div class="mrow-left"><div class="mdot" style="background:#10b981;"></div><div class="mrow-label">Completed</div></div><div class="mrow-val" style="color:#059669;"><%= stats.loans.completedCount %></div></div>
                <div class="mrow"><div class="mrow-left"><div class="mdot" style="background:#ef4444;"></div><div class="mrow-label">Overdue</div></div><div class="mrow-val" style="color:#dc2626;"><%= stats.loans.overdueCount %></div></div>
                <div class="mrow"><div class="mrow-left"><div class="mdot" style="background:#06b6d4;"></div><div class="mrow-label">External</div></div><div class="mrow-val" style="color:#0891b2;"><%= stats.loans.externalCount %></div></div>
                <div class="mrow"><div class="mrow-left"><div class="mdot" style="background:#8b5cf6;"></div><div><div class="mrow-label">Repayments</div><div class="mrow-sub">In period</div></div></div><div class="mrow-val" style="color:#7c3aed;"><%= stats.loans.repaymentsInPeriod %></div></div>
            </div>
        </div>

        <!-- 3. Revenue Breakdown -->
        <div class="s-card" style="position:relative;">
            <div class="s-head">
                <div class="s-head-title">
                    <div class="s-head-icon" style="background:rgba(139,92,246,.1);color:#7c3aed;"><i class="fas fa-chart-pie"></i></div>
                    Revenue Breakdown
                </div>
            </div>
            <div class="s-body">
                <div style="text-align:center;margin-bottom:.875rem;">
                    <div style="font-size:1.4rem;font-weight:900;color:#7c3aed;">₦<%= stats.finance.companyRevenue.toLocaleString() %></div>
                    <div style="font-size:.65rem;font-weight:800;color:#9ca3af;text-transform:uppercase;letter-spacing:.07em;">Total Company Revenue</div>
                </div>
                <% stats.finance.revenueBreakdown.forEach(r => { %>
                <div class="rev-row">
                    <div class="rev-dot" style="background:<%= r.color %>;"></div>
                    <div class="rev-name"><%= r.label %></div>
                    <div class="rev-pct"><%= r.pct %>%</div>
                    <div class="rev-amt" style="color:<%= r.color %>;">₦<%= r.value.toLocaleString() %></div>
                </div>
                <% }) %>
            </div>
            <div class="rev-strip">
                <% stats.finance.revenueBreakdown.forEach(r => { %>
                <div class="rev-strip-seg" style="width:<%= r.pct %>%;background:<%= r.color %>;"></div>
                <% }) %>
            </div>
        </div>

        <!-- 4. Quick Actions -->
        <div class="s-card">
            <div class="s-head">
                <div class="s-head-title">
                    <div class="s-head-icon" style="background:rgba(245,158,11,.1);color:#d97706;"><i class="fas fa-bolt"></i></div>
                    Quick Actions
                </div>
            </div>
            <div class="s-body">
                <a href="/admin/transaction-approvals" class="qlink">
                    <div class="qlink-ico" style="background:rgba(245,158,11,.1);color:#d97706;"><i class="fas fa-tasks"></i></div>
                    <div><div class="qlink-title">Transaction Approvals</div><div class="qlink-desc">Review pending requests</div></div>
                    <% if (stats.pending.approvals > 0) { %><span class="qlink-badge" style="background:rgba(245,158,11,.15);color:#d97706;"><%= stats.pending.approvals %></span><% } %>
                    <i class="fas fa-chevron-right qlink-arrow"></i>
                </a>
                <a href="/admin/manage-withdrawals" class="qlink">
                    <div class="qlink-ico" style="background:rgba(239,68,68,.1);color:#dc2626;"><i class="fas fa-money-check-alt"></i></div>
                    <div><div class="qlink-title">Withdrawals</div><div class="qlink-desc">₦<%= stats.finance.pendingWithdrawalsAmount.toLocaleString() %> pending</div></div>
                    <% if (stats.pending.withdrawals > 0) { %><span class="qlink-badge" style="background:rgba(239,68,68,.15);color:#dc2626;"><%= stats.pending.withdrawals %></span><% } %>
                    <i class="fas fa-chevron-right qlink-arrow"></i>
                </a>
                <a href="/admin-dashboard?status=pending" class="qlink">
                    <div class="qlink-ico" style="background:rgba(30,58,138,.1);color:#1e3a8a;"><i class="fas fa-user-clock"></i></div>
                    <div><div class="qlink-title">Member Approvals</div><div class="qlink-desc">New registrations</div></div>
                    <% if (stats.members.pending > 0) { %><span class="qlink-badge" style="background:rgba(30,58,138,.12);color:#1e3a8a;"><%= stats.members.pending %></span><% } %>
                    <i class="fas fa-chevron-right qlink-arrow"></i>
                </a>
                <a href="/admin/kiddies-accounts" class="qlink">
                    <div class="qlink-ico" style="background:rgba(236,72,153,.1);color:#db2777;"><i class="fas fa-baby"></i></div>
                    <div><div class="qlink-title">Kiddies Approvals</div><div class="qlink-desc">Children's accounts</div></div>
                    <% if (stats.kiddies.pendingApproval > 0) { %><span class="qlink-badge" style="background:rgba(236,72,153,.12);color:#db2777;"><%= stats.kiddies.pendingApproval %></span><% } %>
                    <i class="fas fa-chevron-right qlink-arrow"></i>
                </a>
                <a href="/admin/loan-payments" class="qlink">
                    <div class="qlink-ico" style="background:rgba(139,92,246,.1);color:#7c3aed;"><i class="fas fa-file-invoice-dollar"></i></div>
                    <div><div class="qlink-title">Loan Payments</div><div class="qlink-desc">Pending repayments</div></div>
                    <% if (stats.pending.loanPayments > 0) { %><span class="qlink-badge" style="background:rgba(139,92,246,.12);color:#7c3aed;"><%= stats.pending.loanPayments %></span><% } %>
                    <i class="fas fa-chevron-right qlink-arrow"></i>
                </a>
                <a href="/admin/manage-deposits" class="qlink">
                    <div class="qlink-ico" style="background:rgba(16,185,129,.1);color:#059669;"><i class="fas fa-coins"></i></div>
                    <div><div class="qlink-title">Deposits</div><div class="qlink-desc">Pending deposits</div></div>
                    <% if (stats.pending.deposits > 0) { %><span class="qlink-badge" style="background:rgba(16,185,129,.12);color:#059669;"><%= stats.pending.deposits %></span><% } %>
                    <i class="fas fa-chevron-right qlink-arrow"></i>
                </a>
            </div>
        </div>

    </div><!-- /layout-a -->

    <!-- ═══ ROW B: Transactions | Finance Grid + Top Members ═══ -->
    <div class="layout-b r5">

        <!-- Recent Transactions -->
        <div class="s-card">
            <div class="s-head">
                <div class="s-head-title">
                    <div class="s-head-icon" style="background:rgba(30,58,138,.1);color:var(--primary);"><i class="fas fa-history"></i></div>
                    Recent Transactions
                </div>
                <a href="/admin/manage-payment" class="btn btn-sm btn-outline-primary" style="border-radius:7px;font-size:.73rem;font-weight:700;padding:.28rem .75rem;">View All</a>
            </div>
            <div class="s-body" style="padding-top:.6rem;padding-bottom:.6rem;">
                <% if (recentTransactions && recentTransactions.length > 0) { %>
                    <% recentTransactions.forEach(tx => { %>
                    <div class="act-row">
                        <div class="act-ico" style="background:<%= tx.typeColor %>1a;color:<%= tx.typeColor %>;"><i class="fas <%= tx.typeIcon %>"></i></div>
                        <div class="act-body">
                            <div class="act-name"><%= tx.memberName %></div>
                            <div class="act-meta">
                                <span class="act-status-tag" style="background:<%= tx.statusColor %>1a;color:<%= tx.statusColor %>;"><%= tx.status %></span>
                                <span><%= tx.typeLabel %></span>
                                <span style="color:#e2e8f0;">&middot;</span>
                                <span><%= tx.timeAgo %></span>
                            </div>
                        </div>
                        <div class="act-amt" style="color:<%= tx.typeColor %>;"><%= tx.sign %>₦<%= tx.amount.toLocaleString() %></div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <div style="text-align:center;padding:2.5rem 1rem;color:#9ca3af;">
                        <i class="fas fa-inbox fa-2x" style="opacity:.2;display:block;margin-bottom:.75rem;"></i>
                        <p style="font-size:.83rem;margin:0;">No transactions in selected period</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Right column: Finance Snapshot + Top Members -->
        <div style="display:flex;flex-direction:column;gap:1.1rem;">

            <!-- Finance Snapshot -->
            <div class="s-card">
                <div class="s-head">
                    <div class="s-head-title">
                        <div class="s-head-icon" style="background:rgba(16,185,129,.1);color:#059669;"><i class="fas fa-chart-bar"></i></div>
                        Finance Snapshot
                    </div>
                </div>
                <div class="s-body">
                    <div class="fin-grid">
                        <div class="fin-tile" style="background:rgba(16,185,129,.07);">
                            <div class="fin-tile-label" style="color:#059669;">Loan Interest</div>
                            <div class="fin-tile-value" style="color:#065f46;">₦<%= stats.loans.interestCollected.toLocaleString() %></div>
                        </div>
                        <div class="fin-tile" style="background:rgba(59,130,246,.07);">
                            <div class="fin-tile-label" style="color:#2563eb;">Reg. Fees</div>
                            <div class="fin-tile-value" style="color:#1e3a8a;">₦<%= stats.finance.registrationFees.toLocaleString() %></div>
                        </div>
                        <div class="fin-tile" style="background:rgba(239,68,68,.07);">
                            <div class="fin-tile-label" style="color:#dc2626;">WD Penalties</div>
                            <div class="fin-tile-value" style="color:#7f1d1d;">₦<%= stats.finance.withdrawalPenalties.toLocaleString() %></div>
                        </div>
                        <div class="fin-tile" style="background:rgba(245,158,11,.07);">
                            <div class="fin-tile-label" style="color:#d97706;">Pending W/D</div>
                            <div class="fin-tile-value" style="color:#78350f;">₦<%= stats.finance.pendingWithdrawalsAmount.toLocaleString() %></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top Members -->
            <div class="s-card" style="flex:1;">
                <div class="s-head">
                    <div class="s-head-title">
                        <div class="s-head-icon" style="background:rgba(245,158,11,.1);color:#d97706;"><i class="fas fa-trophy"></i></div>
                        Top Members by Balance
                    </div>
                </div>
                <div style="overflow-x:auto;">
                    <table class="mtable">
                        <thead>
                            <tr>
                                <th style="width:30px;">#</th>
                                <th>Member</th>
                                <th style="text-align:right;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (topMembers && topMembers.length > 0) { %>
                                <% topMembers.forEach((m, i) => { %>
                                <tr>
                                    <td style="font-size:.78rem;font-weight:800;color:<%= i===0?'#d97706':i===1?'#9ca3af':i===2?'#b45309':'#94a3b8' %>;">
                                        <%= i===0?'🥇':i===1?'🥈':i===2?'🥉':(i+1) %>
                                    </td>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:.5rem;">
                                            <div class="m-ava"><%= m.initials %></div>
                                            <div>
                                                <div style="font-weight:700;font-size:.8rem;color:#1f2937;"><%= m.name %></div>
                                                <div style="font-size:.66rem;color:#9ca3af;"><%= m.membershipID %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="text-align:right;font-weight:800;font-size:.83rem;color:#059669;">₦<%= m.balance.toLocaleString() %></td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="3" style="text-align:center;color:#9ca3af;padding:1.5rem;font-size:.82rem;">No data</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div><!-- /right column -->

    </div><!-- /layout-b -->

</div><!-- /main -->

<div class="powered-by">Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
    /* ── Date ── */
    document.getElementById('heroDate').textContent = new Date().toLocaleDateString('en-US', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });

    /* ── Sidebar ── */
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('active');
        document.getElementById('overlay').classList.toggle('show');
    }
    function closeSidebar() {
        document.getElementById('sidebar').classList.remove('active');
        document.getElementById('overlay').classList.remove('show');
    }

    /* ── Period filter ── */
    function applyPeriod(p) {
        window.location.href = p === 'all' ? '/admin/dashboard' : '/admin/dashboard?period=' + p;
    }
    function applyCustom() {
        const f = document.getElementById('fromDate').value;
        const t = document.getElementById('toDate').value;
        if (!f && !t) { alert('Please select at least one date.'); return; }
        window.location.href = '/admin/dashboard?' + (f ? 'from=' + f + '&' : '') + (t ? 'to=' + t : '');
    }
    function applyCustomMob() {
        const f = document.getElementById('fromDateMob').value;
        const t = document.getElementById('toDateMob').value;
        if (!f && !t) { alert('Please select at least one date.'); return; }
        window.location.href = '/admin/dashboard?' + (f ? 'from=' + f + '&' : '') + (t ? 'to=' + t : '');
    }
    ['fromDate','toDate','fromDateMob','toDateMob'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('keydown', e => { if (e.key === 'Enter') id.includes('Mob') ? applyCustomMob() : applyCustom(); });
    });

    /* ── Sidebar pending badge ── */
    (async () => {
        try {
            const data = await (await fetch('/admin/pending-approvals-count')).json();
            const b = document.getElementById('sidebarBadge');
            if (b && data.count > 0) { b.style.display = 'inline-block'; b.textContent = data.count; }
        } catch(_) {}
    })();
</script>
</body>
</html>
