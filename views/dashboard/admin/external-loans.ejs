/* ══════════════════════════════════════
   GUARANTOR DUPLICATE PREVENTION
══════════════════════════════════════ */
const g1 = document.getElementById('guarantor1');
const g2 = document.getElementById('guarantor2');
function syncGuarantors() {
    Array.from(g2.options).forEach(o => { o.disabled = o.value && o.value === g1.value; });
    Array.from(g1.options).forEach(o => { o.disabled = o.value && o.value === g2.value; });
}
if (g1 && g2) { g1.addEventListener('change', syncGuarantors); g2.addEventListener('change', syncGuarantors); }

/* ══════════════════════════════════════
   GENERATE LINK
══════════════════════════════════════ */
let generatedLink = '';

async function generateLink() {
    const btn = document.getElementById('generateLinkBtn');
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Generating...';
    const payload = {
        label:              document.getElementById('inviteLabel').value.trim()           || null,
        presetAmount:       parseFloat(document.getElementById('inviteAmount').value)     || null,
        presetInterestRate: parseFloat(document.getElementById('inviteRate').value)       || null,
        presetDuration:     parseInt(document.getElementById('inviteDuration').value, 10) || null,
        penaltyPercentage:  parseFloat(document.getElementById('invitePenalty').value)    || null,
        rolloverPercentage: parseFloat(document.getElementById('inviteRollover').value)   || null,
    };
    try {
        const res  = await fetch('/admin/external-loans/invite', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
        const data = await res.json();
        if (res.ok) {
            generatedLink = data.link;
            document.getElementById('generatedLinkDisplay').textContent = data.link;
            document.getElementById('linkFormStep').style.display   = 'none';
            document.getElementById('linkResultStep').style.display  = 'block';
            document.getElementById('linkModalFooter').style.display = 'none';
            loadInvites();
        } else { showAlert(data.error || 'Failed to generate link.', 'danger', 'Error'); }
    } catch { showAlert('Network error. Please try again.', 'danger', 'Error'); }
    finally { btn.disabled = false; btn.innerHTML = '<i class="fas fa-link me-2"></i>Generate Link'; }
}

function copyLink(link) {
    const toCopy = link || generatedLink;
    navigator.clipboard.writeText(toCopy).then(() => {
        const notice = document.getElementById('copiedNotice');
        if (notice) { notice.style.display='block'; setTimeout(()=>notice.style.display='none', 2500); }
        else showAlert('Link copied to clipboard!', 'success', 'Copied');
    }).catch(() => showAlert('Could not copy. Please copy manually:\n' + toCopy, 'info', 'Copy Link'));
}

function resetLinkForm() {
    document.getElementById('linkFormStep').style.display   = 'block';
    document.getElementById('linkResultStep').style.display  = 'none';
    document.getElementById('linkModalFooter').style.display = 'flex';
    ['inviteLabel','inviteAmount','inviteRate','inviteDuration','invitePenalty','inviteRollover'].forEach(id => { document.getElementById(id).value = ''; });
    const n = document.getElementById('copiedNotice'); if (n) n.style.display = 'none';
}
document.getElementById('generateLinkModal').addEventListener('hidden.bs.modal', resetLinkForm);

/* ══════════════════════════════════════
   LOAD INVITES TABLE
══════════════════════════════════════ */
async function loadInvites() {
    try {
        const res  = await fetch('/admin/external-loans/invites');
        const data = await res.json();
        const tbody = document.getElementById('invitesTableBody');
        if (!data.invites || !data.invites.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No application links generated yet.</td></tr>'; return;
        }
        tbody.innerHTML = data.invites.map(inv => {
            const sc = { active:'inv-active', used:'inv-used', expired:'inv-expired', revoked:'inv-revoked' }[inv.computedStatus] || 'inv-expired';
            const sl = inv.computedStatus.charAt(0).toUpperCase() + inv.computedStatus.slice(1);
            const expiry = new Date(inv.expiresAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
            const isActive = inv.computedStatus === 'active';
            const linkUrl  = inv.link || `${window.location.origin}/apply/external-loan/${inv.token}`;
            const copyBtn  = `<button class="btn btn-outline-primary btn-sm" title="Copy link" onclick="copyLink('${linkUrl}')"><i class="fas fa-copy"></i></button>`;
            const revokeBtn= isActive ? `<button class="btn btn-outline-warning btn-sm" title="Revoke" onclick="revokeInvite('${inv.token}')"><i class="fas fa-ban"></i></button>` : '';
            const deleteBtn= !isActive ? `<button class="btn btn-outline-danger btn-sm" title="Delete" onclick="deleteInvite('${inv.token}')"><i class="fas fa-trash"></i></button>` : '';
            return `<tr>
                <td>${inv.label||'<span class="text-muted">—</span>'}</td>
                <td>${inv.generatedBy?.fullName||'Admin'}</td>
                <td>${inv.presetAmount?'₦'+Number(inv.presetAmount).toLocaleString():'<span class="text-muted">Open</span>'}</td>
                <td>${inv.penaltyPercentage!=null?inv.penaltyPercentage+'%':'<span class="text-muted">—</span>'}</td>
                <td>${inv.rolloverPercentage!=null?inv.rolloverPercentage+'%':'<span class="text-muted">—</span>'}</td>
                <td>${expiry}</td>
                <td><span class="badge ${sc}">${sl}</span></td>
                <td><div class="invite-actions">${copyBtn}${revokeBtn}${deleteBtn}</div></td>
            </tr>`;
        }).join('');
    } catch(err) { console.error('Failed to load invites:', err); }
}

async function revokeInvite(token) {
    if (!confirm('Revoke this link?')) return;
    try {
        const res = await fetch(`/admin/external-loans/invite/${token}`, { method:'DELETE' });
        const data = await res.json();
        if (res.ok) { showAlert('Link revoked successfully.', 'success', 'Revoked'); loadInvites(); }
        else showAlert(data.error || 'Failed to revoke.', 'danger', 'Error');
    } catch { showAlert('Network error.', 'danger', 'Error'); }
}

async function deleteInvite(token) {
    if (!confirm('Permanently delete this link record?')) return;
    try {
        const res = await fetch(`/admin/external-loans/invite/${token}?permanent=true`, { method:'DELETE' });
        const data = await res.json();
        if (res.ok) { showAlert('Link record deleted.', 'success', 'Deleted'); loadInvites(); }
        else showAlert(data.error || 'Failed to delete.', 'danger', 'Error');
    } catch { showAlert('Network error.', 'danger', 'Error'); }
}

/* ══════════════════════════════════════
   ISSUE LOAN
══════════════════════════════════════ */
async function submitLoanForm() {
    const form = document.getElementById('issueLoanForm');
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const loanData = {};
    new FormData(form).forEach((v, k) => { loanData[k] = v; });
    try {
        const res    = await fetch('/admin/external-loans', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(loanData) });
        const result = await res.json();
        if (res.ok) {
            switchModal('issueLoanModal', () => {
                showAlert(result.message, 'success', 'Loan Issued');
                form.reset();
                setTimeout(() => location.reload(), 1800);
            });
        } else showAlert(result.error || 'Failed to issue loan.', 'danger', 'Error');
    } catch { showAlert('Network error.', 'danger', 'Error'); }
}

/* ══════════════════════════════════════
   RECORD PAYMENT
══════════════════════════════════════ */
function openRecordPaymentModal(realLoanId, displayId, borrower, totalDue, balance) {
    document.getElementById('paymentRealLoanId').value = realLoanId;
    document.getElementById('paymentLoanId').textContent     = displayId;
    document.getElementById('paymentBorrower').textContent   = borrower;
    document.getElementById('paymentTotalDue').textContent   = '₦' + Number(totalDue).toLocaleString();
    document.getElementById('paymentBalance').textContent    = '₦' + Number(balance).toLocaleString();
    document.getElementById('recordPaymentForm').reset();
    document.getElementById('paymentError').classList.add('d-none');
    const btn = document.getElementById('submitPaymentBtn');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-check me-2"></i>Submit for Approval';
    new bootstrap.Modal(document.getElementById('recordPaymentModal')).show();
}

async function submitPaymentRecord() {
    const form   = document.getElementById('recordPaymentForm');
    const errDiv = document.getElementById('paymentError');
    const btn    = document.getElementById('submitPaymentBtn');
    errDiv.classList.add('d-none');
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const loanId    = document.getElementById('paymentRealLoanId').value;
    const amount    = document.getElementById('paymentAmountInput').value;
    const payerName = document.getElementById('payerNameInput').value.trim();
    if (!loanId) {
        document.getElementById('paymentErrorMsg').textContent = 'Loan ID is missing. Please close and reopen.';
        errDiv.classList.remove('d-none'); return;
    }
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';
    try {
        const res  = await fetch('/loan/payment/manual', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ loanId, amount: parseFloat(amount), payerName: payerName || null }) });
        const data = await res.json();
        if (res.ok && data.status) {
            switchModal('recordPaymentModal', () => { showAlert(data.message || 'Payment submitted for approval.', 'success', 'Payment Submitted'); setTimeout(() => location.reload(), 2000); });
        } else {
            document.getElementById('paymentErrorMsg').textContent = data.message || 'Failed to submit payment.';
            errDiv.classList.remove('d-none'); btn.disabled = false; btn.innerHTML = '<i class="fas fa-check me-2"></i>Submit for Approval';
        }
    } catch {
        document.getElementById('paymentErrorMsg').textContent = 'Network error. Check your connection.';
        errDiv.classList.remove('d-none'); btn.disabled = false; btn.innerHTML = '<i class="fas fa-check me-2"></i>Submit for Approval';
    }
}

/* ══════════════════════════════════════
   LOAN DETAILS MODAL
══════════════════════════════════════ */
