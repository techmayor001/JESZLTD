    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        // ══════════════════════════════════════════
        // MODAL SEQUENCING HELPER
        // ══════════════════════════════════════════
        function switchModal(fromId, toFn) {
            const fromEl = document.getElementById(fromId);
            const instance = bootstrap.Modal.getInstance(fromEl);
            if (instance) {
                fromEl.addEventListener('hidden.bs.modal', function handler() {
                    fromEl.removeEventListener('hidden.bs.modal', handler);
                    toFn();
                });
                instance.hide();
            } else {
                toFn();
            }
        }

        // ══════════════════════════════════════════
        // CUSTOM ALERT HELPER
        // ══════════════════════════════════════════
        function showAlert(message, type = 'info', title = null) {
            const config = {
                success: { headerBg: 'bg-success', iconBg: 'rgba(16,185,129,0.12)', iconColor: '#10b981', iconClass: 'fas fa-check-circle', btnClass: 'btn-success', defaultTitle: 'Success' },
                danger:  { headerBg: 'bg-danger',  iconBg: 'rgba(239,68,68,0.12)',  iconColor: '#ef4444', iconClass: 'fas fa-times-circle', btnClass: 'btn-danger',  defaultTitle: 'Error' },
                warning: { headerBg: 'bg-warning', iconBg: 'rgba(245,158,11,0.12)', iconColor: '#f59e0b', iconClass: 'fas fa-exclamation-triangle', btnClass: 'btn-warning', defaultTitle: 'Warning' },
                info:    { headerBg: 'bg-primary', iconBg: 'rgba(59,130,246,0.12)',  iconColor: '#3b82f6', iconClass: 'fas fa-info-circle', btnClass: 'btn-primary', defaultTitle: 'Information' }
            };
            const c = config[type] || config.info;
            document.getElementById('alertModalHeader').className = `modal-header ${c.headerBg} text-white border-0`;
            document.getElementById('alertModalCloseBtn').className = 'btn-close btn-close-white';
            document.getElementById('alertModalLabel').textContent = title || c.defaultTitle;
            const wrapper = document.getElementById('alertModalIconWrapper');
            wrapper.style.background = c.iconBg;
            const icon = document.getElementById('alertModalIcon');
            icon.className = `${c.iconClass} fa-2x`;
            icon.style.color = c.iconColor;
            document.getElementById('alertModalMessage').textContent = message;
            const okBtn = document.getElementById('alertModalOkBtn');
            okBtn.className = `btn px-4 fw-semibold ${c.btnClass}`;

            const openModal = document.querySelector('.modal.show');
            if (openModal && openModal.id !== 'alertModal') {
                switchModal(openModal.id, () => new bootstrap.Modal(document.getElementById('alertModal')).show());
            } else {
                new bootstrap.Modal(document.getElementById('alertModal')).show();
            }
        }

        // ── Init ──────────────────────────────────────────────────────────────
        document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', {
            weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
        });

        // ── Guarantor duplicate prevention ────────────────────────────────────
        const g1 = document.getElementById('guarantor1');
        const g2 = document.getElementById('guarantor2');
        function syncGuarantors() {
            Array.from(g2.options).forEach(o => { o.disabled = o.value && o.value === g1.value; });
            Array.from(g1.options).forEach(o => { o.disabled = o.value && o.value === g2.value; });
        }
        g1.addEventListener('change', syncGuarantors);
        g2.addEventListener('change', syncGuarantors);

        // ══════════════════════════════════════════
        // GENERATE LINK
        // ══════════════════════════════════════════
        let generatedLink = '';

        async function generateLink() {
            const btn = document.getElementById('generateLinkBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Generating...';

            const payload = {
                label:              document.getElementById('inviteLabel').value.trim()            || null,
                presetAmount:       parseFloat(document.getElementById('inviteAmount').value)      || null,
                presetInterestRate: parseFloat(document.getElementById('inviteRate').value)        || null,
                presetDuration:     parseInt(document.getElementById('inviteDuration').value, 10)  || null,
                penaltyPercentage:  parseFloat(document.getElementById('invitePenalty').value)     || null,
                rolloverPercentage: parseFloat(document.getElementById('inviteRollover').value)    || null
            };

            try {
                const res = await fetch('/admin/external-loans/invite', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (res.ok) {
                    generatedLink = data.link;
                    document.getElementById('generatedLinkDisplay').textContent = data.link;
                    document.getElementById('linkFormStep').style.display = 'none';
                    document.getElementById('linkResultStep').style.display = 'block';
                    document.getElementById('linkModalFooter').style.display = 'none';
                    loadInvites();
                } else {
                    showAlert(data.error || 'Failed to generate link.', 'danger', 'Error');
                }
            } catch (err) {
                showAlert('Network error. Please try again.', 'danger', 'Error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-link me-2"></i>Generate Link';
            }
        }

        function copyLink(link) {
            // Called either from result step or from table button
            const linkToCopy = link || generatedLink;
            navigator.clipboard.writeText(linkToCopy).then(() => {
                const notice = document.getElementById('copiedNotice');
                if (notice) { notice.style.display = 'block'; setTimeout(() => { notice.style.display = 'none'; }, 2500); }
                else { showAlert('Link copied to clipboard!', 'success', 'Copied'); }
            }).catch(() => {
                showAlert('Could not copy. Please copy manually:\n' + linkToCopy, 'info', 'Copy Link');
            });
        }

        function resetLinkForm() {
            document.getElementById('linkFormStep').style.display = 'block';
            document.getElementById('linkResultStep').style.display = 'none';
            document.getElementById('linkModalFooter').style.display = 'flex';
            ['inviteLabel','inviteAmount','inviteRate','inviteDuration','invitePenalty','inviteRollover'].forEach(id => {
                document.getElementById(id).value = '';
            });
            const notice = document.getElementById('copiedNotice');
            if (notice) notice.style.display = 'none';
        }

        document.getElementById('generateLinkModal').addEventListener('hidden.bs.modal', resetLinkForm);

        // ══════════════════════════════════════════
        // LOAD & RENDER INVITES TABLE
        // ══════════════════════════════════════════
        async function loadInvites() {
            try {
                const res = await fetch('/admin/external-loans/invites');
                const data = await res.json();
                const tbody = document.getElementById('invitesTableBody');

                if (!data.invites || data.invites.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="8" class="text-center text-muted py-4">
                        No application links generated yet.
                    </td></tr>`;
                    return;
                }

                tbody.innerHTML = data.invites.map(inv => {
                    const statusClass = {
                        active: 'inv-active', used: 'inv-used',
                        expired: 'inv-expired', revoked: 'inv-revoked'
                    }[inv.computedStatus] || 'inv-expired';
                    const statusLabel = inv.computedStatus.charAt(0).toUpperCase() + inv.computedStatus.slice(1);
                    const expiry = new Date(inv.expiresAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    const isActive = inv.computedStatus === 'active';
                    const linkUrl  = inv.link || `${window.location.origin}/apply/external-loan/${inv.token}`;

                    // ── Action buttons ──────────────────────────────────────────
                    // Copy: always available (useful even for used/expired for reference)
                    // Revoke: only if active
                    // Delete: only if not active (already used/expired/revoked)
                    const copyBtn = `
                        <button class="btn btn-outline-primary btn-sm" title="Copy link"
                            onclick="copyLink('${linkUrl}')">
                            <i class="fas fa-copy"></i>
                        </button>`;
                    const revokeBtn = isActive ? `
                        <button class="btn btn-outline-warning btn-sm" title="Revoke link"
                            onclick="revokeInvite('${inv.token}')">
                            <i class="fas fa-ban"></i>
                        </button>` : '';
                    const deleteBtn = !isActive ? `
                        <button class="btn btn-outline-danger btn-sm" title="Delete record"
                            onclick="deleteInvite('${inv.token}')">
                            <i class="fas fa-trash"></i>
                        </button>` : '';

                    return `<tr>
                        <td>${inv.label || '<span class="text-muted">—</span>'}</td>
                        <td>${inv.generatedBy?.fullName || 'Admin'}</td>
                        <td>${inv.presetAmount ? '₦' + Number(inv.presetAmount).toLocaleString() : '<span class="text-muted">Open</span>'}</td>
                        <td>${inv.penaltyPercentage != null ? inv.penaltyPercentage + '%' : '<span class="text-muted">—</span>'}</td>
                        <td>${inv.rolloverPercentage != null ? inv.rolloverPercentage + '%' : '<span class="text-muted">—</span>'}</td>
                        <td>${expiry}</td>
                        <td><span class="badge ${statusClass}">${statusLabel}</span></td>
                        <td>
                            <div class="invite-actions">
                                ${copyBtn}
                                ${revokeBtn}
                                ${deleteBtn}
                            </div>
                        </td>
                    </tr>`;
                }).join('');
            } catch (err) {
                console.error('Failed to load invites:', err);
            }
        }

        async function revokeInvite(token) {
            if (!confirm('Revoke this link? The applicant will no longer be able to use it.')) return;
            try {
                const res = await fetch(`/admin/external-loans/invite/${token}`, { method: 'DELETE' });
                const data = await res.json();
                if (res.ok) {
                    showAlert('Link revoked successfully.', 'success', 'Revoked');
                    loadInvites();
                } else {
                    showAlert(data.error || 'Failed to revoke.', 'danger', 'Error');
                }
            } catch (err) {
                showAlert('Network error. Please try again.', 'danger', 'Error');
            }
        }

        async function deleteInvite(token) {
            if (!confirm('Permanently delete this link record? This cannot be undone.')) return;
            try {
                const res = await fetch(`/admin/external-loans/invite/${token}?permanent=true`, { method: 'DELETE' });
                const data = await res.json();
                if (res.ok) {
                    showAlert('Link record deleted.', 'success', 'Deleted');
                    loadInvites();
                } else {
                    showAlert(data.error || 'Failed to delete.', 'danger', 'Error');
                }
            } catch (err) {
                showAlert('Network error. Please try again.', 'danger', 'Error');
            }
        }

        // ══════════════════════════════════════════
        // ISSUE LOAN DIRECTLY
        // ══════════════════════════════════════════
        async function submitLoanForm() {
            const form = document.getElementById('issueLoanForm');
            if (!form.checkValidity()) { form.reportValidity(); return; }

            const formData = new FormData(form);
            const loanData = {};
            formData.forEach((value, key) => { loanData[key] = value; });

            try {
                const res = await fetch('/admin/external-loans', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(loanData)
                });
                const result = await res.json();
                if (res.ok) {
                    switchModal('issueLoanModal', () => {
                        showAlert(result.message, 'success', 'Loan Issued');
                        form.reset();
                        setTimeout(() => location.reload(), 1800);
                    });
                } else {
                    showAlert(result.error || 'Failed to issue loan.', 'danger', 'Error');
                }
            } catch (err) {
                showAlert('Network error. Please try again.', 'danger', 'Error');
            }
        }

        // ══════════════════════════════════════════
        // RECORD PAYMENT  ←  hits /loan/payment/manual
        // ══════════════════════════════════════════
        // Opens the modal. realLoanId = MongoDB _id, displayId = "EXT-001"
        function openRecordPaymentModal(realLoanId, displayId, borrower, totalDue, balance) {
            // Populate summary
            document.getElementById('paymentRealLoanId').value = realLoanId;
            document.getElementById('paymentLoanId').textContent = displayId;
            document.getElementById('paymentBorrower').textContent = borrower;
            document.getElementById('paymentTotalDue').textContent = '₦' + Number(totalDue).toLocaleString();
            document.getElementById('paymentBalance').textContent  = '₦' + Number(balance).toLocaleString();

            // Reset form & error
            document.getElementById('recordPaymentForm').reset();
            const errDiv = document.getElementById('paymentError');
            errDiv.classList.add('d-none');

            // Reset button
            const btn = document.getElementById('submitPaymentBtn');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check me-2"></i>Submit for Approval';

            new bootstrap.Modal(document.getElementById('recordPaymentModal')).show();
        }

        async function submitPaymentRecord() {
            const form   = document.getElementById('recordPaymentForm');
            const errDiv = document.getElementById('paymentError');
            const btn    = document.getElementById('submitPaymentBtn');

            errDiv.classList.add('d-none');

            if (!form.checkValidity()) { form.reportValidity(); return; }

            const loanId    = document.getElementById('paymentRealLoanId').value;
            const amount    = document.getElementById('paymentAmountInput').value;
            const payerName = document.getElementById('payerNameInput').value.trim();

            if (!loanId) {
                document.getElementById('paymentErrorMsg').textContent = 'Loan ID is missing. Please close and reopen.';
                errDiv.classList.remove('d-none');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';

            try {
                const res = await fetch('/loan/payment/manual', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        loanId,
                        amount:    parseFloat(amount),
                        payerName: payerName || null
                    })
                });

                const data = await res.json();

                if (res.ok && data.status) {
                    switchModal('recordPaymentModal', () => {
                        showAlert(
                            data.message || 'Payment submitted for admin approval.',
                            'success',
                            'Payment Submitted'
                        );
                        setTimeout(() => location.reload(), 2000);
                    });
                } else {
                    document.getElementById('paymentErrorMsg').textContent = data.message || 'Failed to submit payment. Please try again.';
                    errDiv.classList.remove('d-none');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check me-2"></i>Submit for Approval';
                }
            } catch (err) {
                console.error('Payment error:', err);
                document.getElementById('paymentErrorMsg').textContent = 'Network error. Check your connection and try again.';
                errDiv.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check me-2"></i>Submit for Approval';
            }
        }

        // ══════════════════════════════════════════
        // LOAN DETAILS MODAL
        // ══════════════════════════════════════════
        async function openLoanDetailsModal(loanId) {
            const modal = new bootstrap.Modal(document.getElementById('loanDetailsModal'));
            document.getElementById('loanDetailsBody').innerHTML =
                '<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-muted"></i></div>';
            modal.show();

            try {
                const res  = await fetch(`/admin/external-loans/${loanId}/details`);
                const loan = await res.json();

                if (!res.ok) throw new Error(loan.error || 'Failed to load');

                const paidAmount = loan.paidAmount || 0;
                const balance    = loan.totalRepay - paidAmount;

                document.getElementById('loanDetailsBody').innerHTML = `
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <div class="card h-100" style="background:rgba(30,58,138,0.03);border:2px solid rgba(30,58,138,0.1);">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3" style="color:var(--primary);">Borrower Information</h6>
                                <div class="mb-2"><small class="text-muted">Name:</small><div class="fw-bold">${loan.external?.borrowerName || '—'}</div></div>
                                <div class="mb-2"><small class="text-muted">Phone:</small><div class="fw-bold">${loan.external?.phone || '—'}</div></div>
                                <div class="mb-2"><small class="text-muted">Email:</small><div class="fw-bold">${loan.external?.email || '—'}</div></div>
                                <div class="mb-0"><small class="text-muted">Type:</small><div class="fw-bold">${loan.external?.borrowerType || '—'}</div></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <div class="card h-100" style="background:rgba(16,185,129,0.03);border:2px solid rgba(16,185,129,0.1);">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3" style="color:var(--success);">Loan Information</h6>
                                <div class="mb-2"><small class="text-muted">Status:</small><div class="fw-bold">${loan.status}</div></div>
                                <div class="mb-2"><small class="text-muted">Due Date:</small><div class="fw-bold">${loan.dueDate ? new Date(loan.dueDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—'}</div></div>
                                <div class="mb-2"><small class="text-muted">Duration:</small><div class="fw-bold">${loan.externalDuration || '—'} months</div></div>
                                <div class="mb-0"><small class="text-muted">Purpose:</small><div class="fw-bold">${loan.purpose || '—'}</div></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 mb-4">
                        <div class="card" style="background:rgba(245,158,11,0.03);border:2px solid rgba(245,158,11,0.1);">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3" style="color:var(--warning);">Financial Details</h6>
                                <div class="row">
                                    <div class="col-md-3 mb-2"><small class="text-muted d-block">Principal</small><h5 class="mb-0 fw-bold">₦${loan.amount.toLocaleString()}</h5></div>
                                    <div class="col-md-3 mb-2"><small class="text-muted d-block">Interest Rate</small><h5 class="mb-0 fw-bold">${loan.interestRate}% p.m.</h5></div>
                                    <div class="col-md-3 mb-2"><small class="text-muted d-block">Total Due</small><h5 class="mb-0 fw-bold text-primary">₦${loan.totalRepay.toLocaleString()}</h5></div>
                                    <div class="col-md-3 mb-2"><small class="text-muted d-block">Outstanding</small><h5 class="mb-0 fw-bold text-warning">₦${balance.toLocaleString()}</h5></div>
                                </div>
                                ${loan.penaltyPercentage || loan.rolloverPercentage ? `
                                <hr class="my-2">
                                <div class="row">
                                    <div class="col-md-4"><small class="text-muted d-block">Penalty Rate</small><strong>${loan.penaltyPercentage || 0}% / day</strong></div>
                                    <div class="col-md-4"><small class="text-muted d-block">Total Penalty Applied</small><strong>₦${(loan.totalPenalty||0).toLocaleString()}</strong></div>
                                    <div class="col-md-4"><small class="text-muted d-block">Rollover Rate</small><strong>${loan.rolloverPercentage || 0}%</strong></div>
                                </div>` : ''}
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header"><h6 class="mb-0 fw-bold">Payment History</h6></div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <thead><tr><th>Date</th><th>Amount</th><th>Status</th><th>Reference</th></tr></thead>
                                        <tbody>
                                            ${(loan.paymentHistory || []).length > 0
                                                ? (loan.paymentHistory || []).map(p => `
                                                    <tr>
                                                        <td>${new Date(p.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</td>
                                                        <td class="fw-bold text-success">₦${p.amount.toLocaleString()}</td>
                                                        <td><span class="badge ${p.status === 'approved' ? 'bg-success' : p.status === 'pending' ? 'bg-warning' : 'bg-danger'}">${p.status}</span></td>
                                                        <td><small class="text-muted">${p.reference || '—'}</small></td>
                                                    </tr>`).join('')
                                                : '<tr><td colspan="4" class="text-center text-muted py-3">No payments recorded yet</td></tr>'
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>`;
            } catch (err) {
                document.getElementById('loanDetailsBody').innerHTML =
                    `<div class="text-center text-danger py-4"><i class="fas fa-exclamation-circle me-2"></i>${err.message}</div>`;
            }
        }

        function filterLoans(status) { console.log('Filtering by:', status); }

        function exportToCSV() {
            showAlert('CSV export is being prepared...', 'info', 'Exporting');
        }

        function printLoanStatement() {
            bootstrap.Modal.getInstance(document.getElementById('loanDetailsModal')).hide();
            setTimeout(() => window.print(), 400);
        }

        // Close sidebar on mobile when clicking outside
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            if (window.innerWidth <= 992 && !sidebar.contains(event.target) &&
                !event.target.closest('.fa-bars') && sidebar.classList.contains('active')) {
                sidebar.classList.remove('active');
            }
        });

        // ── Sidebar pending count ────────────────────────────────────────────
        async function loadSidebarPendingCount() {
            try {
                const res = await fetch('/admin/pending-approvals-count');
                const data = await res.json();
                const badge = document.getElementById('sidebarPendingBadge');
                if (!badge) return;
                badge.style.display = data.count > 0 ? 'inline-block' : 'none';
                badge.textContent = data.count;
            } catch (err) { console.error('Sidebar count error:', err); }
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadSidebarPendingCount();
            loadInvites();
        });
    </script>
</body>
</html>
