            </a>
            <a href="/admin/external-loans" class="active">
                <i class="fas fa-building"></i> External Loans
            </a>
            <a href="/admin/loan/settings">
                <i class="fas fa-cogs"></i> Loan Settings
            </a>
            <a href="#">
                <i class="fas fa-chart-pie"></i> ROI Distribution
            </a>
            <a href="#">
                <i class="fas fa-money-check-alt"></i> Withdrawals
            </a>
            <a href="#">
                <i class="fas fa-file-alt"></i> Reports
            </a>
            <a href="/admin/settings">
                <i class="fas fa-cog"></i> Settings
            </a>
            <a href="#" class="mt-3" style="color: rgba(255,255,255,0.6);">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3"
           style="cursor: pointer; color: var(--primary); font-size: 1.5rem;"
           onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
        
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color: var(--primary)">External Loan Management</h5>
            <small class="text-muted">Issue loans and track interest payments</small>
        </div>
        
        <div class="d-flex align-items-center gap-3">
            <div class="position-relative">
                <i class="fas fa-bell" style="color: var(--primary); font-size: 1.25rem; cursor: pointer;"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">3</span>
            </div>
        </div>
    </div>

    <div class="main-content">
        <div class="welcome-card position-relative">
            <div class="row align-items-center position-relative" style="z-index: 1;">
                <div class="col-md-8">
                    <h2 class="mb-2 fw-bold">External Loan Portfolio</h2>
                    <p class="mb-3 opacity-90">Manage loans issued to external parties and track interest payments</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <div class="badge bg-light text-dark">
                            <i class="fas fa-calendar me-1"></i>
                            <span id="currentDate"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <button class="btn btn-light fw-semibold" data-bs-toggle="modal" data-bs-target="#issueLoanModal">
                        <i class="fas fa-plus me-2"></i>Issue New Loan
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white;">
                        <i class="fas fa-hand-holding-usd"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Total Loans Issued</p>
                    <h3 class="mb-1 fw-bold">₦8,500,000</h3>
                    <small class="text-success fw-semibold"><i class="fas fa-arrow-up me-1"></i>12 active loans</small>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                        <i class="fas fa-money-bill-wave"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Expected Interest</p>
                    <h3 class="mb-1 fw-bold">₦1,275,000</h3>
                    <small class="text-success fw-semibold"><i class="fas fa-percentage me-1"></i>15% avg rate</small>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                        <i class="fas fa-coins"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Interest Collected</p>
                    <h3 class="mb-1 fw-bold">₦850,000</h3>
                    <small class="text-warning fw-semibold"><i class="fas fa-clock me-1"></i>67% collected</small>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Overdue Payments</p>
                    <h3 class="mb-1 fw-bold">₦125,000</h3>
                    <small class="text-danger fw-semibold"><i class="fas fa-alert me-1"></i>3 overdue</small>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0 fw-bold" style="color: var(--primary);">
                    <i class="fas fa-list me-2"></i>Active External Loans
                </h5>
                <div class="d-flex gap-2 flex-wrap">
                    <select class="form-select form-select-sm" style="max-width: 150px;" onchange="filterLoans(this.value)">
                        <option>All Status</option>
                        <option>Active</option>
                        <option>Completed</option>
                        <option>Overdue</option>
                    </select>
                    <button class="btn btn-sm btn-outline-primary" onclick="exportToCSV()">
                        <i class="fas fa-download me-1"></i>Export
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Loan ID</th>
                                <th>Borrower</th>
                                <th>Principal</th>
                                <th>Interest Rate</th>
                                <th>Total Due</th>
                                <th>Paid</th>
                                <th>Balance</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="loansTableBody">
                            <tr>
                                <td class="fw-semibold">EXT-001</td>
                                <td>
                                    <div class="fw-semibold">ABC Company Ltd</div>
                                    <small class="text-muted">+234 803 123 4567</small>
                                </td>
                                <td class="fw-bold">₦1,000,000</td>
                                <td>15% p.a.</td>
                                <td class="fw-bold text-primary">₦1,150,000</td>
                                <td class="text-success">₦500,000</td>
                                <td class="text-warning fw-bold">₦650,000</td>
                                <td>Dec 31, 2025</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-primary" onclick="openRecordPaymentModal('EXT-001', 'ABC Company Ltd', 1150000, 650000)">
                                            <i class="fas fa-money-bill"></i>
                                        </button>
                                        <button class="btn btn-info" onclick="openLoanDetailsModal('EXT-001')">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">EXT-002</td>
                                <td>
                                    <div class="fw-semibold">John Okeke</div>
                                    <small class="text-muted">+234 805 987 6543</small>
                                </td>
                                <td class="fw-bold">₦500,000</td>
                                <td>12% p.a.</td>
                                <td class="fw-bold text-primary">₦560,000</td>
                                <td class="text-success">₦200,000</td>
                                <td class="text-warning fw-bold">₦360,000</td>
                                <td>Jan 15, 2026</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-primary" onclick="openRecordPaymentModal('EXT-002', 'John Okeke', 560000, 360000)">
                                            <i class="fas fa-money-bill"></i>
                                        </button>
                                        <button class="btn btn-info" onclick="openLoanDetailsModal('EXT-002')">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">EXT-003</td>
                                <td>
                                    <div class="fw-semibold">XYZ Ventures</div>
                                    <small class="text-muted">+234 807 456 1234</small>
                                </td>
                                <td class="fw-bold">₦2,000,000</td>
                                <td>18% p.a.</td>
                                <td class="fw-bold text-primary">₦2,360,000</td>
                                <td class="text-success">₦0</td>
                                <td class="text-danger fw-bold">₦2,360,000</td>
                                <td>Nov 30, 2025</td>
                                <td><span class="badge bg-danger">Overdue</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-primary" onclick="openRecordPaymentModal('EXT-003', 'XYZ Ventures', 2360000, 2360000)">
                                            <i class="fas fa-money-bill"></i>
                                        </button>
                                        <button class="btn btn-info" onclick="openLoanDetailsModal('EXT-003')">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0 fw-bold" style="color: var(--primary);">
                    <i class="fas fa-history me-2"></i>Recent Interest Payments
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Loan ID</th>
                                <th>Borrower</th>
                                <th>Amount Paid</th>
                                <th>Payment Type</th>
                                <th>Recorded By</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Dec 20, 2025</td>
                                <td class="fw-semibold">EXT-001</td>
                                <td>ABC Company Ltd</td>
                                <td class="fw-bold text-success">₦250,000</td>
                                <td><span class="badge bg-info">Interest</span></td>
                                <td>Admin User</td>
                            </tr>
                            <tr>
                                <td>Dec 18, 2025</td>
                                <td class="fw-semibold">EXT-002</td>
                                <td>John Okeke</td>
                                <td class="fw-bold text-success">₦100,000</td>
                                <td><span class="badge bg-success">Principal</span></td>
                                <td>Admin User</td>
                            </tr>
                            <tr>
                                <td>Dec 15, 2025</td>
                                <td class="fw-semibold">EXT-001</td>
                                <td>ABC Company Ltd</td>
                                <td class="fw-bold text-success">₦250,000</td>
                                <td><span class="badge bg-success">Principal</span></td>
                                <td>Admin User</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="powered-by">
        <strong style="color: var(--primary);">Cloudbaam</strong> Powered by <strong style="color: var(--primary);">JESZ LIMITED</strong>
    </div>

    <!-- Issue Loan Modal -->
    <div class="modal fade" id="issueLoanModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-plus-circle me-2" style="color: var(--primary);"></i>Issue New External Loan
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert-info-custom mb-4">
                        <small><i class="fas fa-info-circle me-2"></i>Fill in all borrower and loan details carefully</small>
                    </div>
                    <form id="issueLoanForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Borrower Name *</label>
                                <input type="text" class="form-control" name="borrowerName" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Phone Number *</label>
                                <input type="tel" class="form-control" name="borrowerPhone" required>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Email (Optional)</label>
                                <input type="email" class="form-control" name="borrowerEmail">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Borrower Type *</label>
                                <select class="form-select" name="borrowerType" required>
                                    <option value="">Select type...</option>
                                    <option value="individual">Individual</option>
                                    <option value="company">Company</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Address</label>
