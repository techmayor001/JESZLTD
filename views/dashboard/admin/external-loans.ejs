<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>External Loan Management - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        :root {
            --primary: #1e3a8a; --primary-dark: #1e40af; --primary-light: #3b82f6;
            --secondary: #64748b; --success: #10b981; --danger: #ef4444;
            --warning: #f59e0b; --info: #06b6d4; --purple: #8b5cf6;
            --sidebar-width: 280px; --navbar-h: 70px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%); min-height: 100vh; overflow-x: hidden; }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }
        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18); position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box {
            width: 42px; height: 42px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0;
        }
        .sidebar-brand { font-size: .95rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .65rem; font-weight: 500; opacity: .55; display: block; letter-spacing: .08em; }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 10px; background: rgba(239,68,68,.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.3);
            font-weight: 700; font-size: .7rem; color: #fca5a5;
        }
        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }
        .nav-category {
            display: flex; align-items: center; gap: 7px;
            padding: .55rem 1.25rem .3rem; font-size: .62rem; font-weight: 800;
            color: rgba(255,255,255,.38); text-transform: uppercase; letter-spacing: .1em; user-select: none;
        }
        .nav-category::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.08); margin-left: 4px; }
        .sidebar-nav a {
            display: flex; align-items: center; gap: 11px;
            padding: .62rem 1.25rem; color: rgba(255,255,255,.72);
            text-decoration: none; font-weight: 500; font-size: .84rem;
            border-left: 3px solid transparent; transition: all .18s;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }
        .nav-badge {
            margin-left: auto; font-size: .63rem; font-weight: 800;
            padding: 2px 7px; border-radius: 10px;
            background: rgba(239,68,68,.9); color: white; flex-shrink: 0; line-height: 1.4;
        }
        .nav-back {
            display: flex; align-items: center; gap: 10px;
            padding: .7rem 1.25rem .9rem; font-size: .8rem; font-weight: 600;
            color: rgba(255,255,255,.42); text-decoration: none; transition: color .18s;
            border-top: 1px solid rgba(255,255,255,.07); margin-top: .25rem;
        }
        .nav-back:hover { color: rgba(255,255,255,.7); }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }

        /* ══════════ NAVBAR ══════════ */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: var(--navbar-h);
            background: rgba(255,255,255,.97); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            border-bottom: 1px solid rgba(30,58,138,.1);
        }
        .main-content { margin-left: var(--sidebar-width); margin-top: var(--navbar-h); padding: 1.5rem; min-height: calc(100vh - var(--navbar-h)); }

        /* ══════════ PAGE HEADER ══════════ */
        .page-header {
            background: linear-gradient(130deg, #1e3a8a 0%, #1e40af 45%, #3b82f6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 10px 36px rgba(30,58,138,.28); position: relative;
            /* NO overflow:hidden — keeps export dropdown visible */
        }
        .page-header::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,.05); border-radius: 50%; pointer-events: none;
        }

        /* ══════════ EXPORT DROPDOWN ══════════ */
        .export-wrapper { position: relative; z-index: 200; display: inline-block; }
        .btn-export {
            background: white; color: var(--primary); border: none;
            font-weight: 700; border-radius: 10px; padding: .55rem 1.1rem;
            font-size: .88rem; display: inline-flex; align-items: center; gap: .5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,.12); transition: all .2s; cursor: pointer;
        }
        .btn-export:hover { background: rgba(255,255,255,.92); transform: translateY(-1px); box-shadow: 0 6px 18px rgba(0,0,0,.15); }
        .btn-export .caret { font-size: .7rem; transition: transform .2s; }
        .btn-export.open .caret { transform: rotate(180deg); }
        .export-dropdown-menu {
            position: absolute; top: calc(100% + 6px); right: 0;
            min-width: 230px; background: white; border-radius: 14px;
            box-shadow: 0 20px 50px rgba(30,58,138,.22), 0 4px 16px rgba(0,0,0,.1);
            padding: .5rem; z-index: 99999;
        }
        .export-dropdown-menu .drop-header { font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: #94a3b8; padding: .5rem .75rem .25rem; }
        .export-dropdown-menu .drop-item { border-radius: 9px; padding: .6rem .875rem; font-weight: 600; font-size: .85rem; color: #1e293b; display: flex; align-items: center; gap: .6rem; transition: background .15s; text-decoration: none; cursor: pointer; }
        .export-dropdown-menu .drop-item:hover { background: rgba(30,58,138,.06); }
        .export-dropdown-menu .drop-divider { margin: .35rem .5rem; border-top: 1px solid rgba(30,58,138,.1); }

        /* ══════════ STATS ══════════ */
        .stat-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,.08); transition: all .3s;
            border: 2px solid transparent; height: 100%; position: relative; overflow: hidden;
        }
        .stat-card::before { content: ''; position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: rgba(30,58,138,.03); border-radius: 0 16px 0 100%; }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,.15); border-color: var(--primary); }
        .stat-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 1rem; }

        /* ══════════ CARDS ══════════ */
        .card { border: none; border-radius: 16px; box-shadow: 0 8px 20px rgba(30,58,138,.08); background: white; border: 1px solid rgba(30,58,138,.05); }
        .card-header { background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%); border-bottom: 2px solid rgba(30,58,138,.1); padding: 1.25rem; border-radius: 16px 16px 0 0 !important; }

        /* ══════════ FORM CONTROLS ══════════ */
        .form-label { font-weight: 600; color: var(--primary); margin-bottom: .5rem; }
        .form-control, .form-select { border: 2px solid rgba(30,58,138,.1); border-radius: 10px; padding: .75rem; transition: all .3s; }
        .form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 .2rem rgba(30,58,138,.1); }

        /* ══════════ BUTTONS ══════════ */
        .btn-primary { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); border: none; padding: .6rem 1.5rem; border-radius: 10px; font-weight: 600; transition: all .3s; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(30,58,138,.3); }

        /* ══════════ TABLE ══════════ */
        .table-responsive { border-radius: 0 0 16px 16px; overflow: hidden; }
        .table { margin: 0; font-size: .9rem; }
        .table thead { background: linear-gradient(135deg, rgba(30,58,138,.05) 0%, rgba(59,130,246,.05) 100%); }
        .table thead th { border: none; padding: 1rem; font-weight: 600; color: var(--primary); white-space: nowrap; }
        .table tbody td { padding: .85rem 1rem; vertical-align: middle; border-bottom: 1px solid rgba(30,58,138,.05); }
        .table tbody tr:last-child td { border-bottom: none; }
        .table tbody tr:hover { background: rgba(30,58,138,.02); }

        /* ══════════ INVITE STATUS ══════════ */
        .inv-active  { background: rgba(16,185,129,.1);  color: #059669; border: 1px solid rgba(16,185,129,.3); }
        .inv-used    { background: rgba(59,130,246,.1);  color: #2563eb; border: 1px solid rgba(59,130,246,.3); }
        .inv-expired { background: rgba(100,116,139,.1); color: #475569; border: 1px solid rgba(100,116,139,.3); }
        .inv-revoked { background: rgba(239,68,68,.1);   color: #dc2626; border: 1px solid rgba(239,68,68,.3); }

        /* ══════════ INVITE ACTIONS ══════════ */
        .invite-actions { display: flex; gap: 4px; }
        .invite-actions .btn { padding: 4px 8px; font-size: .75rem; border-radius: 6px; }

        /* ══════════ LINK DISPLAY ══════════ */
        .link-display { background: #f0f9ff; border: 2px solid #3b82f6; border-radius: 10px; padding: 1rem; font-family: monospace; font-size: .85rem; word-break: break-all; color: #1e40af; }

        /* ══════════ ALERT INFO CUSTOM ══════════ */
        .alert-info-custom { background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border: 2px solid #3b82f6; border-radius: 12px; padding: 1rem; color: #1e40af; }

        /* ══════════ CUSTOM ALERT MODAL ══════════ */
        #alertModal .modal-content { border: none; border-radius: 18px; overflow: hidden; box-shadow: 0 20px 60px rgba(30,58,138,.2); }
        #alertModal .modal-header  { padding: 1.25rem 1.5rem; border-bottom: none; }
        #alertModal .modal-body    { padding: 1.5rem; text-align: center; }
        #alertModal .alert-icon-wrapper { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 2rem; }
        #alertModal .modal-footer  { border-top: none; padding: 0 1.5rem 1.5rem; justify-content: center; }

        /* ══════════ POWERED BY ══════════ */
        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,.15); font-size: .8rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        /* ══════════ RESPONSIVE ══════════ */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
        }
        @media (max-width: 576px) {
            :root { --navbar-h: 60px; }
            .main-content { padding: .75rem; }
            .export-dropdown-menu { right: auto; left: 0; }
        }
        @keyframes fadeIn { from{opacity:0;transform:translateY(10px);} to{opacity:1;transform:translateY(0);} }
        .fade-in { animation: fadeIn .5s ease; }
    </style>
</head>
<body>

<!-- ════════════════════════ SIDEBAR ════════════════════════ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-row">
            <div class="logo-box">C</div>
            <div><div class="sidebar-brand">Club De Stars<small>Admin Panel</small></div></div>
        </div>
        <div class="role-pill">
            <i class="fas fa-shield-alt" style="font-size:.65rem;"></i>&nbsp;<%= admin.role?.name?.toUpperCase() || 'SUPER ADMIN' %>
        </div>
    </div>

    <div class="sidebar-nav">
        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-home" style="font-size:.6rem;"></i>Main</div>
            <a href="/admin/dashboard"><i class="fas fa-chart-pie"></i>Overview</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-users" style="font-size:.6rem;"></i>Members</div>
            <a href="/admin/manage-members"><i class="fas fa-users"></i>Manage Members</a>
            <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i>Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i>Membership Types</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-exchange-alt" style="font-size:.6rem;"></i>Transactions</div>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i>Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i>Approvals<span id="sidebarPendingBadge" class="nav-badge" style="display:none;">0</span></a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i>Deposits</a>
            <a href="/admin/kiddies-deposits"><i class="fas fa-piggy-bank"></i>Kiddies Deposits</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i>Withdrawals</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-hand-holding-usd" style="font-size:.6rem;"></i>Loans</div>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i>Loan Management</a>
            <a href="/admin/loan-payments"><i class="fas fa-file-invoice-dollar"></i>Loan Payments</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i>Loan Settings</a>
            <a href="/admin/external-loans" class="active"><i class="fas fa-building"></i>External Loans</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-landmark" style="font-size:.6rem;"></i>Finance</div>
            <a href="/admin/finance"><i class="fas fa-landmark"></i>Company Finance</a>
            <a href="/admin/operating-earnings"><i class="fas fa-chart-line"></i>Operating Earnings</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-chart-bar"></i>Company Revenue</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-cog" style="font-size:.6rem;"></i>System</div>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i>Manage Subscriptions</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i>Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i>Settings</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-file-alt" style="font-size:.6rem;"></i>Reporting</div>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i>Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i>Admin Logs</a>
        </div>
    </div>

    <a href="/cds-cooperative/dashboard" class="nav-back"><i class="fas fa-arrow-left"></i>Back to Dashboard</a>
</div>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- Top Navbar -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;" onclick="toggleSidebar(event)"></i>
    <div class="flex-grow-1 d-none d-lg-block">
        <h5 class="mb-0 fw-bold" style="color:var(--primary)">External Loan Management</h5>
        <small class="text-muted">Issue loans and track interest payments</small>
    </div>
    <div class="d-lg-none fw-bold" style="color:var(--primary);font-size:.95rem;">External Loans</div>
    <div class="ms-auto d-flex align-items-center gap-3">
        <div class="badge bg-light text-dark"><i class="fas fa-calendar me-1"></i><span id="currentDate"></span></div>
    </div>
</div>

<!-- Main Content -->
<div class="main-content">

    <!-- PAGE HEADER -->
    <div class="page-header position-relative">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-md-7">
                <h2 class="mb-2 fw-bold"><i class="fas fa-building me-3"></i>External Loan Portfolio</h2>
                <p class="mb-0 opacity-90">Manage loans issued to external parties and track interest payments</p>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex gap-2 justify-content-md-end flex-wrap align-items-center">
                <!-- Export dropdown -->
                <div class="export-wrapper">
                    <button class="btn-export" id="exportBtn" onclick="toggleExportMenu(event)">
                        <i class="fas fa-download"></i>Export
                        <i class="fas fa-chevron-down caret" id="exportCaret"></i>
                    </button>
                    <div class="export-dropdown-menu" id="exportMenu" style="display:none;">
                        <div class="drop-header">Export Loans</div>
                        <a class="drop-item" onclick="exportLoansExcel();closeExportMenu();return false;">
                            <i class="fas fa-file-excel" style="color:#10b981;font-size:1rem;"></i>Excel — Active Loans
                        </a>
                        <a class="drop-item" onclick="exportLoansPDF();closeExportMenu();return false;">
                            <i class="fas fa-file-pdf" style="color:#ef4444;font-size:1rem;"></i>PDF — Active Loans
                        </a>
                        <div class="drop-divider"></div>
                        <div class="drop-header">Export Payments</div>
                        <a class="drop-item" onclick="exportPaymentsExcel();closeExportMenu();return false;">
                            <i class="fas fa-file-excel" style="color:#059669;font-size:1rem;"></i>Excel — Recent Payments
                        </a>
                    </div>
                </div>
                <button class="btn btn-light fw-semibold" data-bs-toggle="modal" data-bs-target="#generateLinkModal">
                    <i class="fas fa-link me-2"></i>Generate Link
                </button>
                <button class="btn btn-light fw-semibold" data-bs-toggle="modal" data-bs-target="#issueLoanModal">
                    <i class="fas fa-plus me-2"></i>Issue Directly
                </button>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <%
        const externalLoans = loans.filter(l => l.external);
        const totalLoansIssued  = externalLoans.reduce((sum, l) => sum + l.amount, 0);
        const expectedInterest  = externalLoans.reduce((sum, l) => sum + (l.amount * (l.interestRate/100)), 0);
        const interestCollected = externalLoans.reduce((sum, l) => sum + (l.paidInterest || 0), 0);
        const today = new Date();
        const overduePayments = externalLoans.reduce((sum, l) => {
            const balance = (l.totalRepay - (l.paidAmount || 0));
            if (balance > 0 && new Date(l.dueDate) < today) return sum + balance;
            return sum;
        }, 0);
        const activeLoansCount = externalLoans.filter(l => l.status === "approved").length;
        const avgRate = externalLoans.length ? (externalLoans.reduce((sum, l) => sum + l.interestRate, 0) / externalLoans.length).toFixed(2) : 0;
        const percentCollected = expectedInterest ? ((interestCollected / expectedInterest) * 100).toFixed(0) : 0;
        const overdueCount = externalLoans.filter(l => { const b = l.totalRepay - (l.paidAmount || 0); return b > 0 && new Date(l.dueDate) < today; }).length;
    %>
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#3b82f6,#2563eb);color:white;"><i class="fas fa-hand-holding-usd"></i></div>
                <p class="text-muted mb-1 fw-semibold small">Total Loans Issued</p>
                <h3 class="mb-1 fw-bold">₦<%= totalLoansIssued.toLocaleString() %></h3>
                <small class="text-success fw-semibold"><i class="fas fa-arrow-up me-1"></i><%= activeLoansCount %> active loans</small>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;"><i class="fas fa-money-bill-wave"></i></div>
                <p class="text-muted mb-1 fw-semibold small">Expected Interest</p>
                <h3 class="mb-1 fw-bold">₦<%= expectedInterest.toLocaleString() %></h3>
                <small class="text-success fw-semibold"><i class="fas fa-percentage me-1"></i><%= avgRate %>% avg rate</small>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;"><i class="fas fa-coins"></i></div>
                <p class="text-muted mb-1 fw-semibold small">Interest Collected</p>
                <h3 class="mb-1 fw-bold">₦<%= interestCollected.toLocaleString() %></h3>
                <small class="text-warning fw-semibold"><i class="fas fa-clock me-1"></i><%= percentCollected %>% collected</small>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background:linear-gradient(135deg,#ef4444,#dc2626);color:white;"><i class="fas fa-exclamation-triangle"></i></div>
                <p class="text-muted mb-1 fw-semibold small">Overdue Payments</p>
                <h3 class="mb-1 fw-bold">₦<%= overduePayments.toLocaleString() %></h3>
                <small class="text-danger fw-semibold"><%= overdueCount %> overdue</small>
            </div>
        </div>
    </div>

    <!-- APPLICATION LINKS TABLE -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold" style="color:var(--primary);"><i class="fas fa-link me-2"></i>Application Links</h5>
            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#generateLinkModal">
                <i class="fas fa-plus me-1"></i>New Link
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="invitesTable">
                    <thead>
                        <tr>
                            <th>Label</th><th>Generated By</th><th>Preset Amount</th>
                            <th>Penalty %</th><th>Rollover %</th><th>Expires</th>
                            <th>Status</th><th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="invitesTableBody">
                        <tr><td colspan="8" class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading links...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ACTIVE LOANS TABLE -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0 fw-bold" style="color:var(--primary);"><i class="fas fa-list me-2"></i>Active External Loans</h5>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <select class="form-select form-select-sm" style="max-width:150px;" onchange="filterLoans(this.value)">
                    <option>All Status</option>
                    <option>Active</option>
                    <option>Completed</option>
                    <option>Overdue</option>
                </select>
                <input type="text" class="form-control form-control-sm" style="max-width:200px;" id="loanSearch" placeholder="Search borrower…" oninput="searchLoans()">
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="loansTable">
                    <thead>
                        <tr>
                            <th>Loan ID</th><th>Borrower</th><th>Principal</th><th>Rate</th>
                            <th>Total Due</th><th>Paid</th><th>Balance</th><th>Due Date</th>
                            <th>Status</th><th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="loansTableBody">
                        <% loans.forEach((loan, index) => { %>
                            <% if (loan.external) { %>
                                <%
                                    const borrower = loan.external;
                                    const paidAmount = loan.paidAmount || 0;
                                    const balance = loan.totalRepay - paidAmount;
                                    const loanIdDisplay = "EXT-" + (index + 1).toString().padStart(3, '0');
                                    const statusBadge = loan.status === "approved" ? "bg-success" :
                                                        loan.status === "pending"  ? "bg-warning"  :
                                                        loan.status === "rejected" ? "bg-danger"   : "bg-secondary";
                                    const isOverdue = balance > 0 && new Date(loan.dueDate) < today;
                                %>
                                <tr data-borrower="<%= borrower.borrowerName?.toLowerCase() %>">
                                    <td class="fw-semibold"><%= loanIdDisplay %></td>
                                    <td>
                                        <div class="fw-semibold"><%= borrower.borrowerName %></div>
                                        <small class="text-muted"><%= borrower.phone || 'N/A' %></small>
                                    </td>
                                    <td class="fw-bold">₦<%= loan.amount.toLocaleString() %></td>
                                    <td><%= loan.interestRate %>% p.m.</td>
                                    <td class="fw-bold text-primary">₦<%= loan.totalRepay.toLocaleString() %></td>
                                    <td class="text-success">₦<%= paidAmount.toLocaleString() %></td>
                                    <td class="<%= balance <= 0 ? 'text-success fw-bold' : isOverdue ? 'text-danger fw-bold' : 'text-warning fw-bold' %>">
                                        ₦<%= balance.toLocaleString() %>
                                        <% if (isOverdue && balance > 0) { %><span class="badge bg-danger ms-1" style="font-size:.6rem;">OVERDUE</span><% } %>
                                    </td>
                                    <td><%= new Date(loan.dueDate).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) %></td>
                                    <td><span class="badge <%= statusBadge %>"><%= loan.status.charAt(0).toUpperCase() + loan.status.slice(1) %></span></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-primary"
                                                onclick="openRecordPaymentModal('<%= loan._id %>', '<%= loanIdDisplay %>', '<%= borrower.borrowerName %>', <%= loan.totalRepay %>, <%= balance %>)"
                                                title="Record Payment"><i class="fas fa-money-bill"></i></button>
                                            <button class="btn btn-info text-white" onclick="openLoanDetailsModal('<%= loan._id %>')" title="View Details"><i class="fas fa-eye"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        <% }) %>
                        <% if (!loans.some(l => l.external)) { %>
                            <tr><td colspan="10" class="text-center text-muted py-5"><i class="fas fa-inbox fa-2x d-block mb-2 opacity-25"></i>No external loans available</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- RECENT PAYMENTS -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold" style="color:var(--primary);"><i class="fas fa-history me-2"></i>Recent Interest Payments</h5>
            <small class="text-muted" id="paymentsInfo"></small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr><th>Date</th><th>Loan ID</th><th>Borrower</th><th>Amount Paid</th><th>Type</th><th>Recorded By</th></tr>
                    </thead>
                    <tbody id="paymentsTableBody">
                        <% if (payments && payments.length > 0) { %>
                            <% payments.forEach(payment => { %>
                                <tr>
                                    <td><%= new Date(payment.createdAt).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %></td>
                                    <td class="fw-semibold"><%= payment.loan.external ? 'EXT-' + payment.loan._id.toString().slice(-3).toUpperCase() : payment.loan.user.membershipID %></td>
                                    <td><%= payment.loan.external ? payment.loan.external.borrowerName : payment.loan.user.firstName + ' ' + payment.loan.user.lastName %></td>
                                    <td class="fw-bold text-success">₦<%= payment.amount.toLocaleString() %></td>
                                    <td><span class="badge <%= payment.type === 'interest' ? 'bg-info' : 'bg-success' %>"><%= payment.type.charAt(0).toUpperCase() + payment.type.slice(1) %></span></td>
                                    <td><%= payment.paidBy ? (payment.paidBy.fullName || [payment.paidBy.firstName, payment.paidBy.lastName].filter(Boolean).join(' ') || 'Admin') : 'Admin' %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6" class="text-center text-muted py-5"><i class="fas fa-inbox fa-2x d-block mb-2 opacity-25"></i>No recent payments</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div><!-- /main-content -->

<div class="powered-by">Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

