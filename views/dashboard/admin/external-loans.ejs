<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
/* ══════════════════════════════════════
   SIDEBAR
══════════════════════════════════════ */
function toggleSidebar(e) {
    e.stopPropagation();
    document.getElementById('sidebar').classList.toggle('active');
    document.getElementById('sidebarOverlay').classList.toggle('active');
}
function closeSidebar() {
    document.getElementById('sidebar').classList.remove('active');
    document.getElementById('sidebarOverlay').classList.remove('active');
}
document.addEventListener('click', e => {
    const sb = document.getElementById('sidebar');
    if (window.innerWidth <= 992 && !sb.contains(e.target) && !e.target.closest('.fa-bars') && sb.classList.contains('active'))
        closeSidebar();
    if (!e.target.closest('.export-wrapper')) closeExportMenu();
});

async function loadSidebarPendingCount() {
    try {
        const res  = await fetch('/admin/pending-approvals-count');
        const data = await res.json();
        const badge = document.getElementById('sidebarPendingBadge'); if (!badge) return;
        badge.style.display = data.count > 0 ? 'inline-block' : 'none';
        if (data.count > 0) badge.textContent = data.count;
    } catch {}
}

/* ══════════════════════════════════════
   INIT
══════════════════════════════════════ */
document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', {
    weekday:'short', year:'numeric', month:'short', day:'numeric'
});

/* ══════════════════════════════════════
   MODAL SWITCH HELPER
══════════════════════════════════════ */
function switchModal(fromId, toFn) {
    const el = document.getElementById(fromId);
    const inst = bootstrap.Modal.getInstance(el);
    if (inst) {
        el.addEventListener('hidden.bs.modal', function h() { el.removeEventListener('hidden.bs.modal', h); toFn(); });
        inst.hide();
    } else { toFn(); }
}

/* ══════════════════════════════════════
   CUSTOM ALERT
══════════════════════════════════════ */
function showAlert(message, type = 'info', title = null) {
    const cfg = {
        success: { hdr:'bg-success', ibg:'rgba(16,185,129,0.12)', ic:'#10b981', icls:'fas fa-check-circle',        btn:'btn-success', t:'Success' },
        danger:  { hdr:'bg-danger',  ibg:'rgba(239,68,68,0.12)',  ic:'#ef4444', icls:'fas fa-times-circle',         btn:'btn-danger',  t:'Error'   },
        warning: { hdr:'bg-warning', ibg:'rgba(245,158,11,0.12)', ic:'#f59e0b', icls:'fas fa-exclamation-triangle', btn:'btn-warning', t:'Warning' },
        info:    { hdr:'bg-primary', ibg:'rgba(59,130,246,0.12)', ic:'#3b82f6', icls:'fas fa-info-circle',          btn:'btn-primary', t:'Info'    },
    };
    const c = cfg[type] || cfg.info;
    document.getElementById('alertModalHeader').className   = `modal-header ${c.hdr} text-white border-0`;
    document.getElementById('alertModalCloseBtn').className = 'btn-close btn-close-white';
    document.getElementById('alertModalLabel').textContent  = title || c.t;
    const iw = document.getElementById('alertModalIconWrapper'); iw.style.background = c.ibg;
    const ic = document.getElementById('alertModalIcon'); ic.className = `${c.icls} fa-2x`; ic.style.color = c.ic;
    document.getElementById('alertModalMessage').textContent = message;
    document.getElementById('alertModalOkBtn').className    = `btn px-4 fw-semibold ${c.btn}`;
    const open = document.querySelector('.modal.show');
    if (open && open.id !== 'alertModal') switchModal(open.id, () => new bootstrap.Modal(document.getElementById('alertModal')).show());
    else new bootstrap.Modal(document.getElementById('alertModal')).show();
}

/* ══════════════════════════════════════
   EXPORT DROPDOWN
══════════════════════════════════════ */
function toggleExportMenu(e) {
    e.stopPropagation();
    const menu = document.getElementById('exportMenu');
    const btn  = document.getElementById('exportBtn');
    const isOpen = menu.style.display !== 'none';
    menu.style.display = isOpen ? 'none' : 'block';
    btn.classList.toggle('open', !isOpen);
}
function closeExportMenu() {
    document.getElementById('exportMenu').style.display = 'none';
    document.getElementById('exportBtn').classList.remove('open');
}

/* ══════════════════════════════════════
   SERVER LOAN DATA (injected by EJS)
   Used by export functions for full schema coverage
══════════════════════════════════════ */
const _serverLoans    = <%- JSON.stringify(loans.filter(l => l.external).map(l => ({
    _id:               l._id.toString(),
    // ── Borrower ──────────────────────────────────────────────
    borrowerName:      l.external?.borrowerName     || '—',
    borrowerType:      l.external?.borrowerType     || '—',
    borrowerEmail:     l.external?.email            || '—',
    borrowerPhone:     l.external?.phone            || '—',
    borrowerAddress:   l.external?.address          || '—',
    // ── Initiator ─────────────────────────────────────────────
    // initiatedBy may be Admin (fullName) or User (firstName + lastName) — try both
    initiatedBy: l.initiatedBy ? (l.initiatedBy.fullName || [l.initiatedBy.firstName, l.initiatedBy.lastName].filter(Boolean).join(' ') || '—') : '—',
    initiatedByEmail:  l.initiatedBy?.email         || '—',
    // ── Financials ────────────────────────────────────────────
    amount:            l.amount,
    // interestAmount is optional in schema — guard null/undefined
    interestAmount:    (l.interestAmount != null && l.interestAmount !== '') ? Number(l.interestAmount) : null,
    interestRate:      l.interestRate,
    totalRepay:        l.totalRepay,
    paidAmount:        l.paidAmount                 || 0,
    outstandingBalance:l.outstandingBalance         || 0,
    balance:           l.totalRepay - (l.paidAmount || 0),
    // ── Duration / Dates ──────────────────────────────────────
    externalDuration:  l.externalDuration           || '—',
    dueDate:           l.dueDate ? new Date(l.dueDate).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) : '—',
    dueDateRaw:        l.dueDate                    || null,
    approvedAt:        l.approvedAt ? new Date(l.approvedAt).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) : '—',
    disbursementMethod:l.disbursementMethod         || '—',
    disbursementDate:  l.disbursementDate ? new Date(l.disbursementDate).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) : '—',
    createdAt:         new Date(l.createdAt).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}),
    paidAt:            l.paidAt ? new Date(l.paidAt).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) : '—',
    overdueAt:         l.overdueAt ? new Date(l.overdueAt).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) : '—',
    // ── Status ────────────────────────────────────────────────
    status:            l.status,
    rejectionReason:   l.rejectionReason            || '—',
    // ── Penalty ───────────────────────────────────────────────
    penaltyPercentage: l.penaltyPercentage          || 0,
    totalPenalty:      l.totalPenalty               || 0,
    penaltyHistoryCount: (l.penaltyHistory || []).length,
    // ── Rollover ──────────────────────────────────────────────
    rolloverPercentage:l.rolloverPercentage         || 0,
    rolloverCount:     l.rolloverCount              || 0,
    // ── Guarantors ────────────────────────────────────────────
    guarantor1Name:    l.guarantors?.[0]?.guarantor ? (l.guarantors[0].guarantor.firstName + ' ' + l.guarantors[0].guarantor.lastName) : '—',
    guarantor1ID:      l.guarantors?.[0]?.guarantor?.membershipID || '—',
    guarantor1Status:  l.guarantors?.[0]?.status    || '—',
    guarantor2Name:    l.guarantors?.[1]?.guarantor ? (l.guarantors[1].guarantor.firstName + ' ' + l.guarantors[1].guarantor.lastName) : '—',
    guarantor2ID:      l.guarantors?.[1]?.guarantor?.membershipID || '—',
    guarantor2Status:  l.guarantors?.[1]?.status    || '—',
}))) %>;

const _serverPayments = <%- JSON.stringify((payments || []).map(p => ({
    date:        new Date(p.createdAt).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}),
    loanId:      p.loan.external ? 'EXT-' + p.loan._id.toString().slice(-3).toUpperCase() : (p.loan.user?.membershipID || '—'),
    borrower:    p.loan.external ? p.loan.external.borrowerName : ((p.loan.user?.firstName || '') + ' ' + (p.loan.user?.lastName || '')),
    amount:      p.amount,
    type:        p.type,
    recordedBy:  p.paidBy ? (p.paidBy.firstName + ' ' + p.paidBy.lastName) : 'Admin',
    isExternal:  !!p.loan.external,
}))) %>;

/* ── helpers ── */
function _fmt(n) { return '₦' + Number(n||0).toLocaleString('en-NG',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function _cap(s) { return s ? s.charAt(0).toUpperCase()+s.slice(1) : '—'; }

/* ══════════════════════════════════════
   EXCEL EXPORT — LOANS (full schema)
══════════════════════════════════════ */
function exportLoansExcel() {
    if (!_serverLoans.length) { showAlert('No loan records to export.', 'warning', 'Nothing to Export'); return; }
    const now = new Date().toLocaleString('en-US',{year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit'});
    const today = new Date();

    /* ── Main sheet ── */
    const mainRows = _serverLoans.map((l, i) => {
        const isOverdue = l.dueDateRaw && l.balance > 0 && new Date(l.dueDateRaw) < today;
        return {
            '#':                      i + 1,
            'Loan ID (Display)':      'EXT-' + String(i+1).padStart(3,'0'),
            'MongoDB ID':             l._id,
            // Borrower
            'Borrower Name':          l.borrowerName,
            'Borrower Type':          _cap(l.borrowerType),
            'Borrower Email':         l.borrowerEmail,
            'Borrower Phone':         l.borrowerPhone,
            'Borrower Address':       l.borrowerAddress,
            // Initiator
            'Initiated By':           l.initiatedBy,
            'Initiator Email':        l.initiatedByEmail,
            // Financials
            'Principal (₦)':          l.amount,
            'Interest Amount (₦)':    l.interestAmount != null ? l.interestAmount : '—',
            'Interest Rate (% p.m.)': l.interestRate,
            'Total Repayable (₦)':    l.totalRepay,
            'Amount Paid (₦)':        l.paidAmount,
            'Outstanding Balance (₦)':l.outstandingBalance,
            'Remaining Balance (₦)':  l.balance,
            // Penalty
            'Penalty Rate (% /day)':  l.penaltyPercentage,
            'Total Penalty (₦)':      l.totalPenalty,
            'Penalty Events':         l.penaltyHistoryCount,
            // Rollover
            'Rollover Rate (%)':      l.rolloverPercentage,
            'Rollover Count':         l.rolloverCount,
            // Duration / Dates
            'Duration (months)':      l.externalDuration,
            'Due Date':               l.dueDate,
            'Overdue?':               isOverdue ? 'YES' : 'No',
            'Disbursement Method':    l.disbursementMethod,
            'Disbursement Date':      l.disbursementDate,
            'Approved At':            l.approvedAt,
            'Paid Off At':            l.paidAt,
            'Overdue Since':          l.overdueAt,
            'Created At':             l.createdAt,
            // Status
            'Status':                 _cap(l.status),
            'Rejection Reason':       l.rejectionReason,
            // Guarantors
            'Guarantor 1 Name':       l.guarantor1Name,
            'Guarantor 1 ID':         l.guarantor1ID,
            'Guarantor 1 Status':     _cap(l.guarantor1Status),
            'Guarantor 2 Name':       l.guarantor2Name,
            'Guarantor 2 ID':         l.guarantor2ID,
            'Guarantor 2 Status':     _cap(l.guarantor2Status),
        };
    });

    const ws = XLSX.utils.json_to_sheet(mainRows);

    /* Column widths */
    ws['!cols'] = [
        {wch:4},{wch:16},{wch:28},           // # / display id / mongo id
        {wch:22},{wch:14},{wch:26},{wch:16},{wch:28}, // borrower
        {wch:22},{wch:26},                    // initiator
        {wch:16},{wch:18},{wch:18},{wch:18},{wch:16},{wch:20},{wch:18}, // financials
        {wch:18},{wch:16},{wch:14},           // penalty
        {wch:16},{wch:14},                    // rollover
        {wch:14},{wch:14},{wch:10},{wch:18},{wch:16},{wch:14},{wch:14},{wch:14},{wch:14}, // dates
        {wch:14},{wch:22},                    // status
        {wch:22},{wch:14},{wch:16},{wch:22},{wch:14},{wch:16}, // guarantors
    ];

    /* Header styling */
    const range = XLSX.utils.decode_range(ws['!ref']);
    for (let C = range.s.c; C <= range.e.c; C++) {
        const addr = XLSX.utils.encode_cell({r:0,c:C});
        if (!ws[addr]) continue;
        ws[addr].s = { fill:{fgColor:{rgb:'1E3A8A'}}, font:{bold:true,color:{rgb:'FFFFFF'},sz:9}, alignment:{horizontal:'center',vertical:'center',wrapText:true} };
    }
    /* Row striping */
    for (let R = 1; R <= range.e.r; R++) {
        const fill = R%2===0 ? 'EEF2FF' : 'FFFFFF';
        for (let C = range.s.c; C <= range.e.c; C++) {
            const addr = XLSX.utils.encode_cell({r:R,c:C});
            if (!ws[addr]) ws[addr]={v:'',t:'s'};
            ws[addr].s = { fill:{fgColor:{rgb:fill}}, alignment:{vertical:'center'}, border:{bottom:{style:'thin',color:{rgb:'E0E7FF'}}} };
        }
    }

    /* ── Summary sheet ── */
    const totalIssued = _serverLoans.reduce((s,l)=>s+l.amount,0);
    const totalPaid   = _serverLoans.reduce((s,l)=>s+l.paidAmount,0);
    const totalBal    = _serverLoans.reduce((s,l)=>s+l.balance,0);
    const totalPen    = _serverLoans.reduce((s,l)=>s+l.totalPenalty,0);
    const overdueLoans= _serverLoans.filter(l=>l.dueDateRaw&&l.balance>0&&new Date(l.dueDateRaw)<today);

    const summaryData = [
        ['Club De Stars — External Loan Portfolio Export',''],
        ['Generated',          now],
        ['Total Records',      _serverLoans.length],
        ['',''],
        ['STATUS BREAKDOWN',''],
        ['Approved / Active',  _serverLoans.filter(l=>l.status==='approved').length],
        ['Pending',            _serverLoans.filter(l=>l.status==='pending').length],
        ['Paid Off',           _serverLoans.filter(l=>l.status==='paid').length],
        ['Overdue',            _serverLoans.filter(l=>l.status==='overdue').length],
        ['Rolled Over',        _serverLoans.filter(l=>l.status==='rolled_over').length],
        ['Rejected',           _serverLoans.filter(l=>l.status==='rejected').length],
        ['',''],
        ['FINANCIAL SUMMARY (₦)',''],
        ['Total Principal Issued',   totalIssued],
        ['Total Amount Paid',        totalPaid],
        ['Total Outstanding Balance',totalBal],
        ['Total Penalties Applied',  totalPen],
        ['Total Rollovers',          _serverLoans.reduce((s,l)=>s+l.rolloverCount,0)],
        ['',''],
        ['OVERDUE SUMMARY',''],
        ['Overdue Loans',            overdueLoans.length],
        ['Total Overdue Amount (₦)', overdueLoans.reduce((s,l)=>s+l.balance,0)],
    ];
    const ws2 = XLSX.utils.aoa_to_sheet(summaryData);
    ws2['!cols'] = [{wch:30},{wch:22}];

    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws,  'External Loans');
    XLSX.utils.book_append_sheet(wb, ws2, 'Summary');
    XLSX.writeFile(wb, `CDS_ExternalLoans_${new Date().toISOString().split('T')[0]}.xlsx`);
    showAlert(`${_serverLoans.length} loan record${_serverLoans.length!==1?'s':''} exported successfully.`, 'success', 'Export Complete');
}

