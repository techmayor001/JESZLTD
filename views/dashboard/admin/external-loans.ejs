async function submitLoanForm() {
    const form = document.getElementById('issueLoanForm');
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    const formData = new FormData(form);
    const loanData = {};

    formData.forEach((value, key) => {
        if (loanData[key]) {
            // handle multi-select guarantors
            if (Array.isArray(loanData[key])) {
                loanData[key].push(value);
            } else {
                loanData[key] = [loanData[key], value];
            }
        } else {
            loanData[key] = value;
        }
    });

    try {
        const res = await fetch("/admin/external-loans", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(loanData)
        });

        const result = await res.json();

        if (res.ok) {
            alert(result.message);
            bootstrap.Modal.getInstance(document.getElementById('issueLoanModal')).hide();
            form.reset();
            location.reload(); // refresh to show new loan
        } else {
            alert(result.error || "Failed to issue loan");
        }
    } catch (err) {
        console.error(err);
        alert("Error submitting loan");
    }
}


