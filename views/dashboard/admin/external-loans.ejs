<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Loan Management - Club De Stars | Powered by JESZ LIMITED</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; z-index: 1040;
            transition: all 0.3s; overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30,58,138,0.15);
            transform: translateX(0);
        }
        .sidebar-header { padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.1); }
        .logo-container { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .logo-box {
            width: 45px; height: 45px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; color: var(--primary); font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2); flex-shrink: 0;
        }
        .sidebar-title { font-size: 1.1rem; line-height: 1.2; }
        .admin-badge {
            display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px;
            background: rgba(239,68,68,0.2); backdrop-filter: blur(10px);
            border-radius: 20px; border: 1px solid rgba(239,68,68,0.3);
            font-weight: 600; font-size: 0.8rem; margin-top: 8px;
        }
        .sidebar-menu { padding: 1rem 0; }
        .sidebar-menu a {
            color: rgba(255,255,255,0.85); text-decoration: none;
            padding: 0.875rem 1.5rem; display: flex; align-items: center;
            transition: all 0.3s; border-left: 3px solid transparent;
            font-weight: 500; font-size: 0.95rem;
        }
        .sidebar-menu a:hover { background: rgba(255,255,255,0.1); color: white; border-left-color: white; }
        .sidebar-menu a.active { background: rgba(255,255,255,0.15); color: white; border-left-color: white; }
        .sidebar-menu a i { width: 24px; margin-right: 12px; font-size: 1.1rem; flex-shrink: 0; }
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0;
            height: 70px; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,0.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            transition: all 0.3s; border-bottom: 1px solid rgba(30,58,138,0.1);
        }
        .main-content {
            margin-left: var(--sidebar-width); margin-top: 70px;
            padding: 1.5rem; min-height: calc(100vh - 70px); transition: all 0.3s;
        }
        .welcome-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30,58,138,0.25); position: relative; overflow: hidden;
        }
        .welcome-card::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,0.05); border-radius: 50%;
        }
        .stat-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,0.08); transition: transform 0.3s, box-shadow 0.3s;
            height: 100%; border: 1px solid rgba(30,58,138,0.05);
        }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,0.15); }
        .stat-icon {
            width: 60px; height: 60px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.6rem; margin-bottom: 1rem;
        }
        .card {
            border: none; border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30,58,138,0.08);
            background: white; border: 1px solid rgba(30,58,138,0.05);
        }
        .card-header {
            background: linear-gradient(135deg, rgba(30,58,138,0.03) 0%, rgba(59,130,246,0.03) 100%);
            border-bottom: 2px solid rgba(30,58,138,0.1);
            padding: 1.25rem; border-radius: 16px 16px 0 0 !important;
        }
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none; padding: 0.6rem 1.5rem;
            border-radius: 10px; font-weight: 600; transition: all 0.3s;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(30,58,138,0.3); }
        .table { font-size: 0.9rem; }
        .table th { font-weight: 600; color: var(--primary); border-bottom: 2px solid rgba(30,58,138,0.1); white-space: nowrap; }
        .badge { padding: 0.4rem 0.8rem; border-radius: 8px; font-weight: 600; font-size: 0.75rem; }
        .powered-by {
            position: fixed; bottom: 15px; right: 15px; background: white;
            padding: 10px 16px; border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30,58,138,0.15);
            font-size: 0.8rem; font-weight: 600; color: var(--primary); z-index: 1000;
        }
        .alert-info-custom {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border: 2px solid #3b82f6; border-radius: 12px; padding: 1rem; color: #1e40af;
        }
        .modal-content { border-radius: 16px; }
        .modal-header { border-radius: 16px 16px 0 0; }
        .form-label { font-weight: 600; color: var(--primary); margin-bottom: 0.5rem; }
        .form-control, .form-select {
            border: 2px solid rgba(30,58,138,0.1); border-radius: 10px; padding: 0.75rem; transition: all 0.3s;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary); box-shadow: 0 0 0 0.2rem rgba(30,58,138,0.1);
        }
        .link-display {
            background: #f0f9ff; border: 2px solid #3b82f6; border-radius: 10px;
            padding: 1rem; font-family: monospace; font-size: 0.85rem;
            word-break: break-all; color: #1e40af;
        }
        /* Invite status badges */
        .inv-active   { background: rgba(16,185,129,0.1); color: #059669; border: 1px solid rgba(16,185,129,0.3); }
        .inv-used     { background: rgba(59,130,246,0.1); color: #2563eb; border: 1px solid rgba(59,130,246,0.3); }
        .inv-expired  { background: rgba(100,116,139,0.1); color: #475569; border: 1px solid rgba(100,116,139,0.3); }
        .inv-revoked  { background: rgba(239,68,68,0.1);  color: #dc2626; border: 1px solid rgba(239,68,68,0.3); }
        /* Custom alert modal */
        #alertModal .modal-content { border: none; border-radius: 18px; overflow: hidden; box-shadow: 0 20px 60px rgba(30,58,138,0.2); }
        #alertModal .modal-header  { padding: 1.25rem 1.5rem; border-bottom: none; }
        #alertModal .modal-body    { padding: 1.5rem; text-align: center; }
        #alertModal .alert-icon-wrapper {
            width: 72px; height: 72px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1rem; font-size: 2rem;
        }
        #alertModal .modal-footer { border-top: none; padding: 0 1.5rem 1.5rem; justify-content: center; }
        /* Invite action buttons */
        .invite-actions { display: flex; gap: 4px; }
        .invite-actions .btn { padding: 4px 8px; font-size: 0.75rem; border-radius: 6px; }
        /* Payment status */
        .payment-submitting { opacity: 0.7; pointer-events: none; }
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
        }
        @media (max-width: 576px) {
            .top-navbar { height: 60px; }
            .main-content { margin-top: 60px; padding: 0.75rem; }
        }
    </style>
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-box">C</div>
                <div>
                    <h5 class="mb-0 fw-bold sidebar-title" style="text-transform: uppercase;">Club De Stars</h5>
                    <small class="opacity-75" style="font-size: 0.75rem;">ADMIN PANEL</small>
                </div>
            </div>
            <div class="admin-badge"><i class="fas fa-shield-alt"></i><span>SUPER ADMIN</span></div>
        </div>
       <div class="sidebar-menu">
            <a href="/admin-dashboard"><i class="fas fa-users"></i> Members</a>
            <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i> Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i> Membership Types</a>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i> Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i> Approvals<span id="sidebarPendingBadge" class="badge bg-danger ms-1" style="display:none;">0</span></a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i> Deposit Management</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i> Withdrawals</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-hand-holding-usd"></i> Extra Charges</a>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i> Loan Management</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i> Loan Settings</a>
            <a href="/admin/external-loans" class="active"><i class="fas fa-building"></i> External Loans</a>
            <a href="/admin/finance"><i class="fas fa-landmark"></i> Company Finance</a>
            <a href="#"><i class="fas fa-chart-pie"></i> ROI Distribution</a>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i> Manage Subscription</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i> Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i> Settings</a>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i> Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i> Admin Logs</a>
            <a href="/cds-cooperative/dashboard" class="mt-3" style="color:rgba(255,255,255,.6);"><i class="fas fa-sign-in-alt"></i> Back to Dashboard</a>
        </div>
    </div>

    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3"
           style="cursor: pointer; color: var(--primary); font-size: 1.5rem;"
           onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color: var(--primary)">External Loan Management</h5>
            <small class="text-muted">Issue loans and track interest payments</small>
        </div>
    </div>

    <div class="main-content">
        <!-- Page Header -->
        <div class="welcome-card position-relative">
            <div class="row align-items-center position-relative" style="z-index: 1;">
                <div class="col-md-7">
                    <h2 class="mb-2 fw-bold">External Loan Portfolio</h2>
                    <p class="mb-3 opacity-90">Manage loans issued to external parties and track interest payments</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <div class="badge bg-light text-dark">
                            <i class="fas fa-calendar me-1"></i>
                            <span id="currentDate"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex gap-2 justify-content-md-end flex-wrap">
                    <button class="btn btn-light fw-semibold" data-bs-toggle="modal" data-bs-target="#generateLinkModal">
                        <i class="fas fa-link me-2"></i>Generate Application Link
                    </button>
                    <button class="btn btn-light fw-semibold" data-bs-toggle="modal" data-bs-target="#issueLoanModal">
                        <i class="fas fa-plus me-2"></i>Issue Directly
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <%
            const externalLoans = loans.filter(l => l.external);
            const totalLoansIssued = externalLoans.reduce((sum, l) => sum + l.amount, 0);
            const expectedInterest = externalLoans.reduce((sum, l) => sum + (l.amount * (l.interestRate/100)), 0);
            const interestCollected = externalLoans.reduce((sum, l) => sum + (l.paidInterest || 0), 0);
            const today = new Date();
            const overduePayments = externalLoans.reduce((sum, l) => {
                const balance = (l.totalRepay - (l.paidAmount || 0));
                if (balance > 0 && new Date(l.dueDate) < today) return sum + balance;
                return sum;
            }, 0);
            const activeLoansCount = externalLoans.filter(l => l.status === "approved").length;
            const avgRate = externalLoans.length ? (externalLoans.reduce((sum, l) => sum + l.interestRate, 0) / externalLoans.length).toFixed(2) : 0;
            const percentCollected = expectedInterest ? ((interestCollected / expectedInterest) * 100).toFixed(0) : 0;
            const overdueCount = externalLoans.filter(l => { const b = l.totalRepay - (l.paidAmount || 0); return b > 0 && new Date(l.dueDate) < today; }).length;
        %>
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white;"><i class="fas fa-hand-holding-usd"></i></div>
                    <p class="text-muted mb-1 fw-semibold small">Total Loans Issued</p>
                    <h3 class="mb-1 fw-bold">₦<%= totalLoansIssued.toLocaleString() %></h3>
                    <small class="text-success fw-semibold"><i class="fas fa-arrow-up me-1"></i><%= activeLoansCount %> active loans</small>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;"><i class="fas fa-money-bill-wave"></i></div>
                    <p class="text-muted mb-1 fw-semibold small">Expected Interest</p>
                    <h3 class="mb-1 fw-bold">₦<%= expectedInterest.toLocaleString() %></h3>
                    <small class="text-success fw-semibold"><i class="fas fa-percentage me-1"></i><%= avgRate %>% avg rate</small>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;"><i class="fas fa-coins"></i></div>
                    <p class="text-muted mb-1 fw-semibold small">Interest Collected</p>
                    <h3 class="mb-1 fw-bold">₦<%= interestCollected.toLocaleString() %></h3>
                    <small class="text-warning fw-semibold"><i class="fas fa-clock me-1"></i><%= percentCollected %>% collected</small>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;"><i class="fas fa-exclamation-triangle"></i></div>
                    <p class="text-muted mb-1 fw-semibold small">Overdue Payments</p>
                    <h3 class="mb-1 fw-bold">₦<%= overduePayments.toLocaleString() %></h3>
                    <small class="text-danger fw-semibold"><%= overdueCount %> overdue</small>
                </div>
            </div>
        </div>

        <!-- ── Application Links Table ─────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold" style="color: var(--primary);">
                    <i class="fas fa-link me-2"></i>Application Links
                </h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#generateLinkModal">
                    <i class="fas fa-plus me-1"></i>New Link
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="invitesTable">
                        <thead>
                            <tr>
                                <th>Label</th>
                                <th>Generated By</th>
                                <th>Preset Amount</th>
                                <th>Penalty %</th>
                                <th>Rollover %</th>
                                <th>Expires</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="invitesTableBody">
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="fas fa-spinner fa-spin me-2"></i>Loading links...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ── Active Loans Table ─────────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0 fw-bold" style="color: var(--primary);"><i class="fas fa-list me-2"></i>Active External Loans</h5>
                <div class="d-flex gap-2 flex-wrap">
                    <select class="form-select form-select-sm" style="max-width: 150px;" onchange="filterLoans(this.value)">
                        <option>All Status</option>
                        <option>Active</option>
                        <option>Completed</option>
                        <option>Overdue</option>
                    </select>
                    <button class="btn btn-sm btn-outline-primary" onclick="exportToCSV()">
                        <i class="fas fa-download me-1"></i>Export
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Loan ID</th><th>Borrower</th><th>Principal</th><th>Interest Rate</th>
                                <th>Total Due</th><th>Paid</th><th>Balance</th><th>Due Date</th>
                                <th>Status</th><th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="loansTableBody">
                            <% loans.forEach((loan, index) => { %>
                                <% if (loan.external) { %>
                                    <%
                                        const borrower = loan.external;
                                        const paidAmount = loan.paidAmount || 0;
                                        const balance = loan.totalRepay - paidAmount;
                                        const loanIdDisplay = "EXT-" + (index + 1).toString().padStart(3, '0');
                                        const statusBadge = loan.status === "approved" ? "bg-success" :
                                                            loan.status === "pending"  ? "bg-warning"  :
                                                            loan.status === "rejected" ? "bg-danger"   : "bg-secondary";
                                    %>
                                    <tr>
                                        <td class="fw-semibold"><%= loanIdDisplay %></td>
                                        <td>
                                            <div class="fw-semibold"><%= borrower.borrowerName %></div>
                                            <small class="text-muted"><%= borrower.phone || 'N/A' %></small>
                                        </td>
                                        <td class="fw-bold">₦<%= loan.amount.toLocaleString() %></td>
                                        <td><%= loan.interestRate %>% p.m.</td>
                                        <td class="fw-bold text-primary">₦<%= loan.totalRepay.toLocaleString() %></td>
                                        <td class="text-success">₦<%= paidAmount.toLocaleString() %></td>
                                        <td class="<%= balance <= 0 ? 'text-success fw-bold' : 'text-warning fw-bold' %>">₦<%= balance.toLocaleString() %></td>
                                        <td><%= new Date(loan.dueDate).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) %></td>
                                        <td><span class="badge <%= statusBadge %>"><%= loan.status.charAt(0).toUpperCase() + loan.status.slice(1) %></span></td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-primary"
                                                    onclick="openRecordPaymentModal('<%= loan._id %>', '<%= loanIdDisplay %>', '<%= borrower.borrowerName %>', <%= loan.totalRepay %>, <%= balance %>)"
                                                    title="Record Payment">
                                                    <i class="fas fa-money-bill"></i>
                                                </button>
                                                <button class="btn btn-info" onclick="openLoanDetailsModal('<%= loan._id %>')" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            <% }) %>
                            <% if (!loans.some(l => l.external)) { %>
                                <tr><td colspan="10" class="text-center text-muted">No external loans available</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Payments -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0 fw-bold" style="color: var(--primary);"><i class="fas fa-history me-2"></i>Recent Interest Payments</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Date</th><th>Loan ID</th><th>Borrower</th><th>Amount Paid</th><th>Payment Type</th><th>Recorded By</th></tr>
                        </thead>
                        <tbody>
                            <% if (payments && payments.length > 0) { %>
                                <% payments.forEach(payment => { %>
                                    <tr>
                                        <td><%= new Date(payment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                                        <td class="fw-semibold"><%= payment.loan.external ? 'EXT-' + payment.loan._id.toString().slice(-3).toUpperCase() : payment.loan.user.membershipID %></td>
                                        <td><%= payment.loan.external ? payment.loan.external.borrowerName : payment.loan.user.firstName + ' ' + payment.loan.user.lastName %></td>
                                        <td class="fw-bold text-success">₦<%= payment.amount.toLocaleString() %></td>
                                        <td><span class="badge <%= payment.type === 'interest' ? 'bg-info' : 'bg-success' %>"><%= payment.type.charAt(0).toUpperCase() + payment.type.slice(1) %></span></td>
                                        <td><%= payment.paidBy ? (payment.paidBy.firstName + ' ' + payment.paidBy.lastName) : 'Admin' %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="6" class="text-center text-muted">No recent payments</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="powered-by">
        <strong style="color: var(--primary);">Cloudbaam</strong> Powered by <strong style="color: var(--primary);">JESZ LIMITED</strong>
    </div>

    <!-- ══════════════════════════════════════════
         CUSTOM ALERT MODAL
         ══════════════════════════════════════════ -->
    <div class="modal fade" id="alertModal" tabindex="-1" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content">
                <div class="modal-header" id="alertModalHeader">
                    <h5 class="modal-title fw-bold" id="alertModalLabel"></h5>
                    <button type="button" class="btn-close" id="alertModalCloseBtn" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert-icon-wrapper" id="alertModalIconWrapper">
                        <i id="alertModalIcon"></i>
                    </div>
                    <p class="mb-0 text-center" id="alertModalMessage"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn px-4 fw-semibold" id="alertModalOkBtn" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
