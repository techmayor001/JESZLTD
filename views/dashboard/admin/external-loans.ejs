    <script>
const guarantor1 = document.getElementById('guarantor1');
const guarantor2 = document.getElementById('guarantor2');

function preventDuplicateGuarantors() {
    const g1Value = guarantor1.value;
    const g2Value = guarantor2.value;

    Array.from(guarantor2.options).forEach(option => {
        option.disabled = option.value === g1Value;
    });
    Array.from(guarantor1.options).forEach(option => {
        option.disabled = option.value === g2Value;
    });
}

guarantor1.addEventListener('change', preventDuplicateGuarantors);
guarantor2.addEventListener('change', preventDuplicateGuarantors);
</script>


