<!-- ══ GENERATE APPLICATION LINK MODAL ══ -->
<div class="modal fade" id="generateLinkModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;">
                <h5 class="modal-title fw-bold"><i class="fas fa-link me-2"></i>Generate Application Link</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert-info-custom mb-4">
                    <small><i class="fas fa-info-circle me-2"></i>A secure link will be shared with the applicant. It expires in <strong>7 days</strong> and can only be used once.</small>
                </div>
                <div id="linkFormStep">
                    <div class="mb-3">
                        <label class="form-label">Label / Note <small class="text-muted fw-normal">(for your reference)</small></label>
                        <input type="text" class="form-control" id="inviteLabel" placeholder="e.g. Loan for Mr. Emeka – Jan 2026">
                    </div>
                    <p class="fw-semibold small mb-2" style="color:var(--primary);"><i class="fas fa-lock me-1"></i>Pre-set loan terms <span class="text-muted fw-normal">(optional)</span></p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><label class="form-label">Amount (₦)</label><input type="number" class="form-control" id="inviteAmount" placeholder="Leave blank for open"></div>
                        <div class="col-md-4"><label class="form-label">Interest Rate (%)</label><input type="number" class="form-control" id="inviteRate" step="0.01" placeholder="e.g. 5"></div>
                        <div class="col-md-4"><label class="form-label">Duration (months)</label><input type="number" class="form-control" id="inviteDuration" placeholder="e.g. 6"></div>
                    </div>
                    <hr class="my-3">
                    <p class="fw-semibold small mb-2" style="color:var(--primary);"><i class="fas fa-exclamation-circle me-1"></i>Penalty &amp; Rollover Settings <span class="text-muted fw-normal">(optional)</span></p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Penalty % (per day)</label>
                            <div class="input-group"><input type="number" class="form-control" id="invitePenalty" step="0.01" min="0" placeholder="e.g. 2"><span class="input-group-text">%</span></div>
                            <small class="text-muted">Applied daily once overdue</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Rollover % (of balance)</label>
                            <div class="input-group"><input type="number" class="form-control" id="inviteRollover" step="0.01" min="0" placeholder="e.g. 5"><span class="input-group-text">%</span></div>
                            <small class="text-muted">Charged on balance at rollover</small>
                        </div>
                    </div>
                </div>
                <div id="linkResultStep" style="display:none;">
                    <p class="fw-semibold mb-2">Share this link with the applicant:</p>
                    <div class="link-display mb-3" id="generatedLinkDisplay"></div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary flex-grow-1" onclick="copyLink()"><i class="fas fa-copy me-1"></i>Copy Link</button>
                        <button class="btn btn-sm btn-outline-secondary flex-grow-1" onclick="resetLinkForm()"><i class="fas fa-plus me-1"></i>Generate Another</button>
                    </div>
                    <div id="copiedNotice" class="text-success text-center mt-2 small" style="display:none;"><i class="fas fa-check me-1"></i>Copied to clipboard!</div>
                </div>
            </div>
            <div class="modal-footer" id="linkModalFooter">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="generateLinkBtn" onclick="generateLink()"><i class="fas fa-link me-2"></i>Generate Link</button>
            </div>
        </div>
    </div>
</div>

