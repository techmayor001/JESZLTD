<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loan Settings | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh; overflow-x: hidden;
        }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }

        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18);
            position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box {
            width: 42px; height: 42px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0;
        }
        .sidebar-brand {
            font-size: .95rem; font-weight: 800; color: white;
            text-transform: uppercase; letter-spacing: .05em; line-height: 1.2;
        }
        .sidebar-brand small {
            font-size: .65rem; font-weight: 500; opacity: .55;
            display: block; letter-spacing: .08em;
        }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 10px; background: rgba(239,68,68,.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.3);
            font-weight: 700; font-size: .7rem; color: #fca5a5;
        }

        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }
        .nav-category {
            display: flex; align-items: center; gap: 7px;
            padding: .55rem 1.25rem .3rem;
            font-size: .62rem; font-weight: 800;
            color: rgba(255,255,255,.38); text-transform: uppercase;
            letter-spacing: .1em; user-select: none;
        }
        .nav-category::after {
            content: ''; flex: 1; height: 1px;
            background: rgba(255,255,255,.08); margin-left: 4px;
        }
        .sidebar-nav a {
            display: flex; align-items: center; gap: 11px;
            padding: .62rem 1.25rem; color: rgba(255,255,255,.72);
            text-decoration: none; font-weight: 500; font-size: .84rem;
            border-left: 3px solid transparent; transition: all .18s;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }
        .nav-badge {
            margin-left: auto; font-size: .63rem; font-weight: 800;
            padding: 2px 7px; border-radius: 10px;
            background: rgba(239,68,68,.9); color: white;
            flex-shrink: 0; line-height: 1.4;
        }
        .nav-back {
            display: flex; align-items: center; gap: 10px;
            padding: .7rem 1.25rem .9rem; font-size: .8rem; font-weight: 600;
            color: rgba(255,255,255,.42); text-decoration: none; transition: color .18s;
            border-top: 1px solid rgba(255,255,255,.07); margin-top: .25rem;
        }
        .nav-back:hover { color: rgba(255,255,255,.7); }

        .sidebar-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,.45); z-index: 1035;
        }
        .sidebar-overlay.active { display: block; }

        /* ══════════ TOPBAR ══════════ */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: 70px;
            background: rgba(255,255,255,.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            border-bottom: 1px solid rgba(30,58,138,.1); transition: all .3s;
        }
        .main-content {
            margin-left: var(--sidebar-width); margin-top: 70px;
            padding: 1.5rem; min-height: calc(100vh - 70px); transition: all .3s;
        }

        /* ══════════ PAGE HEADER ══════════ */
        .welcome-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30,58,138,.25);
            position: relative; overflow: hidden;
        }
        .welcome-card::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px;
            background: rgba(255,255,255,.05); border-radius: 50%;
            pointer-events: none;
        }

        /* ══════════ CARDS ══════════ */
        .card {
            border: none; border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30,58,138,.08);
            background: white; border: 1px solid rgba(30,58,138,.05);
        }
        .card-header {
            background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%);
            border-bottom: 2px solid rgba(30,58,138,.1); padding: 1.25rem;
            border-radius: 16px 16px 0 0 !important;
        }
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none; padding: .6rem 1.5rem; border-radius: 10px;
            font-weight: 600; transition: all .3s;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(30,58,138,.3); }
        .badge { padding: .4rem .8rem; border-radius: 8px; font-weight: 600; font-size: .75rem; }

        /* ══════════ SETTINGS CARDS ══════════ */
        .settings-card {
            background: white; border-radius: 12px; padding: 1.25rem; margin-bottom: 1rem;
            box-shadow: 0 4px 15px rgba(30,58,138,.08);
            border: 1px solid rgba(30,58,138,.05); transition: all .3s;
        }
        .settings-card:hover { box-shadow: 0 8px 25px rgba(30,58,138,.15); }
        .settings-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 1rem; flex-wrap: wrap; gap: .5rem;
        }
        .settings-badge {
            display: inline-flex; align-items: center; gap: .5rem;
            padding: .5rem 1rem; border-radius: 10px; font-weight: 600; font-size: .85rem;
        }
        .settings-details {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem; margin-bottom: 1rem;
        }
        .detail-box {
            padding: .75rem;
            background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%);
            border-radius: 8px; border: 1px solid rgba(30,58,138,.1);
        }
        .detail-label {
            font-size: .75rem; color: #6b7280; margin-bottom: .25rem;
            text-transform: uppercase; font-weight: 600;
        }
        .detail-value { font-size: 1.1rem; font-weight: 700; color: var(--primary); }
        .test-badge {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 2px 8px; background: rgba(245,158,11,.1);
            border: 1px solid rgba(245,158,11,.4); border-radius: 6px;
            font-size: .7rem; font-weight: 700; color: #92400e;
            text-transform: uppercase; letter-spacing: .05em;
        }
        .action-button-group { display: flex; gap: .5rem; flex-wrap: wrap; }

        /* Toggle */
        .toggle-switch { position: relative; display: inline-block; width: 52px; height: 28px; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .toggle-slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #cbd5e1; transition: .3s; border-radius: 28px;
        }
        .toggle-slider:before {
            position: absolute; content: ""; height: 20px; width: 20px;
            left: 4px; bottom: 4px; background-color: white;
            transition: .3s; border-radius: 50%; box-shadow: 0 2px 4px rgba(0,0,0,.2);
        }
        input:checked + .toggle-slider { background: linear-gradient(135deg,#10b981 0%,#059669 100%); }
        input:checked + .toggle-slider:before { transform: translateX(24px); }

        /* Alerts */
        .alert-info-custom    { background: linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%); border: 2px solid #3b82f6; border-radius: 12px; padding: 1rem; color: #1e40af; }
        .alert-warning-custom { background: linear-gradient(135deg,#fef3c7 0%,#fde68a 100%); border: 2px solid #f59e0b; border-radius: 12px; padding: 1rem; color: #92400e; }
        .alert-danger-custom  { background: linear-gradient(135deg,#fee2e2 0%,#fecaca 100%); border: 2px solid #ef4444; border-radius: 12px; padding: 1rem; color: #991b1b; }

        .empty-state { text-align: center; padding: 3rem 1rem; }
        .empty-state i { font-size: 4rem; color: #cbd5e1; margin-bottom: 1rem; }
        .empty-state h5 { color: #64748b; margin-bottom: .5rem; }
        .empty-state p  { color: #94a3b8; margin-bottom: 1.5rem; }

        .modal-content { border-radius: 16px; }
        .modal-header  { border-radius: 16px 16px 0 0; }

        .powered-by {
            position: fixed; bottom: 15px; right: 15px; background: white;
            padding: 10px 16px; border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30,58,138,.15);
            font-size: .8rem; font-weight: 600; color: var(--primary); z-index: 1000;
        }

        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
            .settings-header { flex-direction: column; align-items: flex-start; }
            .action-button-group { width: 100%; }
            .action-button-group .btn { flex: 1; }
        }
        @media (max-width: 576px) {
            .top-navbar { height: 60px; padding: 0 1rem; }
            .main-content { margin-top: 60px; padding: .75rem; }
            .welcome-card { padding: 1.25rem; border-radius: 16px; }
            .settings-card { padding: 1rem; }
            .settings-details { grid-template-columns: 1fr 1fr; }
            .powered-by { bottom: 10px; right: 10px; font-size: .7rem; padding: 8px 12px; }
        }
    </style>
</head>
<body>

<!-- ════════════════════════ SIDEBAR ════════════════════════ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-row">
            <div class="logo-box">C</div>
            <div>
                <div class="sidebar-brand">Club De Stars<small>Admin Panel</small></div>
            </div>
        </div>
        <div class="role-pill">
            <i class="fas fa-shield-alt" style="font-size:.65rem;"></i>&nbsp;<%= admin.role?.name?.toUpperCase() || 'SUPER ADMIN' %>
        </div>
    </div>

   <div class="sidebar-nav">
        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-home" style="font-size:.6rem;"></i>Main</div>
            <a href="/admin/dashboard"><i class="fas fa-chart-pie"></i>Overview</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-users" style="font-size:.6rem;"></i>Members</div>
            <a href="/admin/manage-members"><i class="fas fa-users"></i>Manage Members</a>
            <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i>Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i>Membership Types</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-exchange-alt" style="font-size:.6rem;"></i>Transactions</div>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i>Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i>Approvals<span id="sidebarPendingBadge" class="nav-badge" style="display:none;">0</span></a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i>Deposits</a>
            <a href="/admin/kiddies-deposits"><i class="fas fa-piggy-bank"></i>Kiddies Deposits</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i>Withdrawals</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-hand-holding-usd" style="font-size:.6rem;"></i>Loans</div>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i>Loan Management</a>
            <a href="/admin/loan-payments"><i class="fas fa-file-invoice-dollar"></i>Loan Payments</a>
            <a href="/admin/loan/settings" class="active"><i class="fas fa-cogs"></i>Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i>External Loans</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-landmark" style="font-size:.6rem;"></i>Finance</div>
            <a href="/admin/finance"><i class="fas fa-landmark"></i>Company Finance</a>
            <a href="/admin/operating-earnings"><i class="fas fa-chart-line"></i>Operating Earnings</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-chart-bar"></i>Company Revenue</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-cog" style="font-size:.6rem;"></i>System</div>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i>Manage Subscriptions</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i>Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i>Settings</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-file-alt" style="font-size:.6rem;"></i>Reporting</div>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i>Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i>Admin Logs</a>
        </div>
    </div>

    <a href="/cds-cooperative/dashboard" class="nav-back">
        <i class="fas fa-arrow-left"></i>Back to Dashboard
    </a>
</div>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- Top Navbar -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3"
       style="cursor:pointer;color:var(--primary);font-size:1.5rem;"
       onclick="toggleSidebar(event)"></i>
    <div class="flex-grow-1 d-none d-lg-block">
        <h5 class="mb-0 fw-bold" style="color:var(--primary)">Loan Settings</h5>
        <small class="text-muted">Configure loan duration and interest rates</small>
    </div>
    <div class="d-lg-none fw-bold" style="color:var(--primary);font-size:.95rem;">Loan Settings</div>
</div>

<!-- Main Content -->
<div class="main-content">

    <!-- Welcome Card -->
    <div class="welcome-card position-relative">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-md-8">
                <h2 class="mb-2 fw-bold">Loan Configuration Center</h2>
                <p class="mb-3 opacity-90">Manage loan durations, interest rates, and eligibility criteria</p>
                <div class="d-flex gap-2 flex-wrap">
                    <div class="badge bg-light text-dark">
                        <i class="fas fa-calendar me-1"></i>
                        <span id="currentDate"></span>
                    </div>
                    <div class="badge bg-warning text-dark">
                        <i class="fas fa-flask me-1"></i>
                        Supports minute/hour durations for testing
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <button class="btn btn-light fw-semibold" onclick="showAddSettingModal()">
                    <i class="fas fa-plus me-2"></i>Add New Configuration
                </button>
            </div>
        </div>
    </div>

    <!-- Settings List -->
    <div id="clubLoanSettings"></div>

</div>

<div class="powered-by">Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

<!-- ══ Add / Edit Modal ══ -->
<div class="modal fade" id="loanSettingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#1e3a8a 0%,#3b82f6 100%);color:white;">
                <h5 class="modal-title fw-bold" id="modalTitle">
                    <i class="fas fa-plus-circle me-2"></i>Add Loan Configuration
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="loanSettingForm">
                    <input type="hidden" id="settingId">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Loan Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="configName" placeholder="e.g., 5-Minute Test Loan" required>
                        <small class="text-muted">Give this loan setting a descriptive name</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Duration <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" class="form-control" id="duration" min="1" placeholder="e.g., 5" required>
                            </div>
                            <div class="col-6">
                                <select class="form-select" id="durationUnit" required>
                                    <option value="minutes">Minutes</option>
                                    <option value="hours">Hours</option>
                                    <option value="days">Days</option>
                                    <option value="weeks">Weeks</option>
                                    <option value="months" selected>Months</option>
                                </select>
                            </div>
                        </div>
                        <small class="text-muted">
                            <i class="fas fa-flask text-warning me-1"></i>
                            Use <strong>minutes</strong> or <strong>hours</strong> for quick penalty/rollover testing
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Penalty Percentage (%)</label>
                        <input type="number" class="form-control" id="penaltyPercentage" min="0" max="100" step="0.1" placeholder="e.g., 2.5">
                        <small class="text-muted">Applied when a user fails to pay on time</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rollover Percentage (%)</label>
                        <input type="number" class="form-control" id="rolloverPercentage" min="0" max="100" step="0.1" placeholder="e.g., 5.0">
                        <small class="text-muted">Applied when a user rolls over their loan</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Eligibility Requirement <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" class="form-control" id="eligibilityValue" min="1" placeholder="Enter value" required>
                            </div>
                            <div class="col-6">
                                <select class="form-select" id="eligibilityUnit" required>
                                    <option value="">Select unit...</option>
                                    <option value="minutes">Minutes</option>
                                    <option value="hours">Hours</option>
                                    <option value="daily">Daily</option>
                                    <option value="days">Days</option>
                                    <option value="weeks">Weeks</option>
                                    <option value="months">Months</option>
                                </select>
                            </div>
                        </div>
                        <small class="text-muted">Minimum membership duration before a member can apply.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status</label>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActive" checked>
                            <label class="form-check-label" for="isActive">
                                <span class="fw-semibold">Active</span>
                                <small class="d-block text-muted">Enable this configuration for new loan applications</small>
                            </label>
                        </div>
                    </div>

                    <div class="alert-info-custom">
                        <small><i class="fas fa-lightbulb me-2"></i>Members will see this option when applying if it's active.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveLoanSetting()">
                    <i class="fas fa-save me-2"></i>Save Configuration
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══ Delete Confirmation Modal ══ -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="deleteForm" method="POST" action="/api/loan/settings/delete" class="modal-content">
            <input type="hidden" name="id" id="deleteSettingId">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-trash-alt me-2 text-danger"></i>Delete Configuration
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert-danger-custom mb-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning!</strong> This action cannot be undone.
                </div>
                <p>Are you sure you want to delete this loan configuration?</p>
                <div class="card">
                    <div class="card-body">
                        <strong id="deleteConfigName"></strong>
                        <p class="mb-0 text-muted small mt-1" id="deleteConfigDetails"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Delete Configuration
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
/* ── Duration unit labels ── */
const UNIT_LABELS = { minutes:'min', hours:'hr', days:'day', weeks:'wk', months:'mo' };
const TEST_UNITS  = ['minutes', 'hours'];

/* ── Map backend data ── */
let loanSettings = <%- JSON.stringify(loanSettings) %>.map(s => ({
    id:                 s._id,
    name:               s.loanName,
    duration:           s.duration,
    durationUnit:       s.durationUnit || 'months',
    penaltyPercentage:  s.penaltyPercentage,
    rolloverPercentage: s.rolloverPercentage,
    eligibility:        `${s.eligibilityValue} ${s.eligibilityUnit}`,
    eligibilityValue:   s.eligibilityValue,
    eligibilityUnit:    s.eligibilityUnit,
    isActive:           s.status === 'active',
    type:               'club'
}));

let editingId = null;

document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', {
    weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
});

/* ── Render ── */
function renderLoanSettings() {
    renderSettingsList('clubLoanSettings', loanSettings);
}

function renderSettingsList(containerId, settings) {
    const container = document.getElementById(containerId);
    if (!container) return;
    if (settings.length === 0) {
        container.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h5>No Configurations Found</h5>
                <p>Add your first loan configuration to get started</p>
                <button class="btn btn-primary" onclick="showAddSettingModal()">
                    <i class="fas fa-plus me-2"></i>Add Configuration
                </button>
            </div>`;
        return;
    }
    container.innerHTML = settings.map(s => {
        const isTest    = TEST_UNITS.includes(s.durationUnit);
        const unitShort = UNIT_LABELS[s.durationUnit] || s.durationUnit;
        const testBadge = isTest ? `<span class="test-badge"><i class="fas fa-flask"></i> test</span>` : '';
        return `
        <div class="settings-card">
            <div class="settings-header">
                <div>
                    <h6 class="mb-1 fw-bold d-flex align-items-center gap-2" style="color:var(--primary);">
                        ${s.name} ${testBadge}
                    </h6>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="settings-badge bg-success-subtle text-success">
                        <i class="fas fa-user-check"></i> Club
                    </span>
                    <label class="toggle-switch mb-0">
                        <input type="checkbox" ${s.isActive ? 'checked' : ''} onchange="toggleStatus('${s.id}')">
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
            <div class="settings-details">
                <div class="detail-box"><div class="detail-label">Duration</div><div class="detail-value">${s.duration} ${unitShort}</div></div>
                <div class="detail-box"><div class="detail-label">Penalty Rate</div><div class="detail-value">${s.penaltyPercentage}%</div></div>
                <div class="detail-box"><div class="detail-label">Rollover Rate</div><div class="detail-value">${s.rolloverPercentage}%</div></div>
                <div class="detail-box"><div class="detail-label">Eligibility</div><div class="detail-value">${s.eligibility}</div></div>
            </div>
            <div class="action-button-group">
                <button class="btn btn-sm btn-info text-white" onclick="editSetting('${s.id}')"><i class="fas fa-edit me-1"></i>Edit</button>
                <button class="btn btn-sm ${s.isActive ? 'btn-warning' : 'btn-success'}" onclick="toggleStatus('${s.id}')">
                    <i class="fas fa-${s.isActive ? 'pause' : 'play'} me-1"></i>${s.isActive ? 'Deactivate' : 'Activate'}
                </button>
                <button class="btn btn-sm btn-danger" onclick="showDeleteModal('${s.id}')"><i class="fas fa-trash me-1"></i>Delete</button>
            </div>
        </div>`;
    }).join('');
}

/* ── Add modal ── */
function showAddSettingModal() {
    editingId = null;
    document.getElementById('modalTitle').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Add Loan Configuration';
    document.getElementById('loanSettingForm').reset();
    document.getElementById('settingId').value = '';
    document.getElementById('isActive').checked = true;
    document.getElementById('durationUnit').value = 'months';
    new bootstrap.Modal(document.getElementById('loanSettingModal')).show();
}

/* ── Edit ── */
function editSetting(id) {
    editingId = id;
    const s = loanSettings.find(x => x.id === id);
    if (!s) return;
    document.getElementById('modalTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Loan Configuration';
    document.getElementById('settingId').value           = s.id;
    document.getElementById('configName').value          = s.name;
    document.getElementById('duration').value            = s.duration;
    document.getElementById('durationUnit').value        = s.durationUnit || 'months';
    document.getElementById('penaltyPercentage').value   = s.penaltyPercentage;
    document.getElementById('rolloverPercentage').value  = s.rolloverPercentage;
    document.getElementById('eligibilityUnit').value     = s.eligibilityUnit;
    document.getElementById('eligibilityValue').value    = s.eligibilityValue;
    document.getElementById('isActive').checked          = s.isActive;
    new bootstrap.Modal(document.getElementById('loanSettingModal')).show();
}

/* ── Save ── */
async function saveLoanSetting() {
    const form = document.getElementById('loanSettingForm');
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const payload = {
        id:                 document.getElementById('settingId').value || null,
        loanName:           document.getElementById('configName').value,
        duration:           document.getElementById('duration').value,
        durationUnit:       document.getElementById('durationUnit').value,
        penaltyPercentage:  document.getElementById('penaltyPercentage').value || 0,
        rolloverPercentage: document.getElementById('rolloverPercentage').value || 0,
        eligibilityUnit:    document.getElementById('eligibilityUnit').value,
        eligibilityValue:   document.getElementById('eligibilityValue').value,
        status:             document.getElementById('isActive').checked ? 'active' : 'inactive'
    };
    try {
        const res    = await fetch('/api/loan/settings/add', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.status) {
            bootstrap.Modal.getInstance(document.getElementById('loanSettingModal')).hide();
            location.reload();
        } else {
            alert(result.message || 'Failed to save loan setting.');
        }
    } catch { alert('An error occurred while saving loan setting.'); }
}

/* ── Toggle ── */
async function toggleStatus(id) {
    try {
        const res    = await fetch('/api/loan/settings/toggle', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id })
        });
        const result = await res.json();
        if (!result.status) { alert(result.message); return; }
        setTimeout(() => location.reload(), 300);
    } catch { alert('Failed to toggle setting'); }
}

/* ── Delete modal ── */
function showDeleteModal(id) {
    const s = loanSettings.find(x => x.id === id);
    if (!s) return;
    const unitShort = UNIT_LABELS[s.durationUnit] || s.durationUnit;
    document.getElementById('deleteConfigName').textContent    = s.name;
    document.getElementById('deleteConfigDetails').textContent = `${s.duration} ${unitShort} • ${s.penaltyPercentage}% penalty • ${s.rolloverPercentage}% rollover`;
    document.getElementById('deleteSettingId').value           = id;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}

/* ── Sidebar ── */
function toggleSidebar(e) {
    e.stopPropagation();
    document.getElementById('sidebar').classList.toggle('active');
    document.getElementById('sidebarOverlay').classList.toggle('active');
}
function closeSidebar() {
    document.getElementById('sidebar').classList.remove('active');
    document.getElementById('sidebarOverlay').classList.remove('active');
}
document.addEventListener('click', e => {
    const sb = document.getElementById('sidebar');
    if (window.innerWidth <= 992 && !sb.contains(e.target) && !e.target.closest('.fa-bars') && sb.classList.contains('active'))
        closeSidebar();
});

async function loadSidebarPendingCount() {
    try {
        const res  = await fetch('/admin/pending-approvals-count');
        const data = await res.json();
        const badge = document.getElementById('sidebarPendingBadge');
        if (!badge) return;
        badge.style.display = data.count > 0 ? 'inline-block' : 'none';
        if (data.count > 0) badge.textContent = data.count;
    } catch {}
}

/* ── Boot ── */
renderLoanSettings();
document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
</script>
</body>
</html>