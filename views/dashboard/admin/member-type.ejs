<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Membership Type Management - Admin Dashboard | Club De Stars</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white;
            z-index: 1040;
            transition: all 0.3s;
            overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30, 58, 138, 0.15);
            transform: translateX(0);
        }
        
        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.1);
        }
        
        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        
        .logo-box {
            width: 45px;
            height: 45px;
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--primary);
            font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            flex-shrink: 0;
        }
        
        .sidebar-title {
            font-size: 1.1rem;
            line-height: 1.2;
        }
        
        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: rgba(239, 68, 68, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(239, 68, 68, 0.3);
            font-weight: 600;
            font-size: 0.8rem;
            margin-top: 8px;
        }
        
        .sidebar-menu {
            padding: 1rem 0;
        }
        
        .sidebar-menu a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            padding: 0.875rem 1.5rem;
            display: flex;
            align-items: center;
            transition: all 0.3s;
            border-left: 3px solid transparent;
            font-weight: 500;
            font-size: 0.95rem;
        }
        
        .sidebar-menu a:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a.active {
            background: rgba(255,255,255,0.15);
            color: white;
            border-left-color: white;
        }
        
        .sidebar-menu a i {
            width: 24px;
            margin-right: 12px;
            font-size: 1.1rem;
            flex-shrink: 0;
        }
        
        .top-navbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: 70px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.08);
            z-index: 1030;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            transition: all 0.3s;
            border-bottom: 1px solid rgba(30, 58, 138, 0.1);
        }
        
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: 70px;
            padding: 1.5rem;
            min-height: calc(100vh - 70px);
            transition: all 0.3s;
        }
        
        .welcome-card {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white;
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30, 58, 138, 0.25);
            position: relative;
            overflow: hidden;
        }
        
        .welcome-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }
        
        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            transition: transform 0.3s, box-shadow 0.3s;
            height: 100%;
            border: 1px solid rgba(30, 58, 138, 0.05);
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(30, 58, 138, 0.15);
        }
        
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 1rem;
        }
        
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            background: white;
            border: 1px solid rgba(30, 58, 138, 0.05);
        }
        
        .card-header {
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.03) 0%, rgba(59, 130, 246, 0.03) 100%);
            border-bottom: 2px solid rgba(30, 58, 138, 0.1);
            padding: 1.25rem;
            border-radius: 16px 16px 0 0 !important;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(30, 58, 138, 0.3);
        }
        
        .table {
            font-size: 0.9rem;
        }
        
        .table th {
            font-weight: 600;
            color: var(--primary);
            border-bottom: 2px solid rgba(30, 58, 138, 0.1);
            white-space: nowrap;
        }
        
        .badge {
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.75rem;
        }
        
        .powered-by {
            position: fixed;
            bottom: 15px;
            right: 15px;
            background: white;
            padding: 10px 16px;
            border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.15);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--primary);
            z-index: 1000;
        }

        .membership-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            transition: transform 0.3s, box-shadow 0.3s;
            height: 100%;
            border: 2px solid rgba(30, 58, 138, 0.05);
            position: relative;
            overflow: hidden;
        }

        .membership-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(30, 58, 138, 0.15);
        }

        .membership-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        }

        .membership-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 1rem;
        }

        .membership-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 0.25rem;
        }

        .membership-price {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .membership-features {
            list-style: none;
            padding: 0;
            margin: 1rem 0;
        }

        .membership-features li {
            padding: 0.5rem 0;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .membership-features li i {
            color: var(--success);
            font-size: 0.85rem;
        }

        .membership-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.4rem 1rem;
            font-size: 0.85rem;
            border-radius: 8px;
        }

        .btn-outline-primary {
            border: 2px solid var(--primary);
            color: var(--primary);
            background: transparent;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-outline-primary:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
        }

        .btn-outline-danger {
            border: 2px solid var(--danger);
            color: var(--danger);
            background: transparent;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-outline-danger:hover {
            background: var(--danger);
            color: white;
            transform: translateY(-2px);
        }
        
        @media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }
            
            .sidebar.active {
                transform: translateX(0);
            }
            
            .top-navbar {
                left: 0;
            }
            
            .main-content {
                margin-left: 0;
                padding: 1rem;
            }
            
            .welcome-card {
                padding: 1.5rem;
            }
            
            .stat-card {
                padding: 1.25rem;
            }
            
            .powered-by {
                bottom: 10px;
                right: 10px;
                font-size: 0.7rem;
                padding: 8px 12px;
            }
            
            .table-responsive {
                font-size: 0.85rem;
            }
        }
        
        @media (max-width: 576px) {
            .top-navbar {
                height: 60px;
                padding: 0 1rem;
            }
            
            .main-content {
                margin-top: 60px;
                padding: 0.75rem;
            }
            
            .welcome-card {
                padding: 1.25rem;
                border-radius: 16px;
            }
            
            .stat-card {
                padding: 1rem;
            }
            
            .stat-icon {
                width: 50px;
                height: 50px;
                font-size: 1.4rem;
            }
            
            .card-header {
                padding: 1rem;
            }
            
            .sidebar-header {
                padding: 1.25rem;
            }
            
            .logo-box {
                width: 40px;
                height: 40px;
                font-size: 1.25rem;
            }
            
            .sidebar-title {
                font-size: 1rem;
            }

            .membership-card {
                padding: 1.25rem;
            }

            .membership-price {
                font-size: 1.5rem;
            }

            .membership-actions {
                flex-direction: column;
            }

            .membership-actions button {
                width: 100%;
            }
        }
        
        .modal-content {
            border-radius: 16px;
        }
        
        .modal-header {
            border-radius: 16px 16px 0 0;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white;
        }

        .modal-header .btn-close {
            filter: invert(1);
        }

        .loading-spinner {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }

        .loading-spinner.active {
            display: flex;
        }

        .content-section {
            animation: fadeIn 0.5s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-label {
            font-weight: 600;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(30, 58, 138, 0.15);
        }

        .settings-section {
            background: #f8f9fa;
            padding: 1.25rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            border-left: 4px solid var(--primary);
        }

        .settings-section h6 {
            color: var(--primary);
            font-weight: 700;
            margin-bottom: 1rem;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .input-group-text {
            background: var(--primary);
            color: white;
            border: none;
            font-weight: 600;
        }

        .form-text {
            font-size: 0.8rem;
            color: #6c757d;
        }

        /* ── Notification Modal ── */
        #notifModal .modal-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        }
        #notifModal .modal-header.success-header { background: linear-gradient(135deg, #065f46 0%, #10b981 100%); }
        #notifModal .modal-header.danger-header  { background: linear-gradient(135deg, #7f1d1d 0%, #ef4444 100%); }
        #notifModal .modal-header.warning-header { background: linear-gradient(135deg, #78350f 0%, #f59e0b 100%); }

        .notif-icon-wrap {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 1rem;
        }
        .notif-icon-wrap.success { background: rgba(16,185,129,.12); color: #10b981; }
        .notif-icon-wrap.danger  { background: rgba(239,68,68,.12);  color: #ef4444; }
        .notif-icon-wrap.warning { background: rgba(245,158,11,.12); color: #f59e0b; }
        .notif-icon-wrap.info    { background: rgba(6,182,212,.12);  color: #06b6d4; }

        /* ── Confirm Delete Modal ── */
        #confirmDeleteModal .modal-header {
            background: linear-gradient(135deg, #7f1d1d 0%, #ef4444 100%);
        }

        #sidebar { transform: translateX(0); }
        .sidebar-overlay { display: none; }

        @media (max-width: 992px) {
            #sidebar {
                transform: translateX(-100%);
                position: fixed;
                z-index: 1040;
                height: 100vh;
            }
            #sidebar.active { transform: translateX(0); }
            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0; left: 0;
                width: 100%; height: 100vh;
                background: rgba(0,0,0,0.4);
                z-index: 1035;
            }
            .sidebar-overlay.active { display: block; }
            .top-navbar { left: 0 !important; }
            .main-content { margin-left: 0 !important; }
        }
    </style>
</head>
<body>
    <!-- Loading Spinner -->
    <div class="loading-spinner" id="loadingSpinner">
        <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-box">C</div>
                <div>
                    <h5 class="mb-0 fw-bold sidebar-title" style="text-transform: uppercase;">Club De Stars</h5>
                    <small class="opacity-75" style="font-size: 0.75rem;">ADMIN PANEL</small>
                </div>
            </div>
            <div class="admin-badge">
                <i class="fas fa-shield-alt"></i>
                <span>Super Admin</span>
            </div>
        </div>
      <div class="sidebar-menu">
            <a href="/admin-dashboard"><i class="fas fa-users"></i> Members</a>
            <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i> Kiddies Accounts</a>
            <a href="/admin/manage/memberType" class="active"><i class="fas fa-id-card"></i> Membership Types</a>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i> Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i> Approvals<span id="sidebarPendingBadge" class="badge bg-danger ms-1" style="display:none;">0</span></a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i> Deposit Management</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i> Withdrawals</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-hand-holding-usd"></i> Extra Charges</a>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i> Loan Management</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i> Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i> External Loans</a>
            <a href="/admin/finance"><i class="fas fa-landmark"></i> Company Finance</a>
            <a href="#"><i class="fas fa-chart-pie"></i> ROI Distribution</a>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i> Manage Subscription</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i> Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i> Settings</a>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i> Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i> Admin Logs</a>
            <a href="/cds-cooperative/dashboard" class="mt-3" style="color:rgba(255,255,255,.6);"><i class="fas fa-sign-in-alt"></i> Back to Dashboard</a>
        </div>
    </div>

    <!-- Top Navbar -->
    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3"
           style="cursor: pointer; color: var(--primary); font-size: 1.5rem;"
           onclick="toggleSidebar()"></i>
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color: var(--primary)">Membership Type Management</h5>
            <small class="text-muted">Create and manage membership tiers and benefits</small>
        </div>
    </div>
    <div id="sidebarOverlay" class="sidebar-overlay" onclick="closeSidebar()"></div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="welcome-card position-relative">
            <div class="row align-items-center position-relative" style="z-index: 1;">
                <div class="col-md-8">
                    <h2 class="mb-2 fw-bold">Membership Type Management</h2>
                    <p class="mb-0 opacity-90">Define membership tiers, pricing, and financial rules for your cooperative</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <button class="btn btn-light fw-semibold" onclick="openAddModal()">
                        <i class="fas fa-plus me-2"></i>Add New Type
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white;">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Total Types</p>
                    <h3 class="mb-0 fw-bold" id="totalTypes">0</h3>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Active</p>
                    <h3 class="mb-0 fw-bold" id="activeTypes">0</h3>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                        <i class="fas fa-users"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Members</p>
                    <h3 class="mb-0 fw-bold" id="totalMembers">0</h3>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white;">
                        <i class="fas fa-percent"></i>
                    </div>
                    <p class="text-muted mb-1 fw-semibold small">Avg. Interest</p>
                    <h3 class="mb-0 fw-bold" id="avgInterest">0%</h3>
                </div>
            </div>
        </div>

        <!-- Membership Types Grid -->
        <div class="row g-4" id="membershipGrid"></div>
    </div>

    <!-- Powered By Footer -->
    <div class="powered-by">
        Powered by <strong style="color: var(--primary);">JESZ LIMITED</strong>
    </div>


    <!-- ══════════════════════════════════════════════
         NOTIFICATION MODAL (replaces all alert())
    ══════════════════════════════════════════════ -->
    <div class="modal fade" id="notifModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header" id="notifModalHeader">
                    <h5 class="modal-title text-white" id="notifModalTitle">
                        <i id="notifModalTitleIcon" class="fas fa-info-circle me-2"></i>
                        <span id="notifModalTitleText">Notification</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="notif-icon-wrap" id="notifIconWrap">
                        <i id="notifBodyIcon" class="fas fa-info-circle"></i>
                    </div>
                    <p id="notifMessage" class="mb-0 fs-6"></p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn btn-primary px-4" id="notifOkBtn" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>


    <!-- ══════════════════════════════════════════════
         CONFIRM DELETE MODAL
    ══════════════════════════════════════════════ -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title text-white">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="notif-icon-wrap danger">
                        <i class="fas fa-trash-alt"></i>
                    </div>
                    <p class="mb-1 fs-6 fw-semibold">Are you sure you want to delete this membership type?</p>
                    <p class="text-muted small mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer justify-content-center gap-2">
                    <button class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger px-4" id="confirmDeleteBtn">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- ══════════════════════════════════════════════
         UNAUTHORIZED ACCESS MODAL
    ══════════════════════════════════════════════ -->
    <div class="modal fade" id="unauthorizedModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-shield-alt me-2"></i>Unauthorized Action
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fas fa-lock fa-3x text-danger mb-3"></i>
                    <p id="unauthorizedMessage" class="mb-0">You do not have permission to perform this action.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn btn-danger px-4" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>


    <!-- Add/Edit Membership Type Modal -->
    <div class="modal fade" id="membershipModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="fas fa-plus-circle me-2"></i>Add Membership Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="membershipForm">
                        <input type="hidden" id="membershipId">

                        <!-- Basic Information -->
                        <div class="settings-section">
                            <h6><i class="fas fa-info-circle me-2"></i>Basic Information</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="typeName" class="form-label">Membership Type Name *</label>
                                    <input type="text" class="form-control" id="typeName" required placeholder="e.g., Club Member">
                                </div>
                                <div class="col-md-3">
                                    <label for="shortName" class="form-label">Short Code *</label>
                                    <input type="text" class="form-control" id="shortName" required placeholder="e.g., CDS">
                                </div>
                                <div class="col-md-3">
                                    <label for="interestRate" class="form-label">Interest Rate (%) *</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="interestRate" placeholder="5.5" min="0" max="100" step="0.1" required>
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="isDefault">
                                        <label class="form-check-label" for="isDefault">Set as default membership type</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Withdrawal Settings -->
                        <div class="settings-section">
                            <h6><i class="fas fa-money-bill-wave me-2"></i>Withdrawal Settings</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="forceWithdrawalPenalty" class="form-label">Force Withdrawal Penalty (%)</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="forceWithdrawalPenalty" placeholder="2" min="0" max="100" step="0.1" value="2">
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <small class="form-text">Penalty charged when member makes forced withdrawal</small>
                                </div>
                                <div class="col-md-6">
                                    <label for="earlyWithdrawalPeriodMonths" class="form-label">Early Withdrawal Period (Months)</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="earlyWithdrawalPeriodMonths" placeholder="6" min="0" step="1" value="6">
                                        <span class="input-group-text">months</span>
                                    </div>
                                    <small class="form-text">Period before withdrawal is considered early</small>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="allowForcedWithdrawal" checked>
                                        <label class="form-check-label" for="allowForcedWithdrawal">Allow forced withdrawals for this membership type</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Loan Settings -->
                        <div class="settings-section">
                            <h6><i class="fas fa-hand-holding-usd me-2"></i>Loan Settings</h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label for="loanRolloverRate" class="form-label">Loan Rollover Rate (%)</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="loanRolloverRate" placeholder="0" min="0" max="100" step="0.1" value="0">
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <small class="form-text">Interest charged when rolling over a loan</small>
                                </div>
                                <div class="col-md-4">
                                    <label for="loanPenaltyRate" class="form-label">Loan Penalty Rate</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="loanPenaltyRate" placeholder="0" min="0" max="100" step="0.1" value="0">
                                        <select class="form-select" id="loanPenaltyType" style="max-width: 120px;">
                                            <option value="percentage">%</option>
                                            <option value="fixed">₦</option>
                                        </select>
                                    </div>
                                    <small class="form-text">Penalty for late loan payments</small>
                                </div>
                                <div class="col-md-4">
                                    <label for="gracePeriodDays" class="form-label">Grace Period (Days)</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="gracePeriodDays" placeholder="0" min="0" step="1" value="0">
                                        <span class="input-group-text">days</span>
                                    </div>
                                    <small class="form-text">Days before penalties apply</small>
                                </div>
                                <div class="col-md-4">
                                    <label for="maxLoanAmount" class="form-label">Max Loan Amount (₦)</label>
                                    <input type="number" class="form-control" id="maxLoanAmount" placeholder="0" min="0" step="1000" value="0">
                                    <small class="form-text">0 = unlimited</small>
                                </div>
                                <div class="col-md-4">
                                    <label for="minDepositBeforeLoan" class="form-label">Min Deposit Before Loan (₦)</label>
                                    <input type="number" class="form-control" id="minDepositBeforeLoan" placeholder="0" min="0" step="1000" value="0">
                                    <small class="form-text">Minimum deposit required for loan eligibility</small>
                                </div>
                                <div class="col-md-4">
                                    <label for="loanToDepositRatio" class="form-label">Loan to Deposit Ratio (%)</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="loanToDepositRatio" placeholder="80" min="0" max="100" step="1" value="80">
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <small class="form-text">Max loan as % of total deposits</small>
                                </div>
                            </div>
                        </div>

                        <!-- ROI/Dividend Settings -->
                        <div class="settings-section">
                            <h6><i class="fas fa-chart-line me-2"></i>ROI & Dividend Settings</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="roiDistributionFrequency" class="form-label">Distribution Frequency</label>
                                    <select class="form-select" id="roiDistributionFrequency">
                                        <option value="monthly">Monthly</option>
                                        <option value="quarterly">Quarterly</option>
                                        <option value="biannually">Bi-annually</option>
                                        <option value="annually">Annually</option>
                                    </select>
                                    <small class="form-text">How often ROI is distributed</small>
                                </div>
                                <div class="col-md-6">
                                    <label for="minimumBalanceForROI" class="form-label">Min Balance for ROI (₦)</label>
                                    <input type="number" class="form-control" id="minimumBalanceForROI" placeholder="0" min="0" step="1000" value="0">
                                    <small class="form-text">Minimum balance required to earn ROI</small>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveMembershipType()">
                        <i class="fas fa-save me-2"></i>Save Membership Type
                    </button>
                </div>
            </div>
        </div>
    </div>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        // MemberTypes will come from backend EJS
        let membershipTypes = <%- JSON.stringify(memberTypes) %>;
        let editingId = null;
        let membershipModal;
        let notifModal;
        let confirmDeleteModal;
        let unauthorizedModal;
        let pendingDeleteId = null;   // stores ID awaiting confirmation

        document.addEventListener('DOMContentLoaded', function () {
            membershipModal   = new bootstrap.Modal(document.getElementById('membershipModal'));
            notifModal        = new bootstrap.Modal(document.getElementById('notifModal'));
            confirmDeleteModal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
            unauthorizedModal = new bootstrap.Modal(document.getElementById('unauthorizedModal'));

            // Wire up the confirm-delete button
            document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
                confirmDeleteModal.hide();
                if (pendingDeleteId) {
                    executeDelete(pendingDeleteId);
                    pendingDeleteId = null;
                }
            });

            loadMembershipTypes();
            updateStats();
        });


        /* ═══════════════════════════════════════════════
           NOTIFICATION HELPER  –  replaces all alert()
           type: 'success' | 'danger' | 'warning' | 'info'
           onClose (optional): callback after OK
        ═══════════════════════════════════════════════ */
        function showNotif(message, type = 'info', onClose = null) {
            const config = {
                success: { headerClass: 'success-header', iconClass: 'success', icon: 'fa-check-circle',  titleIcon: 'fa-check-circle',  title: 'Success'  },
                danger:  { headerClass: 'danger-header',  iconClass: 'danger',  icon: 'fa-times-circle',  titleIcon: 'fa-times-circle',  title: 'Error'    },
                warning: { headerClass: 'warning-header', iconClass: 'warning', icon: 'fa-exclamation-triangle', titleIcon: 'fa-exclamation-triangle', title: 'Warning' },
                info:    { headerClass: '',               iconClass: 'info',    icon: 'fa-info-circle',   titleIcon: 'fa-info-circle',   title: 'Info'     },
            };

            const c = config[type] || config.info;
            const header    = document.getElementById('notifModalHeader');
            const titleIcon = document.getElementById('notifModalTitleIcon');
            const titleText = document.getElementById('notifModalTitleText');
            const iconWrap  = document.getElementById('notifIconWrap');
            const bodyIcon  = document.getElementById('notifBodyIcon');
            const msgEl     = document.getElementById('notifMessage');
            const okBtn     = document.getElementById('notifOkBtn');

            // Reset header classes
            header.className = 'modal-header';
            if (c.headerClass) header.classList.add(c.headerClass);

            titleIcon.className = `fas ${c.titleIcon} me-2`;
            titleText.textContent = c.title;

            iconWrap.className = `notif-icon-wrap ${c.iconClass}`;
            bodyIcon.className = `fas ${c.icon}`;

            msgEl.textContent = message;

            // Remove old listener, add new one
            const newBtn = okBtn.cloneNode(true);
            okBtn.parentNode.replaceChild(newBtn, okBtn);
            if (onClose) {
                newBtn.addEventListener('click', onClose, { once: true });
            }

            notifModal.show();
        }


        /* ═══════════════════════════════════════════
           UNAUTHORIZED HELPER
        ═══════════════════════════════════════════ */
        function showUnauthorized(reason = 'permission') {
            const messageMap = {
                auth:       'Your session has expired. Please login again.',
                permission: "You don't have permission to perform this action.",
                inactive:   'Your admin role is currently inactive.',
                norole:     'No role is assigned to your account.',
                member:     'Members are not allowed to access admin actions.',
            };
            document.getElementById('unauthorizedMessage').innerText =
                messageMap[reason] || 'Unauthorized action.';
            unauthorizedModal.show();
        }


        /* ═══════════════════════════════════════════
           CARD RENDERING
        ═══════════════════════════════════════════ */
        function loadMembershipTypes() {
            const grid = document.getElementById('membershipGrid');
            grid.innerHTML = '';

            membershipTypes.forEach(type => {
                const defaultBadge = type.isDefault
                    ? `<span class="badge bg-warning text-dark ms-2">Default</span>`
                    : '';

                const card = `
                    <div class="col-lg-4 col-md-6">
                        <div class="membership-card">
                            <div class="membership-header">
                                <div>
                                    <div class="membership-title">${type.name}${defaultBadge}</div>
                                    <small class="text-muted">${type.shortCode}</small>
                                </div>
                                <span class="badge bg-success">${type.interestRate}%</span>
                            </div>
                            <ul class="membership-features">
                                <li><i class="fas fa-check-circle"></i><span>Withdrawal Penalty: <strong>${type.forceWithdrawalPenalty || 0}%</strong></span></li>
                                <li><i class="fas fa-check-circle"></i><span>Loan Rollover: <strong>${type.loanRolloverRate || 0}%</strong></span></li>
                                <li><i class="fas fa-check-circle"></i><span>Loan Penalty: <strong>${type.loanPenaltyRate || 0}${type.loanPenaltyType === 'fixed' ? '₦' : '%'}</strong></span></li>
                                <li><i class="fas fa-check-circle"></i><span>Grace Period: <strong>${type.gracePeriodDays || 0} days</strong></span></li>
                                <li><i class="fas fa-check-circle"></i><span>Max Loan: <strong>${type.maxLoanAmount ? '₦' + type.maxLoanAmount.toLocaleString() : 'Unlimited'}</strong></span></li>
                                <li><i class="fas fa-check-circle"></i><span>ROI Distribution: <strong>${formatFrequency(type.roiDistributionFrequency)}</strong></span></li>
                            </ul>
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <small class="text-muted"><i class="fas fa-users me-1"></i> ${type.members || 0} members</small>
                            </div>
                            <div class="membership-actions">
                                <button class="btn btn-sm btn-outline-primary flex-fill" onclick="editMembershipType('${type._id}')">
                                    <i class="fas fa-edit me-1"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteMembershipType('${type._id}')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                grid.innerHTML += card;
            });
        }

        function formatFrequency(freq) {
            const map = { monthly: 'Monthly', quarterly: 'Quarterly', biannually: 'Bi-annually', annually: 'Annually' };
            return map[freq] || 'Monthly';
        }

        function updateStats() {
            document.getElementById('totalTypes').innerText  = membershipTypes.length;
            document.getElementById('activeTypes').innerText = membershipTypes.filter(t => t.active !== false).length;
            document.getElementById('totalMembers').innerText = membershipTypes.reduce((s, t) => s + (t.members || 0), 0);
            const avg = membershipTypes.reduce((s, t) => s + (t.interestRate || 0), 0) / (membershipTypes.length || 1);
            document.getElementById('avgInterest').innerText = avg.toFixed(1) + '%';
        }


        /* ═══════════════════════════════════════════
           ADD MODAL
        ═══════════════════════════════════════════ */
        function openAddModal() {
            editingId = null;
            document.getElementById('membershipForm').reset();
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Add Membership Type';
            document.getElementById('forceWithdrawalPenalty').value  = 2;
            document.getElementById('loanRolloverRate').value        = 0;
            document.getElementById('loanPenaltyRate').value         = 0;
            document.getElementById('gracePeriodDays').value         = 0;
            document.getElementById('maxLoanAmount').value           = 0;
            document.getElementById('minDepositBeforeLoan').value    = 0;
            document.getElementById('loanToDepositRatio').value      = 80;
            document.getElementById('earlyWithdrawalPeriodMonths').value = 6;
            document.getElementById('minimumBalanceForROI').value    = 0;
            document.getElementById('allowForcedWithdrawal').checked = true;
            membershipModal.show();
        }


        /* ═══════════════════════════════════════════
           EDIT MODAL
        ═══════════════════════════════════════════ */
        function editMembershipType(id) {
            const type = membershipTypes.find(t => t._id === id);
            if (!type) return;
            editingId = id;

            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Membership Type';
            document.getElementById('membershipId').value            = type._id;
            document.getElementById('typeName').value                = type.name;
            document.getElementById('shortName').value               = type.shortCode;
            document.getElementById('interestRate').value            = type.interestRate;
            document.getElementById('isDefault').checked             = type.isDefault || false;
            document.getElementById('forceWithdrawalPenalty').value  = type.forceWithdrawalPenalty || 2;
            document.getElementById('earlyWithdrawalPeriodMonths').value = type.earlyWithdrawalPeriodMonths || 6;
            document.getElementById('allowForcedWithdrawal').checked = type.allowForcedWithdrawal !== false;
            document.getElementById('loanRolloverRate').value        = type.loanRolloverRate || 0;
            document.getElementById('loanPenaltyRate').value         = type.loanPenaltyRate || 0;
            document.getElementById('loanPenaltyType').value         = type.loanPenaltyType || 'percentage';
            document.getElementById('gracePeriodDays').value         = type.gracePeriodDays || 0;
            document.getElementById('maxLoanAmount').value           = type.maxLoanAmount || 0;
            document.getElementById('minDepositBeforeLoan').value    = type.minDepositBeforeLoan || 0;
            document.getElementById('loanToDepositRatio').value      = type.loanToDepositRatio || 80;
            document.getElementById('roiDistributionFrequency').value = type.roiDistributionFrequency || 'monthly';
            document.getElementById('minimumBalanceForROI').value    = type.minimumBalanceForROI || 0;

            membershipModal.show();
        }


        /* ═══════════════════════════════════════════
           SAVE (CREATE / UPDATE)
        ═══════════════════════════════════════════ */
        async function saveMembershipType() {
            const id        = document.getElementById('membershipId').value;
            const name      = document.getElementById('typeName').value.trim();
            const shortCode = document.getElementById('shortName').value.trim();

            if (!name || !shortCode) {
                showNotif('Please fill in all required fields.', 'warning');
                return;
            }

            const payload = {
                id,
                name,
                shortCode,
                interestRate:               parseFloat(document.getElementById('interestRate').value) || 0,
                isDefault:                  document.getElementById('isDefault').checked,
                forceWithdrawalPenalty:     parseFloat(document.getElementById('forceWithdrawalPenalty').value) || 0,
                earlyWithdrawalPeriodMonths:parseInt(document.getElementById('earlyWithdrawalPeriodMonths').value) || 0,
                allowForcedWithdrawal:      document.getElementById('allowForcedWithdrawal').checked,
                loanRolloverRate:           parseFloat(document.getElementById('loanRolloverRate').value) || 0,
                loanPenaltyRate:            parseFloat(document.getElementById('loanPenaltyRate').value) || 0,
                loanPenaltyType:            document.getElementById('loanPenaltyType').value,
                gracePeriodDays:            parseInt(document.getElementById('gracePeriodDays').value) || 0,
                maxLoanAmount:              parseFloat(document.getElementById('maxLoanAmount').value) || 0,
                minDepositBeforeLoan:       parseFloat(document.getElementById('minDepositBeforeLoan').value) || 0,
                loanToDepositRatio:         parseFloat(document.getElementById('loanToDepositRatio').value) || 80,
                roiDistributionFrequency:   document.getElementById('roiDistributionFrequency').value,
                minimumBalanceForROI:       parseFloat(document.getElementById('minimumBalanceForROI').value) || 0,
            };

            try {
                const response = await fetch('/admin/manage/memberType', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                    body: JSON.stringify(payload),
                });

                if (response.status === 401) {
                    membershipModal.hide();
                    // Wait for modal to fully close before showing next
                    document.getElementById('membershipModal').addEventListener('hidden.bs.modal', function onHidden() {
                        this.removeEventListener('hidden.bs.modal', onHidden);
                        showUnauthorized('auth');
                        setTimeout(() => { window.location.href = '/login'; }, 1500);
                    });
                    return;
                }

                if (response.status === 403) {
                    let errorData = {};
                    try { errorData = await response.json(); } catch (_) {}
                    membershipModal.hide();
                    // Wait for modal to fully close before showing next
                    document.getElementById('membershipModal').addEventListener('hidden.bs.modal', function onHidden() {
                        this.removeEventListener('hidden.bs.modal', onHidden);
                        showUnauthorized(errorData.reason || 'permission');
                    });
                    return;
                }

                const data = await response.json();
                if (data.success) {
                    membershipModal.hide();
                    showNotif(
                        id ? 'Membership type updated successfully!' : 'Membership type added successfully!',
                        'success',
                        () => location.reload()
                    );
                } else {
                    showNotif(data.message || 'Failed to save membership type.', 'danger');
                }

            } catch (err) {
                console.error(err);
                showNotif('An unexpected error occurred while saving. Please try again.', 'danger');
            }
        }


        /* ═══════════════════════════════════════════
           DELETE  –  Step 1: show confirm dialog
        ═══════════════════════════════════════════ */
        function deleteMembershipType(id) {
            pendingDeleteId = id;
            confirmDeleteModal.show();
        }

        /* ═══════════════════════════════════════════
           DELETE  –  Step 2: execute after confirmation
        ═══════════════════════════════════════════ */
        async function executeDelete(id) {
            try {
                const response = await fetch(`/admin/manage/memberType/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                });

                if (response.status === 401) {
                    showUnauthorized('auth');
                    setTimeout(() => { window.location.href = '/login'; }, 1500);
                    return;
                }

                if (response.status === 403) {
                    let errorData = {};
                    try { errorData = await response.json(); } catch (_) {}
                    showUnauthorized(errorData.reason || 'permission');
                    return;
                }

                const data = await response.json();
                if (data.success) {
                    showNotif('Membership type deleted successfully.', 'success', () => location.reload());
                } else {
                    showNotif(data.message || 'Failed to delete membership type.', 'danger');
                }

            } catch (err) {
                console.error(err);
                showNotif('An unexpected error occurred while deleting. Please try again.', 'danger');
            }
        }
    </script>

    <script>
        function toggleSidebar() {
            if (window.innerWidth <= 992) {
                document.getElementById('sidebar').classList.toggle('active');
                document.getElementById('sidebarOverlay').classList.toggle('active');
            }
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('active');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }
    </script>

    <script>
        async function loadSidebarPendingCount() {
            try {
                const res  = await fetch('/admin/pending-approvals-count');
                const data = await res.json();
                const badge = document.getElementById('sidebarPendingBadge');
                if (!badge) return;
                if (data.count > 0) {
                    badge.style.display = 'inline-block';
                    badge.textContent = data.count;
                } else {
                    badge.style.display = 'none';
                }
            } catch (err) {
                console.error('Sidebar count error:', err);
            }
        }

        document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
    </script>
</body>
</html>