    <div class="mi g"><span>Approved</span><span>${data.filter(p=>p.status==='approved').length}</span></div>
    <div class="mi a"><span>Pending</span><span>${data.filter(p=>p.status==='pending').length}</span></div>
    <div class="mi r"><span>Rejected</span><span>${data.filter(p=>p.status==='rejected').length}</span></div>
    <div class="mi g"><span>Repayments</span><span>${data.filter(p=>p.transactionType==='repayment').length}</span></div>
    <div class="mi r"><span>Penalties</span><span>${data.filter(p=>p.transactionType==='penalty').length}</span></div>
    <div class="mi"><span>Rollovers</span><span>${data.filter(p=>p.transactionType==='rollover').length}</span></div>
    <div class="mi g"><span>Grand Total</span><span>₦${totalAmt.toLocaleString('en-NG',{minimumFractionDigits:2})}</span></div>
