<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loan Payments - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --purple: #8b5cf6;
            --sidebar-width: 280px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; z-index: 1040;
            transition: all 0.3s; overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30,58,138,0.15);
        }
        .sidebar-header { padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.1); }
        .logo-container { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .logo-box {
            width: 45px; height: 45px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; color: var(--primary); font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2); flex-shrink: 0;
        }
        .sidebar-title { font-size: 1.1rem; line-height: 1.2; }
        .admin-badge {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 12px; background: rgba(239,68,68,0.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,0.3);
            font-weight: 600; font-size: 0.8rem; margin-top: 8px;
        }
        .sidebar-menu { padding: 1rem 0; }
        .sidebar-menu a {
            color: rgba(255,255,255,0.85); text-decoration: none;
            padding: 0.875rem 1.5rem; display: flex; align-items: center;
            transition: all 0.3s; border-left: 3px solid transparent;
            font-weight: 500; font-size: 0.95rem;
        }
        .sidebar-menu a:hover { background: rgba(255,255,255,0.1); color: white; border-left-color: white; }
        .sidebar-menu a.active { background: rgba(255,255,255,0.15); color: white; border-left-color: white; }
        .sidebar-menu a i { width: 24px; margin-right: 12px; font-size: 1.1rem; flex-shrink: 0; }

        /* ── Navbar ── */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: 70px;
            background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,0.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            transition: all 0.3s; border-bottom: 1px solid rgba(30,58,138,0.1);
        }

        /* ── Main Content ── */
        .main-content { margin-left: var(--sidebar-width); margin-top: 70px; padding: 1.5rem; min-height: calc(100vh - 70px); transition: all 0.3s; }

        /* ── Page Header ── */
        .page-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30,58,138,0.25); position: relative; overflow: hidden;
        }
        .page-header::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,0.05); border-radius: 50%;
        }

        /* ── Stats Cards ── */
        .stats-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,0.08); transition: all 0.3s;
            border: 2px solid transparent; height: 100%; position: relative; overflow: hidden;
        }
        .stats-card::before {
            content: ''; position: absolute; top: 0; right: 0;
            width: 100px; height: 100px; background: rgba(30,58,138,0.03);
            border-radius: 0 16px 0 100%;
        }
        .stats-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,0.15); border-color: var(--primary); }
        .stats-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 1rem; }
        .stats-value { font-size: 1.6rem; font-weight: bold; margin-bottom: 0.5rem; }
        .stats-label { color: var(--secondary); font-size: 0.9rem; font-weight: 500; }

        /* ── Card ── */
        .card { border: none; border-radius: 16px; box-shadow: 0 8px 20px rgba(30,58,138,0.08); background: white; border: 1px solid rgba(30,58,138,0.05); }
        .card-header {
            background: linear-gradient(135deg, rgba(30,58,138,0.03) 0%, rgba(59,130,246,0.03) 100%);
            border-bottom: 2px solid rgba(30,58,138,0.1); padding: 1.25rem; border-radius: 16px 16px 0 0 !important;
        }

        /* ── Type Badges ── */
        .type-badge {
            padding: 4px 10px; border-radius: 20px; font-size: 0.72rem;
            font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; display: inline-flex; align-items: center; gap: 4px;
        }
        .type-repayment  { background: rgba(16,185,129,0.1);  color: #059669; border: 1px solid rgba(16,185,129,0.3); }
        .type-rollover   { background: rgba(139,92,246,0.1);  color: #7c3aed; border: 1px solid rgba(139,92,246,0.3); }
        .type-interest   { background: rgba(6,182,212,0.1);   color: #0891b2; border: 1px solid rgba(6,182,212,0.3); }
        .type-penalty    { background: rgba(239,68,68,0.1);   color: #dc2626; border: 1px solid rgba(239,68,68,0.3); }
        .type-disbursement { background: rgba(245,158,11,0.1); color: #d97706; border: 1px solid rgba(245,158,11,0.3); }

        /* ── Status Badges ── */
        .status-badge { padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .status-pending  { background: rgba(245,158,11,0.1); color: var(--warning); border: 1px solid rgba(245,158,11,0.3); }
        .status-approved { background: rgba(16,185,129,0.1); color: var(--success); border: 1px solid rgba(16,185,129,0.3); }
        .status-rejected { background: rgba(239,68,68,0.1);  color: var(--danger);  border: 1px solid rgba(239,68,68,0.3); }

        /* ── Action Buttons ── */
        .action-btn { padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; transition: all 0.3s; border: none; cursor: pointer; }
        .btn-approve { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; }
        .btn-approve:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(16,185,129,0.3); }
        .btn-reject  { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }
        .btn-reject:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(239,68,68,0.3); }
        .btn-view    { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; }
        .btn-view:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(59,130,246,0.3); }

        /* ── Filter Section ── */
        .filter-section { background: white; border-radius: 12px; padding: 1rem; margin-bottom: 1rem; box-shadow: 0 4px 12px rgba(30,58,138,0.06); }
        .filter-btn { padding: 8px 16px; border-radius: 8px; border: 2px solid rgba(30,58,138,0.1); background: white; color: var(--primary); font-weight: 600; transition: all 0.3s; cursor: pointer; font-size: 0.85rem; }
        .filter-btn:hover, .filter-btn.active { background: var(--primary); color: white; border-color: var(--primary); }
        .filter-btn.filter-type { border-color: rgba(139,92,246,0.2); color: var(--purple); }
        .filter-btn.filter-type:hover, .filter-btn.filter-type.active { background: var(--purple); color: white; border-color: var(--purple); }

        /* ── Table ── */
        .table-responsive { border-radius: 0 0 16px 16px; overflow: hidden; }
        .table { margin: 0; }
        .table thead { background: linear-gradient(135deg, rgba(30,58,138,0.05) 0%, rgba(59,130,246,0.05) 100%); }
        .table thead th { border: none; padding: 1rem; font-weight: 600; color: var(--primary); white-space: nowrap; }
        .table tbody td { padding: 0.85rem 1rem; vertical-align: middle; border-bottom: 1px solid rgba(30,58,138,0.05); }
        .table tbody tr:last-child td { border-bottom: none; }
        .table tbody tr:hover { background: rgba(30,58,138,0.02); }

        /* ── Breakdown Bar ── */
        .breakdown-bar { display: flex; height: 6px; border-radius: 3px; overflow: hidden; gap: 1px; margin-top: 6px; }
        .breakdown-bar .seg-principal { background: #10b981; }
        .breakdown-bar .seg-interest  { background: #06b6d4; }
        .breakdown-bar .seg-penalty   { background: #ef4444; }

        /* ── Detail Modal specifics ── */
        .detail-chip {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 5px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;
        }
        .breakdown-row { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-bottom: 1px dashed rgba(30,58,138,0.1); }
        .breakdown-row:last-child { border-bottom: none; }

        /* ── Alert Modal ── */
        #alertModal .modal-content { border: none; border-radius: 18px; overflow: hidden; box-shadow: 0 20px 60px rgba(30,58,138,0.2); }
        #alertModal .modal-header  { padding: 1.25rem 1.5rem; border-bottom: none; }
        #alertModal .modal-body    { padding: 1.5rem; text-align: center; }
        #alertModal .alert-icon-wrapper { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 2rem; }
        #alertModal .modal-footer  { border-top: none; padding: 0 1.5rem 1.5rem; justify-content: center; }

        /* ── Powered By ── */
        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,0.15); font-size: 0.8rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        /* ── Responsive ── */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
            .table thead { display: none; }
            .table tbody tr { display: block; margin-bottom: 1rem; border: 2px solid rgba(30,58,138,0.1); border-radius: 12px; overflow: hidden; background: white; }
            .table tbody td { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-bottom: 1px solid rgba(30,58,138,0.05); }
            .table tbody td:last-child { border-bottom: none; }
            .table tbody td::before { content: attr(data-label); font-weight: 600; color: var(--primary); margin-right: 1rem; }
        }

        @keyframes fadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .fade-in { animation: fadeIn 0.5s ease; }
    </style>
</head>
<body>

<!-- ══ Sidebar ══ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-container">
            <div class="logo-box">C</div>
            <div>
                <h5 class="mb-0 fw-bold sidebar-title" style="text-transform:uppercase;">Club De Stars</h5>
                <small class="opacity-75" style="font-size:0.75rem;">ADMIN PANEL</small>
            </div>
        </div>
        <div class="admin-badge"><i class="fas fa-shield-alt"></i><span>SUPER ADMIN</span></div>
    </div>
    <div class="sidebar-menu">
        <a href="/admin-dashboard"><i class="fas fa-users"></i> Members</a>
        <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i> Kiddies Accounts</a>
        <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i> Membership Types</a>
        <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i> Payments</a>
        <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i> Approvals<span id="sidebarPendingBadge" class="badge bg-danger ms-1" style="display:none;">0</span></a>
        <a href="/admin/manage-deposits"><i class="fas fa-coins"></i> Deposit Management</a>
        <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i> Withdrawals</a>
        <a href="/admin/manage-extra-charges"><i class="fas fa-hand-holding-usd"></i> Extra Charges</a>
        <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i> Loan Management</a>
        <a href="/admin/loan/settings"><i class="fas fa-cogs"></i> Loan Settings</a>
        <a href="/admin/loan-payments" class="active"><i class="fas fa-file-invoice-dollar"></i> Loan Payments</a>
        <a href="/admin/external-loans"><i class="fas fa-building"></i> External Loans</a>
        <a href="/admin/finance"><i class="fas fa-landmark"></i> Company Finance</a>
        <a href="#"><i class="fas fa-chart-pie"></i> ROI Distribution</a>
        <a href="/manage-subscriptions"><i class="fas fa-cube"></i> Manage Subscription</a>
        <a href="/manage-roles"><i class="fas fa-user-shield"></i> Roles &amp; Permissions</a>
        <a href="/admin/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/admin/reports"><i class="fas fa-file-alt"></i> Reports</a>
        <a href="/admin/logs"><i class="fas fa-history"></i> Admin Logs</a>
        <a href="/cds-cooperative/dashboard" class="mt-3" style="color:rgba(255,255,255,.6);"><i class="fas fa-sign-in-alt"></i> Back to Dashboard</a>
    </div>
</div>

<!-- ══ Top Navbar ══ -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;" onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
    <div class="flex-grow-1 d-none d-lg-block">
        <h5 class="mb-0 fw-bold" style="color:var(--primary)">Loan Payment Management</h5>
        <small class="text-muted">Review, approve and track all loan repayments</small>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="badge bg-light text-dark"><i class="fas fa-calendar me-1"></i><span id="currentDate"></span></div>
    </div>
</div>

<!-- ══ Main Content ══ -->
<div class="main-content">

    <!-- Page Header -->
    <div class="page-header position-relative">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-md-8">
                <h2 class="mb-2 fw-bold"><i class="fas fa-file-invoice-dollar me-3"></i>Loan Payment Management</h2>
                <p class="mb-0 opacity-90">Monitor repayments, rollovers, interest &amp; penalty settlements</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <button class="btn btn-light" onclick="refreshData()"><i class="fas fa-sync-alt me-2"></i>Refresh</button>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;"><i class="fas fa-hand-holding-usd"></i></div>
                <div class="stats-value" style="color:var(--success);font-size:14px;">₦<%= stats.totalRepaid.toLocaleString() %></div>
                <div class="stats-label">Total Repaid</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;"><i class="fas fa-clock"></i></div>
                <div class="stats-value" style="color:var(--warning);font-size:14px;"><%= stats.pendingCount %></div>
                <div class="stats-label">Pending Approvals</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#ef4444,#dc2626);color:white;"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="stats-value" style="color:var(--danger);font-size:14px;">₦<%= stats.totalPenalties.toLocaleString() %></div>
                <div class="stats-label">Total Penalties Collected</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:white;"><i class="fas fa-sync-alt"></i></div>
                <div class="stats-value" style="color:var(--purple);font-size:14px;"><%= stats.rolloversCount %></div>
                <div class="stats-label">Rollovers This Month</div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="filter-section">
        <div class="row g-2 align-items-center">
            <!-- Status filters -->
            <div class="col-12">
                <small class="text-muted fw-semibold me-2">STATUS:</small>
                <div class="d-inline-flex flex-wrap gap-2">
                    <button class="filter-btn active" onclick="applyFilter('status','all',this)"><i class="fas fa-list me-1"></i>All</button>
                    <button class="filter-btn" onclick="applyFilter('status','pending',this)"><i class="fas fa-clock me-1"></i>Pending</button>
                    <button class="filter-btn" onclick="applyFilter('status','approved',this)"><i class="fas fa-check me-1"></i>Approved</button>
                    <button class="filter-btn" onclick="applyFilter('status','rejected',this)"><i class="fas fa-times me-1"></i>Rejected</button>
                </div>
            </div>
            <!-- Type filters -->
            <div class="col-12 mt-2">
                <small class="text-muted fw-semibold me-2">TYPE:</small>
                <div class="d-inline-flex flex-wrap gap-2">
                    <button class="filter-btn filter-type active" onclick="applyFilter('type','all',this)"><i class="fas fa-th me-1"></i>All Types</button>
                    <button class="filter-btn filter-type" onclick="applyFilter('type','repayment',this)"><i class="fas fa-hand-holding-usd me-1"></i>Repayment</button>
                    <button class="filter-btn filter-type" onclick="applyFilter('type','rollover',this)"><i class="fas fa-sync-alt me-1"></i>Rollover</button>
                    <button class="filter-btn filter-type" onclick="applyFilter('type','interest',this)"><i class="fas fa-percentage me-1"></i>Interest</button>
                    <button class="filter-btn filter-type" onclick="applyFilter('type','penalty',this)"><i class="fas fa-exclamation-triangle me-1"></i>Penalty</button>
                </div>
            </div>
            <!-- Search -->
            <div class="col-lg-4 mt-2">
                <input type="text" class="form-control" id="searchInput" placeholder="Search member, loan ID, reference…" oninput="applySearch()">
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2" style="color:var(--primary);"></i>Loan Payment Records</h5>
            <button class="btn btn-sm btn-outline-primary" onclick="exportData()"><i class="fas fa-download me-1"></i>Export</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="mainTable">
                    <thead>
                        <tr>
                            <th>Date / Time</th>
                            <th>Borrower</th>
                            <th>Loan Ref</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Breakdown</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <% if (payments && payments.length > 0) { %>
                            <% payments.forEach(p => { %>
                            <tr data-status="<%= p.status %>" data-type="<%= p.transactionType %>">
                                <td data-label="Date/Time">
                                    <small class="fw-semibold"><%= p.date %></small><br>
                                    <small class="text-muted"><%= p.time %></small>
                                </td>
                                <td data-label="Borrower">
                                    <div class="fw-semibold"><%= p.borrowerName %></div>
                                    <small class="text-muted"><%= p.borrowerType === 'external' ? '🏢 External' : p.memberId %></small>
                                </td>
                                <td data-label="Loan Ref">
                                    <small class="text-muted"><%= p.loanRef || p.reference %></small>
                                </td>
                                <td data-label="Type">
                                    <%
                                        const typeMap = {
                                            repayment:   ['type-repayment',  'fa-hand-holding-usd', 'Repayment'],
                                            rollover:    ['type-rollover',   'fa-sync-alt',         'Rollover'],
                                            interest:    ['type-interest',   'fa-percentage',       'Interest'],
                                            penalty:     ['type-penalty',    'fa-exclamation-triangle','Penalty'],
                                            disbursement:['type-disbursement','fa-arrow-up',        'Disbursement'],
                                        };
                                        const [cls, icon, label] = typeMap[p.transactionType] || ['type-repayment','fa-hand-holding-usd','Repayment'];
                                    %>
                                    <span class="type-badge <%= cls %>">
                                        <i class="fas <%= icon %>"></i><%= label %>
                                    </span>
                                </td>
                                <td data-label="Amount" class="fw-bold" style="color:var(--success);">
                                    ₦<%= p.amount.toLocaleString() %>
                                </td>
                                <td data-label="Breakdown">
                                    <% if (p.principalPaid > 0 || p.interestPaid > 0 || p.penaltyPaid > 0) { %>
                                        <div style="font-size:0.72rem; color:var(--secondary); min-width:110px;">
                                            <% if (p.principalPaid > 0) { %><span style="color:#059669;">P:₦<%= p.principalPaid.toLocaleString() %></span>&nbsp;<% } %>
                                            <% if (p.interestPaid > 0) { %><span style="color:#0891b2;">I:₦<%= p.interestPaid.toLocaleString() %></span>&nbsp;<% } %>
                                            <% if (p.penaltyPaid > 0) { %><span style="color:#dc2626;">Pen:₦<%= p.penaltyPaid.toLocaleString() %></span><% } %>
                                        </div>
                                        <%
                                            const total = (p.principalPaid||0) + (p.interestPaid||0) + (p.penaltyPaid||0);
                                            const pPct  = total ? Math.round((p.principalPaid||0)/total*100) : 0;
                                            const iPct  = total ? Math.round((p.interestPaid||0)/total*100)  : 0;
                                            const penPct= 100 - pPct - iPct;
                                        %>
                                        <div class="breakdown-bar">
                                            <div class="seg-principal" style="width:<%= pPct %>%;"></div>
                                            <div class="seg-interest"  style="width:<%= iPct %>%;"></div>
                                            <div class="seg-penalty"   style="width:<%= penPct %>%;"></div>
                                        </div>
                                    <% } else { %>
                                        <small class="text-muted">—</small>
                                    <% } %>
                                </td>
                                <td data-label="Status">
                                    <span class="status-badge status-<%= p.status %>">
                                        <%= p.status.charAt(0).toUpperCase() + p.status.slice(1) %>
                                    </span>
                                </td>
                                <td data-label="Actions">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <% if (p.status === 'pending') { %>
                                            <button class="action-btn btn-approve" onclick="openApprove('<%= p.id %>')"><i class="fas fa-check"></i></button>
                                            <button class="action-btn btn-reject"  onclick="openReject('<%= p.id %>')"><i class="fas fa-times"></i></button>
                                        <% } %>
                                        <button class="action-btn btn-view" onclick="viewDetails('<%= p.id %>')"><i class="fas fa-eye"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="8" class="text-center py-5 text-muted"><i class="fas fa-inbox fa-2x mb-2 d-block opacity-50"></i>No loan payment records found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ══ Powered By ══ -->
<div class="powered-by"><strong style="color:var(--primary);">Cloudbaam</strong> Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

<!-- ══ Custom Alert Modal ══ -->
<div class="modal fade" id="alertModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <div class="modal-header" id="alertModalHeader">
                <h5 class="modal-title fw-bold" id="alertModalLabel"></h5>
                <button type="button" class="btn-close" id="alertModalCloseBtn" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert-icon-wrapper" id="alertModalIconWrapper"><i id="alertModalIcon"></i></div>
                <p class="mb-0 text-center" id="alertModalMessage" style="font-size:1rem;"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn px-4 fw-semibold" id="alertModalOkBtn" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ Payment Detail Modal ══ -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;">
                <h5 class="modal-title"><i class="fas fa-file-invoice me-2"></i>Loan Payment Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <!-- Borrower info -->
                    <div class="col-md-6">
                        <div class="card h-100" style="border:2px solid rgba(16,185,129,0.15);background:rgba(16,185,129,0.02);">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3" style="color:var(--success);"><i class="fas fa-user me-2"></i>Borrower</h6>
                                <div class="mb-2"><small class="text-muted d-block">Name</small><strong id="dBorrowerName">—</strong></div>
                                <div class="mb-2"><small class="text-muted d-block">ID / Type</small><strong id="dBorrowerId">—</strong></div>
                                <div class="mb-0"><small class="text-muted d-block">Email</small><strong id="dBorrowerEmail">—</strong></div>
                            </div>
                        </div>
                    </div>
                    <!-- Payment info -->
                    <div class="col-md-6">
                        <div class="card h-100" style="border:2px solid rgba(30,58,138,0.1);background:rgba(30,58,138,0.02);">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3" style="color:var(--primary);"><i class="fas fa-info-circle me-2"></i>Payment Info</h6>
                                <div class="mb-2"><small class="text-muted d-block">Reference</small><strong id="dReference">—</strong></div>
                                <div class="mb-2"><small class="text-muted d-block">Date &amp; Time</small><strong id="dDateTime">—</strong></div>
                                <div class="mb-2"><small class="text-muted d-block">Method</small><strong id="dMethod">—</strong></div>
                                <div class="mb-0"><small class="text-muted d-block">Status</small><span id="dStatus" class="status-badge status-pending">Pending</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Amount breakdown -->
                    <div class="col-12">
                        <div class="card" style="border:2px solid rgba(245,158,11,0.15);background:rgba(245,158,11,0.02);">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3" style="color:var(--warning);"><i class="fas fa-money-bill-wave me-2"></i>Amount Breakdown</h6>
                                <div class="text-center mb-3">
                                    <h2 class="fw-bold" style="color:var(--success);" id="dTotalAmount">₦0</h2>
                                    <span id="dTypeBadge" class="type-badge type-repayment ms-2"><i class="fas fa-hand-holding-usd me-1"></i>Repayment</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-4">
                                        <div style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2);border-radius:10px;padding:10px;text-align:center;">
                                            <small class="text-muted d-block">Principal</small>
                                            <strong style="color:#059669;" id="dPrincipal">₦0</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="background:rgba(6,182,212,0.08);border:1px solid rgba(6,182,212,0.2);border-radius:10px;padding:10px;text-align:center;">
                                            <small class="text-muted d-block">Interest</small>
                                            <strong style="color:#0891b2;" id="dInterest">₦0</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);border-radius:10px;padding:10px;text-align:center;">
                                            <small class="text-muted d-block">Penalty</small>
                                            <strong style="color:#dc2626;" id="dPenalty">₦0</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loan balance -->
                    <div class="col-12">
                        <div class="card" style="border:2px solid rgba(30,58,138,0.1);">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3" style="color:var(--primary);"><i class="fas fa-balance-scale me-2"></i>Loan Balance</h6>
                                <div class="breakdown-row">
                                    <span class="text-muted">Balance Before</span>
                                    <strong id="dBalanceBefore">—</strong>
                                </div>
                                <div class="breakdown-row">
                                    <span class="text-muted">Payment Applied</span>
                                    <strong style="color:var(--success);" id="dAmountApplied">—</strong>
                                </div>
                                <div class="breakdown-row">
                                    <span class="text-muted">Balance After</span>
                                    <strong id="dBalanceAfter">—</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notes -->
                    <div class="col-12">
                        <div class="card" style="border:2px solid rgba(30,58,138,0.1);">
                            <div class="card-body">
                                <h6 class="fw-bold mb-2" style="color:var(--primary);"><i class="fas fa-comment-alt me-2"></i>Notes</h6>
                                <p class="mb-0" id="dNotes">—</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="detailApproveBtn" onclick="approveFromDetail()"><i class="fas fa-check me-2"></i>Approve</button>
                <button type="button" class="btn btn-danger"  id="detailRejectBtn"  onclick="rejectFromDetail()"><i class="fas fa-times me-2"></i>Reject</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ Approve Modal ══ -->
<div class="modal fade" id="approvalModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>Approve Loan Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-success"><i class="fas fa-info-circle me-2"></i>The repayment will be applied to the borrower's loan balance immediately.</div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Admin Notes (Optional)</label>
                    <textarea class="form-control" id="approvalNotes" rows="3" placeholder="Add any notes…"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="confirmApproval()"><i class="fas fa-check me-2"></i>Confirm Approval</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ Reject Modal ══ -->
<div class="modal fade" id="rejectionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-times-circle me-2"></i>Reject Loan Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>The payment will be rejected. The loan balance will remain unchanged.</div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Reason <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="rejectionReason" rows="3" placeholder="Enter reason for rejection…" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmRejection()"><i class="fas fa-times me-2"></i>Confirm Rejection</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ Success Modal ══ -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>Success</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fas fa-check-circle fa-5x text-success mb-3"></i>
                <h4 class="mb-3" id="successMessage">Action completed successfully!</h4>
                <p class="text-muted mb-0">The loan record has been updated.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
    /* ── Seed data from server ── */
    const payments = <%- JSON.stringify(payments) %>;

    let currentId     = null;
    let activeStatus  = 'all';
    let activeType    = 'all';

    /* ── Date ── */
    document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', { weekday:'short', year:'numeric', month:'short', day:'numeric' });

    /* ══════════════════════════════════════════
       Modal helpers
    ══════════════════════════════════════════ */
    function switchModal(fromId, toFn) {
        const el = document.getElementById(fromId);
        const inst = bootstrap.Modal.getInstance(el);
        if (inst) {
            el.addEventListener('hidden.bs.modal', function h() {
                el.removeEventListener('hidden.bs.modal', h);
                toFn();
            });
            inst.hide();
        } else { toFn(); }
    }

    function showAlert(message, type = 'info', title = null) {
        const cfg = {
            success: { hdr:'bg-success', ibg:'rgba(16,185,129,0.12)', ic:'#10b981', icls:'fas fa-check-circle',           btn:'btn-success', t:'Success' },
            danger:  { hdr:'bg-danger',  ibg:'rgba(239,68,68,0.12)',  ic:'#ef4444', icls:'fas fa-times-circle',            btn:'btn-danger',  t:'Error'   },
            warning: { hdr:'bg-warning', ibg:'rgba(245,158,11,0.12)', ic:'#f59e0b', icls:'fas fa-exclamation-triangle',    btn:'btn-warning', t:'Warning' },
            info:    { hdr:'bg-primary', ibg:'rgba(59,130,246,0.12)', ic:'#3b82f6', icls:'fas fa-info-circle',             btn:'btn-primary', t:'Info'    },
        };
        const c = cfg[type] || cfg.info;
        document.getElementById('alertModalHeader').className = `modal-header ${c.hdr} text-white border-0`;
        document.getElementById('alertModalCloseBtn').className = 'btn-close btn-close-white';
        document.getElementById('alertModalLabel').textContent = title || c.t;
        const iw = document.getElementById('alertModalIconWrapper');
        iw.style.background = c.ibg;
        const ic = document.getElementById('alertModalIcon');
        ic.className = `${c.icls} fa-2x`; ic.style.color = c.ic;
        document.getElementById('alertModalMessage').textContent = message;
        document.getElementById('alertModalOkBtn').className = `btn px-4 fw-semibold ${c.btn}`;
        const open = document.querySelector('.modal.show');
        if (open && open.id !== 'alertModal') {
            switchModal(open.id, () => new bootstrap.Modal(document.getElementById('alertModal')).show());
        } else {
            new bootstrap.Modal(document.getElementById('alertModal')).show();
        }
    }

    /* ══════════════════════════════════════════
       Filtering
    ══════════════════════════════════════════ */
    function applyFilter(dimension, value, btn) {
        if (dimension === 'status') {
            activeStatus = value;
            btn.closest('.d-inline-flex').querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        } else {
            activeType = value;
            btn.closest('.d-inline-flex').querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        }
        btn.classList.add('active');
        applySearch();
    }

    function applySearch() {
        const term = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('#tableBody tr').forEach(row => {
            const sMatch = activeStatus === 'all' || row.dataset.status === activeStatus;
            const tMatch = activeType   === 'all' || row.dataset.type   === activeType;
            const qMatch = !term || row.textContent.toLowerCase().includes(term);
            row.style.display = (sMatch && tMatch && qMatch) ? '' : 'none';
        });
    }

    /* ══════════════════════════════════════════
       View Details
    ══════════════════════════════════════════ */
    function viewDetails(id) {
        const p = payments.find(x => x.id === id);
        if (!p) return;
        currentId = id;

        document.getElementById('dBorrowerName').textContent  = p.borrowerName || '—';
        document.getElementById('dBorrowerId').textContent    = p.borrowerType === 'external' ? '🏢 External' : (p.memberId || '—');
        document.getElementById('dBorrowerEmail').textContent = p.email || '—';
        document.getElementById('dReference').textContent     = p.reference || '—';
        document.getElementById('dDateTime').textContent      = `${p.date} at ${p.time}`;
        document.getElementById('dMethod').textContent        = p.paymentMethod || '—';
        document.getElementById('dNotes').textContent         = p.notes || '—';
        document.getElementById('dTotalAmount').textContent   = `₦${(p.amount||0).toLocaleString()}`;

        const statusEl = document.getElementById('dStatus');
        statusEl.className = `status-badge status-${p.status}`;
        statusEl.textContent = p.status.charAt(0).toUpperCase() + p.status.slice(1);

        const typeMap = {
            repayment:   ['type-repayment',  'fa-hand-holding-usd', 'Repayment'],
            rollover:    ['type-rollover',   'fa-sync-alt',         'Rollover'],
            interest:    ['type-interest',   'fa-percentage',       'Interest'],
            penalty:     ['type-penalty',    'fa-exclamation-triangle','Penalty'],
            disbursement:['type-disbursement','fa-arrow-up',        'Disbursement'],
        };
        const [cls, icon, label] = typeMap[p.transactionType] || typeMap.repayment;
        const tb = document.getElementById('dTypeBadge');
        tb.className = `type-badge ${cls} ms-2`;
        tb.innerHTML = `<i class="fas ${icon} me-1"></i>${label}`;

        document.getElementById('dPrincipal').textContent    = `₦${(p.principalPaid||0).toLocaleString()}`;
        document.getElementById('dInterest').textContent     = `₦${(p.interestPaid||0).toLocaleString()}`;
        document.getElementById('dPenalty').textContent      = `₦${(p.penaltyPaid||0).toLocaleString()}`;
        document.getElementById('dBalanceBefore').textContent = p.balanceBefore != null ? `₦${p.balanceBefore.toLocaleString()}` : '—';
        document.getElementById('dBalanceAfter').textContent  = p.balanceAfter  != null ? `₦${p.balanceAfter.toLocaleString()}`  : '—';
        document.getElementById('dAmountApplied').textContent = `₦${(p.amount||0).toLocaleString()}`;

        const isPending = p.status === 'pending';
        document.getElementById('detailApproveBtn').style.display = isPending ? '' : 'none';
        document.getElementById('detailRejectBtn').style.display  = isPending ? '' : 'none';

        new bootstrap.Modal(document.getElementById('detailModal')).show();
    }

    /* ══════════════════════════════════════════
       Approve flow
    ══════════════════════════════════════════ */
    function openApprove(id) {
        currentId = id;
        new bootstrap.Modal(document.getElementById('approvalModal')).show();
    }
    function approveFromDetail() {
        switchModal('detailModal', () => new bootstrap.Modal(document.getElementById('approvalModal')).show());
    }

    async function confirmApproval() {
        const notes = document.getElementById('approvalNotes').value;
        try {
            const res = await fetch(`/admin/loans/${currentId}/approve-payment`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ notes })
            });
            const result = await res.json();
            if (!res.ok) {
                showAlert(result.message || 'Approval failed.', 'danger', 'Approval Failed');
                return;
            }
            const p = payments.find(x => x.id === currentId);
            if (p) p.status = 'approved';
            updateRow(currentId, 'approved');
            document.getElementById('approvalNotes').value = '';
            document.getElementById('successMessage').textContent = result.overpaymentCredited
                ? `Payment approved! ₦${result.overpaymentCredited.toLocaleString()} overpayment credited to savings.`
                : 'Loan payment approved and applied successfully!';
            switchModal('approvalModal', () => new bootstrap.Modal(document.getElementById('successModal')).show());
        } catch (e) {
            showAlert('Network error. Please try again.', 'danger', 'Network Error');
        }
    }

    /* ══════════════════════════════════════════
       Reject flow
    ══════════════════════════════════════════ */
    function openReject(id) {
        currentId = id;
        new bootstrap.Modal(document.getElementById('rejectionModal')).show();
    }
    function rejectFromDetail() {
        switchModal('detailModal', () => new bootstrap.Modal(document.getElementById('rejectionModal')).show());
    }

    async function confirmRejection() {
        const reason = document.getElementById('rejectionReason').value.trim();
        if (!reason) {
            showAlert('Please provide a reason before proceeding.', 'warning', 'Reason Required');
            return;
        }
        try {
            const res = await fetch(`/admin/loans/${currentId}/reject-payment`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason })
            });
            const result = await res.json();
            if (!res.ok) {
                showAlert(result.message || 'Rejection failed.', 'danger', 'Rejection Failed');
                return;
            }
            const p = payments.find(x => x.id === currentId);
            if (p) p.status = 'rejected';
            updateRow(currentId, 'rejected');
            document.getElementById('rejectionReason').value = '';
            document.getElementById('successMessage').textContent = 'Loan payment rejected.';
            switchModal('rejectionModal', () => new bootstrap.Modal(document.getElementById('successModal')).show());
        } catch (e) {
            showAlert('Network error. Please try again.', 'danger', 'Network Error');
        }
    }

    /* ══════════════════════════════════════════
       Update row in place
    ══════════════════════════════════════════ */
    function updateRow(id, status) {
        document.querySelectorAll('#tableBody tr').forEach(row => {
            if (row.querySelector(`button[onclick*="'${id}'"]`)) {
                row.dataset.status = status;
                const statusCell = row.querySelector('[data-label="Status"]');
                if (statusCell) {
                    statusCell.innerHTML = `<span class="status-badge status-${status}">${status.charAt(0).toUpperCase()+status.slice(1)}</span>`;
                }
                const actionsCell = row.querySelector('[data-label="Actions"]');
                if (actionsCell) {
                    actionsCell.innerHTML = `
                        <div class="d-flex gap-1 flex-wrap">
                            <button class="action-btn btn-view" onclick="viewDetails('${id}')"><i class="fas fa-eye"></i></button>
                        </div>`;
                }
            }
        });
    }

    function refreshData() { window.location.reload(); }
    function exportData()  { window.location.href = '/admin/loan-payments/export'; }

    /* ── Sidebar pending badge ── */
    async function loadSidebarPendingCount() {
        try {
            const res = await fetch('/admin/pending-approvals-count');
            const data = await res.json();
            const badge = document.getElementById('sidebarPendingBadge');
            if (!badge) return;
            badge.style.display = data.count > 0 ? 'inline-block' : 'none';
            badge.textContent = data.count;
        } catch (e) { console.error('Sidebar count error:', e); }
    }
    document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
</script>
</body>
</html>
