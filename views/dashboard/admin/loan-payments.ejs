<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loan Payments | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --purple: #8b5cf6;
            --sidebar-width: 280px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh; overflow-x: hidden;
        }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }
        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18); position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box {
            width: 42px; height: 42px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0;
        }
        .sidebar-brand { font-size: .95rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .65rem; font-weight: 500; opacity: .55; display: block; letter-spacing: .08em; }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 10px; background: rgba(239,68,68,.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.3);
            font-weight: 700; font-size: .7rem; color: #fca5a5;
        }
        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }
        .nav-category {
            display: flex; align-items: center; gap: 7px;
            padding: .55rem 1.25rem .3rem; font-size: .62rem; font-weight: 800;
            color: rgba(255,255,255,.38); text-transform: uppercase; letter-spacing: .1em; user-select: none;
        }
        .nav-category::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.08); margin-left: 4px; }
        .sidebar-nav a {
            display: flex; align-items: center; gap: 11px;
            padding: .62rem 1.25rem; color: rgba(255,255,255,.72);
            text-decoration: none; font-weight: 500; font-size: .84rem;
            border-left: 3px solid transparent; transition: all .18s;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }
        .nav-badge {
            margin-left: auto; font-size: .63rem; font-weight: 800;
            padding: 2px 7px; border-radius: 10px;
            background: rgba(239,68,68,.9); color: white; flex-shrink: 0; line-height: 1.4;
        }
        .nav-back {
            display: flex; align-items: center; gap: 10px;
            padding: .7rem 1.25rem .9rem; font-size: .8rem; font-weight: 600;
            color: rgba(255,255,255,.42); text-decoration: none; transition: color .18s;
            border-top: 1px solid rgba(255,255,255,.07); margin-top: .25rem;
        }
        .nav-back:hover { color: rgba(255,255,255,.7); }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }

        /* ══════════ TOPBAR ══════════ */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: 70px;
            background: rgba(255,255,255,.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem;
            border-bottom: 1px solid rgba(30,58,138,.1); transition: all .3s;
        }
        .main-content {
            margin-left: var(--sidebar-width); margin-top: 70px;
            padding: 1.5rem; min-height: calc(100vh - 70px); transition: all .3s;
        }

        /* ══════════ PAGE HEADER — no overflow:hidden ══════════ */
        .page-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30,58,138,.25); position: relative;
            /* NO overflow:hidden — keeps export dropdown visible */
        }
        .page-header::before {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 400px; height: 400px; background: rgba(255,255,255,.05); border-radius: 50%;
            pointer-events: none;
        }

        /* ══════════ EXPORT DROPDOWN — custom, always visible ══════════ */
        .export-wrapper { position: relative; z-index: 200; display: inline-block; }
        .btn-export {
            background: white; color: var(--primary); border: none;
            font-weight: 700; border-radius: 10px; padding: .55rem 1.1rem;
            font-size: .88rem; display: inline-flex; align-items: center; gap: .5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,.12); transition: all .2s; cursor: pointer;
        }
        .btn-export:hover { background: rgba(255,255,255,.92); transform: translateY(-1px); box-shadow: 0 6px 18px rgba(0,0,0,.15); }
        .btn-export .caret { font-size: .7rem; transition: transform .2s; }
        .btn-export.open .caret { transform: rotate(180deg); }
        .export-dropdown-menu {
            position: absolute; top: calc(100% + 6px); right: 0; left: auto;
            min-width: 230px; background: white; border-radius: 14px; border: none;
            box-shadow: 0 20px 50px rgba(30,58,138,.22), 0 4px 16px rgba(0,0,0,.1);
            padding: .5rem; z-index: 99999;
        }
        .export-dropdown-menu .drop-header {
            font-size: .68rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: .08em; color: #94a3b8; padding: .5rem .75rem .25rem;
        }
        .export-dropdown-menu .drop-item {
            border-radius: 9px; padding: .6rem .875rem;
            font-weight: 600; font-size: .85rem; color: #1e293b;
            display: flex; align-items: center; gap: .6rem;
            transition: background .15s; text-decoration: none; cursor: pointer;
        }
        .export-dropdown-menu .drop-item:hover { background: rgba(30,58,138,.06); }
        .export-dropdown-menu .drop-divider { margin: .35rem .5rem; border-top: 1px solid rgba(30,58,138,.1); }
        @media (max-width: 576px) { .export-dropdown-menu { right: auto; left: 0; } }

        /* ══════════ STATS ══════════ */
        .stats-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,.08); transition: all .3s;
            border: 2px solid transparent; height: 100%; position: relative; overflow: hidden;
        }
        .stats-card::before {
            content: ''; position: absolute; top: 0; right: 0;
            width: 100px; height: 100px; background: rgba(30,58,138,.03);
            border-radius: 0 16px 0 100%;
        }
        .stats-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,.15); border-color: var(--primary); }
        .stats-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 1rem; }
        .stats-value { font-size: 1.6rem; font-weight: bold; margin-bottom: .5rem; }
        .stats-label { color: var(--secondary); font-size: .9rem; font-weight: 500; }

        /* ══════════ CARDS ══════════ */
        .card { border: none; border-radius: 16px; box-shadow: 0 8px 20px rgba(30,58,138,.08); background: white; border: 1px solid rgba(30,58,138,.05); }
        .card-header { background: linear-gradient(135deg,rgba(30,58,138,.03) 0%,rgba(59,130,246,.03) 100%); border-bottom: 2px solid rgba(30,58,138,.1); padding: 1.25rem; border-radius: 16px 16px 0 0 !important; }

        /* ══════════ TYPE / STATUS BADGES ══════════ */
        .type-badge { padding: 4px 10px; border-radius: 20px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; display: inline-flex; align-items: center; gap: 4px; }
        .type-repayment   { background: rgba(16,185,129,.1);  color: #059669; border: 1px solid rgba(16,185,129,.3); }
        .type-rollover    { background: rgba(139,92,246,.1);  color: #7c3aed; border: 1px solid rgba(139,92,246,.3); }
        .type-interest    { background: rgba(6,182,212,.1);   color: #0891b2; border: 1px solid rgba(6,182,212,.3); }
        .type-penalty     { background: rgba(239,68,68,.1);   color: #dc2626; border: 1px solid rgba(239,68,68,.3); }
        .type-disbursement{ background: rgba(245,158,11,.1);  color: #d97706; border: 1px solid rgba(245,158,11,.3); }
        .status-badge { padding: 6px 12px; border-radius: 20px; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
        .status-pending  { background: rgba(245,158,11,.1); color: var(--warning); border: 1px solid rgba(245,158,11,.3); }
        .status-approved { background: rgba(16,185,129,.1); color: var(--success); border: 1px solid rgba(16,185,129,.3); }
        .status-rejected { background: rgba(239,68,68,.1);  color: var(--danger);  border: 1px solid rgba(239,68,68,.3); }

        /* ══════════ ACTION BUTTONS ══════════ */
        .action-btn { padding: 6px 12px; border-radius: 8px; font-size: .85rem; font-weight: 600; transition: all .3s; border: none; cursor: pointer; }
        .btn-approve { background: linear-gradient(135deg,#10b981,#059669); color: white; }
        .btn-approve:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(16,185,129,.3); }
        .btn-reject  { background: linear-gradient(135deg,#ef4444,#dc2626); color: white; }
        .btn-reject:hover  { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(239,68,68,.3); }
        .btn-view    { background: linear-gradient(135deg,#3b82f6,#2563eb); color: white; }
        .btn-view:hover    { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(59,130,246,.3); }

        /* ══════════ FILTER ══════════ */
        .filter-section { background: white; border-radius: 12px; padding: 1rem; margin-bottom: 1rem; box-shadow: 0 4px 12px rgba(30,58,138,.06); }
        .filter-btn { padding: 8px 16px; border-radius: 8px; border: 2px solid rgba(30,58,138,.1); background: white; color: var(--primary); font-weight: 600; transition: all .3s; cursor: pointer; font-size: .85rem; }
        .filter-btn:hover, .filter-btn.active { background: var(--primary); color: white; border-color: var(--primary); }
        .filter-btn.filter-type { border-color: rgba(139,92,246,.2); color: var(--purple); }
        .filter-btn.filter-type:hover, .filter-btn.filter-type.active { background: var(--purple); color: white; border-color: var(--purple); }

        /* ══════════ TABLE ══════════ */
        .table-responsive { border-radius: 0 0 16px 16px; overflow: hidden; }
        .table { margin: 0; }
        .table thead { background: linear-gradient(135deg,rgba(30,58,138,.05) 0%,rgba(59,130,246,.05) 100%); }
        .table thead th { border: none; padding: 1rem; font-weight: 600; color: var(--primary); white-space: nowrap; }
        .table tbody td { padding: .85rem 1rem; vertical-align: middle; border-bottom: 1px solid rgba(30,58,138,.05); }
        .table tbody tr:last-child td { border-bottom: none; }
        .table tbody tr:hover { background: rgba(30,58,138,.02); }

        /* Breakdown bar */
        .breakdown-bar { display: flex; height: 6px; border-radius: 3px; overflow: hidden; gap: 1px; margin-top: 6px; }
        .breakdown-bar .seg-principal { background: #10b981; }
        .breakdown-bar .seg-interest  { background: #06b6d4; }
        .breakdown-bar .seg-penalty   { background: #ef4444; }

        /* Detail modal */
        .breakdown-row { display: flex; justify-content: space-between; align-items: center; padding: .6rem 0; border-bottom: 1px dashed rgba(30,58,138,.1); }
        .breakdown-row:last-child { border-bottom: none; }

        /* Alert modal */
        #alertModal .modal-content { border: none; border-radius: 18px; overflow: hidden; box-shadow: 0 20px 60px rgba(30,58,138,.2); }
        #alertModal .modal-header  { padding: 1.25rem 1.5rem; border-bottom: none; }
        #alertModal .modal-body    { padding: 1.5rem; text-align: center; }
        #alertModal .alert-icon-wrapper { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 2rem; }
        #alertModal .modal-footer  { border-top: none; padding: 0 1.5rem 1.5rem; justify-content: center; }

        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,.15); font-size: .8rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
            .table thead { display: none; }
            .table tbody tr { display: block; margin-bottom: 1rem; border: 2px solid rgba(30,58,138,.1); border-radius: 12px; overflow: hidden; background: white; }
            .table tbody td { display: flex; justify-content: space-between; align-items: center; padding: .75rem 1rem; border-bottom: 1px solid rgba(30,58,138,.05); }
            .table tbody td:last-child { border-bottom: none; }
            .table tbody td::before { content: attr(data-label); font-weight: 600; color: var(--primary); margin-right: 1rem; }
        }

        @keyframes fadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .fade-in { animation: fadeIn .5s ease; }
    </style>
</head>
<body>

<!-- ════════════════════════ SIDEBAR ════════════════════════ -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-row">
            <div class="logo-box">C</div>
            <div><div class="sidebar-brand">Club De Stars<small>Admin Panel</small></div></div>
        </div>
        <div class="role-pill">
            <i class="fas fa-shield-alt" style="font-size:.65rem;"></i>&nbsp;<%= admin.role?.name?.toUpperCase() || 'SUPER ADMIN' %>
        </div>
    </div>

      <div class="sidebar-nav">
        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-home" style="font-size:.6rem;"></i>Main</div>
            <a href="/admin/dashboard"><i class="fas fa-chart-pie"></i>Overview</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-users" style="font-size:.6rem;"></i>Members</div>
            <a href="/admin/manage-members"><i class="fas fa-users"></i>Manage Members</a>
            <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i>Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i>Membership Types</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-exchange-alt" style="font-size:.6rem;"></i>Transactions</div>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i>Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i>Approvals<span id="sidebarPendingBadge" class="nav-badge" style="display:none;">0</span></a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i>Deposits</a>
            <a href="/admin/kiddies-deposits"><i class="fas fa-piggy-bank"></i>Kiddies Deposits</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i>Withdrawals</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-hand-holding-usd" style="font-size:.6rem;"></i>Loans</div>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i>Loan Management</a>
            <a href="/admin/loan-payments" class="active"><i class="fas fa-file-invoice-dollar"></i>Loan Payments</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i>Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i>External Loans</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-landmark" style="font-size:.6rem;"></i>Finance</div>
            <a href="/admin/finance"><i class="fas fa-landmark"></i>Company Finance</a>
            <a href="/admin/operating-earnings"><i class="fas fa-chart-line"></i>Operating Earnings</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-chart-bar"></i>Company Revenue</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-cog" style="font-size:.6rem;"></i>System</div>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i>Manage Subscriptions</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i>Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i>Settings</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-file-alt" style="font-size:.6rem;"></i>Reporting</div>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i>Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i>Admin Logs</a>
        </div>
    </div>

    <a href="/cds-cooperative/dashboard" class="nav-back"><i class="fas fa-arrow-left"></i>Back to Dashboard</a>
</div>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- Top Navbar -->
<div class="top-navbar">
    <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;" onclick="toggleSidebar(event)"></i>
    <div class="flex-grow-1 d-none d-lg-block">
        <h5 class="mb-0 fw-bold" style="color:var(--primary)">Loan Payment Management</h5>
        <small class="text-muted">Review, approve and track all loan repayments</small>
    </div>
    <div class="d-lg-none fw-bold" style="color:var(--primary);font-size:.95rem;">Loan Payments</div>
    <div class="ms-auto d-flex align-items-center gap-3">
        <div class="badge bg-light text-dark"><i class="fas fa-calendar me-1"></i><span id="currentDate"></span></div>
    </div>
</div>

<!-- Main Content -->
<div class="main-content">

    <!-- PAGE HEADER -->
    <div class="page-header position-relative">
        <div class="row align-items-center position-relative" style="z-index:1;">
            <div class="col-md-8">
                <h2 class="mb-2 fw-bold"><i class="fas fa-file-invoice-dollar me-3"></i>Loan Payment Management</h2>
                <p class="mb-0 opacity-90">Monitor repayments, rollovers, interest &amp; penalty settlements</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <!-- EXPORT — custom dropdown, never clipped -->
                <div class="export-wrapper">
                    <button class="btn-export" id="exportBtn" onclick="toggleExportMenu(event)">
                        <i class="fas fa-download"></i>
                        Export
                        <i class="fas fa-chevron-down caret" id="exportCaret"></i>
                    </button>
                    <div class="export-dropdown-menu" id="exportMenu" style="display:none;">
                        <div class="drop-header">Export All Records</div>
                        <a class="drop-item" onclick="exportToExcel(false);closeExportMenu();return false;">
                            <i class="fas fa-file-excel" style="color:#10b981;font-size:1rem;"></i>Excel — All Payments
                        </a>
                        <a class="drop-item" onclick="exportToPDF(false);closeExportMenu();return false;">
                            <i class="fas fa-file-pdf" style="color:#ef4444;font-size:1rem;"></i>PDF — All Payments
                        </a>
                        <div class="drop-divider"></div>
                        <div class="drop-header">Export Current Filter</div>
                        <a class="drop-item" onclick="exportToExcel(true);closeExportMenu();return false;">
                            <i class="fas fa-file-excel" style="color:#059669;font-size:1rem;"></i>Excel — Filtered View
                        </a>
                        <a class="drop-item" onclick="exportToPDF(true);closeExportMenu();return false;">
                            <i class="fas fa-file-pdf" style="color:#dc2626;font-size:1rem;"></i>PDF — Filtered View
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;"><i class="fas fa-hand-holding-usd"></i></div>
                <div class="stats-value" style="color:var(--success);font-size:14px;">₦<%= stats.totalRepaid.toLocaleString() %></div>
                <div class="stats-label">Total Repaid</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;"><i class="fas fa-clock"></i></div>
                <div class="stats-value" style="color:var(--warning);font-size:14px;"><%= stats.pendingCount %></div>
                <div class="stats-label">Pending Approvals</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#ef4444,#dc2626);color:white;"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="stats-value" style="color:var(--danger);font-size:14px;">₦<%= stats.totalPenalties.toLocaleString() %></div>
                <div class="stats-label">Total Penalties Collected</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:white;"><i class="fas fa-sync-alt"></i></div>
                <div class="stats-value" style="color:var(--purple);font-size:14px;"><%= stats.rolloversCount %></div>
                <div class="stats-label">Rollovers This Month</div>
            </div>
        </div>
    </div>

    <!-- FILTER SECTION -->
    <div class="filter-section">
        <div class="row g-2 align-items-center">
            <div class="col-12">
                <small class="text-muted fw-semibold me-2">STATUS:</small>
                <div class="d-inline-flex flex-wrap gap-2">
                    <button class="filter-btn active" onclick="applyFilter('status','all',this)"><i class="fas fa-list me-1"></i>All</button>
                    <button class="filter-btn" onclick="applyFilter('status','pending',this)"><i class="fas fa-clock me-1"></i>Pending</button>
                    <button class="filter-btn" onclick="applyFilter('status','approved',this)"><i class="fas fa-check me-1"></i>Approved</button>
                    <button class="filter-btn" onclick="applyFilter('status','rejected',this)"><i class="fas fa-times me-1"></i>Rejected</button>
                </div>
            </div>
            <div class="col-12 mt-2">
                <small class="text-muted fw-semibold me-2">TYPE:</small>
                <div class="d-inline-flex flex-wrap gap-2">
                    <button class="filter-btn filter-type active" onclick="applyFilter('type','all',this)"><i class="fas fa-th me-1"></i>All Types</button>
                    <button class="filter-btn filter-type" onclick="applyFilter('type','repayment',this)"><i class="fas fa-hand-holding-usd me-1"></i>Repayment</button>
                    <button class="filter-btn filter-type" onclick="applyFilter('type','rollover',this)"><i class="fas fa-sync-alt me-1"></i>Rollover</button>
                    <button class="filter-btn filter-type" onclick="applyFilter('type','interest',this)"><i class="fas fa-percentage me-1"></i>Interest</button>
                    <button class="filter-btn filter-type" onclick="applyFilter('type','penalty',this)"><i class="fas fa-exclamation-triangle me-1"></i>Penalty</button>
                </div>
            </div>
            <div class="col-lg-4 mt-2">
                <input type="text" class="form-control" id="searchInput" placeholder="Search member, loan ID, reference…" oninput="applySearch()">
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2" style="color:var(--primary);"></i>Loan Payment Records</h5>
            <small class="text-muted" id="tableInfo"></small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="mainTable">
                    <thead>
                        <tr>
                            <th>Date / Time</th>
                            <th>Borrower</th>
                            <th>Loan Ref</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Breakdown</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <% if (payments && payments.length > 0) { %>
                            <% payments.forEach(p => { %>
                            <tr data-status="<%= p.status %>" data-type="<%= p.transactionType %>">
                                <td data-label="Date/Time">
                                    <small class="fw-semibold"><%= p.date %></small><br>
                                    <small class="text-muted"><%= p.time %></small>
                                </td>
                                <td data-label="Borrower">
                                    <div class="fw-semibold"><%= p.borrowerName %></div>
                                    <small class="text-muted"><%= p.borrowerType === 'external' ? '🏢 External' : p.memberId %></small>
                                </td>
                                <td data-label="Loan Ref">
                                    <small class="text-muted font-monospace"><%= p.loanRef || p.reference %></small>
                                </td>
                                <td data-label="Type">
                                    <%
                                        const typeMap = {
                                            repayment:   ['type-repayment',   'fa-hand-holding-usd',     'Repayment'],
                                            rollover:    ['type-rollover',    'fa-sync-alt',             'Rollover'],
                                            interest:    ['type-interest',    'fa-percentage',           'Interest'],
                                            penalty:     ['type-penalty',     'fa-exclamation-triangle', 'Penalty'],
                                            disbursement:['type-disbursement','fa-arrow-up',             'Disbursement'],
                                        };
                                        const [cls, icon, label] = typeMap[p.transactionType] || ['type-repayment','fa-hand-holding-usd','Repayment'];
                                    %>
                                    <span class="type-badge <%= cls %>">
                                        <i class="fas <%= icon %>"></i><%= label %>
                                    </span>
                                </td>
                                <td data-label="Amount" class="fw-bold" style="color:var(--success);">
                                    ₦<%= p.amount.toLocaleString() %>
                                </td>
                                <td data-label="Breakdown">
                                    <% if (p.principalPaid > 0 || p.interestPaid > 0 || p.penaltyPaid > 0) { %>
                                        <div style="font-size:.72rem;color:var(--secondary);min-width:110px;">
                                            <% if (p.principalPaid > 0) { %><span style="color:#059669;">P:₦<%= p.principalPaid.toLocaleString() %></span>&nbsp;<% } %>
                                            <% if (p.interestPaid  > 0) { %><span style="color:#0891b2;">I:₦<%= p.interestPaid.toLocaleString() %></span>&nbsp;<% } %>
                                            <% if (p.penaltyPaid   > 0) { %><span style="color:#dc2626;">Pen:₦<%= p.penaltyPaid.toLocaleString() %></span><% } %>
                                        </div>
                                        <%
                                            const total = (p.principalPaid||0)+(p.interestPaid||0)+(p.penaltyPaid||0);
                                            const pPct   = total ? Math.round((p.principalPaid||0)/total*100) : 0;
                                            const iPct   = total ? Math.round((p.interestPaid||0)/total*100)  : 0;
                                            const penPct = 100 - pPct - iPct;
                                        %>
                                        <div class="breakdown-bar">
                                            <div class="seg-principal" style="width:<%= pPct %>%;"></div>
                                            <div class="seg-interest"  style="width:<%= iPct %>%;"></div>
                                            <div class="seg-penalty"   style="width:<%= penPct %>%;"></div>
                                        </div>
                                    <% } else { %>
                                        <small class="text-muted">—</small>
                                    <% } %>
                                </td>
                                <td data-label="Status">
                                    <span class="status-badge status-<%= p.status %>">
                                        <%= p.status.charAt(0).toUpperCase() + p.status.slice(1) %>
                                    </span>
                                </td>
                                <td data-label="Actions">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <% if (p.status === 'pending') { %>
                                            <button class="action-btn btn-approve" onclick="openApprove('<%= p.id %>')"><i class="fas fa-check"></i></button>
                                            <button class="action-btn btn-reject"  onclick="openReject('<%= p.id %>')"><i class="fas fa-times"></i></button>
                                        <% } %>
                                        <button class="action-btn btn-view" onclick="viewDetails('<%= p.id %>')"><i class="fas fa-eye"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="8" class="text-center py-5 text-muted"><i class="fas fa-inbox fa-2x mb-2 d-block opacity-50"></i>No loan payment records found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="powered-by"><strong style="color:var(--primary);">Cloudbaam</strong> · <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

