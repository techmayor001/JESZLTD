<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
/* ══════════════════════════════════════
   DATA FROM SERVER
══════════════════════════════════════ */
const payments = <%- JSON.stringify(payments) %>;

let currentId    = null;
let activeStatus = 'all';
let activeType   = 'all';

document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', {
    weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
});

/* ── Update record count in card header ── */
function updateTableInfo() {
    const visible = [...document.querySelectorAll('#tableBody tr')].filter(r => r.style.display !== 'none').length;
    const total   = payments.length;
    document.getElementById('tableInfo').textContent =
        visible === total ? `${total} records` : `Showing ${visible} of ${total}`;
}
document.addEventListener('DOMContentLoaded', updateTableInfo);

/* ══════════════════════════════════════
   EXPORT DROPDOWN — custom (no Bootstrap)
══════════════════════════════════════ */
function toggleExportMenu(e) {
    e.stopPropagation();
    const menu  = document.getElementById('exportMenu');
    const btn   = document.getElementById('exportBtn');
    const isOpen = menu.style.display !== 'none';
    menu.style.display = isOpen ? 'none' : 'block';
    btn.classList.toggle('open', !isOpen);
}
function closeExportMenu() {
    document.getElementById('exportMenu').style.display = 'none';
    document.getElementById('exportBtn').classList.remove('open');
}
document.addEventListener('click', e => {
    if (!e.target.closest('.export-wrapper')) closeExportMenu();
});

/* ══════════════════════════════════════
   HELPERS
══════════════════════════════════════ */
function fmt(n)   { return '₦' + Number(n || 0).toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
function capSt(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }

function getVisibleData(useFilter) {
    if (!useFilter) return payments;
    return payments.filter(p => {
        const sMatch = activeStatus === 'all' || p.status        === activeStatus;
        const tMatch = activeType   === 'all' || p.transactionType === activeType;
        const term   = document.getElementById('searchInput').value.toLowerCase();
        const qMatch = !term || JSON.stringify(p).toLowerCase().includes(term);
        return sMatch && tMatch && qMatch;
    });
}

/* ══════════════════════════════════════
   EXCEL EXPORT (SheetJS)
══════════════════════════════════════ */
function exportToExcel(useFilter) {
    const data = getVisibleData(useFilter);
    if (!data.length) { alert('No records to export.'); return; }

    const rows = data.map((p, i) => ({
        '#': i + 1,
        'Date': p.date || '—',
        'Time': p.time || '—',
        'Borrower Name': p.borrowerName || '—',
        'Member ID': p.borrowerType === 'external' ? 'External' : (p.memberId || '—'),
        'Borrower Type': p.borrowerType || '—',
        'Email': p.email || '—',
        'Loan Reference': p.loanRef || p.reference || '—',
        'Transaction Type': capSt(p.transactionType || '—'),
        'Total Amount (₦)': p.amount || 0,
        'Principal Paid (₦)': p.principalPaid || 0,
        'Interest Paid (₦)': p.interestPaid   || 0,
        'Penalty Paid (₦)': p.penaltyPaid     || 0,
        'Balance Before (₦)': p.balanceBefore != null ? p.balanceBefore : '—',
        'Balance After (₦)':  p.balanceAfter  != null ? p.balanceAfter  : '—',
        'Payment Method': p.paymentMethod || '—',
        'Status': capSt(p.status || '—'),
        'Notes': p.notes || '—',
    }));

    const ws = XLSX.utils.json_to_sheet(rows);
    ws['!cols'] = [
        {wch:4},{wch:14},{wch:10},{wch:24},{wch:16},{wch:14},{wch:26},
        {wch:20},{wch:16},{wch:18},{wch:18},{wch:18},{wch:16},
        {wch:18},{wch:16},{wch:16},{wch:12},{wch:30}
    ];

    // Header styling
    const range = XLSX.utils.decode_range(ws['!ref']);
    for (let C = range.s.c; C <= range.e.c; C++) {
        const addr = XLSX.utils.encode_cell({ r: 0, c: C });
        if (!ws[addr]) continue;
        ws[addr].s = {
            fill: { fgColor: { rgb: '1E3A8A' } },
            font: { bold: true, color: { rgb: 'FFFFFF' }, sz: 10 },
            alignment: { horizontal: 'center', vertical: 'center', wrapText: true }
        };
    }
    // Row styling
    const numCols = [9, 10, 11, 12, 13, 14]; // amount columns
    for (let R = 1; R <= range.e.r; R++) {
        const fill = R % 2 === 0 ? 'EEF2FF' : 'FFFFFF';
        for (let C = range.s.c; C <= range.e.c; C++) {
            const addr = XLSX.utils.encode_cell({ r: R, c: C });
            if (!ws[addr]) ws[addr] = { v: '', t: 's' };
            ws[addr].s = { fill: { fgColor: { rgb: fill } }, alignment: { vertical: 'center' }, border: { bottom: { style: 'thin', color: { rgb: 'E0E7FF' } } } };
        }
        numCols.forEach(C => {
            const addr = XLSX.utils.encode_cell({ r: R, c: C });
            if (ws[addr] && typeof ws[addr].v === 'number') { ws[addr].t = 'n'; ws[addr].z = '#,##0.00'; }
        });
    }

    // Summary sheet
    const now = new Date().toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    const totalAmt   = data.reduce((s, p) => s + (p.amount || 0), 0);
    const totalPrin  = data.reduce((s, p) => s + (p.principalPaid || 0), 0);
    const totalInt   = data.reduce((s, p) => s + (p.interestPaid  || 0), 0);
    const totalPen   = data.reduce((s, p) => s + (p.penaltyPaid   || 0), 0);
    const summaryData = [
        ['Club De Stars — Loan Payments Export', ''],
        ['Generated', now],
        ['Export Scope', useFilter ? `Filter: ${activeStatus} / ${activeType}` : 'All Records'],
        ['', ''],
        ['RECORD COUNTS', ''],
        ['Total Records',  data.length],
        ['Pending',        data.filter(p => p.status === 'pending').length],
        ['Approved',       data.filter(p => p.status === 'approved').length],
        ['Rejected',       data.filter(p => p.status === 'rejected').length],
        ['', ''],
        ['BY TYPE', ''],
        ['Repayments',    data.filter(p => p.transactionType === 'repayment').length],
        ['Rollovers',     data.filter(p => p.transactionType === 'rollover').length],
        ['Interest',      data.filter(p => p.transactionType === 'interest').length],
        ['Penalties',     data.filter(p => p.transactionType === 'penalty').length],
        ['', ''],
        ['FINANCIAL TOTALS', ''],
        ['Total Amount',     totalAmt],
        ['Total Principal',  totalPrin],
        ['Total Interest',   totalInt],
        ['Total Penalties',  totalPen],
    ];
    const ws2 = XLSX.utils.aoa_to_sheet(summaryData);
    ws2['!cols'] = [{ wch: 30 }, { wch: 22 }];

    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Loan Payments');
    XLSX.utils.book_append_sheet(wb, ws2, 'Summary');
    XLSX.writeFile(wb, `CDS_LoanPayments_${new Date().toISOString().split('T')[0]}${useFilter ? '_filtered' : ''}.xlsx`);
}

/* ══════════════════════════════════════
   PDF EXPORT
══════════════════════════════════════ */
function exportToPDF(useFilter) {
    const data = getVisibleData(useFilter);
    if (!data.length) { alert('No records to export.'); return; }

    const now      = new Date().toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    const totalAmt = data.reduce((s, p) => s + (p.amount || 0), 0);
    const typeColor = { repayment:'#059669', rollover:'#7c3aed', interest:'#0891b2', penalty:'#dc2626', disbursement:'#d97706' };
    const typeBg    = { repayment:'#d1fae5', rollover:'#ede9fe', interest:'#cffafe', penalty:'#fee2e2', disbursement:'#fef3c7' };
    const stColor   = { approved:'#059669', pending:'#d97706', rejected:'#dc2626' };
    const stBg      = { approved:'#d1fae5', pending:'#fef3c7', rejected:'#fee2e2' };

    const rows = data.map((p, i) => {
        const tc = typeColor[p.transactionType] || '#475569';
        const tb = typeBg[p.transactionType]    || '#f1f5f9';
        const sc = stColor[p.status] || '#475569';
        const sb = stBg[p.status]    || '#f1f5f9';
        const rowBg = i % 2 === 0 ? '#fff' : '#f8fafc';
        const breakdown = [
            p.principalPaid > 0 ? `<span style="color:#059669;font-size:9px;">P:₦${p.principalPaid.toLocaleString()}</span>` : '',
            p.interestPaid  > 0 ? `<span style="color:#0891b2;font-size:9px;">I:₦${p.interestPaid.toLocaleString()}</span>`  : '',
            p.penaltyPaid   > 0 ? `<span style="color:#dc2626;font-size:9px;">Pen:₦${p.penaltyPaid.toLocaleString()}</span>` : '',
        ].filter(Boolean).join(' &nbsp;');
        return `<tr style="background:${rowBg};">
            <td style="text-align:center;color:#9ca3af;font-size:11px;">${i+1}</td>
            <td style="font-size:11px;color:#6b7280;">${p.date || '—'} ${p.time || ''}</td>
            <td><strong style="font-size:12px;">${p.borrowerName || '—'}</strong><br><span style="color:#9ca3af;font-size:10px;">${p.borrowerType === 'external' ? '🏢 External' : (p.memberId || '—')}</span></td>
            <td style="font-size:10px;color:#6b7280;font-family:monospace;">${p.loanRef || p.reference || '—'}</td>
            <td><span style="background:${tb};color:${tc};padding:2px 6px;border-radius:10px;font-size:10px;font-weight:700;text-transform:uppercase;">${capSt(p.transactionType || '—')}</span></td>
            <td style="text-align:right;font-weight:800;font-size:12px;color:#059669;">₦${(p.amount||0).toLocaleString('en-NG',{minimumFractionDigits:2})}</td>
            <td>${breakdown || '<span style="color:#9ca3af;font-size:10px;">—</span>'}</td>
            <td><span style="background:${sb};color:${sc};padding:2px 6px;border-radius:10px;font-size:10px;font-weight:700;text-transform:uppercase;">${capSt(p.status || '—')}</span></td>
        </tr>`;
    }).join('');

    const html = `<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Club De Stars — Loan Payments</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#1e293b;background:#fff;}
.header{background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;padding:22px 28px;}
.header h1{font-size:20px;font-weight:800;margin-bottom:3px;}.header p{font-size:11px;opacity:.8;}
.meta{display:flex;gap:14px;padding:10px 28px;background:#f8fafc;border-bottom:1px solid #e2e8f0;flex-wrap:wrap;}
.mi{display:flex;flex-direction:column;min-width:80px;}
.mi span:first-child{font-size:9px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.07em;}
.mi span:last-child{font-size:13px;font-weight:800;color:#1e3a8a;}
.mi.g span:last-child{color:#059669;}.mi.r span:last-child{color:#dc2626;}.mi.a span:last-child{color:#d97706;}
table{width:100%;border-collapse:collapse;}
thead tr{background:#1e3a8a;color:white;}
thead th{padding:8px 9px;text-align:left;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap;}
thead th:first-child{text-align:center;width:28px;}
tbody td{padding:7px 9px;border-bottom:1px solid #f1f5f9;vertical-align:middle;}
.footer{padding:14px 28px;font-size:10px;color:#9ca3af;border-top:2px solid #e2e8f0;display:flex;justify-content:space-between;margin-top:6px;}
@media print{@page{size:A4 landscape;margin:7mm;}.no-print{display:none;}}
</style></head><body>
<div class="header">
    <h1>Club De Stars Cooperative — Loan Payments Report</h1>
    <p>Generated: ${now} &nbsp;|&nbsp; ${useFilter && (activeStatus !== 'all' || activeType !== 'all') ? `Filter: ${activeStatus} / ${activeType}` : 'Full Export'}</p>
</div>
<div class="meta">
