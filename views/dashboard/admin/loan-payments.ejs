    const win = window.open('', '_blank', 'width=1300,height=850');
    win.document.write(html);
    win.document.close();
    win.focus();
}

/* ══════════════════════════════════════
   FILTER + SEARCH
══════════════════════════════════════ */
function applyFilter(dimension, value, btn) {
    if (dimension === 'status') {
        activeStatus = value;
        btn.closest('.d-inline-flex').querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    } else {
        activeType = value;
        btn.closest('.d-inline-flex').querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    }
    btn.classList.add('active');
    applySearch();
}

function applySearch() {
    const term = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('#tableBody tr').forEach(row => {
        const sMatch = activeStatus === 'all' || row.dataset.status === activeStatus;
        const tMatch = activeType   === 'all' || row.dataset.type   === activeType;
        const qMatch = !term || row.textContent.toLowerCase().includes(term);
        row.style.display = (sMatch && tMatch && qMatch) ? '' : 'none';
    });
    updateTableInfo();
}

/* ══════════════════════════════════════
   VIEW DETAILS
══════════════════════════════════════ */
function viewDetails(id) {
    const p = payments.find(x => x.id === id);
    if (!p) return;
    currentId = id;

    document.getElementById('dBorrowerName').textContent  = p.borrowerName || '—';
    document.getElementById('dBorrowerId').textContent    = p.borrowerType === 'external' ? '🏢 External' : (p.memberId || '—');
    document.getElementById('dBorrowerEmail').textContent = p.email || '—';
    document.getElementById('dReference').textContent     = p.reference || '—';
    document.getElementById('dDateTime').textContent      = `${p.date} at ${p.time}`;
    document.getElementById('dMethod').textContent        = p.paymentMethod || '—';
    document.getElementById('dNotes').textContent         = p.notes || '—';
    document.getElementById('dTotalAmount').textContent   = fmt(p.amount);

    const statusEl = document.getElementById('dStatus');
    statusEl.className = `status-badge status-${p.status}`;
    statusEl.textContent = capSt(p.status);

    const typeMap = {
        repayment:   ['type-repayment',   'fa-hand-holding-usd',     'Repayment'],
        rollover:    ['type-rollover',    'fa-sync-alt',             'Rollover'],
        interest:    ['type-interest',    'fa-percentage',           'Interest'],
        penalty:     ['type-penalty',     'fa-exclamation-triangle', 'Penalty'],
        disbursement:['type-disbursement','fa-arrow-up',             'Disbursement'],
    };
    const [cls, icon, label] = typeMap[p.transactionType] || typeMap.repayment;
    const tb = document.getElementById('dTypeBadge');
    tb.className = `type-badge ${cls} ms-2`;
    tb.innerHTML = `<i class="fas ${icon} me-1"></i>${label}`;

    document.getElementById('dPrincipal').textContent     = fmt(p.principalPaid);
    document.getElementById('dInterest').textContent      = fmt(p.interestPaid);
    document.getElementById('dPenalty').textContent       = fmt(p.penaltyPaid);
    document.getElementById('dBalanceBefore').textContent = p.balanceBefore != null ? fmt(p.balanceBefore) : '—';
    document.getElementById('dBalanceAfter').textContent  = p.balanceAfter  != null ? fmt(p.balanceAfter)  : '—';
    document.getElementById('dAmountApplied').textContent = fmt(p.amount);

    const isPending = p.status === 'pending';
    document.getElementById('detailApproveBtn').style.display = isPending ? '' : 'none';
    document.getElementById('detailRejectBtn').style.display  = isPending ? '' : 'none';

    new bootstrap.Modal(document.getElementById('detailModal')).show();
}

/* ══════════════════════════════════════
   MODAL SWITCHING
══════════════════════════════════════ */
function switchModal(fromId, toFn) {
    const el = document.getElementById(fromId);
    const inst = bootstrap.Modal.getInstance(el);
    if (inst) {
        el.addEventListener('hidden.bs.modal', function h() { el.removeEventListener('hidden.bs.modal', h); toFn(); });
        inst.hide();
    } else { toFn(); }
}

function showAlert(message, type = 'info', title = null) {
    const cfg = {
        success: { hdr:'bg-success', ibg:'rgba(16,185,129,0.12)', ic:'#10b981', icls:'fas fa-check-circle',        btn:'btn-success', t:'Success' },
        danger:  { hdr:'bg-danger',  ibg:'rgba(239,68,68,0.12)',  ic:'#ef4444', icls:'fas fa-times-circle',         btn:'btn-danger',  t:'Error'   },
        warning: { hdr:'bg-warning', ibg:'rgba(245,158,11,0.12)', ic:'#f59e0b', icls:'fas fa-exclamation-triangle', btn:'btn-warning', t:'Warning' },
        info:    { hdr:'bg-primary', ibg:'rgba(59,130,246,0.12)', ic:'#3b82f6', icls:'fas fa-info-circle',          btn:'btn-primary', t:'Info'    },
    };
    const c = cfg[type] || cfg.info;
    document.getElementById('alertModalHeader').className    = `modal-header ${c.hdr} text-white border-0`;
    document.getElementById('alertModalCloseBtn').className  = 'btn-close btn-close-white';
    document.getElementById('alertModalLabel').textContent   = title || c.t;
    const iw = document.getElementById('alertModalIconWrapper');
    iw.style.background = c.ibg;
    const ic = document.getElementById('alertModalIcon');
    ic.className = `${c.icls} fa-2x`; ic.style.color = c.ic;
    document.getElementById('alertModalMessage').textContent = message;
    document.getElementById('alertModalOkBtn').className     = `btn px-4 fw-semibold ${c.btn}`;
    const open = document.querySelector('.modal.show');
    if (open && open.id !== 'alertModal') {
        switchModal(open.id, () => new bootstrap.Modal(document.getElementById('alertModal')).show());
    } else {
        new bootstrap.Modal(document.getElementById('alertModal')).show();
    }
}

/* ══════════════════════════════════════
   APPROVE / REJECT
══════════════════════════════════════ */
function openApprove(id) { currentId = id; new bootstrap.Modal(document.getElementById('approvalModal')).show(); }
function approveFromDetail() { switchModal('detailModal', () => new bootstrap.Modal(document.getElementById('approvalModal')).show()); }

async function confirmApproval() {
    const notes = document.getElementById('approvalNotes').value;
    try {
        const res    = await fetch(`/admin/loans/${currentId}/approve-payment`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ notes })
        });
        const result = await res.json();
        if (!res.ok) { showAlert(result.message || 'Approval failed.', 'danger', 'Approval Failed'); return; }
        const p = payments.find(x => x.id === currentId);
        if (p) p.status = 'approved';
        updateRow(currentId, 'approved');
        document.getElementById('approvalNotes').value = '';
        document.getElementById('successMessage').textContent = result.overpaymentCredited
            ? `Payment approved! ₦${result.overpaymentCredited.toLocaleString()} overpayment credited to savings.`
            : 'Loan payment approved and applied successfully!';
        switchModal('approvalModal', () => new bootstrap.Modal(document.getElementById('successModal')).show());
    } catch { showAlert('Network error. Please try again.', 'danger', 'Network Error'); }
}

function openReject(id) { currentId = id; new bootstrap.Modal(document.getElementById('rejectionModal')).show(); }
function rejectFromDetail() { switchModal('detailModal', () => new bootstrap.Modal(document.getElementById('rejectionModal')).show()); }

async function confirmRejection() {
    const reason = document.getElementById('rejectionReason').value.trim();
    if (!reason) { showAlert('Please provide a reason before proceeding.', 'warning', 'Reason Required'); return; }
    try {
        const res    = await fetch(`/admin/loans/${currentId}/reject-payment`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason })
        });
        const result = await res.json();
        if (!res.ok) { showAlert(result.message || 'Rejection failed.', 'danger', 'Rejection Failed'); return; }
        const p = payments.find(x => x.id === currentId);
        if (p) p.status = 'rejected';
        updateRow(currentId, 'rejected');
        document.getElementById('rejectionReason').value = '';
        document.getElementById('successMessage').textContent = 'Loan payment rejected.';
        switchModal('rejectionModal', () => new bootstrap.Modal(document.getElementById('successModal')).show());
    } catch { showAlert('Network error. Please try again.', 'danger', 'Network Error'); }
}

function updateRow(id, status) {
    document.querySelectorAll('#tableBody tr').forEach(row => {
        if (row.innerHTML.includes(`'${id}'`)) {
            row.dataset.status = status;
            const statusCell = row.querySelector('[data-label="Status"]');
            if (statusCell) statusCell.innerHTML = `<span class="status-badge status-${status}">${capSt(status)}</span>`;
            const actionsCell = row.querySelector('[data-label="Actions"]');
            if (actionsCell) actionsCell.innerHTML = `<div class="d-flex gap-1 flex-wrap"><button class="action-btn btn-view" onclick="viewDetails('${id}')"><i class="fas fa-eye"></i></button></div>`;
        }
    });
    updateTableInfo();
}

/* ══════════════════════════════════════
   SIDEBAR
══════════════════════════════════════ */
function toggleSidebar(e) {
    e.stopPropagation();
    document.getElementById('sidebar').classList.toggle('active');
    document.getElementById('sidebarOverlay').classList.toggle('active');
}
function closeSidebar() {
    document.getElementById('sidebar').classList.remove('active');
    document.getElementById('sidebarOverlay').classList.remove('active');
}
document.addEventListener('click', e => {
    const sb = document.getElementById('sidebar');
    if (window.innerWidth <= 992 && !sb.contains(e.target) && !e.target.closest('.fa-bars') && sb.classList.contains('active'))
        closeSidebar();
});

async function loadSidebarPendingCount() {
    try {
        const res  = await fetch('/admin/pending-approvals-count');
        const data = await res.json();
        const badge = document.getElementById('sidebarPendingBadge');
        if (!badge) return;
        badge.style.display = data.count > 0 ? 'inline-block' : 'none';
        if (data.count > 0) badge.textContent = data.count;
    } catch {}
}
document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
</script>
</body>
</html>