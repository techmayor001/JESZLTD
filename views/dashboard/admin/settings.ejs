<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ══════════ NEW SIDEBAR STYLES ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto; transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }
        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18);
            position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box { width: 42px; height: 42px; background: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--primary); font-size: 1.3rem; box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0; }
        .sidebar-brand { font-size: .95rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .65rem; font-weight: 500; opacity: .55; display: block; letter-spacing: .08em; }
        .role-pill { display: inline-flex; align-items: center; gap: 7px; padding: 4px 10px; background: rgba(239,68,68,.2); border-radius: 20px; border: 1px solid rgba(239,68,68,.3); font-weight: 700; font-size: .7rem; color: #fca5a5; }
        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }
        .nav-category { display: flex; align-items: center; gap: 7px; padding: .55rem 1.25rem .3rem; font-size: .62rem; font-weight: 800; color: rgba(255,255,255,.38); text-transform: uppercase; letter-spacing: .1em; user-select: none; }
        .nav-category::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.08); margin-left: 4px; }
        .sidebar-nav a { display: flex; align-items: center; gap: 11px; padding: .62rem 1.25rem; color: rgba(255,255,255,.72); text-decoration: none; font-weight: 500; font-size: .84rem; border-left: 3px solid transparent; transition: all .18s; }
        .sidebar-nav a:hover { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }
        .nav-badge { margin-left: auto; font-size: .63rem; font-weight: 800; padding: 2px 7px; border-radius: 10px; background: rgba(239,68,68,.9); color: white; flex-shrink: 0; line-height: 1.4; }
        .nav-back { display: flex; align-items: center; gap: 10px; padding: .7rem 1.25rem .9rem; font-size: .8rem; font-weight: 600; color: rgba(255,255,255,.42); text-decoration: none; transition: color .18s; border-top: 1px solid rgba(255,255,255,.07); margin-top: .25rem; }
        .nav-back:hover { color: rgba(255,255,255,.7); }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }
        /* ══════════ END NEW SIDEBAR STYLES ══════════ */

        .top-navbar { position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: 70px; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); box-shadow: 0 4px 15px rgba(30,58,138,0.08); z-index: 1030; display: flex; align-items: center; padding: 0 2rem; transition: all 0.3s; border-bottom: 1px solid rgba(30,58,138,0.1); }

        .main-content { margin-left: var(--sidebar-width); margin-top: 70px; padding: 2rem; transition: all 0.3s; min-height: calc(100vh - 70px); }
        .settings-container { max-width: 1600px; margin: 0 auto; }

        .page-header { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white; padding: 2.5rem; border-radius: 20px; margin-bottom: 2.5rem; box-shadow: 0 15px 40px rgba(30,58,138,0.25); }
        .page-header h2 { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
        .page-header p { font-size: 1rem; opacity: 0.95; margin: 0; }

        .settings-section { margin-bottom: 2.5rem; }
        .section-title { color: var(--primary); font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 12px; }
        .section-title .icon-badge { width: 50px; height: 50px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: white; }
        .settings-card { background: white; border-radius: 20px; padding: 2rem; box-shadow: 0 8px 25px rgba(30,58,138,0.08); border: 1px solid rgba(30,58,138,0.05); transition: all 0.3s; margin-bottom: 1.5rem; }
        .settings-card:hover { box-shadow: 0 12px 35px rgba(30,58,138,0.12); transform: translateY(-2px); }
        .card-header-custom { border-bottom: 2px solid rgba(30,58,138,0.08); padding-bottom: 1.25rem; margin-bottom: 2rem; }
        .card-header-custom h5 { color: var(--primary); font-weight: 700; font-size: 1.25rem; margin: 0 0 0.5rem 0; display: flex; align-items: center; gap: 10px; }
        .card-header-custom p { color: var(--secondary); font-size: 0.95rem; margin: 0; }
        .icon-box { width: 45px; height: 45px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; }

        .form-group { margin-bottom: 1.75rem; }
        .form-label { font-weight: 600; color: var(--primary); margin-bottom: 0.75rem; font-size: 0.95rem; display: flex; align-items: center; gap: 8px; }
        .form-label i { color: var(--primary-light); font-size: 0.9rem; }
        .form-control, .form-select { border: 2px solid rgba(30,58,138,0.12); border-radius: 12px; padding: 0.875rem 1.25rem; transition: all 0.3s; font-size: 0.95rem; font-weight: 500; }
        .form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 0.25rem rgba(30,58,138,0.1); }
        .input-group-text { background: linear-gradient(135deg,rgba(30,58,138,0.08) 0%,rgba(59,130,246,0.08) 100%); border: 2px solid rgba(30,58,138,0.12); border-right: none; color: var(--primary); font-weight: 700; border-radius: 12px 0 0 12px; padding: 0.875rem 1rem; }
        .input-group .form-control { border-left: none; border-radius: 0 12px 12px 0; }

        .btn-primary { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); border: none; padding: 0.875rem 2.5rem; border-radius: 12px; font-weight: 600; font-size: 1rem; transition: all 0.3s; box-shadow: 0 4px 15px rgba(30,58,138,0.2); }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(30,58,138,0.35); }
        .btn-secondary { background: var(--secondary); border: none; padding: 0.875rem 2rem; border-radius: 12px; font-weight: 600; font-size: 1rem; transition: all 0.3s; }
        .btn-secondary:hover { background: #475569; transform: translateY(-2px); }
        .btn-danger-custom { background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); border: none; padding: 0.875rem 2rem; border-radius: 12px; font-weight: 600; font-size: 1rem; color: white; transition: all 0.3s; box-shadow: 0 4px 15px rgba(220,38,38,0.25); cursor: pointer; }
        .btn-danger-custom:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(220,38,38,0.4); }
        .btn-success-custom { background: linear-gradient(135deg, #059669 0%, #10b981 100%); border: none; padding: 0.875rem 2rem; border-radius: 12px; font-weight: 600; font-size: 1rem; color: white; transition: all 0.3s; box-shadow: 0 4px 15px rgba(5,150,105,0.25); cursor: pointer; }
        .btn-success-custom:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(5,150,105,0.4); }

        .current-value { background: linear-gradient(135deg,rgba(16,185,129,0.08) 0%,rgba(5,150,105,0.08) 100%); border: 2px solid rgba(16,185,129,0.2); border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1.25rem; }
        .current-value-label { font-size: 0.85rem; color: var(--secondary); margin-bottom: 0.5rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .current-value-amount { font-size: 1.75rem; font-weight: 700; color: var(--success); display: flex; align-items: center; gap: 8px; }
        .settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; }
        .divider { height: 2px; background: linear-gradient(90deg,transparent,rgba(30,58,138,0.15),transparent); margin: 2rem 0; }
        .help-text { font-size: 0.85rem; color: var(--secondary); margin-top: 0.75rem; display: flex; align-items: start; gap: 8px; line-height: 1.5; }
        .help-text i { margin-top: 2px; flex-shrink: 0; }
        .alert-info-custom { background: linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%); border: 2px solid #3b82f6; border-radius: 14px; padding: 1.25rem 1.5rem; color: #1e40af; margin-bottom: 2rem; display: flex; align-items: start; gap: 12px; }
        .alert-info-custom i { font-size: 1.25rem; margin-top: 2px; }

        .maintenance-status-card { border-radius: 18px; padding: 2rem; margin-bottom: 1.5rem; transition: all 0.4s; border: 2px solid; }
        .maintenance-status-card.offline { background: linear-gradient(135deg,#fef2f2 0%,#fee2e2 100%); border-color: rgba(239,68,68,0.3); }
        .maintenance-status-card.online { background: linear-gradient(135deg,#f0fdf4 0%,#dcfce7 100%); border-color: rgba(16,185,129,0.3); }
        .status-pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 50px; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.5px; text-transform: uppercase; }
        .status-pill.active-pill { background: rgba(239,68,68,0.15); color: #dc2626; border: 1px solid rgba(239,68,68,0.3); }
        .status-pill.inactive-pill { background: rgba(16,185,129,0.15); color: #059669; border: 1px solid rgba(16,185,129,0.3); }
        .status-pulse { width: 10px; height: 10px; border-radius: 50%; animation: pulse 1.5s infinite; }
        .status-pulse.red { background: #ef4444; }
        .status-pulse.green { background: #10b981; }
        @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(1.4)} }
        .maintenance-icon { font-size: 3.5rem; margin-bottom: 1rem; }
        .maintenance-title { font-size: 1.4rem; font-weight: 700; margin-bottom: 0.4rem; }
        .maintenance-meta { font-size: 0.9rem; color: var(--secondary); }

        .account-display { background: linear-gradient(135deg,rgba(30,58,138,0.04) 0%,rgba(59,130,246,0.06) 100%); border: 2px solid rgba(30,58,138,0.1); border-radius: 14px; padding: 1.5rem; margin-bottom: 1.5rem; }
        .account-row { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid rgba(30,58,138,0.06); }
        .account-row:last-child { border-bottom: none; }
        .account-row .label { font-size: 0.85rem; color: var(--secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .account-row .value { font-size: 1rem; font-weight: 700; color: var(--primary); }

        .verify-spinner-wrap { display: flex; align-items: center; justify-content: center; min-width: 38px; }
        .account-name-verified { border-color: #10b981 !important; background: rgba(16,185,129,0.04) !important; }
        .account-name-error { border-color: #ef4444 !important; background: rgba(239,68,68,0.04) !important; }
        .verify-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 600; margin-top: 6px; }
        .verify-badge.v-success { background: rgba(16,185,129,0.12); color: #059669; border: 1px solid rgba(16,185,129,0.25); }
        .verify-badge.v-error   { background: rgba(239,68,68,0.10); color: #dc2626; border: 1px solid rgba(239,68,68,0.2); }
        .verify-badge.v-loading { background: rgba(59,130,246,0.10); color: #1d4ed8; border: 1px solid rgba(59,130,246,0.2); }

        .danger-zone-card { background: linear-gradient(135deg, #fff5f5 0%, #fef2f2 100%); border: 2px solid rgba(220,38,38,0.3); border-radius: 20px; padding: 2rem; box-shadow: 0 8px 25px rgba(220,38,38,0.08); }
        .danger-zone-card:hover { box-shadow: 0 12px 35px rgba(220,38,38,0.15); transform: translateY(-2px); }
        .danger-zone-header { display: flex; align-items: center; gap: 14px; margin-bottom: 1.5rem; padding-bottom: 1.25rem; border-bottom: 2px solid rgba(220,38,38,0.12); }
        .danger-zone-header h5 { color: #dc2626; font-weight: 700; font-size: 1.2rem; margin: 0; }
        .danger-zone-header p { color: #64748b; font-size: 0.9rem; margin: 4px 0 0; }
        .danger-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 800; background: rgba(220,38,38,0.12); color: #dc2626; border: 1px solid rgba(220,38,38,0.25); letter-spacing: 0.04em; text-transform: uppercase; margin-left: 10px; }
        .danger-action-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; padding: 1.5rem; background: rgba(255,255,255,0.7); border: 1.5px solid rgba(220,38,38,0.15); border-radius: 14px; }
        .danger-action-info h6 { font-weight: 700; color: #991b1b; margin-bottom: 4px; font-size: 1rem; }
        .danger-action-info p { color: #64748b; font-size: 0.88rem; margin: 0; line-height: 1.5; }
        .btn-clear-db { background: linear-gradient(135deg, #7f1d1d 0%, #dc2626 100%); border: none; padding: 0.8rem 2rem; border-radius: 12px; font-weight: 700; font-size: 0.95rem; color: white; transition: all 0.3s; box-shadow: 0 4px 15px rgba(127,29,29,0.3); cursor: pointer; white-space: nowrap; }
        .btn-clear-db:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(127,29,29,0.45); }

        .admin-code-input { letter-spacing: 4px; font-size: 1.2rem; font-weight: 700; text-align: center; font-family: monospace; border: 2px solid rgba(220,38,38,0.25) !important; border-radius: 12px; }
        .admin-code-input:focus { border-color: #dc2626 !important; box-shadow: 0 0 0 0.25rem rgba(220,38,38,0.15) !important; }

        .toast-container-custom { position: fixed; top: 85px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; pointer-events: none; min-width: 300px; }
        .toast-item { pointer-events: all; display: flex; align-items: center; gap: 12px; padding: 1.1rem 1.4rem; border-radius: 14px; color: white; font-weight: 600; font-size: 0.93rem; box-shadow: 0 10px 35px rgba(0,0,0,0.18); transform: translateX(380px); opacity: 0; transition: transform 0.38s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease; }
        .toast-item.show { transform: translateX(0); opacity: 1; }
        .toast-item.toast-success { background: linear-gradient(135deg,#10b981 0%,#059669 100%); }
        .toast-item.toast-error   { background: linear-gradient(135deg,#ef4444 0%,#dc2626 100%); }
        .toast-item.toast-warning { background: linear-gradient(135deg,#f59e0b 0%,#d97706 100%); }
        .toast-item .t-close { margin-left: auto; cursor: pointer; opacity: 0.75; }
        .toast-item .t-close:hover { opacity: 1; }

        .modal-content { border: none; border-radius: 20px; box-shadow: 0 25px 60px rgba(0,0,0,0.15); }
        .modal-header { border-radius: 20px 20px 0 0; border-bottom: 2px solid rgba(30,58,138,0.07); padding: 1.5rem 1.75rem; }
        .modal-footer { border-top: 2px solid rgba(30,58,138,0.06); border-radius: 0 0 20px 20px; padding: 1.25rem 1.75rem; }
        .confirm-icon-circle { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.25rem; }
        .confirm-icon-circle.ci-danger  { background: linear-gradient(135deg,#fef2f2,#fee2e2); color: #dc2626; }
        .confirm-icon-circle.ci-success { background: linear-gradient(135deg,#f0fdf4,#dcfce7); color: #059669; }
        .confirm-icon-circle.ci-warning { background: linear-gradient(135deg,#fffbeb,#fef3c7); color: #d97706; }
        .confirm-title { font-size: 1.3rem; font-weight: 700; color: var(--primary); text-align: center; margin-bottom: 0.5rem; }
        .confirm-body-text { color: var(--secondary); text-align: center; font-size: 0.96rem; line-height: 1.65; }

        .action-buttons { display: flex; gap: 12px; justify-content: flex-end; flex-wrap: wrap; margin-top: 2rem; }
        .powered-by { position: fixed; bottom: 20px; right: 20px; background: white; padding: 12px 20px; border-radius: 30px; box-shadow: 0 4px 20px rgba(30,58,138,0.15); font-size: 0.85rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; padding: 0 1.5rem; }
            .main-content { margin-left: 0; padding: 1.5rem; }
            .settings-grid { grid-template-columns: 1fr; gap: 1.5rem; }
        }
        @media (max-width: 768px) {
            .main-content { padding: 1.25rem; }
            .page-header { padding: 1.75rem; }
            .page-header h2 { font-size: 1.5rem; }
            .settings-card { padding: 1.5rem; }
            .btn-primary, .btn-secondary, .btn-danger-custom, .btn-success-custom { width: 100%; }
            .action-buttons { flex-direction: column-reverse; }
            .toast-container-custom { right: 12px; left: 12px; min-width: auto; }
            .danger-action-row { flex-direction: column; align-items: flex-start; }
            .btn-clear-db { width: 100%; }
        }
        @media (max-width: 576px) {
            .top-navbar { height: 60px; padding: 0 1rem; }
            .main-content { margin-top: 60px; padding: 1rem; }
            .page-header { padding: 1.4rem; border-radius: 16px; }
            .page-header h2 { font-size: 1.3rem; }
            .settings-card { padding: 1.25rem; }
        }
    </style>
</head>
<body>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
    <div class="toast-container-custom" id="toastContainer"></div>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL: Reset Registration Fees
    ═══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="resetRegFeesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body pt-4 px-4 text-center">
                    <div class="confirm-icon-circle ci-warning"><i class="fas fa-undo"></i></div>
                    <div class="confirm-title">Reset Fees?</div>
                    <p class="confirm-body-text">Registration fees will be reset to their default values.<br><strong>Adult: ₦5,000 &nbsp;/&nbsp; Kiddies: ₦2,500</strong></p>
                </div>
                <div class="modal-footer justify-content-center gap-2 border-0 pb-4">
                    <button class="btn btn-light px-4 fw-semibold" style="border-radius:12px;" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-warning px-4 fw-semibold" style="border-radius:12px;" onclick="doResetRegFees()">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL: Reset Kiddies Settings
    ═══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="resetKiddiesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body pt-4 px-4 text-center">
                    <div class="confirm-icon-circle ci-warning"><i class="fas fa-undo"></i></div>
                    <div class="confirm-title">Reset Kiddies Settings?</div>
                    <p class="confirm-body-text">All kiddies account settings will be restored to their system defaults.</p>
                </div>
                <div class="modal-footer justify-content-center gap-2 border-0 pb-4">
                    <button class="btn btn-light px-4 fw-semibold" style="border-radius:12px;" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-warning px-4 fw-semibold" style="border-radius:12px;" onclick="doResetKiddiesSettings()">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL: Reset Other Fees
    ═══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="resetOtherFeesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body pt-4 px-4 text-center">
                    <div class="confirm-icon-circle ci-warning"><i class="fas fa-undo"></i></div>
                    <div class="confirm-title">Reset Fees?</div>
                    <p class="confirm-body-text">ROI Operating Charge will be reset to <strong>10%</strong>.</p>
                </div>
                <div class="modal-footer justify-content-center gap-2 border-0 pb-4">
                    <button class="btn btn-light px-4 fw-semibold" style="border-radius:12px;" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-warning px-4 fw-semibold" style="border-radius:12px;" onclick="doResetOtherFees()">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL: Enable Maintenance Mode
    ═══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="maintenanceEnableModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="color:#dc2626;"><i class="fas fa-exclamation-triangle me-2"></i>Enable Maintenance Mode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="confirm-icon-circle ci-danger"><i class="fas fa-tools"></i></div>
                    <div class="confirm-title">Take System Offline?</div>
                    <p class="confirm-body-text mb-3">
                        This will make the portal <strong>inaccessible to all members immediately</strong>. They will see the maintenance message below until you bring the system back online.
                    </p>
                    <div class="alert-info-custom mb-0">
                        <i class="fas fa-eye"></i>
                        <div>
                            <strong>Members will see:</strong><br>
                            <span id="maintenancePreviewText" style="font-style:italic;opacity:0.85;font-size:0.9rem;"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer gap-2 justify-content-end">
                    <button class="btn btn-light px-4 fw-semibold" style="border-radius:12px;" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger px-4 fw-semibold" style="border-radius:12px;" onclick="doToggleMaintenance(true)">
                        <i class="fas fa-power-off me-2"></i>Take Offline
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL: Disable Maintenance Mode
    ═══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="maintenanceDisableModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body pt-4 px-4 text-center">
                    <div class="confirm-icon-circle ci-success"><i class="fas fa-check-circle"></i></div>
                    <div class="confirm-title">Bring System Online?</div>
                    <p class="confirm-body-text">Members will be able to access the portal normally again.</p>
                </div>
                <div class="modal-footer justify-content-center gap-2 border-0 pb-4">
                    <button class="btn btn-light px-4 fw-semibold" style="border-radius:12px;" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-success px-4 fw-semibold" style="border-radius:12px;" onclick="doToggleMaintenance(false)">
                        <i class="fas fa-check me-2"></i>Bring Online
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL STEP 1: Clear Database — Initial Warning
    ═══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="clearDbWarningModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border: 2px solid rgba(220,38,38,0.3);">
                <div class="modal-header" style="background:linear-gradient(135deg,#7f1d1d 0%,#dc2626 100%);border-radius:18px 18px 0 0;border:none;">
                    <h5 class="modal-title text-white fw-bold">
                        <i class="fas fa-skull-crossbones me-2"></i>DANGER — Clear Entire Database
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 py-4">
                    <div class="confirm-icon-circle ci-danger" style="font-size:2.4rem;">
                        <i class="fas fa-database"></i>
                    </div>
                    <div class="confirm-title" style="color:#7f1d1d;">This Will Erase Everything</div>
                    <p class="confirm-body-text mb-3">
                        Clicking <strong>Continue</strong> will permanently delete <strong>all data</strong> from the database — including all members, accounts, transactions, loans, reports, and settings.
                    </p>
                    <div style="background:rgba(220,38,38,0.06);border:1.5px solid rgba(220,38,38,0.2);border-radius:12px;padding:1rem 1.25rem;margin-bottom:1rem;">
                        <div style="font-size:0.82rem;font-weight:700;color:#7f1d1d;margin-bottom:0.6rem;text-transform:uppercase;letter-spacing:0.05em;">What will be erased:</div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;font-size:0.85rem;color:#374151;">
                            <span><i class="fas fa-times-circle text-danger me-1" style="font-size:0.75rem;"></i>All member accounts</span>
                            <span><i class="fas fa-times-circle text-danger me-1" style="font-size:0.75rem;"></i>All transactions</span>
                            <span><i class="fas fa-times-circle text-danger me-1" style="font-size:0.75rem;"></i>All kiddies accounts</span>
                            <span><i class="fas fa-times-circle text-danger me-1" style="font-size:0.75rem;"></i>All loan records</span>
                            <span><i class="fas fa-times-circle text-danger me-1" style="font-size:0.75rem;"></i>All deposit reports</span>
                            <span><i class="fas fa-times-circle text-danger me-1" style="font-size:0.75rem;"></i>All withdrawal records</span>
                            <span><i class="fas fa-times-circle text-danger me-1" style="font-size:0.75rem;"></i>All admin logs</span>
                            <span><i class="fas fa-times-circle text-danger me-1" style="font-size:0.75rem;"></i>All company ledger entries</span>
                        </div>
                    </div>
                    <div style="background:rgba(245,158,11,0.1);border:1.5px solid rgba(245,158,11,0.3);border-radius:10px;padding:0.875rem 1rem;font-size:0.85rem;color:#92400e;">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>This action is irreversible.</strong> There is no undo. Make sure you have a backup before proceeding.
                    </div>
                </div>
                <div class="modal-footer gap-2 justify-content-end" style="border-top:2px solid rgba(220,38,38,0.1);">
                    <button class="btn btn-light px-4 fw-semibold" style="border-radius:12px;" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button class="btn fw-bold px-4 text-white" style="background:linear-gradient(135deg,#7f1d1d,#dc2626);border:none;border-radius:12px;" onclick="proceedToClearDbCode()">
                        <i class="fas fa-arrow-right me-2"></i>Continue — Enter Admin Code
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL STEP 2: Clear Database — Admin Code Entry
    ═══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="clearDbCodeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content" style="border: 2px solid rgba(220,38,38,0.3);">
                <div class="modal-header" style="background:linear-gradient(135deg,#7f1d1d 0%,#dc2626 100%);border-radius:18px 18px 0 0;border:none;">
                    <h5 class="modal-title text-white fw-bold">
                        <i class="fas fa-key me-2"></i>Enter Admin Code
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 py-4 text-center">
                    <div class="confirm-icon-circle ci-danger"><i class="fas fa-lock"></i></div>
                    <div class="confirm-title" style="color:#7f1d1d;font-size:1.1rem;">Final Confirmation</div>
                    <p class="confirm-body-text mb-3" style="font-size:0.9rem;">
                        Enter the secret admin code to authorise this irreversible action.
                    </p>
                    <input
                        type="password"
                        id="adminClearCode"
                        class="form-control admin-code-input"
                        placeholder="••••••••"
                        autocomplete="off"
                        maxlength="32">
                    <div id="clearCodeError" class="mt-2" style="display:none;color:#dc2626;font-size:0.85rem;font-weight:600;">
                        <i class="fas fa-exclamation-circle me-1"></i><span id="clearCodeErrorText"></span>
                    </div>
                </div>
                <div class="modal-footer gap-2 justify-content-center" style="border-top:2px solid rgba(220,38,38,0.1);">
                    <button class="btn btn-light px-4 fw-semibold" style="border-radius:12px;" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn fw-bold px-4 text-white" style="background:linear-gradient(135deg,#7f1d1d,#dc2626);border:none;border-radius:12px;min-width:140px;" id="clearDbSubmitBtn" onclick="submitClearDatabase()">
                        <i class="fas fa-trash-alt me-2"></i>Clear Database
                    </button>
                </div>
            </div>
        </div>
    </div>

