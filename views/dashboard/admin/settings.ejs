    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;" onclick="toggleSidebar()"></i>
        <div class="flex-grow-1">
            <h5 class="mb-0 fw-bold d-none d-md-block" style="color:var(--primary)">System Settings</h5>
            <h6 class="mb-0 fw-bold d-md-none" style="color:var(--primary)">Settings</h6>
            <small class="text-muted d-none d-sm-block">Configure system parameters</small>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="position-relative">
                <i class="fas fa-bell" style="color:var(--primary);font-size:1.25rem;cursor:pointer;"></i>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <div class="settings-container">

            <!-- Page Header -->
            <div class="page-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h2 class="mb-2 fw-bold"><i class="fas fa-cog me-2"></i>System Settings</h2>
                        <p class="mb-0 opacity-90">Configure system parameters and fee structures for your cooperative</p>
                    </div>
                    <a href="/cds-cooperative/dashboard" class="text-decoration-none">
                        <button class="btn btn-light fw-semibold"><i class="fas fa-arrow-left me-2"></i>Back to Dashboard</button>
                    </a>
                </div>
            </div>

            <!-- ── MAINTENANCE MODE ──────────────────────────────────── -->
            <div class="settings-section">
                <div class="section-title">
                    <div class="icon-badge" style="background:linear-gradient(135deg,#dc2626 0%,#ef4444 100%);">
                        <i class="fas fa-tools"></i>
                    </div>
                    Maintenance Mode
                </div>

                <div class="settings-card">
                    <div class="card-header-custom">
                        <h5>
                            <div class="icon-box" style="background:linear-gradient(135deg,#dc2626 0%,#f87171 100%);color:white;"><i class="fas fa-power-off"></i></div>
                            System Maintenance Control
                        </h5>
                        <p>Take the system offline for maintenance. Members will see the maintenance message instead of the portal.</p>
                    </div>

                    <div class="maintenance-status-card <%= settings.maintenanceMode.enabled ? 'offline' : 'online' %>">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                            <div>
                                <div class="maintenance-icon"><%= settings.maintenanceMode.enabled ? '🔧' : '✅' %></div>
                                <div class="maintenance-title" style="color:<%= settings.maintenanceMode.enabled ? '#dc2626' : '#059669' %>">
                                    System is Currently <strong><%= settings.maintenanceMode.enabled ? 'OFFLINE' : 'ONLINE' %></strong>
                                </div>
                                <div class="maintenance-meta">
                                    <% if (settings.maintenanceMode.enabled && settings.maintenanceMode.enabledAt) { %>
                                        Maintenance started: <strong><%= new Date(settings.maintenanceMode.enabledAt).toLocaleString() %></strong>
                                    <% } else { %>
                                        All systems operational — members can access the portal normally.
                                    <% } %>
                                </div>
                            </div>
                            <div>
                                <span class="status-pill <%= settings.maintenanceMode.enabled ? 'active-pill' : 'inactive-pill' %>">
                                    <span class="status-pulse <%= settings.maintenanceMode.enabled ? 'red' : 'green' %>"></span>
                                    <%= settings.maintenanceMode.enabled ? 'MAINTENANCE ACTIVE' : 'SYSTEM ONLINE' %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-comment-alt"></i>Maintenance Message</label>
                        <textarea class="form-control" id="maintenanceMessage" rows="3" placeholder="Enter the message members will see during maintenance..."><%= settings.maintenanceMode.message %></textarea>
                        <div class="help-text"><i class="fas fa-info-circle"></i><span>This message is displayed to members when they try to access the portal during maintenance.</span></div>
                    </div>

                    <div class="divider"></div>

                    <div class="action-buttons">
                        <% if (settings.maintenanceMode.enabled) { %>
                            <button class="btn-success-custom" onclick="confirmMaintenanceDisable()">
                                <i class="fas fa-check-circle me-2"></i>Bring System Online
                            </button>
                        <% } else { %>
                            <button class="btn-danger-custom" onclick="confirmMaintenanceEnable()">
                                <i class="fas fa-tools me-2"></i>Enable Maintenance Mode
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- ── REGISTRATION FEES ─────────────────────────────────── -->
            <div class="settings-section">
                <div class="section-title">
                    <div class="icon-badge" style="background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%);">
                        <i class="fas fa-percentage"></i>
                    </div>
                    System Configuration
                </div>

                <div class="settings-card">
                    <div class="settings-card">
                        <div class="card-header-custom">
                            <h5>
                                <div class="icon-box" style="background:linear-gradient(135deg,#3b82f6 0%,#2563eb 100%);color:white;"><i class="fas fa-user-plus"></i></div>
                                Membership Registration Fees
                            </h5>
                            <p>Configure one-time registration fees for new members</p>
                        </div>

                        <div class="settings-grid">
                            <div>
                                <div class="current-value">
                                    <div class="current-value-label">Current Registration Fee</div>
                                    <div class="current-value-amount">₦<%= settings.registrationFees.adultRegistrationFee.toLocaleString() %></div>
                                </div>
                                <label class="form-label">Adult Membership Registration Fee</label>
                                <div class="input-group">
                                    <span class="input-group-text">₦</span>
                                    <input type="number" class="form-control" id="adultRegFee" value="<%= settings.registrationFees.adultRegistrationFee %>" step="100" min="0">
                                </div>
                                <div class="help-text"><i class="fas fa-info-circle me-1"></i>One-time fee for adult members (18+ years)</div>
                            </div>

                            <div>
                                <div class="current-value">
                                    <div class="current-value-label">Current Kiddies Fee</div>
                                    <div class="current-value-amount">₦<%= settings.registrationFees.kiddiesRegistrationFee.toLocaleString() %></div>
                                </div>
                                <label class="form-label">Kiddies Account Registration Fee</label>
                                <div class="input-group">
                                    <span class="input-group-text">₦</span>
                                    <input type="number" class="form-control" id="kiddiesRegFee" value="<%= settings.registrationFees.kiddiesRegistrationFee %>" step="100" min="0">
                                </div>
                                <div class="help-text"><i class="fas fa-info-circle me-1"></i>One-time fee for kiddies accounts</div>
                            </div>
                        </div>

                        <div class="divider"></div>

                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                            <button class="btn btn-secondary" onclick="showModal('resetRegFeesModal')">
                                <i class="fas fa-undo me-2"></i>Reset
                            </button>
                            <button class="btn btn-primary" onclick="updateRegFees()">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── KIDDIES ACCOUNT CONFIGURATION ───────────────────────── -->
            <div class="settings-section">
                <div class="section-title">
                    <div class="icon-badge" style="background:linear-gradient(135deg,#ec4899 0%,#db2777 100%);">
                        <i class="fas fa-child"></i>
                    </div>
                    Kiddies Account Configuration
                </div>

                <div class="settings-card">
                    <div class="card-header-custom">
                        <h5><i class="fas fa-piggy-bank"></i> Children's Savings Account Settings</h5>
                        <p>Configure parameters for children's savings accounts including age limits, fees, and upgrade rules</p>
                    </div>

                    <div class="alert-info-custom">
                        <i class="fas fa-lightbulb"></i>
                        <div><strong>About Kiddies Accounts:</strong> Special savings accounts designed for minors with automatic upgrade to adult accounts upon reaching the specified age threshold. Includes preferential interest rates and reduced fees.</div>
                    </div>

                    <div class="settings-grid">
                        <div class="form-group">
                            <label class="form-label"><i class="fas fa-hourglass-start"></i>Minimum Age Requirement</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="minAge" value="<%= settings.kiddiesSettings.minAge %>" min="0" max="17">
                                <span class="input-group-text">years</span>
                            </div>
                            <div class="help-text"><i class="fas fa-info-circle"></i><span>Minimum age required to open a kiddies savings account</span></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label"><i class="fas fa-hourglass-end"></i>Maximum Age Limit</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="maxAge" value="<%= settings.kiddiesSettings.maxAge %>" min="1" max="25">
                                <span class="input-group-text">years</span>
                            </div>
                            <div class="help-text"><i class="fas fa-info-circle"></i><span>Maximum age before mandatory upgrade</span></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label"><i class="fas fa-level-up-alt"></i>Auto-Upgrade Age Threshold</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="upgradeAge" value="<%= settings.kiddiesSettings.upgradeAge %>" min="16" max="25">
                                <span class="input-group-text">years</span>
                            </div>
                            <div class="help-text"><i class="fas fa-info-circle"></i><span>Account automatically converts to adult account at this age</span></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label"><i class="fas fa-percentage"></i>Kiddies Interest Rate (Annual)</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="kiddiesInterest" value="<%= settings.kiddiesSettings.kiddiesInterestRate %>" step="0.1" min="0" max="100">
                                <span class="input-group-text">%</span>
                            </div>
                            <div class="help-text"><i class="fas fa-info-circle"></i><span>Special preferential interest rate for kiddies savings accounts</span></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label"><i class="fas fa-calendar-alt"></i>Monthly Account Maintenance Fee</label>
                            <div class="input-group">
                                <span class="input-group-text">₦</span>
                                <input type="number" class="form-control" id="kiddiesMonthlyFee" value="<%= settings.kiddiesSettings.monthlyMaintenanceFee %>" step="50" min="0">
                            </div>
                            <div class="help-text"><i class="fas fa-info-circle"></i><span>Monthly fee charged for account maintenance</span></div>
                        </div>

