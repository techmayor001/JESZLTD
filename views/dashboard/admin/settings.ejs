    <div class="powered-by">Powered by <strong style="color:var(--primary);">JESZ LIMITED</strong></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
    // ══════════════════════════════════════════════════════════════
    // TOAST
    // ══════════════════════════════════════════════════════════════
    function showToast(message, type = 'success') {
        const icons = { success: 'fa-check-circle', error: 'fa-exclamation-circle', warning: 'fa-exclamation-triangle' };
        const container = document.getElementById('toastContainer');
        const t = document.createElement('div');
        t.className = `toast-item toast-${type}`;
        t.innerHTML = `<i class="fas ${icons[type] || icons.success}" style="font-size:1.15rem;flex-shrink:0;"></i>
                       <span style="flex:1;">${message}</span>
                       <i class="fas fa-times t-close" onclick="this.parentElement.remove()"></i>`;
        container.appendChild(t);
        requestAnimationFrame(() => requestAnimationFrame(() => t.classList.add('show')));
        setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 420); }, 4500);
    }

    // ══════════════════════════════════════════════════════════════
    // MODAL HELPERS
    // ══════════════════════════════════════════════════════════════
    function showModal(id) { new bootstrap.Modal(document.getElementById(id)).show(); }
    function hideModal(id) { const m = bootstrap.Modal.getInstance(document.getElementById(id)); if (m) m.hide(); }

    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('active');
        document.getElementById('sidebarOverlay').classList.toggle('active');
    }
    function closeSidebar() {
        document.getElementById('sidebar').classList.remove('active');
        document.getElementById('sidebarOverlay').classList.remove('active');
    }

    // ══════════════════════════════════════════════════════════════
    // REGISTRATION FEES
    // ══════════════════════════════════════════════════════════════
    async function updateRegFees() {
        try {
            const res    = await fetch('/admin/settings/registration-fees', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ adultFee: document.getElementById('adultRegFee').value, kiddiesFee: document.getElementById('kiddiesRegFee').value }) });
            const result = await res.json();
            showToast(result.message || 'Registration fees updated.', result.success ? 'success' : 'error');
        } catch { showToast('Error updating registration fees.', 'error'); }
    }

    function doResetRegFees() {
        document.getElementById('adultRegFee').value   = '5000';
        document.getElementById('kiddiesRegFee').value = '2500';
        hideModal('resetRegFeesModal');
        showToast('Registration fees reset to default values.', 'warning');
    }

    // ══════════════════════════════════════════════════════════════
    // KIDDIES SETTINGS
    // ══════════════════════════════════════════════════════════════
    async function updateKiddiesSettings() {
        const payload = {
            minAge: document.getElementById('minAge').value, maxAge: document.getElementById('maxAge').value,
            upgradeAge: document.getElementById('upgradeAge').value, monthlyFee: document.getElementById('kiddiesMonthlyFee').value,
            upgradeFee: document.getElementById('upgradeFee').value, interestRate: document.getElementById('kiddiesInterest').value,
            notificationDays: document.getElementById('autoUpgradeNotif').value
        };
        try {
            const res    = await fetch('/admin/settings/kiddies-settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            const result = await res.json();
            showToast(result.message || 'Kiddies settings updated.', result.success ? 'success' : 'error');
        } catch { showToast('Error updating kiddies settings.', 'error'); }
    }

    function doResetKiddiesSettings() {
        document.getElementById('minAge').value            = '0';
        document.getElementById('maxAge').value            = '17';
        document.getElementById('upgradeAge').value        = '18';
        document.getElementById('kiddiesMonthlyFee').value = '100';
        document.getElementById('upgradeFee').value        = '1000';
        document.getElementById('kiddiesInterest').value   = '7.5';
        document.getElementById('autoUpgradeNotif').value  = '60';
        hideModal('resetKiddiesModal');
        showToast('Kiddies settings reset to defaults.', 'warning');
    }

    // ══════════════════════════════════════════════════════════════
    // OTHER FEES
    // ══════════════════════════════════════════════════════════════
    async function updateOtherFees() {
        try {
            const res    = await fetch('/admin/settings/other-fees', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ roiOperating: document.getElementById('roiOperatingCharge').value }) });
            const result = await res.json();
            showToast(result.message || 'Additional fees updated.', result.success ? 'success' : 'error');
        } catch { showToast('Error updating additional fees.', 'error'); }
    }

    function doResetOtherFees() {
        document.getElementById('roiOperatingCharge').value = '10';
        hideModal('resetOtherFeesModal');
        showToast('Additional fees reset to defaults.', 'warning');
    }


    async function uploadChairmanSignature() {
    const fileInput = document.getElementById('signatureFile');
    const file = fileInput.files[0];
    if (!file) { showToast('Please choose a file first.', 'error'); return; }

    const btn = document.getElementById('signatureUploadBtn');
    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Uploading…';

    try {
        const formData = new FormData();
        formData.append('signature', file);

        const res = await fetch('/admin/settings/chairman-signature', {
            method: 'POST',
            body: formData // no Content-Type header — browser sets multipart boundary
        });
        const result = await res.json();

        if (result.success) {
            showToast(result.message || 'Signature updated successfully!');
            setTimeout(() => location.reload(), 1400);
        } else {
            showToast(result.message || 'Failed to upload signature.', 'error');
            btn.disabled = false;
            btn.innerHTML = originalHTML;
        }
    } catch (err) {
        console.error(err);
        showToast('Error uploading signature.', 'error');
        btn.disabled = false;
        btn.innerHTML = originalHTML;
    }
}

    // ══════════════════════════════════════════════════════════════
    // MAINTENANCE MODE
    // ══════════════════════════════════════════════════════════════
    function confirmMaintenanceEnable() {
        const msg = document.getElementById('maintenanceMessage').value.trim()
                  || 'The system is currently undergoing scheduled maintenance. Please check back shortly.';
        document.getElementById('maintenancePreviewText').textContent = msg;
        showModal('maintenanceEnableModal');
    }
    function confirmMaintenanceDisable() { showModal('maintenanceDisableModal'); }

    async function doToggleMaintenance(enable) {
        hideModal(enable ? 'maintenanceEnableModal' : 'maintenanceDisableModal');
        const message = document.getElementById('maintenanceMessage').value.trim();
        try {
            const res    = await fetch('/admin/settings/maintenance-mode', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enabled: enable, message }) });
            const result = await res.json();
            if (result.success) {
                showToast(result.message || (enable ? 'Maintenance mode enabled.' : 'System is back online.'));
                setTimeout(() => location.reload(), 1600);
            } else {
                showToast(result.message || 'Failed to update maintenance mode.', 'error');
            }
        } catch { showToast('Error toggling maintenance mode.', 'error'); }
    }

    // ══════════════════════════════════════════════════════════════
    // COMPANY BANK ACCOUNT — LIVE VERIFICATION
    // ══════════════════════════════════════════════════════════════
    let _verifyTimer = null;

    function _setVerifyState(state, label = '') {
        const spinner   = document.getElementById('verifySpinner');
        const okIcon    = document.getElementById('verifyOkIcon');
        const failIcon  = document.getElementById('verifyFailIcon');
        const nameInput = document.getElementById('companyAccountName');
        const badge     = document.getElementById('verifyStatusBadge');
        spinner.style.display  = 'none';
        okIcon.style.display   = 'none';
        failIcon.style.display = 'none';
        nameInput.classList.remove('account-name-verified', 'account-name-error');
        badge.innerHTML = '';
        if (state === 'loading') {
            spinner.style.display = 'inline-block';
            badge.innerHTML = `<span class="verify-badge v-loading"><i class="fas fa-circle-notch fa-spin me-1"></i>Verifying account…</span>`;
        } else if (state === 'success') {
            okIcon.style.display = 'inline-block';
            nameInput.classList.add('account-name-verified');
            badge.innerHTML = `<span class="verify-badge v-success"><i class="fas fa-check-circle me-1"></i>Verified — ${label}</span>`;
        } else if (state === 'error') {
            failIcon.style.display = 'inline-block';
            nameInput.classList.add('account-name-error');
            nameInput.value = '';
            badge.innerHTML = `<span class="verify-badge v-error"><i class="fas fa-exclamation-circle me-1"></i>${label || 'Verification failed. Check account number and bank.'}</span>`;
        }
    }

    async function _doVerifyCompanyAccount() {
        const bank   = document.getElementById('companyBankName').value.trim();
        const accNum = document.getElementById('companyAccountNumber').value.trim();
        const nameEl = document.getElementById('companyAccountName');
        if (!bank || accNum.length !== 10) { _setVerifyState('idle'); nameEl.value = ''; return; }
        _setVerifyState('loading');
        try {
            const res  = await fetch(`/club-de-star-cooperative/verifyBankAccount?bank=${encodeURIComponent(bank)}&accountNumber=${accNum}`);
            const data = await res.json();
            if (data.success && data.accountName) {
                nameEl.value = data.accountName;
                _setVerifyState('success', data.accountName);
            } else {
                _setVerifyState('error', data.error || 'Account not found.');
            }
        } catch (err) {
            console.error(err);
            _setVerifyState('error', 'Network error. Please try again.');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const accInput  = document.getElementById('companyAccountNumber');
        const bankInput = document.getElementById('companyBankName');
        accInput.addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 10);
            clearTimeout(_verifyTimer);
            if (this.value.length === 10) { _verifyTimer = setTimeout(_doVerifyCompanyAccount, 600); }
            else { _setVerifyState('idle'); document.getElementById('companyAccountName').value = ''; }
        });
        bankInput.addEventListener('change', function () {
            clearTimeout(_verifyTimer);
            if (accInput.value.length === 10) { _verifyTimer = setTimeout(_doVerifyCompanyAccount, 400); }
        });
        loadSidebarPendingCount();
    });

    async function updateCompanyAccount() {
        const bankName      = document.getElementById('companyBankName').value.trim();
        const accountNumber = document.getElementById('companyAccountNumber').value.trim();
        const accountName   = document.getElementById('companyAccountName').value.trim();
        if (!bankName || !accountNumber || !accountName) { showToast('Please fill all fields. Account name must be verified first.', 'error'); return; }
        const nameEl = document.getElementById('companyAccountName');
        if (accountNumber.length === 10 && !nameEl.classList.contains('account-name-verified')) {
            showToast('Please wait for the account verification to complete before saving.', 'warning');
            return;
        }
        try {
            const res    = await fetch('/admin/settings/company-account', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ bankName, accountNumber, accountName }) });
            const result = await res.json();
            if (result.success) { showToast('Company account details saved successfully!'); setTimeout(() => location.reload(), 1600); }
            else { showToast(result.message || 'Failed to save account details.', 'error'); }
        } catch { showToast('Error saving company account details.', 'error'); }
    }

    function clearCompanyAccountFields() {
        document.getElementById('companyBankName').value      = '';
        document.getElementById('companyAccountNumber').value = '';
        document.getElementById('companyAccountName').value   = '';
        _setVerifyState('idle');
    }

    // ══════════════════════════════════════════════════════════════
    // DANGER ZONE — CLEAR DATABASE
    // ══════════════════════════════════════════════════════════════
    function openClearDbWarning() { showModal('clearDbWarningModal'); }

    function proceedToClearDbCode() {
        hideModal('clearDbWarningModal');
        setTimeout(() => {
            document.getElementById('adminClearCode').value = '';
            document.getElementById('clearCodeError').style.display = 'none';
            showModal('clearDbCodeModal');
        }, 350);
    }

    async function submitClearDatabase() {
        const adminCode = document.getElementById('adminClearCode').value.trim();
        const errorEl   = document.getElementById('clearCodeError');
        const errorText = document.getElementById('clearCodeErrorText');
        if (!adminCode) { errorEl.style.display = 'block'; errorText.textContent = 'Please enter the admin code.'; return; }
        const btn = document.getElementById('clearDbSubmitBtn');
        const originalHTML = btn.innerHTML;
        btn.disabled  = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Clearing…';
        errorEl.style.display = 'none';
        try {
            const res    = await fetch('/admin/settings/clear-database', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ adminCode }) });
            const result = await res.json();
            if (result.success) {
                hideModal('clearDbCodeModal');
                showToast(`✅ ${result.message}`, 'success');
                setTimeout(() => { window.location.href = '/login'; }, 2500);
            } else {
                errorEl.style.display = 'block';
                errorText.textContent = result.message || 'Incorrect code. Try again.';
                btn.disabled  = false;
                btn.innerHTML = originalHTML;
            }
        } catch {
            errorEl.style.display = 'block';
            errorText.textContent = 'Network error. Please try again.';
            btn.disabled  = false;
            btn.innerHTML = originalHTML;
        }
    }

    // ══════════════════════════════════════════════════════════════
    // SIDEBAR PENDING BADGE
    // ══════════════════════════════════════════════════════════════
    async function loadSidebarPendingCount() {
        try {
            const res  = await fetch('/admin/pending-approvals-count');
            const data = await res.json();
            const badge = document.getElementById('sidebarPendingBadge');
            if (!badge) return;
            data.count > 0
                ? (badge.style.display = 'inline-block', badge.textContent = data.count)
                : (badge.style.display = 'none');
        } catch (e) { console.error('Sidebar badge error:', e); }
    }
    </script>
</body>
</html>