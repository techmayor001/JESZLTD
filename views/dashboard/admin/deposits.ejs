                                            <small class="text-muted"><%= deposit.time %></small>
                                        </td>

                                        <td data-label="Member">
                                            <div class="fw-semibold">
                                                <%= deposit.memberName %>
                                                <% if (deposit.payeeName) { %>
                                                    (<%= deposit.payeeName %>)
                                                <% } %>
