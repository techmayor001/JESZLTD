<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deposit Management - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --sidebar-width: 280px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }

        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18);
            position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box {
            width: 42px; height: 42px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0;
        }
        .sidebar-brand {
            font-size: .95rem; font-weight: 800; color: white;
            text-transform: uppercase; letter-spacing: .05em; line-height: 1.2;
        }
        .sidebar-brand small {
            font-size: .65rem; font-weight: 500; opacity: .55;
            display: block; letter-spacing: .08em;
        }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 10px; background: rgba(239,68,68,.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.3);
            font-weight: 700; font-size: .7rem; color: #fca5a5;
        }

        /* ── Category groups ── */
        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }

        .nav-category {
            display: flex; align-items: center; gap: 7px;
            padding: .55rem 1.25rem .3rem;
            font-size: .62rem; font-weight: 800;
            color: rgba(255,255,255,.38);
            text-transform: uppercase; letter-spacing: .1em;
            user-select: none;
        }
        .nav-category::after {
            content: '';
            flex: 1; height: 1px;
            background: rgba(255,255,255,.08);
            margin-left: 4px;
        }

        /* ── Nav links ── */
        .sidebar-nav a {
            display: flex; align-items: center; gap: 11px;
            padding: .62rem 1.25rem; color: rgba(255,255,255,.72);
            text-decoration: none; font-weight: 500; font-size: .84rem;
            border-left: 3px solid transparent;
            transition: all .18s;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }

        .nav-badge {
            margin-left: auto;
            font-size: .63rem; font-weight: 800;
            padding: 2px 7px; border-radius: 10px;
            background: rgba(239,68,68,.9); color: white;
            flex-shrink: 0; line-height: 1.4;
        }

        .nav-back {
            display: flex; align-items: center; gap: 10px;
            padding: .7rem 1.25rem .9rem;
            font-size: .8rem; font-weight: 600;
            color: rgba(255,255,255,.42);
            text-decoration: none;
            transition: color .18s;
            border-top: 1px solid rgba(255,255,255,.07);
            margin-top: .25rem;
        }
        .nav-back:hover { color: rgba(255,255,255,.7); }
        .nav-back i { font-size: .8rem; }

        /* Top Navbar */
        .top-navbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: 70px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.08);
            z-index: 1030;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            transition: all 0.3s;
            border-bottom: 1px solid rgba(30, 58, 138, 0.1);
        }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: 70px;
            padding: 1.5rem;
            min-height: calc(100vh - 70px);
            transition: all 0.3s;
        }

        .page-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white;
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(30, 58, 138, 0.25);
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }

        /* Stats Cards */
        .stats-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            transition: all 0.3s;
            border: 2px solid transparent;
            height: 100%;
            position: relative;
            overflow: hidden;
        }

        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100px;
            height: 100px;
            background: rgba(30, 58, 138, 0.03);
            border-radius: 0 16px 0 100%;
        }

        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(30, 58, 138, 0.15);
            border-color: var(--primary);
        }

        .stats-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }

        .stats-value {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .stats-label {
            color: var(--secondary);
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Card Styles */
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            background: white;
            border: 1px solid rgba(30, 58, 138, 0.05);
        }

        .card-header {
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.03) 0%, rgba(59, 130, 246, 0.03) 100%);
            border-bottom: 2px solid rgba(30, 58, 138, 0.1);
            padding: 1.25rem;
            border-radius: 16px 16px 0 0 !important;
        }

        /* Deposit Status Badges */
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-pending {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .status-approved {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-rejected {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        /* Action Buttons */
        .action-btn {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
        }

        .btn-approve {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }

        .btn-approve:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
        }

        .btn-reject {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
        }

        .btn-reject:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
        }

        .btn-view {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
        }

        .btn-view:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(59, 130, 246, 0.3);
        }

        /* Filter Section */
        .filter-section {
            background: white;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1rem;
            box-shadow: 0 4px 12px rgba(30, 58, 138, 0.06);
        }

        .filter-btn {
            padding: 8px 16px;
            border-radius: 8px;
            border: 2px solid rgba(30, 58, 138, 0.1);
            background: white;
            color: var(--primary);
            font-weight: 600;
            transition: all 0.3s;
            cursor: pointer;
        }

        .filter-btn:hover, .filter-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        /* Table Styles */
        .table-responsive {
            border-radius: 0 0 16px 16px;
            overflow: hidden;
        }

        .table {
            margin: 0;
        }

        .table thead {
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.05) 0%, rgba(59, 130, 246, 0.05) 100%);
        }

        .table thead th {
            border: none;
            padding: 1rem;
            font-weight: 600;
            color: var(--primary);
            white-space: nowrap;
        }

        .table tbody td {
            padding: 1rem;
            vertical-align: middle;
            border-bottom: 1px solid rgba(30, 58, 138, 0.05);
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .table tbody tr:hover {
            background: rgba(30, 58, 138, 0.02);
        }

        /* Receipt Styles */
        .receipt-container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            padding: 2rem;
            border: 2px solid #e5e7eb;
        }

        .receipt-header {
            text-align: center;
            border-bottom: 3px solid var(--primary);
            padding-bottom: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .receipt-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            margin: 0 auto 1rem;
        }

        .receipt-title {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .receipt-subtitle {
            color: var(--secondary);
            font-size: 0.9rem;
        }

        .receipt-section { margin-bottom: 1.5rem; }

        .receipt-section-title {
            font-weight: bold;
            color: var(--primary);
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
        }

        .receipt-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px dashed #e5e7eb;
        }

        .receipt-row:last-child { border-bottom: none; }

        .receipt-amount {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border: 2px solid var(--success);
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
            margin: 1.5rem 0;
        }

        .receipt-amount-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--success);
        }

        .receipt-footer {
            text-align: center;
            border-top: 3px solid var(--primary);
            padding-top: 1.5rem;
            margin-top: 2rem;
        }

        .receipt-stamp {
            display: inline-block;
            border: 3px solid var(--success);
            color: var(--success);
            padding: 0.5rem 1.5rem;
            border-radius: 10px;
            font-weight: bold;
            transform: rotate(-5deg);
            margin: 1rem 0;
        }

        .powered-by {
            position: fixed;
            bottom: 15px;
            right: 15px;
            background: white;
            padding: 10px 16px;
            border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.15);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--primary);
            z-index: 1000;
        }

        /* Custom Alert Modal */
        #alertModal .modal-content {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(30, 58, 138, 0.2);
        }
        #alertModal .modal-header { padding: 1.25rem 1.5rem; border-bottom: none; }
        #alertModal .modal-body { padding: 1.5rem; text-align: center; }
        #alertModal .alert-icon-wrapper {
            width: 72px; height: 72px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1rem; font-size: 2rem;
        }
        #alertModal .modal-footer { border-top: none; padding: 0 1.5rem 1.5rem; justify-content: center; }

        /* Responsive */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
            .table thead { display: none; }
            .table tbody tr {
                display: block; margin-bottom: 1rem;
                border: 2px solid rgba(30, 58, 138, 0.1);
                border-radius: 12px; overflow: hidden; background: white;
            }
            .table tbody td {
                display: flex; justify-content: space-between;
                align-items: center; padding: 0.75rem 1rem;
                border-bottom: 1px solid rgba(30, 58, 138, 0.05);
            }
            .table tbody td:last-child { border-bottom: none; }
            .table tbody td::before {
                content: attr(data-label);
                font-weight: 600; color: var(--primary); margin-right: 1rem;
            }
        }

        @media (max-width: 576px) {
            .stats-value { font-size: 1.5rem; }
            .stats-icon { width: 50px; height: 50px; font-size: 1.5rem; }
        }

        @media print {
            body * { visibility: hidden; }
            #printReceipt, #printReceipt * { visibility: visible; }
            #printReceipt { position: absolute; left: 0; top: 0; width: 100%; }
            .sidebar, .top-navbar, .powered-by, .no-print { display: none !important; }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fade-in { animation: fadeIn 0.5s ease; }
    </style>
</head>
<body>

    <!-- ════════════════════════ SIDEBAR ════════════════════════ -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-row">
                <div class="logo-box">C</div>
                <div>
                    <div class="sidebar-brand">Club De Stars<small>Admin Panel</small></div>
                </div>
            </div>
            <div class="role-pill">
                <i class="fas fa-shield-alt" style="font-size:.65rem;"></i>&nbsp;Super Admin
            </div>
        </div>

        <div class="sidebar-nav">
            <div class="nav-group">
                <div class="nav-category"><i class="fas fa-home" style="font-size:.6rem;"></i>Main</div>
                <a href="/admin/dashboard"><i class="fas fa-chart-pie"></i>Overview</a>
            </div>

            <div class="nav-group">
                <div class="nav-category"><i class="fas fa-users" style="font-size:.6rem;"></i>Members</div>
                <a href="/admin/manage-members"><i class="fas fa-users"></i>Manage Members</a>
                <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i>Kiddies Accounts</a>
                <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i>Membership Types</a>
            </div>

            <div class="nav-group">
                <div class="nav-category"><i class="fas fa-exchange-alt" style="font-size:.6rem;"></i>Transactions</div>
                <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i>Payments</a>
                <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i>Approvals<span id="sidebarPendingBadge" class="nav-badge" style="display:none;">0</span></a>
                <a href="/admin/manage-deposit" class='active'><i class="fas fa-coins"></i>Deposits</a>
                <a href="/admin/kiddies-deposits"><i class="fas fa-piggy-bank"></i>Kiddies Deposits</a>
                <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i>Withdrawals</a>
            </div>

            <div class="nav-group">
                <div class="nav-category"><i class="fas fa-hand-holding-usd" style="font-size:.6rem;"></i>Loans</div>
                <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i>Loan Management</a>
                <a href="/admin/loan-payments"><i class="fas fa-file-invoice-dollar"></i>Loan Payments</a>
                <a href="/admin/loan/settings"><i class="fas fa-cogs"></i>Loan Settings</a>
                <a href="/admin/external-loans"><i class="fas fa-building"></i>External Loans</a>
            </div>

            <div class="nav-group">
                <div class="nav-category"><i class="fas fa-landmark" style="font-size:.6rem;"></i>Finance</div>
                <a href="/admin/finance"><i class="fas fa-landmark"></i>Company Finance</a>
                <a href="/admin/operating-earnings"><i class="fas fa-chart-line"></i>Operating Earnings</a>
                <a href="/admin/manage-extra-charges"><i class="fas fa-chart-bar"></i>Company Revenue</a>
            </div>

            <div class="nav-group">
                <div class="nav-category"><i class="fas fa-cog" style="font-size:.6rem;"></i>System</div>
                <a href="/manage-subscriptions"><i class="fas fa-cube"></i>Manage Subscriptions</a>
                <a href="/manage-roles"><i class="fas fa-user-shield"></i>Roles &amp; Permissions</a>
                <a href="/admin/settings"><i class="fas fa-cog"></i>Settings</a>
            </div>

            <div class="nav-group">
                <div class="nav-category"><i class="fas fa-file-alt" style="font-size:.6rem;"></i>Reporting</div>
                <a href="/admin/reports"><i class="fas fa-file-alt"></i>Reports</a>
                <a href="/admin/logs"><i class="fas fa-history"></i>Admin Logs</a>
            </div>
        </div>

        <a href="/cds-cooperative/dashboard" class="nav-back">
            <i class="fas fa-arrow-left"></i>Back to Dashboard
        </a>
    </div>

    <!-- Top Navbar -->
    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3"
           style="cursor: pointer; color: var(--primary); font-size: 1.5rem;"
           onclick="document.getElementById('sidebar').classList.toggle('active')"></i>

        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color: var(--primary)">Deposit Management</h5>
            <small class="text-muted">Review and approve member deposits</small>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="badge bg-light text-dark">
                <i class="fas fa-calendar me-1"></i>
                <span id="currentDate"></span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Page Header -->
        <div class="page-header position-relative">
            <div class="row align-items-center position-relative" style="z-index: 1;">
                <div class="col-md-8">
                    <h2 class="mb-2 fw-bold"><i class="fas fa-coins me-3"></i>Deposit Management</h2>
                    <p class="mb-0 opacity-90">Monitor, review and approve member deposits</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <button class="btn btn-light" onclick="refreshData()">
                        <i class="fas fa-sync-alt me-2"></i>Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="stats-card">
                    <div class="stats-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <div class="stats-value" style="color: var(--success); font-size: 14px;">
                        ₦<%= stats.totalIncome.toLocaleString() %>
                    </div>
                    <div class="stats-label" style="font-size: 12px;">Total Income</div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="stats-card">
                    <div class="stats-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stats-value" style="color: var(--warning); font-size: 14px;">
                        <%= stats.pendingCount %>
                    </div>
                    <div class="stats-label" style="font-size: 12px;">Pending Deposits</div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="stats-card">
                    <div class="stats-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white;">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stats-value" style="color: var(--primary); font-size: 14px;">
                        <%= stats.approvedToday %>
                    </div>
                    <div class="stats-label" style="font-size: 12px;">Approved Today</div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
