function normalizeDocPath(p) {
  if (!p) return null;
  // convert backslashes → forward slashes
  p = p.replace(/\\/g, "/");

  // remove "public" if files are served from /media/ not /public/media/
  if (p.startsWith("public/")) {
    p = p.replace("public/", "/");
  }

  // ensure it begins with a /
  if (!p.startsWith("/")) {
    p = "/" + p;
  }

  return p;
}

