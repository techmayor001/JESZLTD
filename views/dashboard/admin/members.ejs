    async function saveEditMember() {
        const form = document.getElementById('editMemberForm');
        const modalEl = document.getElementById('editMemberModal');
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const formData = new FormData(form);
        const result = await permFetch(`/admin/members/edit/${currentMemberId}`,{method:'POST',body:formData},modalEl);
        if (!result.ok) return;
        if (result.data?.status) {
            const idx = members.findIndex(m=>m.id===currentMemberId);
            if (idx !== -1) {
                const m = members[idx]; const g = k => formData.get(k)||'';
                m.firstName=g('firstName')||m.firstName; m.lastName=g('lastName')||m.lastName;
                m.email=g('email')||m.email; m.phone=g('phone')||m.phone;
                m.status=g('status')||m.status; m.state=g('state')||m.state;
                m.lga=g('lga')||m.lga; m.address=g('address')||m.address;
                m.idType=g('idType')||m.idType; m.idNumber=g('idNumber')||m.idNumber;
                m.bankDetails={bankName:g('bankName')||m.bankDetails?.bankName||'',accountNumber:g('accountNumber')||m.bankDetails?.accountNumber||'',accountName:g('accountName')||m.bankDetails?.accountName||''};
                m.nextOfKin={fullName:g('nokFullName')||m.nextOfKin?.fullName||'',relationship:g('nokRelationship')||m.nextOfKin?.relationship||'',phone:g('nokPhone')||m.nextOfKin?.phone||'',address:g('nokAddress')||m.nextOfKin?.address||''};
                if (result.data.files) { if(result.data.files.passportPhoto) m.passportPhoto=result.data.files.passportPhoto; if(result.data.files.displayPicture) m.displayPicture=result.data.files.displayPicture; if(result.data.files.idFile) m.idFile=result.data.files.idFile; if(result.data.files.addressProof) m.addressProof=result.data.files.addressProof; if(result.data.files.signature) m.signature=result.data.files.signature; }
            }
            updateStats(); renderMembers(_currentFilteredMembers, currentPage);
            bootstrap.Modal.getInstance(modalEl).hide();
            await showNotify({type:'success',title:'Member Updated',message:'Member details have been successfully updated.'});
        } else { await showNotify({type:'error',title:'Update Failed',message:result.data?.message||'An error occurred.'}); }
    }

