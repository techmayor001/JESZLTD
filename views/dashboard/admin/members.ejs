                            <div class="col-12"><label class="form-label">Address</label><textarea name="address" class="form-control" rows="2" required></textarea></div>
                            <div class="col-md-6">
                                <label class="form-label">Date Joined <span class="text-muted fw-normal" style="font-size:.78rem;">(optional — defaults to today)</span></label>
                                <input type="date" name="dateJoined" class="form-control">
                            </div>
                            <div class="col-md-6"><label class="form-label">ID Type</label><select name="idType" class="form-select" required><option value="">Select ID type...</option><option value="nin">NIN</option><option value="passport">International Passport</option><option value="drivers">Driver's License</option><option value="voters">Voter's Card</option></select></div>
                            <div class="col-md-6"><label class="form-label">ID Number</label><input type="text" name="idNumber" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Proof of Address</label><input type="file" name="addressProof" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Passport Photo</label><input type="file" name="passportPhoto" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">ID Document</label><input type="file" name="idFile" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Signature</label><input type="file" name="signature" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Display Picture (optional)</label><input type="file" name="displayPicture" class="form-control"></div>
                            <div class="col-md-4"><label class="form-label">Opening Balance</label><input type="number" name="openingBalance" class="form-control" value="0" required></div>
                            <div class="col-md-4"><label class="form-label">Monthly ROI</label><input type="number" name="monthlyROI" class="form-control"></div>
                            <div class="col-md-4"><label class="form-label">Accumulative ROI</label><input type="number" name="accumulativeROI" class="form-control" value="0"></div>
                            <div class="col-12"><label class="form-label">Password</label><input type="password" name="password" class="form-control" required></div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" onclick="saveNewMember()"><i class="fas fa-save me-2"></i>Add Member</button></div>
            </div>
        </div>
    </div>

    <!-- DELETE CONFIRM MODAL -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:linear-gradient(135deg,#7f1d1d 0%,#ef4444 100%)!important;"><h5 class="modal-title text-white"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body text-center py-4">
                    <div style="width:64px;height:64px;border-radius:50%;background:rgba(239,68,68,.12);display:flex;align-items:center;justify-content:center;font-size:1.8rem;color:#ef4444;margin:0 auto 1rem;"><i class="fas fa-trash-alt"></i></div>
                    <p class="mb-1 fw-semibold">Are you sure you want to delete this member?</p>
                    <p class="text-muted small mb-0">All associated data including savings, loans, and transactions will be permanently deleted.</p>
                </div>
                <div class="modal-footer justify-content-center gap-2"><button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger px-4" onclick="confirmDelete()"><i class="fas fa-trash me-1"></i>Delete Member</button></div>
            </div>
        </div>
    </div>

    <!-- BULK ACTIONS MODAL -->
    <div class="modal fade" id="bulkActionsModal" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title"><i class="fas fa-tasks me-2"></i>Bulk Actions</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Selected: <strong id="selectedCount">0</strong> members</p><div class="d-grid gap-2"><button class="btn btn-success" onclick="bulkApprove()"><i class="fas fa-check me-2"></i>Approve Selected</button><button class="btn btn-warning" onclick="bulkChangeType()"><i class="fas fa-exchange-alt me-2"></i>Change Member Type</button><button class="btn btn-danger" onclick="bulkDelete()"><i class="fas fa-trash me-2"></i>Delete Selected</button></div></div></div></div>
    </div>

    <!-- APPROVE MEMBER MODAL -->
    <div class="modal fade" id="approveMemberModal" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#064e3b 0%,#10b981 100%)!important;"><h5 class="modal-title text-white"><i class="fas fa-user-check me-2"></i>Approve Member</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i><strong>Important:</strong> You must assign a membership type before approving this member.</div>
                <div class="mb-3">
                    <label class="form-label fw-semibold"><i class="fas fa-star me-2" style="color:var(--primary);"></i>Select Membership Type</label>
                    <select class="form-select" id="approvalMemberType" required>
                        <option value="">Choose membership type...</option>
                        <% memberTypes.forEach(type => { %><option value="<%= type._id %>" data-short="<%= type.shortCode %>" data-rate="<%= type.interestRate %>"><%= type.name %> (<%= type.shortCode %>) - <%= type.interestRate %>% Interest Rate</option><% }) %>
                    </select>
                    <small class="text-muted d-block mt-2"><% memberTypes.forEach(type => { %><strong><%= type.shortCode %> Members:</strong> <%= type.name %> — <%= type.interestRate %>% Loan Interest Rate<br><% }) %></small>
                </div>
                <div class="card" style="background:linear-gradient(135deg,rgba(30,58,138,.05) 0%,rgba(59,130,246,.05) 100%);border:2px solid rgba(30,58,138,.1);"><div class="card-body"><h6 class="fw-bold mb-2">Member Information</h6><div class="row g-2 small"><div class="col-6"><strong>Name:</strong></div><div class="col-6 text-end" id="approvalMemberName">-</div><div class="col-6"><strong>Email:</strong></div><div class="col-6 text-end" id="approvalMemberEmail">-</div><div class="col-6"><strong>Phone:</strong></div><div class="col-6 text-end" id="approvalMemberPhone">-</div><div class="col-6"><strong>Registration Status:</strong></div><div class="col-6 text-end" id="approvalRegStatus">-</div></div></div></div>
                <div class="alert alert-warning mt-3 mb-0"><small><i class="fas fa-exclamation-triangle me-2"></i>Once approved, the member will receive an email notification and can access their dashboard.</small></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-success" onclick="confirmApproval()"><i class="fas fa-check me-2"></i>Approve Member</button></div>
        </div></div>
    </div>

    <!-- SheetJS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
    /* ─── All JS from original file preserved exactly ─── */

    let _notifyResolve = null;
    function showNotify({ type='info', title='', message='', confirmLabel='OK', cancelLabel=null } = {}) {
        return new Promise(resolve => {
            _notifyResolve = resolve;
            const iconMap = { success:{icon:'fa-check-circle',label:title||'Success'}, error:{icon:'fa-times-circle',label:title||'Error'}, warning:{icon:'fa-exclamation-triangle',label:title||'Warning'}, info:{icon:'fa-info-circle',label:title||'Info'} };
            const cfg = iconMap[type]||iconMap.info;
            document.getElementById('notifyIcon').className      = `notify-icon-wrap ${type}`;
            document.getElementById('notifyIconClass').className = `fas ${cfg.icon}`;
            const t = document.getElementById('notifyTitle'); t.className = `notify-title ${type}`; t.textContent = cfg.label;
            document.getElementById('notifyMessage').textContent = message;
            const ok = document.getElementById('notifyOkBtn'); ok.className = `notify-btn-ok ${type}`; ok.textContent = confirmLabel;
            const ex = document.getElementById('notifyCancelBtn'); if(ex) ex.remove();
            if (cancelLabel) {
                const cb = document.createElement('button'); cb.className='notify-btn-cancel'; cb.id='notifyCancelBtn'; cb.textContent=cancelLabel; cb.onclick=notifyCancel;
                document.getElementById('notifyFooter').insertBefore(cb, ok);
            }
            new bootstrap.Modal(document.getElementById('notifyModal'),{backdrop:'static',keyboard:false}).show();
        });
    }
    function notifyClose()  { bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide(); if(_notifyResolve){_notifyResolve(true);_notifyResolve=null;} }
    function notifyCancel() { bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide(); if(_notifyResolve){_notifyResolve(false);_notifyResolve=null;} }

    const unauthorizedMessages = { auth:'Your session has expired. Please login again.', permission:"You don't have permission to perform this action.", inactive:'Your admin role is currently inactive.', norole:'No role is assigned to your account.', member:'Members are not allowed to access admin actions.' };
    function showUnauthorized(reason='permission', onClose=null) {
        document.getElementById('unauthorizedMessage').innerText = unauthorizedMessages[reason]||'Unauthorized action.';
        const el = document.getElementById('unauthorizedModal');
        if (onClose) el.addEventListener('hidden.bs.modal', function h(){ el.removeEventListener('hidden.bs.modal',h); onClose(); });
        new bootstrap.Modal(el).show();
    }

    async function permFetch(url, options={}, sourceModal=null) {
        const hide = () => { if(sourceModal){ const i=bootstrap.Modal.getInstance(sourceModal); if(i)i.hide(); } };
        const res = await fetch(url, { headers:{'X-Requested-With':'XMLHttpRequest',...(options.headers||{})}, ...options });
        if (res.status===401) {
            hide();
            const fn = () => { showUnauthorized('auth'); setTimeout(()=>{window.location.href='/login';},1500); };
            if(sourceModal) sourceModal.addEventListener('hidden.bs.modal',function h(){sourceModal.removeEventListener('hidden.bs.modal',h);fn();}); else fn();
            return {ok:false};
        }
        if (res.status===403) {
            let d={}; try{d=await res.json();}catch(_){}
            hide();
            const fn = () => showUnauthorized(d.reason||'permission');
            if(sourceModal) sourceModal.addEventListener('hidden.bs.modal',function h(){sourceModal.removeEventListener('hidden.bs.modal',h);fn();}); else fn();
            return {ok:false};
        }
        return {ok:true, data:await res.json(), status:res.status};
    }

    let members = <%- JSON.stringify([
        ...users.map(u => {
            const account = u.account || null;
            const stats   = u._memberStats || {};
            return {
                id: String(u._id), entityType: 'member',
                firstName: u.firstName||'', lastName: u.lastName||'',
                email: u.email||'', phone: u.phone||'', dob: u.dob||null,
                memberID: u.membershipID||(account?.memberID||'N/A'),
                type: account?.accountType?.shortCode||'N/A',
                typeName: account?.accountType?.name||'No Membership',
                status: u.status||'pending', registrationStatus: u.registrationStatus||'pending',
                balance: account?.balance||0,
                state: u.state||'', lga: u.lga||'', address: u.address||'',
                idType: u.idType||'', idNumber: u.idNumber||'',
                joinDate: u.createdAt||new Date(),
                displayPicture: u.displayPicture||null, passportPhoto: u.passportPhoto||null,
                idFile: u.idFile||null, addressProof: u.addressProof||null, signature: u.signature||null,
                bankDetails: u.bankDetails||{}, nextOfKin: u.nextOfKin||{},
                memberStats: { memberSavings: stats.memberSavings||0, accumulativeROI: stats.accumulativeROI||0, totalBalance: stats.totalBalance||0, sharePercentage: stats.sharePercentage||0, userShare: stats.userShare||0, companyChargeOnUser: stats.companyChargeOnUser||0, ROI: stats.ROI||0 },
                account: account ? { memberID: account.memberID||'N/A', balance: account.balance||0, accountType: account.accountType ? { id: String(account.accountType._id), name: account.accountType.name, shortCode: account.accountType.shortCode, interestRate: account.accountType.interestRate } : null } : null,
                parentName: '', parentMemberID: '', lockPeriodYears: null, unlockDate: null, beneficiaryType: null, childDOB: null,
            };
        }),
        ...kiddiesAccounts.map(k => {
            const d = k._display||{}; const stats = k._memberStats||{};
            return {
                id: String(k._id), entityType: 'kiddies',
                firstName: k.childFirstName||'', lastName: k.childLastName||'',
                email: d.email||'', phone: d.phone||'', dob: k.childDOB||null,
                memberID: k.accountID||'N/A', type: 'KIDDIES', typeName: 'Kiddies Account',
                status: k.status||'locked', registrationStatus: k.registrationStatus||'pending',
                balance: d.balance||0, state:'', lga:'', address:'', idType:'', idNumber:'',
                joinDate: k.createdAt||new Date(),
                displayPicture: d.displayPicture||null, passportPhoto: null, idFile: null, addressProof: null, signature: null,
                bankDetails: {}, nextOfKin: k.nextOfKin||{},
                memberStats: { memberSavings: stats.memberSavings||0, accumulativeROI: stats.accumulativeROI||0, totalBalance: stats.totalBalance||0, sharePercentage: stats.sharePercentage||0, userShare: stats.userShare||0, companyChargeOnUser: stats.companyChargeOnUser||0, ROI: stats.ROI||0 },
                account: k.account ? { balance: k.account.balance||0, accountType: null } : null,
                parentName: d.parentName||'', parentMemberID: d.parentMemberID||'',
                lockPeriodYears: k.lockPeriodYears||5, unlockDate: k.unlockDate||null,
                beneficiaryType: k.beneficiaryType||'family', childDOB: k.childDOB||null,
            };
        })
    ]) %>;

    let memberTypes = <%- JSON.stringify(memberTypes.map(m => ({ id: String(m._id), name: m.name, shortCode: m.shortCode, interestRate: m.interestRate }))) %>;

    let currentMemberId = null;
    let selectedMembers = [];
    let _currentFilteredMembers = members;
    const PER_PAGE = 20;
    let currentPage = 1;

    document.addEventListener('DOMContentLoaded', () => { updateStats(); renderMembers(); attachFilterListeners(); });

    function updateStats() {
        const r = members.filter(m=>m.entityType==='member');
        const k = members.filter(m=>m.entityType==='kiddies');
        document.getElementById('totalMembers').textContent    = members.length;
        document.getElementById('activeMembers').textContent   = r.filter(m=>m.status==='active').length;
        document.getElementById('pendingMembers').textContent  = r.filter(m=>m.status==='pending').length;
        document.getElementById('rejectedMembers').textContent = r.filter(m=>m.status==='rejected').length;
        document.getElementById('kiddiesCount').textContent    = k.length;
        document.getElementById('memberCountDisplay').textContent = _currentFilteredMembers.length;
    }

    function getMemberTypeBadge(member) {
        if (member.entityType === 'kiddies') return `<span class="badge" style="background:linear-gradient(135deg,#ec4899,#db2777);color:white;"><i class="fas fa-baby me-1"></i>Kiddies</span>`;
        const type = member.account?.accountType;
        if (!type) return `<span class="badge" style="background:#6b7280;color:white;">No Membership</span>`;
        const colors = { CDS:'#10b981', NCDS:'#f59e0b' };
        return `<span class="badge" style="background:${colors[type.shortCode]||'#6366f1'};color:white;">${type.name}</span>`;
    }

    function renderMembers(filteredMembers = members, page = 1) {
        currentPage = page;
        _currentFilteredMembers = filteredMembers;
        document.getElementById('memberCountDisplay').textContent = filteredMembers.length;
        const start = (page-1)*PER_PAGE, end = Math.min(start+PER_PAGE, filteredMembers.length);
        const pageData = filteredMembers.slice(start, end);
        document.getElementById('showingFrom').textContent = filteredMembers.length ? start+1 : 0;
        document.getElementById('showingTo').textContent = end;
        const tbody = document.getElementById('membersTableBody');
        tbody.innerHTML = '';
        if (!pageData.length) { tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5"><i class="fas fa-users fa-3x text-muted mb-3 d-block"></i><p class="text-muted">No members found</p></td></tr>`; renderPagination(filteredMembers.length, page); return; }
        pageData.forEach(member => {
            const row = document.createElement('tr');
            if (member.entityType === 'kiddies') row.classList.add('kiddies-row');
            const statusColors = { active:'<span class="badge bg-success">Active</span>', pending:'<span class="badge bg-warning">Pending</span>', rejected:'<span class="badge bg-danger">Rejected</span>', locked:'<span class="badge" style="background:rgba(236,72,153,.15);color:#db2777;border:1px solid rgba(236,72,153,.3);">Locked</span>', closed:'<span class="badge bg-secondary">Closed</span>' };
            const statusBadge = statusColors[member.status] || '<span class="badge bg-secondary">Unknown</span>';
            let actionButtons;
            if (member.entityType === 'kiddies') {
                actionButtons = `<button class="action-btn btn btn-sm btn-primary" onclick="viewMember('${member.id}')" title="View"><i class="fas fa-eye"></i></button><a class="action-btn btn btn-sm" href="/admin/kiddies-accounts" title="Manage Kiddies" style="background:linear-gradient(135deg,#ec4899,#db2777);color:white;"><i class="fas fa-baby"></i></a>`;
            } else if (member.status === 'pending') {
                actionButtons = `<button class="action-btn btn btn-sm btn-success" onclick="showApprovalModal('${member.id}')" title="Approve"><i class="fas fa-check"></i></button><button class="action-btn btn btn-sm btn-danger" onclick="rejectMember('${member.id}')" title="Reject"><i class="fas fa-times"></i></button><button class="action-btn btn btn-sm btn-primary" onclick="viewMember('${member.id}')" title="View"><i class="fas fa-eye"></i></button><button class="action-btn btn btn-sm text-white" onclick="openChangeTypeModal('${member.id}')" title="Change Type" style="background:linear-gradient(135deg,#312e81,#6366f1);"><i class="fas fa-exchange-alt"></i></button>`;
            } else {
                actionButtons = `<button class="action-btn btn btn-sm btn-primary" onclick="viewMember('${member.id}')" title="View"><i class="fas fa-eye"></i></button><button class="action-btn btn btn-sm btn-warning" onclick="editMember('${member.id}')" title="Edit"><i class="fas fa-edit"></i></button><button class="action-btn btn btn-sm text-white" onclick="openChangeTypeModal('${member.id}')" title="Change Type" style="background:linear-gradient(135deg,#312e81,#6366f1);"><i class="fas fa-exchange-alt"></i></button><button class="action-btn btn btn-sm btn-danger" onclick="deleteMember('${member.id}')" title="Delete"><i class="fas fa-trash"></i></button>`;
            }
            let avatarHtml;
            if (member.entityType === 'kiddies') {
                const initials = (member.firstName[0]||'?') + (member.lastName[0]||'?');
                avatarHtml = `<div class="kiddies-avatar">${initials.toUpperCase()}</div>`;
            } else {
                const src = member.displayPicture || `https://ui-avatars.com/api/?name=${encodeURIComponent(member.firstName+' '+member.lastName)}&background=1e3a8a&color=fff&size=80`;
                avatarHtml = `<img src="${src}" alt="Avatar" class="member-avatar">`;
            }
            const subLabel = member.entityType === 'kiddies' ? `<small class="text-muted" style="color:#ec4899!important;">Parent: ${member.parentName||'—'}</small>` : `<small class="text-muted">${member.email}</small>`;
            row.innerHTML = `<td><input type="checkbox" class="member-checkbox" data-id="${member.id}" onchange="updateSelection()"></td><td><div class="d-flex align-items-center gap-2">${avatarHtml}<div><div class="fw-semibold">${member.firstName} ${member.lastName}</div>${subLabel}</div></div></td><td><span class="badge bg-primary-subtle text-primary">${member.memberID||'-'}</span></td><td>${getMemberTypeBadge(member)}</td><td>${member.phone||'-'}</td><td>${statusBadge}</td><td><strong>₦${member.balance.toLocaleString()}</strong></td><td>${new Date(member.joinDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</td><td><div class="btn-group">${actionButtons}</div></td>`;
            tbody.appendChild(row);
        });
        renderPagination(filteredMembers.length, page);
    }

    function renderPagination(total, current) {
        const totalPages = Math.ceil(total/PER_PAGE);
        const el = document.getElementById('paginationEl');
        if (totalPages <= 1) { el.innerHTML=''; return; }
        let html = `<li class="page-item ${current===1?'disabled':''}"><a class="page-link" href="#" onclick="goPage(${current-1});return false;"><i class="fas fa-chevron-left"></i></a></li>`;
        const start = Math.max(1, current-2), end = Math.min(totalPages, current+2);
        if (start>1) html += `<li class="page-item"><a class="page-link" href="#" onclick="goPage(1);return false;">1</a></li>${start>2?'<li class="page-item disabled"><a class="page-link">…</a></li>':''}`;
        for (let i=start; i<=end; i++) html += `<li class="page-item ${i===current?'active':''}"><a class="page-link" href="#" onclick="goPage(${i});return false;">${i}</a></li>`;
        if (end<totalPages) html += `${end<totalPages-1?'<li class="page-item disabled"><a class="page-link">…</a></li>':''}<li class="page-item"><a class="page-link" href="#" onclick="goPage(${totalPages});return false;">${totalPages}</a></li>`;
        html += `<li class="page-item ${current===totalPages?'disabled':''}"><a class="page-link" href="#" onclick="goPage(${current+1});return false;"><i class="fas fa-chevron-right"></i></a></li>`;
        el.innerHTML = html;
    }

    function goPage(p) { renderMembers(_currentFilteredMembers, p); window.scrollTo({top:0,behavior:'smooth'}); }

    function attachFilterListeners() {
        ['searchInput','statusFilter','typeFilter','sortFilter'].forEach(id => {
            const el = document.getElementById(id);
            el.addEventListener('change', applyFilters);
            if (id==='searchInput') el.addEventListener('keyup', applyFilters);
        });
    }
    function applyFilters() {
        let f = [...members];
        const s = document.getElementById('searchInput').value.toLowerCase();
        if (s) f = f.filter(m=>(m.firstName+m.lastName+m.email+m.memberID+m.parentName).toLowerCase().includes(s));
        const st = document.getElementById('statusFilter').value;
        if (st) f = f.filter(m=>m.status===st);
        const ty = document.getElementById('typeFilter').value;
        if (ty) f = f.filter(m=>m.type===ty);
        const so = document.getElementById('sortFilter').value;
        if (so==='newest') f.sort((a,b)=>new Date(b.joinDate)-new Date(a.joinDate));
        else if (so==='oldest') f.sort((a,b)=>new Date(a.joinDate)-new Date(b.joinDate));
        else if (so==='name') f.sort((a,b)=>a.firstName.localeCompare(b.firstName));
        renderMembers(f, 1);
    }
