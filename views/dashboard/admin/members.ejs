    <!-- ══════════════════════════════════════════════════════
         ★ CHANGE MEMBER TYPE MODAL
         Works for ANY member — pending, active, or rejected.
         Hitting this button replaces the membershipID with a
         new sequential one for the chosen type.
    ══════════════════════════════════════════════════════ -->
    <div class="modal fade" id="changeTypeModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-exchange-alt me-2"></i>Change Member Type</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Member summary card -->
                    <div class="ct-summary">
                        <img id="ct_avatar" alt="avatar">
                        <div style="flex:1;min-width:0;">
                            <div class="fw-bold" id="ct_name" style="color:#312e81;"></div>
                            <small class="text-muted d-block text-truncate" id="ct_email"></small>
                            <span class="badge mt-1" id="ct_currentTypeBadge" style="font-size:.72rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-star me-2" style="color:#6366f1;"></i>Select New Membership Type
                        </label>
                        <select class="form-select" id="ct_memberTypeId">
                            <option value="">Choose new type...</option>
                            <% memberTypes.forEach(type => { %>
                                <option value="<%= type.id %>"
                                        data-short="<%= type.shortCode %>"
                                        data-rate="<%= type.interestRate %>"
                                        data-name="<%= type.name %>">
                                    <%= type.name %> (<%= type.shortCode %>) — <%= type.interestRate %>% Interest
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="alert alert-warning py-2 mb-0" style="font-size:.85rem;">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        The member's current Membership ID will be <strong>replaced</strong> with a new sequential ID for the selected type. This takes effect immediately.
