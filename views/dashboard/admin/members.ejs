    function buildExportRows(data) {
        return data.map((m, i) => ({
            '#': i+1, 'Entity Type': m.entityType==='kiddies'?'Kiddies Account':'Member',
            'Member / Account ID': m.memberID||'N/A', 'First Name': m.firstName, 'Last Name': m.lastName,
            'Email': m.email||'---', 'Phone': m.phone||'---',
            'Status': m.status.charAt(0).toUpperCase()+m.status.slice(1),
            'Type': m.entityType==='kiddies'?'Kiddies Account':(m.account?.accountType?.name||'No Membership'),
            'Savings (₦)': m.memberStats.memberSavings, 'Accum. ROI (₦)': m.memberStats.accumulativeROI,
            'Total Balance (₦)': m.memberStats.totalBalance, 'Share (%)': Number(m.memberStats.sharePercentage||0).toFixed(2),
            'Est. ROI Earning (₦)': m.memberStats.ROI, 'Company Charge (₦)': m.memberStats.companyChargeOnUser,
            'State': m.state||'---', 'LGA': m.lga||'---',
            'Date Joined': new Date(m.joinDate).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}),
            'Parent Name': m.entityType==='kiddies'?(m.parentName||'---'):'---',
            'Parent Member ID': m.entityType==='kiddies'?(m.parentMemberID||'---'):'---',
            'Unlock Date': m.entityType==='kiddies'&&m.unlockDate?new Date(m.unlockDate).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}):'---',
            'Bank Name': m.bankDetails?.bankName||'---', 'Account Number': m.bankDetails?.accountNumber||'---',
            'Account Name': m.bankDetails?.accountName||'---', 'NOK Name': m.nextOfKin?.fullName||'---',
            'NOK Phone': m.nextOfKin?.phone||'---', 'NOK Relationship': m.nextOfKin?.relationship||'---',
            'LOAN': m.loanDetails?.currentLoanAmount?fmt(m.loanDetails.currentLoanAmount):'---', 'LOAN STATUS': m.loanDetails?.loanStatus?m.loanDetails.loanStatus.charAt(0).toUpperCase()+m.loanDetails.loanStatus.slice(1):'---',
        }));
    }

    function exportToExcel(useFiltered=false) {
        const data = useFiltered?_currentFilteredMembers:members;
        if (!data.length) { showNotify({type:'warning',title:'No Data',message:'No members to export.'}); return; }
        const rows = buildExportRows(data);
        const ws = XLSX.utils.json_to_sheet(rows);
        ws['!cols']=[{wch:4},{wch:14},{wch:14},{wch:16},{wch:16},{wch:28},{wch:16},{wch:10},{wch:18},{wch:16},{wch:16},{wch:16},{wch:10},{wch:18},{wch:18},{wch:14},{wch:14},{wch:16},{wch:16},{wch:14},{wch:14},{wch:16},{wch:16},{wch:20},{wch:20},{wch:16},{wch:16}];
        const range = XLSX.utils.decode_range(ws['!ref']);
        for (let C=range.s.c; C<=range.e.c; C++) { const addr=XLSX.utils.encode_cell({r:0,c:C}); if(!ws[addr]) continue; ws[addr].s={fill:{fgColor:{rgb:'1E3A8A'}},font:{bold:true,color:{rgb:'FFFFFF'},sz:11},alignment:{horizontal:'center',vertical:'center',wrapText:true},border:{bottom:{style:'thin',color:{rgb:'FFFFFF'}},right:{style:'thin',color:{rgb:'FFFFFF'}}}}; }
        for (let R=1; R<=range.e.r; R++) {
            const isKiddiesRow=rows[R-1]?.['Entity Type']==='Kiddies Account';
            const fillColor=isKiddiesRow?'FFF0F9':(R%2===0?'EEF2FF':'FFFFFF');
            for (let C=range.s.c; C<=range.e.c; C++) { const addr=XLSX.utils.encode_cell({r:R,c:C}); if(!ws[addr]) ws[addr]={v:'',t:'s'}; ws[addr].s={fill:{fgColor:{rgb:fillColor}},alignment:{vertical:'center'},border:{bottom:{style:'thin',color:{rgb:'E0E7FF'}},right:{style:'thin',color:{rgb:'E0E7FF'}}}}; }
            [9,10,11,13,14].forEach(c=>{const addr=XLSX.utils.encode_cell({r:R,c});if(ws[addr]){ws[addr].t='n';ws[addr].z='#,##0.00';}});
            const shareAddr=XLSX.utils.encode_cell({r:R,c:12}); if(ws[shareAddr]){ws[shareAddr].t='s';ws[shareAddr].v=ws[shareAddr].v+'%';}
            const stAddr=XLSX.utils.encode_cell({r:R,c:7}); if(ws[stAddr]){const v=ws[stAddr].v;const fc=v==='Active'?'065F46':v==='Pending'?'92400E':v==='Locked'?'831843':'7F1D1D';ws[stAddr].s={...ws[stAddr].s,font:{bold:true,color:{rgb:fc}}};}
        }
        const wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'All Members');
        const regularData=data.filter(m=>m.entityType==='member'); const kiddiesData=data.filter(m=>m.entityType==='kiddies');
        const totSavings=data.reduce((s,m)=>s+m.memberStats.memberSavings,0); const totROI=data.reduce((s,m)=>s+m.memberStats.ROI,0); const totAccumROI=data.reduce((s,m)=>s+m.memberStats.accumulativeROI,0); const totBalance=data.reduce((s,m)=>s+m.memberStats.totalBalance,0);
        const summaryData=[['Club De Stars Cooperative — Member Export',''],['Generated',new Date().toLocaleString()],['',''],['MEMBER COUNTS',''],['Total Records Exported',data.length],['Regular Members',regularData.length],['  — Active',regularData.filter(m=>m.status==='active').length],['  — Pending',regularData.filter(m=>m.status==='pending').length],['  — Rejected',regularData.filter(m=>m.status==='rejected').length],['Kiddies Accounts',kiddiesData.length],['  — Active Kiddies',kiddiesData.filter(m=>m.status==='active').length],['  — Locked Kiddies',kiddiesData.filter(m=>m.status==='locked').length],['',''],['FINANCIAL TOTALS (Exported Set)',''],['Total Savings',totSavings],['Total Accum. ROI',totAccumROI],['Total Balance',totBalance],['Total Est. ROI Earnings',totROI]];
        const ws2=XLSX.utils.aoa_to_sheet(summaryData); ws2['!cols']=[{wch:32},{wch:20}]; XLSX.utils.book_append_sheet(wb,ws2,'Summary');
        const filename=`CDS_Members_${new Date().toISOString().split('T')[0]}${useFiltered?'_filtered':''}.xlsx`;
        XLSX.writeFile(wb,filename);
        showNotify({type:'success',title:'Excel Exported',message:`${data.length} record(s) exported to ${filename}`});
    }

    function exportToPDF(useFiltered=false) {
        const data=useFiltered?_currentFilteredMembers:members;
        if (!data.length) { showNotify({type:'warning',title:'No Data',message:'No members to export.'}); return; }
        const now=new Date().toLocaleString('en-US',{year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit'});
        const regular=data.filter(m=>m.entityType==='member'); const kiddies=data.filter(m=>m.entityType==='kiddies');
        const active=regular.filter(m=>m.status==='active').length; const pending=regular.filter(m=>m.status==='pending').length; const rejected=regular.filter(m=>m.status==='rejected').length;
        const totSavings=data.reduce((s,m)=>s+m.memberStats.memberSavings,0); const totROI=data.reduce((s,m)=>s+m.memberStats.ROI,0); const totBalance=data.reduce((s,m)=>s+m.memberStats.totalBalance,0);
        const rows=data.map((m,i)=>{
            const isKiddies=m.entityType==='kiddies';
            const statusColor=m.status==='active'?'#065f46':m.status==='pending'?'#92400e':m.status==='locked'?'#831843':'#7f1d1d';
            const statusBg=m.status==='active'?'#d1fae5':m.status==='pending'?'#fef3c7':m.status==='locked'?'#fce7f3':'#fee2e2';
            const rowBg=isKiddies?(i%2===0?'#fff8fc':'#fdf2f8'):(i%2===0?'#fff':'#f8fafc');
            const s=m.memberStats;
            const typeLabel=isKiddies?`<span style="background:#fce7f3;color:#db2777;padding:1px 6px;border-radius:6px;font-size:9px;font-weight:700;">👶 Kiddies</span>`:`<span style="font-size:10px;">${m.account?.accountType?.name||'—'}</span>`;
            const subLine=isKiddies?`<span style="color:#ec4899;font-size:9px;">Parent: ${m.parentName||'—'} · ${m.parentMemberID||'—'}</span>`:`<span style="color:#9ca3af;font-size:10px;">${m.email}</span>`;
            return `<tr style="background:${rowBg};"><td style="text-align:center;color:#9ca3af;font-size:11px;">${i+1}</td><td><strong style="font-size:12px;">${m.firstName} ${m.lastName}</strong><br>${subLine}<br><span style="font-family:monospace;font-size:10px;color:#6366f1;">${m.memberID||'N/A'}</span></td><td>${typeLabel}</td><td style="text-align:center;"><span style="background:${statusBg};color:${statusColor};padding:2px 7px;border-radius:10px;font-size:10px;font-weight:700;text-transform:uppercase;">${m.status}</span></td><td style="text-align:right;font-size:11px;"><strong style="color:#1e3a8a;">₦${Number(s.memberSavings).toLocaleString('en-NG',{minimumFractionDigits:2})}</strong><br><span style="color:#9ca3af;font-size:10px;">Accum: ₦${Number(s.accumulativeROI).toLocaleString('en-NG',{minimumFractionDigits:2})}</span></td><td style="text-align:right;font-size:11px;"><strong style="color:#059669;">₦${Number(s.totalBalance).toLocaleString('en-NG',{minimumFractionDigits:2})}</strong></td><td style="text-align:right;font-size:11px;"><span style="color:#d97706;font-weight:700;">${Number(s.sharePercentage).toFixed(2)}%</span><br><span style="color:#059669;font-size:10px;">ROI: ₦${Number(s.ROI).toLocaleString('en-NG',{minimumFractionDigits:2})}</span></td><td style="font-size:10px;color:#6b7280;">${new Date(m.joinDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</td></tr>`;
        }).join('');
        const html=`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Club De Stars — Member Report</title><style>*{box-sizing:border-box;margin:0;padding:0;}body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#1e293b;background:#fff;}.header{background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;padding:24px 28px;}.header h1{font-size:20px;font-weight:800;margin-bottom:3px;}.header p{font-size:11px;opacity:.8;}.meta{display:flex;gap:16px;padding:12px 28px;background:#f8fafc;border-bottom:1px solid #e2e8f0;flex-wrap:wrap;}.meta-item{display:flex;flex-direction:column;}.meta-item span:first-child{font-size:9px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.07em;}.meta-item span:last-child{font-size:14px;font-weight:800;color:#1e3a8a;}.meta-item.green span:last-child{color:#059669;}.meta-item.amber span:last-child{color:#d97706;}.meta-item.red span:last-child{color:#dc2626;}.meta-item.purple span:last-child{color:#7c3aed;}.meta-item.pink span:last-child{color:#db2777;}table{width:100%;border-collapse:collapse;font-size:12px;}thead tr{background:#1e3a8a;color:white;}thead th{padding:9px 10px;text-align:left;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap;}thead th:first-child{text-align:center;width:30px;}tbody td{padding:8px 10px;border-bottom:1px solid #f1f5f9;vertical-align:middle;}.footer{padding:16px 28px;font-size:10px;color:#9ca3af;border-top:2px solid #e2e8f0;display:flex;justify-content:space-between;margin-top:8px;}@media print{@page{size:A4 landscape;margin:8mm;}.no-print{display:none;}}</style></head><body><div class="header"><h1>Club De Stars Cooperative — Member Report</h1><p>Generated: ${now}${useFiltered?' · Filtered export':' · Full export'}</p></div><div class="meta"><div class="meta-item"><span>Total Records</span><span>${data.length}</span></div><div class="meta-item green"><span>Active Members</span><span>${active}</span></div><div class="meta-item amber"><span>Pending</span><span>${pending}</span></div><div class="meta-item red"><span>Rejected</span><span>${rejected}</span></div><div class="meta-item pink"><span>Kiddies</span><span>${kiddies.length}</span></div><div class="meta-item"><span>Total Savings</span><span>₦${totSavings.toLocaleString('en-NG',{minimumFractionDigits:2})}</span></div><div class="meta-item green"><span>Total Balance</span><span>₦${totBalance.toLocaleString('en-NG',{minimumFractionDigits:2})}</span></div><div class="meta-item purple"><span>Total Est. ROI</span><span>₦${totROI.toLocaleString('en-NG',{minimumFractionDigits:2})}</span></div></div><div style="padding:0 0 12px;"><table><thead><tr><th>#</th><th>Member / Child</th><th>Type</th><th>Status</th><th style="text-align:right;">Savings / Accum.</th><th style="text-align:right;">Total Balance</th><th style="text-align:right;">Share % / ROI</th><th>Joined</th></tr></thead><tbody>${rows}</tbody></table></div><div class="footer"><span>Club De Stars Cooperative &nbsp;·&nbsp; Powered by JESZ LIMITED</span><span>${data.length} records · Members: ${regular.length} · Kiddies: ${kiddies.length}</span></div><div style="text-align:center;padding:14px;" class="no-print"><button onclick="window.print()" style="padding:10px 28px;background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:white;border:none;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;margin-right:8px;">🖨 Print / Save as PDF</button><button onclick="window.close()" style="padding:10px 20px;background:#f1f5f9;color:#374151;border:1px solid #e2e8f0;border-radius:8px;font-weight:600;font-size:14px;cursor:pointer;">Close</button></div></body></html>`;
        const win=window.open('','_blank','width=1200,height=800'); win.document.write(html); win.document.close(); win.focus();
    }

    async function loadSidebarPendingCount() {
        try {
            const res=await fetch('/admin/pending-approvals-count'); const data=await res.json();
            const badge=document.getElementById('sidebarBadge'); if(!badge) return;
            badge.style.display=data.count>0?'inline-block':'none'; if(data.count>0) badge.textContent=data.count;
        } catch(err){ console.error('Sidebar count error:',err); }
    }
    document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
    </script>






<script>
(function () {
    const TIMEOUT_MS  = 1 * 60 * 1000;
    const WARNING_MS  = 20 * 1000;
    const LOGOUT_URL  = '/logout';
    const PING_URL    = '/api/ping';     // keeps session alive on activity

    let logoutTimer, warningTimer, warningEl;

    function resetTimers() {
        clearTimeout(logoutTimer);
        clearTimeout(warningTimer);
        hideWarning();

        warningTimer = setTimeout(showWarning, TIMEOUT_MS - WARNING_MS);
        logoutTimer  = setTimeout(() => { window.location.href = LOGOUT_URL; }, TIMEOUT_MS);
    }

    function showWarning() {
        if (warningEl) return;
        warningEl = document.createElement('div');
        warningEl.id = 'inactivity-warning';
        warningEl.innerHTML = `
            <div style="
                position:fixed;bottom:24px;right:24px;z-index:99999;
                background:#1e3a8a;color:#fff;border-radius:14px;
                padding:16px 20px;max-width:300px;
                box-shadow:0 8px 32px rgba(0,0,0,.3);font-size:13px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
            ">
                <strong style="display:block;margin-bottom:6px;">⏱ Session expiring</strong>
                You'll be logged out in 1 minute due to inactivity.
                <button onclick="stayLoggedIn()" style="
                    display:block;margin-top:12px;width:100%;
                    padding:8px;border:none;border-radius:8px;
                    background:#fff;color:#1e3a8a;font-weight:700;
                    cursor:pointer;font-size:13px;
                ">Stay logged in</button>
            </div>`;
        document.body.appendChild(warningEl);
    }

    function hideWarning() {
        if (warningEl) { warningEl.remove(); warningEl = null; }
    }

    window.stayLoggedIn = function () {
        fetch(PING_URL, { credentials: 'same-origin' }); // touch the session
        resetTimers();
    };

    // Reset on any user activity
    ['mousemove','keydown','mousedown','touchstart','scroll'].forEach(evt => {
        document.addEventListener(evt, resetTimers, { passive: true });
    });

    resetTimers(); // start on page load
})();
</script>
</body>
</html>