// Document Preview
function viewDocument(url, title) {
    const docTitle = document.getElementById("doc_title");
    const docFrame = document.getElementById("doc_frame");
    docTitle.innerText = title || "Document Preview";

    // If PDF -> load in iframe (works if served with correct headers)
    // If image -> use data URL in iframe OR open in new tab for best UX
    // For other unknown types, open in new tab
    const lower = url.split('?')[0].toLowerCase();
    if (lower.endsWith(".pdf")) {
        docFrame.src = url;
        new bootstrap.Modal(document.getElementById("documentModal")).show();
    } else if (lower.match(/\.(jpg|jpeg|png|gif|bmp|webp)$/)) {
        // show image inside iframe (works) or use an <img> inside modal — we use iframe for simplicity
        docFrame.src = url;
        new bootstrap.Modal(document.getElementById("documentModal")).show();
    } else {
        // Unknown file type — try to open in new tab (safer fallback)
        window.open(url, "_blank");
    }
}



