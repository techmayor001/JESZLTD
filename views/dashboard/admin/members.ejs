            height: 100%;
            border: 1px solid rgba(30, 58, 138, 0.05);
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(30, 58, 138, 0.15);
        }
        
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 1rem;
        }
        
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            background: white;
            border: 1px solid rgba(30, 58, 138, 0.05);
        }
        
        .card-header {
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.03) 0%, rgba(59, 130, 246, 0.03) 100%);
            border-bottom: 2px solid rgba(30, 58, 138, 0.1);
            padding: 1.25rem;
            border-radius: 16px 16px 0 0 !important;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(30, 58, 138, 0.3);
        }
        
        .table {
            font-size: 0.9rem;
        }
        
        .table th {
            font-weight: 600;
            color: var(--primary);
            border-bottom: 2px solid rgba(30, 58, 138, 0.1);
            white-space: nowrap;
        }
        
        .badge {
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.75rem;
        }
        
        .powered-by {
            position: fixed;
            bottom: 15px;
            right: 15px;
            background: white;
            padding: 10px 16px;
            border-radius: 25px;
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.15);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--primary);
            z-index: 1000;
        }

        .membership-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.08);
            transition: transform 0.3s, box-shadow 0.3s;
            height: 100%;
            border: 2px solid rgba(30, 58, 138, 0.05);
            position: relative;
            overflow: hidden;
        }

        .membership-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(30, 58, 138, 0.15);
        }

        .membership-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        }

        .membership-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 1rem;
        }

        .membership-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 0.25rem;
        }

        .membership-price {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .membership-features {
            list-style: none;
            padding: 0;
            margin: 1rem 0;
        }

        .membership-features li {
            padding: 0.5rem 0;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .membership-features li i {
            color: var(--success);
            font-size: 0.85rem;
        }

        .membership-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.4rem 1rem;
            font-size: 0.85rem;
            border-radius: 8px;
        }

        .btn-outline-primary {
            border: 2px solid var(--primary);
            color: var(--primary);
            background: transparent;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-outline-primary:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
        }

        .btn-outline-danger {
            border: 2px solid var(--danger);
            color: var(--danger);
            background: transparent;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-outline-danger:hover {
            background: var(--danger);
            color: white;
            transform: translateY(-2px);
        }
        
        /* Mobile Responsive */
        @media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }
            
            .sidebar.active {
                transform: translateX(0);
            }
            
            .top-navbar {
                left: 0;
            }
            
            .main-content {
                margin-left: 0;
                padding: 1rem;
            }
            
            .welcome-card {
                padding: 1.5rem;
            }
            
            .stat-card {
                padding: 1.25rem;
            }
            
            .powered-by {
                bottom: 10px;
                right: 10px;
                font-size: 0.7rem;
                padding: 8px 12px;
            }
            
            .table-responsive {
                font-size: 0.85rem;
            }
        }
        
        @media (max-width: 576px) {
            .top-navbar {
                height: 60px;
                padding: 0 1rem;
            }
            
            .main-content {
                margin-top: 60px;
                padding: 0.75rem;
            }
            
            .welcome-card {
                padding: 1.25rem;
                border-radius: 16px;
            }
            
            .stat-card {
                padding: 1rem;
            }
            
            .stat-icon {
                width: 50px;
                height: 50px;
                font-size: 1.4rem;
            }
            
            .card-header {
                padding: 1rem;
            }
            
            .sidebar-header {
                padding: 1.25rem;
            }
            
            .logo-box {
                width: 40px;
                height: 40px;
                font-size: 1.25rem;
            }
            
            .sidebar-title {
                font-size: 1rem;
            }

            .membership-card {
                padding: 1.25rem;
            }

            .membership-price {
                font-size: 1.5rem;
            }

            .membership-actions {
                flex-direction: column;
            }

            .membership-actions button {
                width: 100%;
            }
