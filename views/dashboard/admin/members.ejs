                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn fw-semibold text-white"
                            style="background:linear-gradient(135deg,#312e81 0%,#6366f1 100%);border:none;"
                            onclick="confirmChangeType()">
                        <i class="fas fa-check me-2"></i>Change Type
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- ══════════════════════════════════════════════════════
         EDIT MEMBER MODAL — all fields + all 5 file uploads
    ══════════════════════════════════════════════════════ -->
    <div class="modal fade" id="editMemberModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Edit Member</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- enctype MUST be multipart/form-data for file uploads to work -->
                    <form id="editMemberForm" autocomplete="off" enctype="multipart/form-data">

                        <!-- Personal Information -->
                        <div class="edit-section-header mb-3"><i class="fas fa-user me-2" style="color:var(--primary);"></i><strong class="section-title">Personal Information</strong></div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6"><label class="form-label">First Name <span class="text-danger">*</span></label><input type="text" name="firstName" id="edit_firstName" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Last Name <span class="text-danger">*</span></label><input type="text" name="lastName" id="edit_lastName" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Email <span class="text-danger">*</span></label><input type="email" name="email" id="edit_email" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Phone</label><input type="tel" name="phone" id="edit_phone" class="form-control" placeholder="08012345678"></div>
                            <div class="col-md-6"><label class="form-label">Date of Birth</label><input type="date" name="dob" id="edit_dob" class="form-control"></div>
                            <div class="col-md-6"><label class="form-label">Status <span class="text-danger">*</span></label><select name="status" id="edit_status" class="form-select" required><option value="active">Active</option><option value="pending">Pending</option><option value="rejected">Rejected</option></select></div>
                            <div class="col-md-6"><label class="form-label">State</label><input type="text" name="state" id="edit_state" class="form-control" placeholder="e.g. Lagos"></div>
                            <div class="col-md-6"><label class="form-label">LGA</label><input type="text" name="lga" id="edit_lga" class="form-control" placeholder="e.g. Ikeja"></div>
                            <div class="col-12"><label class="form-label">Address</label><textarea name="address" id="edit_address" class="form-control" rows="2" placeholder="Full residential address"></textarea></div>
                        </div>

                        <!-- ID Details -->
                        <div class="edit-section-header mb-3"><i class="fas fa-id-card me-2" style="color:var(--primary);"></i><strong class="section-title">ID Details</strong></div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6"><label class="form-label">ID Type</label><select name="idType" id="edit_idType" class="form-select"><option value="">Select ID type...</option><option value="nin">NIN</option><option value="passport">International Passport</option><option value="drivers">Driver's License</option><option value="voters">Voter's Card</option></select></div>
                            <div class="col-md-6"><label class="form-label">ID Number</label><input type="text" name="idNumber" id="edit_idNumber" class="form-control" placeholder="Enter ID number"></div>
                        </div>

                        <!-- ★ KYC Documents — all 5 with existing-file previews -->
                        <div class="edit-section-header mb-3">
                            <i class="fas fa-file-upload me-2" style="color:var(--primary);"></i>
                            <strong class="section-title">KYC Documents</strong>
                            <small class="text-muted ms-2 fw-normal" style="font-size:.78rem;">(leave blank to keep existing file)</small>
                        </div>
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">
                                <label class="form-label">Passport Photo</label>
                                <div class="file-current-preview" id="prev_passportPhoto"><span class="dot-gray"></span><span class="text-muted fst-italic small">No file uploaded</span></div>
                                <input type="file" name="passportPhoto" id="edit_passportPhoto" class="form-control" accept="image/*,.pdf">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Display Picture</label>
                                <div class="file-current-preview" id="prev_displayPicture"><span class="dot-gray"></span><span class="text-muted fst-italic small">No file uploaded</span></div>
                                <input type="file" name="displayPicture" id="edit_displayPicture" class="form-control" accept="image/*">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">ID Document</label>
                                <div class="file-current-preview" id="prev_idFile"><span class="dot-gray"></span><span class="text-muted fst-italic small">No file uploaded</span></div>
                                <input type="file" name="idFile" id="edit_idFile" class="form-control" accept="image/*,.pdf">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Proof of Address</label>
                                <div class="file-current-preview" id="prev_addressProof"><span class="dot-gray"></span><span class="text-muted fst-italic small">No file uploaded</span></div>
                                <input type="file" name="addressProof" id="edit_addressProof" class="form-control" accept="image/*,.pdf">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Signature</label>
                                <div class="file-current-preview" id="prev_signature"><span class="dot-gray"></span><span class="text-muted fst-italic small">No file uploaded</span></div>
                                <input type="file" name="signature" id="edit_signature" class="form-control" accept="image/*,.pdf">
                            </div>

                        </div>

                        <!-- Bank Details -->
                        <div class="edit-section-header mb-3"><i class="fas fa-university me-2" style="color:var(--primary);"></i><strong class="section-title">Bank Details</strong></div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6"><label class="form-label">Bank Name</label><input type="text" name="bankName" id="edit_bankName" class="form-control" placeholder="e.g. GTBank"></div>
                            <div class="col-md-6"><label class="form-label">Account Number</label><input type="text" name="accountNumber" id="edit_accountNumber" class="form-control" placeholder="10-digit account number" maxlength="10"></div>
                            <div class="col-12"><label class="form-label">Account Name</label><input type="text" name="accountName" id="edit_accountName" class="form-control" placeholder="Account holder name"></div>
                        </div>

                        <!-- Next of Kin -->
                        <div class="edit-section-header mb-3"><i class="fas fa-people-arrows me-2" style="color:var(--primary);"></i><strong class="section-title">Next of Kin</strong></div>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">Full Name</label><input type="text" name="nokFullName" id="edit_nokFullName" class="form-control" placeholder="Next of kin full name"></div>
                            <div class="col-md-6"><label class="form-label">Relationship</label><input type="text" name="nokRelationship" id="edit_nokRelationship" class="form-control" placeholder="e.g. Spouse, Parent"></div>
                            <div class="col-md-6"><label class="form-label">Phone</label><input type="tel" name="nokPhone" id="edit_nokPhone" class="form-control" placeholder="Next of kin phone"></div>
                            <div class="col-12"><label class="form-label">Address</label><textarea name="nokAddress" id="edit_nokAddress" class="form-control" rows="2" placeholder="Next of kin address"></textarea></div>
                        </div>

                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveEditMember()"><i class="fas fa-save me-2"></i>Save Changes</button>
                </div>
            </div>
        </div>
    </div>


    <!-- ADD MEMBER MODAL -->
    <div class="modal fade" id="addMemberModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Add New Member</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <form id="addMemberForm" enctype="multipart/form-data">
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">First Name</label><input type="text" name="firstName" class="form-control" placeholder="Enter first name" required></div>
                            <div class="col-md-6"><label class="form-label">Last Name</label><input type="text" name="lastName" class="form-control" placeholder="Enter last name" required></div>
                            <div class="col-md-6"><label class="form-label">Email</label><input type="email" name="email" class="form-control" placeholder="member@email.com" required></div>
                            <div class="col-md-6"><label class="form-label">Phone</label><input type="tel" name="phone" class="form-control" placeholder="080-XXXX-XXXX" required></div>
                            <div class="col-md-6"><label class="form-label">Date of Birth</label><input type="date" name="dob" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Member Type</label><select name="memberTypeId" class="form-select" required><option value="">Select type...</option><% memberTypes.forEach(type => { %><option value="<%= type.id %>"><%= type.name %> (<%= type.shortCode %>) - <%= type.interestRate %>% ROI</option><% }) %></select></div>
                            <div class="col-md-6"><label class="form-label">State</label><input type="text" name="state" class="form-control" placeholder="Enter state" required></div>
                            <div class="col-md-6"><label class="form-label">LGA</label><input type="text" name="lga" class="form-control" placeholder="Enter LGA" required></div>
                            <div class="col-12"><label class="form-label">Address</label><textarea name="address" class="form-control" rows="2" placeholder="Enter full address" required></textarea></div>
                            <div class="col-md-6"><label class="form-label">ID Type</label><select name="idType" class="form-select" required><option value="">Select ID type...</option><option value="nin">NIN</option><option value="passport">International Passport</option><option value="drivers">Driver's License</option><option value="voters">Voter's Card</option></select></div>
                            <div class="col-md-6"><label class="form-label">ID Number</label><input type="text" name="idNumber" class="form-control" placeholder="Enter ID number" required></div>
                            <div class="col-md-6"><label class="form-label">Proof of Address</label><input type="file" name="addressProof" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Passport Photo</label><input type="file" name="passportPhoto" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">ID Document</label><input type="file" name="idFile" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Signature</label><input type="file" name="signature" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Display Picture (optional)</label><input type="file" name="displayPicture" class="form-control"></div>
                            <div class="col-md-4"><label class="form-label">Opening Balance</label><input type="number" name="openingBalance" class="form-control" value="0" required></div>
                            <div class="col-md-4"><label class="form-label">Monthly ROI</label><input type="number" name="monthlyROI" class="form-control" placeholder="e.g. 5"></div>
                            <div class="col-md-4"><label class="form-label">Accumulative ROI</label><input type="number" name="accumulativeROI" class="form-control" value="0"></div>
                            <div class="col-12"><label class="form-label">Password</label><input type="password" name="password" class="form-control" placeholder="Enter password" required></div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" onclick="saveNewMember()"><i class="fas fa-save me-2"></i>Add Member</button></div>
            </div>
        </div>
    </div>

    <!-- DELETE CONFIRM MODAL -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:linear-gradient(135deg,#7f1d1d 0%,#ef4444 100%)!important;"><h5 class="modal-title text-white"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body text-center py-4">
                    <div style="width:64px;height:64px;border-radius:50%;background:rgba(239,68,68,.12);display:flex;align-items:center;justify-content:center;font-size:1.8rem;color:#ef4444;margin:0 auto 1rem;"><i class="fas fa-trash-alt"></i></div>
                    <p class="mb-1 fw-semibold">Are you sure you want to delete this member?</p>
                    <p class="text-muted small mb-0">All associated data including savings, loans, and transactions will be permanently deleted.</p>
                </div>
                <div class="modal-footer justify-content-center gap-2"><button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger px-4" onclick="confirmDelete()"><i class="fas fa-trash me-1"></i>Delete Member</button></div>
            </div>
        </div>
    </div>

    <!-- BULK ACTIONS MODAL -->
    <div class="modal fade" id="bulkActionsModal" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title"><i class="fas fa-tasks me-2"></i>Bulk Actions</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Selected: <strong id="selectedCount">0</strong> members</p><div class="d-grid gap-2"><button class="btn btn-success" onclick="bulkApprove()"><i class="fas fa-check me-2"></i>Approve Selected</button><button class="btn btn-warning" onclick="bulkChangeType()"><i class="fas fa-exchange-alt me-2"></i>Change Member Type</button><button class="btn btn-danger" onclick="bulkDelete()"><i class="fas fa-trash me-2"></i>Delete Selected</button></div></div></div></div>
    </div>

    <!-- APPROVE MEMBER MODAL -->
    <div class="modal fade" id="approveMemberModal" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#064e3b 0%,#10b981 100%)!important;"><h5 class="modal-title text-white"><i class="fas fa-user-check me-2"></i>Approve Member</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i><strong>Important:</strong> You must assign a membership type before approving this member.</div>
                <div class="mb-3">
                    <label class="form-label fw-semibold"><i class="fas fa-star me-2" style="color:var(--primary);"></i>Select Membership Type</label>
                    <select class="form-select" id="approvalMemberType" required>
                        <option value="">Choose membership type...</option>
                        <% memberTypes.forEach(type => { %><option value="<%= type._id %>" data-short="<%= type.shortCode %>" data-rate="<%= type.interestRate %>"><%= type.name %> (<%= type.shortCode %>) - <%= type.interestRate %>% Interest Rate</option><% }) %>
                    </select>
                    <small class="text-muted d-block mt-2"><% memberTypes.forEach(type => { %><strong><%= type.shortCode %> Members:</strong> <%= type.name %> — <%= type.interestRate %>% Loan Interest Rate<br><% }) %></small>
                </div>
                <div class="card" style="background:linear-gradient(135deg,rgba(30,58,138,.05) 0%,rgba(59,130,246,.05) 100%);border:2px solid rgba(30,58,138,.1);"><div class="card-body"><h6 class="fw-bold mb-2">Member Information</h6><div class="row g-2 small"><div class="col-6"><strong>Name:</strong></div><div class="col-6 text-end" id="approvalMemberName">-</div><div class="col-6"><strong>Email:</strong></div><div class="col-6 text-end" id="approvalMemberEmail">-</div><div class="col-6"><strong>Phone:</strong></div><div class="col-6 text-end" id="approvalMemberPhone">-</div><div class="col-6"><strong>Registration Status:</strong></div><div class="col-6 text-end" id="approvalRegStatus">-</div></div></div></div>
                <div class="alert alert-warning mt-3 mb-0"><small><i class="fas fa-exclamation-triangle me-2"></i>Once approved, the member will receive an email notification and can access their dashboard.</small></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-success" onclick="confirmApproval()"><i class="fas fa-check me-2"></i>Approve Member</button></div>
        </div></div>
    </div>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>

    /* ═══════════════════════════════════════════════════
       NOTIFICATION MODAL
    ═══════════════════════════════════════════════════ */
    let _notifyResolve = null;
    function showNotify({ type='info', title='', message='', confirmLabel='OK', cancelLabel=null } = {}) {
        return new Promise(resolve => {
            _notifyResolve = resolve;
            const iconMap = { success:{icon:'fa-check-circle',label:title||'Success'}, error:{icon:'fa-times-circle',label:title||'Error'}, warning:{icon:'fa-exclamation-triangle',label:title||'Warning'}, info:{icon:'fa-info-circle',label:title||'Info'} };
            const cfg = iconMap[type]||iconMap.info;
            document.getElementById('notifyIcon').className      = `notify-icon-wrap ${type}`;
            document.getElementById('notifyIconClass').className = `fas ${cfg.icon}`;
            const t = document.getElementById('notifyTitle'); t.className = `notify-title ${type}`; t.textContent = cfg.label;
            document.getElementById('notifyMessage').textContent = message;
            const ok = document.getElementById('notifyOkBtn'); ok.className = `notify-btn-ok ${type}`; ok.textContent = confirmLabel;
            const ex = document.getElementById('notifyCancelBtn'); if(ex) ex.remove();
            if (cancelLabel) {
                const cb = document.createElement('button'); cb.className='notify-btn-cancel'; cb.id='notifyCancelBtn'; cb.textContent=cancelLabel; cb.onclick=notifyCancel;
                document.getElementById('notifyFooter').insertBefore(cb, ok);
            }
            new bootstrap.Modal(document.getElementById('notifyModal'),{backdrop:'static',keyboard:false}).show();
        });
    }
    function notifyClose()  { bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide(); if(_notifyResolve){_notifyResolve(true);_notifyResolve=null;} }
    function notifyCancel() { bootstrap.Modal.getInstance(document.getElementById('notifyModal'))?.hide(); if(_notifyResolve){_notifyResolve(false);_notifyResolve=null;} }

    /* ═══════════════════════════════════════════════════
       UNAUTHORIZED MODAL
    ═══════════════════════════════════════════════════ */
    const unauthorizedMessages = { auth:'Your session has expired. Please login again.', permission:"You don't have permission to perform this action.", inactive:'Your admin role is currently inactive.', norole:'No role is assigned to your account.', member:'Members are not allowed to access admin actions.' };
    function showUnauthorized(reason='permission', onClose=null) {
        document.getElementById('unauthorizedMessage').innerText = unauthorizedMessages[reason]||'Unauthorized action.';
        const el = document.getElementById('unauthorizedModal');
        if (onClose) el.addEventListener('hidden.bs.modal', function h(){ el.removeEventListener('hidden.bs.modal',h); onClose(); });
        new bootstrap.Modal(el).show();
    }

    /* ═══════════════════════════════════════════════════
       PERMISSION-AWARE FETCH
    ═══════════════════════════════════════════════════ */
    async function permFetch(url, options={}, sourceModal=null) {
        const hide = () => { if(sourceModal){ const i=bootstrap.Modal.getInstance(sourceModal); if(i)i.hide(); } };
        const res = await fetch(url, { headers:{'X-Requested-With':'XMLHttpRequest',...(options.headers||{})}, ...options });
        if (res.status===401) {
            hide();
            const fn = () => { showUnauthorized('auth'); setTimeout(()=>{window.location.href='/login';},1500); };
            if(sourceModal) sourceModal.addEventListener('hidden.bs.modal',function h(){sourceModal.removeEventListener('hidden.bs.modal',h);fn();}); else fn();
            return {ok:false};
        }
        if (res.status===403) {
            let d={}; try{d=await res.json();}catch(_){}
            hide();
            const fn = () => showUnauthorized(d.reason||'permission');
            if(sourceModal) sourceModal.addEventListener('hidden.bs.modal',function h(){sourceModal.removeEventListener('hidden.bs.modal',h);fn();}); else fn();
            return {ok:false};
        }
        return {ok:true, data:await res.json(), status:res.status};
    }

    /* ═══════════════════════════════════════════════════
       PAGE DATA
    ═══════════════════════════════════════════════════ */
    let members = <%- JSON.stringify(users.map(u => {
        const account = u.account || null;
        return {
            id: String(u._id),
            firstName: u.firstName||'', lastName: u.lastName||'', email: u.email||'',
            phone: u.phone||'', dob: u.dob||null,
            memberID: u.membershipID||(account?.memberID||'N/A'),
            type: account?.accountType?.shortCode||'N/A',
            status: u.status||'pending',
            registrationStatus: u.registrationStatus||'pending',
            balance: account?.balance||0,
            state: u.state||'', lga: u.lga||'', address: u.address||'',
            idType: u.idType||'', idNumber: u.idNumber||'',
            joinDate: u.createdAt||new Date(),
            displayPicture: u.displayPicture||null,
            passportPhoto:  u.passportPhoto||null,
            idFile:         u.idFile||null,
            addressProof:   u.addressProof||null,
            signature:      u.signature||null,
            bankDetails: u.bankDetails||{}, nextOfKin: u.nextOfKin||{},
            account: account ? {
                memberID: account.memberID||'N/A', balance: account.balance||0,
                accountType: account.accountType ? {
                    id: String(account.accountType._id),
                    name: account.accountType.name,
                    shortCode: account.accountType.shortCode,
                    interestRate: account.accountType.interestRate
                } : null
            } : null
        };
    })) %>;

    let memberTypes = <%- JSON.stringify(memberTypes.map(m => ({
        id: String(m._id), name: m.name, shortCode: m.shortCode, interestRate: m.interestRate
    }))) %>;

    let currentMemberId = null;
    let selectedMembers = [];

    /* ═══════════════════════════════════════════════════
       INIT
    ═══════════════════════════════════════════════════ */
    document.addEventListener('DOMContentLoaded', () => {
        updateStats(); renderMembers(); attachFilterListeners();
    });

    /* ═══════════════════════════════════════════════════
       STATS
    ═══════════════════════════════════════════════════ */
    function updateStats() {
        document.getElementById('totalMembers').textContent    = members.length;
        document.getElementById('activeMembers').textContent   = members.filter(m=>m.status==='active').length;
        document.getElementById('pendingMembers').textContent  = members.filter(m=>m.status==='pending').length;
        document.getElementById('rejectedMembers').textContent = members.filter(m=>m.status==='rejected').length;
        document.getElementById('memberCountDisplay').textContent = members.length;
    }

    /* ═══════════════════════════════════════════════════
       RENDER TABLE
    ═══════════════════════════════════════════════════ */
    function getMemberTypeBadge(member) {
        const type = member.account?.accountType;
        if (!type) return `<span class="badge" style="background:#6b7280;color:white;">No Membership</span>`;
        const colors = {CDS:'#10b981',NCDS:'#f59e0b'};
        return `<span class="badge" style="background:${colors[type.shortCode]||'#6366f1'};color:white;">${type.name}</span>`;
    }

    function renderMembers(filteredMembers=members) {
        const tbody = document.getElementById('membersTableBody');
        tbody.innerHTML = '';
        if (!filteredMembers.length) {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5"><i class="fas fa-users fa-3x text-muted mb-3 d-block"></i><p class="text-muted">No members found</p></td></tr>`;
            return;
        }
        filteredMembers.forEach(member => {
            const row = document.createElement('tr');
            const statusBadge = {active:'<span class="badge bg-success">Active</span>',pending:'<span class="badge bg-warning">Pending</span>',rejected:'<span class="badge bg-danger">Rejected</span>'}[member.status]||'<span class="badge bg-secondary">Unknown</span>';

            // ★ Change Type button visible for all members in action column
            const actionButtons = member.status === 'pending'
                ? `<button class="action-btn btn btn-sm btn-success" onclick="showApprovalModal('${member.id}')" title="Approve"><i class="fas fa-check"></i></button>
                   <button class="action-btn btn btn-sm btn-danger" onclick="rejectMember('${member.id}')" title="Reject"><i class="fas fa-times"></i></button>
                   <button class="action-btn btn btn-sm btn-primary" onclick="viewMember('${member.id}')" title="View"><i class="fas fa-eye"></i></button>
                   <button class="action-btn btn btn-sm text-white" onclick="openChangeTypeModal('${member.id}')" title="Change Type" style="background:linear-gradient(135deg,#312e81,#6366f1);"><i class="fas fa-exchange-alt"></i></button>`
                : `<button class="action-btn btn btn-sm btn-primary" onclick="viewMember('${member.id}')" title="View"><i class="fas fa-eye"></i></button>
                   <button class="action-btn btn btn-sm btn-warning" onclick="editMember('${member.id}')" title="Edit"><i class="fas fa-edit"></i></button>
                   <button class="action-btn btn btn-sm text-white" onclick="openChangeTypeModal('${member.id}')" title="Change Type" style="background:linear-gradient(135deg,#312e81,#6366f1);"><i class="fas fa-exchange-alt"></i></button>
                   <button class="action-btn btn btn-sm btn-danger" onclick="deleteMember('${member.id}')" title="Delete"><i class="fas fa-trash"></i></button>`;

            const avatar = member.displayPicture || `https://ui-avatars.com/api/?name=${encodeURIComponent(member.firstName+' '+member.lastName)}&background=1e3a8a&color=fff&size=80`;
            row.innerHTML = `
                <td><input type="checkbox" class="member-checkbox" data-id="${member.id}" onchange="updateSelection()"></td>
                <td><div class="d-flex align-items-center gap-2"><img src="${avatar}" alt="Avatar" class="member-avatar"><div><div class="fw-semibold">${member.firstName} ${member.lastName}</div><small class="text-muted">${member.email}</small></div></div></td>
                <td><span class="badge bg-primary-subtle text-primary">${member.memberID||'-'}</span></td>
                <td>${getMemberTypeBadge(member)}</td>
                <td>${member.phone||'-'}</td>
                <td>${statusBadge}</td>
                <td><strong>₦${member.balance.toLocaleString()}</strong></td>
                <td>${new Date(member.joinDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</td>
                <td><div class="btn-group">${actionButtons}</div></td>`;
            tbody.appendChild(row);
        });
    }

    /* ═══════════════════════════════════════════════════
       FILTERS
    ═══════════════════════════════════════════════════ */
    function attachFilterListeners() {
        ['searchInput','statusFilter','typeFilter','sortFilter'].forEach(id => {
            const el = document.getElementById(id);
            el.addEventListener('change', applyFilters);
            if (id==='searchInput') el.addEventListener('keyup', applyFilters);
        });
    }
    function applyFilters() {
        let f = [...members];
        const s = document.getElementById('searchInput').value.toLowerCase();
        if (s) f = f.filter(m=>(m.firstName+m.lastName+m.email+m.memberID).toLowerCase().includes(s));
        const st = document.getElementById('statusFilter').value; if(st) f=f.filter(m=>m.status===st);
        const ty = document.getElementById('typeFilter').value;   if(ty) f=f.filter(m=>m.type===ty);
        const so = document.getElementById('sortFilter').value;
        if(so==='newest') f.sort((a,b)=>new Date(b.joinDate)-new Date(a.joinDate));
        else if(so==='oldest') f.sort((a,b)=>new Date(a.joinDate)-new Date(b.joinDate));
        else if(so==='name')   f.sort((a,b)=>a.firstName.localeCompare(b.firstName));
        renderMembers(f);
    }
    function resetFilters() {
        ['searchInput','statusFilter','typeFilter'].forEach(id=>document.getElementById(id).value='');
        document.getElementById('sortFilter').value='newest'; renderMembers();
    }

    /* ═══════════════════════════════════════════════════
       SELECTION
    ═══════════════════════════════════════════════════ */
    function toggleSelectAll() { const c=document.getElementById('selectAll').checked; document.querySelectorAll('.member-checkbox').forEach(cb=>cb.checked=c); updateSelection(); }
    function updateSelection() { selectedMembers=[...document.querySelectorAll('.member-checkbox:checked')].map(cb=>cb.dataset.id); }
    function openModal(id) { new bootstrap.Modal(document.getElementById(id)).show(); }

    /* ═══════════════════════════════════════════════════
       HELPER — normalise file path
    ═══════════════════════════════════════════════════ */
    function normPath(p) {
        if (!p) return null;
        p = p.replace(/\\/g,'/');
        if (p.startsWith('public/')) p=p.replace('public/','/')
        if (!p.startsWith('/')) p='/'+p;
        return p;
    }

    /* ═══════════════════════════════════════════════════
       HELPER — render file preview row
    ═══════════════════════════════════════════════════ */
    function renderFilePreview(wrapId, filePath, label) {
        const wrap = document.getElementById(wrapId); if(!wrap) return;
        const src = normPath(filePath);
        if (src) {
            const isImg = /\.(jpg|jpeg|png|gif|webp|bmp)$/i.test(src);
            wrap.innerHTML = `
                <span class="dot-green"></span>
                ${isImg ? `<img src="${src}" alt="${label}" title="Click to preview" onclick="viewDocument('${src}','${label}')">` : `<i class="fas fa-file-alt text-primary" style="font-size:1.4rem;flex-shrink:0;"></i>`}
                <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                    <strong style="color:#065f46;font-size:.82rem;">File exists</strong>
                    <a href="${src}" target="_blank" class="text-primary text-decoration-none small ms-1">view</a>
                </span>`;
        } else {
            wrap.innerHTML = `<span class="dot-gray"></span><span class="text-muted fst-italic small">No file uploaded</span>`;
        }
    }

    /* ═══════════════════════════════════════════════════
       ADD MEMBER
    ═══════════════════════════════════════════════════ */
    function openAddMemberModal() { openModal('addMemberModal'); }
    async function saveNewMember() {
        const formData = new FormData(document.getElementById('addMemberForm'));
        const modalEl  = document.getElementById('addMemberModal');
        const result   = await permFetch('/add',{method:'POST',body:formData},modalEl);
        if (!result.ok) return;
        if (result.data.status) { bootstrap.Modal.getInstance(modalEl).hide(); await showNotify({type:'success',title:'Member Added',message:'The new member has been successfully added.'}); location.reload(); }
        else { await showNotify({type:'error',title:'Failed to Add Member',message:result.data.message||'An error occurred.'}); }
    }

    /* ═══════════════════════════════════════════════════
       EDIT MEMBER — populate all fields + file previews
    ═══════════════════════════════════════════════════ */
    function editMember(id) {
        currentMemberId = id;
        const m = members.find(m=>m.id==id); if(!m) return;

        // Personal
        document.getElementById('edit_firstName').value = m.firstName||'';
        document.getElementById('edit_lastName').value  = m.lastName ||'';
        document.getElementById('edit_email').value     = m.email    ||'';
        document.getElementById('edit_phone').value     = m.phone    ||'';
        document.getElementById('edit_status').value    = m.status   ||'pending';
        document.getElementById('edit_state').value     = m.state    ||'';
        document.getElementById('edit_lga').value       = m.lga      ||'';
        document.getElementById('edit_address').value   = m.address  ||'';
        if (m.dob) { try{ document.getElementById('edit_dob').value=new Date(m.dob).toISOString().split('T')[0]; }catch(_){document.getElementById('edit_dob').value='';} }
        else document.getElementById('edit_dob').value='';

        // ID
        document.getElementById('edit_idType').value   = m.idType  ||'';
        document.getElementById('edit_idNumber').value = m.idNumber||'';

        // File previews
        renderFilePreview('prev_passportPhoto',  m.passportPhoto,  'Passport Photo');
        renderFilePreview('prev_displayPicture', m.displayPicture, 'Display Picture');
        renderFilePreview('prev_idFile',         m.idFile,         'ID Document');
        renderFilePreview('prev_addressProof',   m.addressProof,   'Proof of Address');
        renderFilePreview('prev_signature',      m.signature,      'Signature');

        // Clear stale file inputs
        ['edit_passportPhoto','edit_displayPicture','edit_idFile','edit_addressProof','edit_signature']
            .forEach(id=>{ document.getElementById(id).value=''; });

        // Bank
        document.getElementById('edit_bankName').value      = m.bankDetails?.bankName     ||'';
        document.getElementById('edit_accountNumber').value = m.bankDetails?.accountNumber||'';
        document.getElementById('edit_accountName').value   = m.bankDetails?.accountName  ||'';

        // NOK
        document.getElementById('edit_nokFullName').value     = m.nextOfKin?.fullName    ||'';
        document.getElementById('edit_nokRelationship').value = m.nextOfKin?.relationship||'';
        document.getElementById('edit_nokPhone').value        = m.nextOfKin?.phone       ||'';
        document.getElementById('edit_nokAddress').value      = m.nextOfKin?.address     ||'';

        // Close view modal if open, then open edit
        const vi = bootstrap.Modal.getInstance(document.getElementById('viewMemberModal'));
        if (vi) { vi.hide(); document.getElementById('viewMemberModal').addEventListener('hidden.bs.modal', function once(){ this.removeEventListener('hidden.bs.modal',once); openModal('editMemberModal'); }); }
        else openModal('editMemberModal');
    }

    /* ═══════════════════════════════════════════════════
       SAVE EDIT — multipart/form-data (includes files)
       Backend should ignore file fields with size === 0
       and keep the existing stored path.
    ═══════════════════════════════════════════════════ */
    async function saveEditMember() {
        const form    = document.getElementById('editMemberForm');
        const modalEl = document.getElementById('editMemberModal');
        if (!form.checkValidity()) { form.reportValidity(); return; }

        const formData = new FormData(form); // includes all text fields AND any selected files

        // Send as multipart — do NOT set Content-Type header (browser sets it with boundary)
        const result = await permFetch(
            `/admin/members/edit/${currentMemberId}`,
            { method:'POST', body:formData },
            modalEl
        );
        if (!result.ok) return;

        if (result.data?.status) {
            // Patch local array
            const idx = members.findIndex(m=>m.id===currentMemberId);
            if (idx !== -1) {
                const m = members[idx];
                const g = k => formData.get(k)||'';
                m.firstName = g('firstName')||m.firstName; m.lastName  = g('lastName') ||m.lastName;
                m.email     = g('email')    ||m.email;     m.phone     = g('phone')    ||m.phone;
                m.status    = g('status')   ||m.status;    m.state     = g('state')    ||m.state;
                m.lga       = g('lga')      ||m.lga;       m.address   = g('address')  ||m.address;
                m.idType    = g('idType')   ||m.idType;    m.idNumber  = g('idNumber') ||m.idNumber;
                m.bankDetails = { bankName:g('bankName')||m.bankDetails?.bankName||'', accountNumber:g('accountNumber')||m.bankDetails?.accountNumber||'', accountName:g('accountName')||m.bankDetails?.accountName||'' };
                m.nextOfKin   = { fullName:g('nokFullName')||m.nextOfKin?.fullName||'', relationship:g('nokRelationship')||m.nextOfKin?.relationship||'', phone:g('nokPhone')||m.nextOfKin?.phone||'', address:g('nokAddress')||m.nextOfKin?.address||'' };
                // If backend returns updated file paths, patch them
                if (result.data.files) {
                    if (result.data.files.passportPhoto)  m.passportPhoto  = result.data.files.passportPhoto;
                    if (result.data.files.displayPicture) m.displayPicture = result.data.files.displayPicture;
                    if (result.data.files.idFile)         m.idFile         = result.data.files.idFile;
                    if (result.data.files.addressProof)   m.addressProof   = result.data.files.addressProof;
                    if (result.data.files.signature)      m.signature      = result.data.files.signature;
                }
            }
            updateStats(); renderMembers();
            bootstrap.Modal.getInstance(modalEl).hide();
            await showNotify({type:'success',title:'Member Updated',message:'Member details have been successfully updated.'});
        } else {
            await showNotify({type:'error',title:'Update Failed',message:result.data?.message||'An error occurred.'});
        }
    }

    /* ═══════════════════════════════════════════════════
       VIEW MEMBER
    ═══════════════════════════════════════════════════ */
    function viewMember(id) {
        const m = members.find(m=>m.id==id); if(!m) return;
        const avatar = m.displayPicture||m.passportPhoto||`https://ui-avatars.com/api/?name=${encodeURIComponent(m.firstName+' '+m.lastName)}&background=1e3a8a&color=fff&size=150`;
        document.getElementById('view_avatar').src            = avatar;
        document.getElementById('view_fullname').innerText    = `${m.firstName} ${m.lastName}`.trim()||'No name';
        document.getElementById('view_membershipId').innerText= m.memberID||'No ID';
        const sb=document.getElementById('view_status_badge');
        sb.className='badge '+(m.status==='active'?'bg-success':m.status==='pending'?'bg-warning':'bg-danger');
        sb.innerText=m.status?m.status.charAt(0).toUpperCase()+m.status.slice(1):'Unknown';
        document.getElementById('view_type_badge_wrap').innerHTML = getMemberTypeBadge(m);
        document.getElementById('view_email').innerText           = m.email   ||'---';
        document.getElementById('view_phone').innerText           = m.phone   ||'---';
        document.getElementById('view_dob').innerText             = m.dob?new Date(m.dob).toLocaleDateString():'---';
        document.getElementById('view_state_lga').innerText       = (m.state||'---')+(m.lga?', '+m.lga:'');
        document.getElementById('view_address').innerText         = m.address ||'---';
        document.getElementById('view_bankName').innerText        = m.bankDetails?.bankName     ||'---';
        document.getElementById('view_accountNumber').innerText   = m.bankDetails?.accountNumber||'---';
        document.getElementById('view_accountName').innerText     = m.bankDetails?.accountName  ||'---';
        document.getElementById('view_nok_name').innerText        = m.nextOfKin?.fullName    ||'---';
        document.getElementById('view_nok_relationship').innerText= m.nextOfKin?.relationship||'---';
        document.getElementById('view_nok_phone').innerText       = m.nextOfKin?.phone       ||'---';
        document.getElementById('view_nok_address').innerText     = m.nextOfKin?.address     ||'---';
        const docs=[{label:'Passport Photo',src:normPath(m.passportPhoto)},{label:'ID Document',src:normPath(m.idFile)},{label:'Address Proof',src:normPath(m.addressProof)},{label:'Signature',src:normPath(m.signature)}];
        const dc=document.getElementById('view_documents'); dc.innerHTML='';
        docs.forEach(doc=>{ if(!doc.src) return; const w=document.createElement('div'); w.innerHTML=`<small class="text-muted d-block mb-2">${doc.label}</small><div style="cursor:pointer"><img src="${doc.src}" class="document-preview" alt="${doc.label}"></div>`; w.querySelector('div').addEventListener('click',()=>viewDocument(doc.src,doc.label)); dc.appendChild(w); });
        document.getElementById('editMemberBtn').onclick      = () => editMember(id);
        document.getElementById('changeTypeBtnView').onclick  = () => openChangeTypeModal(id);
        document.getElementById('deleteMemberBtn').onclick    = () => deleteMember(id);
        new bootstrap.Modal(document.getElementById('viewMemberModal')).show();
    }
    function viewDocument(url, title) {
        document.getElementById('doc_title').innerText = title||'Document Preview';
        document.getElementById('doc_frame').src = url;
        if (url.split('?')[0].toLowerCase().match(/\.(jpg|jpeg|png|gif|bmp|webp|pdf)$/)) new bootstrap.Modal(document.getElementById('documentModal')).show();
        else window.open(url,'_blank');
    }

    /* ═══════════════════════════════════════════════════
       ★ CHANGE MEMBER TYPE — opens for ANY member,
         replaces membershipID with new sequential one
    ═══════════════════════════════════════════════════ */
    function openChangeTypeModal(id) {
        currentMemberId = id;
        const m = members.find(m=>m.id==id); if(!m) return;

        const avatar = m.displayPicture||m.passportPhoto||`https://ui-avatars.com/api/?name=${encodeURIComponent(m.firstName+' '+m.lastName)}&background=312e81&color=fff&size=80`;
        document.getElementById('ct_avatar').src        = avatar;
        document.getElementById('ct_name').textContent  = `${m.firstName} ${m.lastName}`;
        document.getElementById('ct_email').textContent = m.email||'';

        const ctb = document.getElementById('ct_currentTypeBadge');
        if (m.account?.accountType) {
            ctb.style.cssText = 'background:#6366f1;color:white;';
            ctb.textContent   = `Current: ${m.account.accountType.name} (${m.account.accountType.shortCode})`;
        } else {
            ctb.style.cssText = 'background:#6b7280;color:white;';
            ctb.textContent   = 'No type assigned yet';
        }

        // Reset select + mark current type as disabled
        const sel = document.getElementById('ct_memberTypeId');
        sel.value = '';
        Array.from(sel.options).forEach(opt => {
            if (!opt.value) return;
            const isCurrent = m.account?.accountType && opt.value === m.account.accountType.id;
            opt.disabled    = isCurrent;
            // Clean old label suffix before adding fresh one
            opt.textContent = opt.textContent.replace(/\s*✓ \(current\)$/, '');
            if (isCurrent) opt.textContent += ' ✓ (current)';
        });

        // Close view modal first if open
        const vi = bootstrap.Modal.getInstance(document.getElementById('viewMemberModal'));
        if (vi) { vi.hide(); document.getElementById('viewMemberModal').addEventListener('hidden.bs.modal', function once(){ this.removeEventListener('hidden.bs.modal',once); openModal('changeTypeModal'); }); }
        else openModal('changeTypeModal');
    }

    async function confirmChangeType() {
        const memberTypeId = document.getElementById('ct_memberTypeId').value;
        if (!memberTypeId) { await showNotify({type:'warning',title:'Select a Type',message:'Please select a membership type to switch to.'}); return; }

        const modalEl = document.getElementById('changeTypeModal');
        const result  = await permFetch(`/admin/members/change-type/${currentMemberId}`, {
            method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({memberTypeId})
        }, modalEl);
        if (!result.ok) return;

        if (result.data?.status) {
            const idx = members.findIndex(m=>m.id===currentMemberId);
            if (idx !== -1) {
                const m = members[idx];
                const typeObj = memberTypes.find(t=>t.id===memberTypeId);
                if (typeObj) {
                    m.type     = typeObj.shortCode;
                    m.memberID = result.data.newMembershipID;
                    if (!m.account) m.account = {};
                    m.account.accountType = {id:typeObj.id, name:typeObj.name, shortCode:typeObj.shortCode, interestRate:typeObj.interestRate};
                }
            }
            updateStats(); renderMembers();
            bootstrap.Modal.getInstance(modalEl).hide();
            await showNotify({type:'success',title:'Type Changed',message:`Membership type updated!\n\nNew Type: ${result.data.newMemberTypeName}\nNew Membership ID: ${result.data.newMembershipID}`});
        } else {
            await showNotify({type:'error',title:'Change Failed',message:result.data?.message||'An error occurred.'});
        }
    }

    /* ═══════════════════════════════════════════════════
       DELETE MEMBER
    ═══════════════════════════════════════════════════ */
    function deleteMember(id) { currentMemberId=id; openModal('deleteConfirmModal'); }
    async function confirmDelete() {
        const modalEl = document.getElementById('deleteConfirmModal');
        const result  = await permFetch(`/members/delete/${currentMemberId}`,{method:'POST'},modalEl);
        if (!result.ok) return;
        if (result.data.status) { members=members.filter(m=>m.id!==currentMemberId); updateStats(); renderMembers(); bootstrap.Modal.getInstance(modalEl).hide(); await showNotify({type:'success',title:'Member Deleted',message:'The member has been successfully deleted.'}); }
        else { await showNotify({type:'error',title:'Delete Failed',message:result.data.message||'Failed to delete member.'}); }
    }

    /* ═══════════════════════════════════════════════════
       APPROVE MEMBER
    ═══════════════════════════════════════════════════ */
    function showApprovalModal(id) {
        currentMemberId=id; const m=members.find(m=>m.id==id); if(!m) return;
        document.getElementById('approvalMemberName').textContent  = `${m.firstName} ${m.lastName}`;
        document.getElementById('approvalMemberEmail').textContent = m.email;
        document.getElementById('approvalMemberPhone').textContent = m.phone;
        document.getElementById('approvalRegStatus').textContent   = m.registrationStatus;
        document.getElementById('approvalMemberType').value        = '';
        openModal('approveMemberModal');
    }
    async function confirmApproval() {
        const memberTypeId = document.getElementById('approvalMemberType').value;
        if (!memberTypeId) { await showNotify({type:'warning',title:'Missing Information',message:'Please select a membership type before approving this member.'}); return; }
        const modalEl = document.getElementById('approveMemberModal');
        const result  = await permFetch(`/admin/members/approve/${currentMemberId}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({memberTypeId})},modalEl);
        if (!result.ok) return;
        if (!result.data?.error) {
            bootstrap.Modal.getInstance(modalEl).hide();
            await showNotify({type:'success',title:'Member Approved',message:`Member approved successfully!\n\nMembership Type: ${result.data.memberTypeName}\nMember ID: ${result.data.membershipID}\nEmail sent to: ${result.data.email}`});
            location.reload();
        } else { await showNotify({type:'error',title:'Approval Failed',message:result.data.message||'An error occurred during approval.'}); }
    }
    function approveMember(id) { showApprovalModal(id); }

    /* ═══════════════════════════════════════════════════
       REJECT MEMBER
    ═══════════════════════════════════════════════════ */
    async function rejectMember(id) {
        const confirmed = await showNotify({type:'warning',title:'Confirm Rejection',message:'Are you sure you want to reject and delete this member? This action cannot be undone.',confirmLabel:'Yes, Reject',cancelLabel:'Cancel'});
        if (!confirmed) return;
        const result = await permFetch(`/admin/members/delete/${id}`,{method:'POST',headers:{'Content-Type':'application/json'}});
        if (!result.ok) return;
        if (result.data.status) { const i=members.findIndex(m=>m.id===id); if(i!==-1){members.splice(i,1);updateStats();renderMembers();} await showNotify({type:'success',title:'Member Rejected',message:'The member has been successfully removed.'}); }
        else { await showNotify({type:'error',title:'Rejection Failed',message:`Failed to reject: ${result.data.message}`}); }
    }

    /* ═══════════════════════════════════════════════════
       BULK ACTIONS
    ═══════════════════════════════════════════════════ */
    async function bulkApprove() {
        if (!selectedMembers.length) { await showNotify({type:'warning',title:'No Selection',message:'Please select at least one member.'}); return; }
        const ok = await showNotify({type:'info',title:'Approve Members',message:`Approve ${selectedMembers.length} member(s)?`,confirmLabel:'Yes, Approve',cancelLabel:'Cancel'});
        if (!ok) return;
        for (const id of selectedMembers) { const r=await permFetch(`/admin/members/approve/${id}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({})}); if(!r.ok) return; }
        selectedMembers.forEach(id=>{const m=members.find(m=>m.id==id);if(m)m.status='active';}); updateStats(); renderMembers();
        await showNotify({type:'success',title:'Members Approved',message:`${selectedMembers.length} member(s) approved.`});
    }
    async function bulkChangeType() { if(!selectedMembers.length){await showNotify({type:'warning',title:'No Selection',message:'Please select at least one member.'});return;} await showNotify({type:'info',title:'Coming Soon',message:'Bulk member type change feature coming soon.'}); }
    async function bulkDelete() {
        if (!selectedMembers.length) { await showNotify({type:'warning',title:'No Selection',message:'Please select at least one member.'}); return; }
        const ok = await showNotify({type:'warning',title:'Delete Members',message:`Delete ${selectedMembers.length} member(s)? This cannot be undone.`,confirmLabel:'Yes, Delete All',cancelLabel:'Cancel'});
        if (!ok) return;
        for (const id of selectedMembers) { const r=await permFetch(`/members/delete/${id}`,{method:'POST'}); if(!r.ok) return; }
        members=members.filter(m=>!selectedMembers.includes(m.id)); selectedMembers=[];
        updateStats(); renderMembers(); await showNotify({type:'success',title:'Members Deleted',message:'Selected members have been permanently deleted.'});
    }

    /* ═══════════════════════════════════════════════════
       SIDEBAR
    ═══════════════════════════════════════════════════ */
    function toggleSidebar() { if(window.innerWidth<=992){document.getElementById('sidebar').classList.toggle('active');document.getElementById('sidebarOverlay').classList.toggle('active');} }
    function closeSidebar() { document.getElementById('sidebar').classList.remove('active'); document.getElementById('sidebarOverlay').classList.remove('active'); }

    </script>
    <script>
    async function loadSidebarPendingCount() {
        try {
            const res=await fetch('/admin/pending-approvals-count'); const data=await res.json();
            const badge=document.getElementById('sidebarPendingBadge'); if(!badge) return;
            badge.style.display=data.count>0?'inline-block':'none'; if(data.count>0) badge.textContent=data.count;
        } catch(err){ console.error('Sidebar count error:',err); }
    }
    document.addEventListener('DOMContentLoaded',loadSidebarPendingCount);
    </script>
</body>
</html>
