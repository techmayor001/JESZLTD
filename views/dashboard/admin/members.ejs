                                <button class="btn btn-sm fw-semibold text-white" id="changeTypeBtnView"
                                    style="background:linear-gradient(135deg,#312e81 0%,#6366f1 100%);border:none;">
                                    <i class="fas fa-exchange-alt me-2"></i>Change Member Type
                                </button>
                                <button class="btn btn-danger btn-sm" id="deleteMemberBtn"><i class="fas fa-trash me-2"></i>Delete Member</button>
                            </div>
                        </div>
                        <div class="col-lg-8">
                            <h6 class="fw-bold mb-3 section-title">Personal Information</h6>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6"><small class="text-muted">Email</small><br><strong id="view_email"></strong></div>
                                <div class="col-md-6"><small class="text-muted">Phone</small><br><strong id="view_phone"></strong></div>
                                <div class="col-md-6"><small class="text-muted">Date of Birth</small><br><strong id="view_dob"></strong></div>
                                <div class="col-md-6"><small class="text-muted">State / LGA</small><br><strong id="view_state_lga"></strong></div>
                                <div class="col-12"><small class="text-muted">Address</small><br><strong id="view_address"></strong></div>
                            </div>
                            <h6 class="fw-bold mb-3 section-title">Bank Details</h6>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6"><small class="text-muted">Bank Name</small><br><strong id="view_bankName"></strong></div>
                                <div class="col-md-6"><small class="text-muted">Account Number</small><br><strong id="view_accountNumber"></strong></div>
                                <div class="col-md-12"><small class="text-muted">Account Name</small><br><strong id="view_accountName"></strong></div>
                            </div>
                            <h6 class="fw-bold mb-3 section-title">KYC Documents</h6>
                            <div id="view_documents" class="doc-grid mb-4"></div>
