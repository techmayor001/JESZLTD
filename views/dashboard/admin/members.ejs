<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Membership Management | Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary:       #1e3a8a;
            --primary-dark:  #1e40af;
            --primary-light: #3b82f6;
            --success:       #10b981;
            --danger:        #ef4444;
            --warning:       #f59e0b;
            --sidebar-width: 280px;
            --navbar-h:      70px;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
            min-height: 100vh; overflow-x: hidden;
        }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f2357 0%, #1e3a8a 40%, #1e40af 100%);
            z-index: 1040; overflow-y: auto;
            transition: transform .3s ease;
            box-shadow: 4px 0 24px rgba(30,58,138,.25);
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.15) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }

        .sidebar-header {
            padding: 1.4rem 1.25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.18);
            position: sticky; top: 0; z-index: 2;
        }
        .logo-row { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
        .logo-box {
            width: 42px; height: 42px; background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary); font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(0,0,0,.25); flex-shrink: 0;
        }
        .sidebar-brand { font-size: .95rem; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .05em; line-height: 1.2; }
        .sidebar-brand small { font-size: .65rem; font-weight: 500; opacity: .55; display: block; letter-spacing: .08em; }
        .role-pill {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 4px 10px; background: rgba(239,68,68,.2);
            border-radius: 20px; border: 1px solid rgba(239,68,68,.3);
            font-weight: 700; font-size: .7rem; color: #fca5a5;
        }

        /* ── Category groups ── */
        .nav-group { padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.06); }
        .nav-group:last-child { border-bottom: none; }

        .nav-category {
            display: flex; align-items: center; gap: 7px;
            padding: .55rem 1.25rem .3rem;
            font-size: .62rem; font-weight: 800;
            color: rgba(255,255,255,.38);
            text-transform: uppercase; letter-spacing: .1em;
            user-select: none;
        }
        .nav-category::after {
            content: '';
            flex: 1; height: 1px;
            background: rgba(255,255,255,.08);
            margin-left: 4px;
        }

        /* ── Nav links ── */
        .sidebar-nav a {
            display: flex; align-items: center; gap: 11px;
            padding: .62rem 1.25rem; color: rgba(255,255,255,.72);
            text-decoration: none; font-weight: 500; font-size: .84rem;
            border-left: 3px solid transparent;
            transition: all .18s; position: relative;
        }
        .sidebar-nav a:hover  { background: rgba(255,255,255,.09); color: white; border-left-color: rgba(255,255,255,.4); }
        .sidebar-nav a.active { background: rgba(255,255,255,.15); color: white; border-left-color: white; }
        .sidebar-nav a i { width: 18px; font-size: .9rem; flex-shrink: 0; opacity: .8; text-align: center; }
        .sidebar-nav a.active i { opacity: 1; }

        .nav-badge {
            margin-left: auto;
            font-size: .63rem; font-weight: 800;
            padding: 2px 7px; border-radius: 10px;
            background: rgba(239,68,68,.9); color: white;
            flex-shrink: 0; line-height: 1.4;
        }

        .nav-back {
            display: flex; align-items: center; gap: 10px;
            padding: .7rem 1.25rem .9rem;
            font-size: .8rem; font-weight: 600;
            color: rgba(255,255,255,.42);
            text-decoration: none;
            transition: color .18s;
            border-top: 1px solid rgba(255,255,255,.07);
            margin-top: .25rem;
        }
        .nav-back:hover { color: rgba(255,255,255,.7); }
        .nav-back i { font-size: .8rem; }

        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1035; }
        .sidebar-overlay.active { display: block; }

        /* ══════════ TOP NAVBAR ══════════ */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: var(--navbar-h);
            background: rgba(255,255,255,.97); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem; gap: 1rem;
            transition: left .3s ease; border-bottom: 1px solid rgba(30,58,138,.1);
        }
        .main-content {
            margin-left: var(--sidebar-width); margin-top: var(--navbar-h); padding: 1.5rem;
            min-height: calc(100vh - var(--navbar-h)); transition: margin-left .3s ease;
        }
        .page-header {
            background: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,.08);
        }
        .stat-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,.08); transition: transform .3s, box-shadow .3s;
            height: 100%; border: 1px solid rgba(30,58,138,.05);
        }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(30,58,138,.15); }
        .stat-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 1rem; }
        .filter-section { background: white; border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 4px 15px rgba(30,58,138,.08); }
        .table-card { background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 20px rgba(30,58,138,.08); }
        .scroll-hint { display: none; align-items: center; gap: 6px; padding: .3rem 1rem; background: rgba(30,58,138,.04); font-size: .78rem; color: var(--primary); font-weight: 600; }
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: rgba(30,58,138,.2) transparent; }
        .table-responsive::-webkit-scrollbar { height: 4px; }
        .table-responsive::-webkit-scrollbar-thumb { background: rgba(30,58,138,.25); border-radius: 4px; }
        .table { margin-bottom: 0; font-size: .9rem; min-width: 820px; width: 100%; }
        .table thead { background: linear-gradient(135deg, rgba(30,58,138,.05) 0%, rgba(59,130,246,.05) 100%); }
        .table thead th { border: none; padding: 1rem; font-weight: 600; color: var(--primary); white-space: nowrap; }
        .table tbody td { padding: 1rem; vertical-align: middle; }
        .table tbody tr:hover { background: rgba(59,130,246,.03); }
        .table tbody tr.kiddies-row { background: rgba(236,72,153,.02); }
        .table tbody tr.kiddies-row:hover { background: rgba(236,72,153,.05); }
        .badge { padding: .5rem .875rem; border-radius: 8px; font-weight: 600; font-size: .75rem; white-space: nowrap; }
        .member-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(30,58,138,.1); flex-shrink: 0; }
        .kiddies-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg,#ec4899,#db2777); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: .85rem; flex-shrink: 0; }
        .action-btn { padding: .4rem .75rem; border-radius: 8px; font-size: .85rem; border: none; transition: all .3s; }
        .btn-group { display: flex; flex-wrap: nowrap; gap: 3px; }
        .btn-primary { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); border: none; border-radius: 10px; padding: .6rem 1.5rem; font-weight: 600; transition: all .3s; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(30,58,138,.3); }
        .btn-outline-primary { border: 2px solid var(--primary); color: var(--primary); background: transparent; font-weight: 600; transition: all .3s; border-radius: 10px; }
        .btn-outline-primary:hover { background: var(--primary); color: white; transform: translateY(-2px); }
        .btn-sm { padding: .4rem 1rem; font-size: .85rem; border-radius: 8px; }
        .search-box { position: relative; }
        .search-box input { padding-left: 2.5rem; border-radius: 10px; border: 2px solid rgba(30,58,138,.1); }
        .search-box i { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--primary); }
        .form-label { font-weight: 600; color: var(--primary); margin-bottom: .5rem; }
        .form-control, .form-select { border-radius: 10px; border: 2px solid rgba(30,58,138,.1); padding: .65rem 1rem; }
        .form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 .2rem rgba(30,58,138,.1); }
        .card { border: none; border-radius: 16px; box-shadow: 0 8px 20px rgba(30,58,138,.08); background: white; border: 1px solid rgba(30,58,138,.05); }
        .card-header { background: linear-gradient(135deg, rgba(30,58,138,.03) 0%, rgba(59,130,246,.03) 100%); border-bottom: 2px solid rgba(30,58,138,.1); padding: 1.25rem; border-radius: 16px 16px 0 0 !important; }
        .modal-content { border-radius: 16px; border: none; }
        .modal-header { border-radius: 16px 16px 0 0; background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white; border: none; }
        .modal-header .btn-close { filter: invert(1); }
        .page-link { color: var(--primary); border-radius: 8px; margin: 0 .25rem; border: 2px solid rgba(30,58,138,.1); }
        .page-link:hover { background: var(--primary); color: white; border-color: var(--primary); }
        .page-item.active .page-link { background: var(--primary); border-color: var(--primary); }
        .doc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 20px; }
        .document-preview { width: 100%; height: 120px; object-fit: cover; border-radius: 10px; cursor: pointer; transition: .3s; }
        .document-preview:hover { transform: scale(1.05); }
        .section-title { color: var(--primary); }
        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,.15); font-size: .8rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        /* FINANCIAL SNAPSHOT */
        .fin-snap { display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem; margin-bottom: 1.25rem; }
        .fin-snap-tile { padding: .875rem 1rem; border-radius: 12px; text-align: center; }
        .fin-snap-tile .fst-label { font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .2rem; }
        .fin-snap-tile .fst-value { font-size: 1.05rem; font-weight: 900; }

        /* KIDDIES INFO BANNER */
        .kiddies-info-banner {
            background: rgba(236,72,153,.06); border: 1px solid rgba(236,72,153,.2);
            border-radius: 12px; padding: 1rem; margin-bottom: 1rem;
        }
        .kiddies-info-banner .kb-title {
            font-size: .7rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: .07em; color: #db2777; margin-bottom: .6rem;
        }

        /* NOTIFY */
        #notifyModal .modal-content { border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,.18); }
        #notifyModal .modal-body { padding: 2rem; text-align: center; }
        .notify-icon-wrap { width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 2.2rem; animation: notifyPop .4s cubic-bezier(.34,1.56,.64,1) both; }
        @keyframes notifyPop { from{transform:scale(.4);opacity:0;}to{transform:scale(1);opacity:1;} }
        .notify-icon-wrap.success { background: linear-gradient(135deg,#d1fae5,#6ee7b7); color:#059669; }
        .notify-icon-wrap.error   { background: linear-gradient(135deg,#fee2e2,#fca5a5); color:#dc2626; }
        .notify-icon-wrap.warning { background: linear-gradient(135deg,#fef3c7,#fcd34d); color:#d97706; }
        .notify-icon-wrap.info    { background: linear-gradient(135deg,#dbeafe,#93c5fd); color:#2563eb; }
        .notify-title { font-size: 1.25rem; font-weight: 700; margin-bottom: .5rem; }
        .notify-title.success{color:#065f46;} .notify-title.error{color:#7f1d1d;} .notify-title.warning{color:#78350f;} .notify-title.info{color:#1e3a8a;}
        .notify-message { color:#475569; font-size:.95rem; line-height:1.6; margin-bottom:1.5rem; white-space:pre-line; }
        .notify-footer { display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap; }
        .notify-btn-ok { padding:.6rem 2rem; border-radius:10px; border:none; font-weight:600; font-size:.95rem; cursor:pointer; transition:all .25s; color:white; }
        .notify-btn-ok.success{background:linear-gradient(135deg,#10b981,#059669);}
        .notify-btn-ok.error  {background:linear-gradient(135deg,#ef4444,#dc2626);}
        .notify-btn-ok.warning{background:linear-gradient(135deg,#f59e0b,#d97706);}
        .notify-btn-ok.info   {background:linear-gradient(135deg,#1e3a8a,#3b82f6);}
        .notify-btn-ok:hover  {transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.18);}
        .notify-btn-cancel { padding:.6rem 1.5rem; border-radius:10px; border:2px solid #e2e8f0; background:white; color:#64748b; font-weight:600; font-size:.95rem; cursor:pointer; transition:all .25s; }
        .notify-btn-cancel:hover { background:#f1f5f9; border-color:#cbd5e1; }
        #unauthorizedModal .modal-header { background: linear-gradient(135deg,#7f1d1d 0%,#ef4444 100%); }
        .edit-section-header {
            background: linear-gradient(135deg, rgba(30,58,138,.05) 0%, rgba(59,130,246,.05) 100%);
            border-left: 4px solid var(--primary); border-radius: 0 8px 8px 0;
            padding: .6rem 1rem; margin-bottom: 1rem; font-size: .9rem;
        }
        .file-current-preview {
            display: flex; align-items: center; gap: 10px; padding: 8px 12px;
            background: rgba(30,58,138,.04); border-radius: 8px; margin-bottom: 8px;
            font-size: .82rem; color: #475569; min-height: 44px;
        }
        .file-current-preview img { width: 36px; height: 36px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(30,58,138,.15); cursor: pointer; flex-shrink: 0; }
        .dot-green  { width: 8px; height: 8px; border-radius: 50%; background: #10b981; flex-shrink: 0; }
        .dot-gray   { width: 8px; height: 8px; border-radius: 50%; background: #9ca3af; flex-shrink: 0; }
        #changeTypeModal .modal-header { background: linear-gradient(135deg, #312e81 0%, #6366f1 100%); }
        .ct-summary { display:flex; align-items:center; gap:14px; padding:14px 16px; background:linear-gradient(135deg,rgba(99,102,241,.07),rgba(59,130,246,.07)); border:1.5px solid rgba(99,102,241,.18); border-radius:12px; margin-bottom:1.25rem; }
        .ct-summary img { width:52px; height:52px; border-radius:50%; object-fit:cover; border:2px solid rgba(99,102,241,.3); flex-shrink:0; }

        @media(max-width:992px){.sidebar{transform:translateX(-100%);}.sidebar.active{transform:translateX(0);}.top-navbar{left:0!important;}.main-content{margin-left:0!important;padding:1rem;}.scroll-hint{display:flex;}}
        @media(max-width:768px){.page-header{padding:1.25rem;}.stats-row>[class*="col-"]{flex:0 0 50%;max-width:50%;}.stat-card{display:flex;flex-direction:row;align-items:center;gap:1rem;padding:1rem 1.1rem;}.stat-icon{margin-bottom:0;width:48px;height:48px;font-size:1.25rem;border-radius:12px;}}
        @media(max-width:576px){:root{--navbar-h:60px;}.top-navbar{height:60px;padding:0 1rem;}.main-content{padding:0.75rem;}.page-header{padding:1rem;border-radius:14px;margin-bottom:1rem;}.stats-row>[class*="col-"]{flex:0 0 50%;max-width:50%;}.stat-card{gap:.65rem;padding:.85rem .9rem;border-radius:12px;}.stat-card h3{font-size:1.5rem;}.stat-icon{width:42px;height:42px;font-size:1.25rem;border-radius:10px;}.filter-section{padding:.875rem;border-radius:12px;}.filter-section [class*="col-"]{flex:0 0 100%;max-width:100%;}.table-card{border-radius:14px;}.table thead th{padding:.75rem .6rem;}.table tbody td{padding:.75rem .6rem;}.pagination-wrap{flex-direction:column;align-items:flex-start!important;gap:.5rem!important;}.modal-dialog{margin:.4rem;max-width:calc(100vw - .8rem);}.modal-body{padding:1rem;}.modal-footer{padding:.75rem 1rem;}.notify-footer{flex-direction:column-reverse;}.notify-btn-ok,.notify-btn-cancel{width:100%;}.doc-grid{grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:.75rem;}.document-preview{height:90px;}.fin-snap{grid-template-columns:1fr 1fr;}}
    </style>
</head>
<body>

    <!-- ════════════════════════ SIDEBAR ════════════════════════ -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-row">
                <div class="logo-box">C</div>
                <div>
                    <div class="sidebar-brand">Club De Stars<small>Admin Panel</small></div>
                </div>
            </div>
            <div class="role-pill"><i class="fas fa-shield-alt" style="font-size:.65rem;"></i>&nbsp;Super Admin</div>
        </div>

        <div class="sidebar-nav">
        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-home" style="font-size:.6rem;"></i>Main</div>
            <a href="/admin/dashboard"><i class="fas fa-chart-pie"></i>Overview</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-users" style="font-size:.6rem;"></i>Members</div>
            <a href="/admin/manage-members" class="active"><i class="fas fa-users"></i>Manage Members</a>
            <a href="/admin/kiddies-accounts"><i class="fas fa-baby"></i>Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i>Membership Types</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-exchange-alt" style="font-size:.6rem;"></i>Transactions</div>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i>Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i>Approvals<span id="sidebarPendingBadge" class="nav-badge" style="display:none;">0</span></a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i>Deposits</a>
            <a href="/admin/kiddies-deposits"><i class="fas fa-piggy-bank"></i>Kiddies Deposits</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i>Withdrawals</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-hand-holding-usd" style="font-size:.6rem;"></i>Loans</div>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i>Loan Management</a>
            <a href="/admin/loan-payments"><i class="fas fa-file-invoice-dollar"></i>Loan Payments</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i>Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i>External Loans</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-landmark" style="font-size:.6rem;"></i>Finance</div>
            <a href="/admin/finance"><i class="fas fa-landmark"></i>Company Finance</a>
            <a href="/admin/operating-earnings"><i class="fas fa-chart-line"></i>Operating Earnings</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-chart-bar"></i>Company Revenue</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-cog" style="font-size:.6rem;"></i>System</div>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i>Manage Subscriptions</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i>Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i>Settings</a>
        </div>

        <div class="nav-group">
            <div class="nav-category"><i class="fas fa-file-alt" style="font-size:.6rem;"></i>Reporting</div>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i>Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i>Admin Logs</a>
        </div>
    </div>

        <a href="/cds-cooperative/dashboard" class="nav-back"><i class="fas fa-arrow-left"></i>Back to Dashboard</a>
    </div>

    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;" onclick="toggleSidebar()"></i>
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color:var(--primary)">Member Management</h5>
            <small class="text-muted">Manage all cooperative members and their accounts</small>
        </div>
        <div class="d-lg-none"><span class="fw-bold" style="color:var(--primary);font-size:.95rem;">Club De Stars Admin</span></div>
    </div>

    <div id="sidebarOverlay" class="sidebar-overlay" onclick="closeSidebar()"></div>

    <div class="main-content">
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h3 class="mb-1 fw-bold" style="color:var(--primary);"><i class="fas fa-users me-2"></i>Member Management</h3>
                    <p class="text-muted mb-0">Manage all cooperative members and their accounts</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-download me-2"></i><span class="d-none d-sm-inline">Export</span>
                        </button>
