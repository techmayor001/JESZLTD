    async function rejectMember(id) {
        const confirmed = await showNotify({type:'warning',title:'Confirm Rejection',message:'Are you sure you want to reject this member?',confirmLabel:'Yes, Reject',cancelLabel:'Cancel'});
        if (!confirmed) return;
        const result = await permFetch(`/admin/members/reject/${id}`,{method:'POST',headers:{'Content-Type':'application/json'}});
        if (!result.ok) return;
        if (result.data.status) { const m=members.find(m=>m.id===id); if(m) m.status='rejected'; updateStats(); renderMembers(_currentFilteredMembers, currentPage); await showNotify({type:'success',title:'Member Rejected',message:'The member status has been set to rejected.'}); }
        else { await showNotify({type:'error',title:'Rejection Failed',message:result.data.message||'Failed to reject member.'}); }
