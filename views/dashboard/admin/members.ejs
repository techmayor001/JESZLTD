            const formData = new FormData(form);

            for (let pair of formData.entries()) {
                console.log(pair[0], pair[1]);
            }

            try {
                const response = await fetch("/add", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                if (result.status) {
                    alert("New member added successfully!");
                    bootstrap.Modal.getInstance(document.getElementById('addMemberModal')).hide();
                } else {
                    alert(result.message || "Failed to add member.");
                }
            } catch (error) {
                console.error("Error adding member:", error);
                alert("An error occurred while adding member.");
            }
        }


        // Bulk actions
        function bulkApprove() {
            if (selectedMembers.length === 0) {
                alert('Please select members first');
                return;
            }
            if (confirm(`Approve ${selectedMembers.length} members?`)) {
                selectedMembers.forEach(id => {
                    const member = members.find(m => m.id == id);
                    if (member) member.status = 'active';
                });
                updateStats();
                renderMembers();
                alert('Members approved successfully!');
            }
        }

        function bulkChangeType() {
            if (selectedMembers.length === 0) {
                alert('Please select members first');
                return;
            }
            // Show type selection modal
            alert('Bulk type change feature');
        }

        function bulkDelete() {
            if (selectedMembers.length === 0) {
                alert('Please select members first');
                return;
            }
            if (confirm(`Delete ${selectedMembers.length} members? This action cannot be undone.`)) {
                members = members.filter(m => !selectedMembers.includes(m.id));
                selectedMembers = [];
                updateStats();
                renderMembers();
                alert('Members deleted successfully!');
            }
        }


        // Make table mobile-friendly with horizontal scroll indicator
        const tableContainer = document.querySelector('.table-responsive');
        if (tableContainer) {
            tableContainer.addEventListener('scroll', function() {
                const scrollLeft = this.scrollLeft;
                const scrollWidth = this.scrollWidth;
                const clientWidth = this.clientWidth;
                
                if (scrollLeft + clientWidth >= scrollWidth - 10) {
                    this.classList.add('scrolled-end');
                } else {
                    this.classList.remove('scrolled-end');
                }
            });
        }
    </script>

    <script>
function toggleSidebar() {
    if (window.innerWidth <= 992) {
        document.getElementById("sidebar").classList.toggle("active");
        document.getElementById("sidebarOverlay").classList.toggle("active");
    }
}

function closeSidebar() {
    document.getElementById("sidebar").classList.remove("active");
    document.getElementById("sidebarOverlay").classList.remove("active");
}
</script>

