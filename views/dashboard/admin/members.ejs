    function normPath(p) {
        if (!p) return null;
        // R2 / any full URL — use as-is
        if (p.startsWith('http')) return p;
        // Legacy disk path — treat as broken, return null
        return null;
    }    
    function renderFilePreview(wrapId, filePath, label) {
        const wrap = document.getElementById(wrapId); if(!wrap) return;
        const src = normPath(filePath);
        if (src) {
            const isImg = /\.(jpg|jpeg|png|gif|webp|bmp)$/i.test(src);
            wrap.innerHTML = `<span class="dot-green"></span>${isImg?`<img src="${src}" alt="${label}" title="Click to preview" onclick="viewDocument('${src}','${label}')">`:`<i class="fas fa-file-alt text-primary" style="font-size:1.4rem;flex-shrink:0;"></i>`}<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><strong style="color:#065f46;font-size:.82rem;">File exists</strong><a href="${src}" target="_blank" class="text-primary text-decoration-none small ms-1">view</a></span>`;
        } else { wrap.innerHTML = `<span class="dot-gray"></span><span class="text-muted fst-italic small">No file uploaded</span>`; }
    }
    const fmt = n => '₦' + Number(n||0).toLocaleString('en-NG', {minimumFractionDigits:2, maximumFractionDigits:2});

