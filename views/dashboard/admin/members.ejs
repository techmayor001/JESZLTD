    function openChangeTypeModal(id) {
        currentMemberId = id;
        const m = members.find(m=>m.id==id); if(!m) return;
        if (m.entityType==='kiddies') { showNotify({type:'info',title:'Not Applicable',message:'Member type cannot be changed for kiddies accounts.'}); return; }
        const avatar = m.displayPicture||m.passportPhoto||`https://ui-avatars.com/api/?name=${encodeURIComponent(m.firstName+' '+m.lastName)}&background=312e81&color=fff&size=80`;
        document.getElementById('ct_avatar').src        = avatar;
        document.getElementById('ct_name').textContent  = `${m.firstName} ${m.lastName}`;
        document.getElementById('ct_email').textContent = m.email||'';
        const ctb = document.getElementById('ct_currentTypeBadge');
        if (m.account?.accountType) { ctb.style.cssText='background:#6366f1;color:white;'; ctb.textContent=`Current: ${m.account.accountType.name} (${m.account.accountType.shortCode})`; }
        else { ctb.style.cssText='background:#6b7280;color:white;'; ctb.textContent='No type assigned yet'; }
        const sel = document.getElementById('ct_memberTypeId'); sel.value='';
        Array.from(sel.options).forEach(opt=>{ if(!opt.value) return; const isCurrent=m.account?.accountType&&opt.value===m.account.accountType.id; opt.disabled=isCurrent; opt.textContent=opt.textContent.replace(/\s*✓ \(current\)$/,''); if(isCurrent) opt.textContent+=' ✓ (current)'; });
        const vi = bootstrap.Modal.getInstance(document.getElementById('viewMemberModal'));
        if (vi) { vi.hide(); document.getElementById('viewMemberModal').addEventListener('hidden.bs.modal', function once(){ this.removeEventListener('hidden.bs.modal',once); openModal('changeTypeModal'); }); }
        else openModal('changeTypeModal');
    }

    async function confirmChangeType() {
        const memberTypeId = document.getElementById('ct_memberTypeId').value;
        if (!memberTypeId) { await showNotify({type:'warning',title:'Select a Type',message:'Please select a membership type to switch to.'}); return; }
        const modalEl = document.getElementById('changeTypeModal');
        const result = await permFetch(`/admin/members/change-type/${currentMemberId}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({memberTypeId})},modalEl);
        if (!result.ok) return;
        if (result.data?.status) {
            const idx = members.findIndex(m=>m.id===currentMemberId);
            if (idx !== -1) { const m=members[idx]; const typeObj=memberTypes.find(t=>t.id===memberTypeId); if(typeObj){m.type=typeObj.shortCode;m.memberID=result.data.newMembershipID;if(!m.account)m.account={};m.account.accountType={id:typeObj.id,name:typeObj.name,shortCode:typeObj.shortCode,interestRate:typeObj.interestRate};} }
            updateStats(); renderMembers(_currentFilteredMembers, currentPage);
            bootstrap.Modal.getInstance(modalEl).hide();
            await showNotify({type:'success',title:'Type Changed',message:`Membership type updated!\n\nNew Type: ${result.data.newMemberTypeName}\nNew Membership ID: ${result.data.newMembershipID}`});
        } else { await showNotify({type:'error',title:'Change Failed',message:result.data?.message||'An error occurred.'}); }
    }

