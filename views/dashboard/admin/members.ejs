                            <div class="col-md-6"><label class="form-label">Member Type</label><select name="memberTypeId" class="form-select" required><option value="">Select type...</option><% memberTypes.forEach(type => { %><option value="<%= type.id %>"><%= type.name %> (<%= type.shortCode %>) - <%= type.interestRate %>% ROI</option><% }) %></select></div>
                            <div class="col-md-6"><label class="form-label">State</label><input type="text" name="state" class="form-control" required></div>
