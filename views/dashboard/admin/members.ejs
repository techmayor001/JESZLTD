            document.getElementById('approvalMemberEmail').textContent = member.email;
            document.getElementById('approvalMemberPhone').textContent = member.phone;
            document.getElementById('approvalRegStatus').textContent = member.registrationStatus;
            document.getElementById('approvalMemberType').value = '';

            openModal('approveMemberModal');
        }

async function confirmApproval() {
    const memberTypeId = document.getElementById('approvalMemberType').value;

    if (!memberTypeId) {
        alert("❌ Please select a membership type before approving!");
        return;
    }

    if (!currentMemberId) {
        alert("❌ No member selected!");
        return;
    }

    // Make Request to Backend
    try {
        const response = await fetch(`/admin/members/approve/${currentMemberId}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ memberTypeId })
        });

        const result = await response.json();

        if (!response.ok) {
            alert(`❌ Error: ${result.message}`);
            return;
        }

        // Close Modal
        bootstrap.Modal.getInstance(
            document.getElementById("approveMemberModal")
        ).hide();

        // Success Message
        alert(`✅ Member approved successfully!
Membership Type: ${result.memberTypeName}
Member ID: ${result.membershipID}
Email notification sent to: ${result.email}`);

        // Reload page to update UI
        location.reload();

    } catch (err) {
        console.error("Approval error:", err);
        alert("❌ Server error approving member");
    }
}


