            margin-top: 0.5rem;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem;
            background: #f8f9fa;
            border-radius: 8px;
            margin-bottom: 0.5rem;
        }

        .feature-item span {
            flex: 1;
        }

        .feature-item button {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }

/* ---------- DESKTOP DEFAULTS ---------- */
#sidebar {
    transform: translateX(0); /* Always visible on desktop */
}

/* Overlay hidden on desktop */
.sidebar-overlay {
    display: none;
}

/* ---------- MOBILE BEHAVIOR ---------- */
@media (max-width: 992px) {

    /* Sidebar hidden by default on mobile */
    #sidebar {
        transform: translateX(-100%);
        position: fixed;
        z-index: 1040;
        height: 100vh;
    }

    /* Sidebar open state */
    #sidebar.active {
        transform: translateX(0);
    }

    /* Overlay only on mobile */
    .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background: rgba(0,0,0,0.4);
        z-index: 1035;
    }

    .sidebar-overlay.active {
        display: block;
    }

    /* Navbar moves to full width on mobile */
    .top-navbar {
        left: 0 !important;
    }

    /* Main content shifts */
    .main-content {
        margin-left: 0 !important;
    }
}
.section-title {
    color: var(--primary);
}

.doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 20px;
}

.document-preview {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 10px;
    cursor: pointer;
    transition: 0.3s;
}

.document-preview:hover {
    transform: scale(1.05);
}

