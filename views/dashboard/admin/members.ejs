            flex-shrink: 0;
        }
        
        .sidebar-title {
            font-size: 1.1rem;
            line-height: 1.2;
        }
        
        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: rgba(239, 68, 68, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(239, 68, 68, 0.3);
            font-weight: 600;
            font-size: 0.8rem;
            margin-top: 8px;
        }
        
        .sidebar-menu {
            padding: 1rem 0;
        }
        
        .sidebar-menu a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
