    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentDepositId = null;
        const deposits = <%- JSON.stringify(deposits) %>;

        document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', {
            weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
        });

        // ── Modal Helpers ──
        function switchModal(fromId, toFn) {
            const fromEl = document.getElementById(fromId);
            const instance = bootstrap.Modal.getInstance(fromEl);
            if (instance) {
                fromEl.addEventListener('hidden.bs.modal', function handler() {
                    fromEl.removeEventListener('hidden.bs.modal', handler);
                    toFn();
                });
                instance.hide();
            } else {
                toFn();
            }
        }

        function showAlert(message, type = 'info', title = null) {
            const config = {
                success: { headerBg:'bg-success', iconBg:'rgba(16,185,129,0.12)', iconColor:'#10b981', iconClass:'fas fa-check-circle',    btnClass:'btn-success', defaultTitle:'Success'     },
                danger:  { headerBg:'bg-danger',  iconBg:'rgba(239,68,68,0.12)',  iconColor:'#ef4444', iconClass:'fas fa-times-circle',    btnClass:'btn-danger',  defaultTitle:'Error'       },
                warning: { headerBg:'bg-warning', iconBg:'rgba(245,158,11,0.12)', iconColor:'#f59e0b', iconClass:'fas fa-exclamation-triangle', btnClass:'btn-warning', defaultTitle:'Warning' },
                info:    { headerBg:'bg-primary', iconBg:'rgba(139,92,246,0.12)', iconColor:'#8b5cf6', iconClass:'fas fa-info-circle',      btnClass:'btn-primary', defaultTitle:'Information' }
            };
            const c = config[type] || config.info;
            document.getElementById('alertModalHeader').className = `modal-header ${c.headerBg} text-white border-0`;
            document.getElementById('alertModalCloseBtn').className = 'btn-close btn-close-white';
            document.getElementById('alertModalLabel').textContent = title || c.defaultTitle;
            const iconWrapper = document.getElementById('alertModalIconWrapper');
            iconWrapper.style.background = c.iconBg;
            const icon = document.getElementById('alertModalIcon');
            icon.className = `${c.iconClass} fa-2x`;
            icon.style.color = c.iconColor;
            document.getElementById('alertModalMessage').textContent = message;
            const okBtn = document.getElementById('alertModalOkBtn');
            okBtn.className = `btn px-4 fw-semibold ${c.btnClass}`;
            const openModal = document.querySelector('.modal.show');
            if (openModal && openModal.id !== 'alertModal') {
                switchModal(openModal.id, () => new bootstrap.Modal(document.getElementById('alertModal')).show());
            } else {
                new bootstrap.Modal(document.getElementById('alertModal')).show();
            }
        }

        // ── Filter & Search ──
        function filterDeposits(status, event) {
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            if (event) event.target.classList.add('active');
            document.querySelectorAll('#depositsTableBody tr').forEach(row => {
                if (status === 'all') { row.style.display = ''; return; }
                row.style.display = row.getAttribute('data-status') === status ? '' : 'none';
            });
        }

        function searchDeposits() {
            const term = document.getElementById('searchDeposit').value.toLowerCase();
            document.querySelectorAll('#depositsTableBody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
            });
        }

        // ── View Details ──
        function viewDepositDetails(depositId) {
            const deposit = deposits.find(d => d.id === depositId);
            if (!deposit) return;
            currentDepositId = depositId;

            document.getElementById('detailReference').textContent   = deposit.reference;
            document.getElementById('detailDateTime').textContent     = `${deposit.date} at ${deposit.time}`;
            document.getElementById('detailPaymentType').textContent  = deposit.paymentType || 'Manual Deposit';
            document.getElementById('detailChildName').textContent    = deposit.childName;
            document.getElementById('detailAccountID').textContent    = deposit.accountID;
            document.getElementById('detailParentName').textContent   = deposit.parentName;
            document.getElementById('detailEmail').textContent        = deposit.parentEmail;
            document.getElementById('detailPayeeName').textContent    = deposit.payeeName || '—';
            document.getElementById('detailAmount').textContent       = `₦${deposit.amount.toLocaleString()}.00`;
            document.getElementById('detailCurrentBalance').textContent = `₦${deposit.currentBalance.toLocaleString()}`;
            document.getElementById('detailBalanceAfter').textContent  = `₦${(deposit.currentBalance + deposit.amount).toLocaleString()}`;

            const statusBadge = document.getElementById('detailStatus');
            statusBadge.className = `status-badge status-${deposit.status}`;
            statusBadge.textContent = deposit.status === 'success' ? 'Approved' : deposit.status.charAt(0).toUpperCase() + deposit.status.slice(1);

            const showActions = deposit.status === 'pending';
            document.getElementById('approveBtn').style.display = showActions ? 'inline-block' : 'none';
            document.getElementById('rejectBtn').style.display  = showActions ? 'inline-block' : 'none';

            new bootstrap.Modal(document.getElementById('depositDetailsModal')).show();
        }

        // ── Approve ──
        function approveDeposit(depositId) {
            currentDepositId = depositId;
            new bootstrap.Modal(document.getElementById('approvalModal')).show();
        }

        function approveFromModal() {
            switchModal('depositDetailsModal', () => {
                new bootstrap.Modal(document.getElementById('approvalModal')).show();
            });
        }

        async function confirmApproval() {
            const notes = document.getElementById('approvalNotes').value;
            try {
                const response = await fetch(`/admin/kiddies-deposits/${currentDepositId}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ notes })
                });
                const result = await response.json();
                if (!response.ok) {
                    showAlert(result.message || 'Approval failed', 'danger', 'Approval Failed');
                    return;
                }

                const deposit = deposits.find(d => d.id === currentDepositId);
                if (deposit) {
                    deposit.status = 'success';
                    deposit.currentBalance = result.newBalance;
                }

                updateTableRow(currentDepositId, 'success');
                document.getElementById('approvalNotes').value = '';
                document.getElementById('successMessage').textContent = 'Deposit Approved Successfully!';
                document.getElementById('generateReceiptBtn').style.display = 'inline-block';
                switchModal('approvalModal', () => new bootstrap.Modal(document.getElementById('successModal')).show());

            } catch (err) {
                console.error(err);
                showAlert('Network error while approving deposit. Please try again.', 'danger', 'Network Error');
            }
        }

        // ── Reject ──
        function rejectDeposit(depositId) {
            currentDepositId = depositId;
            new bootstrap.Modal(document.getElementById('rejectionModal')).show();
        }

        function rejectFromModal() {
            switchModal('depositDetailsModal', () => {
                new bootstrap.Modal(document.getElementById('rejectionModal')).show();
            });
        }

        async function confirmRejection() {
            const reason = document.getElementById('rejectionReason').value;
            if (!reason.trim()) {
                showAlert('Please provide a reason for rejection before proceeding.', 'warning', 'Reason Required');
                return;
            }
            try {
                const response = await fetch(`/admin/kiddies-deposits/${currentDepositId}/reject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason })
                });
                const result = await response.json();
                if (!response.ok) {
                    showAlert(result.message || 'Rejection failed', 'danger', 'Rejection Failed');
                    return;
                }

                const deposit = deposits.find(d => d.id === currentDepositId);
                if (deposit) deposit.status = 'failed';

                updateTableRow(currentDepositId, 'failed');
                document.getElementById('rejectionReason').value = '';
                document.getElementById('successMessage').textContent = 'Deposit Rejected Successfully';
                document.getElementById('generateReceiptBtn').style.display = 'none';
                switchModal('rejectionModal', () => new bootstrap.Modal(document.getElementById('successModal')).show());

            } catch (err) {
                console.error(err);
                showAlert('Network error while rejecting deposit. Please try again.', 'danger', 'Network Error');
            }
        }

        // ── Update Table Row ──
        function updateTableRow(depositId, status) {
            document.querySelectorAll('#depositsTableBody tr').forEach(row => {
                const viewBtn = row.querySelector(`button[onclick*="viewDepositDetails('${depositId}')"]`);
                if (!viewBtn) return;

                row.setAttribute('data-status', status);
                const statusCell = row.querySelector('[data-label="Status"]');
                if (statusCell) {
                    const label = status === 'success' ? 'Approved' : status.charAt(0).toUpperCase() + status.slice(1);
                    statusCell.innerHTML = `<span class="status-badge status-${status}">${label}</span>`;
                }
                const actionsCell = row.querySelector('[data-label="Actions"]');
                if (actionsCell) {
                    let btns = `<button class="action-btn btn-view" onclick="viewDepositDetails('${depositId}')"><i class="fas fa-eye"></i></button>`;
                    if (status === 'success') btns += `<button class="action-btn btn-view" onclick="printReceipt('${depositId}')"><i class="fas fa-print"></i></button>`;
                    actionsCell.innerHTML = `<div class="d-flex gap-2 flex-wrap">${btns}</div>`;
                }
            });
        }

        // ── Receipt ──
        function generateReceipt() {
            const deposit = deposits.find(d => d.id === currentDepositId);
            if (!deposit) return;

            document.getElementById('printReference').textContent   = deposit.reference;
            document.getElementById('printDateTime').textContent    = `${deposit.date} at ${deposit.time}`;
            document.getElementById('printPaymentType').textContent = deposit.paymentType || 'Manual Deposit';
            document.getElementById('printStatus').textContent      = 'Approved';
            document.getElementById('printChildName').textContent   = deposit.childName;
            document.getElementById('printAccountID').textContent   = deposit.accountID;
            document.getElementById('printParentName').textContent  = deposit.parentName;
            document.getElementById('printEmail').textContent       = deposit.parentEmail;
            document.getElementById('printPayeeName').textContent   = deposit.payeeName || '—';
            document.getElementById('printAmount').textContent      = `₦${deposit.amount.toLocaleString()}.00`;
            document.getElementById('printDepositAmount').textContent = `₦${deposit.amount.toLocaleString()}.00`;
            document.getElementById('printPrevBalance').textContent  = `₦${deposit.currentBalance.toLocaleString()}.00`;
            document.getElementById('printNewBalance').textContent   = `₦${(deposit.currentBalance + deposit.amount).toLocaleString()}.00`;
            document.getElementById('printGeneratedDate').textContent = new Date().toLocaleString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit'
            });

            const successModalEl = document.getElementById('successModal');
            const successInstance = bootstrap.Modal.getInstance(successModalEl);
            const doPrint = () => {
                const receipt = document.getElementById('printReceipt');
                receipt.style.display = 'block';
                window.print();
                setTimeout(() => { receipt.style.display = 'none'; }, 500);
            };
            successInstance ? switchModal('successModal', doPrint) : doPrint();
        }

        function printReceipt(depositId) {
            currentDepositId = depositId;
            generateReceipt();
        }

        function refreshData() { window.location.reload(); }

        function exportDeposits() {
            showAlert('Export feature coming soon.', 'info', 'Export');
        }
    </script>

    <script>
        async function loadSidebarPendingCount() {
            try {
                const res = await fetch('/admin/pending-approvals-count');
                const data = await res.json();
                const badge = document.getElementById('sidebarPendingBadge');
                if (!badge) return;
                if (data.count > 0) { badge.style.display = 'inline-block'; badge.textContent = data.count; }
                else { badge.style.display = 'none'; }
            } catch (err) { console.error('Sidebar count error:', err); }
        }
        document.addEventListener('DOMContentLoaded', loadSidebarPendingCount);
    </script>
</body>
</html>
