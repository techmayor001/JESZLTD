<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kiddies Deposit Management - Club De Stars Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --kiddies: #8b5cf6;
            --kiddies-light: #a78bfa;
            --sidebar-width: 280px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #ede9fe 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed; left: 0; top: 0; bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
            color: white; z-index: 1040; transition: all 0.3s;
            overflow-y: auto;
            box-shadow: 4px 0 20px rgba(30,58,138,0.15);
            transform: translateX(0);
        }
        .sidebar-header { padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.1); }
        .logo-container { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .logo-box { width: 45px; height: 45px; background: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--primary); font-size: 1.5rem; box-shadow: 0 4px 10px rgba(0,0,0,0.2); flex-shrink: 0; }
        .sidebar-title { font-size: 1.1rem; line-height: 1.2; }
        .admin-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; background: rgba(239,68,68,0.2); backdrop-filter: blur(10px); border-radius: 20px; border: 1px solid rgba(239,68,68,0.3); font-weight: 600; font-size: 0.8rem; margin-top: 8px; }
        .sidebar-menu { padding: 1rem 0; }
        .sidebar-menu a { color: rgba(255,255,255,0.85); text-decoration: none; padding: 0.875rem 1.5rem; display: flex; align-items: center; transition: all 0.3s; border-left: 3px solid transparent; font-weight: 500; font-size: 0.95rem; }
        .sidebar-menu a:hover { background: rgba(255,255,255,0.1); color: white; border-left-color: white; }
        .sidebar-menu a.active { background: rgba(255,255,255,0.15); color: white; border-left-color: white; }
        .sidebar-menu a i { width: 24px; margin-right: 12px; font-size: 1.1rem; flex-shrink: 0; }

        /* ── Top Navbar ── */
        .top-navbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: 70px;
            background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(30,58,138,0.08); z-index: 1030;
            display: flex; align-items: center; padding: 0 1.5rem; transition: all 0.3s;
            border-bottom: 1px solid rgba(30,58,138,0.1);
        }

        /* ── Main Content ── */
        .main-content { margin-left: var(--sidebar-width); margin-top: 70px; padding: 1.5rem; min-height: calc(100vh - 70px); transition: all 0.3s; }

        /* ── Page Header ── */
        .page-header {
            background: linear-gradient(135deg, #4c1d95 0%, #6d28d9 50%, #8b5cf6 100%);
            color: white; border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
            box-shadow: 0 15px 40px rgba(109,40,217,0.3); position: relative; overflow: hidden;
        }
        .page-header::before { content: ''; position: absolute; top: -50%; right: -20%; width: 400px; height: 400px; background: rgba(255,255,255,0.05); border-radius: 50%; }
        .page-header::after { content: '🧒'; position: absolute; right: 2rem; bottom: -10px; font-size: 5rem; opacity: 0.15; }

        /* ── Stats Cards ── */
        .stats-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(30,58,138,0.08); transition: all 0.3s;
            border: 2px solid transparent; height: 100%; position: relative; overflow: hidden;
        }
        .stats-card::before { content: ''; position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: rgba(139,92,246,0.04); border-radius: 0 16px 0 100%; }
        .stats-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(139,92,246,0.15); border-color: var(--kiddies); }
        .stats-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 1rem; }
        .stats-value { font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem; }
        .stats-label { color: var(--secondary); font-size: 0.9rem; font-weight: 500; }

        /* ── Card ── */
        .card { border: none; border-radius: 16px; box-shadow: 0 8px 20px rgba(30,58,138,0.08); background: white; border: 1px solid rgba(30,58,138,0.05); }
        .card-header { background: linear-gradient(135deg, rgba(139,92,246,0.04) 0%, rgba(167,139,250,0.04) 100%); border-bottom: 2px solid rgba(139,92,246,0.12); padding: 1.25rem; border-radius: 16px 16px 0 0 !important; }

        /* ── Status Badges ── */
        .status-badge { padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .status-pending  { background: rgba(245,158,11,0.1);  color: var(--warning); border: 1px solid rgba(245,158,11,0.3); }
        .status-success  { background: rgba(16,185,129,0.1);  color: var(--success); border: 1px solid rgba(16,185,129,0.3); }
        .status-approved { background: rgba(16,185,129,0.1);  color: var(--success); border: 1px solid rgba(16,185,129,0.3); }
        .status-failed   { background: rgba(239,68,68,0.1);   color: var(--danger);  border: 1px solid rgba(239,68,68,0.3); }
        .status-rejected { background: rgba(239,68,68,0.1);   color: var(--danger);  border: 1px solid rgba(239,68,68,0.3); }

        /* ── Action Buttons ── */
        .action-btn { padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; transition: all 0.3s; border: none; cursor: pointer; }
        .btn-approve { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; }
        .btn-approve:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(16,185,129,0.3); }
        .btn-reject  { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }
        .btn-reject:hover  { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(239,68,68,0.3); }
        .btn-view    { background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white; }
        .btn-view:hover    { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(139,92,246,0.3); }

        /* ── Filter Section ── */
        .filter-section { background: white; border-radius: 12px; padding: 1rem; margin-bottom: 1rem; box-shadow: 0 4px 12px rgba(30,58,138,0.06); }
        .filter-btn { padding: 8px 16px; border-radius: 8px; border: 2px solid rgba(139,92,246,0.15); background: white; color: var(--kiddies); font-weight: 600; transition: all 0.3s; cursor: pointer; }
        .filter-btn:hover, .filter-btn.active { background: var(--kiddies); color: white; border-color: var(--kiddies); }

        /* ── Table ── */
        .table-responsive { border-radius: 0 0 16px 16px; overflow: hidden; }
        .table { margin: 0; }
        .table thead { background: linear-gradient(135deg, rgba(139,92,246,0.05) 0%, rgba(167,139,250,0.05) 100%); }
        .table thead th { border: none; padding: 1rem; font-weight: 600; color: var(--kiddies); white-space: nowrap; }
        .table tbody td { padding: 1rem; vertical-align: middle; border-bottom: 1px solid rgba(139,92,246,0.05); }
        .table tbody tr:last-child td { border-bottom: none; }
        .table tbody tr:hover { background: rgba(139,92,246,0.02); }

        /* ── Child Avatar ── */
        .child-avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; display: inline-flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.85rem; flex-shrink: 0; }

        /* ── Receipt ── */
        .receipt-container { max-width: 800px; margin: 0 auto; background: white; padding: 2rem; border: 2px solid #e5e7eb; }
        .receipt-header { text-align: center; border-bottom: 3px solid var(--kiddies); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
        .receipt-logo { width: 80px; height: 80px; background: linear-gradient(135deg, #4c1d95 0%, #8b5cf6 100%); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; margin: 0 auto 1rem; }
        .receipt-title { font-size: 1.8rem; font-weight: bold; color: var(--kiddies); margin-bottom: 0.5rem; }
        .receipt-subtitle { color: var(--secondary); font-size: 0.9rem; }
        .receipt-section { margin-bottom: 1.5rem; }
        .receipt-section-title { font-weight: bold; color: var(--kiddies); border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem; margin-bottom: 1rem; }
        .receipt-row { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px dashed #e5e7eb; }
        .receipt-row:last-child { border-bottom: none; }
        .receipt-amount { background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%); border: 2px solid var(--kiddies); border-radius: 10px; padding: 1rem; text-align: center; margin: 1.5rem 0; }
        .receipt-amount-value { font-size: 2.5rem; font-weight: bold; color: var(--kiddies); }
        .receipt-footer { text-align: center; border-top: 3px solid var(--kiddies); padding-top: 1.5rem; margin-top: 2rem; }
        .receipt-stamp { display: inline-block; border: 3px solid var(--success); color: var(--success); padding: 0.5rem 1.5rem; border-radius: 10px; font-weight: bold; transform: rotate(-5deg); margin: 1rem 0; }

        /* ── Alert Modal ── */
        #alertModal .modal-content { border: none; border-radius: 18px; overflow: hidden; box-shadow: 0 20px 60px rgba(139,92,246,0.2); }
        #alertModal .modal-header { padding: 1.25rem 1.5rem; border-bottom: none; }
        #alertModal .modal-body { padding: 1.5rem; text-align: center; }
        #alertModal .alert-icon-wrapper { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 2rem; }
        #alertModal .modal-footer { border-top: none; padding: 0 1.5rem 1.5rem; justify-content: center; }

        .powered-by { position: fixed; bottom: 15px; right: 15px; background: white; padding: 10px 16px; border-radius: 25px; box-shadow: 0 4px 15px rgba(30,58,138,0.15); font-size: 0.8rem; font-weight: 600; color: var(--primary); z-index: 1000; }

        /* ── Responsive ── */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.active { transform: translateX(0); }
            .top-navbar { left: 0; }
            .main-content { margin-left: 0; padding: 1rem; }
            .table thead { display: none; }
            .table tbody tr { display: block; margin-bottom: 1rem; border: 2px solid rgba(139,92,246,0.1); border-radius: 12px; overflow: hidden; background: white; }
            .table tbody td { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-bottom: 1px solid rgba(139,92,246,0.05); }
            .table tbody td:last-child { border-bottom: none; }
            .table tbody td::before { content: attr(data-label); font-weight: 600; color: var(--kiddies); margin-right: 1rem; }
        }

        @media print {
            body * { visibility: hidden; }
            #printReceipt, #printReceipt * { visibility: visible; }
            #printReceipt { position: absolute; left: 0; top: 0; width: 100%; }
            .sidebar, .top-navbar, .powered-by, .no-print { display: none !important; }
        }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .fade-in { animation: fadeIn 0.5s ease; }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-box">C</div>
                <div>
                    <h5 class="mb-0 fw-bold sidebar-title" style="text-transform:uppercase;">Club De Stars</h5>
                    <small class="opacity-75" style="font-size:0.75rem;">ADMIN PANEL</small>
                </div>
            </div>
            <div class="admin-badge"><i class="fas fa-shield-alt"></i><span>SUPER ADMIN</span></div>
        </div>
        <div class="sidebar-menu">
            <a href="/admin-dashboard"><i class="fas fa-users"></i> Members</a>
            <a href="/admin/kiddies-accounts" class="active"><i class="fas fa-baby"></i> Kiddies Accounts</a>
            <a href="/admin/manage/memberType"><i class="fas fa-id-card"></i> Membership Types</a>
            <a href="/admin/manage-payment"><i class="fas fa-credit-card"></i> Payments</a>
            <a href="/admin/transaction-approvals"><i class="fas fa-tasks"></i> Approvals<span id="sidebarPendingBadge" class="badge bg-danger ms-1" style="display:none;">0</span></a>
            <a href="/admin/manage-deposits"><i class="fas fa-coins"></i> Deposit Management</a>
            <a href="/admin/kiddies-deposits" class="active"><i class="fas fa-piggy-bank"></i> Kiddies Deposits</a>
            <a href="/admin/manage-withdrawals"><i class="fas fa-money-check-alt"></i> Withdrawals</a>
            <a href="/admin/manage-extra-charges"><i class="fas fa-hand-holding-usd"></i> Extra Charges</a>
            <a href="/admin/manage-loan"><i class="fas fa-hand-holding-usd"></i> Loan Management</a>
            <a href="/admin/loan/settings"><i class="fas fa-cogs"></i> Loan Settings</a>
            <a href="/admin/external-loans"><i class="fas fa-building"></i> External Loans</a>
            <a href="/admin/finance"><i class="fas fa-landmark"></i> Company Finance</a>
            <a href="#"><i class="fas fa-chart-pie"></i> ROI Distribution</a>
            <a href="/manage-subscriptions"><i class="fas fa-cube"></i> Manage Subscription</a>
            <a href="/manage-roles"><i class="fas fa-user-shield"></i> Roles &amp; Permissions</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i> Settings</a>
            <a href="/admin/reports"><i class="fas fa-file-alt"></i> Reports</a>
            <a href="/admin/logs"><i class="fas fa-history"></i> Admin Logs</a>
            <a href="/cds-cooperative/dashboard" class="mt-3" style="color:rgba(255,255,255,.6);"><i class="fas fa-sign-in-alt"></i> Back to Dashboard</a>
        </div>
    </div>

    <!-- Top Navbar -->
    <div class="top-navbar">
        <i class="fas fa-bars d-lg-none me-3" style="cursor:pointer;color:var(--primary);font-size:1.5rem;" onclick="document.getElementById('sidebar').classList.toggle('active')"></i>
        <div class="flex-grow-1 d-none d-lg-block">
            <h5 class="mb-0 fw-bold" style="color:var(--kiddies)">Kiddies Deposit Management</h5>
            <small class="text-muted">Review and approve kiddies account deposits</small>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="badge bg-light text-dark">
                <i class="fas fa-calendar me-1"></i>
                <span id="currentDate"></span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">

        <!-- Page Header -->
        <div class="page-header position-relative">
            <div class="row align-items-center position-relative" style="z-index:1;">
                <div class="col-md-8">
                    <h2 class="mb-2 fw-bold"><i class="fas fa-piggy-bank me-3"></i>Kiddies Deposit Management</h2>
                    <p class="mb-0 opacity-90">Monitor, review and approve deposits into kiddies savings accounts</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <button class="btn btn-light" onclick="refreshData()">
                        <i class="fas fa-sync-alt me-2"></i>Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="stats-card">
                    <div class="stats-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:white;">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <div class="stats-value" style="color:var(--success);font-size:14px;">
                        ₦<%= stats.totalDeposited.toLocaleString() %>
                    </div>
                    <div class="stats-label" style="font-size:12px;">Total Deposited</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stats-card">
                    <div class="stats-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stats-value" style="color:var(--warning);font-size:14px;">
                        <%= stats.pendingCount %>
                    </div>
                    <div class="stats-label" style="font-size:12px;">Pending Deposits</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stats-card">
                    <div class="stats-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:white;">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stats-value" style="color:var(--kiddies);font-size:14px;">
                        <%= stats.approvedToday %>
                    </div>
                    <div class="stats-label" style="font-size:12px;">Approved Today</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stats-card">
                    <div class="stats-icon" style="background:linear-gradient(135deg,#3b82f6,#2563eb);color:white;">
                        <i class="fas fa-baby"></i>
                    </div>
                    <div class="stats-value" style="color:var(--primary);font-size:14px;">
                        <%= stats.activeKiddiesAccounts %>
                    </div>
                    <div class="stats-label" style="font-size:12px;">Active Kiddies Accounts</div>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="d-flex flex-wrap gap-2">
                        <button class="filter-btn active" onclick="filterDeposits('all', event)">
                            <i class="fas fa-list me-1"></i> All Deposits
                        </button>
                        <button class="filter-btn" onclick="filterDeposits('pending', event)">
                            <i class="fas fa-clock me-1"></i> Pending
                        </button>
                        <button class="filter-btn" onclick="filterDeposits('success', event)">
                            <i class="fas fa-check me-1"></i> Approved
                        </button>
                        <button class="filter-btn" onclick="filterDeposits('failed', event)">
                            <i class="fas fa-times me-1"></i> Rejected
                        </button>
                    </div>
                </div>
                <div class="col-lg-4 mt-3 mt-lg-0">
                    <input type="text" class="form-control" id="searchDeposit"
                        placeholder="Search by child name, parent, account ID or reference..."
                        onkeyup="searchDeposits()">
                </div>
            </div>
        </div>

        <!-- Deposits Table -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-list me-2" style="color:var(--kiddies);"></i>
                    Kiddies Deposit Requests
                </h5>
                <button class="btn btn-sm btn-outline-secondary" onclick="exportDeposits()">
                    <i class="fas fa-download me-1"></i>Export
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Date / Time</th>
                                <th>Child</th>
                                <th>Parent</th>
                                <th>Amount</th>
                                <th>Payer</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="depositsTableBody">
                            <% if (deposits && deposits.length > 0) { %>
                                <% deposits.forEach(deposit => { %>
                                    <tr data-status="<%= deposit.status %>">
                                        <td data-label="Date/Time">
                                            <small class="fw-semibold"><%= deposit.date %></small><br>
                                            <small class="text-muted"><%= deposit.time %></small>
                                        </td>

                                        <td data-label="Child">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="child-avatar">
                                                    <%= deposit.childName.charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold"><%= deposit.childName %></div>
                                                    <small class="text-muted"><%= deposit.accountID %></small>
                                                </div>
                                            </div>
                                        </td>

                                        <td data-label="Parent">
                                            <div class="fw-semibold"><%= deposit.parentName %></div>
                                            <small class="text-muted"><%= deposit.parentEmail %></small>
                                        </td>

                                        <td data-label="Amount" class="fw-bold" style="color:var(--success);">
                                            ₦<%= deposit.amount.toLocaleString() %>
                                        </td>

                                        <td data-label="Payer">
                                            <small><%= deposit.payeeName || '—' %></small>
                                        </td>

                                        <td data-label="Reference">
                                            <small class="text-muted"><%= deposit.reference %></small>
                                        </td>

                                        <td data-label="Status">
                                            <span class="status-badge status-<%= deposit.status %>">
                                                <%= deposit.status === 'success' ? 'Approved' : deposit.status.charAt(0).toUpperCase() + deposit.status.slice(1) %>
                                            </span>
                                        </td>

                                        <td data-label="Actions">
                                            <div class="d-flex gap-2 flex-wrap">
                                                <% if (deposit.status === 'pending') { %>
                                                    <button class="action-btn btn-approve" onclick="approveDeposit('<%= deposit.id %>')">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button class="action-btn btn-reject" onclick="rejectDeposit('<%= deposit.id %>')">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                <% } %>
                                                <button class="action-btn btn-view" onclick="viewDepositDetails('<%= deposit.id %>')">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <% if (deposit.status === 'success') { %>
                                                    <button class="action-btn btn-view" onclick="printReceipt('<%= deposit.id %>')">
