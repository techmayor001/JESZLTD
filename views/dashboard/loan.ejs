    <!-- Loan Request Modal -->
<!-- Special Loan Button -->
<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#loanRequestModal">
    <i class="fas fa-piggy-bank me-2"></i>Request Special Loan
</button>

<!-- Loan Request Modal -->
<div class="modal fade" id="loanRequestModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 20px;">

            <div class="modal-header" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-file-invoice-dollar me-2" style="color: var(--primary);"></i>
                    Apply for Loan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="alert-warning-custom mb-4">
                    <small>
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Requirements:</strong> Two guarantors required for loan approval.
                    </small>
                </div>

                <% 
                    const now = new Date();
                    const joinDate = new Date(user.createdAt);

                    const isEligibleForLoan = (unit, value) => {
                        if (unit === "daily") return true;
                        let elapsed;
                        switch(unit) {
                            case "weeks":
                                elapsed = Math.floor((now - joinDate) / (1000*60*60*24*7));
                                break;
                            case "months":
                                elapsed = (now.getFullYear() - joinDate.getFullYear()) * 12 + (now.getMonth() - joinDate.getMonth());
                                break;
                            default:
                                elapsed = 0;
                        }
                        return elapsed >= value;
                    };

                    const eligibleLoan = loanSettings.find(ls => 
                        ls.status === "active" && isEligibleForLoan(ls.eligibilityUnit, ls.eligibilityValue)
                    );

                    const isEligible = !!eligibleLoan;

                    // ---- NEW: Block loan application if user already has a loan ----
                    const canApply = isEligible && !loan;
                %>

                <% if (loan) { %>
                    <div class="alert alert-danger mb-3">
                        <i class="fas fa-ban me-2"></i>
                        You already have an active or pending loan. You cannot apply for a new loan until it is fully cleared.
                    </div>
                <% } %>

                <% if (!isEligible && !loan) { %>
                    <div class="alert alert-danger mb-3">
                        You are not eligible to apply for a loan yet. Remain on the platform for the required duration.
                    </div>
                <% } %>

                <form id="loanForm" action="/club-de-star-cooperative/apply-loan" method="POST">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Loan Amount (₦)</label>
                            <input type="number" class="form-control" name="amount"
                                   max="<%= user.account.balance * 3 %>" 
                                   placeholder="Enter amount" 
                                   required
                                   <%= !canApply ? "disabled" : "" %>>
                            <small class="text-muted">Max: ₦<%= (user.account.balance * 3).toLocaleString() %></small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Repayment Period</label>
                            <select class="form-select" name="duration" required <%= !canApply ? "disabled" : "" %>>
                                <% loanSettings.forEach(setting => { %>
                                    <% if (setting.status === "active") { %>
                                        <option value="<%= setting._id %>"
                                            <%= !isEligibleForLoan(setting.eligibilityUnit, setting.eligibilityValue) ? "disabled" : "" %>>
                                            <%= setting.loanName %> - <%= setting.duration %> months
                                            <% if(setting.eligibilityUnit !== 'daily' && !isEligibleForLoan(setting.eligibilityUnit, setting.eligibilityValue)) { %>
                                                (Not yet eligible)
                                            <% } %>
                                        </option>
                                    <% } %>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <!-- GUARANTORS -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Guarantor 1</label>
                            <select id="guarantor1" class="form-select guarantorSelect" 
                                name="guarantor1" required <%= !canApply ? "disabled" : "" %>>
                                <option value="">Select guarantor...</option>
                                <% users.forEach(u => { if(u._id.toString() !== user._id.toString()){ %>
                                    <option value="<%= u._id %>"><%= u.firstName %> — <%= u.phone %></option>
                                <% }}) %>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Guarantor 2</label>
                            <select id="guarantor2" class="form-select guarantorSelect" 
                                name="guarantor2" required <%= !canApply ? "disabled" : "" %>>
                                <option value="">Select guarantor...</option>
                                <% users.forEach(u => { if(u._id.toString() !== user._id.toString()){ %>
                                    <option value="<%= u._id %>"><%= u.firstName %> — <%= u.phone %></option>
                                <% }}) %>
                            </select>
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" name="agreeTerms" id="agreeTerms" 
                            required <%= !canApply ? "disabled" : "" %>>
                        <label class="form-check-label" for="agreeTerms">
                            I agree to the loan terms: 
                            <%= user.account.accountType.name %> account — <%= user.account.accountType.interestRate %>% interest rate,
                            0.5% daily penalty for late payment.
                        </label>
                    </div>

                    <div class="modal-footer mt-4">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" <%= !canApply ? "disabled" : "" %>>
                            Submit Application
                        </button>
                    </div>
                </form>

            </div>

        </div>
    </div>
</div>

<script>
    // Prevent selecting the same guarantor twice
    document.querySelectorAll('.guarantorSelect').forEach(select => {
        select.addEventListener('change', function() {
            const g1 = document.getElementById('guarantor1').value;
            const g2 = document.getElementById('guarantor2').value;

            if (g1 && g2 && g1 === g2) {
                alert("You cannot select the same guarantor twice.");
                this.value = "";
            }
        });
    });

    document.getElementById('loanForm').addEventListener('submit', function(e) {
        const g1 = document.getElementById('guarantor1').value;
        const g2 = document.getElementById('guarantor2').value;

        if (g1 && g2 && g1 === g2) {
            alert("You cannot select the same guarantor twice.");
            e.preventDefault();
        }
    });
</script>



<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-credit-card me-2 text-primary"></i>Make Loan Payment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="loanPaymentForm">
                    <div class="card mb-3" style="background: linear-gradient(135deg, rgba(30, 58, 138, 0.05) 0%, rgba(59, 130, 246, 0.05) 100%);">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted fw-semibold">Outstanding Balance</span>
                                <strong>
                                    ₦<%= loan ? loan.totalRepay.toLocaleString() : '0' %>
                                </strong>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Amount (₦)</label>
                        <input 
                            type="number" 
                            name="amount"
                            id="paymentAmount" 
                            class="form-control" 
                            value="<%= loan ? Math.ceil(loan.totalRepay / 12) : 0 %>" 
                            min="<%= loan ? Math.ceil(loan.totalRepay / 12) : 0 %>" 
                            max="<%= loan ? loan.totalRepay : 0 %>" 
                            required
                        >
                        <small class="text-muted">
                            Minimum payment: ₦<%= loan ? Math.ceil(loan.totalRepay / 12).toLocaleString() : '0' %>
                        </small>
                    </div>

                    <input type="hidden" name="loanId" value="<%= loan ? loan._id : '' %>">
                    <input type="hidden" name="dueDate" value="<%= loan?.dueDate ? loan.dueDate.toISOString() : '' %>">


                    <div class="alert-warning-custom">
                        <small>
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>
                                Due 
                                <%= loan ? new Date(loan.dueDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A' %>!
                            </strong> 
                            Avoid 0.5% daily penalty
                        </small>
                    </div>

                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Make Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("loanPaymentForm");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const amount = parseFloat(document.getElementById("paymentAmount").value);
        const loanId = form.querySelector('input[name="loanId"]').value;
        const dueDate = form.querySelector('input[name="dueDate"]').value;

        if (!amount || amount <= 0) {
            alert("Please enter a valid payment amount.");
            return;
        }

        const button = form.querySelector("button[type='submit']");
        button.disabled = true;
        button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';

        try {
            const response = await fetch("/loan/payment", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ amount, loanId, dueDate })
            });

            const result = await response.json();

            if (result.status && result.authorization_url) {
                // redirect to Paystack if backend returns URL
                window.location.href = result.authorization_url;
            } else if (result.status) {
                alert("Payment successful!");
                window.location.reload();
            } else {
                alert(result.message || "Failed to process payment.");
                button.disabled = false;
                button.innerHTML = "Make Payment";
            }
        } catch (err) {
            console.error("Loan payment failed:", err);
            alert("Unable to process payment. Please try again.");
            button.disabled = false;
            button.innerHTML = "Make Payment";
        }
    });
});
</script>

