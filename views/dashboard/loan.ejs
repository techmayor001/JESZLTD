    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        // Navigation
        function showSection(sectionId, event) {
            if (event) {
                event.preventDefault();
            }
            
            document.querySelectorAll('.content-section').forEach(section => {
                section.style.display = 'none';
            });
            document.getElementById(sectionId).style.display = 'block';
            
            document.querySelectorAll('.sidebar-menu a').forEach(link => {
                link.classList.remove('active');
            });
            
            if (event && event.target) {
                event.target.classList.add('active');
            }

            if (window.innerWidth <= 992) {
                document.getElementById('sidebar').classList.remove('active');
            }
        }

        // Modal Functions
        function openModal(modalId) {
            const modal = new bootstrap.Modal(document.getElementById(modalId));
            modal.show();
        }

        // Loan Calculator

    function calculateLoan() {
        const amountInput = document.getElementById('calcAmount');
        const durationInput = document.getElementById('calcDuration');
        const rateInput = document.getElementById('calcRate');

        const amount = parseFloat(amountInput.value) || 0;
        const duration = parseInt(durationInput.value) || 1;
        const rate = parseFloat(rateInput.value) || 0;

        // Max loan amount
        const maxLoan = parseFloat("<%= user.account.balance %>") * 3;

        if (amount > maxLoan) {
            alert(`Loan amount exceeds your max eligible amount of ₦${maxLoan.toLocaleString()}`);
            amountInput.value = maxLoan;
            return;
        }

        if (amount <= 0) return;

        // Interest is based on selected duration
        const interest = (amount * (rate / 100)) * duration;

        const total = amount + interest;
        const monthly = total / duration;

        document.getElementById('calcResult').style.display = 'block';
        document.getElementById('monthlyPay').textContent =
            '₦' + monthly.toLocaleString('en-NG', { minimumFractionDigits: 2 });

        document.getElementById('totalInt').textContent =
            '₦' + interest.toLocaleString('en-NG', { minimumFractionDigits: 2 });

        document.getElementById('totalRep').textContent =
            '₦' + total.toLocaleString('en-NG', { minimumFractionDigits: 2 });
    }

        // Withdrawal Fee Calculator


        // Form Submissions
        function submitDeposit() {
            alert('✅ Deposit request submitted successfully! You will receive a confirmation shortly.');
            bootstrap.Modal.getInstance(document.getElementById('depositModal')).hide();
        }

        function submitWithdrawal() {
            const type = document.getElementById('withdrawalType').value;
            if (type === 'force') {
                if (confirm('Force withdrawal includes a 2.5% charge. You will receive 50% now and 50% after 30 days. Continue?')) {
                    alert('✅ Force withdrawal request submitted! Processing time: 24-48 hours.');
                    bootstrap.Modal.getInstance(document.getElementById('withdrawModal')).hide();
                }
            } else {
                alert('✅ Withdrawal request submitted successfully! Processing time: 24-48 hours.');
                bootstrap.Modal.getInstance(document.getElementById('withdrawModal')).hide();
            }
        }

        function submitPayment() {
            alert('✅ Payment processed successfully! Your loan balance has been updated.');
            bootstrap.Modal.getInstance(document.getElementById('paymentModal')).hide();
        }

        function submitLoanRequest() {
            const amount = parseFloat(document.getElementById('loanAmount').value) || 0;
            
            if (amount <= 0) {
                alert('❌ Please enter a valid loan amount');
                return;
            }
            
            if (amount > 1350000) {
                alert('❌ Loan amount exceeds maximum eligible amount of ₦1,350,000 (3x your savings)');
                return;
            }
            
            if (!document.getElementById('agreeTerms').checked) {
                alert('❌ Please agree to the loan terms and conditions');
                return;
            }
            
            alert('✅ Loan application submitted successfully!\n\nYour application will be reviewed within 3-5 business days.\n\nClub Member Rate: 5% p.a.\nMaximum Amount: 3x savings\nReminder: 3 days before due date');
            bootstrap.Modal.getInstance(document.getElementById('loanRequestModal')).hide();
        }


        // Animation on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.stat-card, .card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                
                setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>


    <script>
    // Close sidebar when clicking outside (for mobile view)
    document.addEventListener('click', function (event) {
        const sidebar = document.getElementById('sidebar');
        const toggleButton = document.querySelector('.fa-bars');

        // Only apply this behavior on small screens
        if (window.innerWidth <= 992) {
            // If sidebar is active and click is outside sidebar and toggle button → close it
            if (sidebar.classList.contains('active') &&
                !sidebar.contains(event.target) &&
                !toggleButton.contains(event.target)) {
                sidebar.classList.remove('active');
            }
        }
    });
</script>

